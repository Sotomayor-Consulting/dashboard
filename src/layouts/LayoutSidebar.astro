---
import Banner from '@components/feedback/Banner.astro';
import BannerUpgrade from '@components/feedback/BannerUpgrade.astro';
import BannerPartner from '@components/feedback/PartnerProfileBanner.astro';
import BannerIncorporacion from '@components/feedback/BannerIncorporationForm.astro';
import Toaster from '@components/ui/Sonner';
import LayoutCommon from './LayoutCommon.astro';
import NavBarSidebar from '../components/navigation/NavBarSidebar.astro';
import SideBar from '../components/navigation/SideBar.astro';

import {
	getUsuarioById,
	getMissingFieldsFromProfile,
	type PartnerRequiredField,
} from '@domains/users/users';
import { getNotifications } from '@domains/users/notifications';
import {
	getEstadoIncorporacionByUserId,
	getBannerIncorporacionData,
} from '@domains/companies/incorporations';
import {
	getEmpresasForSwitcher,
	resolveActiveCompany,
	type EmpresaSwitcherItem,
} from '@domains/companies/companies';
import { ACTIVE_COMPANY_COOKIE } from '@shared/cookies';
import {
	getLayoutCache,
	setLayoutCache,
} from '@infrastructure/cache/layout-cache';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];
const isPartner = userRoles.includes('partner');

let usuario: any = null;
let notificationsData: any = { notifications: [], totalUnread: 0 };
let incorporaciones: any[] = [];
let bannerIncorpData = { shouldShow: false, empresaId: null as string | null };
let empresasSwitcher: EmpresaSwitcherItem[] = [];

// Detectar si es un fetch del ClientRouter (navegación SPA o prefetch).
// Sec-Fetch-Dest=document → navegación nativa (F5, URL bar, link sin prefetch).
// Sec-Fetch-Dest=empty    → fetch() programático (View Transitions / prefetch).
const fetchDest = Astro.request.headers.get('sec-fetch-dest');
const isClientRouterFetch = fetchDest !== null && fetchDest !== 'document';

if (user && userId) {
	const cached = getLayoutCache(userId);

	if (cached) {
		({
			usuario,
			notificationsData,
			incorporaciones,
			bannerIncorpData,
			empresasSwitcher,
		} = cached);
	} else if (isClientRouterFetch) {
		// SideBar (transition:persist="sidebar-*") y NavBarSidebar (transition:persist="navbar")
		// conservan su DOM en el swap → su HTML server-rendered se descarta. Saltamos
		// las queries que SOLO los alimentan (notificaciones y empresas del switcher).
		// Los banners NO son persistidos, así que mantenemos sus 3 queries.
		[usuario, incorporaciones, bannerIncorpData] = await Promise.all([
			getUsuarioById(supabase, userId),
			getEstadoIncorporacionByUserId(supabase, userId),
			getBannerIncorporacionData(supabase, userId),
		]);
		// No persistimos al LRU: entrada incompleta. Una navegación full-document
		// repoblará el cache con las 5 queries.
	} else {
		[
			usuario,
			notificationsData,
			incorporaciones,
			bannerIncorpData,
			empresasSwitcher,
		] = await Promise.all([
			getUsuarioById(supabase, userId),
			getNotifications(supabase, userId),
			getEstadoIncorporacionByUserId(supabase, userId),
			getBannerIncorporacionData(supabase, userId),
			getEmpresasForSwitcher(supabase, userId),
		]);

		setLayoutCache(userId, {
			usuario,
			notificationsData,
			incorporaciones,
			bannerIncorpData,
			empresasSwitcher,
		});
	}
}

const activeCompany = resolveActiveCompany(
	empresasSwitcher,
	Astro.cookies.get(ACTIVE_COMPANY_COOKIE)?.value,
);

const routeCompanyIdMatch = Astro.url.pathname.match(
	/^\/my-companies\/([^/]+)\//,
);
const routeCompanyId = routeCompanyIdMatch?.[1];
const routeCompany = routeCompanyId
	? (empresasSwitcher.find((company) => company.id === routeCompanyId) ?? null)
	: null;
const selectedCompany = routeCompany ?? activeCompany;

// Derivar datos de banner desde los resultados
const showBannerEnProceso =
	incorporaciones?.length > 0 &&
	incorporaciones.some((c: any) => c.estado === 'En proceso');

const showBannerUpgrade =
	incorporaciones?.length > 0 &&
	incorporaciones.some((c: any) => c.estado === 'Upgrade');

// Reusar datos del usuario para verificar campos de partner (0 queries extra)
const missingPartnerFields: PartnerRequiredField[] =
	isPartner && usuario ? getMissingFieldsFromProfile(usuario) : [];
const showBannerPartner = missingPartnerFields.length > 0;
---

<LayoutCommon>
	<NavBarSidebar usuario={usuario} notificationsData={notificationsData} />

	<SideBar empresas={empresasSwitcher} activeCompany={selectedCompany} />

	<div class="dark:bg-black-900 flex overflow-hidden bg-white pt-14">
		<div
			id="main-content"
			class="dark:bg-black-900 relative h-full min-h-screen w-full bg-white px-6"
		>
			<div transition:persist="global-toaster">
				<Toaster client:load />
			</div>
			<Banner shouldShowBanner={showBannerEnProceso} />
			<BannerUpgrade shouldShowBanner={showBannerUpgrade} />
			<BannerPartner
				shouldShowBanner={showBannerPartner}
				missingFields={missingPartnerFields}
			/>
			<BannerIncorporacion
				shouldShowBanner={bannerIncorpData.shouldShow}
				empresaId={bannerIncorpData.empresaId}
			/>
			<slot />
		</div>
	</div>
</LayoutCommon>
