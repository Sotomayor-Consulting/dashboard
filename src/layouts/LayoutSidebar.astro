---
import BannerToastManager from '@components/feedback/islands/BannerToastManager.tsx';
import Toaster from '@components/ui/Sonner';
import LayoutCommon from './LayoutCommon.astro';
import NavBarSidebar from '../components/navigation/NavBarSidebar.astro';
import SideBar from '../components/navigation/SideBar.astro';

import {
	getUsuarioById,
	type PartnerRequiredField,
} from '@domains/users/users';
import { getAvatarUrl } from '@shared/avatar';
import { getNotifications } from '@domains/users/notifications';
import {
	getEmpresasForSwitcher,
	resolveActiveCompany,
	type EmpresaSwitcherItem,
} from '@domains/companies/companies';
import { ACTIVE_COMPANY_COOKIE } from '@shared/cookies';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;

let usuario: any = null;
let notificationsData: any = { notifications: [], totalUnread: 0 };
let empresasSwitcher: EmpresaSwitcherItem[] = [];

if (user && userId) {
	[usuario, notificationsData, empresasSwitcher] = await Promise.all([
		getUsuarioById(supabase, userId),
		getNotifications(supabase, userId),
		getEmpresasForSwitcher(supabase, userId),
	]);
}

const activeCompany = resolveActiveCompany(
	empresasSwitcher,
	Astro.cookies.get(ACTIVE_COMPANY_COOKIE)?.value,
);

// Detecta la empresa del contexto por URL: /incorporation/[id] o /company/[id].
const routeCompanyIdMatch = Astro.url.pathname.match(
	/^\/(incorporation|company)\/([^/]+)/,
);
const routeCompany = routeCompanyIdMatch
	? (empresasSwitcher.find((company) =>
			routeCompanyIdMatch[1] === 'incorporation'
				? company.incorporation_id === routeCompanyIdMatch[2]
				: company.company_id === routeCompanyIdMatch[2],
		) ?? null)
	: null;
const selectedCompany = routeCompany ?? activeCompany;

/*
	Toast de validacion partner deshabilitado temporalmente.
	Mantener este bloque comentado por si se vuelve a habilitar a futuro.

	const userRoles = Astro.locals.userRoles || [];
	const isPartner = userRoles.includes('partner');
	const missingPartnerFields: PartnerRequiredField[] =
		isPartner && usuario ? getMissingFieldsFromProfile(usuario) : [];
	const showBannerPartner = missingPartnerFields.length > 0;
*/

const missingPartnerFields: PartnerRequiredField[] = [];
const showBannerPartner = false;

const avatarUrl = getAvatarUrl(usuario?.avatar_url, supabase);
---

<LayoutCommon>
	<NavBarSidebar
		usuario={usuario}
		notificationsData={notificationsData}
		empresas={empresasSwitcher}
		avatarUrl={avatarUrl}
	/>

	<SideBar
		empresas={empresasSwitcher}
		activeCompany={selectedCompany}
		avatarUrl={avatarUrl}
	/>

	<div class="dark:bg-primary-black flex h-dvh overflow-hidden bg-white pt-14">
		<div
			id="main-content"
			class="dark:bg-primary-black relative h-full w-full overflow-y-auto bg-white"
		>
			<div transition:persist="global-toaster">
				<Toaster client:load />
			</div>
			<BannerToastManager
				showBannerPartner={showBannerPartner}
				missingFields={missingPartnerFields}
				client:load
			/>
			<div class="px-6">
				<slot />
			</div>
		</div>
	</div>
</LayoutCommon>
