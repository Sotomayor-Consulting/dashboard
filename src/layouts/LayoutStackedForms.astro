---
import FooterStacked from '../components/navigation/FooterStacked.astro';
import LayoutCommon from './LayoutCommonForms.astro';
import NavBarStacked from '../components/navigation/NavBarStacked.astro';
import { Image } from 'astro:assets';
import edificiosFondo from '@assets/backgrounds/edificios-fondo.avif';
---

<LayoutCommon>
	<NavBarStacked />

	<div class="flex pt-16 overflow-hidden bg-gray-50 dark:bg-black-800">
		<div>
			<Image
				src={edificiosFondo}
				alt="Fondo edificios"
				class="z-0 dark:opacity-10 opacity-50 absolute object-center h-full w-full object-cover"
			/>
		</div>
		<div
			id="main-content"
			class="relative w-full max-w-screen-2xl mx-auto h-full overflow-y-auto min-h-screen z-10"
		>
			<div class="px-4 pt-6 2xl:px-0">
				<slot />
			</div>

			<FooterStacked />
		</div>
	</div>
</LayoutCommon>
