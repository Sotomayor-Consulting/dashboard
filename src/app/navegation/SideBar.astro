---
import { Icon } from 'astro-icon/components';
import { menuItems } from '@lib/interfaz/itemsNavegacion';

const userRoles = Astro.locals.userRoles;

const visibleMenu = menuItems.filter(
	(item) =>
		(item.roles.includes('all') && userRoles.length > 0) ||
		item.roles.includes('todos') ||
		item.roles.some((r) => userRoles.includes(r)),
);

const ruta = Astro.url.pathname;

/* Clases reutilizables */
const activeClass =
	'bg-gray-100 text-gray-900 font-semibold dark:bg-white/10 dark:text-white';
const inactiveClass =
	'text-gray-500 hover:bg-gray-50 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-200';
---

<!-- ===== Mobile drawer (< lg) ===== -->
<aside
	id="sidebar"
	class="fixed top-0 left-0 z-40 h-screen w-60 -translate-x-full overflow-hidden border-r border-gray-200 bg-white transition-transform lg:hidden dark:border-gray-700/50 dark:bg-black-900"
	tabindex="-1"
	aria-label="Menú de navegación"
	transition:persist="sidebar-mobile"
>
	<div class="flex h-full flex-col">
		<!-- Logo + close -->
		<div class="flex items-center justify-between px-3 pt-5 pb-2">
			<a href="/">
				<Icon
					name="logo-en-negro"
					class="block text-3xl dark:hidden"
					title="Logo Sotomayor Consulting"
				/>
				<Icon
					name="logo-en-blanco"
					class="hidden text-3xl dark:block"
					title="Logo Sotomayor Consulting"
				/>
			</a>
			<button
				type="button"
				data-drawer-hide="sidebar"
				aria-controls="sidebar"
				class="flex items-center justify-center rounded-md p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-white/5 dark:hover:text-gray-200"
			>
				<Icon name="ri:close-line" class="h-5 w-5" />
				<span class="sr-only">Cerrar menú</span>
			</button>
		</div>

		<!-- Nav items -->
		<nav
			class:list={[
				'flex-1 overflow-y-auto overflow-x-hidden px-2 py-2',
				'scrollbar scrollbar-w-1.5 scrollbar-thumb-rounded-full',
				'scrollbar-thumb-gray-300 scrollbar-track-transparent',
				'dark:scrollbar-thumb-neutral-700',
			]}
		>
			<ul class="space-y-0.5">
				<li>
					<a
						href="/"
						class={`flex items-center gap-3 rounded-md px-2.5 py-2 text-[13px] font-medium transition-colors ${ruta === '/' ? activeClass : inactiveClass}`}
					>
						<Icon name="ri:home-9-fill" class="h-5 w-5 shrink-0" />
						<span>Inicio</span>
					</a>
				</li>
				{
					visibleMenu.map((l) => (
						<li>
							<a
								href={l.href}
								class={`flex items-center gap-3 rounded-md px-2.5 py-2 text-[13px] font-medium transition-colors ${ruta === l.href ? activeClass : inactiveClass}`}
							>
								<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
								<span>{l.label}</span>
							</a>
						</li>
					))
				}
			</ul>

			<!-- Links externos -->
			<div class="mt-3 space-y-0.5 border-t border-gray-200 pt-3 dark:border-gray-700/50">
				{
					[
						{
							link: 'https://sotomayorconsulting.com/',
							svgname: 'ri:earth-line',
							span: 'Visita nuestra web',
						},
						{
							link: 'https://sotomayorconsulting.com/inicio/terminos/',
							svgname: 'ri:file-list-3-fill',
							span: 'Términos y condiciones',
						},
						{
							link: 'mailto:info@sotomayorconsulting.com',
							svgname: 'ri:lifebuoy-fill',
							span: 'Soporte',
						},
					].map((l) => (
						<a
							href={l.link}
							target="_blank"
							class={`flex items-center gap-3 rounded-md px-2.5 py-2 text-[13px] font-medium transition-colors ${inactiveClass}`}
						>
							<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
							<span>{l.span}</span>
						</a>
					))
				}
			</div>
		</nav>
	</div>
</aside>

<!-- Mobile backdrop -->
<div
	class="fixed inset-0 z-10 hidden bg-gray-900/50 lg:hidden dark:bg-gray-900/90"
	id="sidebarBackdrop"
></div>

<!-- ===== Desktop collapsible sidebar (>= lg) ===== -->
<aside
	id="sidebar-desktop"
	class="sb-desktop group/sb fixed top-16 left-0 z-20 hidden h-[calc(100vh-4rem)] flex-col border-r border-gray-200 bg-white lg:flex dark:border-gray-700/50 dark:bg-black-900"
	transition:persist="sidebar-desktop"
>
	<nav
		class:list={[
			'flex-1 overflow-y-auto overflow-x-hidden px-1.5 py-2',
			'scrollbar scrollbar-w-1.5 scrollbar-thumb-rounded-full',
			'scrollbar-thumb-gray-300 scrollbar-track-transparent',
			'dark:scrollbar-thumb-neutral-700',
		]}
	>
		<ul class="space-y-0.5">
			<li>
				<a
					href="/"
					class={`sb-link flex items-center gap-3 rounded-md px-2 py-1.75 text-[13px] font-medium transition-colors ${ruta === '/' ? activeClass : inactiveClass}`}
					title="Inicio"
				>
					<Icon name="ri:home-9-fill" class="h-5 w-5 shrink-0" />
					<span class="sb-label whitespace-nowrap">Inicio</span>
				</a>
			</li>
			{
				visibleMenu.map((l) => (
					<li>
						<a
							href={l.href}
							class={`sb-link flex items-center gap-3 rounded-md px-2 py-1.75 text-[13px] font-medium transition-colors ${ruta === l.href ? activeClass : inactiveClass}`}
							title={l.label}
						>
							<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
							<span class="sb-label whitespace-nowrap">{l.label}</span>
						</a>
					</li>
				))
			}
		</ul>

		<!-- Links externos -->
		<div class="mt-3 space-y-0.5 border-t border-gray-200 pt-3 dark:border-gray-700/50">
			{
				[
					{
						link: 'https://sotomayorconsulting.com/',
						svgname: 'ri:earth-line',
						span: 'Visita nuestra web',
					},
					{
						link: 'https://sotomayorconsulting.com/inicio/terminos/',
						svgname: 'ri:file-list-3-fill',
						span: 'Términos y condiciones',
					},
					{
						link: 'mailto:info@sotomayorconsulting.com',
						svgname: 'ri:lifebuoy-fill',
						span: 'Soporte',
					},
				].map((l) => (
					<a
						href={l.link}
						target="_blank"
						class={`sb-link flex items-center gap-3 rounded-md px-2 py-1.75 text-[13px] font-medium transition-colors ${inactiveClass}`}
						title={l.span}
					>
						<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
						<span class="sb-label whitespace-nowrap">{l.span}</span>
					</a>
				))
			}
		</div>
	</nav>

	<!-- Sidebar control trigger -->
	<div class="relative border-t border-gray-200 py-2 dark:border-gray-700/50">
		<button
			id="sb-control-btn"
			type="button"
			class="flex h-8 w-12 shrink-0 items-center justify-center rounded-md text-gray-400 transition-colors hover:bg-gray-50 hover:text-gray-600 dark:hover:bg-white/5 dark:hover:text-gray-200"
			title="Sidebar control"
		>
			<svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<rect x="3" y="3" width="18" height="18" rx="3" />
				<line x1="9" y1="3" x2="9" y2="21" />
			</svg>
		</button>

		<!-- Popover -->
		<div
			id="sb-control-popover"
			class="absolute bottom-full left-1 mb-2 hidden w-48 rounded-lg border border-gray-200 bg-white py-1.5 shadow-lg dark:border-gray-700 dark:bg-black-800"
		>
			<p class="px-3 py-1.5 text-xs font-medium text-gray-400 dark:text-gray-500">
				Sidebar control
			</p>
			<button data-sb-mode="expanded" type="button" class="sb-option flex w-full items-center gap-2 px-3 py-1.5 text-[13px] text-gray-600 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
				<span class="sb-dot hidden h-1.5 w-1.5 rounded-full bg-gray-900 dark:bg-white"></span>
				<span class="sb-dot-space h-1.5 w-1.5"></span>
				Expanded
			</button>
			<button data-sb-mode="collapsed" type="button" class="sb-option flex w-full items-center gap-2 px-3 py-1.5 text-[13px] text-gray-600 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
				<span class="sb-dot hidden h-1.5 w-1.5 rounded-full bg-gray-900 dark:bg-white"></span>
				<span class="sb-dot-space h-1.5 w-1.5"></span>
				Collapsed
			</button>
			<button data-sb-mode="hover" type="button" class="sb-option flex w-full items-center gap-2 px-3 py-1.5 text-[13px] text-gray-600 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
				<span class="sb-dot hidden h-1.5 w-1.5 rounded-full bg-gray-900 dark:bg-white"></span>
				<span class="sb-dot-space h-1.5 w-1.5"></span>
				Expand on hover
			</button>
		</div>
	</div>
</aside>

<style is:global>
	/* ── Sidebar transitions ── */
	.sb-desktop {
		transition: width 200ms ease-in-out;
	}
	.sb-label {
		transition: opacity 200ms ease-in-out;
	}

	/* ── Collapsed (default) ── */
	[data-sidebar='collapsed'] .sb-desktop {
		width: 3rem; /* 48px */
	}
	[data-sidebar='collapsed'] .sb-label {
		opacity: 0;
	}
	[data-sidebar='collapsed'] #main-content {
		margin-left: 3rem;
	}

	/* ── Expand on hover ── */
	[data-sidebar='hover'] .sb-desktop {
		width: 3rem;
	}
	[data-sidebar='hover'] .sb-desktop:hover {
		width: 15rem; /* 240px */
	}
	[data-sidebar='hover'] .sb-label {
		opacity: 0;
	}
	[data-sidebar='hover'] .sb-desktop:hover .sb-label {
		opacity: 1;
	}
	[data-sidebar='hover'] #main-content {
		margin-left: 3rem;
	}

	/* ── Expanded ── */
	[data-sidebar='expanded'] .sb-desktop {
		width: 15rem;
	}
	[data-sidebar='expanded'] .sb-label {
		opacity: 1;
	}
	[data-sidebar='expanded'] #main-content {
		margin-left: 15rem;
	}

	/* ── Mobile: no margin ── */
	@media (max-width: 1023px) {
		#main-content {
			margin-left: 0 !important;
		}
	}
</style>

<script>
	type SidebarMode = 'expanded' | 'collapsed' | 'hover';
	const STORAGE_KEY = 'sidebar-mode';

	// Clases de active/inactive (deben coincidir con las del template)
	const ACTIVE_CLASSES = ['bg-gray-100', 'text-gray-900', 'font-semibold', 'dark:bg-white/10', 'dark:text-white'];
	const INACTIVE_CLASSES = ['text-gray-500', 'hover:bg-gray-50', 'hover:text-gray-900', 'dark:text-gray-400', 'dark:hover:bg-white/5', 'dark:hover:text-gray-200'];

	/**
	 * Actualiza el estado activo de los links en ambos sidebars.
	 * Necesario porque con transition:persist el HTML no se reemplaza.
	 */
	function updateActiveLinks() {
		const currentPath = window.location.pathname;
		// Seleccionar links internos en ambos sidebars (no los externos con target=_blank)
		const sidebarLinks = document.querySelectorAll<HTMLAnchorElement>(
			'#sidebar a[href^="/"]:not([target]), #sidebar-desktop a.sb-link[href^="/"]:not([target])'
		);

		sidebarLinks.forEach((link) => {
			const href = link.getAttribute('href') || '';
			const isActive = href === currentPath;

			if (isActive) {
				INACTIVE_CLASSES.forEach((c) => link.classList.remove(c));
				ACTIVE_CLASSES.forEach((c) => link.classList.add(c));
			} else {
				ACTIVE_CLASSES.forEach((c) => link.classList.remove(c));
				INACTIVE_CLASSES.forEach((c) => link.classList.add(c));
			}
		});
	}

	function getSavedMode(): SidebarMode {
		const saved = localStorage.getItem(STORAGE_KEY);
		if (saved === 'expanded' || saved === 'collapsed' || saved === 'hover') {
			return saved;
		}
		return 'hover';
	}

	function applyMode(mode: SidebarMode) {
		document.documentElement.setAttribute('data-sidebar', mode);
		localStorage.setItem(STORAGE_KEY, mode);
		updateDots(mode);
	}

	function updateDots(mode: SidebarMode) {
		document.querySelectorAll<HTMLElement>('.sb-option').forEach((btn) => {
			const btnMode = btn.getAttribute('data-sb-mode');
			const dot = btn.querySelector('.sb-dot') as HTMLElement | null;
			const space = btn.querySelector('.sb-dot-space') as HTMLElement | null;
			if (dot && space) {
				if (btnMode === mode) {
					dot.classList.remove('hidden');
					space.classList.add('hidden');
				} else {
					dot.classList.add('hidden');
					space.classList.remove('hidden');
				}
			}
		});
	}

	/**
	 * Cierra el drawer mobile si quedó abierto tras una navegación con transition:persist.
	 * Flowbite aplica transform + clases al abrir; aquí revertimos manualmente.
	 */
	function closeMobileDrawer() {
		const sidebar = document.getElementById('sidebar');
		const backdrop = document.getElementById('sidebarBackdrop');

		if (sidebar) {
			// Revertir la transformación que Flowbite aplica al abrir el drawer
			sidebar.classList.add('-translate-x-full');
			sidebar.classList.remove('transform-none');
			sidebar.removeAttribute('aria-modal');
			sidebar.removeAttribute('role');

			// Quitar foco de cualquier link dentro del sidebar oculto
			// para evitar "Blocked aria-hidden on an element because its descendant retained focus"
			const focused = sidebar.querySelector(':focus') as HTMLElement | null;
			if (focused) focused.blur();
		}
		if (backdrop) {
			backdrop.classList.add('hidden');
		}

		// Remover el backdrop que Flowbite inyecta dinámicamente
		document.querySelectorAll('[drawer-backdrop]').forEach((el) => el.remove());
	}

	// Cleanup references para evitar listeners duplicados
	let cleanupFns: (() => void)[] = [];

	function initSidebarControl() {
		// Limpiar listeners anteriores (importante con View Transitions)
		cleanupFns.forEach((fn) => fn());
		cleanupFns = [];

		// Cerrar drawer mobile si quedó abierto de la navegación anterior
		closeMobileDrawer();

		applyMode(getSavedMode());

		// Actualizar active state de links (necesario con transition:persist)
		updateActiveLinks();

		const triggerBtn = document.getElementById('sb-control-btn');
		const popover = document.getElementById('sb-control-popover');
		if (!triggerBtn || !popover) return;

		const onTriggerClick = (e: Event) => {
			e.stopPropagation();
			popover.classList.toggle('hidden');
		};
		triggerBtn.addEventListener('click', onTriggerClick);
		cleanupFns.push(() =>
			triggerBtn.removeEventListener('click', onTriggerClick),
		);

		document.querySelectorAll<HTMLElement>('.sb-option').forEach((btn) => {
			const onOptionClick = () => {
				const mode = btn.getAttribute('data-sb-mode') as SidebarMode;
				applyMode(mode);
				popover.classList.add('hidden');
			};
			btn.addEventListener('click', onOptionClick);
			cleanupFns.push(() =>
				btn.removeEventListener('click', onOptionClick),
			);
		});

		const onDocClick = (e: Event) => {
			if (
				!popover.classList.contains('hidden') &&
				!popover.contains(e.target as Node) &&
				!triggerBtn.contains(e.target as Node)
			) {
				popover.classList.add('hidden');
			}
		};
		document.addEventListener('click', onDocClick);
		cleanupFns.push(() =>
			document.removeEventListener('click', onDocClick),
		);
	}

	// Con View Transitions, astro:page-load se dispara en cada navegación
	document.addEventListener('astro:page-load', initSidebarControl);
</script>
