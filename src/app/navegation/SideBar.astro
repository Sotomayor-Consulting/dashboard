---
import { Icon } from 'astro-icon/components';
import { menuItems } from '@lib/interfaz/itemsNavegacion';

const userRoles = Astro.locals.userRoles;

const visibleMenu = menuItems.filter(
	(item) =>
		(item.roles.includes('all') && userRoles.length > 0) ||
		item.roles.includes('todos') ||
		item.roles.some((r) => userRoles.includes(r)),
);

const ruta = Astro.url.pathname;
---

<div class="fixed top-1/2 z-40 hidden lg:block">
	<button
		type="button"
		class="to-black-600 from-black-900 bg-white-200 hover:bg-white-200 focus:ring-brand-medium dark:focus:ring-black-700 rounded-e-base group dark:hover:border-black-800 dark:hover:bg-black-900 box-border border border-transparent py-6 text-sm leading-5 font-medium text-white shadow-xs focus:ring-1 focus:outline-none dark:bg-linear-to-r"
		data-drawer-target="sidebar"
		data-drawer-show="sidebar"
		aria-controls="sidebar"
	>
		<Icon
			name="ri:arrow-right-s-fill"
			class="text-white-600 text-xl transition-transform duration-200 ease-in group-hover:translate-x-0.5 dark:text-white"
			title="Menu"
		/>
	</button>
</div>

<aside
	id="sidebar"
	class="bg-neutral-primary-soft border-default fixed top-0 left-0 z-40 h-screen w-64 -translate-x-full overflow-hidden border-e transition-transform"
	tabindex="-1"
	aria-labelledby="sidebar-label"
>
	<div
		class="bg-white-100 dark:bg-black-900 relative flex h-full min-h-0 flex-1 flex-col border-r border-neutral-300 pt-0 dark:border-gray-700"
	>
		<div
			class:list={[
				'flex flex-1 flex-col overflow-y-auto pt-5 pb-28',
				'scrollbar scrollbar-w-2 scrollbar-thumb-rounded-[0.1667rem]',
				'scrollbar-thumb-slate-200 scrollbar-track-gray-400',
				'dark:scrollbar-thumb-neutral-700 dark:scrollbar-track-neutral-800',
			]}
		>
			<div
				class="bg-white-100 dark:bg-black-900 scrollbar-none flex-1 space-y-1 overflow-auto px-3"
			>
				<div class="mb-5 flex items-center justify-start gap-1">
					<a href="/">
						<Icon
							name="logo-en-negro"
							class="block text-3xl dark:hidden"
							title="Logo Sotomayor Consulting"
						/>
						<Icon
							name="logo-en-blanco"
							class="mr-3 hidden text-3xl dark:block"
							title="Logo Sotomayor Consulting"
						/>
					</a>

					<button
						type="button"
						data-drawer-hide="sidebar"
						aria-controls="sidebar"
						class="text-body hover:text-heading hover:bg-neutral-tertiary rounded-base flex h-fit items-center justify-center bg-transparent p-2"
					>
						<Icon name="ri:close-line" class="h-5 w-5" />
						<span class="sr-only">Close menu</span>
					</button>
				</div>
				<ul class="space-y-2 overflow-hidden pb-2">
					<li>
						<a
							href="/"
							class={`flex items-center p-2 text-base text-white-800 rounded-lg hover:bg-gray-100 group dark:text-gray-200 dark:hover:bg-black-700 ${
								ruta === '/'
									? 'bg-white-200 dark:bg-black-700 translate-x-2.5 hover:translate-x-0 transition-transform duration-200'
									: 'hover:translate-x-2 transition-transform duration-200'
							}`}
						>
							<Icon
								name="ri:home-9-fill"
								class={`w-6 h-6 transition duration-75 group-hover:text-white-700 dark:group-hover:text-black-400 ${ruta === '/' ? 'dark:text-black-400 text-white-500' : 'dark:text-gray-400 text-white-700'}`}
							/>
							<span
								class={`ml-3 ${ruta === '/' ? 'dark:text-black-400 text-white-700' : 'dark:text-gray-400 text-gray-500'}`}
								sidebar-toggle-item
							>
								Inicio
							</span>
						</a>
					</li>

					<li>
						<button
							type="button"
							class="group flex w-full items-center rounded-lg p-2 text-base font-medium text-gray-900 transition duration-75 hover:bg-gray-100 dark:text-white dark:hover:bg-gray-700"
							aria-controls="dropdown-pages"
							data-collapse-toggle="dropdown-pages"
						>
							<Icon
								name="ri:apps-2-add-fill"
								class="h-6 w-6 shrink-0 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"
							/>
							<span class="ml-3 flex-1 text-left whitespace-nowrap">Menu</span>
							<svg
								aria-hidden="true"
								class="h-6 w-6"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
									clip-rule="evenodd"></path>
							</svg>
						</button>
						<ul id="dropdown-pages" class="ml-1 space-y-2 py-2">
							{
								visibleMenu &&
									visibleMenu.map((l) => {
										const isActive = ruta === l.href;

										return (
											<li>
												<a
													href={l.href}
													class={`group dark:hover:bg-black-700 flex items-center rounded-lg p-2 text-base text-gray-900 hover:bg-gray-100 dark:text-gray-200 ${
														isActive
															? 'dark:bg-black-700 translate-x-2.5 bg-gray-200 transition-transform duration-200 hover:translate-x-0'
															: 'transition-transform duration-200 hover:translate-x-2'
													}`}
												>
													<Icon
														name={l.svgname}
														class={`dark:group-hover:text-black-400 h-6 w-6 transition duration-75 group-hover:text-gray-900 ${isActive ? 'dark:text-black-400 text-white-700' : 'text-white-600 dark:text-gray-400'}`}
													/>
													<span
														class={`ml-3 ${isActive ? 'dark:text-black-400 text-white-700' : 'text-white-600 dark:text-gray-400'}`}
														sidebar-toggle-item
													>
														{l.label}
													</span>
												</a>
											</li>
										);
									})
							}
						</ul>
					</li>
				</ul>

				<div
					class="dark:border-black-600 border-white-500 space-y-2 border-t pt-2"
				>
					{
						[
							{
								link: 'https://sotomayorconsulting.com/',
								svgname: 'ri:earth-line',
								span: 'Visita nuestra web',
							},
							{
								link: 'https://sotomayorconsulting.com/inicio/terminos/',
								svgname: 'ri:file-list-3-fill',
								span: 'Términos y condiciones',
							},
							{
								link: 'mailto:info@sotomayorconsulting.com',
								svgname: 'ri:lifebuoy-fill',
								span: 'Soporte',
							},
						].map((l) => (
							<a
								href={l.link}
								target="_blank"
								class="group dark:hover:bg-black-700 flex items-center rounded-lg p-2 text-base text-gray-900 transition duration-75 hover:bg-gray-100 dark:text-gray-200"
							>
								<Icon
									name={l.svgname}
									class="text-white-600 h-6 w-6 shrink-0 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"
								/>
								<span class="ml-3" sidebar-toggle-item>
									{l.span}
								</span>
							</a>
						))
					}
				</div>
			</div>
		</div>
		<div
			class="bg-white-100 dark:bg-black-900 absolute bottom-0 left-0 hidden w-full justify-center space-x-4 p-4 lg:flex"
			sidebar-bottom-menu
		>
			<form action="/api/auth/signout">
				<button
					type="submit"
					data-tooltip-target="tooltip-cerrar"
					class="dark:hover:bg-black-700 inline-flex cursor-pointer justify-center rounded p-2 text-gray-500 hover:bg-gray-100 hover:text-red-600 dark:hover:text-red-600"
					role="menuitem"
					><svg
						xmlns="http://www.w3.org/2000/svg"
						class="h-6 w-6"
						viewBox="0 0 24 24"
						><path
							fill="currentColor"
							d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h6q.425 0 .713.288T12 4t-.288.713T11 5H5v14h6q.425 0 .713.288T12 20t-.288.713T11 21zm12.175-8H10q-.425 0-.712-.288T9 12t.288-.712T10 11h7.175L15.3 9.125q-.275-.275-.275-.675t.275-.7t.7-.313t.725.288L20.3 11.3q.3.3.3.7t-.3.7l-3.575 3.575q-.3.3-.712.288t-.713-.313q-.275-.3-.262-.712t.287-.688z"
						></path></svg
					></button
				>
			</form>
			<div
				id="tooltip-cerrar"
				role="tooltip"
				class="tooltip dark:bg-black-800 invisible absolute z-10 inline-block rounded-lg bg-neutral-500 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity duration-300"
			>
				Cerrar sesión
				<div class="tooltip-arrow" data-popper-arrow></div>
			</div>

			<a
				href="/settings/"
				data-tooltip-target="tooltip-settings"
				class="dark:hover:bg-black-700 inline-flex cursor-pointer justify-center rounded p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-900 dark:hover:text-white"
			>
				<svg
					class="h-6 w-6"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
					aria-label="Configurar"
				>
					<title>Configurar perfil</title>
					<path
						fill-rule="evenodd"
						d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z"
						clip-rule="evenodd"></path></svg
				>
			</a>
			<div
				id="tooltip-settings"
				role="tooltip"
				class="tooltip dark:bg-black-800 invisible absolute z-10 inline-block rounded-lg bg-neutral-500 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity duration-300"
			>
				Configuración
				<div class="tooltip-arrow" data-popper-arrow></div>
			</div>
		</div>
	</div>
</aside>

<div
	class="fixed inset-0 z-10 hidden bg-gray-900/50 dark:bg-gray-900/90"
	id="sidebarBackdrop"
>
</div>
