---
import { Icon } from 'astro-icon/components';
import { menuItems } from '@lib/interfaz/itemsNavegacion';

const userRoles = Astro.locals.userRoles;
const user = Astro.locals.user;
const userId = user?.id ?? '';
const userName = user?.user_metadata?.name ?? user?.email ?? 'Usuario';
const userEmail = user?.email ?? '';

const visibleMenu = menuItems.filter(
	(item) =>
		(item.roles.includes('all') && userRoles.length > 0) ||
		item.roles.includes('todos') ||
		item.roles.some((r) => userRoles.includes(r)),
);

const sortedMenu = [...visibleMenu].sort((a, b) => a.sequence - b.sequence);

const groupOrder = ['Get Started', 'Partner Hub', 'Admin', 'Servicios', 'Cuenta', 'General'];

const groupedMenu = sortedMenu.reduce(
	(acc, item) => {
		const menuItem = item as typeof item & { group?: string };
		const groupName = menuItem.group ?? 'General';
		if (!acc[groupName]) acc[groupName] = [];
		acc[groupName].push(item);
		return acc;
	},
	{} as Record<string, typeof sortedMenu>,
);

const visibleGroups = groupOrder
	.filter((groupName) => groupedMenu[groupName]?.length)
	.map((groupName) => ({
		title: groupName,
		items: groupedMenu[groupName] ?? [],
	}));

const ruta = Astro.url.pathname;

/* Clases reutilizables */
const activeClass =
	'bg-gray-100 text-gray-900 font-semibold dark:bg-black-600 dark:text-white';
const inactiveClass =
	'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-200';
---

<!-- ===== Mobile drawer (< lg) ===== -->
<aside
	id="sidebar"
	class="dark:bg-black-900 bg-white fixed top-0 left-0 z-40 h-screen w-60 -translate-x-full overflow-hidden border-r border-gray-200/60 transition-transform lg:hidden dark:border-gray-700/50"
	tabindex="-1"
	aria-label="Menú de navegación"
	transition:persist="sidebar-mobile"
>
	<div class="flex h-full flex-col">
		<!-- Logo + close -->
		<div class="flex items-center justify-between px-3 pt-5 pb-2">
			<div>
				<Icon
					name="logo-en-azul"
					class="block text-3xl dark:hidden"
					title="Logo Sotomayor Consulting"
				/>
				<Icon
					name="logo-en-blanco-alt"
					class="hidden text-3xl dark:block"
					title="Logo Sotomayor Consulting"
				/>
			</div>
			<button
				type="button"
				data-drawer-hide="sidebar"
				aria-controls="sidebar"
				class="flex items-center justify-center rounded-md p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-white/5 dark:hover:text-gray-200"
			>
				<Icon name="ri:close-line" class="h-5 w-5" />
				<span class="sr-only">Cerrar menú</span>
			</button>
		</div>

		<!-- Nav items -->
		<nav
			class:list={[
				'flex-1 overflow-x-hidden overflow-y-auto px-2 py-2',
				'scrollbar scrollbar-w-1.5 scrollbar-thumb-rounded-full',
				'scrollbar-thumb-gray-300 scrollbar-track-transparent',
				'dark:scrollbar-thumb-neutral-700',
			]}
		>
			<ul class="space-y-0.5">
				<li>
					<a
						href="/"
						class={`flex items-center gap-3 rounded-md px-2.5 py-2 text-[13px] font-medium transition-colors ${ruta === '/' ? activeClass : inactiveClass}`}
					>
						<Icon name="ri:home-9-line" class="h-5 w-5 shrink-0" />
						<span>Inicio</span>
					</a>
				</li>
				{
					visibleGroups.map((group) => (
					<li class="mt-1 pt-1">
							<p class="px-2.5 pt-1 text-[11px] font-semibold tracking-wide text-gray-400 uppercase dark:text-gray-500">
								{group.title}
							</p>
							<ul class="mt-1 space-y-0.5">
								{(group.items ?? []).map((l) => (
									<li>
										<a
											href={l.href}
											class={`flex items-center gap-3 rounded-md px-2.5 py-2 text-[13px] font-medium transition-colors ${ruta === l.href ? activeClass : inactiveClass}`}
										>
											<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
											<span>{l.label}</span>
										</a>
									</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>

			<!-- Links externos -->
			<div class="mt-1 space-y-0.5 pt-1.5">
				<p class="px-2.5 pb-1 text-[11px] font-semibold tracking-wide text-gray-400 uppercase dark:text-gray-500">
					Recursos
				</p>
				{
					[
						{
							link: 'https://sotomayorconsulting.com/',
							svgname: 'ri:earth-line',
							span: 'Visita nuestra web',
						},
						{
							link: 'https://sotomayorconsulting.com/inicio/terminos/',
							svgname: 'ri:file-list-3-line',
							span: 'Términos y condiciones',
						},
					].map((l) => (
						<a
							href={l.link}
							target="_blank"
							class={`flex items-center gap-3 rounded-md px-2.5 py-2 text-[13px] font-medium transition-colors ${inactiveClass}`}
						>
							<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
							<span>{l.span}</span>
						</a>
					))
				}
			</div>
		</nav>

		<div class="border-t border-gray-200/90 p-3 dark:border-gray-700/80">
			<details class="group">
				<summary class="flex list-none cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 transition-colors hover:bg-gray-100 dark:hover:bg-white/5">
					<img
						src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${userId}`}
						alt="Avatar"
						class="h-8 w-8 rounded-full border border-gray-200 dark:border-gray-700"
					/>
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium text-gray-800 dark:text-gray-100">{userName}</p>
						<p class="truncate text-xs text-gray-500 dark:text-gray-400">{userEmail}</p>
					</div>
					<Icon name="ri:arrow-down-s-line" class="user-menu-chevron h-4 w-4 text-gray-400 transition-transform" />
				</summary>
				<div class="mt-2 space-y-1 rounded-md p-1.5">
					<a
						href="/settings/"
						class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white"
					>
						<Icon name="ri:settings-3-line" class="h-4 w-4" />
						<span>Configuración</span>
					</a>
					<form action="/api/auth/signout" method="post">
						<button
							type="submit"
							class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm text-red-600 transition-colors hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10"
						>
							<Icon name="ri:logout-box-r-line" class="h-4 w-4" />
							<span>Cerrar sesión</span>
						</button>
					</form>
				</div>
			</details>
		</div>
	</div>
</aside>

<!-- Mobile backdrop -->
<div
	class="fixed inset-0 z-10 hidden bg-gray-900/50 lg:hidden dark:bg-gray-900/90"
	id="sidebarBackdrop"
>
</div>

<!-- ===== Desktop collapsible sidebar (>= lg) ===== -->
<aside
	id="sidebar-desktop"
	class="dark:bg-black-900 bg-white fixed top-14 left-0 z-20 hidden h-[calc(100vh-3.5rem)] w-60 flex-col border-r border-gray-300/90 box-border lg:flex dark:border-gray-600/90"
	transition:persist="sidebar-desktop"
>
	<nav
		class:list={[
			'flex-1 overflow-x-hidden overflow-y-auto px-1.5 py-2',
			'scrollbar scrollbar-w-1.5 scrollbar-thumb-rounded-full',
			'scrollbar-thumb-gray-300 scrollbar-track-transparent',
			'dark:scrollbar-thumb-neutral-700',
		]}
	>
		<ul class="space-y-0.5">
			<li>
				<a
					href="/"
					class={`sb-link flex items-center gap-3 rounded-md px-2 py-1.75 text-[13px] font-medium transition-colors ${ruta === '/' ? activeClass : inactiveClass}`}
					title="Inicio"
				>
					<Icon name="ri:home-9-line" class="h-5 w-5 shrink-0" />
					<span class="sb-label whitespace-nowrap">Inicio</span>
				</a>
			</li>
			{
				visibleGroups.map((group) => (
					<li class="mt-1 pt-1">
						<p class="sb-label px-2 pt-1 text-[11px] font-semibold tracking-wide text-gray-400 uppercase dark:text-gray-500">
							{group.title}
						</p>
						<ul class="mt-1 space-y-0.5">
							{(group.items ?? []).map((l) => (
								<li>
									<a
										href={l.href}
										class={`sb-link flex items-center gap-3 rounded-md px-2 py-1.75 text-[13px] font-medium transition-colors ${ruta === l.href ? activeClass : inactiveClass}`}
										title={l.label}
									>
										<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
										<span class="sb-label whitespace-nowrap">{l.label}</span>
									</a>
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>

		<!-- Links externos -->
		<div class="mt-1 space-y-0.5 pt-1.5">
			<p class="sb-label px-2 pb-1 text-[11px] font-semibold tracking-wide text-gray-400 uppercase dark:text-gray-500">
				Recursos
			</p>
			{
				[
					{
						link: 'https://sotomayorconsulting.com/',
						svgname: 'ri:earth-line',
						span: 'Visita nuestra web',
					},
					{
						link: 'https://sotomayorconsulting.com/inicio/terminos/',
						svgname: 'ri:file-list-3-line',
						span: 'Términos y condiciones',
					},
				].map((l) => (
					<a
						href={l.link}
						target="_blank"
						class={`sb-link flex items-center gap-3 rounded-md px-2 py-1.75 text-[13px] font-medium transition-colors ${inactiveClass}`}
						title={l.span}
					>
						<Icon name={l.svgname} class="h-5 w-5 shrink-0" />
						<span class="sb-label whitespace-nowrap">{l.span}</span>
					</a>
				))
			}
		</div>
	</nav>

	<div class="border-t border-gray-200/90 p-3 dark:border-gray-700/80">
		<details class="group">
			<summary class="flex list-none cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 transition-colors hover:bg-gray-100 dark:hover:bg-white/5">
				<img
					src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${userId}`}
					alt="Avatar"
					class="h-8 w-8 rounded-full border border-gray-200 dark:border-gray-700"
				/>
				<div class="min-w-0 flex-1">
					<p class="truncate text-sm font-medium text-gray-800 dark:text-gray-100">{userName}</p>
					<p class="truncate text-xs text-gray-500 dark:text-gray-400">{userEmail}</p>
				</div>
				<Icon name="ri:arrow-down-s-line" class="user-menu-chevron h-4 w-4 text-gray-400 transition-transform" />
			</summary>
			<div class="mt-2 space-y-1 rounded-md p-1.5">
				<a
					href="/settings/"
					class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white"
				>
					<Icon name="ri:settings-3-line" class="h-4 w-4" />
					<span>Configuración</span>
				</a>
				<form action="/api/auth/signout" method="post">
					<button
						type="submit"
						class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm text-red-600 transition-colors hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10"
					>
						<Icon name="ri:logout-box-r-line" class="h-4 w-4" />
						<span>Cerrar sesión</span>
					</button>
				</form>
			</div>
		</details>
	</div>
</aside>

<style is:global>
	#sidebar details > summary::-webkit-details-marker,
	#sidebar-desktop details > summary::-webkit-details-marker {
		display: none;
	}

	#sidebar details[open] .user-menu-chevron,
	#sidebar-desktop details[open] .user-menu-chevron {
		transform: rotate(180deg);
	}

	/* Sidebar fixed expanded width */
	:root {
		--sb-divider-x: 15rem;
	}
	#main-content {
		margin-left: 15rem;
	}

	/* ── Mobile: no margin ── */
	@media (max-width: 1023px) {
		#main-content {
			margin-left: 0 !important;
		}
	}
</style>

<script>
	const ACTIVE_CLASSES = [
		'bg-gray-100',
		'text-gray-900',
		'font-semibold',
		'dark:bg-black-600',
		'dark:text-white',
	];
	const INACTIVE_CLASSES = [
		'text-gray-600',
		'hover:bg-gray-100',
		'hover:text-gray-900',
		'dark:text-gray-400',
		'dark:hover:bg-white/5',
		'dark:hover:text-gray-200',
	];

	function updateActiveLinks() {
		const currentPath = window.location.pathname;
		const sidebarLinks = document.querySelectorAll<HTMLAnchorElement>(
			'#sidebar a[href^="/"]:not([target]), #sidebar-desktop a[href^="/"]:not([target])',
		);

		sidebarLinks.forEach((link) => {
			const href = link.getAttribute('href') || '';
			const isActive = href === currentPath;

			if (isActive) {
				INACTIVE_CLASSES.forEach((c) => link.classList.remove(c));
				ACTIVE_CLASSES.forEach((c) => link.classList.add(c));
			} else {
				ACTIVE_CLASSES.forEach((c) => link.classList.remove(c));
				INACTIVE_CLASSES.forEach((c) => link.classList.add(c));
			}
		});
	}

	function closeMobileDrawer() {
		const sidebar = document.getElementById('sidebar');
		const backdrop = document.getElementById('sidebarBackdrop');

		if (sidebar) {
			sidebar.classList.add('-translate-x-full');
			sidebar.classList.remove('transform-none');
			sidebar.removeAttribute('aria-modal');
			sidebar.removeAttribute('role');
			const focused = sidebar.querySelector(':focus') as HTMLElement | null;
			if (focused) focused.blur();
		}
		if (backdrop) backdrop.classList.add('hidden');
		document.querySelectorAll('[drawer-backdrop]').forEach((el) => el.remove());
	}

	function initSidebar() {
		closeMobileDrawer();
		updateActiveLinks();
	}

	document.addEventListener('astro:page-load', initSidebar);
</script>
