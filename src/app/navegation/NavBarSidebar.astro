---
import { Icon } from 'astro-icon/components';
import ColorModeSwitcher from '@components/display/ColorModeSwitcher.astro';
import logonotificaciones from '@assets/avatarSCI.png';
import { Picture } from 'astro:assets';

// Datos recibidos desde LayoutSidebar (ya consultados en paralelo)
const { usuario: usuarioProp, notificationsData: notifProp } = Astro.props;

const user = Astro.locals?.user;
const userId = user?.id;
const email = user?.email;

const usuario = usuarioProp ?? null;
const imagen = usuario; // avatar_url viene incluido en getUsuarioById (select *)
const { notifications, totalUnread } = notifProp ?? {
	notifications: [],
	totalUnread: 0,
};
---

<nav
	class="dark:bg-black-900/60 bg-white-50/80 fixed z-30 w-full border-b border-gray-200/60 backdrop-blur-md dark:border-gray-700/50 dark:backdrop-blur-md"
	transition:persist="navbar"
>
	<div class="px-3 py-3 lg:px-5 lg:pl-3">
		<div class="flex items-center justify-between">
			<div class="flex items-center justify-start">
				<button
					id="toggleSidebarMobile"
					data-drawer-target="sidebar"
					data-drawer-show="sidebar"
					aria-controls="sidebar"
					aria-expanded="true"
					class="cursor-pointer rounded p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:ring-2 focus:ring-gray-100 lg:hidden dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white dark:focus:bg-neutral-700 dark:focus:ring-gray-700"
				>
					<svg
						id="toggleSidebarMobileHamburger"
						class="h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
							clip-rule="evenodd"></path></svg
					>
					<svg
						id="toggleSidebarMobileClose"
						class="hidden h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path></svg
					>
				</button>
				<a href="/" class="ml-2 hidden md:mr-24 md:flex">
					<Icon
						name="isotipo_azul"
						class="block text-3xl dark:hidden"
						title="Logo Sotomayor Consulting"
					/>
					<Icon
						name="isotipo_blanco_alt"
						class="mr-3 hidden text-3xl dark:block"
						title="Logo Sotomayor Consulting"
					/>
				</a>
			</div>

			<div class="flex items-center">
				<!-- Dropdown menu -->
				<div
					id="dropdownNavbar"
					class="dark:bg-black-800 z-10 hidden w-44 divide-y divide-gray-100 rounded-lg bg-white shadow dark:divide-gray-600"
				>
					<ul
						class="py-2 text-sm text-gray-700 dark:text-gray-400"
						aria-labelledby="dropdownNavbarButton"
					>
						<li>
							<a
								href="#"
								class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								>Dashboard</a
							>
						</li>
						<li>
							<a
								href="/settings/"
								class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								>Settings</a
							>
						</li>
						<li>
							<a
								href="#"
								class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								>Earnings</a
							>
						</li>
					</ul>
					<div class="py-2">
						<a
							href="#"
							class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-600 dark:hover:text-white"
							>Sign out</a
						>
					</div>
				</div>
				<div>
					<!-- Notifications -->
					<button
						type="button"
						id="notifications-toggle"
						data-dropdown-toggle="notification-dropdown"
						class="relative rounded-lg p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:text-white dark:hover:bg-[#101522] dark:hover:text-white"
					>
						<span class="sr-only">Ver Notificaciones</span>
						<!-- Bell icon -->
						<svg
							class="h-6 w-6"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"
							></path></svg
						>
						{
							totalUnread > 0 && (
								<span class="absolute -inset-2 -top-2 inline-flex h-6 w-6 animate-pulse items-center justify-center rounded-full border-2 border-white bg-red-500 text-xs font-bold text-white dark:border-[#223848]">
									{totalUnread}
								</span>
							)
						}
					</button>
					<!-- Dropdown menu -->
					<div
						class="dark:bg-black-800 z-20 my-4 hidden max-w-sm min-w-[24rem] list-none divide-y divide-gray-100 overflow-hidden rounded-xl bg-white text-base shadow-lg dark:divide-gray-600"
						id="notification-dropdown"
					>
						<div
							class="dark:bg-black-800 block bg-gray-50 px-4 py-2 text-center text-base font-medium text-gray-700 dark:text-gray-400"
						>
							Notificaciones
						</div>
						<div
							id="notifications-list"
							class="scrollbar-thin scrollbar-thumb-neutral-400 h-96 overflow-y-auto"
						>
							{
								notifications.length === 0 ? (
									<div class="flex px-4 py-3 text-neutral-500 dark:text-neutral-500">
										No hay notificaciones
									</div>
								) : (
									notifications.map((notification: any) => (
										<div
											class="flex border-b px-4 py-3 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-[#101522]/5"
											data-id={notification.id}
										>
											<div class="shrink-0">
												<img
													src={logonotificaciones.src}
													width="44"
													height="44"
													alt="Logo notificación Sotomayor Consulting"
													class="rounded-full"
													loading="lazy"
												/>
											</div>
											<div class="w-full pl-3">
												<div class="mb-1.5 flex flex-col gap-2 text-sm font-normal text-gray-500 dark:text-gray-400">
													<span class="font-semibold text-gray-900 dark:text-white">
														{notification.message}
													</span>
													<a
														href={notification.link}
														target="_blank"
														class="dark:bg-black-400 dark:hover:bg-black-500 bg-black-600 hover:bg-black-700 focus:ring-brand-medium rounded-base group box-border flex w-fit items-center gap-1 border border-transparent px-2 py-1 text-sm leading-5 font-medium text-white shadow-xs focus:ring-4 focus:outline-none"
													>
														{notification.mensaje_link}
														<Icon
															name="ri:arrow-right-s-fill"
															class="transition-all delay-105 ease-in-out group-hover:translate-x-1"
														/>
													</a>
												</div>
												<div class="flex justify-between">
													<span class="text-xs text-gray-400">
														{new Date(
															notification.created_at,
														).toLocaleDateString()}
													</span>
													{!notification.is_read && (
														<button
															class="mark-as-read text-primary-600 hover:bg-primary-50 hover:text-primary-700 dark:hover:text-primary-400 inline-flex cursor-pointer rounded-lg px-2 py-1 text-xs font-medium dark:text-neutral-400"
															data-id={notification.id}
														>
															Marcar como leída
														</button>
													)}
												</div>
											</div>
										</div>
									))
								)
							}
						</div>
						<a
							href="/notificaciones"
							class="dark:bg-black-800 group text-black-600 hover:text-black-700 block bg-gray-50 py-2 text-center text-base font-normal hover:bg-gray-100 dark:text-white dark:hover:bg-[#192033]/50 dark:hover:underline"
						>
							<div class="inline-flex items-center gap-2">
								<Icon
									name="ri:eye-fill"
									class="group-hover:text-black-700 text-black-600 text-xl"
								/>
								Ver todo
							</div>
						</a>
					</div>
				</div>

				<ColorModeSwitcher />

				<!-- Profile -->
				<div class="ml-3 flex items-center">
					<div>
						<button
							type="button"
							class="flex rounded-full bg-gray-800 text-sm focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600"
							id="user-menu-button-2"
							aria-expanded="false"
							data-dropdown-toggle="dropdown-2"
						>
							<span class="sr-only">Open user menu</span>
							{
								imagen?.avatar_url === 'NULL' || !imagen?.avatar_url ? (
									<Picture
										src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${userId || ''}`}
										class="h-8 w-8 rounded-full"
										alt="avatar general aleatorio"
										loading="eager"
										inferSize={true}
									/>
								) : (
									<Picture
										class="h-8 w-8 rounded-full"
										src={imagen?.avatar_url}
										alt={`user avatar ${userId}`}
										loading="eager"
										inferSize={true}
									/>
								)
							}
						</button>
					</div>
					<!-- Dropdown menu -->
					<div
						class="dark:bg-black-800 z-50 my-4 hidden list-none divide-y divide-gray-100 rounded bg-white text-base shadow dark:divide-gray-600"
						id="dropdown-2"
					>
						<div class="px-4 py-3" role="none">
							<p class="text-sm text-gray-900 dark:text-white" role="none">
								{usuario?.nombre ?? ''}
								{usuario?.apellido ?? ''}
							</p>
							<p
								class="truncate text-sm font-medium text-gray-900 dark:text-gray-300"
								role="none"
							>
								{email}
							</p>
						</div>
						<ul class="py-1" role="none">
							<li>
								<a
									href="/pages/companias"
									class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white"
									role="menuitem">Mis empresas</a
								>
							</li>
							<li>
								<a
									href="/settings/"
									class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white"
									role="menuitem">Configuraciones</a
								>
							</li>
							<li>
								<form action="/api/auth/signout" method="post" class="w-full">
									<button
										type="submit"
										class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white"
										role="menuitem">Cerrar sesión</button
									>
								</form>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</nav>
<script
	type="module"
	define:vars={{
		SB_URL: import.meta.env.PUBLIC_SUPABASE_URL,
		SB_ANON: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
		USER_ID: user?.id ?? '',
	}}
	is:inline
>
	import { createBrowserClient } from 'https://esm.sh/@supabase/ssr@0.7.0';

	const start = async () => {
		const listEl = document.getElementById('notifications-list');
		const bellBtn = document.getElementById('notifications-toggle');
		if (!listEl || !bellBtn)
			return console.error(
				'[notifications] Falta #notifications-list o #notifications-toggle',
			);
		if (!SB_URL || !SB_ANON)
			return console.error('[notifications] Faltan claves Supabase');
		if (!USER_ID)
			return console.info('[notifications] Sin usuario; no suscribo');

		const supabase = createBrowserClient(SB_URL, SB_ANON, {
			isSingleton: true,
		});

		const getBadgeEl = () => bellBtn?.querySelector('span.inline-flex.w-6.h-6');
		const refreshBadgeFromDOM = () => {
			const unread = listEl.querySelectorAll('.mark-as-read').length;
			const existing = getBadgeEl();
			if (unread <= 0) return existing?.remove();
			if (!existing) {
				const b = document.createElement('span');
				b.className =
					'absolute inline-flex items-center justify-center w-6 h-6 text-xs font-bold text-white bg-red-500 border-2 border-white rounded-full -top-2 -end-2 dark:border-gray-900';
				bellBtn.appendChild(b);
				b.textContent = String(unread);
			} else {
				existing.textContent = String(unread);
			}
		};

		listEl.addEventListener('click', async (e) => {
			const btn = e.target.closest('.mark-as-read');
			if (!btn) return;
			const id = btn.getAttribute('data-id');

			btn.remove();
			refreshBadgeFromDOM();

			try {
				const formData = new FormData();
				formData.append('id', id);
				formData.append('estado_lectura', 'true');

				const res = await fetch('/api/update/update-notification', {
					method: 'POST',
					body: formData,
					credentials: 'include',
				});

				if (!res.ok) {
					const err = await res.text();
					console.error('[notifications] Error:', err);
				}
			} catch (error) {
				console.error('[notifications] marcar como leída error:', error);
			}
		});
		refreshBadgeFromDOM();
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start);
	} else {
		start();
	}
</script>
