---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logonotificaciones from '/src/assets/avatarSCI.png';
import ColorModeSwitcher from '@components/display/ColorModeSwitcher.astro';
import { getUsuarioAvatar, getUsuarioById } from '@lib/tablas/usuarios';
import { getNotifications } from '@lib/tablas/notificaciones';

const user = Astro.locals?.user;
const userId = user?.id;
const email = user?.email;

let imagen: any = null;
let usuario: any = null;
let notificationsData: any = { notifications: [], totalUnread: 0 };

if (user && userId) {
	[imagen, usuario, notificationsData] = await Promise.all([
		getUsuarioAvatar(userId),
		getUsuarioById(userId),
		getNotifications(userId),
	]);
}

const { notifications, totalUnread } = notificationsData;

export { notifications, totalUnread, user };
---

<nav
	class="fixed z-30 w-full bg-neutral-200 border-b border-neutral-300 dark:bg-[#101521] dark:border-gray-700"
>
	<div class="px-3 py-3 lg:px-5 lg:pl-3">
		<div class="flex items-center justify-between">
			<div class="flex items-center justify-start">
				<button
					id="toggleSidebarMobile"
					aria-expanded="true"
					aria-controls="sidebar"
					class="p-2 text-gray-600 rounded cursor-pointer lg:hidden hover:text-gray-900 hover:bg-gray-100 focus:bg-gray-100 dark:focus:bg-neutral-700 focus:ring-2 focus:ring-gray-100 dark:focus:ring-gray-700 dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white"
				>
					<svg
						id="toggleSidebarMobileHamburger"
						class="w-6 h-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
							clip-rule="evenodd"></path></svg
					>
					<svg
						id="toggleSidebarMobileClose"
						class="hidden w-6 h-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path></svg
					>
				</button>
				<a href="/" class="ml-2 md:mr-24 md:flex hidden">
					<Icon
						name="logo-en-negro"
						class="dark:hidden block text-3xl"
						title="Logo Sotomayor Consulting"
					/>
					<Icon
						name="logo-en-blanco"
						class="mr-3 hidden dark:block text-3xl"
						title="Logo Sotomayor Consulting"
					/>
				</a>
			</div>

			<div class="flex items-center">
				<!-- Dropdown menu -->
				<div
					id="dropdownNavbar"
					class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-44 dark:bg-[#192033] dark:divide-gray-600"
				>
					<ul
						class="py-2 text-sm text-gray-700 dark:text-gray-400"
						aria-labelledby="dropdownNavbarButton"
					>
						<li>
							<a
								href="#"
								class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								>Dashboard</a
							>
						</li>
						<li>
							<a
								href="/settings/"
								class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								>Settings</a
							>
						</li>
						<li>
							<a
								href="#"
								class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
								>Earnings</a
							>
						</li>
					</ul>
					<div class="py-2">
						<a
							href="#"
							class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-400 dark:hover:text-white"
							>Sign out</a
						>
					</div>
				</div>
				<div>
					<!-- Notifications -->
					<button
						type="button"
						id="notifications-toggle"
						data-dropdown-toggle="notification-dropdown"
						class="p-2 text-gray-500 rounded-lg hover:text-gray-900 hover:bg-gray-100 dark:text-white dark:hover:text-white dark:hover:bg-[#101522] relative"
					>
						<span class="sr-only">Ver Notificaciones</span>
						<!-- Bell icon -->
						<svg
							class="w-6 h-6"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"
							></path></svg
						>
						{
							totalUnread > 0 && (
								<span class="absolute inline-flex items-center justify-center w-6 h-6 text-xs font-bold text-white bg-red-500 border-2 border-neutral-300 rounded-full -top-2 -end-2 dark:border-[#223848] animate-pulse">
									{totalUnread}
								</span>
							)
						}
					</button>
					<!-- Dropdown menu -->
					<div
						class="z-20 z-50 hidden max-w-sm min-w-[24rem] my-4 overflow-hidden text-base list-none bg-white divide-y divide-gray-100 shadow-lg dark:divide-gray-600 dark:bg-[#192033] rounded-xl"
						id="notification-dropdown"
					>
						<div
							class="block px-4 py-2 text-base font-medium text-center text-gray-700 bg-gray-50 dark:bg-[#192033] dark:text-gray-400"
						>
							Notificaciones
						</div>
						<div
							id="notifications-list"
							class="overflow-y-auto h-96 scrollbar-thin scrollbar-thumb-neutral-400"
						>
							{
								notifications.length === 0 ? (
									<div class="flex px-4 py-3  dark:text-neutral-500 text-neutral-500">
										No hay notificaciones
									</div>
								) : (
									notifications.map((notification: any) => (
										<div
											class="flex px-4 py-3 border-b hover:bg-gray-100 dark:hover:bg-[#101522]/5 dark:border-gray-600"
											data-id={notification.id}
										>
											<div class="flex-shrink-0">
												<Image
													src={logonotificaciones}
													width="44"
													alt="Logo notificación Sotomayor Consulting"
													class="rounded-full"
													loading="lazy"
												/>
											</div>
											<div class="w-full pl-3">
												<div class="text-gray-500 font-normal text-sm mb-1.5 dark:text-gray-400 flex flex-col">
													<span class="font-semibold text-gray-900 dark:text-white">
														{notification.message}
													</span>
													<a
														href={notification.link}
														target="_blank"
														class="my-1 text-primary-500 hover:text-blue-600"
													>
														{notification.mensaje_link}
													</a>
												</div>
												<div class="flex justify-between">
													<span class="text-xs text-gray-400">
														{new Date(
															notification.created_at,
														).toLocaleDateString()}
													</span>
													{!notification.is_read && (
														<button
															class="mark-as-read text-xs font-medium text-[#8c681d] dark:text-neutral-400 inline-flex hover:dark:text-primary-400"
															data-id={notification.id}
														>
															Marcar como leída
														</button>
													)}
												</div>
											</div>
										</div>
									))
								)
							}
						</div>
						<a
							href="/notificaciones"
							class="block py-2 text-base font-normal text-center text-gray-900 bg-gray-50 hover:bg-gray-100 dark:bg-[#192033] dark:text-white dark:hover:underline"
						>
							<div class="inline-flex items-center">
								<svg
									class="w-5 h-5 mr-2"
									fill="currentColor"
									viewBox="0 0 20 20"
									xmlns="http://www.w3.org/2000/svg"
									><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path><path
										fill-rule="evenodd"
										d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z"
										clip-rule="evenodd"></path></svg
								>
								Ver todo
							</div>
						</a>
					</div>
				</div>

				<ColorModeSwitcher />

				<!-- Profile -->
				<div class="flex items-center ml-3">
					<div>
						<button
							type="button"
							class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600"
							id="user-menu-button-2"
							aria-expanded="false"
							data-dropdown-toggle="dropdown-2"
						>
							<span class="sr-only">Open user menu</span>
							{
								imagen?.avatar_url === 'NULL' || !imagen?.avatar_url ? (
									<Image
										src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${userId || ''}`}
										class="w-8 h-8 rounded-full"
										alt="avatar general aleatorio"
										loading="eager"
										inferSize={true}
									/>
								) : (
									<Image
										class="w-8 h-8 rounded-full"
										src={imagen?.avatar_url}
										alt={`user avatar ${userId}`}
										loading="eager"
										inferSize={true}
									/>
								)
							}
						</button>
					</div>
					<!-- Dropdown menu -->
					<div
						class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded shadow dark:bg-[#192033] dark:divide-gray-600"
						id="dropdown-2"
					>
						<div class="px-4 py-3" role="none">
							<p class="text-sm text-gray-900 dark:text-white" role="none">
								{usuario?.nombre ?? ''}
								{usuario?.apellido ?? ''}
							</p>
							<p
								class="text-sm font-medium text-gray-900 truncate dark:text-gray-300"
								role="none"
							>
								{email}
							</p>
						</div>
						<ul class="py-1" role="none">
							<li>
								<a
									href="/dashboard/"
									class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white"
									role="menuitem">Dashboard</a
								>
							</li>
							<li>
								<a
									href="/settings/"
									class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white"
									role="menuitem">Configuraciones</a
								>
							</li>
							<li>
								<form action="/api/auth/signout">
									<button
										type="submit"
										class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-600 dark:hover:text-white"
										role="menuitem">Cerrar sesión</button
									>
								</form>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</nav>
<script
	type="module"
	define:vars={{
		SB_URL: import.meta.env.PUBLIC_SUPABASE_URL,
		SB_ANON: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
		USER_ID: user?.id ?? '',
	}}
>
	import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

	const start = async () => {
		const listEl = document.getElementById('notifications-list');
		const bellBtn = document.getElementById('notifications-toggle');
		if (!listEl || !bellBtn)
			return console.error(
				'[notifications] Falta #notifications-list o #notifications-toggle',
			);
		if (!SB_URL || !SB_ANON)
			return console.error('[notifications] Faltan claves Supabase');
		if (!USER_ID)
			return console.info('[notifications] Sin usuario; no suscribo');

		const supabase = createClient(SB_URL, SB_ANON, {
			auth: { persistSession: true, autoRefreshToken: true },
		});

		const readCookie = (name) =>
			document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'))?.[2] ??
			null;

		const at = readCookie('sb-access-token'),
			rt = readCookie('sb-refresh-token');
		if (at && rt) {
			await supabase.auth.setSession({
				access_token: at,
				refresh_token: rt,
			});
		}

		const getBadgeEl = () => bellBtn?.querySelector('span.inline-flex.w-6.h-6');
		const refreshBadgeFromDOM = () => {
			const unread = listEl.querySelectorAll('.mark-as-read').length;
			const existing = getBadgeEl();
			if (unread <= 0) return existing?.remove();
			if (!existing) {
				const b = document.createElement('span');
				b.className =
					'absolute inline-flex items-center justify-center w-6 h-6 text-xs font-bold text-white bg-red-500 border-2 border-white rounded-full -top-2 -end-2 dark:border-gray-900';
				bellBtn.appendChild(b);
				b.textContent = String(unread);
			} else {
				existing.textContent = String(unread);
			}
		};

		listEl.addEventListener('click', async (e) => {
			const btn = e.target.closest('.mark-as-read');
			if (!btn) return;
			const id = btn.getAttribute('data-id');

			btn.remove();
			refreshBadgeFromDOM();

			const { error } = await supabase
				.from('notifications')
				.update({ is_read: true, leido_en: new Date().toISOString() })
				.eq('id', id)
				.eq('user_id', USER_ID);

			if (error) {
				console.error('[notifications] marcar como leída error:', error);
			}
		});

		refreshBadgeFromDOM();
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start);
	} else {
		start();
	}
</script>
