---
import { Icon } from 'astro-icon/components';
import ColorModeSwitcher from '@components/display/ColorModeSwitcher.astro';
import logonotificaciones from '@assets/avatarSCI.png';
import { menuItems } from '@lib/interfaz/itemsNavegacion';

// Datos recibidos desde LayoutSidebar (ya consultados en paralelo)
const { notificationsData: notifProp } = Astro.props;

const user = Astro.locals?.user;
const supabaseUrl =
	process.env.PUBLIC_SUPABASE_URL ?? import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey =
	process.env.PUBLIC_SUPABASE_ANON_KEY ??
	import.meta.env.PUBLIC_SUPABASE_ANON_KEY ??
	'';

const { notifications, totalUnread } = notifProp ?? {
	notifications: [],
	totalUnread: 0,
};

const pathname = Astro.url.pathname;

const humanize = (value: string) =>
	value
		.replaceAll('-', ' ')
		.replaceAll('_', ' ')
		.replace(/\b\w/g, (char: string) => char.toUpperCase());

const isUuid = (value: string) =>
	/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
		value,
	);

const segments = pathname.split('/').filter(Boolean);

const sectionLabel = (() => {
	const exactMatch = menuItems.find((item) => item.href === pathname);
	if (exactMatch) return exactMatch.label;

	const prefixMatch = menuItems.find(
		(item) => item.href !== '/' && pathname.startsWith(item.href),
	);
	if (prefixMatch) return prefixMatch.label;

	if (segments.length === 0) return 'Inicio';
	return humanize(segments[0] ?? 'Inicio');
})();

const breadcrumbItems = [
	{ label: 'Inicio', href: '/' },
	...segments.map((segment, index) => ({
		label: isUuid(segment) ? 'Detalle' : humanize(segment),
		href: `/${segments.slice(0, index + 1).join('/')}/`,
	})),
];

const quickActions = [
	{
		label: 'Feedback',
		href: 'mailto:info@sotomayorconsulting.com?subject=Feedback%20Dashboard',
		icon: 'ri:message-3-line',
	},
	{
		label: 'Soporte',
		href: 'mailto:info@sotomayorconsulting.com',
		icon: 'ri:customer-service-2-line',
	},
];
---

<nav
	id="navbar-sidebar"
	class="dark:bg-black-900 fixed top-0 right-0 left-0 z-30 h-14 w-full border-b border-gray-300/90 bg-white dark:border-gray-600/80"
	transition:persist="navbar"
>
	<div class="h-full pr-3 pl-0 lg:pr-5">
		<div class="flex h-full items-center justify-between">
			<div class="flex min-w-0 items-center justify-start">
				<button
					id="toggleSidebarMobile"
					data-drawer-target="sidebar"
					data-drawer-show="sidebar"
					aria-controls="sidebar"
					aria-expanded="true"
					class="cursor-pointer rounded p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:ring-2 focus:ring-gray-100 lg:hidden dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white dark:focus:bg-neutral-700 dark:focus:ring-gray-700"
				>
					<svg
						id="toggleSidebarMobileHamburger"
						class="h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
							clip-rule="evenodd"></path></svg
					>
					<svg
						id="toggleSidebarMobileClose"
						class="hidden h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path></svg
					>
				</button>

				<a href="/" class="ml-1 hidden md:mr-4 md:flex lg:hidden">
					<Icon
						name="isotipo_azul"
						class="block text-3xl dark:hidden"
						title="Logo Sotomayor Consulting"
					/>
					<Icon
						name="isotipo_blanco_alt"
						class="mr-3 hidden text-3xl dark:block"
						title="Logo Sotomayor Consulting"
					/>
				</a>

				<div
					class="hidden h-full items-center justify-center border-r border-gray-300/90 px-2 lg:flex dark:border-gray-600/80"
					style="width: var(--sb-divider-x, 3rem);"
				>
					<a href="/" class="flex items-center justify-center">
						<Icon
							name="isotipo_azul"
							class="block text-2xl dark:hidden"
							title="Logo Sotomayor Consulting"
						/>
						<Icon
							name="isotipo_blanco_alt"
							class="hidden text-2xl dark:block"
							title="Logo Sotomayor Consulting"
						/>
					</a>
				</div>

				<div class="hidden min-w-0 flex-col justify-center pl-4 lg:flex">
					<p
						class="text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-400"
					>
						{sectionLabel}
					</p>
					<nav
						aria-label="Breadcrumb"
						class="mt-0.5 flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400"
					>
						{
							breadcrumbItems.map((crumb, idx) => (
								<>
									{idx > 0 && (
										<Icon name="ri:arrow-right-s-line" class="h-3 w-3" />
									)}
									<a
										href={crumb.href}
										class:list={{
											'transition-colors hover:text-gray-700 dark:hover:text-gray-200': true,
											'font-semibold text-gray-900 dark:text-white':
												idx === breadcrumbItems.length - 1,
										}}
									>
										{crumb.label}
									</a>
								</>
							))
						}
					</nav>
				</div>
			</div>

			<div class="flex items-center gap-1.5">
				<div class="hidden items-center gap-1 pr-1 lg:flex">
					{
						quickActions.map((action) => (
							<a
								href={action.href}
								target={action.href.startsWith('http') ? '_blank' : undefined}
								rel={
									action.href.startsWith('http')
										? 'noreferrer noopener'
										: undefined
								}
								class="inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-xs font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white"
							>
								<Icon name={action.icon} class="h-5 w-5" />
								<span>{action.label}</span>
							</a>
						))
					}
				</div>
				<div
					class="mx-1 hidden h-5 w-px bg-gray-300/90 lg:block dark:bg-gray-600/80"
				>
				</div>
				<div>
					<!-- Notifications -->
					<button
						type="button"
						id="notifications-toggle"
						data-dropdown-toggle="notification-dropdown"
						class="relative inline-flex h-9 w-9 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 dark:text-gray-300 dark:hover:bg-[#101522] dark:hover:text-white"
					>
						<span class="sr-only">Ver Notificaciones</span>
						<!-- Bell icon -->
						<svg
							class="h-5 w-5"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"
							></path></svg
						>
						{
							totalUnread > 0 && (
								<span class="absolute -top-1.5 -right-1.5 inline-flex h-5 w-5 animate-pulse items-center justify-center rounded-full border-2 border-white bg-red-500 text-[10px] font-bold text-white dark:border-[#223848]">
									{totalUnread}
								</span>
							)
						}
					</button>
					<!-- Dropdown menu -->
					<div
						class="dark:bg-black-800 z-20 my-4 hidden max-w-sm min-w-[24rem] list-none divide-y divide-gray-100 overflow-hidden rounded-xl border border-gray-200 bg-white text-base dark:divide-gray-600 dark:border-gray-700"
						id="notification-dropdown"
					>
						<div
							class="dark:bg-black-800 block bg-gray-50 px-4 py-2 text-center text-base font-medium text-gray-700 dark:text-gray-400"
						>
							Notificaciones
						</div>
						<div
							id="notifications-list"
							class="scrollbar-thin scrollbar-thumb-neutral-400 h-96 overflow-y-auto"
						>
							{
								notifications.length === 0 ? (
									<div class="flex px-4 py-3 text-neutral-500 dark:text-neutral-500">
										No hay notificaciones
									</div>
								) : (
									notifications.map((notification: any) => (
										<div
											class="flex border-b px-4 py-3 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-[#101522]/5"
											data-id={notification.id}
										>
											<div class="shrink-0">
												<img
													src={logonotificaciones.src}
													width="44"
													height="44"
													alt="Logo notificación Sotomayor Consulting"
													class="rounded-full"
													loading="lazy"
												/>
											</div>
											<div class="w-full pl-3">
												<div class="mb-1.5 flex flex-col gap-2 text-sm font-normal text-gray-500 dark:text-gray-400">
													<span class="font-semibold text-gray-900 dark:text-white">
														{notification.message}
													</span>
													<a
														href={notification.link}
														target="_blank"
														class="dark:bg-black-400 dark:hover:bg-black-500 bg-black-600 hover:bg-black-700 focus:ring-brand-medium rounded-base group box-border flex w-fit items-center gap-1 border border-transparent px-2 py-1 text-sm leading-5 font-medium text-white shadow-xs focus:ring-4 focus:outline-none"
													>
														{notification.mensaje_link}
														<Icon
															name="ri:arrow-right-s-fill"
															class="transition-all delay-105 ease-in-out group-hover:translate-x-1"
														/>
													</a>
												</div>
												<div class="flex justify-between">
													<span class="text-xs text-gray-400">
														{new Date(
															notification.created_at,
														).toLocaleDateString()}
													</span>
													{!notification.is_read && (
														<button
															class="mark-as-read text-primary-600 hover:bg-primary-50 hover:text-primary-700 dark:hover:text-primary-400 inline-flex cursor-pointer rounded-lg px-2 py-1 text-xs font-medium dark:text-neutral-400"
															class="mark-as-read text-primary-600 hover:bg-primary-50 hover:text-primary-700 dark:hover:text-primary-400 inline-flex cursor-pointer rounded-lg px-2 py-1 text-xs font-medium dark:text-neutral-400"
															data-id={notification.id}
														>
															Marcar como leída
														</button>
													)}
												</div>
											</div>
										</div>
									))
								)
							}
						</div>
						<a
							href="/notifications"
							class="dark:bg-black-800 group text-black-600 hover:text-black-700 block bg-gray-50 py-2 text-center text-base font-normal hover:bg-gray-100 dark:text-white dark:hover:bg-[#192033]/50 dark:hover:underline"
						>
							<div class="inline-flex items-center gap-2">
								<Icon
									name="ri:eye-fill"
									class="group-hover:text-black-700 text-black-600 text-xl"
								/>
								Ver todo
							</div>
						</a>
					</div>
				</div>
				<div
					class="mx-0.5 hidden h-5 w-px bg-gray-300/90 lg:block dark:bg-gray-600/80"
				>
				</div>
				<ColorModeSwitcher />
			</div>
		</div>
	</div>
</nav>
<script
	type="module"
	define:vars={{
		SB_URL: supabaseUrl,
		SB_ANON: supabaseAnonKey,
		USER_ID: user?.id ?? '',
		TOTAL_UNREAD: totalUnread ?? 0,
	}}
	is:inline
>
	import { createBrowserClient } from 'https://esm.sh/@supabase/ssr@0.7.0';

	const start = async () => {
		const listEl = document.getElementById('notifications-list');
		const bellBtn = document.getElementById('notifications-toggle');
		if (!listEl || !bellBtn)
			return console.error(
				'[notifications] Falta #notifications-list o #notifications-toggle',
			);
		if (!SB_URL || !SB_ANON)
			return console.error('[notifications] Faltan claves Supabase');
		if (!USER_ID)
			return console.info('[notifications] Sin usuario; no suscribo');

		const supabase = createBrowserClient(SB_URL, SB_ANON, {
			isSingleton: true,
		});

		const getBadgeEl = () => bellBtn?.querySelector('span.inline-flex.w-6.h-6');
		const updateBadge = (count) => {
			const existing = getBadgeEl();
			if (count <= 0) return existing?.remove();
			if (!existing) {
				const b = document.createElement('span');
				b.className =
					'absolute inline-flex items-center justify-center w-5 h-5 text-[10px] font-bold text-white bg-red-500 border-2 border-white rounded-full -top-1.5 -end-1.5 dark:border-gray-900';
				bellBtn.appendChild(b);
				b.textContent = String(count);
			} else {
				existing.textContent = String(count);
			}
		};

		// Usar el valor del servidor directamente
		updateBadge(TOTAL_UNREAD);

		listEl.addEventListener('click', async (e) => {
			const btn = e.target.closest('.mark-as-read');
			if (!btn) return;
			const id = btn.getAttribute('data-id');

			// Actualizar el badge restando 1
			const currentCount = parseInt(getBadgeEl()?.textContent || '0');
			updateBadge(Math.max(0, currentCount - 1));

			try {
				const formData = new FormData();
				formData.append('id', id);
				formData.append('estado_lectura', 'true');

				const res = await fetch('/api/update/update-notification', {
					method: 'POST',
					body: formData,
					credentials: 'include',
				});

				if (!res.ok) {
					const err = await res.text();
					console.error('[notifications] Error:', err);
				}
			} catch (error) {
				console.error('[notifications] marcar como leída error:', error);
			}
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start);
	} else {
		start();
	}
</script>
