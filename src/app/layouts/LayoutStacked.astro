---
import FooterStacked from '../navegation/FooterStacked.astro';
import LayoutCommon from './LayoutCommon.astro';
import NavBarStacked from '../navegation/NavBarStacked.astro';
---

<LayoutCommon>
	<NavBarStacked />

	<div class="bg-white-100 dark:bg-black-800 flex overflow-hidden pt-16">
		<div
			id="main-content"
			class="relative z-10 mx-auto h-full min-h-screen w-full max-w-screen-2xl overflow-y-auto"
		>
			<div class="px-4 pt-6 2xl:px-0">
				<slot />
			</div>

			<FooterStacked />
		</div>
	</div>
</LayoutCommon>
