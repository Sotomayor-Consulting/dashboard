---
import FooterStacked from '../navegation/FooterStacked.astro';
import LayoutCommon from './LayoutCommon.astro';
import NavBarStacked from '../navegation/NavBarStacked.astro';
---

<LayoutCommon>
	<NavBarStacked />

	<div class="flex pt-16 overflow-hidden bg-neutral-200 dark:bg-black-800">
		<div
			id="main-content"
			class="relative w-full max-w-screen-2xl mx-auto h-full overflow-y-auto min-h-screen z-10"
		>
			<div class="px-4 pt-6 2xl:px-0">
				<slot />
			</div>

			<FooterStacked />
		</div>
	</div>
</LayoutCommon>
