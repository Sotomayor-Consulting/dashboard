---
import LayoutCommon from './LayoutCommon.astro';
import NavBarStacked from '../navegation/NavBarStacked.astro';
import { Image } from 'astro:assets';
import fondo from '/src/assets/edificios-fondo.avif';
---

<LayoutCommon>
	<NavBarStacked />

	<div class="relative flex overflow-hidden pt-16 bg-gray-50 dark:bg-black-800">
		<Image
			src={fondo}
			alt="Fondo edificios"
			class="absolute inset-0 z-0 h-[120%] w-full object-cover object-center opacity-15 sm:min-h-svh dark:opacity-15"
			loading="eager"
		/>
		<div
			id="main-content"
			class="relative z-10 mx-auto h-full min-h-[calc(100svh-4rem)] w-full max-w-screen-2xl"
		>
			<div class="px-4 pt-6 2xl:px-0">
				<slot />
			</div>
		</div>
	</div>
</LayoutCommon>
