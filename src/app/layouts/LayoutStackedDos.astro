---
import LayoutCommon from './LayoutCommon.astro';
import NavBarStacked from '../navegation/NavBarStacked.astro';
import { Image } from 'astro:assets';
import fondo from '@assets/edificios-fondo.avif';
---

<LayoutCommon>
	<NavBarStacked />

	<div class="dark:bg-black-800 flex overflow-hidden bg-gray-50 pt-16">
		<div class="">
			<Image
				src={fondo}
				alt="Fondo edificios"
				class="absolute z-0 h-[140%] w-full object-cover object-center opacity-10 sm:min-h-svh dark:opacity-10"
				loading="eager"
			/>
		</div>
		<div
			id="main-content"
			class="relative z-10 mx-auto h-full min-h-[calc(100svh-4rem)] w-full max-w-screen-2xl"
		>
			<div class="px-4 pt-6 2xl:px-0">
				<slot />
			</div>
		</div>
	</div>
</LayoutCommon>
