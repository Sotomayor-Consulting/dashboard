---
import '../../styles/global.css';
import pkg from '../../../package.json' assert { type: 'json' };
import { url } from '../../lib/data.js';

import { SITE_TITLE } from '../constants.js';

const { class: clazz } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{SITE_TITLE} — v{pkg.version}</title>

		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pkg.description} />
		<meta name="" content={pkg.description} />
		<link rel="icon" type="image/svg+xml" href="/src/assets/icono.svg" />
		<link
			rel="sitemap"
			type="application/xml"
			href={url('sitemap-index.xml')}
		/>

		<meta name="author" content="Sotomayor Consulting" />

		<script is:inline>
			if (
				localStorage.getItem('color-theme') === 'dark' ||
				(!('color-theme' in localStorage) &&
					window.matchMedia('(prefers-color-scheme: dark)').matches)
			) {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
		</script>
	</head>
	<body class:list={[clazz, 'bg-gray-50 dark:bg-[#192033]']}>
		<slot />
	</body>
</html>

<script>
	import 'flowbite';
</script>

<style is:global>
	/* Scrollbar styling (reemplaza tailwind-scrollbar plugin incompatible con v4) */
	body {
		scrollbar-width: thin;
		scrollbar-color: #9ca3af #e2e8f0;
	}
	:where(.dark) body {
		scrollbar-color: #374151 #111827;
	}
	body::-webkit-scrollbar {
		width: 0.75rem;
	}
	body::-webkit-scrollbar-track {
		background: #e2e8f0;
	}
	body::-webkit-scrollbar-thumb {
		background: #9ca3af;
		border-radius: 0.25rem;
	}
	:where(.dark) body::-webkit-scrollbar-track {
		background: #111827;
	}
	:where(.dark) body::-webkit-scrollbar-thumb {
		background: #374151;
	}
</style>
