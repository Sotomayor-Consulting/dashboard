---
//import FooterSidebar from './FooterSidebar.astro';
import Banner from '../components/Banner.astro';
import BannerPartner from '../components/Banner_partner_profile.astro';
import BannerIncorporacion from '../components/Banner_formulario_de_incorporacion.astro';
import LayoutCommon from './LayoutCommon.astro';
import NavBarSidebar from './NavBarSidebar.astro';
import SideBar from './SideBar.astro';
---

<LayoutCommon>
	<NavBarSidebar />

	<SideBar />

	<div class="flex pt-16 overflow-hidden bg-neutral-200 dark:bg-[#101521]">
		<div
			id="main-content"
			class="relative w-full h-full bg-neutral-200 lg:ml-64 dark:bg-[#101521] min-h-screen"
		>
			<Banner />
			<BannerPartner />
			<BannerIncorporacion />
			<slot />
		</div>
	</div>
</LayoutCommon>
