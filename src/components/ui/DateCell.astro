---
/**
 * Celda de fecha formateada en espanol (dd-mm-yyyy).
 *
 * Uso:
 * <DateCell date={item.created_at} />
 */
interface Props {
	/** Fecha como string ISO o Date */
	date: string | Date | null | undefined;
	/** Formato de locale. Default: 'es-ES' */
	locale?: string;
}

const { date, locale = 'es-ES' } = Astro.props;

const formatted = date
	? new Date(date)
			.toLocaleDateString(locale, {
				day: '2-digit',
				month: '2-digit',
				year: 'numeric',
			})
			.replace(/\//g, '-')
	: '—';
---

<span>{formatted}</span>
