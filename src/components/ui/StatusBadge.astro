---
/**
 * Badge de estado con punto de color.
 * Muestra un circulo verde/rojo/naranja junto con el texto del estado.
 *
 * Uso:
 * <StatusBadge active={user.estado === 'activo'} label={user.estado} />
 * <StatusBadge active={pago.leido} activeLabel="Leido" inactiveLabel="No leido" />
 */
interface Props {
	/** Determina si el estado es activo (verde) o inactivo (rojo) */
	active: boolean;
	/** Texto a mostrar. Si no se provee, usa activeLabel/inactiveLabel */
	label?: string;
	/** Texto cuando active=true. Default: 'Activo' */
	activeLabel?: string;
	/** Texto cuando active=false. Default: 'Inactivo' */
	inactiveLabel?: string;
	/** Color del punto activo. Default: 'bg-green-400' */
	activeColor?: string;
	/** Color del punto inactivo. Default: 'bg-red-500' */
	inactiveColor?: string;
}

const {
	active,
	label,
	activeLabel = 'Activo',
	inactiveLabel = 'Inactivo',
	activeColor = 'bg-green-400',
	inactiveColor = 'bg-red-500',
} = Astro.props;

const displayLabel = label ?? (active ? activeLabel : inactiveLabel);
const dotColor = active ? activeColor : inactiveColor;
---

<div class="flex items-center">
	<div class:list={['h-2.5 w-2.5 rounded-full mr-2', dotColor]} />
	<span>{displayLabel}</span>
</div>
