---
import { Icon } from 'astro-icon/components';

interface Props {
	buttons: {
		label: string;
		icon: string;
		active: boolean;
		link: string;
	}[];
}

const { buttons } = Astro.props;
---

<ul
	class="mt-4 inline-flex w-full flex-wrap items-center gap-1 rounded-lg border border-gray-200 bg-white p-1 text-sm font-medium shadow-sm shadow-gray-200/70 dark:border-gray-700 dark:bg-black-900 dark:shadow-none md:w-auto"
>
	{
		buttons.map((li, idx) => (
			<>
				{idx > 0 && (
					<li
						aria-hidden="true"
						class="mx-1 hidden h-6 w-px self-center bg-gray-300/90 dark:bg-gray-600/80 md:block"
					></li>
				)}
				<li class="m-0">
					<a
						href={li.link}
						class:list={{
							'inline-flex w-full items-center gap-2 rounded-md px-3 py-2 transition-colors md:w-auto':
								true,
							'bg-gray-100 text-gray-900 shadow-sm dark:bg-black-700 dark:text-white':
								li.active === true,
							'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white':
								li.active === false,
						}}
						aria-current={li.active ? 'page' : undefined}
					>
						<Icon name={li.icon} class="h-4 w-4" />
						{li.label}
					</a>
				</li>
			</>
		))
	}
</ul>
