---
/**
 * Avatar con fallback a DiceBear.
 * Si no hay avatar_url o es 'NULL', genera un avatar con DiceBear.
 *
 * Uso:
 * <AvatarCell src={user.avatar_url} name={user.nombre} />
 */
interface Props {
	/** URL del avatar. Si es null/undefined/'NULL', usa DiceBear */
	src: string | null | undefined;
	/** Nombre para el alt text y seed de DiceBear */
	name: string;
	/** Tamano del avatar. Default: 'w-10 h-10' */
	size?: string;
}

const { src, name, size = 'w-10 h-10' } = Astro.props;

const hasAvatar = src && src !== 'NULL';
const imgSrc = hasAvatar
	? src
	: `https://api.dicebear.com/9.x/thumbs/svg?seed=${encodeURIComponent(name)}`;
---

<img
	class:list={[size, 'rounded-full']}
	src={imgSrc}
	alt={`Avatar de ${name}`}
	loading="lazy"
/>
