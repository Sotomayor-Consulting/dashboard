---
interface Props {
	/** ID del elemento <table>. Default: 'myTable' */
	id?: string;
	/** Array de strings con los nombres de las columnas */
	headers: string[];
	/** Mensaje cuando no hay filas. Default: 'No hay registros' */
	noRowsMessage?: string;
	/** Mensaje cuando la busqueda no encuentra resultados */
	noResultsMessage?: string;
	/** Filas por pagina. Default: 25 */
	perPage?: number;
	/** Opciones de filas por pagina */
	perPageSelect?: number[];
	/** Habilitar busqueda. Default: true */
	searchable?: boolean;
	/** Clase CSS adicional para el <table> */
	class?: string;
}

const {
	id = 'myTable',
	headers,
	noRowsMessage = 'No hay registros',
	noResultsMessage = 'No se encontraron resultados',
	perPage = 25,
	perPageSelect = [5, 10, 25, 50],
	searchable = true,
	class: className = '',
} = Astro.props;
---

<div
	class="space-y-3"
	data-shadcn-table
	data-no-rows={noRowsMessage}
	data-no-results={noResultsMessage}
	data-per-page={perPage}
	data-searchable={searchable}
>
	<div
		class="dark:bg-black-800 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-700"
	>
		<div class:list={['relative w-full max-w-sm', searchable ? '' : 'hidden']}>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="16"
				height="16"
				viewBox="0 0 24 24"
				class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-gray-400"
			>
				<path
					fill="currentColor"
					d="M11 2c4.968 0 9 4.032 9 9s-4.032 9-9 9s-9-4.032-9-9s4.032-9 9-9m0 16c3.867 0 7-3.133 7-7s-3.133-7-7-7s-7 3.133-7 7s3.133 7 7 7m8.485.071l2.829 2.828l-1.415 1.415l-2.828-2.829z"
				/>
			</svg>
			<input
				type="search"
				data-role="search-input"
				placeholder="Buscar..."
				class="dark:bg-black-700 block w-full rounded-lg border border-gray-200 bg-white py-2 pr-3 pl-9 text-sm text-gray-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none dark:border-gray-600 dark:text-gray-200 dark:focus:border-blue-400 dark:focus:ring-blue-800"
			/>
		</div>

		<div class="ml-auto flex items-center gap-2">
			<label class="text-xs font-medium text-gray-500 dark:text-gray-400">
				Filas
			</label>
			<select
				data-role="per-page-select"
				class="dark:bg-black-700 rounded-lg border border-gray-200 bg-white px-2.5 py-2 text-sm text-gray-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 focus:outline-none dark:border-gray-600 dark:text-gray-200 dark:focus:border-blue-400 dark:focus:ring-blue-800"
			>
				{
					perPageSelect.map((option) => (
						<option value={option} selected={option === perPage}>
							{option}
						</option>
					))
				}
			</select>
		</div>
	</div>

	<div
		class="dark:bg-black-800 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-xs dark:border-gray-700"
	>
		<div class="overflow-x-auto">
			<table
				id={id}
				class:list={[
					'min-w-full divide-y divide-gray-200/80 dark:divide-gray-700/60',
					className,
				]}
			>
				<thead class="bg-gray-50 dark:bg-[#28314c]">
					<tr>
						{
							headers.map((th, index) => (
								<th
									scope="col"
									class="p-4 text-left text-[11px] font-semibold tracking-wider whitespace-nowrap text-gray-500 uppercase dark:text-gray-400"
								>
									<button
										type="button"
										class="inline-flex items-center gap-1 uppercase"
										data-sort-index={index}
										aria-label={`Ordenar por ${th}`}
									>
										{th}
										<span
											class="text-xs leading-none opacity-60"
											data-sort-indicator={index}
											>↕</span
										>
									</button>
								</th>
							))
						}
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100 dark:divide-gray-700/50">
					<slot />
				</tbody>
			</table>
		</div>
	</div>

	<div class="flex flex-wrap items-center justify-between gap-2">
		<p class="text-xs text-gray-500 dark:text-gray-400" data-role="table-info">
			—
		</p>
		<div class="flex items-center gap-2">
			<button
				type="button"
				data-role="prev-page"
				class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:bg-[#28314c] dark:text-gray-200 dark:hover:bg-[#334164]"
			>
				Anterior
			</button>
			<button
				type="button"
				data-role="next-page"
				class="rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:bg-[#28314c] dark:text-gray-200 dark:hover:bg-[#334164]"
			>
				Siguiente
			</button>
		</div>
	</div>
</div>

<script is:inline>
	function normalizeText(value) {
		return (value || '')
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.toLowerCase()
			.trim();
	}

	function initShadcnDataTables() {
		const tables = document.querySelectorAll('[data-shadcn-table]');

		tables.forEach((root) => {
			if (!(root instanceof HTMLElement) || root.dataset.dtInit === '1') return;

			const table = root.querySelector('table');
			if (!(table instanceof HTMLTableElement)) return;
			const tbody = table.tBodies[0];
			if (!(tbody instanceof HTMLTableSectionElement)) return;

			const searchInput = root.querySelector('[data-role="search-input"]');
			const perPageSelect = root.querySelector('[data-role="per-page-select"]');
			const infoEl = root.querySelector('[data-role="table-info"]');
			const prevBtn = root.querySelector('[data-role="prev-page"]');
			const nextBtn = root.querySelector('[data-role="next-page"]');
			const sortButtons = Array.from(
				root.querySelectorAll('[data-sort-index]'),
			).filter((item) => item instanceof HTMLButtonElement);
			const sortIndicators = Array.from(
				root.querySelectorAll('[data-sort-indicator]'),
			).filter((item) => item instanceof HTMLElement);

			const noRowsMessage = root.dataset.noRows || 'No hay registros';
			const noResultsMessage =
				root.dataset.noResults || 'No se encontraron resultados';
			const searchable = root.dataset.searchable !== 'false';
			const initialPerPage = Number.parseInt(root.dataset.perPage || '25', 10);

			const allRows = Array.from(tbody.querySelectorAll(':scope > tr')).filter(
				(row) => row instanceof HTMLTableRowElement,
			);
			const state = {
				query: '',
				page: 1,
				perPage: Number.isFinite(initialPerPage) ? initialPerPage : 25,
				sortIndex: null,
				sortDirection: 'asc',
			};

			const emptyRow = document.createElement('tr');
			emptyRow.dataset.emptyState = '1';
			emptyRow.className = 'hidden';
			emptyRow.innerHTML = `<td class="h-16 px-4 text-center text-sm text-gray-500 dark:text-gray-400" colspan="${Math.max(
				1,
				table.tHead?.rows?.[0]?.cells?.length || 1,
			)}"></td>`;
			tbody.appendChild(emptyRow);

			const collator = new Intl.Collator('es', {
				numeric: true,
				sensitivity: 'base',
			});

			function updateSortUi() {
				sortIndicators.forEach((indicator) => {
					const index = Number.parseInt(
						indicator.getAttribute('data-sort-indicator') || '-1',
						10,
					);
					if (index !== state.sortIndex) {
						indicator.textContent = '↕';
						return;
					}
					indicator.textContent = state.sortDirection === 'asc' ? '↑' : '↓';
				});
			}

			function setEmptyState(message) {
				allRows.forEach((row) => {
					row.hidden = true;
				});
				const cell = emptyRow.querySelector('td');
				if (cell) cell.textContent = message;
				emptyRow.classList.remove('hidden');
			}

			function hideEmptyState() {
				emptyRow.classList.add('hidden');
			}

			function applyTableState() {
				let filteredRows = allRows;
				const normalizedQuery = normalizeText(state.query);

				if (normalizedQuery.length > 0) {
					filteredRows = allRows.filter((row) =>
						normalizeText(row.textContent || '').includes(normalizedQuery),
					);
				}

				if (state.sortIndex !== null) {
					filteredRows = filteredRows
						.map((row, originalIndex) => ({ row, originalIndex }))
						.sort((a, b) => {
							const aText =
								a.row.cells[state.sortIndex]?.textContent?.trim() || '';
							const bText =
								b.row.cells[state.sortIndex]?.textContent?.trim() || '';
							const result = collator.compare(aText, bText);
							if (result === 0) return a.originalIndex - b.originalIndex;
							return state.sortDirection === 'asc' ? result : -result;
						})
						.map((item) => item.row);
				}

				const total = filteredRows.length;
				const hasOriginalRows = allRows.length > 0;

				if (!hasOriginalRows) {
					setEmptyState(noRowsMessage);
					if (infoEl instanceof HTMLElement) infoEl.textContent = noRowsMessage;
					if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = true;
					if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = true;
					updateSortUi();
					return;
				}

				if (total === 0) {
					setEmptyState(normalizedQuery ? noResultsMessage : noRowsMessage);
					if (infoEl instanceof HTMLElement)
						infoEl.textContent = normalizedQuery
							? noResultsMessage
							: noRowsMessage;
					if (prevBtn instanceof HTMLButtonElement) prevBtn.disabled = true;
					if (nextBtn instanceof HTMLButtonElement) nextBtn.disabled = true;
					updateSortUi();
					return;
				}

				hideEmptyState();
				const totalPages = Math.max(1, Math.ceil(total / state.perPage));
				if (state.page > totalPages) state.page = totalPages;

				const start = (state.page - 1) * state.perPage;
				const end = Math.min(start + state.perPage, total);
				const visibleRows = new Set(filteredRows.slice(start, end));

				allRows.forEach((row) => {
					row.hidden = !visibleRows.has(row);
				});

				if (infoEl instanceof HTMLElement) {
					infoEl.textContent = `Mostrando ${start + 1}-${end} de ${total} registro(s)`;
				}
				if (prevBtn instanceof HTMLButtonElement) {
					prevBtn.disabled = state.page <= 1;
				}
				if (nextBtn instanceof HTMLButtonElement) {
					nextBtn.disabled = state.page >= totalPages;
				}

				updateSortUi();
			}

			if (searchable && searchInput instanceof HTMLInputElement) {
				searchInput.addEventListener('input', () => {
					state.query = searchInput.value;
					state.page = 1;
					applyTableState();
				});
			}

			if (perPageSelect instanceof HTMLSelectElement) {
				perPageSelect.value = String(state.perPage);
				perPageSelect.addEventListener('change', () => {
					const nextPerPage = Number.parseInt(perPageSelect.value, 10);
					state.perPage = Number.isFinite(nextPerPage) ? nextPerPage : 25;
					state.page = 1;
					applyTableState();
				});
			}

			if (prevBtn instanceof HTMLButtonElement) {
				prevBtn.addEventListener('click', () => {
					state.page = Math.max(1, state.page - 1);
					applyTableState();
				});
			}

			if (nextBtn instanceof HTMLButtonElement) {
				nextBtn.addEventListener('click', () => {
					state.page += 1;
					applyTableState();
				});
			}

			sortButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const sortIndex = Number.parseInt(
						button.getAttribute('data-sort-index') || '-1',
						10,
					);
					if (!Number.isFinite(sortIndex) || sortIndex < 0) return;

					if (state.sortIndex === sortIndex) {
						state.sortDirection =
							state.sortDirection === 'asc' ? 'desc' : 'asc';
					} else {
						state.sortIndex = sortIndex;
						state.sortDirection = 'asc';
					}
					state.page = 1;
					applyTableState();
				});
			});

			root.dataset.dtInit = '1';
			applyTableState();
		});
	}

	initShadcnDataTables();
	document.addEventListener('astro:page-load', initShadcnDataTables);
</script>
