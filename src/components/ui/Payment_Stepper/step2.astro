---
interface Props {
	estados: Array<{
		Estado: string;
	}>;
}

const { estados } = Astro.props;
---

<div id="paso2" class="hidden w-full">
	<div>
		<div class="px-10 py-10 text-center">
			<h3 class="text-2xl text-neutral-800 lg:text-3xl dark:text-white">
				Elija el estado de registro
			</h3>
			<p class="text-neutral-700 dark:text-gray-400">Estados populares</p>
			<ol class="mt-3 flex justify-center">
				<li>
					<span
						class="bg-black-500 me-2 rounded-full px-2.5 py-0.5 text-sm font-medium text-white dark:bg-[#134aed] dark:text-white"
						>Florida</span
					>
				</li>
				<li>
					<span
						class="bg-black-500 me-2 rounded-full px-2.5 py-0.5 text-sm font-medium text-white dark:bg-[#134aed] dark:text-white"
						>Wyoming</span
					>
				</li>
			</ol>
		</div>
		<ul class="grid w-full place-items-center gap-3">
			<li class="w-4/5 md:w-3/5">
				<div id="seleccionar" class="mt-5">
					<select
						id="estados"
						name="estado_de_empresa"
						class="dark:bg-black-900 border-black-500 bg-white-50 text-black-900 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border hover:bg-white hover:text-neutral-800 lg:p-5 dark:text-gray-400 dark:hover:bg-[#192033] dark:hover:text-white"
						required
					>
						{
							estados?.map((es) => (
								<option value={es.Estado} selected={es.Estado === 'Florida'}>
									{es.Estado}
								</option>
							))
						}
					</select>
				</div>
			</li>
		</ul>
		<div class="my-8 grid w-full grid-cols-2 gap-2 px-10 lg:px-36">
			<button
				type="button"
				id="atrasBtn"
				class="from-black-400 via-black-500 to-black-600 w-full justify-self-center rounded-lg bg-linear-to-r px-5 py-2.5 text-center text-xs font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:focus:ring-neutral-500"
				>Volver</button
			>
			<button
				type="button"
				id="continuarBtn2"
				class="from-black-400 via-black-500 to-black-600 w-full justify-self-center rounded-lg bg-linear-to-r px-5 py-2.5 text-center text-xs font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:focus:ring-neutral-500"
				>Continuar</button
			>
		</div>
	</div>
</div>
