---
interface Props {
	estados: Array<{
		Estado: string;
	}>;
}

const { estados } = Astro.props;
---

<div id="paso2" class="hidden w-full">
	<div>
		<div class="px-10 py-10 text-center">
			<span
				class="bg-primary-gold/20 text-brand-gold mb-4 inline-block rounded-full px-3 py-1 text-xs font-bold tracking-widest uppercase"
				>Paso 02</span
			>
			<h3 class="text-2xl text-neutral-800 lg:text-3xl dark:text-white">
				Elija el estado de registro
			</h3>
			<p class="text-neutral-700 dark:text-gray-400">Estados populares</p>
			<ol class="mt-3 flex justify-center gap-2">
				<li>
					<button
						class="bg-primary-gold/20 border-gold/50 text-gold hover:bg-gold group flex items-center space-x-2 rounded-full border px-6 py-2 font-bold transition-all hover:text-white"
					>
						<span
							class="bg-primary-gold h-2 w-2 rounded-full group-hover:bg-white"
						></span>
						<span>Florida</span>
					</button>
				</li>
				<li>
					<button
						class="bg-primary-gold/20 border-gold/50 text-gold hover:bg-gold group flex items-center space-x-2 rounded-full border px-6 py-2 font-bold transition-all hover:text-white"
					>
						<span
							class="bg-primary-gold h-2 w-2 rounded-full group-hover:bg-white"
						></span>
						<span>Wyoming</span>
					</button>
				</li>
			</ol>
		</div>
		<ul class="grid w-full place-items-center gap-3">
			<li class="w-4/5 md:w-3/5">
				<div id="seleccionar" class="mt-5">
					<select
						id="estados"
						name="estado_de_empresa"
						class="bg-white-50 text-black-900 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border border-white hover:bg-white hover:text-neutral-800 lg:p-5 dark:border-neutral-900 dark:bg-neutral-950 dark:text-gray-400 dark:hover:bg-neutral-950 dark:hover:text-white"
						required
					>
						{
							estados?.map((es) => (
								<option value={es.Estado} selected={es.Estado === 'Florida'}>
									{es.Estado}
								</option>
							))
						}
					</select>
				</div>
			</li>
		</ul>
		<div class="my-8 grid w-full grid-cols-2 gap-2 px-10 lg:px-36">
			<button
				type="button"
				id="atrasBtn"
				class="w-full cursor-pointer justify-self-center rounded-lg border border-neutral-700 bg-transparent px-5 py-2.5 text-center text-xs font-medium focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:border-neutral-600 dark:text-white dark:focus:ring-neutral-500"
				>Volver</button
			>
			<button
				type="button"
				id="continuarBtn2"
				class="w-full cursor-pointer justify-self-center rounded-lg border border-neutral-700 bg-transparent px-5 py-2.5 text-center text-xs font-medium focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:border-neutral-600 dark:text-white dark:focus:ring-neutral-500"
				>Continuar</button
			>
		</div>
	</div>
</div>
