---
interface Props {
	estados: Array<{
		Estado: string;
	}>;
}

const { estados } = Astro.props;
---

<div id="paso2" class="hidden">
	<div class="relative">
		<button
			type="button"
			id="atrasBtn"
			class="text-white-500 group absolute bottom-10 left-5 flex cursor-pointer items-center text-center font-medium"
			><span class="transition delay-101 group-hover:-translate-x-0.5"
				><svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					><path
						fill="currentColor"
						d="M17 11H9.41l3.3-3.29a1 1 0 1 0-1.42-1.42l-5 5a1 1 0 0 0-.21.33a1 1 0 0 0 0 .76a1 1 0 0 0 .21.33l5 5a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.42L9.41 13H17a1 1 0 0 0 0-2"
					></path></svg
				></span
			> atrás</button
		>
	</div>
	<div class="pb-5 text-center">
		<h3 class="text-3xl text-neutral-800 dark:text-white">
			Elija el estado de registro
		</h3>
		<p class="text-neutral-700 dark:text-gray-400">Estados populares</p>
		<ol class="mt-3 flex justify-center">
			<li>
				<span
					class="bg-black-500 me-2 rounded-full px-2.5 py-0.5 text-sm font-medium text-white dark:bg-[#134aed] dark:text-white"
					>Florida</span
				>
			</li>
			<li>
				<span
					class="bg-black-500 me-2 rounded-full px-2.5 py-0.5 text-sm font-medium text-white dark:bg-[#134aed] dark:text-white"
					>Wyoming</span
				>
			</li>
		</ol>
	</div>
	<ul class="grid w-full place-items-center gap-3">
		<li class="w-4/5 md:w-3/5">
			<div id="seleccionar" class="mt-5">
				<select
					id="estados"
					name="estado_de_empresa"
					class="dark:bg-black-900 border-black-500 bg-white-50 text-black-900 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border p-5 hover:bg-white hover:text-neutral-800 dark:text-gray-400 dark:hover:bg-[#192033] dark:hover:text-white"
					required
				>
					{
						estados?.map((es) => (
							<option value={es.Estado} selected={es.Estado === 'Florida'}>
								{es.Estado}
							</option>
						))
					}
				</select>
			</div>
		</li>
	</ul>
	<div class="mt-8 flex w-full justify-center">
		<button
			type="button"
			id="continuarBtn2"
			class="from-black-400 via-black-500 to-black-600 me-2 mb-2 w-4/5 rounded-lg bg-linear-to-r px-5 py-2.5 text-center font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:w-3/5 md:text-lg dark:focus:ring-neutral-500"
			>Continuar</button
		>
	</div>
</div>
