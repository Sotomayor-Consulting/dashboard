---
import { Icon } from 'astro-icon/components';

interface Props {
	id: string;
	IdClose: string;
	title1: string;
	titlecolored: string;
	description: string;
	button1: string;
	button2: string;
	button1link: string;
	button2link: string;
	footer: string;
}

const {
	id,
	IdClose,
	title1,
	titlecolored,
	description,
	button1,
	button2,
	button1link,
	button2link,
	footer,
} = Astro.props;
---

<div
	id={id}
	aria-hidden="true"
	class="bg-opacity-70 bg-white-100/80 fixed top-0 right-0 left-0 z-50 hidden h-full max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0 dark:bg-black/80"
>
	<article
		class="gold-gradient-border relative w-full max-w-2xl overflow-hidden rounded-2xl bg-white px-8 py-12 text-center shadow-2xl md:px-16 md:py-16 dark:bg-black"
		data-purpose="modal-content"
	>
		<!-- Close Button -->
		<button
			aria-label="Cerrar modal"
			class="absolute top-6 right-6 cursor-pointer text-zinc-500 transition-colors duration-200 hover:text-white"
			id={IdClose}
		>
			<Icon name="ri:close-fill" class="text-2xl" />
		</button>
		<!-- BEGIN: Visual Identity Icon -->
		<div class="mb-8 flex justify-center" data-purpose="icon-container">
			<div
				class="bg-brand-gold/10 border-brand-gold/20 flex h-20 w-20 items-center justify-center rounded-2xl border shadow-[0_0_30px_rgba(176,141,66,0.15)]"
			>
				<Icon name="ri:calendar-todo-line" class="text-primary-gold text-5xl" />
			</div>
		</div>
		<!-- END: Visual Identity Icon -->
		<!-- BEGIN: Text Content -->
		<header class="mb-10 space-y-4" data-purpose="modal-header">
			<h1
				class="text-3xl leading-tight font-bold tracking-tight md:text-4xl dark:text-white"
			>
				{title1}
				<span class="text-primary-gold">{titlecolored}</span>
			</h1>
			<p
				class="text-white-700 mx-auto max-w-lg text-lg leading-relaxed dark:text-zinc-400"
			>
				{description}
			</p>
		</header>
		<!-- END: Text Content -->
		<!-- BEGIN: Action Buttons -->
		<div
			class="flex flex-col items-center justify-center gap-4 sm:flex-row"
			data-purpose="modal-actions"
		>
			<!-- Diagnostic Button -->
			<a
				href={button1link}
				class="bg-primary-gold hover:bg-brand-gold-hover shadow-brand-gold/10 w-full transform rounded-lg px-8 py-4 font-bold text-black shadow-lg transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] sm:w-auto"
				data-purpose="btn-diagnostic"
			>
				{button1}
			</a>
			<!-- Appointment Button -->
			<a
				href={button2link}
				class="text-brand-gold border-brand-gold/40 w-full transform rounded-lg border bg-transparent px-8 py-4 font-semibold transition-all duration-300 hover:scale-[1.02] hover:bg-white/5 active:scale-[0.98] sm:w-auto"
				data-purpose="btn-appointment"
			>
				{button2}
			</a>
		</div>
		<!-- END: Action Buttons -->
		<!-- Footer Insight -->
		<footer class="mt-10 border-t border-white/5 pt-8">
			<p class="text-sm text-zinc-500 italic">
				{footer}
			</p>
		</footer>
	</article>
</div>
