---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
---

<div id="paso3" class="hidden w-full">
	<div class="px-10 py-10 text-center">
		<span
			class="bg-primary-gold/20 text-brand-gold mb-4 inline-block rounded-full px-3 py-1 text-xs font-bold tracking-widest uppercase"
			>Paso 03</span
		>
		<h3 class="text-2xl text-neutral-800 lg:text-3xl dark:text-white">
			{title}
		</h3>
		<p class="text-neutral-700 dark:text-gray-400">
			{description}
		</p>
	</div>
	<ul class="flex w-full flex-col place-items-center gap-2 px-10">
		{
			[
				{
					nombre: 'Nombre de tu empresa - (opción #1)',
					id: 'nombre-empresa-1',
					name: 'nombre_1',
				},
				{
					nombre: 'Nombre de tu empresa - (opción #2)',
					id: 'nombre-empresa-2',
					name: 'nombre_2',
				},
				{
					nombre: 'Nombre de tu empresa - (opción #3)',
					id: 'nombre-empresa-3',
					name: 'nombre_3',
				},
			].map((name) => (
				<li class="m-2 h-full w-full md:w-3/5">
					<label
						for={name.id}
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-400"
					>
						{name.nombre}
					</label>
					<div class="flex">
						<span class="rounded-e-0 inline-flex items-center rounded-s-md bg-gray-100 px-3 text-sm text-gray-900 group-focus/input:bg-neutral-900 dark:bg-neutral-950 dark:text-gray-400">
							<Icon
								name="ri:building-2-line"
								class="text-primary-gold text-base"
							/>
						</span>
						<input
							type="text"
							id={name.id}
							name={name.name}
							class="group/input focus:bg-white-100 w-full rounded-none rounded-e-lg border-0 bg-gray-100 p-2.5 text-sm text-neutral-900 placeholder-gray-500 focus:ring-white lg:min-w-10 dark:bg-neutral-950 dark:text-white dark:focus:bg-neutral-900 dark:focus:ring-black"
							placeholder="Sotomayor Consulting"
							required
						/>
					</div>
				</li>
			))
		}
	</ul>
	<div class="my-8 grid w-full grid-cols-2 gap-2 px-10 lg:px-36">
		<button
			type="button"
			id="atrasBtn4"
			class="w-full cursor-pointer justify-self-center rounded-lg border border-neutral-700 bg-transparent px-5 py-2.5 text-center text-xs font-medium focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:border-neutral-600 dark:text-white dark:focus:ring-neutral-500"
			>Volver</button
		>
		<button
			type="button"
			id="continuarBtn3"
			class="w-full cursor-pointer justify-self-center rounded-lg border border-neutral-700 bg-transparent px-5 py-2.5 text-center text-xs font-medium focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:border-neutral-600 dark:text-white dark:focus:ring-neutral-500"
			>Continuar</button
		>
	</div>
</div>
