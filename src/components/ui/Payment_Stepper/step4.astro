---
interface Props {
	title: string;
	description: string;
	description2: string;
}
const { title, description, description2 } = Astro.props;
---

<div id="paso4" class="hidden w-full">
	<div class="px-10 py-10 text-center">
		<h3 class="text-2xl text-neutral-800 lg:text-3xl dark:text-white">
			{title}
		</h3>
		<p class="text-black-800 dark:text-gray-400">
			{description2}
		</p>
		<p class="text-black-800 dark:text-gray-400">
			{description}
		</p>
	</div>
	<ul class="grid w-full place-items-center gap-3">
		<li class="w-4/5">
			{
				[
					{
						id: 'respuestasradio',
						title: 'Tipo de empresa',
						description: 'No has seleccionado nada',
						idButton: 'editar1',
					},
					{
						id: 'respuesta_estado',
						title: 'Estado en el cual se va a registrar',
						description: 'No has seleccionada nada',
						idButton: 'editar2',
					},
					{
						id: 'respuesta_plan',
						title: 'El nombre que seleccionaste',
						description: 'No has seleccionada nada',
						idButton: 'editar3',
					},
				].map((li) => (
					<div id={li.id} class="mt-5">
						<div class="flex w-full items-center justify-between rounded-lg border border-neutral-700 bg-white p-3 text-neutral-600 hover:text-neutral-200 focus:ring-neutral-600 dark:bg-black dark:text-gray-400 dark:hover:text-white">
							<div>
								<p class="text-black-700 mt-1 text-sm dark:text-gray-400">
									{li.title}
								</p>
								<h3
									id="radioResultado"
									class="text-black-900 text-xs lg:text-xl dark:text-white"
								>
									{li.description}
								</h3>
							</div>
							<button
								id={li.idButton}
								type="button"
								class="hover:bg-black-600 flex cursor-pointer items-center justify-center rounded-lg border bg-neutral-400 p-1 dark:bg-neutral-900 dark:hover:bg-neutral-950/80"
								title="editar"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
								>
									<path
										fill="currentColor"
										d="M3 21v-4.25L16.2 3.575q.3-.275.663-.425t.762-.15t.775.15t.65.45L20.425 5q.3.275.438.65T21 6.4q0 .4-.137.763t-.438.662L7.25 21zM17.6 7.8L19 6.4L17.6 5l-1.4 1.4z"
									/>
								</svg>
							</button>
						</div>
					</div>
				))
			}
		</li>
	</ul>
	<div class="my-8 grid w-full grid-cols-2 gap-2 px-10 lg:px-36">
		<button
			type="button"
			id="atrasBtn2"
			class="w-full cursor-pointer justify-self-center rounded-lg border bg-transparent px-5 py-2.5 text-center text-xs font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:border-neutral-600 dark:focus:ring-neutral-500"
			>Volver</button
		>
		<button
			type="button"
			id="boton-verificar"
			class="w-full cursor-pointer justify-self-center rounded-lg border bg-transparent px-5 py-2.5 text-center text-xs font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:text-lg dark:border-neutral-600 dark:focus:ring-neutral-500"
			>Verificar información</button
		>
	</div>
</div>
