---
interface Props {
	title: string;
	description: string;
	description2: string;
}
const { title, description, description2 } = Astro.props;
---

<div id="paso4" class="hidden">
	<div class="relative">
		<button
			type="button"
			id="atrasBtn2"
			class="text-white-500 group absolute bottom-10 left-5 flex cursor-pointer items-center text-center font-medium"
			><span class="transition delay-101 group-hover:-translate-x-0.5"
				><svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					><path
						fill="currentColor"
						d="M17 11H9.41l3.3-3.29a1 1 0 1 0-1.42-1.42l-5 5a1 1 0 0 0-.21.33a1 1 0 0 0 0 .76a1 1 0 0 0 .21.33l5 5a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.42L9.41 13H17a1 1 0 0 0 0-2"
					></path></svg
				></span
			> atrás</button
		>
	</div>
	<div class="pb-5 text-center">
		<h3 class="text-black-900 text-3xl dark:text-white">
			{title}
		</h3>
		<p class="text-black-800 dark:text-gray-400">
			{description2}
		</p>
		<p class="text-black-800 dark:text-gray-400">
			{description}
		</p>
	</div>
	<ul class="grid w-full place-items-center gap-3">
		<li class="w-4/5 md:w-3/5">
			{
				[
					{
						id: 'respuestasradio',
						title: 'Tipo de empresa',
						description: 'No has seleccionado nada',
						idButton: 'editar1',
					},
					{
						id: 'respuesta_estado',
						title: 'Estado en el cual se va a registrar',
						description: 'No has seleccionada nada',
						idButton: 'editar2',
					},
					{
						id: 'respuesta_plan',
						title: 'El nombre que seleccionaste',
						description: 'No has seleccionada nada',
						idButton: 'editar3',
					},
				].map((li) => (
					<div id={li.id} class="mt-5">
						<div class="dark:bg-black-900 flex w-full items-center justify-between rounded-lg border border-neutral-700 bg-white p-5 text-neutral-600 hover:text-neutral-200 focus:ring-neutral-600 dark:text-gray-400 dark:hover:text-white">
							<div>
								<p class="text-black-700 mt-1 text-sm dark:text-gray-400">
									{li.title}
								</p>
								<h3
									id="radioResultado"
									class="text-black-900 text-xl dark:text-white"
								>
									{li.description}
								</h3>
							</div>
							<button
								id={li.idButton}
								type="button"
								class="dark:bg-black-900 hover:bg-black-600 flex cursor-pointer items-center justify-center rounded-lg border bg-neutral-400 p-1 dark:hover:bg-[#134aed]/80"
								title="editar"
							>
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
								>
									<path
										fill="currentColor"
										d="M3 21v-4.25L16.2 3.575q.3-.275.663-.425t.762-.15t.775.15t.65.45L20.425 5q.3.275.438.65T21 6.4q0 .4-.137.763t-.438.662L7.25 21zM17.6 7.8L19 6.4L17.6 5l-1.4 1.4z"
									/>
								</svg>
							</button>
						</div>
					</div>
				))
			}
		</li>
	</ul>
	<div class="mt-8 flex w-full justify-center">
		<button
			type="button"
			id="boton-verificar"
			class="from-black-400 via-black-500 to-black-600 me-2 mb-2 w-4/5 rounded-lg bg-linear-to-r px-5 py-2.5 text-center font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:w-3/5 md:text-lg dark:focus:ring-neutral-500"
			>Verificar información</button
		>
	</div>
</div>
