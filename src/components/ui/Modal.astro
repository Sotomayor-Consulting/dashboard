---
/**
 * Modal reutilizable sobre <dialog> nativo.
 * El navegador aporta ESC, focus trap, ::backdrop y top layer;
 * los triggers usan data-dialog-show/hide (ver native-dialog.client.ts).
 *
 * Uso:
 * <button data-dialog-show="edit-user-modal">Abrir</button>
 * <Modal id="edit-user-modal" title="Editar usuario" maxWidth="max-w-4xl">
 *   <form>...</form>
 * </Modal>
 */
interface Props {
	/** ID unico del modal (usado por data-dialog-show/hide) */
	id: string;
	/** Titulo del modal */
	title: string;
	/** Ancho maximo. Default: 'max-w-2xl' */
	maxWidth?: string;
	/** Backdrop estatico: el click fuera no cierra. Default: false */
	staticBackdrop?: boolean;
}

const {
	id,
	title,
	maxWidth = 'max-w-2xl',
	staticBackdrop = false,
} = Astro.props;
---

<dialog
	id={id}
	class:list={[
		'm-auto w-full bg-transparent p-4 backdrop:bg-gray-900/50 dark:backdrop:bg-gray-900/80',
		maxWidth,
	]}
	{...staticBackdrop ? { 'data-static': 'true' } : {}}
>
	<div class="dark:bg-black-900 relative rounded-lg bg-white shadow">
		<div
			class="flex items-start justify-between border-b p-5 dark:border-gray-700"
		>
			<h3 class="text-xl font-semibold dark:text-white">{title}</h3>
			<button
				type="button"
				class="dark:hover:bg-black-700 ml-auto inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:text-white"
				data-dialog-hide={id}
			>
				<svg
					class="h-5 w-5"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						fill-rule="evenodd"
						d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
						clip-rule="evenodd"></path>
				</svg>
			</button>
		</div>
		<slot />
	</div>
</dialog>

<script>
	import { initNativeDialogs } from '@shared/native-dialog.client';
	initNativeDialogs();
</script>
