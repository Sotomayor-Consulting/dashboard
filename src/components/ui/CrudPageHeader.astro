---
interface Props {
	title: string;
	descripcion?: string;
	classAlt?: string;
}

const { title, descripcion, classAlt } = Astro.props;
---

<div
	class={`flex flex-wrap items-center justify-between gap-3 ${classAlt || ''}`}
>
	<div class="section-header">
		<h1 class="section-title text-xl">{title}</h1>
		{descripcion && <p class="section-description">{descripcion}</p>}
	</div>
</div>
