---
interface Props {
    class?: string;
    size?: 'sm' | 'md' | 'lg' | 'xl';
    label?: string;
}

const { class: className = '', size = 'lg', label = 'Cargando...' } = Astro.props;

const sizeMap: Record<string, string> = {
    sm: 'h-6 w-6',
    md: 'h-8 w-8',
    lg: 'h-12 w-12',
    xl: 'h-16 w-16',
};
---

<div class:list={['flex flex-col items-center justify-center gap-3 py-12', className]} role="status">
    <svg
        class:list={['animate-spin text-gray-300 dark:text-gray-600', sizeMap[size]]}
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
    >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
        <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        />
    </svg>
    {label && (
        <span class="text-sm text-gray-500 dark:text-gray-400">{label}</span>
    )}
</div>