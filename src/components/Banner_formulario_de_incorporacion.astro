---
import { Image } from 'astro:assets';
import icono from '/src/assets/icono.png';
import icono2 from '/src/assets/icono-negro.png';
import { supabase } from '../lib/supabase'; // Asegúrate de que esta ruta es correcta
import type { User } from '@supabase/supabase-js';

// 1. Acceso a las cookies y tokens
const { cookies } = Astro;
const accessToken = cookies.get('sb-access-token');
const refreshToken = cookies.get('sb-refresh-token');

let user: User | null = null;
let shouldShowBanner = false;

// 2. Definición de la Condición
const TARGET_TABLE = 'empresas_incorporaciones';
const FORMULARIOS_TABLE = 'formularios_envios';

// Datos fijos para el banner
const BANNER_PROPS = {
	title: 'Proceda con la formalización de la incorporación de su empresa a través del siguiente formulario.',
	btnId: 'dismiss-incorp-banner-icorp',
	btnTitle: 'Comenzar ahora',
};

// 3. Proceso de Autenticación y Consulta (SSR)
let empresaId: string | null = null;

if (accessToken && refreshToken) {
	try {
		// 3a. Establecer la sesión para que las consultas tengan el contexto del usuario
		await supabase.auth.setSession({
			refresh_token: refreshToken.value,
			access_token: accessToken.value,
		});

		// 3b. Obtener el objeto de usuario actual
		const {
			data: { user: currentUser },
		} = await supabase.auth.getUser();
		user = currentUser;

		if (user) {
			// 3c. Consulta una sola empresa activa del usuario (más escalable)
			const { data: empresaActiva, error: errorIncorp } = await supabase
				.from(TARGET_TABLE)
				.select('empresa_incorporacion_id')
				.eq('user_id', user.id)
				.eq('estado', 'Activo')
				.single(); // .single() devuelve solo un registro o null

			// 3d. Consulta si ya existe un formulario enviado por el usuario actual
			const { data: formularios, error: errorForm } = await supabase
				.from(FORMULARIOS_TABLE)
				.select('status')
				.eq('user_id', user.id)
				.eq('status', 'submitted')
				.maybeSingle(); // .maybeSingle() permite null sin error

			if (errorIncorp && errorIncorp.code !== 'PGRST116') {
				// Ignorar error de "no rows returned"
				console.error(
					'[Banner] Error al consultar empresa activa:',
					errorIncorp,
				);
			} else if (errorForm && errorForm.code !== 'PGRST116') {
				// Ignorar error de "no rows returned"
				console.error('[Banner] Error al consultar formulario:', errorForm);
			} else {
				// 3e. Condición: mostrar si hay empresa 'Activo' Y NO hay formulario 'submitted'
				const tieneEmpresaActiva = !!empresaActiva;
				const tieneFormularioEnviado = !!formularios;

				shouldShowBanner = tieneEmpresaActiva && !tieneFormularioEnviado;
				if (tieneEmpresaActiva && empresaActiva.empresa_incorporacion_id) {
					empresaId = empresaActiva.empresa_incorporacion_id;
				}
			}
		}
	} catch (e) {
		console.error('[Banner] Error de sesión o conexión con Supabase:', e);
	}
}
---

{
	shouldShowBanner && (
		<astro-banner btnId={BANNER_PROPS.btnId}>
			<div
				id="banner_forms_incorp"
				tabindex="-1"
				class="flex flex-col md:flex-row justify-between w-full p-4 bg-neutral-300 border border-gray-100 shadow-xs top-28 dark:bg-neutral-700 dark:border-gray-600 right-4 animate-fade-in"
			>
			
				<div class="flex mb-3 me-4 items-center flex-row md:mb-0">
					<a
						href="/"
						class="items-center mb-2 border-gray-200 pe-4 me-4 border-e md:mb-0 dark:border-gray-600 hidden md:flex"
					>
						<Image
							src={icono}
							width="32"
							alt="Sotomayor consulting Logo"
							class="me-2 hidden dark:block"
						/>
						<Image
							src={icono2}
							width="32"
							alt="Sotomayor consulting Logo"
							class="me-2 dark:hidden block"
						/>
					</a>
					<p class="flex items-center text-base font-normal text-black dark:text-white">
						{BANNER_PROPS.title}
					</p>
				</div>
				<div class="flex items-center shrink-0 justify-between">
					<a
						href={`/forms/incorporacion/3bc86384-2cc6-440d-aa79-f2f63738fd3b?empresa=${empresaId}`}
						class="px-5 py-2 me-2 text-base font-medium text-white bg-[#8c681d] rounded-lg hover:bg-[#8c681d] focus:ring-4 focus:ring-blue-300 dark:bg-[#8c681d] dark:hover:bg-[#8c681d] focus:outline-none dark:focus:ring-[#8c681d]"
					>
						{BANNER_PROPS.btnTitle}
					</a>
					<button
						data-dismiss-target="#banner_forms_incorp"
						type="button"
						class="shrink-0 inline-flex justify-center w-7 h-7 items-center text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 dark:hover:bg-gray-600 dark:hover:text-white"
					>
						<svg
							class="w-3 h-3"
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 14 14"
						>
							<path
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
							/>
						</svg>
						<span class="sr-only">Close banner</span>
					</button>
				</div>
			</div>
		</astro-banner>
	)
}

<style>
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fade-in 0.5s ease-out forwards;
	}
</style>
