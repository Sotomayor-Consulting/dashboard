---
import { Icon } from 'astro-icon/components';
import ColorModeSwitcher from '@components/display/ColorModeSwitcher.astro';
import GlobalSearch from '@components/navigation/GlobalSearch.astro';
import logonotificaciones from '@assets/avatarSCI.png';
import NotificationsPopover from '@components/navigation/islands/NotificationsPopover';
import { menuItems } from '@components/navigation/items';

// Datos recibidos desde LayoutSidebar (ya consultados en paralelo)
const { notificationsData: notifProp } = Astro.props;

const { notifications, totalUnread } = notifProp ?? {
	notifications: [],
	totalUnread: 0,
};

const pathname = Astro.url.pathname;

const humanize = (value: string) =>
	value
		.replaceAll('-', ' ')
		.replaceAll('_', ' ')
		.replace(/\b\w/g, (char: string) => char.toUpperCase());

const isUuid = (value: string) =>
	/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
		value,
	);

const segments = pathname.split('/').filter(Boolean);

const sectionLabel = (() => {
	const exactMatch = menuItems.find((item) => item.href === pathname);
	if (exactMatch) return exactMatch.label;

	const prefixMatch = menuItems.find(
		(item) => item.href !== '/' && pathname.startsWith(item.href),
	);
	if (prefixMatch) return prefixMatch.label;

	if (segments.length === 0) return 'Inicio';
	return humanize(segments[0] ?? 'Inicio');
})();

const breadcrumbItems = [
	{ label: 'Inicio', href: '/' },
	...segments.map((segment, index) => ({
		label: isUuid(segment) ? 'Detalle' : humanize(segment),
		href: `/${segments.slice(0, index + 1).join('/')}/`,
	})),
];

const quickActions = [
	{
		label: 'Feedback',
		href: 'mailto:info@sotomayorconsulting.com?subject=Feedback%20Dashboard',
		icon: 'ri:message-3-line',
	},
	{
		label: 'Soporte',
		href: 'mailto:info@sotomayorconsulting.com',
		icon: 'ri:customer-service-2-line',
	},
];
---

<nav
	id="navbar-sidebar"
	class="dark:bg-black-900 fixed top-0 right-0 left-0 z-30 h-14 w-full border-b border-gray-300/90 bg-white dark:border-gray-600/80"
	transition:persist="navbar"
>
	<div class="h-full pr-3 pl-0 lg:pr-5">
		<div class="flex h-full items-center justify-between">
			<div class="flex min-w-0 items-center justify-start">
				<button
					id="toggleSidebarMobile"
					data-drawer-target="sidebar"
					data-drawer-show="sidebar"
					aria-controls="sidebar"
					aria-expanded="true"
					class="cursor-pointer rounded p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 focus:bg-gray-100 focus:ring-2 focus:ring-gray-100 lg:hidden dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white dark:focus:bg-neutral-700 dark:focus:ring-gray-700"
				>
					<svg
						id="toggleSidebarMobileHamburger"
						class="h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
							clip-rule="evenodd"></path></svg
					>
					<svg
						id="toggleSidebarMobileClose"
						class="hidden h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path></svg
					>
				</button>

				<a href="/" class="ml-1 hidden md:mr-4 md:flex lg:hidden">
					<Icon
						name="isotipo_azul"
						class="block text-3xl dark:hidden"
						title="Logo Sotomayor Consulting"
					/>
					<Icon
						name="isotipo_blanco_alt"
						class="mr-3 hidden text-3xl dark:block"
						title="Logo Sotomayor Consulting"
					/>
				</a>

				<div
					class="hidden h-full items-center justify-center border-r border-gray-300/90 px-2 lg:flex dark:border-gray-600/80"
					style="width: var(--sb-divider-x, 3rem);"
				>
					<a href="/" class="flex items-center justify-center">
						<Icon
							name="isotipo_azul"
							class="block text-2xl dark:hidden"
							title="Logo Sotomayor Consulting"
						/>
						<Icon
							name="isotipo_blanco_alt"
							class="hidden text-2xl dark:block"
							title="Logo Sotomayor Consulting"
						/>
					</a>
				</div>

				<div class="hidden min-w-0 flex-col justify-center pl-4 lg:flex">
					<p
						class="text-xs font-medium tracking-wide text-gray-500 uppercase dark:text-gray-400"
					>
						{sectionLabel}
					</p>
					<nav
						aria-label="Breadcrumb"
						class="mt-0.5 flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400"
					>
						{
							breadcrumbItems.map((crumb, idx) => (
								<>
									{idx > 0 && (
										<Icon name="ri:arrow-right-s-line" class="h-3 w-3" />
									)}
									<a
										href={crumb.href}
										class:list={{
											'transition-colors hover:text-gray-700 dark:hover:text-gray-200': true,
											'font-semibold text-gray-900 dark:text-white':
												idx === breadcrumbItems.length - 1,
										}}
									>
										{crumb.label}
									</a>
								</>
							))
						}
					</nav>
				</div>
			</div>

			<div class="hidden flex-1 items-center justify-center px-4 md:flex">
				<GlobalSearch />
			</div>

			<div class="flex items-center gap-1.5">
				<div class="hidden items-center gap-1 pr-1 lg:flex">
					{
						quickActions.map((action) => (
							<a
								href={action.href}
								target={action.href.startsWith('http') ? '_blank' : undefined}
								rel={
									action.href.startsWith('http')
										? 'noreferrer noopener'
										: undefined
								}
								class="inline-flex h-9 items-center gap-1.5 rounded-md px-2.5 text-xs font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white"
							>
								<Icon name={action.icon} class="h-5 w-5" />
								<span>{action.label}</span>
							</a>
						))
					}
				</div>
				<div
					class="mx-1 hidden h-5 w-px bg-gray-300/90 lg:block dark:bg-gray-600/80"
				>
				</div>
				<div id="notificaciones">
					<NotificationsPopover
						notifications={notifications}
						totalUnread={totalUnread}
						avatarSrc={logonotificaciones.src}
						client:load
					/>
				</div>
				<div
					class="mx-0.5 hidden h-5 w-px bg-gray-300/90 lg:block dark:bg-gray-600/80"
				>
				</div>
				<ColorModeSwitcher />
			</div>
		</div>
	</div>
</nav>
