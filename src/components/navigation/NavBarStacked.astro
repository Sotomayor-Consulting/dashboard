---
import { Icon } from 'astro-icon/components';
import ColorModeSwitcher from '@components/display/ColorModeSwitcher.astro';
const user = Astro.locals.user;
---

<nav
	class="fixed z-50 w-full border-b border-gray-200/60 bg-white/80 backdrop-blur-md sm:py-2 dark:border-gray-700/50 dark:bg-black dark:backdrop-blur-md"
>
	<div class="container mx-auto py-3">
		<div class="flex items-center justify-between">
			<div class="flex items-center justify-start">
				<a href="/" class="mx-4 flex">
					<Icon
						name="logo-sotomayor-consulting"
						id="isotipo"
						class="block text-4xl dark:hidden"
						title="Logo Sotomayor Consulting"
					/>
					<Icon
						name="logo-sotomayor-consulting-black"
						id="isotipo"
						class="hidden text-4xl dark:block"
						title="Logo Sotomayor Consulting"
					/>
				</a>
				<div class="hidden sm:ml-6 sm:flex">
					<ul class="flex space-x-8">
						{
							[
								{
									link: '/',
									label: 'Inicio',
								},
								{
									link: 'https://sotomayorconsulting.com/inicio/about/',
									label: 'Nosotros',
								},
								{
									link: 'https://sotomayorconsulting.com/inicio/contact/',
									label: 'Contactos',
								},
							].map((li) => (
								<li>
									<a
										href={li.link}
										class="hover:text-primary-gold text-sm font-medium text-gray-700 dark:text-gray-400"
										aria-current="page"
									>
										{li.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<div class="grid grid-cols-2 sm:flex sm:flex-row">
				{
					!user ? (
						<a
							href="/sign-in"
							target="_blank"
							class="bg-primary-gold hover:bg-primary-gold/80 focus:ring-primary-300 hidden items-center rounded-lg px-5 py-2.5 text-center text-sm font-medium text-white focus:ring-4 md:inline-flex"
						>
							<svg
								class="mr-2 -ml-1 h-5 w-5"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
								/>
							</svg>
							Iniciar sesión
						</a>
					) : (
						<div class="hidden items-end md:flex md:flex-col">
							<span class="text-wite font-semibold dark:text-white">
								{user.user_metadata?.full_name || 'Usuario'}
							</span>
							<span class="text-sm text-gray-600">{user.email}</span>
						</div>
					)
				}

				<button
					data-collapse-toggle="mobile-menu"
					type="button"
					class="focus:ring-primary-300 ml-3 inline-flex items-center justify-center rounded-lg p-2 text-gray-400 hover:text-gray-900 focus:ring-2 focus:outline-none sm:hidden dark:hover:bg-[#101522] dark:hover:text-white"
					aria-controls="mobile-menu-2"
					aria-expanded="false"
				>
					<span class="sr-only">Abrir menu</span>
					<!-- Open mobile menu icon -->
					<svg
						class="h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							fill-rule="evenodd"
							d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
							clip-rule="evenodd"></path>
					</svg>
					<!-- Close mobile menu icon -->
					<svg
						class="hidden h-6 w-6"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path>
					</svg>
				</button>
				<div class="flex justify-end">
					<div class="ml-5">
						<ColorModeSwitcher />
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Mobile menu -->
	<div class="hidden sm:hidden" id="mobile-menu">
		<ul class="pt-2">
			<li>
				<a
					href="#"
					class="dark:bg-black-900 block bg-gray-100 py-2 pr-4 pl-3 text-base font-normal text-gray-900 dark:text-white"
					>Inicio</a
				>
			</li>
			<li>
				<a
					href="https://sotomayorconsulting.com/inicio/about/"
					class="block border-b border-gray-100 px-3 py-2 text-base font-normal text-gray-600 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white"
					>Nosotros</a
				>
			</li>
			<li>
				<a
					href="https://sotomayorconsulting.com/inicio/contact/"
					class="block border-b border-gray-100 px-3 py-2 text-base font-normal text-gray-600 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white"
					>Contactos</a
				>
			</li>

			<li class="block">
				{
					!user ? (
						<a
							href="/sign-in"
							target="_blank"
							class="inline-flex w-full items-center px-3 py-2 text-base font-normal text-gray-600 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white"
						>
							<svg
								class="mr-2 h-5 w-5"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"
								/>
							</svg>
							Iniciar sesión
						</a>
					) : null
				}
			</li>
		</ul>
	</div>
</nav>
