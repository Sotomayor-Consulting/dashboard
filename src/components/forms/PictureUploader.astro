---
import { getUsuarioAvatar } from '@domains/users/users';
import PictureUploaderIsland from './islands/PictureUploaderIsland';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const imagen = userId ? await getUsuarioAvatar(supabase, userId) : null;

const hasAvatar = imagen?.avatar_url && imagen.avatar_url !== 'NULL';

interface Props {
	title?: string;
}
const { title } = Astro.props;
---

<PictureUploaderIsland
	initialAvatarUrl={hasAvatar ? imagen!.avatar_url : null}
	fallbackSeed={userId}
	client:load
/>

{title && <p class="text-muted-foreground mt-2 text-sm">{title}</p>}
