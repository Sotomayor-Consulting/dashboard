---
import { getUsuarioAvatar } from '@domains/users/users';
import Image from 'astro/components/Image.astro';

const supabase = Astro.locals.supabase;

const user = Astro.locals.user;
const userId = user?.id;
const imagen = userId ? await getUsuarioAvatar(supabase, userId) : null;

interface Props {
	title: string;
}
const { title } = Astro.props;
const { slug } = Astro.params;
---

{
	imagen?.avatar_url === 'NULL' || !imagen?.avatar_url ? (
		<div class="relative inline-block">
			<Image
				src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${userId || ''}`}
				class="h-28 w-28 rounded-lg"
				alt="avatar"
				loading="eager"
				inferSize={true}
			/>
			<img
				id="preview-avatar"
				class="absolute inset-0 hidden h-28 w-28 rounded-lg object-cover"
				alt="Preview"
			/>
		</div>
	) : (
		<div class="relative inline-block">
			<Image
				class="h-28 w-28 rounded-lg object-cover"
				src={imagen?.avatar_url}
				alt="Foto de perfil"
				inferSize={true}
				loading="eager"
			/>
			<img
				id="preview-avatar"
				class="absolute inset-0 hidden h-28 w-28 rounded-lg object-cover"
				alt="Preview"
			/>
		</div>
	)
}

<div>
	<h3 class="mb-1 text-xl font-bold text-gray-900 dark:text-white">
		{title}
	</h3>
	<div class="mb-4 text-sm text-gray-500 dark:text-gray-400">
		JPG, PNG o WEBP. tamaño máximo de 5M.
	</div>
	<div class="flex items-center space-x-4">
		<form
			method="post"
			action="/api/companies/update-avatar"
			enctype="multipart/form-data"
		>
			<input type="hidden" name="slug" value={slug} />
			<div class="flex justify-center gap-2">
				<label
					class="bg-primary-gold hover:bg-primary-gold/80 inline-flex cursor-pointer items-center rounded-lg border px-3 py-2 text-white drop-shadow-2xl transition"
				>
					<span>Seleccionar archivo</span>
					<input
						class="hidden"
						type="file"
						name="avatar"
						accept="image/*"
						id="avatar-input"
					/>
				</label>

				<button
					type="submit"
					class="bg-primary-gold hover:bg-primary-gold/80 inline-flex cursor-pointer items-center rounded-lg border px-3 py-2 text-white drop-shadow-2xl transition"
				>
					<svg
						class="mr-2 -ml-1 h-4 w-4"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill="currentColor"
							d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h11.175q.4 0 .763.15t.637.425l2.85 2.85q.275.275.425.638t.15.762V19q0 .825-.587 1.413T19 21zm7-3q1.25 0 2.125-.875T15 15t-.875-2.125T12 12t-2.125.875T9 15t.875 2.125T12 18m-5-8h7q.425 0 .713-.288T15 9V7q0-.425-.288-.712T14 6H7q-.425 0-.712.288T6 7v2q0 .425.288.713T7 10"
						></path></svg
					>
					Actualizar foto de perfil
				</button>
			</div>
		</form>
	</div>
</div>

<script>
	const input = document.getElementById('avatar-input') as HTMLInputElement;
	const preview = document.getElementById('preview-avatar') as HTMLImageElement;

	input?.addEventListener('change', (e) => {
		const file = (e.target as HTMLInputElement).files?.[0];
		if (file) {
			const url = URL.createObjectURL(file);
			preview.src = url;
			preview.classList.remove('hidden');
		}
	});
</script>
