---
interface Props {
	id?: string;
	name?: string;
	placeholder?: string;
	required?: boolean;
	minlength?: number;
	/** ID del input de confirmación de contraseña para validación cruzada */
	confirmInputId?: string;
}

const {
	id = 'password-meter',
	name = 'password',
	placeholder = 'Ingresa tu Contraseña',
	required = false,
	minlength = 8,
	confirmInputId,
} = Astro.props;
---

<div
	class="password-meter-wrapper"
	data-password-meter
	data-confirm-input-id={confirmInputId ?? ''}
>
	<div class="relative">
		<input
			id={id}
			name={name}
			type="password"
			placeholder={placeholder}
			required={required}
			minlength={minlength}
			autocomplete="new-password"
			aria-describedby={`${id}-strength-feedback`}
			class="border sm:text-sm rounded-lg focus:ring-[#967432] focus:border-[#967432] block w-full p-2.5
                            dark:bg-[#05121d] border-gray-600 placeholder-gray-400 dark:text-white bg-white"
		/>
		<button
			type="button"
			data-toggle-visibility
			class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-colors"
			aria-label="Mostrar u ocultar contraseña"
		>
			<svg
				data-icon-eye
				class="w-5 h-5"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
				></path>
			</svg>
			<svg
				data-icon-eye-off
				class="w-5 h-5 hidden"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
				></path>
			</svg>
		</button>
	</div>

	<!-- Barra de fuerza -->
	<div
		class="mt-3"
		id={`${id}-strength-feedback`}
		role="status"
		aria-live="polite"
	>
		<div class="flex gap-1.5 mb-2">
			{
				[0, 1, 2, 3].map((i) => (
					<div
						class="h-1.5 flex-1 rounded-full bg-gray-200 dark:bg-gray-700 transition-all duration-300"
						data-bar-segment={i}
					/>
				))
			}
		</div>
		<div class="flex justify-between items-center">
			<span
				data-strength-label
				class="text-xs font-medium text-neutral-500 dark:text-neutral-400 transition-colors"
			>
			</span>
			<span
				data-crack-time
				class="text-xs text-neutral-400 dark:text-neutral-500"
			>
			</span>
		</div>
	</div>

	<!-- Criterios individuales -->
	<ul class="mt-1 space-y-1.5 text-xs" data-criteria-list>
		<li
			data-criterion="length"
			class="flex items-center gap-2 text-neutral-400 dark:text-neutral-500 transition-colors"
		>
			<svg
				class="w-3.5 h-3.5 shrink-0"
				data-check-icon
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2.5"
					d="M5 13l4 4L19 7"></path>
			</svg>
			<span>Mínimo {minlength} caracteres</span>
		</li>
		<li
			data-criterion="uppercase"
			class="flex items-center gap-2 text-neutral-400 dark:text-neutral-500 transition-colors"
		>
			<svg
				class="w-3.5 h-3.5 shrink-0"
				data-check-icon
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2.5"
					d="M5 13l4 4L19 7"></path>
			</svg>
			<span>Al menos una letra mayúscula</span>
		</li>
		<li
			data-criterion="lowercase"
			class="flex items-center gap-2 text-neutral-400 dark:text-neutral-500 transition-colors"
		>
			<svg
				class="w-3.5 h-3.5 shrink-0"
				data-check-icon
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2.5"
					d="M5 13l4 4L19 7"></path>
			</svg>
			<span>Al menos una letra minúscula</span>
		</li>
		<li
			data-criterion="number"
			class="flex items-center gap-2 text-neutral-400 dark:text-neutral-500 transition-colors"
		>
			<svg
				class="w-3.5 h-3.5 shrink-0"
				data-check-icon
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2.5"
					d="M5 13l4 4L19 7"></path>
			</svg>
			<span>Al menos un número</span>
		</li>
		<li
			data-criterion="special"
			class="flex items-center gap-2 text-neutral-400 dark:text-neutral-500 transition-colors"
		>
			<svg
				class="w-3.5 h-3.5 shrink-0"
				data-check-icon
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2.5"
					d="M5 13l4 4L19 7"></path>
			</svg>
			<span>Al menos un carácter especial (!@#$...)</span>
		</li>
		<li
			data-criterion="match"
			class="items-center gap-2 text-neutral-400 dark:text-neutral-500 transition-colors hidden"
		>
			<svg
				class="w-3.5 h-3.5 shrink-0"
				data-check-icon
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2.5"
					d="M5 13l4 4L19 7"></path>
			</svg>
			<span>Las contraseñas coinciden</span>
		</li>
	</ul>

	<!-- Sugerencia de zxcvbn -->
	<p
		data-suggestion
		class="mt-2 text-xs text-amber-600 dark:text-amber-400 min-h-5 transition-opacity"
		aria-live="polite"
	>
	</p>

	<!-- Mensaje de error de coincidencia (para el input de confirmación externo) -->
	<p
		data-match-error
		class="mt-1 text-xs text-red-500 dark:text-red-400 hidden transition-opacity"
		aria-live="polite"
	>
		Las contraseñas no coinciden
	</p>
</div>

<script>
	import type { ZXCVBNResult, ZXCVBNScore } from 'zxcvbn';

	// Lazy-load zxcvbn (~400KB) solo cuando el usuario empiece a escribir
	let _zxcvbn: typeof import('zxcvbn').default | null = null;

	async function getZxcvbn(): Promise<typeof import('zxcvbn').default> {
		if (!_zxcvbn) {
			const mod = await import('zxcvbn');
			_zxcvbn = mod.default;
		}
		return _zxcvbn;
	}

	interface StrengthConfig {
		readonly label: string;
		readonly color: string;
		readonly textClass: string;
		readonly segments: number;
	}

	type CriterionKey =
		| 'length'
		| 'uppercase'
		| 'lowercase'
		| 'number'
		| 'special'
		| 'match';

	const STRENGTH_MAP: Readonly<Record<ZXCVBNScore, StrengthConfig>> = {
		0: {
			label: 'Muy débil',
			color: '#ef4444',
			textClass: 'text-red-500',
			segments: 1,
		},
		1: {
			label: 'Débil',
			color: '#f59e0b',
			textClass: 'text-amber-500',
			segments: 1,
		},
		2: {
			label: 'Media',
			color: '#eab308',
			textClass: 'text-yellow-500',
			segments: 2,
		},
		3: {
			label: 'Buena',
			color: '#22c55e',
			textClass: 'text-green-500',
			segments: 3,
		},
		4: {
			label: 'Muy fuerte',
			color: '#16a34a',
			textClass: 'text-green-600',
			segments: 4,
		},
	} as const;

	const WARNING_MAP: Readonly<Record<string, string>> = {
		'Straight rows of keys are easy to guess':
			'Filas de teclas consecutivas son fáciles de adivinar',
		'Short keyboard patterns are easy to guess':
			'Patrones cortos de teclado son fáciles de adivinar',
		'Repeats like "aaa" are easy to guess':
			'Repeticiones como "aaa" son fáciles de adivinar',
		'Repeats like "abcabcabc" are only slightly harder to guess than "abc"':
			'Repeticiones como "abcabc" son casi tan fáciles como "abc"',
		'Sequences like abc or 6543 are easy to guess':
			'Secuencias como abc o 6543 son fáciles de adivinar',
		'Recent years are easy to guess': 'Años recientes son fáciles de adivinar',
		'Dates are often easy to guess': 'Las fechas son fáciles de adivinar',
		'This is a top-10 common password':
			'Esta es una de las 10 contraseñas más comunes',
		'This is a top-100 common password':
			'Esta es una de las 100 contraseñas más comunes',
		'This is a very common password': 'Esta es una contraseña muy común',
		'This is similar to a commonly used password':
			'Es similar a una contraseña común',
		'A word by itself is easy to guess':
			'Una palabra sola es fácil de adivinar',
		'Names and surnames by themselves are easy to guess':
			'Nombres y apellidos solos son fáciles de adivinar',
		'Common names and surnames are easy to guess':
			'Nombres y apellidos comunes son fáciles de adivinar',
	};

	const SUGGESTION_MAP: Readonly<Record<string, string>> = {
		'Use a few words, avoid common phrases':
			'Usa varias palabras, evita frases comunes',
		'No need for symbols, digits, or uppercase letters':
			'No necesitas símbolos, dígitos o mayúsculas obligatoriamente',
		'Add another word or two. Uncommon words are better.':
			'Añade otra palabra o dos. Palabras poco comunes son mejores.',
		"Capitalization doesn't help very much":
			'Las mayúsculas no ayudan mucho por sí solas',
		'All-uppercase is almost as easy to guess as all-lowercase':
			'Todo en mayúsculas es casi tan fácil como todo en minúsculas',
		"Reversed words aren't much harder to guess":
			'Palabras al revés no son mucho más difíciles',
		"Predictable substitutions like '@' instead of 'a' don't help very much":
			'Sustituciones predecibles como @ por a no ayudan mucho',
	};

	function buildSuggestions(result: ZXCVBNResult): string[] {
		const suggestions: string[] = [];
		const { feedback } = result;

		if (feedback.warning) {
			suggestions.push(WARNING_MAP[feedback.warning] ?? feedback.warning);
		}

		if (feedback.suggestions.length > 0) {
			for (const s of feedback.suggestions) {
				suggestions.push(SUGGESTION_MAP[s] ?? s);
			}
		}

		return suggestions;
	}

	function initPasswordMeter(wrapper: Element): void {
		const input = wrapper.querySelector<HTMLInputElement>(
			'input[type="password"], input[type="text"]',
		);
		const toggleBtn = wrapper.querySelector<HTMLButtonElement>(
			'[data-toggle-visibility]',
		);
		const eyeIcon = wrapper.querySelector<SVGElement>('[data-icon-eye]');
		const eyeOffIcon = wrapper.querySelector<SVGElement>('[data-icon-eye-off]');
		const barSegments =
			wrapper.querySelectorAll<HTMLDivElement>('[data-bar-segment]');
		const strengthLabel = wrapper.querySelector<HTMLSpanElement>(
			'[data-strength-label]',
		);
		const crackTimeEl =
			wrapper.querySelector<HTMLSpanElement>('[data-crack-time]');
		const suggestionEl =
			wrapper.querySelector<HTMLParagraphElement>('[data-suggestion]');
		const matchErrorEl =
			wrapper.querySelector<HTMLParagraphElement>('[data-match-error]');

		const criteriaItems: Readonly<Record<CriterionKey, HTMLLIElement | null>> =
			{
				length: wrapper.querySelector<HTMLLIElement>(
					'[data-criterion="length"]',
				),
				uppercase: wrapper.querySelector<HTMLLIElement>(
					'[data-criterion="uppercase"]',
				),
				lowercase: wrapper.querySelector<HTMLLIElement>(
					'[data-criterion="lowercase"]',
				),
				number: wrapper.querySelector<HTMLLIElement>(
					'[data-criterion="number"]',
				),
				special: wrapper.querySelector<HTMLLIElement>(
					'[data-criterion="special"]',
				),
				match: wrapper.querySelector<HTMLLIElement>('[data-criterion="match"]'),
			};

		if (!input) return;

		const minLength: number = Number(input.getAttribute('minlength') ?? 8);

		// ── Confirm input setup ───────────────────────────
		const confirmInputId =
			(wrapper as HTMLElement).dataset.confirmInputId ?? '';
		const confirmInput: HTMLInputElement | null = confirmInputId
			? document.querySelector<HTMLInputElement>(`#${confirmInputId}`)
			: null;

		// Mostrar criterio "match" solo si hay input de confirmación
		if (confirmInput && criteriaItems.match) {
			criteriaItems.match.classList.remove('hidden');
		}

		// Toggle visibilidad
		toggleBtn?.addEventListener('click', () => {
			const isPassword = input.type === 'password';
			input.type = isPassword ? 'text' : 'password';
			eyeIcon?.classList.toggle('hidden', isPassword);
			eyeOffIcon?.classList.toggle('hidden', !isPassword);
		});

		function updateCriterion(el: HTMLLIElement | null, passed: boolean): void {
			if (!el) return;
			const icon = el.querySelector<SVGElement>('[data-check-icon]');

			if (passed) {
				el.classList.remove('text-neutral-400', 'dark:text-neutral-500');
				el.classList.add('text-green-600', 'dark:text-green-400');
				if (icon) icon.style.opacity = '1';
			} else {
				el.classList.remove('text-green-600', 'dark:text-green-400');
				el.classList.add('text-neutral-400', 'dark:text-neutral-500');
				if (icon) icon.style.opacity = '0.3';
			}
		}

		function updateMatchError(passed: boolean): void {
			if (!matchErrorEl) return;
			matchErrorEl.classList.toggle('hidden', passed);
		}

		function checkPasswordsMatch(): boolean {
			if (!confirmInput) return true;
			const passwordVal = input!.value;
			const confirmVal = confirmInput.value;

			// No validar si la confirmación está vacía
			if (!confirmVal) {
				updateCriterion(criteriaItems.match, false);
				updateMatchError(true); // Ocultar error si está vacío
				setConfirmInputValidation('');
				return false;
			}

			const matches = passwordVal === confirmVal;
			updateCriterion(criteriaItems.match, matches);
			updateMatchError(matches);
			setConfirmInputValidation(matches ? '' : 'Las contraseñas no coinciden');
			return matches;
		}

		/** Usa la Constraint Validation API nativa para bloquear el submit */
		function setConfirmInputValidation(message: string): void {
			if (!confirmInput) return;
			confirmInput.setCustomValidity(message);
		}

		function resetUI(): void {
			barSegments.forEach((seg) => {
				seg.style.backgroundColor = '';
				seg.classList.add('bg-gray-200', 'dark:bg-gray-700');
			});

			if (strengthLabel) {
				strengthLabel.textContent = '';
				strengthLabel.className =
					'text-xs font-medium text-neutral-500 dark:text-neutral-400 transition-colors';
			}
			if (crackTimeEl) crackTimeEl.textContent = '';
			if (suggestionEl) suggestionEl.textContent = '';

			(Object.values(criteriaItems) as (HTMLLIElement | null)[]).forEach((el) =>
				updateCriterion(el, false),
			);
			updateMatchError(true);
		}

		async function evaluate(password: string): Promise<void> {
			if (!password) {
				resetUI();
				return;
			}

			// Evaluar criterios individuales
			const criteria: Record<Exclude<CriterionKey, 'match'>, boolean> = {
				length: password.length >= minLength,
				uppercase: /[A-Z]/.test(password),
				lowercase: /[a-z]/.test(password),
				number: /\d/.test(password),
				special: /[^A-Za-z0-9]/.test(password),
			};

			for (const [key, passed] of Object.entries(criteria) as [
				Exclude<CriterionKey, 'match'>,
				boolean,
			][]) {
				updateCriterion(criteriaItems[key], passed);
			}

			// Evaluar coincidencia
			checkPasswordsMatch();

			// zxcvbn analysis (lazy-loaded)
			const zxcvbn = await getZxcvbn();
			const result: ZXCVBNResult = zxcvbn(password);
			const score: ZXCVBNScore = result.score;
			const config: StrengthConfig = STRENGTH_MAP[score];

			// Actualizar barras
			barSegments.forEach((seg, i) => {
				seg.classList.remove('bg-gray-200', 'dark:bg-gray-700');
				if (i < config.segments) {
					seg.style.backgroundColor = config.color;
				} else {
					seg.style.backgroundColor = '';
					seg.classList.add('bg-gray-200', 'dark:bg-gray-700');
				}
			});

			// Label de fuerza
			if (strengthLabel) {
				strengthLabel.textContent = config.label;
				strengthLabel.className = `text-xs font-medium ${config.textClass} transition-colors`;
			}

			// // Tiempo estimado de crack
			// if (crackTimeEl) {
			// 	const displayTime: string =
			// 		result.crack_times_display.offline_slow_hashing_1e4_per_second;
			// 	crackTimeEl.textContent = displayTime ? `${displayTime}` : '';
			// }

			// Sugerencias traducidas
			if (suggestionEl) {
				const suggestions = buildSuggestions(result);
				suggestionEl.textContent =
					suggestions.length > 0 ? `${suggestions[0]}` : '';
			}
		}

		// Evaluar al escribir en el password principal
		input.addEventListener('input', () => {
			evaluate(input.value);
		});

		// Evaluar coincidencia al escribir en el confirm
		confirmInput?.addEventListener('input', () => {
			checkPasswordsMatch();
		});

		// Limpiar validación custom al enfocar el confirm (UX)
		confirmInput?.addEventListener('focus', () => {
			if (confirmInput.value === '') {
				setConfirmInputValidation('');
			}
		});

		// Dispatch evento custom tipado
		input.addEventListener('input', async () => {
			const zxcvbn = await getZxcvbn();
			const result: ZXCVBNResult = zxcvbn(input.value);
			const matches = confirmInput ? input.value === confirmInput.value : true;

			wrapper.dispatchEvent(
				new CustomEvent<{
					score: ZXCVBNScore;
					password: string;
					matches: boolean;
				}>('password-strength', {
					detail: {
						score: result.score,
						password: input.value,
						matches,
					},
					bubbles: true,
				}),
			);
		});
	}

	function initAll(): void {
		document
			.querySelectorAll<HTMLElement>('[data-password-meter]')
			.forEach(initPasswordMeter);
	}

	// Soporte para Astro View Transitions
	initAll();
	document.addEventListener('astro:page-load', initAll);
</script>

<style>
	[data-bar-segment] {
		transition: background-color 0.3s ease;
	}

	[data-check-icon] {
		transition: opacity 0.2s ease;
		opacity: 0.3;
	}

	[data-suggestion] {
		transition: opacity 0.2s ease;
	}
</style>
