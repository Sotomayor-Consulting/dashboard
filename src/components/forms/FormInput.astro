---
interface Props {
	label: string;
	name?: string | undefined;
	value?: string | undefined;
	type?: 'text' | 'number' | 'date' | 'email' | 'tel' | 'hidden';
	placeholder?: string | undefined;
	required?: boolean | undefined;
	disabled?: boolean | undefined;
	id?: string | undefined;
	class?: string | undefined;
	error?: string | undefined;
}

const {
	label,
	disabled = false,
	name,
	id = name ?? label.toLowerCase().replace(/\s+/g, '-'),
	value = '',
	placeholder,
	type = 'text',
	required = false,
	class: wrapperClass = 'col-span-6 sm:col-span-3',
	error,
} = Astro.props;

const inputClasses = [
	'block w-full rounded-lg border bg-transparent px-3 py-2.5',
	'text-foreground sm:text-sm',
	'placeholder:text-muted-foreground',
	'transition focus:border-accent-gold focus:ring-accent-gold',
	disabled && 'cursor-not-allowed bg-muted/40',
	error
		? 'border-red-500 dark:border-red-500'
		: 'border-border',
]
	.filter(Boolean)
	.join(' ');
---

<div class={wrapperClass}>
	{label && (
		<label
			for={id}
			class="mb-2 block text-sm font-medium text-foreground"
		>
			{label}
		</label>
	)}
	{
		disabled ? (
			<label class={inputClasses}>{value}</label>
		) : (
			<input
				type={type}
				name={name}
				id={id}
				value={value ?? ''}
				placeholder={placeholder}
				required={required}
				class={inputClasses}
				data-field={name}
			/>
		)
	}
	<p
		class="mt-1 hidden text-sm text-red-600 dark:text-red-400"
		data-error={name}
	>
		{error}
	</p>
</div>
