---
interface Props {
	backPath?: string;
}

const { backPath = '/admin/notifications/' } = Astro.props as Props;
const formAction = `/api/notifications/admin-update?back=${encodeURIComponent(backPath)}`;
---

<div
	id="send-email-modal"
	class="fixed inset-0 z-50 hidden items-center justify-center bg-black p-4"
>
	<div
		class="w-full max-w-2xl rounded-lg border border-gray-200 bg-white p-5 shadow-xl dark:border-gray-700 dark:bg-[#0e2738]"
	>
		<div class="mb-4 flex items-center justify-between">
			<div>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
					Enviar notificación
				</h3>
				<p
					class="text-sm text-gray-500 dark:text-gray-400"
					id="notification-target"
				>
					Selecciona un usuario para enviar
				</p>
			</div>
			<button
				type="button"
				class="rounded-md p-2 text-gray-500 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-[#101522]"
				data-close-notification-modal
			>
				Cerrar
			</button>
		</div>

		<form
			id="notification-form"
			method="post"
			action={formAction}
			class="space-y-4"
		>
			<input
				type="hidden"
				name="user_id_modal_name"
				id="notification-user-id"
			/>

			<div>
				<label
					for="mensaje-notificacion"
					class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-100"
				>
					Mensaje
				</label>
				<textarea
					id="mensaje-notificacion"
					name="mensaje-notificacion"
					rows="4"
					required
					class="block w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm text-gray-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-700 dark:bg-[#101522] dark:text-white"
					placeholder="Escribe el mensaje de la notificacion..."></textarea>
			</div>

			<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
				<div>
					<label
						for="link-notificacion"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-100"
					>
						URL (opcional)
					</label>
					<input
						type="text"
						id="link-notificacion"
						name="link-notificacion"
						class="block w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm text-gray-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-700 dark:bg-[#101522] dark:text-white"
						placeholder="/my-companies/..."
					/>
				</div>
				<div>
					<label
						for="descripcion-link-notificacion"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-100"
					>
						Texto del boton (opcional)
					</label>
					<input
						type="text"
						id="descripcion-link-notificacion"
						name="descripcion-link-notificacion"
						class="block w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm text-gray-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-700 dark:bg-[#101522] dark:text-white"
						placeholder="Ver detalle"
					/>
				</div>
			</div>

			<div class="rounded-lg border border-gray-200 p-3 dark:border-gray-700">
				<label
					class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200"
				>
					<input
						type="checkbox"
						name="send_email"
						id="send-email-checkbox"
						class="h-4 w-4 rounded border-gray-300"
					/>
					Enviar también por correo
				</label>

				<div class="mt-3 grid grid-cols-1 gap-3" id="email-extra-fields">
					<input
						type="text"
						name="email_subject"
						id="email_subject"
						class="block w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm text-gray-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-700 dark:bg-[#101522] dark:text-white"
						placeholder="Asunto del correo (opcional)"
					/>
					<textarea
						name="email_html"
						id="email_html"
						rows="4"
						class="block w-full rounded-lg border border-gray-300 bg-white p-2.5 text-sm text-gray-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-700 dark:bg-[#101522] dark:text-white"
						placeholder="HTML del correo (opcional, si no se envias usa plantilla por defecto)"
					></textarea>
				</div>
			</div>

			<div class="flex items-center justify-end gap-2 pt-2">
				<button
					type="button"
					data-close-notification-modal
					class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-[#101522]"
				>
					Cancelar
				</button>
				<button
					type="submit"
					class="rounded-lg bg-[#8c681d] px-4 py-2 text-sm font-medium text-white hover:bg-[#8c681d]/90"
				>
					Enviar notificación
				</button>
			</div>
		</form>
	</div>
</div>

<script is:inline>
	(() => {
		const modal = document.getElementById('send-email-modal');
		const userIdInput = document.getElementById('notification-user-id');
		const target = document.getElementById('notification-target');
		const form = document.getElementById('notification-form');

		if (!modal || !userIdInput || !target || !form) return;

		const openModal = (detail) => {
			userIdInput.value = detail?.userId ?? '';
			const safeEmail =
				detail?.email && detail.email !== '—' ? ` (${detail.email})` : '';
			target.textContent = detail?.userName
				? `Destino: ${detail.userName}${safeEmail}`
				: 'Selecciona un usuario para enviar';
			modal.classList.remove('hidden');
			modal.classList.add('flex');
		};

		const closeModal = () => {
			modal.classList.add('hidden');
			modal.classList.remove('flex');
		};

		document.addEventListener('open-notification-modal', (event) => {
			openModal(event.detail || {});
		});

		modal
			.querySelectorAll('[data-close-notification-modal]')
			.forEach((button) => {
				button.addEventListener('click', closeModal);
			});

		modal.addEventListener('click', (event) => {
			if (event.target === modal) closeModal();
		});

		form.addEventListener('submit', () => {
			const submitButton = form.querySelector('button[type="submit"]');
			if (submitButton) submitButton.setAttribute('disabled', 'true');
		});
	})();
</script>
