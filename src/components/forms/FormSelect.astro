---
interface Option {
	value: string;
	label: string;
}

interface Props {
	label: string;
	name: string;
	options: Option[];
	value?: string | undefined;
	required?: boolean | undefined;
	disabled?: boolean | undefined;
	id?: string | undefined;
	class?: string | undefined;
	placeholder?: string | undefined;
	error?: string | undefined;
}

const {
	label,
	name,
	options,
	value = '',
	required = false,
	disabled = false,
	id = name,
	class: wrapperClass = 'col-span-6 sm:col-span-3',
	placeholder = 'Seleccione una opción',
	error,
} = Astro.props;

const selectClasses = [
	'block w-full rounded-lg border bg-gray-50 p-2.5',
	'text-gray-900 shadow-sm sm:text-sm',
	'focus:border-primary-500 focus:ring-primary-500',
	'dark:bg-[#101521] dark:text-white',
	'dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]',
	disabled && 'cursor-not-allowed opacity-50',
	error
		? 'border-red-500 dark:border-red-500'
		: 'border-gray-300 dark:border-gray-600',
]
	.filter(Boolean)
	.join(' ');
---

<div class={wrapperClass}>
	<label
		for={id}
		class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
	>
		{label}
	</label>
	<select
		name={name}
		id={id}
		required={required}
		disabled={disabled}
		class={selectClasses}
		data-field={name}
	>
		<option value="" disabled selected={!value}>
			{placeholder}
		</option>
		{
			options.map((option) => (
				<option value={option.value} selected={option.value === value}>
					{option.label}
				</option>
			))
		}
	</select>
	<p
		class="mt-1 hidden text-sm text-red-600 dark:text-red-400"
		data-error={name}
	>
		{error}
	</p>
</div>
