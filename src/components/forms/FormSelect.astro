---
interface Option {
	value: string;
	label: string;
}

interface Props {
	label: string;
	name: string;
	options: Option[];
	value?: string | undefined;
	required?: boolean | undefined;
	disabled?: boolean | undefined;
	id?: string | undefined;
	class?: string | undefined;
	placeholder?: string | undefined;
	error?: string | undefined;
}

const {
	label,
	name,
	options,
	value = '',
	required = false,
	disabled = false,
	id = name,
	class: wrapperClass = 'col-span-6 sm:col-span-3',
	placeholder = 'Seleccione una opción',
	error,
} = Astro.props;

const selectClasses = [
	'block w-full rounded-lg border bg-transparent px-3 py-2.5',
	'text-foreground sm:text-sm',
	'transition focus:border-accent-gold focus:ring-accent-gold',
	disabled && 'cursor-not-allowed opacity-50',
	error
		? 'border-red-500 dark:border-red-500'
		: 'border-border',
]
	.filter(Boolean)
	.join(' ');
---

<div class={wrapperClass}>
	{label && (
		<label
			for={id}
			class="mb-2 block text-sm font-medium text-foreground"
		>
			{label}
		</label>
	)}
	<select
		name={name}
		id={id}
		required={required}
		disabled={disabled}
		class={selectClasses}
		data-field={name}
	>
		<option value="" disabled selected={!value}>
			{placeholder}
		</option>
		{
			options.map((option) => (
				<option value={option.value} selected={option.value === value}>
					{option.label}
				</option>
			))
		}
	</select>
	<p
		class="mt-1 hidden text-sm text-red-600 dark:text-red-400"
		data-error={name}
	>
		{error}
	</p>
</div>
