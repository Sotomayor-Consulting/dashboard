---
interface Props {
	label: string;
	name: string;
	value?: string | undefined;
	initialCountry?: string | undefined;
	required?: boolean | undefined;
	id?: string | undefined;
	class?: string | undefined;
}
const {
	label,
	name,
	value = '',
	initialCountry = 'us',
	required = false,
	id = `phone-${name}`,
	class: wrapperClass = 'col-span-6 sm:col-span-3',
} = Astro.props;
---

<div class={wrapperClass}>
	<label
		for={id}
		class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
	>
		{label}
	</label>
	<input
		type="tel"
		id={id}
		value={value ?? ''}
		placeholder=""
		class="iti-input focus:border-primary-500 focus:ring-primary-500 dark:bg-black-900 dark:focus:border-black-400 bg-white-50 block w-full rounded-lg border border-gray-300 p-2.5 text-gray-900 shadow-sm sm:text-sm dark:border-gray-600 dark:text-white dark:placeholder-gray-400"
		data-phone-input
		data-phone-name={name}
		data-phone-country={initialCountry}
		data-phone-required={required ? 'true' : undefined}
	/>
	<p
		class="mt-1 hidden text-sm text-red-600 dark:text-red-400"
		data-phone-error={id}
	>
		Número de teléfono inválido
	</p>
</div>
<script>
	import intlTelInput from 'intl-tel-input/intlTelInputWithUtils';
	import es from 'intl-tel-input/i18n/es';
	import 'intl-tel-input/styles';
	function initPhoneInputs() {
		const inputs =
			document.querySelectorAll<HTMLInputElement>('[data-phone-input]');
		inputs.forEach((input) => {
			if (intlTelInput.getInstance(input)) return;
			const name = input.dataset.phoneName || 'phone';
			const country = input.dataset.phoneCountry || 'us';
			const isRequired = input.dataset.phoneRequired === 'true';
			const iti = intlTelInput(input, {
				i18n: es,
				initialCountry: country as any,
				nationalMode: true,
				formatAsYouType: true,
				separateDialCode: true,
				countrySearch: true,
				strictMode: true,
				hiddenInput: () => ({
					phone: name,
					country: `${name}_country`,
				}),
			});
			// Validación inline (opcional, si el form lo requiere)
			if (isRequired) {
				const errorEl = document.querySelector(
					`[data-phone-error="${input.id}"]`,
				);
				input.addEventListener('blur', () => {
					const isValid = iti.isValidNumber();
					input.classList.toggle(
						'border-red-500',
						!isValid && input.value !== '',
					);
					errorEl?.classList.toggle('hidden', isValid || input.value === '');
				});
				// Limpiar error al escribir
				input.addEventListener('input', () => {
					input.classList.remove('border-red-500');
					errorEl?.classList.add('hidden');
				});
			}
		});
	}
	document.addEventListener('DOMContentLoaded', initPhoneInputs);
	document.addEventListener('astro:page-load', initPhoneInputs);
</script>

