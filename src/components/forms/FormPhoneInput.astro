---
interface Props {
	label: string;
	name: string;
	value?: string | undefined;
	initialCountry?: string | undefined;
	required?: boolean | undefined;
	id?: string | undefined;
	class?: string | undefined;
}
const {
	label,
	name,
	value = '',
	initialCountry = 'us',
	required = false,
	id = `phone-${name}`,
	class: wrapperClass = 'col-span-6 sm:col-span-3',
} = Astro.props;
---

<div class={wrapperClass}>
	{label && (
		<label
			for={id}
			class="mb-2 block text-sm font-medium text-foreground"
		>
			{label}
		</label>
	)}
	<input
		type="tel"
		id={id}
		value={value ?? ''}
		placeholder=""
		class="block w-full rounded-lg border border-border bg-transparent px-3 py-2.5 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-accent-gold focus:ring-accent-gold"
		data-phone-input
		data-phone-name={name}
		data-phone-country={initialCountry}
		data-phone-required={required ? 'true' : undefined}
		data-field={name}
	/>
	<p
		class="mt-1 hidden text-sm text-red-600 dark:text-red-400"
		data-error={name}
	>
		Número de teléfono inválido
	</p>
</div>

<script>
	import intlTelInput from 'intl-tel-input/intlTelInputWithUtils';

	function initPhoneInputs() {
		const inputs =
			document.querySelectorAll<HTMLInputElement>('[data-phone-input]');
		inputs.forEach((input) => {
			if ((input as any)._iti) return;
			const existing = intlTelInput.getInstance(input);
			if (existing) {
				existing.destroy();
			}

			const name = input.dataset.phoneName || 'telefono';
			const country = input.dataset.phoneCountry || 'us';
			const isRequired = input.dataset.phoneRequired === 'true';

			const iti = intlTelInput(input, {
				initialCountry: country as any,
				formatAsYouType: true,
				separateDialCode: true,
				countrySearch: true,
				strictMode: true,
				countrySelectorMode: 'DROPDOWN' as any,
				dropdownParent: document.body,
				hiddenInputs: () => ({
					phone: name,
					country: `${name}_country`,
				}),
			});

			(input as any)._iti = iti;

			if (isRequired) {
				const errorEl = document.querySelector(
					`[data-error="${name}"]`,
				);
				input.addEventListener('blur', () => {
					const isValid = iti.isValidNumber();
					input.classList.toggle(
						'border-red-500',
						!isValid && input.value !== '',
					);
					errorEl?.classList.toggle('hidden', isValid || input.value === '');
				});
				input.addEventListener('input', () => {
					input.classList.remove('border-red-500');
					errorEl?.classList.add('hidden');
				});
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPhoneInputs);
	} else {
		initPhoneInputs();
	}
	document.addEventListener('astro:page-load', initPhoneInputs);
</script>
