---
import { Icon } from 'astro-icon/components';

// Datos calculados en LayoutSidebar y pasados como prop
const { shouldShowBanner = false } = Astro.props;

const BANNER_PROPS = {
	title: 'Tu compañía esta pendiente a incorporar. Desbloquea sus beneficios.',
	btnId: 'dismiss-incorp-banner',
	btnTitle: 'Continuar al pago',
	url: '/incorporacion-y-pago',
};
---

{
	shouldShowBanner && (
		<astro-banner btnId={BANNER_PROPS.btnId}>
			<div
				id="marketing-banner"
				tabindex="-1"
				class="dark:bg-black-800 animate-fade-in dark:border-black-600 top-28 right-4 mt-2 flex w-full flex-col justify-between rounded-2xl border border-gray-100 bg-white p-4 shadow-xs md:flex-row"
			>
				<div class="me-4 mb-3 flex flex-row items-center md:mb-0">
					<a
						href="/"
						class="me-4 mb-2 hidden items-center border-e border-gray-200 pe-4 md:mb-0 md:flex dark:border-gray-600"
					>
						<Icon
							name="isotipo_azul"
							class="block text-3xl dark:hidden"
							title="Logo Sotomayor Consulting"
						/>
						<Icon
							name="isotipo_blanco_alt"
							class="mr-3 hidden text-3xl dark:block"
							title="Logo Sotomayor Consulting"
						/>
					</a>
					<p class="flex items-center text-base font-normal text-black dark:text-white">
						{BANNER_PROPS.title}
					</p>
				</div>
				<div class="flex shrink-0 items-center justify-between">
					<a
						href={BANNER_PROPS.url}
						class="bg-black-600 hover:bg-black-500 dark:bg-black-400 dark:hover:bg-black-500 me-2 rounded-lg px-5 py-2 text-base font-medium text-white focus:ring-4 focus:ring-blue-300 focus:outline-none dark:focus:ring-[#323f67]"
					>
						{BANNER_PROPS.btnTitle}
					</a>
					<button
						data-dismiss-target="#marketing-banner"
						type="button"
						class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					>
						<svg
							class="h-3 w-3"
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 14 14"
						>
							<path
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
							/>
						</svg>
						<span class="sr-only">Close banner</span>
					</button>
				</div>
			</div>
		</astro-banner>
	)
}

<style>
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fade-in 0.5s ease-out forwards;
	}
</style>
