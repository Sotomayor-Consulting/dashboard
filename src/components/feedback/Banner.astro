---
import BannerToast from './islands/BannerToast.tsx';

const { shouldShowBanner = false } = Astro.props;

const BANNER_PROPS = {
	title: 'Tu compania esta pendiente a incorporar. Desbloquea sus beneficios.',
	btnTitle: 'Continuar al pago',
	url: '/incorporation-and-payment',
};
---

{
	shouldShowBanner && (
		<BannerToast
			title={BANNER_PROPS.title}
			ctaLabel={BANNER_PROPS.btnTitle}
			url={BANNER_PROPS.url}
			client:load
		/>
	)
}
