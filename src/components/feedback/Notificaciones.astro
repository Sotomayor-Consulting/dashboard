---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import '@styles/datatables.css';
import logonotificaciones from '/src/assets/avatarSCI.png';
import Alerta from '@components/feedback/alertageneral.astro';
import { getNotificacionesGeneralPorId } from '@lib/tablas/notificaciones';

const user = Astro.locals.user;
const userId = user?.id;
const supabase = Astro.locals.supabase;

const notificaciones = userId
	? await getNotificacionesGeneralPorId(supabase, userId)
	: null;
---

<script src="@lib/alpinejs/alpine.js"></script>
<Alerta />
<div class="flex flex-col">
	<div class="overflow-x-auto">
		<div class="inline-block min-w-full align-middle">
			<div class="overflow-hidden shadow">
				<table
					class="min-w-full divide-y divide-gray-200 dark:divide-gray-600"
					id="myTable"
				>
					<thead class="bg-gray-100 dark:bg-[#374151]">
						<tr>
							{
								[
									'Icono',
									'Id',
									'Mensaje',
									'Link',
									'Fecha',
									'Marcado como leído',
									'Acciones',
								].map((th) => (
									<th
										scope="col"
										class="p-4 text-left text-xs font-medium text-gray-500 uppercase dark:text-gray-400"
									>
										<span class="flex items-center">
											{th}
											<svg
												class="ms-1 h-4 w-4"
												aria-hidden="true"
												xmlns="http://www.w3.org/2000/svg"
												width="24"
												height="24"
												fill="none"
												viewBox="0 0 24 24"
											>
												<path
													stroke="currentColor"
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="m8 15 4 4 4-4m0-6-4-4-4 4"
												/>
											</svg>
										</span>
									</th>
								))
							}
						</tr>
					</thead>
					<tbody
						class="dark:bg-black-800 divide-y divide-gray-200 bg-white dark:divide-gray-700"
					>
						{
							notificaciones?.map((user) => (
								<div>
									<tr class="odd:bg-white even:bg-[#d4d4d4] hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]">
										<td class="w-4 pl-4">
											<Image
												src={logonotificaciones}
												width="44"
												alt="Icono Sotomayor Consulting"
												class="rounded-full"
											/>
										</td>
										<td class="max-w-sm truncate overflow-hidden p-4 text-base font-medium whitespace-nowrap text-gray-900 xl:max-w-xs dark:text-gray-500">
											#{user.id}
										</td>
										<td class="max-w-sm truncate p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
											{user.message}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											<a
												href={user.link}
												target="_blank"
												class="me-2 mb-2 flex w-fit items-center gap-4 rounded-full bg-[#967432] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 focus:ring-[#8c681d] focus:outline-none dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
											>
												{user.mensaje_link}
												<Icon name="ri:external-link-line" />
											</a>
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{user.created_at &&
												new Date(user.created_at)
													.toLocaleDateString('es-ES', {
														day: '2-digit',
														month: '2-digit',
														year: 'numeric',
													})
													.replace(/\//g, '-')}
										</td>

										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											<div class="flex items-center">
												{user.is_read === true ? (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-green-400" />
												) : (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-red-500" />
												)}
												{user.is_read ? 'Leído' : 'No leído'}
											</div>
										</td>

										<td
											class="space-x-2 p-4 whitespace-nowrap"
											x-data="{ showTooltip: false }"
										>
											<button
												type="button"
												data-modal-target="edit-user-modal"
												data-modal-toggle="edit-user-modal"
												data-edit-user
												data-user-id={user.id}
												data-user-userid={user.user_id}
												data-mensaje={user.message || ''}
												data-isread={user.is_read || ''}
												data-fecha-leido={user.leido_en || ''}
												data-creado={user.created_at || ''}
												data-link={user.link || ''}
												data-mensajelink={user.mensaje_link ?? ''}
												class="inline-flex items-center rounded-lg bg-[#967432] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 focus:ring-[#967432] dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
											>
												<svg
													xmlns="http://www.w3.org/2000/svg"
													class="mr-2 h-4 w-4"
													viewBox="0 0 24 24"
												>
													<path
														fill="currentColor"
														d="M12 9a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3m0 8a5 5 0 0 1-5-5a5 5 0 0 1 5-5a5 5 0 0 1 5 5a5 5 0 0 1-5 5m0-12.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5"
													/>
												</svg>
												Ver notificación
											</button>

											<button
												id={`dd-btn-${user.id}`}
												@click="showTooltip = !showTooltip"
												@click.outside="showTooltip = false"
												class="dark:bg-black-800 inline-flex items-center rounded-lg bg-white p-2 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-50 focus:outline-none dark:text-white dark:hover:bg-[#101522] dark:focus:ring-gray-600"
												type="button"
												aria-haspopup="true"
												aria-expanded="false"
											>
												<svg
													class="h-5 w-5"
													aria-hidden="true"
													xmlns="http://www.w3.org/2000/svg"
													fill="currentColor"
													viewBox="0 0 4 15"
												>
													<path d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
												</svg>
											</button>
											<div
												id={`dd-${user.id}`}
												class="dark:bg-black-800 absolute z-10 mt-1 w-44 divide-y divide-gray-100 rounded-lg bg-white shadow-sm dark:divide-gray-600"
												role="menu"
												x-show="showTooltip"
												x-transition
												aria-labelledby={`dd-btn-${user.id}`}
												data-dropdown-placement="bottom-start"
											>
												<ul
													class="py-2 text-sm text-gray-700 dark:text-gray-200"
													role="none"
												>
													<li>
														{user.is_read === true ? (
															<a
																href="/notificaciones"
																class="block w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
																role="menuitem"
															>
																Marcar como leído
															</a>
														) : (
															<form
																action="/api/update/update-notification"
																method="post"
															>
																<input
																	type="hidden"
																	value="true"
																	name="estado_lectura"
																/>
																<input
																	type="hidden"
																	value={user.id}
																	name="id"
																/>
																<button
																	type="submit"
																	class="block w-full cursor-pointer px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
																	role="menuitem"
																>
																	Marcar como leído
																</button>
															</form>
														)}
													</li>
												</ul>
											</div>
										</td>
									</tr>
								</div>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<!-- Edit User Modal -->
<div
	class="h-modal fixed top-4 right-0 left-0 z-50 hidden items-center justify-center overflow-x-hidden overflow-y-auto sm:h-full md:inset-0"
	id="edit-user-modal"
>
	<div class="relative h-full w-full max-w-2xl px-4 md:h-auto">
		<!-- Modal content -->
		<div class="dark:bg-black-900 relative rounded-lg bg-white shadow">
			<!-- Modal header -->
			<div
				class="flex items-start justify-between rounded-t border-b p-5 dark:border-gray-700"
			>
				<h3 class="text-base leading-relaxed text-gray-500 dark:text-gray-400">
					Notificación #<span
						class="text-base leading-relaxed text-gray-500 dark:text-gray-400"
						id="display_id"></span>
				</h3>
				<button
					type="button"
					class="ml-auto inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-[#101522] dark:hover:text-white"
					data-modal-toggle="edit-user-modal"
				>
					<svg
						class="h-5 w-5"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path></svg
					>
				</button>
			</div>
			<!-- Modal body -->
			<div class="space-y-4 p-4 md:p-5">
				<div class="flex justify-between">
					<p
						class="text-sm leading-relaxed text-gray-500 dark:text-gray-400"
						id="display_leido"
					>
					</p>
					<p
						class="text-sm leading-relaxed text-gray-500 dark:text-gray-400"
						id="display_fecha_creacion"
					>
					</p>
				</div>
				<div>
					<p
						class="mb-3 text-base leading-relaxed text-gray-500 dark:text-gray-400"
					>
						Mensaje:
					</p>
					<p
						class="text-base leading-relaxed text-gray-500 dark:text-gray-300"
						id="display_mensaje"
					>
						No se pudo leer el mensaje de la notificación.
					</p>
				</div>
				<div class="py-5">
					<a
						href="http://"
						target="_blank"
						rel="noopener noreferrer"
						id="enlace_display_link"
						class="rounded-lg bg-blue-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-800 dark:focus:ring-blue-800"
						title="ir"></a>
				</div>
			</div>
		</div>
	</div>
</div>
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// Seleccionar los botones
		const btns = document.querySelectorAll('[data-edit-user]');

		// Función auxiliar para setear el texto en cualquier elemento de visualización
		function setTextContent(id, text) {
			const el = document.getElementById(id);
			if (el) {
				el.textContent = text ?? '';
			}
		}

		// Función auxiliar para establecer atributos (como href, class, src)
		function setAttributeValue(id, attribute, value) {
			const el = document.getElementById(id);
			if (el) {
				el.setAttribute(attribute, value ?? '');
			}
		}

		// Nota: Mantenemos setValue solo si todavía lo necesitas para inputs en el modal.
		function setValue(id, val) {
			const el = document.getElementById(id);
			if (el) el.value = val ?? '';
		}

		// Función: Formatea el string ISO de fecha/hora a un formato de fecha corto
		const formatFecha = (fechaStr) => {
			if (!fechaStr) return 'N/A';

			try {
				const dateObj = new Date(fechaStr);
				return dateObj.toLocaleDateString('es-ES', {
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
				});
			} catch (e) {
				return 'Fecha inválida';
			}
		};

		// ----------------------------------------------------------------------

		btns.forEach((btn) => {
			btn.addEventListener('click', () => {
				// Obtención de DataSets
				const id = btn.dataset.userId ?? '';
				const mensaje = btn.dataset.mensaje ?? '';
				const leido = btn.dataset.isread ?? '';
				const fechalectura = btn.dataset.fechaLeido ?? '';
				const creado = btn.dataset.creado ?? '';
				const link = btn.dataset.link ?? ''; // URL para el href
				const mensajelink = btn.dataset.mensajelink ?? ''; // Texto para el enlace

				// 1. Transformación del booleano (string)
				const estadoLeidoTexto = leido === 'true' ? 'Leído' : 'No leído';

				// 2. Formateo de las fechas
				const fechaLeidoFormateada = formatFecha(fechalectura);
				const creadoFormateado = formatFecha(creado);

				// ----------------------------------------------------------------------
				// Asignación de Link y Texto del Enlace (CLAVE)
				// ----------------------------------------------------------------------
				const enlaceId = 'enlace_display_link'; // ID de tu etiqueta <a>

				// 🎯 Establece la URL en el atributo href
				setAttributeValue(enlaceId, 'href', link);

				// 🎯 Establece el texto visible del enlace
				setTextContent(enlaceId, mensajelink);

				// ----------------------------------------------------------------------
				// Asignación de valores (Display)
				// ----------------------------------------------------------------------

				setTextContent('display_id', id);
				setTextContent('display_mensaje', mensaje);
				setTextContent('display_leido', estadoLeidoTexto);
				setTextContent('display_fecha_lectura', fechaLeidoFormateada);
				setTextContent('display_fecha_creacion', creadoFormateado);

				// Nota: Ya no necesitas estas líneas si el enlace tiene su propio ID:
				// setTextContent('display_link', link);
				// setTextContent('display_mensajelink', mensajelink);

				// ... (El resto de tu lógica para setValue)
			});
		});
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('updaterolForm');
		const uidInput = document.getElementById('updaterol_user_id');
		const estadoSel = document.getElementById('updaterol_estado');
		const nameSpan = document.getElementById('updaterolUserName');

		// Botones que abren el modal (uno por fila/usuario)
		const btns = document.querySelectorAll('[data-open-estado]');

		btns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const uid = btn.dataset.userId || '';
				const uname = btn.dataset.userName || '';
				const estCur = btn.dataset.userEstado || '';

				// Inyecta user_id y muestra nombre
				uidInput.value = uid;
				nameSpan.textContent = uname ? ` · ${uname}` : '';

				// Preselecciona estado si coincide; si no, deja "(sin cambio)"
				const hasOption = Array.from(estadoSel.options).some(
					(o) => o.value === estCur,
				);
				estadoSel.value = hasOption ? estCur : '';

				// Endpoint + retorno a esta misma página
				const back = location.pathname + location.search;
				form.action = `/api/admin/usuarios/update?back=${encodeURIComponent(back)}`;
			});
		});

		// Anti doble-submit (opcional)
		form?.addEventListener('submit', () => {
			const submitBtn = form?.querySelector('button[type="submit"]');
			if (submitBtn) submitBtn.disabled = true;
		});
	});
</script>
<script>
	import { DataTable } from '@lib/simple-data-tables/simple-data-table.js';

	function initDT() {
		const el = document.querySelector('#myTable') as HTMLElement | null;
		if (!el) return;
		if ((el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit === '1')
			return;

		new DataTable(el, {
			searchable: true,
			perPage: 25,
			perPageSelect: [5, 10, 25, 50],

			// Textos en español
			labels: {
				placeholder: 'Buscar...',
				perPage: 'Filas',
				noRows: 'No hay usuarios',
				noResults: 'No se encontraron resultados',
				info: 'Mostrando {start} a {end} de {rows} registros',
			},

			// Layout estilo Flowbite (arriba: perPage + search / abajo: info + paging)
			layout: {
				top: '{select}{search}',
				bottom: '{info}{pager}',
			},
		});

		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit = '1';
		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInstance = '1';
	}

	initDT();
	document.addEventListener('astro:page-load', initDT);
</script>
