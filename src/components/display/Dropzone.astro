---
interface Props {
	endpoint: string;
	id?: string;
	maxFilesize?: number;
	acceptedFiles?: string;
	mensaje: string;
}

const {
	endpoint,
	mensaje,
	id = 'hs-file-upload',
	maxFilesize = 2,
	acceptedFiles = '.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp',
} = Astro.props;
---

<div class="flex w-full flex-col items-center justify-center">
	<div class="flex w-full flex-col items-center justify-center">
		<div
			id={id}
			data-id={id}
			data-endpoint={endpoint}
			data-maxfilesize={maxFilesize}
			data-acceptedfiles={acceptedFiles}
			class="h-full w-full"
			data-hs-file-upload='{
 "extensions": {
   "default": {
     "class": "shrink-0 size-5"
   },
   "xls": {
     "class": "shrink-0 size-5"
   },
   "zip": {
     "class": "shrink-0 size-5"
   },
   "csv": {
     "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4\"/><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"/><path d=\"m5 12-3 3 3 3\"/><path d=\"m9 18 3-3-3-3\"/></svg>",
     "class": "shrink-0 size-5"
   }
 }
}'
		>
			<template data-hs-file-upload-preview="">
				<div
					class="bg-white-100 dark:bg-black-600 flex min-h-96 flex-col items-center justify-center rounded-xl border border-solid border-gray-300 p-3 dark:border-neutral-600"
				>
					<div
						class="to-black-700 from-black-900 mb-2 flex w-full items-center justify-between rounded-2xl bg-white p-5 dark:bg-linear-to-br"
					>
						<div class="flex w-full items-center gap-x-3">
							<span
								class="dark:bg-black-600 dark:border-black-400 flex size-10 items-center justify-center rounded-lg border border-gray-200 bg-gray-100 text-gray-500 dark:text-white"
								data-hs-file-upload-file-icon=""
							>
								<svg
									class="size-5"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
									></path>
								</svg>
								<img class="hidden rounded-lg" data-dz-thumbnail="" />
							</span>
							<div>
								<p class="text-sm font-medium text-gray-800 dark:text-white">
									<span
										class="inline-block max-w-75 truncate align-bottom"
										data-hs-file-upload-file-name=""></span>.<span
										data-hs-file-upload-file-ext=""></span>
								</p>
								<p
									class="dark:text-white-400 text-xs text-gray-500"
									data-hs-file-upload-file-size=""
								>
								</p>
							</div>
						</div>
						<div class="inline-flex items-center gap-x-2">
							<button
								type="button"
								class="cursor-pointer text-red-500 hover:text-red-600 focus:text-gray-800 focus:outline-hidden dark:focus:text-neutral-200"
								data-hs-file-upload-clear=""
							>
								<svg
									class="size-4 shrink-0"
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M3 6h18"></path>
									<path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
									<path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
									<line x1="10" x2="10" y1="11" y2="17"></line>
									<line x1="14" x2="14" y1="11" y2="17"></line>
								</svg>
							</button>
						</div>
					</div>

					<div class="flex w-11/12 items-center gap-x-3 whitespace-nowrap">
						<div
							class="flex h-2 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-neutral-700"
							role="progressbar"
							aria-valuenow="0"
							aria-valuemin="0"
							aria-valuemax="100"
							data-hs-file-upload-progress-bar=""
						>
							<div
								class="hs-file-upload-complete:bg-green-600 flex flex-col justify-center overflow-hidden rounded-full bg-blue-600 text-center text-xs whitespace-nowrap text-white transition-all duration-500 dark:bg-blue-500"
								style="width: 0"
								data-hs-file-upload-progress-bar-pane=""
							>
							</div>
						</div>
						<div class="w-10 text-end">
							<span class="text-sm text-gray-800 dark:text-white">
								<span data-hs-file-upload-progress-bar-value="">0</span>%
							</span>
						</div>
					</div>
				</div>
			</template>

			<div
				class="dark:bg-black-600 bg-white-100 border-black-600 flex min-h-96 cursor-pointer justify-center rounded-xl border border-dashed p-12 dark:border-neutral-600"
				data-hs-file-upload-trigger=""
			>
				<div
					class="pointer-events-none flex flex-col items-center justify-center text-center"
				>
					<svg
						class="mx-auto w-16 text-gray-400 dark:text-neutral-400"
						width="70"
						height="46"
						viewBox="0 0 70 46"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M6.05172 9.36853L17.2131 7.5083V41.3608L12.3018 42.3947C9.01306 43.0871 5.79705 40.9434 5.17081 37.6414L1.14319 16.4049C0.515988 13.0978 2.73148 9.92191 6.05172 9.36853Z"
							fill="currentColor"
							stroke="currentColor"
							stroke-width="2"
							class="dark:fill-black-500 dark:stroke-black-400 fill-white stroke-gray-400"
						></path>
						<path
							d="M63.9483 9.36853L52.7869 7.5083V41.3608L57.6982 42.3947C60.9869 43.0871 64.203 40.9434 64.8292 37.6414L68.8568 16.4049C69.484 13.0978 67.2685 9.92191 63.9483 9.36853Z"
							fill="currentColor"
							stroke="currentColor"
							stroke-width="2"
							class="dark:fill-black-500 fill-white-50 dark:stroke-black-400 stroke-gray-400"
						></path>
						<rect
							x="17.0656"
							y="1.62305"
							width="35.8689"
							height="42.7541"
							rx="5"
							fill="currentColor"
							stroke="currentColor"
							stroke-width="2"
							class="dark:fill-black-500 fill-white-50 dark:stroke-black-400 stroke-gray-400"
						></rect>
						<path
							d="M47.9344 44.3772H22.0655C19.3041 44.3772 17.0656 42.1386 17.0656 39.3772L17.0656 35.9161L29.4724 22.7682L38.9825 33.7121C39.7832 34.6335 41.2154 34.629 42.0102 33.7025L47.2456 27.5996L52.9344 33.7209V39.3772C52.9344 42.1386 50.6958 44.3772 47.9344 44.3772Z"
							stroke="currentColor"
							stroke-width="2"
							class="dark:stroke-black-400 stroke-gray-400"></path>
						<circle
							cx="39.5902"
							cy="14.9672"
							r="4.16393"
							stroke="currentColor"
							stroke-width="2"
							class="dark:stroke-black-400 stroke-gray-400"></circle>
					</svg>

					<div
						class="mt-4 flex flex-wrap justify-center text-sm/6 text-gray-600"
					>
						<span class="text-black-900 pe-1 font-medium dark:text-white">
							{mensaje}
						</span>
					</div>

					<p class="mt-1 text-xs text-gray-700 dark:text-neutral-400">
						Tamaño máximo del archivo {maxFilesize}MB.
					</p>
				</div>
			</div>

			<div class="mt-4 space-y-3 empty:mt-0" data-hs-file-upload-previews="">
			</div>

			<div
				class="mt-4 flex hidden w-full justify-center"
				data-hs-file-upload-actions=""
			>
				<button
					type="button"
					class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-transparent bg-blue-600 px-4 py-3 text-sm font-semibold text-white hover:bg-blue-700 focus:bg-blue-700 focus:outline-none disabled:pointer-events-none disabled:opacity-50 dark:bg-blue-500 dark:hover:bg-blue-600 dark:focus:bg-blue-600"
					data-hs-file-upload-confirm=""
				>
					<svg
						class="size-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
						></path>
					</svg>
					Subir documento
				</button>
			</div>
		</div>

		<script src="@lib/dropzone/dropzone.min.js"></script>
		<script
			is:inline
			src="https://cdn.jsdelivr.net/npm/lodash@4.17.23/lodash.min.js"></script>

		<script is:inline>
			document.addEventListener('DOMContentLoaded', function () {
				if (typeof Dropzone === 'undefined') {
					console.error('Dropzone no está definido.');
					return;
				}

				Dropzone.autoDiscover = false;

				const containers = document.querySelectorAll('[data-endpoint]');
				if (containers.length === 0) {
					console.error('Contenedor de upload no encontrado');
					return;
				}

				containers.forEach((container) => {
					const endpoint = container.dataset.endpoint;
					const maxFilesize = parseFloat(container.dataset.maxfilesize) || 2;
					const acceptedFiles =
						container.dataset.acceptedfiles ||
						'.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp';

					const trigger = container.querySelector(
						'[data-hs-file-upload-trigger]',
					);
					const previewsContainer = container.querySelector(
						'[data-hs-file-upload-previews]',
					);
					const template = container.querySelector(
						'[data-hs-file-upload-preview]',
					).innerHTML;
					const actionsContainer = container.querySelector(
						'[data-hs-file-upload-actions]',
					);

					const dz = new Dropzone(trigger, {
						url: endpoint,
						method: 'post',
						paramName: 'file',
						autoProcessQueue: false,
						maxFiles: 1,
						uploadMultiple: false,
						acceptedFiles: acceptedFiles,
						maxFilesize: maxFilesize,
						clickable: trigger,
						previewsContainer: previewsContainer,
						previewTemplate: template,
						addRemoveLinks: false,
					});

					let tempTimeoutId = null;

					dz.on('addedfile', function (file) {
						trigger.style.display = 'none';
						if (actionsContainer) {
							actionsContainer.classList.remove('hidden');
						}

						const nameEl = file.previewElement.querySelector(
							'[data-hs-file-upload-file-name]',
						);
						const extEl = file.previewElement.querySelector(
							'[data-hs-file-upload-file-ext]',
						);
						const sizeEl = file.previewElement.querySelector(
							'[data-hs-file-upload-file-size]',
						);
						const iconContainer = file.previewElement.querySelector(
							'[data-hs-file-upload-file-icon]',
						);
						const thumbnail = file.previewElement.querySelector(
							'[data-dz-thumbnail]',
						);

						if (nameEl) {
							const nameParts = file.name.split('.');
							nameParts.pop();
							nameEl.textContent = nameParts.join('.');
						}
						if (extEl) {
							const parts = file.name.split('.');
							extEl.textContent = parts.length > 1 ? parts.pop() : '';
						}
						if (sizeEl) {
							sizeEl.textContent = (file.size / 1024).toFixed(1) + ' KB';
						}

						const progressBar = file.previewElement.querySelector(
							'[data-hs-file-upload-progress-bar-pane]',
						);
						const progressValue = file.previewElement.querySelector(
							'[data-hs-file-upload-progress-bar-value]',
						);
						if (progressBar) {
							progressBar.style.width = '100%';
							progressBar.classList.add('hs-file-upload-complete:bg-green-600');
						}
						if (progressValue) {
							progressValue.textContent = '100';
						}

						if (file.type.startsWith('image/')) {
							if (thumbnail) {
								thumbnail.classList.remove('hidden');
							}
							if (iconContainer) {
								const svg = iconContainer.querySelector('svg');
								if (svg) svg.classList.add('hidden');
							}
						} else {
							if (thumbnail) {
								thumbnail.classList.add('hidden');
							}
							if (iconContainer) {
								const svg = iconContainer.querySelector('svg');
								if (svg) svg.classList.remove('hidden');
							}
						}

						if (tempTimeoutId) clearTimeout(tempTimeoutId);
						tempTimeoutId = setTimeout(
							function () {
								dz.removeAllFiles(true);
								trigger.style.display = '';
								if (actionsContainer) {
									actionsContainer.classList.add('hidden');
								}
								alert(
									'El archivo temporal ha expirado. Vuelve a subir el archivo.',
								);
							},
							2 * 60 * 1000,
						);
					});

					dz.on('removedfile', function () {
						trigger.style.display = '';
						if (actionsContainer) {
							actionsContainer.classList.add('hidden');
						}
						if (tempTimeoutId) clearTimeout(tempTimeoutId);
					});

					container.addEventListener('click', function (e) {
						const clearBtn = e.target.closest('[data-hs-file-upload-clear]');
						if (clearBtn) {
							e.preventDefault();
							dz.removeAllFiles(true);
						}

						const confirmBtnEl = e.target.closest(
							'[data-hs-file-upload-confirm]',
						);
						if (confirmBtnEl) {
							e.preventDefault();
							dz.processQueue();
						}
					});

					dz.on('uploadprogress', function (file, percent) {
						if (file.previewElement) {
							const progressBar = file.previewElement.querySelector(
								'[data-hs-file-upload-progress-bar-pane]',
							);
							const progressValue = file.previewElement.querySelector(
								'[data-hs-file-upload-progress-bar-value]',
							);
							if (progressBar) {
								progressBar.style.width = percent + '%';
							}
							if (progressValue) {
								progressValue.textContent = Math.round(percent);
							}
						}
					});

					dz.on('success', function (file) {
						if (tempTimeoutId) clearTimeout(tempTimeoutId);

						if (file.previewElement) {
							const progressBar = file.previewElement.querySelector(
								'[data-hs-file-upload-progress-bar-pane]',
							);
							if (progressBar) {
								progressBar.classList.add(
									'hs-file-upload-complete:bg-green-600',
								);
							}
						}
						if (actionsContainer) {
							actionsContainer.classList.add('hidden');
						}

						const xhr = file.xhr;
						if (xhr && xhr.responseURL) {
							window.location.href = xhr.responseURL;
						}
					});

					dz.on('error', function (file, errorMessage) {
						console.error('Upload error:', errorMessage);
						if (tempTimeoutId) clearTimeout(tempTimeoutId);
						alert('Hubo un error al subir el archivo. Intenta de nuevo.');
					});
				});
			});
		</script>
	</div>
</div>
