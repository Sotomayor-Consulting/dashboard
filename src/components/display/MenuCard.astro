---
interface Props {
	href: string;
	label: string;
	tooltipId: string;
	tooltipText: string;
	badge?: number | null;
}

const { href, label, tooltipId, tooltipText, badge } = Astro.props;
---

<div class="menu-card-wrap group flex flex-col items-center gap-3">
	<a
		href={href}
		data-tooltip-target={tooltipId}
		data-tooltip-placement="top"
		class:list={[
			'menu-card relative flex items-center justify-center',
			'h-18 w-18 rounded-2xl',
			'bg-white-50 border border-gray-200/80',
			'shadow-[0_1px_3px_rgba(0,0,0,0.04)]',
			'transition-all duration-300 ease-out',
			'hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(1,33,66,1.15)]',
			'hover:border-black-600/40',
			'text-black-600',
			'dark:bg-black-800 dark:border-white/6',
			'dark:shadow-[0_1px_3px_rgba(0,0,0,0.2)]',
			'dark:hover:shadow-[0_8px_24px_rgba(19,74,237,0.2)]',
			'dark:hover:border-[#134aed]/40',
			'dark:text-black-400',
		]}
	>
		<div class="text-[2.25rem] leading-none [&>svg]:h-9 [&>svg]:w-9">
			<slot />
		</div>
		{
			badge && (
				<span class="dark:ring-black-800 absolute -top-1.5 -right-1.5 flex h-5 w-5 animate-pulse items-center justify-center rounded-full bg-red-500 text-[0.65rem] font-bold text-white ring-2 ring-white">
					{badge > 99 ? '99+' : badge}
				</span>
			)
		}
	</a>

	<span
		class="group-hover:text-black-600 max-w-22 text-center text-[0.8rem] leading-tight font-medium text-gray-600 transition-colors duration-300 dark:text-gray-400 dark:group-hover:text-blue-300"
	>
		{label}
	</span>

	<div
		id={tooltipId}
		role="tooltip"
		class="tooltip invisible absolute z-10 inline-block rounded-lg bg-gray-900 px-3 py-2 text-xs font-medium text-white opacity-0 shadow-lg transition-all duration-200 dark:bg-gray-700"
	>
		{tooltipText}
		<div class="tooltip-arrow" data-popper-arrow></div>
	</div>
</div>
