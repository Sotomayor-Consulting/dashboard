---
interface Props {
	href: string;
	label: string;
	tooltipId: string;
	tooltipText: string;
	badge?: number | null;
}

const { href, label, tooltipId, tooltipText, badge } = Astro.props;
---

<div class="flex flex-col items-center justify-center">
	<a
		href={href}
		data-tooltip-target={tooltipId}
		data-tooltip-placement="top"
		class="dark:bg-black-800 dark:border-black-700 border-white-200 dark:hover:border-black-600 hover:border-white-300 text-white-800 bg-white-50 flex w-fit justify-center rounded-md border-2 p-5 backdrop-blur-[20px] backdrop-saturate-100 transition-all duration-200 ease-in-out hover:-translate-y-0.5 dark:text-slate-200"
	>
		<slot />
		{
			badge && (
				<span class="absolute -top-2 -right-2 flex h-6 w-6 animate-pulse items-center justify-center rounded-full bg-red-500 text-xs font-bold text-white">
					{badge > 99 ? '99+' : badge}
				</span>
			)
		}
	</a>

	<span class="max-w-30 pt-3 text-center dark:text-slate-300">{label}</span>

	<div
		id={tooltipId}
		role="tooltip"
		class="tooltip dark:bg-black-800 invisible absolute z-10 inline-block rounded-lg bg-neutral-50 px-3 py-2 text-sm font-medium text-black opacity-0 shadow-xs transition-all duration-300 dark:text-white"
	>
		{tooltipText}
		<div class="tooltip-arrow" data-popper-arrow></div>
	</div>
</div>
