---
interface Props {
	href: string;
	label: string;
	tooltipId: string;
	tooltipText: string;
	badge?: number | null;
}

const { href, label, tooltipId, tooltipText, badge } = Astro.props;
---

<div class="flex justify-center items-center flex-col">
	<a
		href={href}
		data-tooltip-target={tooltipId}
		data-tooltip-placement="top"
		class="backdrop-blur-[20px] backdrop-saturate-100 dark:bg-black-800 bg-slate-300 border-2 dark:border-black-700 border-white-300 rounded-md p-5 flex justify-center w-fit hover:-translate-y-0.5 transition-all duration-200 ease-in-out dark:hover:border-black-600 hover:border-white-400 text-[#967432] dark:text-slate-200"
	>
		<slot />
		{
			badge && (
				<span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full h-6 w-6 flex items-center justify-center font-bold animate-pulse">
					{badge > 99 ? '99+' : badge}
				</span>
			)
		}
	</a>

	<span class="pt-3 text-center max-w-30 dark:text-slate-300">{label}</span>

	<div
		id={tooltipId}
		role="tooltip"
		class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-black dark:text-white bg-neutral-300 rounded-lg shadow-xs opacity-0 tooltip dark:bg-black-800 transition-all duration-300"
	>
		{tooltipText}
		<div class="tooltip-arrow" data-popper-arrow></div>
	</div>
</div>
