<button
	id="theme-toggle"
	data-tooltip-target="tooltip-toggle"
	type="button"
	class="relative h-9 w-9 overflow-hidden rounded-lg p-2.5 text-sm text-gray-500 hover:bg-gray-100 focus:outline-none dark:text-gray-400 dark:hover:bg-[#101522]"
>
	<svg
		id="theme-toggle-dark-icon"
		class="absolute inset-0 m-auto h-5 w-5 scale-0 rotate-90 opacity-0 transition-all duration-300 ease-in-out"
		fill="currentColor"
		viewBox="0 0 20 20"
		xmlns="http://www.w3.org/2000/svg"
		><path
			d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
		></path></svg
	>
	<svg
		id="theme-toggle-light-icon"
		class="absolute inset-0 m-auto h-5 w-5 scale-0 rotate-90 opacity-0 transition-all duration-300 ease-in-out"
		fill="currentColor"
		viewBox="0 0 20 20"
		xmlns="http://www.w3.org/2000/svg"
		><path
			d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
			fill-rule="evenodd"
			clip-rule="evenodd"></path></svg
	>
</button>
<div
	id="tooltip-toggle"
	role="tooltip"
	class="tooltip invisible absolute z-10 inline-block rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-sm transition-opacity duration-300"
>
	Toggle dark mode
	<div class="tooltip-arrow" data-popper-arrow></div>
</div>

<script>
	const ACTIVE = ['scale-100', 'rotate-0', 'opacity-100'];
	const INACTIVE = ['scale-0', 'rotate-90', 'opacity-0'];

	function showIcon(el: HTMLElement) {
		el.classList.remove(...INACTIVE);
		el.classList.add(...ACTIVE);
	}

	function hideIcon(el: HTMLElement) {
		el.classList.remove(...ACTIVE);
		el.classList.add(...INACTIVE);
	}

	function isDark(): boolean {
		return (
			localStorage.getItem('color-theme') === 'dark' ||
			(!('color-theme' in localStorage) &&
				window.matchMedia('(prefers-color-scheme: dark)').matches)
		);
	}

	function initThemeToggle() {
		const darkIcon = document.getElementById('theme-toggle-dark-icon');
		const lightIcon = document.getElementById('theme-toggle-light-icon');
		const toggleBtn = document.getElementById(
			'theme-toggle',
		) as HTMLElement | null;
		if (!darkIcon || !lightIcon || !toggleBtn) return;

		// Sincronizar iconos con el estado actual del tema
		if (isDark()) {
			hideIcon(darkIcon);
			showIcon(lightIcon);
		} else {
			hideIcon(lightIcon);
			showIcon(darkIcon);
		}

		// Evitar registrar múltiples listeners cuando el navbar persiste entre navegaciones (transition:persist)
		if (toggleBtn.dataset.themeInit) return;
		toggleBtn.dataset.themeInit = 'true';

		toggleBtn.addEventListener('click', () => {
			const goingDark =
				!document.documentElement.classList.contains('dark');

			if (goingDark) {
				document.documentElement.classList.add('dark');
				localStorage.setItem('color-theme', 'dark');
				hideIcon(darkIcon!);
				showIcon(lightIcon!);
			} else {
				document.documentElement.classList.remove('dark');
				localStorage.setItem('color-theme', 'light');
				hideIcon(lightIcon!);
				showIcon(darkIcon!);
			}

			document.dispatchEvent(new Event('dark-mode'));
		});
	}

	// astro:page-load se dispara tanto en la carga inicial como en cada navegación con View Transitions
	document.addEventListener('astro:page-load', initThemeToggle);
</script>
