---
import { Icon } from 'astro-icon/components';
---

<a
	href="/"
	target="_blank"
	rel="noreferrer noopener"
	class="wa-btn fixed right-4 bottom-4 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366]"
	aria-label="WhatsApp"
>
	<span class="wa-pulse" aria-hidden="true"></span>
	<span class="relative z-20">
		<Icon
			name="ri:whatsapp-line"
			class="text-3xl text-white"
			title="whatsapp"
		/>
	</span>
</a>

<style>
	.wa-pulse {
		position: absolute;
		inset: 0;
		z-index: 10;
		border-radius: 9999px;
		background: #25d366;
		opacity: 0;
		animation: wa-pulse 2.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
	}

	@keyframes wa-pulse {
		0% {
			transform: scale(1);
			opacity: 0.35;
		}
		70% {
			opacity: 0;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.wa-pulse {
			animation: none;
		}
	}
</style>
