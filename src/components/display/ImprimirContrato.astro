---
import { Icon } from 'astro-icon/components';
import { createSupabaseServerClient } from '@lib/supabase';
import { getMissingPartnerFields } from '@lib/tablas/usuarios';

interface Props {
	data: object | null | undefined;
	templateName?: string;
	reportName?: string;
}

const supabase = createSupabaseServerClient(Astro);

const { data, templateName, reportName } = Astro.props;
const btnId = `btn-imprimir-${Math.random().toString(36).slice(2, 9)}`;

const user = Astro.locals.user;
const userRoles = Astro.locals.userRoles || [];

let perfilCompleto = false;

const isPartner = userRoles.includes('partner');

if (isPartner && user) {
	const camposFaltantes = await getMissingPartnerFields(supabase, user.id);
	perfilCompleto = camposFaltantes.length === 0;
}
---

{
	perfilCompleto ? (
		<button
			id={btnId}
			class="text-white bg-[#967432] hover:bg-[#967432] focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center me-2 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
		>
			<Icon name="ri:download-2-fill" class="me-2" />
			Descargar contrato
		</button>
	) : (
		<button
			id="boton-disabled"
			class="text-white bg-[#967432] hover:bg-[#967432] focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center me-2 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67] cursor-not-allowed"
		>
			<Icon name="ri:spam-2-fill" class="me-2" />
			Completa los datos para descargar el contrato
		</button>
	)
}

<script define:vars={{ btnId, data, templateName, reportName }} is:inline>
	const btn = document.getElementById(btnId);
	btn.addEventListener('click', async () => {
		const originalText = btn.innerText;
		btn.innerText = 'Generando contrato...';
		btn.disabled = true;
		try {
			const response = await fetch('../../api/pdf/generar-pdf', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					data,
					templateName,
					reportName,
				}),
			});

			if (!response.ok) {
				const errorText = await response.text();
				throw new Error(errorText || 'Error en la generación');
			}

			// 4. Convertir respuesta a Blob
			const blob = await response.blob();

			// 5. Forzar descarga
			const url = window.URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = `${reportName}.pdf`;
			document.body.appendChild(a);
			a.click();

			// Limpieza del DOM
			window.URL.revokeObjectURL(url);
			a.remove();
		} catch (error) {
			console.error('Error en el frontend:', error);
			alert('Hubo un error al generar el PDF. Revisa la consola.');
		} finally {
			btn.disabled = false;
			btn.innerText = originalText;
		}
	});
</script>
