---
import PictureUploader from '@components/PictureUploader.astro';
import { PaisesGeneral } from '@lib/tablas/paises';
import { FacturacionbyId } from '@lib/tablas/facturacion';
import { getUsuarioById } from '@lib/tablas/usuarios';

const paises = await PaisesGeneral();
const email = Astro.locals.user?.email;
const user = Astro.locals.user;
const userId = user?.id;
const usuario = userId ? await getUsuarioById(userId) : null;
const facturacion = userId ? await FacturacionbyId(userId) : null;

type Opcion = {
	value: string;
	label: string;
};

const opcionesPerfil: Opcion[] = [
	{ value: 'Cédula', label: 'Cédula' },
	{ value: 'RUC', label: 'RUC' },
	{ value: 'ID', label: 'ID' },
	{ value: 'Pasaporte', label: 'Pasaporte' },
	{ value: 'EIN', label: 'EIN' },
];

const TipoPersonaOptions: Opcion[] = [
	{ value: 'Natural', label: 'Natural' },
	{ value: 'Jurídica', label: 'Jurídica' },
];

const TipoIdentificacionOptions: Opcion[] = [
	{ value: 'Cédula', label: 'Cédula' },
	{ value: 'RUC', label: 'RUC' },
	{ value: 'ID', label: 'ID' },
	{ value: 'Pasaporte', label: 'Pasaporte' },
	{ value: 'EIN', label: 'EIN' },
];
---

<div class="grid grid-cols-1 px-4 pt-6 xl:grid-cols-3 xl:gap-4">
	<div class="mb-4 col-span-full xl:mb-2">
		<nav class="flex mb-5" aria-label="Breadcrumb">
			<ol
				class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
			>
				<li class="inline-flex items-center">
					<a
						href="/"
						class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
					>
						<svg
							class="w-5 h-5 mr-2.5"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
							></path></svg
						>
						Inicio
					</a>
				</li>

				<li>
					<div class="flex items-center">
						<svg
							class="w-6 h-6 text-gray-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						<span
							class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500"
							aria-current="page">Configuración</span
						>
					</div>
				</li>
			</ol>
		</nav>
		<h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
			Configuraciones de usuario
		</h1>
	</div>
	<!-- Right Content -->
	<div class="col-span-full xl:col-auto">
		<div
			class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-[#192033]"
		>
			<div
				class="items-center sm:flex xl:block 2xl:flex sm:space-x-4 xl:space-x-0 2xl:space-x-4"
			>
				<PictureUploader title="Foto de perfil" />
			</div>
		</div>
		<div
			class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-[#192033]"
		>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">Rol de cuenta</h3>
			<div class="mb-4">
				<label
					for=""
					class="cursor-not-allowed shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
					>{email}</label
				>
			</div>

			<div>
				<a
					href="/"
					class="text-white bg-[#8c681d] hover:bg-[#8c681d] focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
					>Promover a cuenta de asociado</a
				>
			</div>
		</div>
		<div
			class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-[#192033]"
		>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">
				Canjear código de Referido
			</h3>
			<form action="/api/partners_code/code_canje" method="POST">
				<div class="mb-4">
					<input
						type="text"
						name="code"
						class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
						placeholder="Ejemplo: 9F2A7C4B"
					/>
				</div>

				<div>
					<button
						type="submit"
						class="text-white bg-[#8c681d] hover:bg-[#8c681d] focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
						>Canjear</button
					>
				</div>
			</form>
		</div>
	</div>
	<div class="col-span-2">
		<div
			class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-[#192033]"
		>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">
				Información General
			</h3>
			<form method="post" action="/api/update/update-profile">
				<div class="grid grid-cols-6 gap-6">
					<div class="col-span-6 sm:col-span-3">
						<label
							for="first-name"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Nombre</label
						>
						<input
							type="text"
							name="nombre"
							value={usuario?.nombre ?? ''}
							id="first-name"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="Juan"
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="last-name"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Apellido</label
						>
						<input
							type="text"
							name="apellido"
							id="last-name"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="Green"
							value={usuario.apellido ?? ''}
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="country"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Pais</label
						>
						<select
							name="pais"
							class="bg-neutral-200 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
						>
							<option value="" selected={!usuario?.pais_id}
								>Seleccione un país</option
							>
							{
								paises?.map((p) => (
									<option value={p.id} selected={usuario?.pais_id === p.id}>
										{p.nombre_paises}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="city"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Ciudad</label
						>
						<input
							type="text"
							name="ciudad"
							value={usuario?.ciudad ?? ''}
							id="city"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="ejem. San Francisco"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="direccion"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Dirección linea 1</label
						>
						<input
							type="text"
							name="direccion"
							value={usuario?.direccion_linea1 ?? ''}
							id="address"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="ejem. Av. Juan Molineros"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="direccion2"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Dirección linea 2</label
						>
						<input
							type="text"
							name="direccion2"
							value={usuario?.direccion_linea2 ?? ''}
							id="address"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="ejem. y De los Guayacanes"
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="tipo_de_documento"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Tipo de documento</label
						>
						<select
							name="tipo_de_documento"
							class="bg-neutral-200 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
						>
							<option
								value=""
								selected={!usuario?.tipo_identificacion}
								disabled
								hidden>Seleccione un tipo de documento</option
							>
							{
								opcionesPerfil?.map((p) => (
									<option
										value={p.value}
										selected={usuario?.tipo_identificacion === p.value}
									>
										{p.label}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="Numero_de_identificacion"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Numero de identificacion</label
						>
						<input
							type="text"
							name="Numero_de_identificacion"
							value={usuario?.numero_de_identificacion ?? ''}
							id="address"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="1777745898"
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="tipo_de_persona"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Tipo de persona</label
						>
						<select
							name="tipo_de_persona"
							class="bg-neutral-200 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
						>
							<option value="" selected={!usuario?.tipo_persona} disabled hidden
								>Seleccione el tipo de persona</option
							>
							{
								TipoPersonaOptions?.map((p) => (
									<option
										value={p.value}
										selected={usuario?.tipo_persona === p.value}
									>
										{p.label}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="email"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Email</label
						>
						<label
							for=""
							class="cursor-not-allowed shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							>{email}</label
						>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="phone-number"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Numero de telefono</label
						>
						<input
							type="number"
							name="telefono"
							id="phone-number"
							value={usuario?.telf ?? ''}
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="ejem. +(12)3456 789"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="birthday"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Fecha de nacimiento</label
						>
						<input
							type="date"
							name="fecha_nacimiento"
							value={usuario?.fecha_nacimiento ?? ''}
							id="birthday"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="15/08/1990"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="organization"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Organizacion a la que pertenece</label
						>
						<input
							type="text"
							name="organizacion"
							value={usuario?.organizacion ?? ''}
							id="organizacion"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="Ejem. Sotomayor Consulting Ecuador"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="role"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Cargo</label
						>
						<input
							type="text"
							name="cargo"
							value={usuario?.cargo ?? ''}
							id="role"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="Ejem. Gerente General"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="department"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Departamento</label
						>
						<input
							type="text"
							name="departamento"
							value={usuario?.departamento ?? ''}
							id="department"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="Development"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="zip-code"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Codigo Postal</label
						>
						<input
							type="number"
							name="codigo_postal"
							value={usuario?.codigo_postal ?? ''}
							id="zip-code"
							class="shadow-sm bg-neutral-200 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="123456"
							-
						/>
					</div>

					<div class="col-span-6 sm:col-full">
						<button
							class="text-white bg-[#8c681d] hover:bg-[#8c681d] focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
							type="submit">Guardar</button
						>
					</div>
				</div>
			</form>
		</div>
		<div
			id="datos-facturacion"
			class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-[#192033]"
		>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">
				Datos de facturación
			</h3>
			<form method="post" action="/api/update/update-factura">
				<input hidden value={user?.id} name="user_id_factura" />
				<div class="grid grid-cols-6 gap-6">
					<div class="col-span-6 sm:col-span-3">
						<label
							for="tipo_de_persona"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Personería</label
						>
						<select
							name="tipo_de_persona"
							id="tipo_de_persona"
							class="bg-neutral-200 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							required
						>
							<option
								value=""
								selected={!facturacion?.personería}
								disabled
								hidden>Seleccione el tipo de persona</option
							>
							{
								TipoPersonaOptions?.map((p) => (
									<option
										value={p.value}
										selected={facturacion?.personería === p.value}
									>
										{p.label}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="razon_social"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Nombre o Razón Social</label
						>
						<input
							name="razon_social"
							value={facturacion?.nombre_o_razon_social ?? ''}
							type="text"
							id="razon_social"
							class="bg-neutral-200 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-[#8c681d] focus:border-[#8c681d] block w-full p-2.5 dark:bg-[#101521] dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-[#323f67] dark:focus:border-[#8c681d]"
							placeholder="Ejem. Juan Perez o Comercial Perez S.A."
							required
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="correo_electronico_factura"
							class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
							>Correo electrónico para facturacion</label
						>
						<input
							type="email"
							name="correo_electronico_factura"
							value={facturacion?.correo ?? ''}
