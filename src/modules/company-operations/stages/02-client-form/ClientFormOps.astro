---
import { Icon } from 'astro-icon/components';
import type { OpsStageProps } from '../types';
import {
	priorityClass,
	priorityLabel,
	taskStatusBadge,
	taskStatusLabel,
} from '../../lib/style-helpers';
import { getIncorporationForm } from '@domains/workflow/incorporation-forms';

const { currentStage, empresaId } = Astro.props as OpsStageProps;
const supabase = Astro.locals.supabase;

const form = await getIncorporationForm(supabase, empresaId);
const formStatus = form?.status ?? null;

const clientSubmitted =
	formStatus === 'submitted' || formStatus === 'in_review';
const isValidated = formStatus === 'validated' || formStatus === 'promoted';
const isRejected = formStatus === 'rejected';
const canValidate = clientSubmitted && !isValidated;
---

<div class="space-y-4">
	{/* ─── Task list ─── */}
	{
		currentStage.tasks.length > 0 && (
			<ul class="divide-y divide-border">
				{currentStage.tasks.map((t) => (
					<li class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
						<input
							type="checkbox"
							checked={t.status === 'completed'}
							class="mt-1 h-4 w-4 shrink-0 rounded border-border"
							disabled
						/>
						<div class="min-w-0 flex-1">
							<div class="flex flex-wrap items-center gap-2">
								<p
									class={`text-sm font-medium ${
										t.status === 'completed'
											? 'text-muted-foreground line-through'
											: 'text-foreground'
									}`}
								>
									{t.title}
								</p>
								<span
									class={`text-2xs rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase ${priorityClass(t.priority)}`}
								>
									{priorityLabel(t.priority)}
								</span>
							</div>
							<p class="mt-0.5 text-xs text-muted-foreground">
								{t.description}
							</p>
						</div>
						<div class="flex shrink-0 items-center gap-3">
							{t.assignee ? (
								<span class="inline-flex items-center gap-2 text-xs text-muted-foreground">
									<span class="text-2xs inline-flex h-6 w-6 items-center justify-center rounded-full bg-muted font-semibold text-foreground">
										{t.assignee.initials}
									</span>
									{t.assignee.name}
								</span>
							) : (
								<button
									type="button"
									class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground hover:text-foreground"
								>
									<Icon name="ri:user-add-line" class="h-3.5 w-3.5" />
									Asignar
								</button>
							)}
							<span
								class={`rounded-full px-2 py-0.5 text-[11px] font-medium ${taskStatusBadge(t.status)}`}
							>
								{taskStatusLabel(t.status)}
							</span>
						</div>
					</li>
				))}
			</ul>
		)
	}

	{/* ─── Contextual stage UI ─── */}
	{
		(!formStatus || formStatus === 'draft') && (
			<div class="flex items-start gap-3 rounded-lg border border-dashed border-border p-3">
				<Icon
					name="ri:time-line"
					class="h-5 w-5 shrink-0 text-muted-foreground"
				/>
				<div>
					<p class="text-sm font-medium text-foreground">
						Esperando envío del cliente
					</p>
					<p class="mt-0.5 text-xs text-muted-foreground">
						El cliente aún no ha completado y enviado el formulario de
						incorporación.
					</p>
				</div>
			</div>
		)
	}

	{
		canValidate && (
			<div class="flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50/60 p-3 dark:border-amber-500/20 dark:bg-amber-500/5">
				<Icon
					name="ri:alert-line"
					class="h-5 w-5 shrink-0 text-amber-600 dark:text-amber-400"
				/>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-medium text-foreground">
						Formulario recibido — pendiente de validación
					</p>
					<p class="mt-0.5 text-xs text-muted-foreground">
						El cliente envió sus datos. Revisa la información y valida o
						solicita correcciones.
					</p>
					<a
						href={`/incorporations/${empresaId}/form-review`}
						class="mt-2 inline-flex items-center gap-1.5 rounded-md bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-amber-700"
					>
						<Icon name="ri:checkbox-circle-line" class="h-3.5 w-3.5" />
						Ver y validar datos
					</a>
				</div>
			</div>
		)
	}

	{
		isValidated && (
			<div class="flex items-start gap-3 rounded-lg border border-emerald-200 bg-emerald-50/50 p-3 dark:border-emerald-900/40 dark:bg-emerald-900/10">
				<Icon
					name="ri:checkbox-circle-line"
					class="h-5 w-5 shrink-0 text-emerald-600 dark:text-emerald-400"
				/>
				<div>
					<p class="text-sm font-medium text-foreground">
						Datos validados
					</p>
					<p class="mt-0.5 text-xs text-muted-foreground">
						Los datos del formulario fueron validados. La etapa se completó.
					</p>
				</div>
			</div>
		)
	}

	{
		isRejected && (
			<div class="flex items-start gap-3 rounded-lg border border-red-200 bg-red-50/50 p-3 dark:border-red-900/40 dark:bg-red-900/10">
				<Icon
					name="ri:close-circle-line"
					class="h-5 w-5 shrink-0 text-red-600 dark:text-red-400"
				/>
				<div>
					<p class="text-sm font-medium text-foreground">
						Formulario devuelto al cliente
					</p>
					<p class="mt-0.5 text-xs text-muted-foreground">
						Se solicitaron correcciones. Esperando que el cliente reenvíe el
						formulario.
					</p>
				</div>
			</div>
		)
	}
</div>
