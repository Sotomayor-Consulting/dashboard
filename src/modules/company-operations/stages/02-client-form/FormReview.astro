							</dl>
							<div class="mt-2 flex flex-wrap gap-3">
								{files.passport.url && (
									<a
										href={files.passport.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1 text-[11px] font-medium text-blue-600 hover:underline dark:text-blue-400"
									>
										<Icon name="ri:file-line" class="h-3 w-3" />
										Pasaporte
									</a>
								)}
								{files.utility.url && (
									<a
										href={files.utility.url}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-1 text-[11px] font-medium text-blue-600 hover:underline dark:text-blue-400"
									>
										<Icon name="ri:file-line" class="h-3 w-3" />
										Planilla de servicio
									</a>
								)}
							</div>
						</div>
					);
				})}
			</section>
		)
	}

	<!-- Configuración -->
	<section
		class="mb-6 rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-transparent"
	>
		<h2
			class="mb-4 flex items-center gap-2 text-base font-semibold text-gray-950 dark:text-white"
		>
			<Icon name="ri:settings-3-line" class="h-4.5 w-4.5 text-gray-400" />
			Configuración
		</h2>
		<dl class="grid gap-3 sm:grid-cols-2">
			<div>
				<dt class="text-xs font-medium text-gray-500 dark:text-gray-400">
					SCI asigna manager
				</dt>
				<dd class="text-sm text-gray-900 dark:text-white">
					{
						payload.managers?.sciAssigns === true
							? 'Sí'
							: payload.managers?.sciAssigns === false
								? 'No'
								: '—'
					}
				</dd>
			</div>
			<div>
				<dt class="text-xs font-medium text-gray-500 dark:text-gray-400">
					Manager es miembro
				</dt>
				<dd class="text-sm text-gray-900 dark:text-white">
					{
						payload.managers?.isMember === true
							? 'Sí'
							: payload.managers?.isMember === false
								? 'No'
								: '—'
					}
				</dd>
			</div>
			<div>
				<dt class="text-xs font-medium text-gray-500 dark:text-gray-400">
					Responsable IRS
				</dt>
				<dd class="text-sm text-gray-900 dark:text-white">
					{
						irsMember
							? irsMember.type === 'company'
								? (irsMember as any).legalName
								: (irsMember as any).fullName
							: '—'
					}
				</dd>
			</div>
		</dl>
	</section>

	<!-- Firma y consentimiento -->
	<section
		class="mb-6 rounded-lg border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-transparent"
	>
		<h2
			class="mb-4 flex items-center gap-2 text-base font-semibold text-gray-950 dark:text-white"
		>
			<Icon name="ri:quill-pen-line" class="h-4.5 w-4.5 text-gray-400" />
			Firma y consentimiento
		</h2>
		<p
			id="edit-signature-warning"
			class="hidden text-xs text-amber-600 italic dark:text-amber-400"
		>
			La firma y el consentimiento se limpiarán al guardar los cambios. El
			cliente deberá firmar y aceptar los términos nuevamente.
		</p>
		<div id="read-signature" class="flex items-center gap-4">
			{
				signatureUrl ? (
					<a
						href={signatureUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 text-xs font-medium text-blue-600 hover:underline dark:text-blue-400"
					>
						<Icon name="ri:image-line" class="h-3.5 w-3.5" />
						Ver firma
					</a>
				) : (
					<span class="text-xs text-gray-500 dark:text-gray-400">
						Sin firma guardada
					</span>
				)
			}
			<span class="text-xs text-gray-500 dark:text-gray-400">
				Términos aceptados: {payload.consent?.acceptedTerms ? '✓ Sí' : '✗ No'}
			</span>
		</div>
	</section>

	<!-- Acciones -->
	{
		canValidate && (
			<section
				class="sticky bottom-0 z-10 -mx-4 border-t border-gray-200 bg-white px-4 py-4 dark:border-gray-700 dark:bg-gray-950"
				id="review-actions"
			>
				{/* Read mode actions */}
				<div id="actions-read">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<p class="text-sm text-gray-500 dark:text-gray-400">
							¿Los datos del formulario son correctos?
						</p>
						<div class="flex gap-3">
							<button
								type="button"
								id="btn-edit"
								class="inline-flex items-center gap-1.5 rounded-lg border border-blue-300 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-50 dark:border-blue-700 dark:text-blue-400 dark:hover:bg-blue-900/20"
							>
								<Icon name="ri:edit-line" class="h-4 w-4" />
								Realizar modificaciones
							</button>
							<button
								type="button"
								id="btn-reject"
								class="inline-flex items-center gap-1.5 rounded-lg border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-50 dark:border-red-700 dark:text-red-400 dark:hover:bg-red-900/20"
							>
								<Icon name="ri:close-circle-line" class="h-4 w-4" />
								Solicitar correcciones
							</button>
							<button
								type="button"
								id="btn-validate"
								class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"
							>
								<Icon name="ri:checkbox-circle-line" class="h-4 w-4" />
								Validar datos
							</button>
						</div>
					</div>
					<div id="reject-reason-box" class="mt-3 hidden">
						<label
							for="reject-reason"
							class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300"
						>
							Motivo del rechazo
						</label>
						<textarea
							id="reject-reason"
							rows="3"
							class="w-full rounded-lg border border-gray-300 p-2 text-sm dark:border-gray-600 dark:bg-gray-900 dark:text-white"
							placeholder="Describe qué debe corregir el cliente..."
						/>
						<div class="mt-2 flex justify-end gap-2">
							<button
								type="button"
								id="btn-cancel-reject"
								class="rounded-lg px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800"
							>
								Cancelar
							</button>
							<button
								type="button"
								id="btn-confirm-reject"
								class="rounded-lg bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700"
							>
								Confirmar rechazo
							</button>
						</div>
					</div>
				</div>

				{/* Edit mode actions */}
				<div id="actions-edit" class="hidden">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<p class="text-sm text-gray-500 dark:text-gray-400">
							Guarda los cambios para que el cliente revise, firme y acepte los
							términos.
						</p>
						<div class="flex gap-3">
							<button
								type="button"
								id="btn-cancel-edit"
								class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-50 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
							>
								Cancelar
							</button>
							<button
								type="button"
								id="btn-save-edit"
								class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-700 disabled:opacity-50"
							>
								<Icon name="ri:save-line" class="h-4 w-4" />
								Guardar cambios
							</button>
						</div>
					</div>
				</div>
			</section>
		)
	}
</div>

<script is:inline define:vars={{ incorporationId, payload }}>
	function init() {
		const root = document.getElementById('form-review-root');
		if (!root) return;

		const $ = (id) => document.getElementById(id);
		let currentPayload = JSON.parse(JSON.stringify(payload));

		// --- Toggle edit mode ---
		function setEditMode(on) {
			root.querySelectorAll('.js-read').forEach((el) => {
				el.classList.toggle('hidden', on);
			});
			root.querySelectorAll('.js-edit').forEach((el) => {
				el.classList.toggle('hidden', !on);
			});
			const banner = $('edit-banner');
			if (banner) {
				banner.classList.toggle('hidden', !on);
				banner.classList.toggle('flex', on);
			}
			const sigWarn = $('edit-signature-warning');
			const sigRead = $('read-signature');
			if (sigWarn) sigWarn.classList.toggle('hidden', !on);
			if (sigRead) sigRead.classList.toggle('hidden', on);

			const actRead = $('actions-read');
			const actEdit = $('actions-edit');
			if (actRead) actRead.classList.toggle('hidden', on);
			if (actEdit) actEdit.classList.toggle('hidden', !on);
		}

		// --- Collect edited values from inputs into payload ---
		function collectEdits() {
			const edited = JSON.parse(JSON.stringify(currentPayload));
			root.querySelectorAll('[data-field]').forEach((el) => {
				const path = el.dataset.field;
				const isCountry = el.dataset.country === 'true';
				const isNumber = el.dataset.type === 'number';
				const isBool = el.dataset.type === 'boolean';
				let val = el.value;

				if (isBool) val = val === 'true';
				else if (isNumber) val = Number(val);

				// Navigate to the nested property
				const parts = path.split('.');
				let obj = edited;
				for (let i = 0; i < parts.length - 1; i++) {
					const key = isNaN(parts[i]) ? parts[i] : Number(parts[i]);
					if (obj[key] == null) obj[key] = {};
					obj = obj[key];
				}
				const lastKey = parts[parts.length - 1];

				if (isCountry) {
					const current = obj[lastKey];
					if (typeof current === 'object' && current !== null) {
						obj[lastKey] = { ...current, name: val };
					} else {
						obj[lastKey] = val;
					}
				} else {
					obj[lastKey] = val;
				}
			});

			// Clear signature and consent
			edited.signature = { dataUrl: null, file: null };
			edited.consent = { acceptedTerms: false };

			return edited;
		}

		// --- API helpers ---
		let _reviewBusy = false;
		async function reviewAction(decision, reason) {
			if (_reviewBusy) return;
			_reviewBusy = true;
			const actionBtns = [btnValidate, btnConfirmReject].filter(Boolean);
			actionBtns.forEach((b) => {
				b.disabled = true;
			});
			try {
				const res = await fetch(
					`/api/incorporations/${incorporationId}/form/review`,
					{
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ decision, reason }),
					},
				);
				const data = await res.json().catch(() => null);
				if (res.ok && data?.ok) {
					window.location.href =
						`/admin/incorporations/${incorporationId}?status=success&msg=` +
						encodeURIComponent(
							decision === 'validate'
								? 'Formulario validado exitosamente.'
								: 'Formulario devuelto al cliente.',
						);
					return;
				}
				alert(data?.error || 'Error al procesar la acción');
			} catch {
				alert('Error de conexión. Intenta de nuevo.');
			} finally {
				_reviewBusy = false;
				actionBtns.forEach((b) => {
					b.disabled = false;
				});
			}
		}

		// --- Buttons ---
		const btnEdit = $('btn-edit');
		const btnCancelEdit = $('btn-cancel-edit');
		const btnSaveEdit = $('btn-save-edit');
		const btnValidate = $('btn-validate');
		const btnReject = $('btn-reject');
		const rejectBox = $('reject-reason-box');
		const btnCancelReject = $('btn-cancel-reject');
		const btnConfirmReject = $('btn-confirm-reject');
		const reasonInput = $('reject-reason');

		if (btnEdit) btnEdit.addEventListener('click', () => setEditMode(true));

		if (btnCancelEdit)
			btnCancelEdit.addEventListener('click', () => {
				// Reset input values to original payload
				root.querySelectorAll('[data-field]').forEach((el) => {
					const path = el.dataset.field;
					const parts = path.split('.');
					let val = currentPayload;
					for (const p of parts) {
						const key = isNaN(p) ? p : Number(p);
						val = val?.[key];
					}
					if (el.dataset.country === 'true') {
						el.value = typeof val === 'object' ? val?.name || '' : val || '';
					} else if (el.dataset.type === 'boolean') {
						el.value = String(!!val);
					} else {
						el.value = val ?? '';
					}
				});
				setEditMode(false);
			});

		if (btnSaveEdit)
			btnSaveEdit.addEventListener('click', async () => {
				if (
					!confirm(
						'Al guardar, la firma y consentimiento se limpiarán y el cliente deberá firmar nuevamente. ¿Continuar?',
					)
				)
					return;
				btnSaveEdit.disabled = true;
				btnSaveEdit.textContent = 'Guardando…';
				try {
					const edited = collectEdits();
					const res = await fetch(
						`/api/incorporations/${incorporationId}/form/ops-edit`,
						{
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ payload: edited }),
						},
					);
					const data = await res.json();
					if (data?.ok) {
						window.location.href =
							`/admin/incorporations/${incorporationId}?status=success&msg=` +
							encodeURIComponent(
								'Formulario modificado. El cliente debe firmar y aceptar los términos nuevamente.',
							);
					} else {
						alert(data?.error || 'Error al guardar los cambios');
					}
				} finally {
					btnSaveEdit.disabled = false;
					btnSaveEdit.textContent = 'Guardar cambios';
				}
			});

		if (btnValidate)
			btnValidate.addEventListener('click', () => {
				if (confirm('¿Confirmas que los datos del formulario son correctos?')) {
					reviewAction('validate');
				}
			});

		if (btnReject)
			btnReject.addEventListener('click', () => {
				rejectBox?.classList.remove('hidden');
			});

		if (btnCancelReject)
			btnCancelReject.addEventListener('click', () => {
				rejectBox?.classList.add('hidden');
			});

		if (btnConfirmReject)
			btnConfirmReject.addEventListener('click', () => {
				const reason = reasonInput?.value?.trim();
				if (!reason) {
					alert('Ingresa el motivo del rechazo');
					return;
				}
				reviewAction('reject', reason);
			});
	}
	document.addEventListener('DOMContentLoaded', init);
	document.addEventListener('astro:page-load', init);
</script>
