---
// ─── Operations Panel ───────────────────────────────────
// Vista de operaciones del workflow por empresa. Pensado para el
// rol `operaciones` (y `admin`): muestra etapa actual, tareas,
// cola del equipo, progreso de etapas y alertas de SLA.
//
// Crítico: aquí operaciones ejecuta y avanza las stages; en stages
// con requires_approval=client se solicita aprobación al cliente.
import { Icon } from 'astro-icon/components';
import { getOperationsPanelData } from './services/get-operations-panel-data';
import OperationsHeader from './components/OperationsHeader.astro';
// import OperationsStats from './components/OperationsStats.astro';
import CurrentStageTasks from './components/CurrentStageTasks.astro';
import TeamQueue from './components/TeamQueue.astro';
import QuickActions from './components/QuickActions.astro';
import StagesOverview from './components/StagesOverview.astro';
import SlaAlerts from './components/SlaAlerts.astro';

interface Props {
	empresaId: string;
	empresaNombre?: string | null;
}

const { empresaId, empresaNombre } = Astro.props;
const supabase = Astro.locals.supabase;
const data = await getOperationsPanelData(supabase, empresaId, empresaNombre);
---

<div class="space-y-4">
	{
		!data.hasWorkflow ? (
			<article class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center dark:border-gray-700 dark:bg-neutral-950">
				<Icon
					name="ri:flow-chart"
					class="mx-auto h-10 w-10 text-gray-400 dark:text-gray-500"
				/>
				<h3 class="mt-3 text-base font-semibold text-gray-950 dark:text-white">
					Esta empresa aún no tiene un workflow activo
				</h3>
				<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
					{data.empresaNombre} todavía no ha iniciado el proceso de
					incorporación gestionado por operaciones.
				</p>
				<p class="mt-3 text-xs text-gray-400 dark:text-gray-500">
					El workflow se crea automáticamente al completar el pago del plan
					contratado.
				</p>
			</article>
		) : (
			<>
				<OperationsHeader workflow={data.workflow} />

				{/* <OperationsStats stats={data.stats} /> */}

				<div class="grid gap-4 lg:grid-cols-[minmax(0,1.6fr)_minmax(280px,1fr)]">
					{data.currentStage ? (
						<CurrentStageTasks
							currentStage={data.currentStage}
							empresaId={empresaId}
						/>
					) : (
						<article class="rounded-xl border border-gray-200 bg-white p-5 text-sm text-gray-500 dark:border-gray-800 dark:bg-gray-900/60 dark:text-gray-400">
							No hay una etapa activa para este workflow.
						</article>
					)}
					<aside class="space-y-4">
						<TeamQueue teamQueue={data.teamQueue} />
						<QuickActions />
					</aside>
				</div>

				<div class="grid gap-4 lg:grid-cols-[minmax(0,1.6fr)_minmax(280px,1fr)]">
					<StagesOverview stages={data.stages} />
					<SlaAlerts slaAlerts={data.slaAlerts} />
				</div>
			</>
		)
	}
</div>
