---
// ─── Operations Panel ───────────────────────────────────
// Vista de operaciones del workflow por empresa. Pensado para el
// rol `operaciones` (y `admin`): muestra etapa actual, tareas,
// cola del equipo, progreso de etapas y alertas de SLA.
//
// Crítico: aquí operaciones ejecuta y avanza las stages; en stages
// con requires_approval=client se solicita aprobación al cliente.
import { Icon } from 'astro-icon/components';
import { getOperationsPanelData } from './services/get-operations-panel-data';
import OperationsHeader from './components/OperationsHeader.astro';
import { resolveOpsStageComponent } from './stages/registry';
import TeamQueue from './components/TeamQueue.astro';
import QuickActions from './components/QuickActions.astro';
import StagesOverview from './components/StagesOverview.astro';
import SlaAlerts from './components/SlaAlerts.astro';

interface Props {
	empresaId: string;
	empresaNombre?: string | null;
}

const { empresaId, empresaNombre } = Astro.props;
const supabase = Astro.locals.supabase;
const data = await getOperationsPanelData(supabase, empresaId, empresaNombre);
---

<div>
	{
		!data.hasWorkflow ? (
			<div class="py-12 text-center">
				<Icon
					name="ri:flow-chart"
					class="mx-auto h-10 w-10 text-muted-foreground"
				/>
				<h3 class="mt-3 text-base font-semibold text-foreground">
					Esta empresa aún no tiene un workflow activo
				</h3>
				<p class="mt-1 text-sm text-muted-foreground">
					{data.empresaNombre} todavía no ha iniciado el proceso de
					incorporación gestionado por operaciones.
				</p>
				<p class="mt-3 text-xs text-muted-foreground">
					El workflow se crea automáticamente al completar el pago del plan
					contratado.
				</p>
			</div>
		) : (
			<div class="divide-y divide-border">
				<div class="pb-6">
					<OperationsHeader workflow={data.workflow} />
				</div>

				<div class="grid gap-x-8 gap-y-6 py-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(280px,1fr)]">
					<div class="space-y-8">
						<div id="ops-stage-canvas">
							{data.stages.length === 0 ? (
								<p class="text-sm text-muted-foreground">
									No hay etapas en este workflow.
								</p>
							) : (
								data.stages.map((s) => {
									const isCurrent = data.currentStage && s.id === data.currentStage.id;
									const StageComp = resolveOpsStageComponent(s.slug);
									const allDone = s.tasks.length > 0 && s.tasks.every((t) => t.status === 'completed');
									return (
										<div data-stage-panel={s.id} hidden={!isCurrent}>
											<header class="mb-4 flex items-start justify-between gap-3">
												<div>
													<p class="flex items-center gap-2 text-sm font-medium text-foreground">
														<Icon name="ri:time-line" class="h-4 w-4 text-accent-gold" />
														{s.name}
													</p>
													<p class="mt-0.5 text-xs text-muted-foreground">
														Etapa {s.order} · {s.tasks.filter((t) => t.status === 'completed').length}/{s.tasks.length} tareas completadas
													</p>
												</div>
												{isCurrent && allDone && (
													<button
														type="button"
														class="btn-primary"
														data-advance-stage
														data-incorporation-id={empresaId}
													>
														<Icon name="ri:arrow-right-line" class="h-3.5 w-3.5" />
														Avanzar etapa
													</button>
												)}
											</header>
											<StageComp currentStage={s} empresaId={empresaId} />
										</div>
									);
								})
							)}
						</div>
						<StagesOverview stages={data.stages} currentStageId={data.currentStage?.id} />
					</div>
					<aside class="space-y-6">
						<TeamQueue teamQueue={data.teamQueue} />
						<QuickActions />
						<SlaAlerts slaAlerts={data.slaAlerts} />
					</aside>
				</div>
			</div>
		)
	}
</div>

<script is:inline>
	document.addEventListener('click', async (e) => {
		const btn = e.target.closest('[data-advance-stage]');
		if (!btn) return;
		const id = btn.dataset.incorporationId;
		if (!id) return;
		btn.disabled = true;
		btn.textContent = 'Avanzando…';
		try {
			const res = await fetch('/api/workflow/stages/advance', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ incorporationId: id }),
			});
			const data = await res.json();
			if (data.ok) {
				window.location.reload();
			} else {
				alert('Error: ' + (data.error || 'No se pudo avanzar la etapa'));
				btn.disabled = false;
				btn.textContent = 'Avanzar etapa';
			}
		} catch {
			alert('Error de conexión');
			btn.disabled = false;
			btn.textContent = 'Avanzar etapa';
		}
	});
</script>
