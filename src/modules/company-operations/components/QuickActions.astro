---
import { Icon } from 'astro-icon/components';

const actions = [
	{ icon: 'ri:play-circle-line', label: 'Nueva tarea' },
	{ icon: 'ri:user-shared-line', label: 'Reasignar' },
	{ icon: 'ri:error-warning-line', label: 'Reportar' },
	{ icon: 'ri:calendar-event-line', label: 'Agendar' },
];
---

<section
	class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-transparent"
>
	<h4 class="mb-3 text-sm font-semibold text-gray-950 dark:text-white">
		Acciones Rápidas
	</h4>
	<div class="grid grid-cols-2 gap-2">
		{
			actions.map((a) => (
				<button
					type="button"
					class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-gray-200 px-3 py-2 text-xs font-medium text-gray-700 transition hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/5"
				>
					<Icon name={a.icon} class="h-3.5 w-3.5" />
					{a.label}
				</button>
			))
		}
	</div>
</section>
