---
import { Icon } from 'astro-icon/components';
import type { Task } from '../types';
import {
	priorityClass,
	priorityLabel,
	taskStatusBadge,
	taskStatusLabel,
} from '../lib/style-helpers';

interface Props {
	tasks: Task[];
	emptyMessage?: string;
}

const {
	tasks,
	emptyMessage = 'No hay tareas registradas en esta etapa todavía.',
} = Astro.props;
---

{
	tasks.length === 0 ? (
		<div class="border-border text-muted-foreground flex h-80 w-full items-center justify-center rounded-lg border border-dashed p-4 text-center text-xs">
			{emptyMessage}
		</div>
	) : (
		<div class="scrollbar scrollbar-w-2 relative flex h-80 w-full flex-col overflow-y-auto pr-1">
			<ul class="divide-border flex-1 space-y-0 divide-y">
				{tasks.map((t) => (
					<li class="flex w-full items-start gap-3 py-3 first:pt-0 last:pb-0">
						<input
							type="checkbox"
							checked={t.status === 'completed'}
							class="border-border mt-1 h-4 w-4 shrink-0 rounded"
							disabled
						/>
						<div class="min-w-0 flex-1">
							<div class="flex flex-wrap items-center gap-2">
								<p
									class={`text-sm font-medium ${
										t.status === 'completed'
											? 'text-muted-foreground line-through'
											: 'text-foreground'
									}`}
								>
									{t.title}
								</p>
								<span
									class={`text-2xs rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase ${priorityClass(t.priority)}`}
								>
									{priorityLabel(t.priority)}
								</span>
							</div>
							<p class="text-muted-foreground mt-0.5 text-xs">
								{t.description}
							</p>
						</div>

						<div class="flex shrink-0 items-center gap-3">
							{t.assignee ? (
								<span class="text-muted-foreground inline-flex items-center gap-2 text-xs">
									<span class="text-2xs bg-muted text-foreground inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full font-semibold">
										{t.assignee.initials}
									</span>
									{t.assignee.name}
								</span>
							) : (
								<button
									type="button"
									class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 text-xs font-medium"
								>
									<Icon name="ri:user-add-line" class="h-3.5 w-3.5" />
									Asignar
								</button>
							)}
							<span
								class={`rounded-full px-2 py-0.5 text-[11px] font-medium ${taskStatusBadge(t.status)}`}
							>
								{taskStatusLabel(t.status)}
							</span>
						</div>
					</li>
				))}
			</ul>
			<div class="bg-background sticky bottom-0 pt-3 pb-1">
				<slot />
			</div>
		</div>
	)
}
