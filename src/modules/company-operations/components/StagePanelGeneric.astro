---
import { Icon } from 'astro-icon/components';
import type { Stage } from '../types';
import TaskCardsList from './TaskCardsList.astro';

interface Props {
	stage: Stage;
}

const { stage } = Astro.props;
---

<div>
	<header class="mb-4">
		<p class="text-foreground flex items-center gap-2 text-sm font-medium">
			<Icon name="ri:time-line" class="text-accent-gold h-4 w-4" />
			{stage.name}
		</p>
		<p class="text-muted-foreground mt-0.5 text-xs">
			Etapa {stage.order} · {
				stage.tasks.filter((t) => t.status === 'completed').length
			}/{stage.tasks.length} tareas completadas
		</p>
	</header>

	<TaskCardsList
		tasks={stage.tasks}
		emptyMessage="No hay tareas registradas en esta etapa."
	/>
</div>
