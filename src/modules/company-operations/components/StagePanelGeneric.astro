---
import { Icon } from 'astro-icon/components';
import type { Stage } from '../types';
import {
	priorityClass,
	priorityLabel,
	taskStatusBadge,
	taskStatusLabel,
} from '../lib/style-helpers';

interface Props {
	stage: Stage;
}

const { stage } = Astro.props;
---

<div>
	<header class="mb-4">
		<p
			class="flex items-center gap-2 text-sm font-medium text-foreground"
		>
			<Icon
				name="ri:time-line"
				class="h-4 w-4 text-accent-gold"
			/>
			{stage.name}
		</p>
		<p class="mt-0.5 text-xs text-muted-foreground">
			Etapa {stage.order} · {stage.tasks.filter((t) => t.status === 'completed').length}/{stage.tasks.length} tareas completadas
		</p>
	</header>

	{
		stage.tasks.length === 0 ? (
			<p class="rounded-lg border border-dashed border-border p-4 text-center text-xs text-muted-foreground">
				No hay tareas registradas en esta etapa.
			</p>
		) : (
			<ul class="divide-y divide-border">
				{stage.tasks.map((t) => (
					<li class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
						<input
							type="checkbox"
							checked={t.status === 'completed'}
							class="mt-1 h-4 w-4 shrink-0 rounded border-border"
							disabled
						/>
						<div class="min-w-0 flex-1">
							<div class="flex flex-wrap items-center gap-2">
								<p
									class={`text-sm font-medium ${
										t.status === 'completed'
											? 'text-muted-foreground line-through'
											: 'text-foreground'
									}`}
								>
									{t.title}
								</p>
								<span
									class={`text-2xs rounded px-1.5 py-0.5 font-semibold tracking-wide uppercase ${priorityClass(t.priority)}`}
								>
									{priorityLabel(t.priority)}
								</span>
							</div>
							<p class="mt-0.5 text-xs text-muted-foreground">
								{t.description}
							</p>
						</div>

						<div class="flex shrink-0 items-center gap-3">
							{t.assignee ? (
								<span class="inline-flex items-center gap-2 text-xs text-muted-foreground">
									<span class="text-2xs inline-flex h-6 w-6 items-center justify-center rounded-full bg-muted font-semibold text-foreground">
										{t.assignee.initials}
									</span>
									{t.assignee.name}
								</span>
							) : (
								<button
									type="button"
									class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground hover:text-foreground"
								>
									<Icon name="ri:user-add-line" class="h-3.5 w-3.5" />
									Asignar
								</button>
							)}
							<span
								class={`rounded-full px-2 py-0.5 text-[11px] font-medium ${taskStatusBadge(t.status)}`}
							>
								{taskStatusLabel(t.status)}
							</span>
						</div>
					</li>
				))}
			</ul>
		)
	}
</div>
