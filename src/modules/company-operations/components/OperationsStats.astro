---
import { Icon } from 'astro-icon/components';
import type { StatCard } from '../types';
import { statTone } from '../lib/style-helpers';

interface Props {
	stats: StatCard[];
}

const { stats } = Astro.props;
---

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
	{
		stats.map((s) => (
			<article class="flex items-center justify-between rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-transparent">
				<div>
					<p class="text-2xl font-semibold text-gray-950 dark:text-white">
						{s.value}
					</p>
					<p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
						{s.label}
					</p>
				</div>
				<span
					class={`inline-flex h-9 w-9 items-center justify-center rounded-lg ${statTone(s.tone)}`}
				>
					<Icon name={s.icon} class="h-4 w-4" />
				</span>
			</article>
		))
	}
</div>
