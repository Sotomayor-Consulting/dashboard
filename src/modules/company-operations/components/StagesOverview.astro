---
import { Icon } from 'astro-icon/components';
import type { Stage } from '../types';
import {
	stageIcon,
	stageIconColor,
	stageRingClass,
} from '../lib/style-helpers';

interface Props {
	stages: Stage[];
}

const { stages } = Astro.props;
---

<section
	class="to-black-600 from-black-900 rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-linear-to-tr"
>
	<header class="mb-4 flex items-start justify-between gap-3">
		<p
			class="flex items-center gap-2 text-sm font-semibold text-gray-950 dark:text-white"
		>
			<Icon
				name="ri:function-line"
				class="h-4 w-4 text-amber-500 dark:text-amber-400"
			/>
			Vista General de Etapas
		</p>
	</header>
	<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
		{
			stages.map((s) => (
				<article
					class={`rounded-lg border p-3 transition ${stageRingClass(s.status)}`}
				>
					<div class="flex items-center gap-2 text-[11px] font-medium text-gray-500 dark:text-gray-400">
						<Icon
							name={stageIcon(s.status)}
							class={`h-3.5 w-3.5 ${stageIconColor(s.status)}`}
						/>
						Etapa {s.order}
					</div>
					<p class="mt-1 text-sm font-semibold text-gray-950 dark:text-white">
						{s.name}
					</p>
					<p class="mt-1 inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
						<Icon name="ri:time-line" class="h-3 w-3" />
						SLA: {s.slaHours}h
					</p>
				</article>
			))
		}
	</div>
</section>
