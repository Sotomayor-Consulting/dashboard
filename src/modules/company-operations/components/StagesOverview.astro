---
import { Icon } from 'astro-icon/components';
import type { Stage } from '../types';
import {
	stageIcon,
	stageIconColor,
	stageRingClass,
} from '../lib/style-helpers';

interface Props {
	stages: Stage[];
}

const { stages } = Astro.props;
const canReset = (status: string) =>
	status === 'in_progress' || status === 'completed';
---

<section
	class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-transparent"
>
	<header class="mb-4 flex items-start justify-between gap-3">
		<p
			class="flex items-center gap-2 text-sm font-semibold text-gray-950 dark:text-white"
		>
			<Icon
				name="ri:function-line"
				class="h-4 w-4 text-amber-500 dark:text-amber-400"
			/>
			Vista General de Etapas
		</p>
	</header>
	<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
		{
			stages.map((s) => (
				<article
					class={`rounded-lg border p-3 transition ${stageRingClass(s.status)}`}
				>
					<div class="flex items-center gap-2 text-[11px] font-medium text-gray-500 dark:text-gray-400">
						<Icon
							name={stageIcon(s.status)}
							class={`h-3.5 w-3.5 ${stageIconColor(s.status)}`}
						/>
						Etapa {s.order}
					</div>
					<p class="mt-1 text-sm font-semibold text-gray-950 dark:text-white">
						{s.name}
					</p>
					<div class="mt-2 flex items-center justify-between">
						<p class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
							<Icon name="ri:time-line" class="h-3 w-3" />
							SLA: {s.slaHours}h
						</p>
						{canReset(s.status) && (
							<button
								type="button"
								class="btn-reset-stage inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[10px] font-medium text-amber-600 transition hover:bg-amber-50 dark:text-amber-400 dark:hover:bg-amber-900/20"
								data-stage-id={s.id}
								data-stage-name={s.name}
								title="Resetear etapa y sus tareas a pendiente"
							>
								<Icon name="ri:restart-line" class="h-3 w-3" />
								Resetear
							</button>
						)}
					</div>
				</article>
			))
		}
	</div>
</section>

<script is:inline>
	document.addEventListener('click', async (e) => {
		const btn = e.target.closest('.btn-reset-stage');
		if (!btn) return;
		e.preventDefault();

		const stageId = btn.dataset.stageId;
		const stageName = btn.dataset.stageName || 'esta etapa';

		const confirmed = confirm(
			`¿Resetear "${stageName}"?\n\nTodas las tareas volverán a pendiente y la etapa quedará en progreso.`
		);
		if (!confirmed) return;

		btn.disabled = true;
		const originalText = btn.textContent;
		btn.textContent = ' Reseteando...';

		try {
			const res = await fetch('/api/workflow/stages/reset', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ stage_id: stageId }),
			});
			const data = await res.json();
			if (!res.ok || !data.ok) {
				throw new Error(data.error || 'Error al resetear');
			}
			window.location.reload();
		} catch (err) {
			alert(err.message || 'Error al resetear la etapa');
			btn.disabled = false;
			btn.textContent = originalText;
		}
	});
</script>
