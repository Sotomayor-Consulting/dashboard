---
import { Icon } from 'astro-icon/components';
import type { CurrentStage } from '../types';
import { resolveOpsStageComponent } from '../stages/registry.ts';

interface Props {
	currentStage: CurrentStage;
	empresaId: string;
}

const { currentStage, empresaId } = Astro.props;
const StageBody = resolveOpsStageComponent(currentStage.slug);
---

<section
	class="to-black-600 from-black-900 rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-linear-to-tr"
>
	<header class="mb-4 flex items-start justify-between gap-3">
		<div class="min-w-0">
			<p
				class="flex items-center gap-2 text-sm font-semibold text-gray-950 dark:text-white"
			>
				<Icon
					name="ri:time-line"
					class="h-4 w-4 text-amber-500 dark:text-amber-400"
				/>
				{currentStage.name}
			</p>
			<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
				{currentStage.description}
			</p>
		</div>
		{
			currentStage.requiresApproval && currentStage.approvalRole === 'client' ? (
				<span
					class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-amber-500 px-3 py-2 text-xs font-semibold text-white opacity-80"
					title="Esta etapa requiere aprobación del cliente"
				>
					<Icon name="ri:user-received-line" class="h-3.5 w-3.5" />
					Requiere aprobación del cliente
				</span>
			) : (
				<button
					type="button"
					class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-gray-950 px-3 py-2 text-xs font-semibold text-white transition hover:bg-gray-800 dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100"
				>
					<Icon name="ri:arrow-right-line" class="h-3.5 w-3.5" />
					Avanzar etapa
				</button>
			)
		}
	</header>

	<StageBody currentStage={currentStage} empresaId={empresaId} />
</section>
