---
import { Icon } from 'astro-icon/components';
import type { CurrentStage } from '../types';
import { resolveOpsStageComponent } from '../stages/registry.ts';

interface Props {
	currentStage: CurrentStage;
	empresaId: string;
}

const { currentStage, empresaId } = Astro.props;
const StageBody = resolveOpsStageComponent(currentStage.slug);
---

<div>
	<header class="mb-4 flex items-start justify-between gap-3">
		<div class="min-w-0">
			<p
				class="flex items-center gap-2 text-sm font-medium text-foreground"
			>
				<Icon
					name="ri:time-line"
					class="h-4 w-4 text-accent-gold"
				/>
				{currentStage.name}
			</p>
			<p class="mt-0.5 text-xs text-muted-foreground">
				{currentStage.description}
			</p>
		</div>
	</header>

	<StageBody currentStage={currentStage} empresaId={empresaId} />
</div>
