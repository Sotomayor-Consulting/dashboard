---
import { Icon } from 'astro-icon/components';
import type { QueueItem } from '../types';
import { priorityClass, priorityLabel } from '../lib/style-helpers';

interface Props {
	teamQueue: QueueItem[];
}

const { teamQueue } = Astro.props;
---

<section
	class="to-black-600 from-black-900 rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-linear-to-tr"
>
	<header class="mb-3 flex items-center justify-between">
		<h4 class="text-sm font-semibold text-gray-950 dark:text-white">
			Cola del Equipo
		</h4>
		<span
			class="rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-white/10 dark:text-gray-300"
		>
			{teamQueue.length} tareas
		</span>
	</header>
	<ul class="space-y-2">
		{teamQueue.length === 0 && (
			<li class="rounded-lg border border-dashed border-gray-200 p-3 text-center text-xs text-gray-500 dark:border-gray-700 dark:text-gray-400">
				Sin tareas pendientes para operaciones.
			</li>
		)}
		{
			teamQueue.map((q) => (
				<li class="rounded-lg border border-gray-200 p-3 dark:border-gray-800">
					<div class="flex items-start justify-between gap-2">
						<p class="text-sm font-medium text-gray-950 dark:text-white">
							{q.title}
						</p>
						<span
							class={`text-2xs shrink-0 rounded px-1.5 py-0.5 font-semibold ${priorityClass(q.priority)}`}
						>
							{priorityLabel(q.priority)}
						</span>
					</div>
					<div class="mt-1.5 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
						<span class="inline-flex items-center gap-1">
							<Icon name="ri:user-line" class="h-3 w-3" />
							{q.assignee}
						</span>
						<span class="inline-flex items-center gap-1">
							<Icon name="ri:time-line" class="h-3 w-3" />
							{q.eta}
						</span>
					</div>
				</li>
			))
		}
	</ul>
	<button
		type="button"
		class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-gray-200 px-3 py-2 text-xs font-medium text-gray-700 transition hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/5"
	>
		Ver cola completa
		<Icon name="ri:arrow-right-s-line" class="h-3.5 w-3.5" />
	</button>
</section>
