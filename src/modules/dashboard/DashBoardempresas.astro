									id="path1"
									d="M212.325 135.821V88.572c-2.776-8.19-7.114-10.708-11.821-10.124-6.066.752-12.743 6.657-22.699 5.152-8.711-1.317-19.933-8.308-28.402-8.135-1.21.025-2.363.196-3.445.55-8.658 2.838-12.739 17.427-20.944 22.693s-20.535 1.208-30.02-3.366S78.87 85.68 69.65 89.561s-21.02 16.734-29.513 21.597c-8.492 4.863-13.676 1.737-19.86 4.053s-13.366 10.073-18.88 17.6c-.74 1.009-1.45 2.014-2.062 3.01z"
