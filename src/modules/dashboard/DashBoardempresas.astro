---
import '@styles/datatables.css';
import { Icon } from 'astro-icon/components';
import Dropzone from '@components/display/Dropzone.astro';
import { getIncorporacionById } from '@lib/tablas/empresa_incorporaciones';
import { getEstadoPorEmpresa } from '@lib/tablas/estados';
import { getUserFolders } from '@lib/storage/test.ts';
import { getDocumentosPorFirmar } from '@lib/tablas/documentos_por_firmar';

interface Props {
	empresaId: string;
}

const { empresaId } = Astro.props;
const { id } = Astro.params;
const user = Astro.locals.user;
const userId = user?.id;

if (!id || !userId) {
	return Astro.redirect('/');
}

const [empresa, folderPath, porfirmar] = await Promise.all([
	getIncorporacionById(id, userId),
	getUserFolders(userId, id),
	getDocumentosPorFirmar(userId, empresaId),
]);

// Obtener estado de incorporación para el mapa
let estadoMapa = null;
if (empresa.estado_de_incorporacion) {
	const estadoData = await getEstadoPorEmpresa(empresa.estado_de_incorporacion);

	if (estadoData) {
		estadoMapa = estadoData.Estado;
	}
}
---

<div class="px-4 pt-6">
	<div
		class="my-4 grid w-full grid-cols-1 gap-4 xl:grid-cols-2 2xl:grid-cols-3"
	>
		<div
			class="dark:bg-black-800 bg-white-50 items-center justify-between rounded-lg border border-gray-200 p-4 shadow-sm sm:flex sm:p-6 dark:border-gray-700"
		>
			<div class="w-full">
				<h3 class="mb-2 text-base font-normal text-gray-500 dark:text-gray-400">
					Nombre de tu empresa
