			porfirmar && porfirmar.length > 0 ? (
				porfirmar.map((f) => (
					<div class="dark:bg-black-800 bg-white-50 rounded-lg border border-gray-200 p-4 shadow-sm sm:p-6 dark:border-gray-700">
						<h3 class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-white">
							Documentos pendientes a firmar
							<button
								data-popover-target="popover-description"
								data-popover-placement="bottom-end"
								type="button"
							>
								<>
									<svg
										class="ml-2 h-4 w-4 text-gray-400 hover:text-gray-500"
										aria-hidden="true"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
									>
