												class="btn-upload-firmado bg-success hover:bg-success-strong focus:ring-success-medium rounded-base box-border inline-flex cursor-pointer border border-transparent px-4 py-2.5 text-sm leading-5 font-medium text-white shadow-xs focus:ring-4 focus:outline-none"
											>
												<Icon
													name="ri:upload-2-fill"
													class="-ms-0.5 me-1.5 text-base"
												/>
