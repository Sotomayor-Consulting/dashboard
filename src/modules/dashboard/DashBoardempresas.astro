			<div class="w-full">
				<h3 class="mb-2 text-base font-normal text-gray-500 dark:text-gray-400">
					Porcentaje de incorporación
				</h3>
				<span
					class="text-xl leading-none font-bold text-gray-900 sm:text-3xl dark:text-white"
