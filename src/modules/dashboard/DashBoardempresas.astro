										clip-rule="evenodd"
									/>
								</svg>
								<span class="sr-only">Ayuda</span>
							</>
						</button>
					</h3>
					<div
						data-popover
						id="popover-description"
						role="tooltip"
						class="dark:bg-black-800 bg-white-50 invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 text-sm font-light text-gray-500 opacity-0 shadow-sm transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
					>
						<div class="space-y-2 p-3">
							<h3
								class="font-semibold text-gray-900 dark:text-white"
								aria-label="Acciones rapidas"
							>
								Acciones rápidas
							</h3>
							<p>
								Selecciona una opción para acceder a las múltiples funciones y
								servicios que tenemos.
							</p>
						</div>
						<div data-popper-arrow />
					</div>
					<div class="border-t border-gray-200 dark:border-gray-600">
						<div class="pt-4">
							<ul class="mb-4 space-y-4">
								{[
									{
										icono: 'ri:building-2-fill',
										nombre: 'Crea un nueva LLC',
										link: '/start/',
									},
									{
										icono: 'ri:calendar-schedule-fill',
										nombre: 'Agenda una reunión',
										link: 'https://zcal.co/t/agendar-asesoria-llc/60min',
									},
									{
										icono: 'ri:account-circle-fill',
										nombre: 'Configura tu perfil',
										link: '/partners/configuracion-partners/',
									},
									{
										icono: 'ri:bar-chart-2-fill',
										nombre: 'Mira tus empresas',
										link: '/pages/companias',
									},
								].map((a) => (
									<li>
										<a href={a.link}>
											<label
												for="job-1"
												class="text-body dark:bg-black-700 bg-white-100 border-default rounded-base peer-checked:hover:bg-brand-softer peer-checked:border-brand-subtle peer-checked:bg-brand-softer hover:bg-neutral-secondary-medium peer-checked:text-fg-brand-strong inline-flex w-full cursor-pointer items-center border p-5"
											>
												<div class="bg-brand-soft dark:text-fg-brand-strong flex h-9 w-9 items-center justify-center rounded text-[#8c681d]">
													<Icon name={a.icono} class="text-lg" />
												</div>
												<div class="ms-2.5 block">
													<div class="w-full text-base font-medium">
														{a.nombre}
													</div>
												</div>

												<Icon
													name="ri:arrow-right-long-line"
													class="ms-auto text-lg"
												/>
											</label>
										</a>
									</li>
								))}
