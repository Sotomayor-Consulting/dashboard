						</div>
					</div>
				</div>
			)
		}
	</div>
	<div
		class="dark:bg-black-800 bg-white-50 my-4 rounded-lg border border-gray-200 p-4 shadow-sm sm:p-6 dark:border-gray-700"
	>
		<!-- Card header -->
		<div class="items-center justify-between lg:flex">
			<div class="mb-4 lg:mb-0">
				<h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">
					Documentos
				</h3>
				<span class="text-base font-normal text-gray-500 dark:text-gray-400"
					>Tu lista de documentos de la empresa</span
				>
			</div>
		</div>
		<!-- Table -->
		<div class="mt-6 flex flex-col">
			<div class="overflow-x-auto rounded-lg">
				<div class="inline-block min-w-full align-middle">
					<div class="overflow-hidden shadow sm:rounded-lg">
						<table
							class="min-w-full divide-y divide-gray-200 dark:divide-gray-600"
							id="myTable"
						>
							<thead class="dark:bg-black-800 bg-gray-50">
								<tr>
									{
										[
											'Nombre del documento',
											'Fecha',
											'estado del documento',
											'Descargar',
										].map((th) => (
											<th
												scope="col"
												class="p-4 text-left text-xs font-medium tracking-wider text-neutral-600 uppercase dark:text-white"
											>
												<span class="flex items-center uppercase">
													{th}
													<svg
														class="ms-1 h-4 w-4"
														aria-hidden="true"
														xmlns="http://www.w3.org/2000/svg"
														width="24"
														height="24"
														fill="none"
														viewBox="0 0 24 24"
													>
														<path
															stroke="currentColor"
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="2"
															d="m8 15 4 4 4-4m0-6-4-4-4 4"
														/>
													</svg>
												</span>
											</th>
										))
									}
								</tr>
							</thead>
							<tbody class="dark:bg-black-800 bg-white-50">
								{
									folderPath.map((archivos) => (
										<tr class="odd:bg-white-100 cursor-pointer even:bg-[#d4d4d4] hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]">
											<td class="p-4 text-sm font-normal whitespace-nowrap text-gray-900 dark:text-white">
												<span class="font-semibold">{archivos.name}</span>
											</td>
											<td class="p-4 text-sm font-normal whitespace-nowrap text-gray-500 dark:text-gray-400">
												{archivos.updated_at &&
													new Date(archivos.updated_at)
														.toLocaleDateString('es-ES', {
															day: '2-digit',
															month: '2-digit',
															year: 'numeric',
														})
														.replace(/\//g, '-')}
											</td>
											<td class="p-4 whitespace-nowrap">
												<span class="mx-auto mr-2 rounded-md border border-green-500 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:border-green-500 dark:text-green-400">
													Subido
												</span>
											</td>
											<td class="p-4 text-sm font-semibold whitespace-nowrap text-gray-900 dark:text-neutral-500">
												<button
													class="btn-ver-documento cursor-pointer"
													data-path={`${userId}/companies/${id}/documents/${archivos.name}`}
													title="Ver o descargar documento"
												>
													<Icon
														name="ri:download-2-line"
														class="text-2xl text-neutral-900 transition-colors hover:text-neutral-600 dark:text-neutral-500 dark:hover:text-white"
													/>
												</button>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<div
	id="popup-modal"
	tabindex="-1"
	class="fixed top-0 right-0 left-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0"
>
	<div class="relative max-h-full w-full max-w-3xl p-4">
		<div
			class="bg-neutral-primary-soft border-default rounded-base relative border p-4 shadow-sm md:p-6"
		>
			<button
				type="button"
				class="text-body hover:bg-neutral-tertiary hover:text-heading rounded-base absolute end-2.5 top-3 ms-auto inline-flex h-9 w-9 items-center justify-center bg-transparent text-sm"
				data-modal-hide="popup-modal"
			>
				<svg
					class="h-5 w-5"
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					fill="none"
					viewBox="0 0 24 24"
					><path
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18 17.94 6M18 18 6.06 6"></path></svg
				>
				<span class="sr-only">Close modal</span>
			</button>
			<div class="p-4 text-center md:p-5">
				<Dropzone
					mensaje="Arrastra el documento pendiente a firmar aquí o haz clic para subir."
					icon="ri:draft-line"
					id="ConFirma"
					endpoint={`/api/documentos/upload_file_signed?empresaId=${empresaId}&userId=${userId}`}
				/>
			</div>
		</div>
	</div>
</div>

<script>
	import './DashBoardEmpresas.client.ts';
</script>

<script>
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.btn-ver-documento');
		if (!btn) return;

		const path = (btn as HTMLElement).dataset.path;
		if (!path) return;

		try {
			const res = await fetch('/api/storage/get-signed-url', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ path }),
			});
			const data = await res.json();
			if (data.error) throw new Error(data.error);
			window.open(data.signedUrl, '_blank');
		} catch (error) {
			console.error('Error al obtener documento:', error);
			alert('Error al cargar el documento');
		}
	});

	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.btn-upload-firmado');
		if (!btn) return;

		const fileId = (btn as HTMLElement).dataset.fileId;
		if (!fileId) return;

		const form = document.getElementById('ConFirma') as HTMLFormElement;
		if (!form) return;

		let input = form.querySelector('input[name="fileId"]') as HTMLInputElement;
		if (!input) {
			input = document.createElement('input');
			input.type = 'hidden';
			input.name = 'fileId';
			form.appendChild(input);
		}
		input.value = fileId;
	});
</script>

