---
import { getReferidos } from '@lib/tablas/referidos';
import { getCodigoDePartner } from '@lib/tablas/referidos';
import { Icon } from 'astro-icon/components';

const user = Astro.locals.user;
const UserId = user?.id;

const rows = UserId ? await getReferidos(UserId) : null;
const codigo = UserId ? await getCodigoDePartner(UserId) : null;

const referidosSupabase = (rows ?? []).map((r) => ({
	name:
		`${r.referido[0]?.nombre ?? ''} ${r.referido[0]?.apellido ?? ''}`.trim() ||
		'—',
	email: r.referido[0]?.correo ?? '—',
	avatar: r.referido[0]?.avatar_url ?? null,
	code: r.code,
	fecha: r.created_at,
	estado: r.referido[0]?.estado,
	fuente: 'Supabase',
}));
type Referral = {
	name: string;
	email?: string | null;
	create_date?: string;
	avatar?: string | null;
	fuente?: string;
};

let referrals: Referral[] = [];
let errorMsg = '';
let loading = true;

try {
	const apiUrl = new URL('/api/odoo/referrals', Astro.request.url);

	// 2) Pasar las cookies del request actual al endpoint
	const res = await fetch(apiUrl.toString(), {
		headers: {
			cookie: Astro.request.headers.get('cookie') ?? '',
		},
	});

	if (!res.ok) {
		errorMsg = 'Sistema ERP no disponible temporalmente.';
	} else {
		const { success, data } = await res.json();

		if (!success) {
			errorMsg = 'Sistema ERP no disponible temporalmente.';
		} else {
			referrals = data ?? [];
		}
	}
} catch (err) {
	errorMsg = 'No se pudo conectar con el ERP.';
} finally {
	loading = false;
}

// Combinar datos de Odoo y Supabase
const referidosOdoo = referrals.map((r) => ({
	name: r.name,
	email: r.email,
	avatar: r.avatar || null,
	fecha: r.create_date,
	fuente: 'Odoo',
}));

const referidosCombinados = [...referidosSupabase, ...referidosOdoo].sort(
	(a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime(),
);
---

<div class="px-4 pt-6">
	<div class="grid gap-4 xl:grid-cols-2 2xl:grid-cols-3">
		{
			referidosCombinados.length !== 0 ? (
				<>
					<div class="dark:bg-black-800 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700">
						<div class="mb-4 flex items-center justify-between">
							<div class="shrink-0">
								<span class="text-xl leading-none font-bold text-gray-900 sm:text-2xl dark:text-white">
									Referidos
								</span>
								<h3 class="text-base font-light text-gray-500 dark:text-gray-400">
									por dia
								</h3>
							</div>
						</div>
						<div id="main-chart" />

						<div class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 sm:pt-6 dark:border-gray-700">
							<div>
								<p class="inline-flex items-center rounded-lg p-2 text-center text-sm font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">
									Últimos 10 días
								</p>
							</div>
						</div>
					</div>

					<div class="dark:bg-black-800 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 dark:border-gray-700">
						<h3 class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-white">
							Lista de usuarios que referiste
							<button
								data-popover-target="popover-description"
								data-popover-placement="bottom-end"
								type="button"
							>
								<>
									<svg
										class="ml-2 h-4 w-4 text-gray-400 hover:text-gray-500"
										aria-hidden="true"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path
											fill-rule="evenodd"
											d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
											clip-rule="evenodd"
										/>
									</svg>
									<span class="sr-only">Mostrar información</span>
								</>
							</button>
						</h3>
						<div
							data-popover
							id="popover-description"
							role="tooltip"
							class="dark:bg-black-800 invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 bg-white text-sm font-light text-gray-500 opacity-0 shadow-sm transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
						>
							<div class="space-y-2 p-3">
								<h3 class="font-semibold text-gray-900 dark:text-white">
									Acciones rápidas
								</h3>
								<p>
									Accede rápidamente a funciones o herramientas útiles, que te ayudaran a saber tu código de partner, agendar una reunión, o acceder a otros funciones de la plataforma. 
								</p>
							</div>
							<div data-popper-arrow />
						</div>

						<div class="space-y-2 p-3">
							<h3 class="font-semibold text-gray-900 dark:text-white">
								Referidos
							</h3>
						</div>
						<div
							id="fullWidthTabContent"
							class="border-t border-gray-200 dark:border-gray-600"
						>
							<div
								class="pt-4"
								id="about"
								role="tabpanel"
								aria-labelledby="about-tab"
							>
								<ul
									role="list"
									class="divide-y divide-gray-200 dark:divide-gray-700"
								>
									{referidosCombinados?.map((r) => (
										<li class="py-3 sm:py-4">
											<div class="flex items-center space-x-4">
												<div class="shrink-0">
													{!r.avatar || r.avatar === 'NULL' ? (
														<img
															class="h-10 w-10 rounded-full"
															src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${r.name}`}
															alt={`Avatar de ${r.name}`}
														/>
													) : (
														<img
															class="h-10 w-10 rounded-full"
															src={r.avatar}
															alt={`Avatar de ${r.name}`}
														/>
													)}
												</div>
												<div class="min-w-0 flex-1">
													<p class="truncate font-medium text-gray-900 dark:text-white">
														{r.name}
													</p>
													<p class="truncate text-sm text-gray-500 dark:text-gray-400">
														{r.email}
													</p>
												</div>
											</div>
										</li>
									))}
								</ul>
							</div>
						</div>
					</div>
				</>
			) : (
				<>
					<div class="dark:bg-black-800 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700">
						<div>
							<section>
								<div class="mx-auto max-w-7xl gap-16 px-4 py-8 lg:px-6 lg:py-16">
									<div class="font-light text-gray-500 sm:text-lg dark:text-gray-400">
										<h2 class="mb-4 text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
											Aún no tienes referidos
										</h2>
										<p class="mb-4">
											¡No te preocupes! Este es el momento ideal para empezar a
											compartir tu código único de referido. Cada persona que
											forme su LLC en Estados Unidos a través de tu código te
											generará una comisión. Piensa en todos los emprendedores,
											dueños de negocios o inversores que conoces y que podrían
											beneficiarse de tener una empresa en EE.UU. (acceso a
											Stripe, PayPal, facilidad para facturar, etc.).
										</p>
										<p class="mb-4">
											<strong>
												¿Cómo puedes compartir tu código y atraer clientes?
											</strong>
											Aquí tienes algunas ideas prácticas:
										</p>

										<div
											id="accordion-card"
											data-accordion="collapse"
											class="mb-5"
										>
											{[
												{
													titulo: 'Redes sociales',
													parrafo:
														'Publica en LinkedIn, Instagram o Facebook explicando las ventajas de formar una LLC en EE.UU. (por ejemplo, para vender online, proteger activos o acceder al mercado americano). Incluye tu código en la publicación o en tu biografía.',
												},
												{
													titulo: 'Comunidades de emprendedores',
													parrafo:
														'Participa en grupos de Facebook, foros o canales de Slack donde haya personas interesadas en internacionalizar sus negocios. Comparte tu experiencia y ofrece tu código como ayuda.',
												},
												{
													titulo: 'Email marketing',
													parrafo:
														' Si ya tienes una lista de contactos (clientes, colegas, seguidores), envía un correo breve contándoles cómo pueden formar su LLC fácilmente y con un beneficio extra al usar tu código.',
												},

												{
													titulo: 'Alianzas estratégicas',
													parrafo:
														'Conecta con contadores, abogados o asesores de negocios que atiendan a emprendedores. Ofréceles compartir tu código con sus clientes a cambio de una comisión (puedes establecer un acuerdo de referidos).',
												},
											].map((l, index) => (
												<>
													<h2 id={`recomendacion-${index}`}>
														<button
															type="button"
															class="text-body rounded-base border-default hover:text-heading hover:bg-white-200 bg-white-100 dark:bg-black-900 dark:hover:bg-black-700 flex w-full items-center justify-between gap-3 border p-5 font-medium shadow-xs aria-expanded:rounded-b-none aria-expanded:shadow-none rtl:text-right"
															data-accordion-target={`#recomendacion-body-${index}`}
															aria-expanded="true"
															aria-controls={`recomendacion-body-${index}`}
														>
															<span>{l.titulo}</span>

															<Icon
																name="ri:arrow-up-s-line"
																class="h-5 w-5 shrink-0 rotate-180"
																data-accordion-icon
															/>
														</button>
													</h2>
													<div
														id={`recomendacion-body-${index}`}
														class="border-default rounded-b-base hidden border border-t-0 shadow-xs"
														aria-labelledby={`recomendacion-${index}`}
													>
														<div class="p-4 md:p-5">
															<p class="text-body mb-2">{l.parrafo}</p>
														</div>
													</div>
												</>
											))}
										</div>

										<p>
											Recuerda: mientras más personas conozcan los beneficios de
											tener una LLC en EE.UU., más oportunidades tendrás de
											ganar comisiones. ¡Empieza hoy mismo a compartir tu código
											y construye tu red de referidos!
										</p>
									</div>
								</div>
							</section>
						</div>
					</div>

					<div class="dark:bg-black-800 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 dark:border-gray-700">
						<h3 class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-white">
							Acciones Rápidas
							<button
								data-popover-target="popover-description"
								data-popover-placement="bottom-end"
								type="button"
							>
								<>
									<svg
										class="ml-2 h-4 w-4 text-gray-400 hover:text-gray-500"
										aria-hidden="true"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path
											fill-rule="evenodd"
											d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
											clip-rule="evenodd"
										/>
									</svg>
									<span class="sr-only">Mostrar información</span>
								</>
							</button>
						</h3>
						<div
							data-popover
							id="popover-description"
							role="tooltip"
							class="dark:bg-black-800 invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 bg-white text-sm font-light text-gray-500 opacity-0 shadow-sm transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
						>
							<div class="space-y-2 p-3">
								<h3 class="font-semibold text-gray-900 dark:text-white">
									Acciones rápidas
								</h3>
								<p>
									Accede de forma fácil a herramientas o links.
								</p>
							</div>
							<div data-popper-arrow />
						</div>

						<div class="dark:bg-black-700 bg-white-50 rounded-xl gap-2 flex flex-col p-5 mb-5 drop-shadow-2xl">
							<div>
								<h5 class="dark:text-white">Copia tu código de partner:</h5>
							</div>
							<div class="w-full">
								<div class="relative">
									<label for="copiarCodigo" class="sr-only">
										Label
									</label>
									<input
										id="copiarCodigo"
										type="text"
										class="bg-neutral-secondary-medium border-default-medium text-body rounded-base focus:ring-brand focus:border-brand placeholder:text-body col-span-6 block w-full border px-3 py-2.5 text-sm shadow-xs"
										value={codigo?.codigo_de_partner}
										disabled
										readonly
									/>
									<button
										data-copy-to-clipboard-target="copiarCodigo"
										class="text-body bg-neutral-primary-strong border-default-strong hover:bg-neutral-secondary-strong/70 hover:text-heading focus:ring-neutral-tertiary-soft active:group absolute inset-e-1.5 top-1/2 flex -translate-y-1/2 items-center rounded border px-3 py-1.5 text-xs leading-5 font-medium focus:ring-4 focus:outline-none"
									>
										<span id="default-message-codigo">
											<span class="flex items-center">
												<svg
													class="me-1.5 h-4 w-4"
													aria-hidden="true"
													xmlns="http://www.w3.org/2000/svg"
													width="24"
													height="24"
													fill="none"
													viewBox="0 0 24 24"
												>
													<path
														stroke="currentColor"
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M15 4h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3m0 3h6m-6 5h6m-6 4h6M10 3v4h4V3h-4Z"
													/>
												</svg>
												<span class="text-xs font-semibold">Copiar</span>
											</span>
										</span>
										<span id="success-message-codigo" class="hidden">
											<span class="flex items-center">
												<svg
													class="dark:text-black-400 me-1.5 h-4 w-4"
													aria-hidden="true"
													xmlns="http://www.w3.org/2000/svg"
													width="24"
													height="24"
													fill="none"
													viewBox="0 0 24 24"
												>
													<path
														stroke="currentColor"
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="M15 4h3a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3m0 3h6m-6 7 2 2 4-4m-5-9v4h4V3h-4Z"
													/>
												</svg>
												<span class="dark:text-black-400 text-xs font-semibold">
													¡Copiado!
												</span>
											</span>
										</span>
									</button>
								</div>
							</div>
						</div>

						<div
								class="pt-4 flex justify-center"
								id="about"
								role="tabpanel"
								aria-labelledby="about-tab"
							>
								<div class="mt-8">
									<Icon name="persona-esperando" width={300} height={300} />
								</div>
							</div>
					</div>
				</>
			)
		}
	</div>
</div>

<script>
	import './DashBoardpartners.client.js';
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		const $defaultMessage = document.getElementById('default-message-codigo');
		const $successMessage = document.getElementById('success-message-codigo');
		const copyButton = document.querySelector(
			'[data-copy-to-clipboard-target="copiarCodigo"]',
		);

		const showSuccess = () => {
			if ($defaultMessage) $defaultMessage.classList.add('hidden');
			if ($successMessage) $successMessage.classList.remove('hidden');
		};

		const resetToDefault = () => {
			if ($defaultMessage) $defaultMessage.classList.remove('hidden');
			if ($successMessage) $successMessage.classList.add('hidden');
		};

		if (copyButton) {
			copyButton.addEventListener('click', async () => {
				const input = document.getElementById('copiarCodigo');
				if (input) {
					try {
						await navigator.clipboard.writeText(input.value);
						showSuccess();
						setTimeout(resetToDefault, 2000);
					} catch (err) {
						console.error('Failed to copy:', err);
					}
				}
			});
		}
	});
</script>
