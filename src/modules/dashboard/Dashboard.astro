---
import { Icon } from 'astro-icon/components';

import {
	getEmpresasForSwitcher,
	resolveActiveCompany,
	type EmpresaSwitcherItem,
} from '@domains/companies/companies';
import {
	getDocumentsForIncorporationCase,
	getDocumentRequestsForIncorporationCase,
} from '@domains/documents/document_dashboard';
import { getNotifications } from '@domains/users/notifications';
import { ACTIVE_COMPANY_COOKIE } from '@shared/cookies';

type NotificationRow = {
	id?: string;
	message?: string;
	created_at?: string;
	link?: string | null;
	is_read?: boolean;
};

type SubmittedFormRow = {
	submission_id: string;
	status: string | null;
	submitted_at: string | null;
	updated_at: string | null;
	formularios?: { titulo?: string | null } | null;
};

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];

let usuario: { nombre?: string | null; apellido?: string | null } | null = null;
let empresas: EmpresaSwitcherItem[] = [];
let notificationsData: {
	notifications: NotificationRow[];
	totalUnread: number;
} = {
	notifications: [],
	totalUnread: 0,
};
let submittedForms: SubmittedFormRow[] = [];

if (userId) {
	const [profileResult, companiesResult, notificationsResult, formsResult] =
		await Promise.allSettled([
			supabase
				.from('usuarios')
				.select('nombre, apellido')
				.eq('user_id', userId)
				.maybeSingle(),
			getEmpresasForSwitcher(supabase, userId),
			getNotifications(supabase, userId, 5),
			supabase
				.from('submitted_forms')
				.select(
					`
					submission_id,
					status,
					submitted_at,
					updated_at,
					formularios:formularios ( titulo )
				`,
				)
				.eq('user_id', userId)
				.order('updated_at', { ascending: false })
				.limit(5),
		]);

	if (profileResult.status === 'fulfilled' && !profileResult.value.error) {
		usuario = profileResult.value.data;
	}

	if (companiesResult.status === 'fulfilled') {
		empresas = companiesResult.value;
	}

	if (notificationsResult.status === 'fulfilled') {
		notificationsData = notificationsResult.value;
	}

	if (formsResult.status === 'fulfilled' && !formsResult.value.error) {
		submittedForms = (formsResult.value.data || []) as SubmittedFormRow[];
	}
}

const activeCompany = resolveActiveCompany(
	empresas,
	Astro.cookies.get(ACTIVE_COMPANY_COOKIE)?.value,
);

let documentCount = 0;
let pendingDocumentRequests = 0;

if (activeCompany) {
	const [documentsResult, requestsResult] = await Promise.allSettled([
		getDocumentsForIncorporationCase(
			supabase,
			activeCompany.id,
			userId,
			userRoles,
		),
		getDocumentRequestsForIncorporationCase(supabase, activeCompany.id),
	]);

	if (documentsResult.status === 'fulfilled') {
		documentCount = documentsResult.value.length;
	}

	if (requestsResult.status === 'fulfilled') {
		pendingDocumentRequests = requestsResult.value.filter(
			(request) =>
				!['completed', 'approved', 'signed'].includes(request.status),
		).length;
	}
}

const firstName =
	usuario?.nombre?.trim() ||
	user?.user_metadata?.name?.split(' ')?.[0] ||
	user?.email?.split('@')?.[0] ||
	'Cliente';
// const fullName = [usuario?.nombre, usuario?.apellido]
// 	.filter(Boolean)
// 	.join(' ')
// 	.trim();
const companyName = activeCompany?.nombre || 'tu portal';
const activeCompanies = empresas.filter(
	(company) => company.estado === 'Activo',
);
const inProgressCompanies = empresas.filter((company) =>
	['En proceso', 'Upgrade'].includes(company.estado || ''),
);
const pendingTasks =
	notificationsData.totalUnread +
	inProgressCompanies.length +
	pendingDocumentRequests;

const formatRelativeDate = (dateValue?: string | null) => {
	if (!dateValue) return 'Reciente';

	const date = new Date(dateValue);
	const now = new Date();
	const diffMs = now.getTime() - date.getTime();
	const diffDays = Math.floor(diffMs / 86_400_000);

	if (diffDays <= 0) return 'Hoy';
	if (diffDays === 1) return 'Ayer';
	if (diffDays < 7) return `Hace ${diffDays} dias`;

	return new Intl.DateTimeFormat('es', {
		day: 'numeric',
		month: 'short',
	}).format(date);
};

const activityItems = [
	...notificationsData.notifications.map((notification) => ({
		title: notification.message || 'Nueva notificacion',
		meta: formatRelativeDate(notification.created_at),
		href: notification.link || '/notifications',
		isUnread: !notification.is_read,
	})),
	...submittedForms.map((form) => ({
		title: form.formularios?.titulo || 'Formulario enviado',
		meta: formatRelativeDate(form.submitted_at || form.updated_at),
		href: '/forms/submitted',
		isUnread: false,
	})),
	...empresas.slice(0, 3).map((company) => ({
		title:
			company.estado === 'Activo'
				? `${company.nombre} aprobada`
				: `${company.nombre} en proceso`,
		meta: company.estado_de_incorporacion || company.estado || 'Actualizado',
		href: `/my-companies/${company.id}/dashboard`,
		isUnread: false,
	})),
].slice(0, 5);

const quickActions = [
	{
		title: 'Crea una LLC',
		description: 'Constituye una nueva empresa en minutos.',
		href: '/start/',
		icon: 'ri:building-4-line',
		tone: 'sky',
	},
	{
		title: 'Agendar cita',
		description: 'Reserva una sesion con un asesor.',
		href: '/services',
		icon: 'ri:calendar-event-line',
		tone: 'violet',
	},
	{
		title: 'Mi perfil',
		description: 'Gestiona tu informacion personal.',
		href: '/settings/general',
		icon: 'ri:user-3-line',
		tone: 'emerald',
	},
	{
		title: 'Otros servicios',
		description: 'Explora todo lo que ofrecemos.',
		href: '/services',
		icon: 'ri:apps-2-line',
		tone: 'amber',
	},
] as const;

const stats = [
	{
		label: 'Empresas activas',
		value: activeCompanies.length,
		meta:
			empresas.length === 1
				? '1 empresa registrada'
				: `${empresas.length} empresas registradas`,
		icon: 'ri:building-line',
	},
	{
		label: 'Tareas pendientes',
		value: pendingTasks,
		meta:
			pendingDocumentRequests > 0
				? `${pendingDocumentRequests} documentos requeridos`
				: `${notificationsData.totalUnread} sin leer`,
		icon: 'ri:time-line',
	},
	{
		label: 'Proxima cita',
		value: 'Por agendar',
		meta: 'Reserva cuando estes listo',
		icon: 'ri:calendar-line',
	},
	{
		label: 'Documentos',
		value: documentCount,
		meta: documentCount === 1 ? '1 disponible' : `${documentCount} disponibles`,
		icon: 'ri:file-text-line',
	},
];
---

<section class="mx-auto w-full max-w-7xl px-2 py-8 sm:px-4 lg:px-6">
	<header
		class="flex flex-col gap-5 border-b border-gray-100 pb-8 lg:flex-row lg:items-end lg:justify-between dark:border-gray-800"
	>
		<div class="min-w-0">
			<p
				class="mb-4 text-xs font-semibold tracking-[0.38em] text-gray-400 uppercase dark:text-gray-500"
			>
				Bienvenido de nuevo
			</p>
			<h1
				class="text-4xl font-semibold tracking-normal text-gray-950 sm:text-5xl dark:text-white"
			>
				Hola, {firstName}
			</h1>
			<p class="mt-4 max-w-2xl text-base text-gray-500 dark:text-gray-400">
				Aqui tienes un resumen de tu actividad en
				<span class="font-semibold text-gray-800 dark:text-gray-200">
					{companyName}
				</span>.
			</p>
			<!-- {
				fullName && fullName !== firstName && (
					<p class="mt-2 text-sm text-gray-400 dark:text-gray-500">
						{fullName}
					</p>
				)
			} -->
		</div>

		<a
			href="/start/"
			class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-gray-950 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-gray-800 focus:ring-4 focus:ring-gray-200 focus:outline-none sm:w-auto dark:bg-white dark:text-gray-950 dark:hover:bg-gray-100 dark:focus:ring-gray-700"
		>
			<Icon name="ri:building-4-line" class="h-4 w-4" />
			Ver mi Empresa
		</a>
	</header>

	<div class="grid gap-4 py-10 sm:grid-cols-2 xl:grid-cols-4">
		{
			stats.map((stat) => (
				<article class="group to-black-600 from-black-900 relative min-h-36 rounded-lg border border-gray-200 bg-white p-5 transition hover:border-gray-300 hover:shadow-sm dark:border-gray-800 dark:bg-linear-to-tr dark:hover:border-gray-700">
					<div class="flex items-start justify-between gap-4">
						<p class="text-xs font-semibold tracking-[0.28em] text-gray-400 uppercase dark:text-gray-500">
							{stat.label}
						</p>
						<span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-gray-200 text-gray-400 dark:border-gray-700 dark:text-gray-500">
							<Icon name={stat.icon} class="h-4 w-4" />
						</span>
					</div>
					<div class="mt-8">
						<p class="text-3xl font-semibold text-gray-950 dark:text-white">
							{stat.value}
						</p>
						<p class="mt-2 text-sm font-medium text-gray-500 dark:text-gray-400">
							{stat.meta}
						</p>
					</div>
				</article>
			))
		}
	</div>

	<div class="grid gap-8 xl:grid-cols-[minmax(0,1.45fr)_minmax(320px,0.9fr)]">
		<section>
			<div class="mb-4 flex items-center justify-between gap-4">
				<h2 class="text-lg font-semibold text-gray-950 dark:text-white">
					Acciones rapidas
				</h2>
				<a
					href="/services"
					class="text-sm font-medium text-gray-500 transition hover:text-gray-950 dark:text-gray-400 dark:hover:text-white"
				>
					Ver todo
				</a>
			</div>

			<div class="grid gap-4 md:grid-cols-2">
				{
					quickActions.map((action) => (
						<a
							href={action.href}
							class="to-black-600 from-black-900 group flex min-h-28 items-start gap-4 rounded-lg border border-gray-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-gray-300 hover:shadow-sm focus:ring-4 focus:ring-gray-100 focus:outline-none dark:border-gray-800 dark:bg-linear-to-tr dark:hover:border-gray-700 dark:focus:ring-gray-800"
						>
							<span
								class={`} inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg`}
							>
								<Icon name={action.icon} class="h-5 w-5" />
							</span>
							<span class="min-w-0 flex-1">
								<span class="block font-semibold text-gray-950 dark:text-white">
									{action.title}
								</span>
								<span class="mt-1 block text-sm leading-5 text-gray-500 dark:text-gray-400">
									{action.description}
								</span>
							</span>
							<Icon
								name="ri:arrow-right-up-line"
								class="h-4 w-4 shrink-0 text-gray-400 transition group-hover:text-gray-950 dark:group-hover:text-white"
							/>
						</a>
					))
				}
			</div>
		</section>

		<aside>
			<div class="mb-4 flex items-center justify-between gap-4">
				<h2 class="text-lg font-semibold text-gray-950 dark:text-white">
					Actividad
				</h2>
				<span
					class="inline-flex items-center gap-2 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-300"
				>
					<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
					Activo
				</span>
			</div>

			<div class="divide-y divide-gray-200 dark:divide-gray-800">
				{
					activityItems.length > 0 ? (
						activityItems.map((item) => (
							<a
								href={item.href}
								class="flex items-start gap-3 py-4 transition hover:bg-gray-50 dark:hover:bg-white/3"
							>
								<span
									class={`mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border ${
										item.isUnread
											? 'border-emerald-200 bg-emerald-50 text-emerald-600 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-300'
											: 'dark:bg-black-900 border-gray-200 bg-white text-gray-400 dark:border-gray-700 dark:text-gray-500'
									}`}
								>
									<Icon name="ri:check-line" class="h-4 w-4" />
								</span>
								<span class="min-w-0">
									<span class="block text-sm font-semibold text-gray-900 dark:text-white">
										{item.title}
									</span>
									<span class="mt-1 block text-sm text-gray-500 dark:text-gray-400">
										{item.meta}
									</span>
								</span>
							</a>
						))
					) : (
						<div class="rounded-lg border border-dashed border-gray-200 p-6 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">
							Tu actividad reciente aparecera aqui cuando haya movimientos en tu
							cuenta.
						</div>
					)
				}
			</div>
		</aside>
	</div>
</section>
