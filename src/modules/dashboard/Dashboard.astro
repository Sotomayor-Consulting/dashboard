---
import { Icon } from 'astro-icon/components';

import {
	getEmpresasForSwitcher,
	resolveActiveCompany,
	type EmpresaSwitcherItem,
} from '@domains/companies/companies';
import {
	getDocumentsForIncorporationCase,
	getDocumentRequestsForIncorporationCase,
} from '@domains/documents/document_dashboard';
import { getNotifications } from '@domains/users/notifications';
import { getOrdersByUser } from '@domains/payments/orders';
import { ACTIVE_COMPANY_COOKIE } from '@shared/cookies';

type NotificationRow = {
	id?: string;
	message?: string;
	created_at?: string | null;
	action_url?: string | null;
	read_at?: string | null;
};

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];

let usuario: { nombre?: string | null; apellido?: string | null } | null = null;
let empresas: EmpresaSwitcherItem[] = [];
let notificationsData: {
	notifications: NotificationRow[];
	totalUnread: number;
} = {
	notifications: [],
	totalUnread: 0,
};
let pendingOrdersCount = 0;
if (userId) {
	const [profileResult, companiesResult, notificationsResult, ordersResult] =
		await Promise.allSettled([
			supabase
				.from('usuarios')
				.select('nombre, apellido')
				.eq('user_id', userId)
				.maybeSingle(),
			getEmpresasForSwitcher(supabase, userId),
			getNotifications(supabase, userId),
			getOrdersByUser(supabase, userId),
		]);

	if (profileResult.status === 'fulfilled' && !profileResult.value.error) {
		usuario = profileResult.value.data;
	}

	if (companiesResult.status === 'fulfilled') {
		empresas = companiesResult.value;
	}

	if (notificationsResult.status === 'fulfilled') {
		notificationsData = notificationsResult.value;
	}

	if (ordersResult.status === 'fulfilled') {
		pendingOrdersCount = ordersResult.value.filter(
			(order) => order.status === 'pending_payment',
		).length;
	}
}

const activeCompany = resolveActiveCompany(
	empresas,
	Astro.cookies.get(ACTIVE_COMPANY_COOKIE)?.value,
);

let documentCount = 0;
let pendingDocumentRequests = 0;

if (activeCompany) {
	const [documentsResult, requestsResult] = await Promise.allSettled([
		getDocumentsForIncorporationCase(
			supabase,
			activeCompany.id,
			userId,
			userRoles,
		),
		getDocumentRequestsForIncorporationCase(supabase, activeCompany.id),
	]);

	if (documentsResult.status === 'fulfilled') {
		documentCount = documentsResult.value.length;
	}

	if (requestsResult.status === 'fulfilled') {
		pendingDocumentRequests = requestsResult.value.filter(
			(request) =>
				!['completed', 'approved', 'signed'].includes(request.status),
		).length;
	}
}

const firstName =
	usuario?.nombre?.trim() ||
	user?.user_metadata?.name?.split(' ')?.[0] ||
	user?.email?.split('@')?.[0] ||
	'Cliente';
// const fullName = [usuario?.nombre, usuario?.apellido]
// 	.filter(Boolean)
// 	.join(' ')
// 	.trim();
const companyName = activeCompany?.nombre || 'tu portal';
const activeCompanies = empresas.filter(
	(company) => company.estado === 'active',
);
const inProgressCompanies = empresas.filter((company) =>
	['draft', 'upgrade'].includes(company.estado || ''),
);
const pendingTasks =
	notificationsData.totalUnread +
	inProgressCompanies.length +
	pendingDocumentRequests;

const formatRelativeDate = (dateValue?: string | null) => {
	if (!dateValue) return 'Reciente';

	const date = new Date(dateValue);
	const now = new Date();
	const diffMs = now.getTime() - date.getTime();
	const diffDays = Math.floor(diffMs / 86_400_000);

	if (diffDays <= 0) return 'Hoy';
	if (diffDays === 1) return 'Ayer';
	if (diffDays < 7) return `Hace ${diffDays} días`;

	return new Intl.DateTimeFormat('es', {
		day: 'numeric',
		month: 'short',
	}).format(date);
};

const activityItems = [
	...notificationsData.notifications.map((notification) => ({
		title: notification.message || 'Nueva notificación',
		meta: formatRelativeDate(notification.created_at),
		href: notification.action_url || '/notifications',
		isUnread: !notification.read_at,
	})),
	...empresas.slice(0, 3).map((company) => ({
		title:
			company.estado === 'active'
				? `${company.nombre} aprobada`
				: `${company.nombre} en proceso`,
		meta: company.estado_de_incorporacion || company.estado || 'Actualizado',
		href: company.incorporation_id
			? `/incorporation/${company.incorporation_id}`
			: `/company/${company.company_id}`,
		isUnread: false,
	})),
].slice(0, 5);

const quickActions = [
	{
		title: 'Crea una LLC',
		description: 'Constituye una nueva empresa en minutos.',
		href: '/start/',
		icon: 'ri:building-4-line',
		tone: 'sky',
	},
	{
		title: 'Agendar cita',
		description: 'Reserva una sesión con un asesor.',
		href: '/services',
		icon: 'ri:calendar-event-line',
		tone: 'violet',
	},
	{
		title: 'Mi perfil',
		description: 'Gestiona tu información personal.',
		href: '/profile/general',
		icon: 'ri:user-3-line',
		tone: 'emerald',
	},
	{
		title: 'Otros servicios',
		description: 'Explora todo lo que ofrecemos.',
		href: '/services',
		icon: 'ri:apps-2-line',
		tone: 'amber',
	},
] as const;

const stats: {
	label: string;
	value: string | number;
	meta: string;
	icon: string;
	href?: string;
}[] = [
	{
		label: 'Empresas activas',
		value: activeCompanies.length,
		meta:
			empresas.length === 1
				? '1 empresa registrada'
				: `${empresas.length} empresas registradas`,
		icon: 'ri:building-line',
		href: '/incorporation/',
	},
	{
		label: 'Tareas pendientes',
		value: pendingTasks,
		meta:
			pendingDocumentRequests > 0
				? `${pendingDocumentRequests} documentos requeridos`
				: `${notificationsData.totalUnread} sin leer`,
		icon: 'ri:time-line',
		href: '/notifications',
	},
	{
		label: 'Pagos pendientes',
		value: pendingOrdersCount,
		meta:
			pendingOrdersCount > 0 ? 'Completa el pago en Órdenes' : 'Estás al día',
		icon: 'ri:bank-card-line',
		href: '/orders/',
	},
	{
		label: 'Documentos',
		value: documentCount,
		meta: documentCount === 1 ? '1 disponible' : `${documentCount} disponibles`,
		icon: 'ri:file-text-line',
	},
];
---

<section class="mx-auto w-full max-w-7xl px-2 py-8 sm:px-4 lg:px-6">
	<header
		class="border-border flex flex-col gap-5 border-b pb-8 lg:flex-row lg:items-end lg:justify-between"
	>
		<div class="min-w-0">
			<p class="kicker mb-4 tracking-[0.38em]">Bienvenido de nuevo</p>
			<h1
				class="text-foreground text-4xl font-semibold tracking-normal sm:text-5xl"
			>
				Hola, {firstName}
			</h1>
			<p class="text-muted-foreground mt-4 max-w-2xl text-base">
				Aquí tienes un resumen de tu actividad en
				<span class="text-foreground font-semibold">
					{` ${companyName}`}
				</span>.
			</p>
		</div>

		<a
			href={activeCompany
				? activeCompany.incorporation_id
					? `/incorporation/${activeCompany.incorporation_id}`
					: `/company/${activeCompany.company_id}`
				: '/start/'}
			class="bg-foreground text-background hover:bg-foreground/90 focus:ring-ring inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-semibold shadow-sm transition focus:ring-4 focus:outline-none sm:w-auto"
		>
			<Icon name="ri:building-4-line" class="h-4 w-4" />
			{activeCompany ? 'Ver mi empresa' : 'Crear mi LLC'}
		</a>
	</header>

	<div class="grid gap-4 py-10 sm:grid-cols-2 xl:grid-cols-4">
		{
			stats.map((stat) => {
				const Tag = stat.href ? 'a' : 'article';
				return (
					<Tag
						href={stat.href}
						class="group border-border hover:border-accent-gold relative block min-h-36 rounded-lg border p-5 transition hover:shadow-sm"
					>
						<div class="flex items-start justify-between gap-4">
							<p class="kicker tracking-[0.12em] sm:tracking-[0.28em]">
								{stat.label}
							</p>
							<span class="border-border text-muted-foreground inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border">
								<Icon name={stat.icon} class="text-accent-gold h-4 w-4" />
							</span>
						</div>
						<div class="mt-8">
							<p class="stat-value text-3xl">{stat.value}</p>
							<p class="stat-label mt-2 text-sm font-medium">{stat.meta}</p>
						</div>
					</Tag>
				);
			})
		}
	</div>

	<div class="grid gap-8 xl:grid-cols-[minmax(0,1.45fr)_minmax(320px,0.9fr)]">
		<section>
			<div class="mb-4 flex items-center justify-between gap-4">
				<h2 class="section-title">Acciones rápidas</h2>
				<a
					href="/services"
					class="text-muted-foreground hover:text-foreground text-sm font-medium transition"
				>
					Ver todo
				</a>
			</div>

			<div class="grid gap-4 md:grid-cols-2">
				{
					quickActions.map((action) => (
						<a
							href={action.href}
							class="group border-border hover:border-accent-gold/50 focus:ring-ring flex min-h-28 items-start gap-4 rounded-lg border p-5 transition hover:-translate-y-0.5 hover:shadow-sm focus:ring-4 focus:outline-none"
						>
							<span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-lg">
								<Icon name={action.icon} class="text-accent-gold h-5 w-5" />
							</span>
							<span class="min-w-0 flex-1">
								<span class="text-foreground block font-semibold">
									{action.title}
								</span>
								<span class="text-muted-foreground mt-1 block text-sm leading-5">
									{action.description}
								</span>
							</span>
							<Icon
								name="ri:arrow-right-up-line"
								class="text-muted-foreground group-hover:text-foreground h-4 w-4 shrink-0 transition"
							/>
						</a>
					))
				}
			</div>
		</section>

		<aside>
			<div class="mb-4 flex items-center justify-between gap-4">
				<h2 class="section-title">Actividad</h2>
				<span
					class="badge-status bg-emerald-100 text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-300"
				>
					<span class="mr-1.5 h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
					Activo
				</span>
			</div>

			<div class="divide-border divide-y">
				{
					activityItems.length > 0 ? (
						activityItems.map((item) => (
							<a
								href={item.href}
								class="hover:bg-muted/50 flex items-start gap-3 py-4 transition"
							>
								<span
									class={`mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border ${
										item.isUnread
											? 'border-emerald-200 bg-emerald-50 text-emerald-600 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-300'
											: 'border-border bg-card text-muted-foreground'
									}`}
								>
									<Icon name="ri:check-line" class="h-4 w-4" />
								</span>
								<span class="min-w-0">
									<span class="text-foreground block text-sm font-semibold">
										{item.title}
									</span>
									<span class="text-muted-foreground mt-1 block text-sm">
										{item.meta}
									</span>
								</span>
							</a>
						))
					) : (
						<div class="border-border text-muted-foreground rounded-lg border border-dashed p-6 text-sm">
							Tu actividad reciente aparecerá aquí cuando haya movimientos en tu
							cuenta.
						</div>
					)
				}
			</div>
		</aside>
	</div>
</section>
