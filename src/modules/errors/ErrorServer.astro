---
import { asset, url } from '@shared/data.js';
---

<div
	class="mx-auto flex h-screen flex-col items-center justify-center px-6 xl:px-0 dark:bg-gray-900"
>
	<div class="block md:max-w-lg">
		<img src={asset('images/illustrations/500.svg')} alt="astronaut image" />
	</div>
	<div class="text-center xl:max-w-4xl">
		<h1
			class="mb-3 text-2xl leading-tight font-bold text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
		>
			Something has gone seriously wrong
		</h1>
		<p
			class="mb-5 text-base font-normal text-gray-500 md:text-lg dark:text-gray-400"
		>
			It's always time for a coffee break. We should be back by the time you
			finish your coffee.
		</p>
		<a
			href={url('')}
			class="hover:bg-primary-800 focus:ring-primary-300 dark:focus:ring-primary-800 mr-3 inline-flex items-center rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
		>
			<svg
				class="mr-2 -ml-1 h-5 w-5"
				fill="currentColor"
				viewBox="0 0 20 20"
				xmlns="http://www.w3.org/2000/svg"
				><path
					fill-rule="evenodd"
					d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
					clip-rule="evenodd"></path></svg
			>
			Go back home
		</a>
	</div>
</div>
