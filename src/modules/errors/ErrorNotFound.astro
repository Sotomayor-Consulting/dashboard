---
import { Icon } from 'astro-icon/components';
---

<section
	class="mx-auto flex min-h-screen max-w-4xl flex-col items-center justify-center px-6 py-16 text-center xl:px-0"
>
	<div
		class="mb-10 flex w-full max-w-md items-center justify-center"
		aria-hidden="true"
	>
		<Icon
			name="undraw_plug-in_hy0z"
			class="h-auto w-full max-w-xs text-gray-900 dark:text-white"
		/>
	</div>

	<p
		class="mb-4 text-xs font-semibold tracking-[0.38em] text-gray-400 uppercase dark:text-gray-500"
	>
		Error 404
	</p>
	<h1
		class="mb-3 text-3xl leading-tight font-bold text-gray-900 sm:text-4xl lg:text-5xl dark:text-white"
	>
		No se encontró esta pagina
	</h1>
	<p
		class="mb-6 max-w-2xl text-base text-gray-500 md:text-lg dark:text-gray-400"
	>
		Parece que seguiste un enlace incorrecto. Si crees que esto es un problema
		con nosotros, por favor avísanos.
	</p>
	<a
		href="/"
		class="focus:ring-primary-300 dark:hover:bg-white-200 inline-flex items-center rounded-lg bg-black px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-neutral-900 focus:ring-4 focus:outline-none dark:bg-white dark:text-black dark:focus:ring-white"
	>
		<Icon name="ri:arrow-left-line" class="mr-2 -ml-1 h-5 w-5" />
		Regresar
	</a>
</section>
