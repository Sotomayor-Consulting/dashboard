---
import { createSupabaseServerClient } from '@lib/supabase';
import PictureUploader from '@components/forms/PictureUploader.astro';
import PersonalInfoForm from './components/PersonalInfoForm.astro';
import BillingForm from './components/BillingForm.astro';

// Auth handled by middleware
const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

let testRow = null;
if (user) {
	const { data } = await supabase
		.from('usuarios')
		.select(
			'nombre, apellido, pais_id, ciudad, direccion_linea1, direccion_linea2, telf, fecha_nacimiento, organizacion, cargo, departamento, codigo_postal, tipo_identificacion, numero_de_identificacion, tipo_persona, user_id',
		)
		.eq('user_id', user.id)
		.single();
	testRow = data;
}

const { data: paises } = await supabase
	.from('paises')
	.select('id, iso, nombre_paises, codigo_telf')
	.order('nombre_paises');

const { data: facturacion } = await supabase
	.from('datos_facturacion')
	.select('*')
	.eq('user_id', user?.id)
	.single();

const email = user?.email;
---

<div class="grid grid-cols-1 px-4 pt-6 xl:grid-cols-3 xl:gap-4">
	<div class="col-span-full mb-4 xl:mb-2">
		<nav class="mb-5 flex" aria-label="Breadcrumb">
			<ol
				class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
			>
				<li class="inline-flex items-center">
					<a
						href="/"
						class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
					>
						<svg
							class="mr-2.5 h-5 w-5"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
							></path></svg
						>
						Inicio
					</a>
				</li>

				<li>
					<div class="flex items-center">
						<svg
							class="h-6 w-6 text-gray-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						<span
							class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500"
							aria-current="page">Configuración</span
						>
					</div>
				</li>
			</ol>
		</nav>
		<h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
			Configuraciones de usuario
		</h1>
	</div>
	<!-- Right Content -->
	<div class="col-span-full xl:col-auto">
		<div
			class="mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700 dark:bg-[#192033]"
		>
			<div
				class="items-center sm:flex sm:space-x-4 xl:block xl:space-x-0 2xl:flex 2xl:space-x-4"
			>
				<PictureUploader title="Foto de perfil" />
			</div>
		</div>
		<div
			class="mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700 dark:bg-[#192033]"
		>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">Rol de cuenta</h3>
			<div class="mb-4">
				<label
					for=""
					class="block w-full cursor-not-allowed rounded-lg border border-gray-300 bg-neutral-200 p-2.5 text-gray-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-gray-600 dark:bg-[#101521] dark:text-white dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
					>{email}</label
				>
			</div>

			<div>
				<a
					href="/"
					class="focus:ring-primary-300 rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
					>Promover a cuenta de asociado</a
				>
			</div>
		</div>
		<div
			class="mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700 dark:bg-[#192033]"
		>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">
				Canjear codigo de Referido
			</h3>
			<form action="/api/partners_code/code_canje" method="POST">
				<div class="mb-4">
					<input
						type="text"
						name="code"
						class="block w-full rounded-lg border border-gray-300 bg-neutral-200 p-2.5 text-gray-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-gray-600 dark:bg-[#101521] dark:text-white dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
						placeholder="Ejemplo: 9F2A7C4B"
					/>
				</div>

				<div>
					<button
						type="submit"
						class="focus:ring-primary-300 rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
						>Canjear</button
					>
				</div>
			</form>
		</div>
	</div>
	<div class="col-span-2">
			<PersonalInfoForm usuario={testRow} paises={paises} email={email} />
			<BillingForm facturacion={facturacion} paises={paises} />
	</div>
</div>
