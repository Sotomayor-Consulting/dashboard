---
import { createSupabaseServerClient } from '@lib/supabase';
import PictureUploader from '@components/forms/PictureUploader.astro';
import PersonalInfoForm from './components/PersonalInfoForm.astro';
import UserAccountPanel from './components/UserAccountPanel.astro';
import BillingForm from './components/BillingForm.astro';

// Auth handled by middleware
const user = Astro.locals.user;
const supabase = createSupabaseServerClient(Astro);

let testRow = null;
if (user) {
	const { data } = await supabase
		.from('usuarios')
		.select(
			'nombre, apellido, pais_id, ciudad, direccion_linea1, direccion_linea2, telf, fecha_nacimiento, organizacion, cargo, departamento, codigo_postal, tipo_identificacion, numero_de_identificacion, tipo_persona, user_id',
		)
		.eq('user_id', user.id)
		.single();
	testRow = data;
}

const { data: paises } = await supabase
	.from('paises')
	.select('id, iso, nombre_paises, codigo_telf')
	.order('nombre_paises');

const { data: facturacion } = await supabase
	.from('datos_facturacion')
	.select('*')
	.eq('user_id', user?.id)
	.single();

const email = user?.email;
---

<div class="grid grid-cols-1 px-4 pt-6 xl:grid-cols-3 xl:gap-4">
	<div class="col-span-full mb-4 xl:mb-2">
		<nav class="mb-5 flex" aria-label="Breadcrumb">
			<ol
				class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
			>
				<li class="inline-flex items-center">
					<a
						href="/"
						class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
					>
						<svg
							class="mr-2.5 h-5 w-5"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
							></path></svg
						>
						Inicio
					</a>
				</li>
				<li>
					<div class="flex items-center">
						<svg
							class="h-6 w-6 text-gray-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						<span
							class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500"
							aria-current="page">Configuración</span
						>
					</div>
				</li>
			</ol>
		</nav>
		<h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
			Configuraciones de usuario
		</h1>
	</div>
	<UserAccountPanel email={email} />
	<div class="col-span-2">
			<PersonalInfoForm usuario={testRow} paises={paises} email={email} />
			<BillingForm facturacion={facturacion} paises={paises} />
	</div>
</div>
