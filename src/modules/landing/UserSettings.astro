---
import PersonalInfoForm from './components/PersonalInfoForm.astro';
import UserAccountPanel from './components/UserAccountPanel.astro';
import BillingForm from './components/BillingForm.astro';
import { getUsuarioById } from '@domains/users/users';
import { PaisesGeneral } from '@domains/utils/generals/countries-list';
import { getAllBillingInfo } from '@domains/users/billing';

interface Props {
	section?: 'account' | 'general' | 'billing';
}

const { section = 'account' } = Astro.props as Props;

const user = Astro.locals.user;
const userId = user?.id ?? '';
const supabase = Astro.locals.supabase;

const sectionTitles: Record<string, string> = {
	account: 'Perfil',
	general: 'Información general',
	billing: 'Datos de facturación',
};

const sectionDescriptions: Record<string, string> = {
	account: 'Gestiona tu información personal y cuenta.',
	general: 'Completa tus datos personales y de contacto.',
	billing: 'Administra tus datos de facturación.',
};

const needsUser = section === 'general';
const needsBilling = section === 'billing';
const needsPaises = needsUser || needsBilling;

const [testRow, paises, billingAddresses] = await Promise.all([
	needsUser ? getUsuarioById(supabase, userId) : Promise.resolve(null),
	needsPaises ? PaisesGeneral(supabase) : Promise.resolve(null),
	needsBilling ? getAllBillingInfo(supabase, userId) : Promise.resolve([]),
]);

const email = user?.email ?? undefined;
---

<div class="mx-auto max-w-3xl px-4 pt-6 pb-12">
	<div class="section-header mb-8">
		<h1 class="section-title text-xl">{sectionTitles[section]}</h1>
		<p class="section-description">{sectionDescriptions[section]}</p>
	</div>

	{section === 'account' && <UserAccountPanel email={email} />}

	{section === 'general' && (
		<PersonalInfoForm usuario={testRow} paises={paises} email={email} />
	)}

	{section === 'billing' && (
		<BillingForm addresses={billingAddresses ?? []} paises={paises} userId={userId} />
	)}
</div>
