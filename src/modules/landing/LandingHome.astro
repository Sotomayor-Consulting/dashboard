---
import { Icon } from 'astro-icon/components';
import MenuCard from '@components/display/MenuCard.astro';
import { getUserWithRole } from '@lib/tablas/menu';
import { getFormulariosPendientes } from '@lib/tablas/formulariosEnviados';
import { getPagosPorLeer } from '@lib/tablas/PagosPorLeer';
import { menuItems } from '@lib/interfaz/itemsNavegacion';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;

const [userData, formularioData] = await Promise.all([
	getUserWithRole(supabase, userId),
	getFormulariosPendientes(supabase),
]);

const { role: userRole, roles: userRoles } = userData;
const { count: formularioPendientesCount } = formularioData;

const { count: pagosCount } = await getPagosPorLeer(supabase, userRole);

const visibleMenu = menuItems.filter(
	(item) =>
		(item.roles.includes('all') && userRoles.length > 0) ||
		item.roles.includes('todos') ||
		item.roles.some((r) => userRoles.includes(r)),
);
---

<div
	class="bg-neutral-200 dark:bg-black-900 dark:text-slate-100 p-4 lg:p-16 h-full mb-20 mt-10"
>
	<header
		class="p-8 flex justify-center items-center flex-wrap flex-col w-full mt-5"
	>
		<div class="flex justify-center w-full">
			<Icon name="logo-en-negro" class="dark:hidden block text-5xl" />
			<Icon name="logo-en-blanco" class="hidden dark:block text-5xl" />
		</div>
	</header>

	<article class="flex justify-center pt-20 pb-32 h-full">
		<div
			class="grid grid-flow-row grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 md:gap-10 gap-y-10"
		>
			{
				visibleMenu &&
					visibleMenu.map((item) => (
						<MenuCard
							href={item.href}
							label={item.label}
							tooltipId={item.id}
							tooltipText={item.tooltip}
							badge={
								item.id === 'verificacion-formulario-incorp' &&
								formularioPendientesCount > 0
									? formularioPendientesCount
									: item.id === 'menu-vista-de-pagos' && pagosCount > 0
										? pagosCount
										: null
							}
						>
							<Icon
								name={item.svgname}
								class="text-5xl"
								aria-label={item.label}
								title={item.label}
							/>
						</MenuCard>
					))
			}
		</div>
	</article>
</div>
