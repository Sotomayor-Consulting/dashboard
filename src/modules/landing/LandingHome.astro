---
import ClientOnboarding from '@modules/onboarding/ClientOnboarding.astro';
import DashBoard from '@modules/dashboard/Dashboard.astro';
import OpsDashboard from '@modules/dashboard/OpsDashboard.astro';
import { getUserWithRole } from '@domains/users/menu';
import { getEmpresasForSwitcher } from '@domains/companies/companies';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;

const [userData, empresasSwitcher] = await Promise.all([
	getUserWithRole(supabase, userId),
	getEmpresasForSwitcher(supabase, userId ?? ''),
]);

const { roles: userRoles } = userData;
const userName = user?.user_metadata?.name ?? user?.email ?? 'Usuario';
const hasCompanies = empresasSwitcher.length > 0;
const isNewClient = userRoles.includes('cliente') && !hasCompanies;

// El staff (admin/operaciones) ve el panel operativo: incorporaciones en
// curso y pagos de clientes, no el resumen personal de un cliente.
const isStaff =
	userRoles.includes('admin') || userRoles.includes('operaciones');
---

{
	isStaff ? (
		<OpsDashboard />
	) : isNewClient ? (
		<ClientOnboarding userName={userName} />
	) : (
		<DashBoard />
	)
}
