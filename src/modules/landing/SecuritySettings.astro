---
import FormInput from '@components/forms/FormInput.astro';
---

<div class="mx-auto max-w-3xl px-4 pt-6 pb-12">
	<div class="section-header mb-8">
		<h1 class="section-title text-xl">Seguridad</h1>
		<p class="section-description">Gestiona tu contraseña y la seguridad de tu cuenta.</p>
	</div>

	<form method="post" action="/api/auth/reset-password">
		<div class="divide-y divide-border">
			<!-- Contraseña -->
			<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 first:pt-0 sm:grid-cols-[220px_1fr]">
				<div>
					<h3 class="text-sm font-medium text-foreground">Contraseña</h3>
					<p class="mt-1 text-sm text-muted-foreground">Confirma tu contraseña actual antes de establecer una nueva.</p>
				</div>
				<div class="space-y-4">
					<FormInput
						label=""
						name="current_password"
						type="text"
						placeholder="Contraseña actual"
						required
						class="w-full"
					/>
					<FormInput
						label=""
						name="new_password"
						type="text"
						placeholder="Nueva contraseña"
						required
						class="w-full"
					/>
				</div>
			</div>
		</div>

		<!-- Save button -->
		<div class="flex justify-end border-t border-border pt-6">
			<button
				type="submit"
				class="btn-primary"
			>
				Actualizar contraseña
			</button>
		</div>
	</form>
</div>
