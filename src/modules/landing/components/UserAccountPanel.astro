---
import PictureUploader from '@components/forms/PictureUploader.astro';

interface Props {
	email?: string | undefined;
	promoteHref?: string;
	referralAction?: string;
}

const {
	email = '',
	promoteHref = '/',
	referralAction = '/api/partners/redeem-code',
} = Astro.props as Props;
---

<div class="col-span-full xl:col-auto">
	<div class="flat-card-padded mb-4 sm:p-6 2xl:col-span-2">
		<div
			class="items-center sm:flex sm:space-x-4 xl:block xl:space-x-0 2xl:flex 2xl:space-x-4"
		>
			<PictureUploader title="Foto de perfil" />
		</div>
	</div>

	<div class="flat-card-padded mb-4 sm:p-6 2xl:col-span-2">
		<h3 class="section-title mb-4">Rol de cuenta</h3>
		<div class="mb-4">
			<p
				class="block w-full cursor-not-allowed rounded-lg border border-border bg-card p-2.5 text-foreground shadow-sm sm:text-sm"
			>
				{email}
			</p>
		</div>

		<div>
			<a
				href={promoteHref}
				class="rounded-lg bg-accent-gold px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-accent-gold/80 focus:ring-4 focus:ring-accent-gold/30"
			>
				Promover a cuenta de asociado
			</a>
		</div>
	</div>

	<div class="flat-card-padded mb-4 sm:p-6 2xl:col-span-2">
		<h3 class="section-title mb-4">
			Canjear código de Referido
		</h3>

		<form action={referralAction} method="POST">
			<div class="mb-4">
				<input
					type="text"
					name="code"
					class="block w-full rounded-lg border border-border bg-card p-2.5 text-foreground shadow-sm placeholder:text-muted-foreground focus:border-accent-gold focus:ring-accent-gold sm:text-sm"
					placeholder="Ejemplo: 9F2A7C4B"
				/>
			</div>

			<div>
				<button
					type="submit"
					class="cursor-pointer rounded-lg bg-accent-gold px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-accent-gold/80 focus:ring-4 focus:ring-accent-gold/30"
				>
					Canjear
				</button>
			</div>
		</form>
	</div>
</div>
