---
import PictureUploader from '@components/forms/PictureUploader.astro';

interface Props {
	email?: string | undefined;
	promoteHref?: string;
	referralAction?: string;
}

const {
	email = '',
	promoteHref = '/',
	referralAction = '/api/partners/redeem-code',
} = Astro.props as Props;
---

<div class="divide-y divide-border">
	<!-- Avatar -->
	<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 first:pt-0 sm:grid-cols-[220px_1fr]">
		<div>
			<h3 class="text-sm font-medium text-foreground">Foto de perfil</h3>
			<p class="mt-1 text-sm text-muted-foreground">JPG, PNG o WEBP. Máx 5 MB.</p>
		</div>
		<div class="flex items-center gap-6">
			<PictureUploader title="" />
		</div>
	</div>

	<!-- Rol de cuenta -->
	<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[220px_1fr]">
		<div>
			<h3 class="text-sm font-medium text-foreground">Rol de cuenta</h3>
			<p class="mt-1 text-sm text-muted-foreground">Tu correo vinculado a la cuenta.</p>
		</div>
		<div class="space-y-4">
			<p class="block w-full rounded-lg border border-border bg-muted/40 px-3 py-2.5 text-sm text-foreground">
				{email}
			</p>
			<a
				href={promoteHref}
				class="btn-outline"
			>
				Promover a cuenta de asociado
			</a>
		</div>
	</div>

	<!-- Código de referido -->
	<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[220px_1fr]">
		<div>
			<h3 class="text-sm font-medium text-foreground">Código de referido</h3>
			<p class="mt-1 text-sm text-muted-foreground">Ingresa un código para vincular tu cuenta.</p>
		</div>
		<form action={referralAction} method="POST" class="space-y-4">
			<input
				type="text"
				name="code"
				class="block w-full rounded-lg border border-border bg-transparent px-3 py-2.5 text-sm text-foreground placeholder:text-muted-foreground transition focus:border-accent-gold focus:ring-accent-gold"
				placeholder="Ejemplo: 9F2A7C4B"
			/>
			<button
				type="submit"
				class="btn-primary"
			>
				Canjear
			</button>
		</form>
	</div>
</div>
