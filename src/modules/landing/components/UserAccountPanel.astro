---
import PictureUploader from '@components/forms/PictureUploader.astro';

interface Props {
    email?: string | null;
    promoteHref?: string;
    referralAction?: string;
}

const {
    email = '',
    promoteHref = '/',
    referralAction = '/api/partners_code/code_canje',
} = Astro.props as Props;
---

<div class="col-span-full xl:col-auto">
    <div
        class="mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700 dark:bg-[#192033]"
    >
        <div
            class="items-center sm:flex sm:space-x-4 xl:block xl:space-x-0 2xl:flex 2xl:space-x-4"
        >
            <PictureUploader title="Foto de perfil" />
        </div>
    </div>

    <div
        class="mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700 dark:bg-[#192033]"
    >
        <h3 class="mb-4 text-xl font-semibold dark:text-white">Rol de cuenta</h3>
        <div class="mb-4">
            <p
                class="block w-full cursor-not-allowed rounded-lg border border-gray-300 bg-neutral-200 p-2.5 text-gray-900 shadow-sm sm:text-sm dark:border-gray-600 dark:bg-[#101521] dark:text-white"
            >
                {email}
            </p>
        </div>

        <div>
            <a
                href={promoteHref}
                class="focus:ring-primary-300 rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
            >
                Promover a cuenta de asociado
            </a>
        </div>
    </div>

    <div
        class="mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700 dark:bg-[#192033]"
    >
        <h3 class="mb-4 text-xl font-semibold dark:text-white">
            Canjear codigo de Referido
        </h3>

        <form action={referralAction} method="POST">
            <div class="mb-4">
                <input
                    type="text"
                    name="code"
                    class="block w-full rounded-lg border border-gray-300 bg-neutral-200 p-2.5 text-gray-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-gray-600 dark:bg-[#101521] dark:text-white dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
                    placeholder="Ejemplo: 9F2A7C4B"
                />
            </div>

            <div>
                <button
                    type="submit"
                    class="focus:ring-primary-300 rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
                >
                    Canjear
                </button>
            </div>
        </form>
    </div>
</div>