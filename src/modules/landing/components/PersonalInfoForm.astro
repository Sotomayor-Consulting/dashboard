---
import FormInput from '../../../components/forms/FormInput.astro';
import FormPhoneInput from '../../../components/forms/FormPhoneInput.astro';
import FormSelect from '../../../components/forms/FormSelect.astro';

interface PaisRow {
	id: number;
	iso: string;
	nombre_paises: string;
	codigo_telf: string;
}

interface UsuarioRow {
	nombre?: string | null;
	apellido?: string | null;
	pais_id?: number | null;
	ciudad?: string | null;
	direccion_linea1?: string | null;
	direccion_linea2?: string | null;
	telf?: string | null;
	fecha_nacimiento?: string | null;
	organizacion?: string | null;
	cargo?: string | null;
	departamento?: string | null;
	codigo_postal?: string | null;
	tipo_identificacion?: string | null;
	numero_de_identificacion?: string | null;
	tipo_persona?: string | null;
	user_id?: string | null;
}

interface Props {
	usuario?: UsuarioRow | null | undefined;
	paises?: PaisRow[] | null | undefined;
	email?: string | undefined;
}

type Option = {
	value: string;
	label: string;
};

const documentTypeOptions: Option[] = [
	{ value: 'Cédula', label: 'Cédula' },
	{ value: 'RUC', label: 'RUC' },
	{ value: 'ID', label: 'ID' },
	{ value: 'Pasaporte', label: 'Pasaporte' },
	{ value: 'EIN', label: 'EIN' },
];

const personTypeOptions: Option[] = [
	{ value: 'Natural', label: 'Natural' },
	{ value: 'Jurídica', label: 'Jurídica' },
];

const { usuario, paises, email } = Astro.props;

const countryOptions: Option[] = (paises ?? []).map((p) => ({
	value: String(p.id),
	label: p.nombre_paises,
}));
const selectedCountry = usuario?.pais_id ? String(usuario.pais_id) : '';
---

<div
	class="dark:bg-black-800 mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700"
>
	<h3 class="mb-4 text-xl font-semibold dark:text-white">
		Información General
	</h3>
	<form
		id="personal-info-form"
		method="post"
		action="/api/update/update-profile"
	>
		<div class="grid grid-cols-6 gap-6">
			<!-- Nombre / Apellido -->
			<FormInput
				label="Nombre"
				name="nombre"
				value={usuario?.nombre ?? ''}
				placeholder="Juan"
			/>
			<FormInput
				label="Apellido"
				name="apellido"
				value={usuario?.apellido ?? ''}
				placeholder="Green"
			/>
			<!-- País / Ciudad -->
			<FormSelect
				label="País"
				name="pais"
				value={selectedCountry}
				options={countryOptions}
				placeholder="Seleccione un país"
			/>
			<FormInput
				label="Ciudad"
				name="ciudad"
				value={usuario?.ciudad ?? ''}
				placeholder="ejem. San Francisco"
			/>
			<!-- Dirección línea 1 / Dirección línea 2 -->
			<FormInput
				label="Dirección línea 1"
				name="direccion"
				value={usuario?.direccion_linea1 ?? ''}
				placeholder="ejem. Av. Juan Molineros"
			/>
			<FormInput
				label="Dirección línea 2"
				name="direccion2"
				value={usuario?.direccion_linea2 ?? ''}
				placeholder="ejem. y De los Guayacanes"
			/>

			<!-- Tipo de documento / Número de identificación -->
			<FormSelect
				label="Tipo de documento"
				name="tipo_de_documento"
				value={usuario?.tipo_identificacion ?? ''}
				options={documentTypeOptions}
				placeholder="Seleccione un tipo de documento"
			/>
			<FormInput
				label="Número de identificación"
				name="Numero_de_identificacion"
				value={usuario?.numero_de_identificacion ?? ''}
				placeholder="1777745898"
			/>

			<!-- Tipo de persona / Email -->
			<FormSelect
				label="Tipo de persona"
				name="tipo_de_persona"
				value={usuario?.tipo_persona ?? ''}
				options={personTypeOptions}
				placeholder="Seleccione el tipo de persona"
			/>
			<FormInput label="Email" name="email" value={email ?? ''} disabled />

			<!-- Teléfono / Fecha de nacimiento -->
			<FormPhoneInput
				label="Número de teléfono"
				name="telefono"
				value={usuario?.telf ?? ''}
				initialCountry="us"
			/>
			<FormInput
				label="Fecha de nacimiento"
				name="fecha_nacimiento"
				type="date"
				value={usuario?.fecha_nacimiento ?? ''}
			/>
			<!-- Organización / Cargo -->
			<FormInput
				label="Organización a la que pertenece"
				name="organizacion"
				value={usuario?.organizacion ?? ''}
				placeholder="Ejem. Sotomayor Consulting Ecuador"
			/>
			<FormInput
				label="Cargo"
				name="cargo"
				value={usuario?.cargo ?? ''}
				placeholder="Ejem. Gerente General"
			/>

			<!-- Departamento / Código Postal -->
			<FormInput
				label="Departamento"
				name="departamento"
				value={usuario?.departamento ?? ''}
				placeholder="Development"
			/>
			<FormInput
				label="Código Postal"
				name="codigo_postal"
				value={usuario?.codigo_postal ?? ''}
				placeholder="123456"
			/>
			<!-- Botón guardar -->
			<div class="sm:col-full col-span-6">
				<button
					type="submit"
					class="focus:ring-primary-300 bg-black-600 hover:bg-black-500 dark:bg-black-400 dark:hover:bg-black-400/80 cursor-pointer rounded-lg px-5 py-2.5 text-center text-sm font-medium text-white focus:ring-4 dark:focus:ring-[#323f67]"
				>
					Guardar
				</button>
			</div>
		</div>
	</form>
</div>

<script>
	import { personalInfoSchema } from '@lib/schemas/personalInfo.schema';
	import {
		validateFormData,
		formDataToObject,
	} from '@lib/validation/formValidator';

	function initPersonalInfoValidation() {
		const form = document.getElementById(
			'personal-info-form',
		) as HTMLFormElement | null;
		if (!form) return;

		form.addEventListener('submit', (e) => {
			clearErrors(form);

			const formData = new FormData(form);
			const data = formDataToObject(formData);
			const result = validateFormData(personalInfoSchema, data);

			if (!result.success) {
				e.preventDefault();
				showErrors(form, result.fieldErrors);
				scrollToFirstError(form);
			}
		});

		// Limpiar error individual al escribir/cambiar
		form.addEventListener('input', (e) => {
			const target = e.target as HTMLElement;
			const fieldName = target.getAttribute('name') || target.dataset.field;
			if (fieldName) clearFieldError(form, fieldName);
		});
		form.addEventListener('change', (e) => {
			const target = e.target as HTMLElement;
			const fieldName = target.getAttribute('name') || target.dataset.field;
			if (fieldName) clearFieldError(form, fieldName);
		});
	}

	function showErrors(
		form: HTMLFormElement,
		fieldErrors: Record<string, string[]>,
	) {
		for (const [field, messages] of Object.entries(fieldErrors)) {
			const errorEl = form.querySelector(
				`[data-error="${field}"]`,
			) as HTMLElement | null;
			const inputEl = form.querySelector(
				`[data-field="${field}"]`,
			) as HTMLElement | null;

			if (errorEl) {
				errorEl.textContent = messages[0];
				errorEl.classList.remove('hidden');
			}
			if (inputEl) {
				inputEl.classList.add('border-red-500', 'dark:border-red-500');
				inputEl.classList.remove('border-gray-300', 'dark:border-gray-600');
			}
		}
	}

	function clearErrors(form: HTMLFormElement) {
		form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
			el.textContent = '';
			el.classList.add('hidden');
		});
		form.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
			el.classList.remove('border-red-500', 'dark:border-red-500');
			el.classList.add('border-gray-300', 'dark:border-gray-600');
		});
	}

	function clearFieldError(form: HTMLFormElement, fieldName: string) {
		const errorEl = form.querySelector(
			`[data-error="${fieldName}"]`,
		) as HTMLElement | null;
		const inputEl = form.querySelector(
			`[data-field="${fieldName}"]`,
		) as HTMLElement | null;

		if (errorEl) {
			errorEl.textContent = '';
			errorEl.classList.add('hidden');
		}
		if (inputEl) {
			inputEl.classList.remove('border-red-500', 'dark:border-red-500');
			inputEl.classList.add('border-gray-300', 'dark:border-gray-600');
		}
	}

	function scrollToFirstError(form: HTMLFormElement) {
		const firstError = form.querySelector(
			'.border-red-500',
		) as HTMLElement | null;
		firstError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		(firstError as HTMLInputElement | null)?.focus();
	}

	document.addEventListener('DOMContentLoaded', initPersonalInfoValidation);
	document.addEventListener('astro:page-load', initPersonalInfoValidation);
</script>
