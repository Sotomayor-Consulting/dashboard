---
import FormInput from '../../../components/forms/FormInput.astro';
import FormPhoneInput from '../../../components/forms/FormPhoneInput.astro';
import FormSelect from '../../../components/forms/FormSelect.astro';

interface PaisRow {
	id: number;
	iso: string;
	name: string;
	codigo_telf: string;
}

interface UsuarioRow {
	nombre?: string | null;
	apellido?: string | null;
	pais_id?: number | null;
	ciudad?: string | null;
	direccion_linea1?: string | null;
	direccion_linea2?: string | null;
	telf?: string | null;
	fecha_nacimiento?: string | null;
	departamento?: string | null;
	codigo_postal?: string | null;
	tipo_identificacion?: string | null;
	numero_de_identificacion?: string | null;
	tipo_persona?: string | null;
	user_id?: string | null;
}

interface Props {
	usuario?: UsuarioRow | null | undefined;
	paises?: PaisRow[] | null | undefined;
	email?: string | undefined;
}

type Option = {
	value: string;
	label: string;
};

const documentTypeOptions: Option[] = [
	{ value: 'Cédula', label: 'Cédula' },
	{ value: 'RUC', label: 'RUC' },
	{ value: 'ID', label: 'ID' },
	{ value: 'Pasaporte', label: 'Pasaporte' },
	{ value: 'EIN', label: 'EIN' },
];

const personTypeOptions: Option[] = [
	{ value: 'Natural', label: 'Natural' },
	{ value: 'Jurídica', label: 'Jurídica' },
];

const { usuario, paises, email } = Astro.props;

const countryOptions: Option[] = (paises ?? []).map((p) => ({
	value: String(p.id),
	label: p.name,
}));
const selectedCountry = usuario?.pais_id ? String(usuario.pais_id) : '';
---

<form
	id="personal-info-form"
	method="post"
	action="/api/users/update-profile"
>
	<div class="divide-y divide-border">
		<!-- Nombre -->
		<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 first:pt-0 sm:grid-cols-[220px_1fr]">
			<div>
				<h3 class="text-sm font-medium text-foreground">Nombre *</h3>
				<p class="mt-1 text-sm text-muted-foreground">Aparecerá en recibos, facturas y comunicaciones.</p>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<FormInput
					label=""
					name="nombre"
					value={usuario?.nombre ?? ''}
					placeholder="Nombre"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="apellido"
					value={usuario?.apellido ?? ''}
					placeholder="Apellido"
					class="col-span-1"
				/>
			</div>
		</div>

		<!-- Email -->
		<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[220px_1fr]">
			<div>
				<h3 class="text-sm font-medium text-foreground">Email *</h3>
				<p class="mt-1 text-sm text-muted-foreground">Usado para inicio de sesión y comunicaciones.</p>
			</div>
			<FormInput label="" name="email" value={email ?? ''} disabled class="col-span-1" />
		</div>

		<!-- Ubicación -->
		<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[220px_1fr]">
			<div>
				<h3 class="text-sm font-medium text-foreground">Ubicación</h3>
				<p class="mt-1 text-sm text-muted-foreground">País, ciudad y dirección.</p>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<FormSelect
					label=""
					name="pais"
					value={selectedCountry}
					options={countryOptions}
					placeholder="Seleccione un país"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="ciudad"
					value={usuario?.ciudad ?? ''}
					placeholder="Ciudad"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="direccion"
					value={usuario?.direccion_linea1 ?? ''}
					placeholder="Dirección línea 1"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="direccion2"
					value={usuario?.direccion_linea2 ?? ''}
					placeholder="Dirección línea 2"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="departamento"
					value={usuario?.departamento ?? ''}
					placeholder="Departamento"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="codigo_postal"
					value={usuario?.codigo_postal ?? ''}
					placeholder="Código postal"
					class="col-span-1"
				/>
			</div>
		</div>

		<!-- Identificación -->
		<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[220px_1fr]">
			<div>
				<h3 class="text-sm font-medium text-foreground">Identificación</h3>
				<p class="mt-1 text-sm text-muted-foreground">Tipo y número de documento.</p>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<FormSelect
					label=""
					name="tipo_de_documento"
					value={usuario?.tipo_identificacion ?? ''}
					options={documentTypeOptions}
					placeholder="Tipo de documento"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="Numero_de_identificacion"
					value={usuario?.numero_de_identificacion ?? ''}
					placeholder="Número de identificación"
					class="col-span-1"
				/>
				<FormSelect
					label=""
					name="tipo_de_persona"
					value={usuario?.tipo_persona ?? ''}
					options={personTypeOptions}
					placeholder="Tipo de persona"
					class="col-span-1"
				/>
			</div>
		</div>

		<!-- Contacto -->
		<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[220px_1fr]">
			<div>
				<h3 class="text-sm font-medium text-foreground">Contacto</h3>
				<p class="mt-1 text-sm text-muted-foreground">Teléfono y fecha de nacimiento.</p>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<FormPhoneInput
					label=""
					name="telefono"
					value={usuario?.telf ?? ''}
					initialCountry="us"
					class="col-span-1"
				/>
				<FormInput
					label=""
					name="fecha_nacimiento"
					type="date"
					value={usuario?.fecha_nacimiento ?? ''}
					placeholder="Fecha de nacimiento"
					class="col-span-1"
				/>
			</div>
		</div>
	</div>

	<!-- Save button -->
	<div class="flex justify-end border-t border-border pt-6">
		<button
			type="submit"
			class="btn-primary"
		>
			Guardar cambios
		</button>
	</div>
</form>

<script>
	import { personalInfoSchema } from '@shared/schemas/personal-info.schema';
	import {
		validateFormData,
		formDataToObject,
	} from '@shared/validation/form-validator';

	function initPersonalInfoValidation() {
		const form = document.getElementById(
			'personal-info-form',
		) as HTMLFormElement | null;
		if (!form) return;

		form.addEventListener('submit', (e) => {
			clearErrors(form);

			const formData = new FormData(form);
			const data = formDataToObject(formData);
			const result = validateFormData(personalInfoSchema, data);

			if (!result.success) {
				e.preventDefault();
				showErrors(form, result.fieldErrors);
				scrollToFirstError(form);
			}
		});

		form.addEventListener('input', (e) => {
			const target = e.target as HTMLElement;
			const fieldName = target.getAttribute('name') || target.dataset.field;
			if (fieldName) clearFieldError(form, fieldName);
		});
		form.addEventListener('change', (e) => {
			const target = e.target as HTMLElement;
			const fieldName = target.getAttribute('name') || target.dataset.field;
			if (fieldName) clearFieldError(form, fieldName);
		});
	}

	function showErrors(
		form: HTMLFormElement,
		fieldErrors: Record<string, string[]>,
	) {
		for (const [field, messages] of Object.entries(fieldErrors)) {
			const errorEl = form.querySelector(
				`[data-error="${field}"]`,
			) as HTMLElement | null;
			const inputEl = form.querySelector(
				`[data-field="${field}"]`,
			) as HTMLElement | null;

			if (errorEl) {
				errorEl.textContent = messages[0] ?? '';
				errorEl.classList.remove('hidden');
			}
			if (inputEl) {
				inputEl.classList.add('border-red-500', 'dark:border-red-500');
				inputEl.classList.remove('border-gray-300', 'dark:border-gray-600');
			}
		}
	}

	function clearErrors(form: HTMLFormElement) {
		form.querySelectorAll<HTMLElement>('[data-error]').forEach((el) => {
			el.textContent = '';
			el.classList.add('hidden');
		});
		form.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
			el.classList.remove('border-red-500', 'dark:border-red-500');
			el.classList.add('border-gray-300', 'dark:border-gray-600');
		});
	}

	function clearFieldError(form: HTMLFormElement, fieldName: string) {
		const errorEl = form.querySelector(
			`[data-error="${fieldName}"]`,
		) as HTMLElement | null;
		const inputEl = form.querySelector(
			`[data-field="${fieldName}"]`,
		) as HTMLElement | null;

		if (errorEl) {
			errorEl.textContent = '';
			errorEl.classList.add('hidden');
		}
		if (inputEl) {
			inputEl.classList.remove('border-red-500', 'dark:border-red-500');
			inputEl.classList.add('border-gray-300', 'dark:border-gray-600');
		}
	}

	function scrollToFirstError(form: HTMLFormElement) {
		const firstError = form.querySelector(
			'.border-red-500',
		) as HTMLElement | null;
		firstError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		(firstError as HTMLInputElement | null)?.focus();
	}

	document.addEventListener('DOMContentLoaded', initPersonalInfoValidation);
	document.addEventListener('astro:page-load', initPersonalInfoValidation);
</script>
