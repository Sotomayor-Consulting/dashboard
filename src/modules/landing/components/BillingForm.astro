---
import { Icon } from 'astro-icon/components';
import FormPhoneInput from '@components/forms/FormPhoneInput.astro';
import FormInput from '@components/forms/FormInput.astro';
import FormSelect from '@components/forms/FormSelect.astro';
import type { BillingInfoRow } from '@domains/users/billing';

interface PaisRow {
	id: number;
	iso: string;
	name: string;
	codigo_telf: string;
}

interface Props {
	addresses: (BillingInfoRow & { paises?: { name: string } | null })[];
	paises?: PaisRow[] | null | undefined;
	userId?: string | undefined;
}

type Option = {
	value: string;
	label: string;
};

const { addresses = [], paises, userId } = Astro.props;
const canAdd = addresses.length < 3;

const countryOptions: Option[] = (paises ?? []).map((p) => ({
	value: String(p.id),
	label: p.name,
}));
---

<!-- Saved addresses -->
{addresses.length > 0 && (
	<div class="mb-8">
		<div class="flex items-center justify-between mb-4">
			<div>
				<h3 class="text-sm font-medium text-foreground">Direcciones guardadas</h3>
				<p class="mt-0.5 text-sm text-muted-foreground">{addresses.length} de 3</p>
			</div>
		</div>

		<div class="space-y-3">
			{addresses.map((addr) => (
				<div class="group flex items-start justify-between rounded-lg border border-border p-4 transition hover:bg-hover">
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2 mb-1">
							<span class="text-sm font-medium text-foreground">
								{addr.line1}
							</span>
							{addr.is_default && (
								<span class="badge-status bg-accent-gold/10 text-accent-gold">
									Predeterminada
								</span>
							)}
						</div>
						{addr.line2 && (
							<p class="text-sm text-muted-foreground">{addr.line2}</p>
						)}
						<p class="text-sm text-muted-foreground">
							{[addr.city, addr.paises?.name, addr.zip].filter(Boolean).join(', ')}
						</p>
						{(addr.email || addr.phone) && (
							<p class="mt-1 text-xs text-muted-foreground">
								{[addr.email, addr.phone].filter(Boolean).join(' · ')}
							</p>
						)}
					</div>

					<div class="flex shrink-0 items-center gap-1 ml-4">
						{!addr.is_default && (
							<form method="post" action="/api/billing/set-default">
								<input type="hidden" name="billing_id" value={addr.id} />
								<button
									type="submit"
									class="rounded-md p-1.5 text-muted-foreground transition hover:bg-hover hover:text-foreground"
									title="Establecer como predeterminada"
								>
									<Icon name="ri:star-line" class="h-4 w-4" />
								</button>
							</form>
						)}
						<form method="post" action="/api/billing/delete">
							<input type="hidden" name="billing_id" value={addr.id} />
							<button
								type="submit"
								class="rounded-md p-1.5 text-muted-foreground transition hover:bg-hover hover:text-red-500"
								title="Eliminar dirección"
							>
								<Icon name="ri:delete-bin-line" class="h-4 w-4" />
							</button>
						</form>
					</div>
				</div>
			))}
		</div>
	</div>
)}

<!-- Add new address form -->
{canAdd ? (
	<div x-data="{ open: false }">
		<button
			type="button"
			x-on:click="open = !open"
			class="btn-outline w-full gap-2"
		>
			<Icon name="ri:add-line" class="h-4 w-4" />
			Agregar dirección de facturación
		</button>

		<div x-show="open" x-transition class="mt-6">
			<form method="post" action="/api/billing/upsert-invoice">
				<input type="hidden" value={userId} name="user_id_factura" />
				{addresses.length === 0 && (
					<input type="hidden" name="is_default" value="true" />
				)}

				<div class="divide-y divide-border">
					<!-- Contacto -->
					<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 first:pt-0 sm:grid-cols-[220px_1fr]">
						<div>
							<h3 class="text-sm font-medium text-foreground">Contacto</h3>
							<p class="mt-1 text-sm text-muted-foreground">Correo y teléfono de facturación.</p>
						</div>
						<div class="grid grid-cols-2 gap-4">
							<FormInput
								label=""
								name="email"
								type="email"
								placeholder="correo@ejemplo.com"
								class="col-span-1"
							/>
							<FormPhoneInput
								label=""
								name="phone"
								initialCountry="us"
								class="col-span-1"
							/>
						</div>
					</div>

					<!-- Dirección -->
					<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[220px_1fr]">
						<div>
							<h3 class="text-sm font-medium text-foreground">Dirección *</h3>
							<p class="mt-1 text-sm text-muted-foreground">Ubicación para facturación.</p>
						</div>
						<div class="grid grid-cols-2 gap-4">
							<FormInput
								label=""
								name="line1"
								placeholder="Dirección línea 1"
								required
								class="col-span-2"
							/>
							<FormInput
								label=""
								name="line2"
								placeholder="Dirección línea 2"
								class="col-span-2"
							/>
							<FormSelect
								label=""
								name="country_id"
								options={countryOptions}
								placeholder="País"
								required
								class="col-span-1"
							/>
							<FormInput
								label=""
								name="city"
								placeholder="Ciudad"
								required
								class="col-span-1"
							/>
							<FormInput
								label=""
								name="zip"
								placeholder="Código postal"
								class="col-span-1"
							/>
						</div>
					</div>
				</div>

				<!-- Save button -->
				<div class="flex justify-end gap-3 border-t border-border pt-6">
					<button
						type="button"
						x-on:click="open = false"
						class="btn-outline"
					>
						Cancelar
					</button>
					<button
						type="submit"
						class="btn-primary"
					>
						Guardar dirección
					</button>
				</div>
			</form>
		</div>
	</div>
) : (
	<p class="text-center text-sm text-muted-foreground py-4">
		Has alcanzado el máximo de 3 direcciones de facturación.
	</p>
)}
