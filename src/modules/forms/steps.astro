---
import WhatsappBtn from '@components/display/WhatsappBtn.astro';
import Alerta from '@components/feedback/alertageneral.astro';
import { Icon } from 'astro-icon/components';

const supabase = Astro.locals.supabase;
const { data: estados } = await supabase.from('estados').select('Estado');

const datosName = [
	{
		nombre: 'Nombre de tu empresa - (opción #1)',
		id: 'nombre-empresa-1',
		name: 'nombre_1',
	},
	{
		nombre: 'Nombre de tu empresa - (opción #2)',
		id: 'nombre-empresa-2',
		name: 'nombre_2',
	},
	{
		nombre: 'Nombre de tu empresa - (opción #3)',
		id: 'nombre-empresa-3',
		name: 'nombre_3',
	},
];
---

<Alerta />

<WhatsappBtn />
<!--Modal --><!-- Main modal -->
<div
	id="modalCard"
	aria-hidden="true"
	class="bg-opacity-70 bg-white-100/80 dark:bg-black-700/80 fixed top-0 right-0 left-0 z-50 hidden h-full max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0"
>
	<div class="relative w-full max-w-5xl p-4">
		<!-- Modal content -->
		<div class="dark:bg-black-900 relative rounded-lg bg-white shadow-sm">
			<!-- Modal header -->
			<div
				class="flex items-center justify-between rounded-t p-4 md:p-5 dark:border-gray-600"
			>
				<button
					type="button"
					id="closeBtn"
					class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
				>
					<svg
						class="h-3 w-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 14 14"
					>
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
					</svg>
					<span class="sr-only">Close modal</span>
				</button>
			</div>
			<!-- Modal body -->
			<div
				class="flex-col items-center justify-center space-y-4 p-4 text-center md:p-5"
			>
				<h3
					class="mx-auto mb-10 w-4/5 text-center text-3xl font-semibold text-neutral-900 md:w-3/5 dark:text-white"
				>
					Encuentre el tipo de entidad adecuado para su negocio
				</h3>
				<p
					class="mx-auto my-10 w-4/5 text-justify text-lg leading-relaxed text-neutral-500 md:w-3/5 dark:text-gray-400"
				>
					La elección de tu entidad legal es el primer gran paso. Evita riesgos
					fiscales y legales. Nuestros consultores te brindan una asesoría
					gratuita para identificar la mejor opción para tu negocio, asegurando
					un crecimiento sólido y protegido en EE. UU.
				</p>
				<div
					class="mt-10 flex h-full w-full justify-center text-neutral-500 dark:text-white"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="100"
						height="100"
						viewBox="0 0 24 24"
						><g fill="none"
							><path
								fill="currentColor"
								d="M2 9c0-1.886 0-2.828.586-3.414S4.114 5 6 5h12c1.886 0 2.828 0 3.414.586S22 7.114 22 9c0 .471 0 .707-.146.854C21.707 10 21.47 10 21 10H3c-.471 0-.707 0-.854-.146C2 9.707 2 9.47 2 9m0 9c0 1.886 0 2.828.586 3.414S4.114 22 6 22h12c1.886 0 2.828 0 3.414-.586S22 19.886 22 18v-5c0-.471 0-.707-.146-.854C21.707 12 21.47 12 21 12H3c-.471 0-.707 0-.854.146C2 12.293 2 12.53 2 13z"
							></path><path
								stroke="currentColor"
								stroke-linecap="round"
								stroke-width="2"
								d="M7 3v3m10-3v3"></path></g
						></svg
					>
				</div>
			</div>
			<!-- Modal footer -->
			<div
				class="flex flex-col items-center justify-center gap-2 rounded-b p-4 md:p-5 lg:flex-row dark:border-gray-600"
			>
				<a
					type="button"
					target="_blank"
					href="https://sotomayorconsulting.com/diagnostico-llc/"
					class="bg-black-600 hover:bg-black-500 w-full rounded-lg px-5 py-2.5 text-center text-sm font-medium text-white focus:ring-4 focus:ring-neutral-500 focus:outline-none lg:w-2/5 lg:text-base"
					>Realiza un Diagnostico breve</a
				>
				<a
					type="button"
					target="_blank"
					href="https://zcal.co/t/agendar-asesoria-llc/60min"
					class="bg-black-600 hover:bg-black-500 w-full rounded-lg px-5 py-2.5 text-center text-sm font-medium text-white focus:ring-4 focus:ring-neutral-500 focus:outline-none lg:w-2/5 lg:text-base"
					>Agendar una cita</a
				>
			</div>

			<div class="h-12.5"></div>
		</div>
	</div>
</div>

<div class="my-8 flex w-full items-center justify-center">
	<div class="ml-5 hidden w-full lg:flex lg:min-h-175 lg:flex-col">
		<div class="mt-16">
			<h3 class="text-black-900 text-2xl dark:text-white">
				Inicie su empresa en EE. UU. en minutos.
			</h3>
			<p class="w-3/4 text-gray-500">
				Responda algunas preguntas para ayudarnos a formar su nueva empresa.
			</p>
		</div>
		<ol class="mt-8 w-full space-y-8 overflow-hidden">
			<li
				id="stepli-1"
				class="relative flex-1 after:absolute after:-bottom-11 after:left-1/4 after:inline-block after:h-full after:w-0.5 after:content-['']"
			>
				<button
					class="flex w-full max-w-sm items-center justify-center gap-8"
					id="paso1btn"
				>
					<div
						id="stepdiv1-1"
						class="relative z-10 flex w-full items-center gap-3.5 rounded-xl p-3.5 text-left"
					>
						<div
							id="stepdiv2-1"
							class="flex items-center justify-center rounded-lg"
						>
							<span id="stepspan-1" class="p-3 text-white">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									><path
										fill="none"
										stroke="currentColor"
										stroke-linecap="square"
										stroke-width="2"
										d="M12 19V4.5h-.5L9.5 6"></path>
								</svg>
							</span>
						</div>
						<div class="flex flex-col items-start justify-center rounded-md">
							<h6 id="steph6-1" class="mb-0.5 text-base font-semibold">
								Tipo de empresa
							</h6>
							<p id="stepp-1" class="text-xs font-normal">
								Elige tu entidad comercial ¿No estás seguro? te ayudamos a
								elegir.
							</p>
						</div>
					</div>
				</button>
			</li>
			<li
				id="stepli-2"
				class="relative flex-1 after:absolute after:-bottom-12 after:left-1/4 after:inline-block after:h-full after:w-0.5 after:content-['']"
			>
				<button
					class="flex w-full max-w-sm items-center justify-center gap-8 text-left"
					id="paso2btn"
				>
					<div
						id="stepdiv1-2"
						class="group relative z-10 flex w-full items-center gap-3.5 rounded-xl border border-transparent p-3.5 transition-all"
					>
						<div
							id="stepdiv2-2"
							class="flex items-center justify-center rounded-lg transition-all"
						>
							<span id="stepspan-2" class="p-3 transition-all">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									><path
										fill="none"
										stroke="currentColor"
										stroke-linecap="square"
										stroke-width="2"
										d="M16 19H8v-2.024a1 1 0 0 1 .37-.776l6.128-4.98A4.07 4.07 0 0 0 16 8.065V8a4 4 0 0 0-8 0"
									></path></svg
								>
							</span>
						</div>
						<div class="flex flex-col items-start justify-center rounded-md">
							<h6
								id="steph6-2"
								class="mb-0.5 text-base font-semibold transition-all"
							>
								Estado de registro
							</h6>
							<p id="stepp-2" class="text-xs font-normal transition-all">
								Elija su estado de registro
							</p>
						</div>
					</div>
				</button>
			</li>
			<li id="stepli-3" class="relative flex-1">
				<button
					class="flex w-full max-w-sm items-center justify-center gap-8 text-left"
					id="paso3btn"
				>
					<div
						id="stepdiv1-3"
						class="group relative z-10 flex w-full items-center gap-3.5 rounded-xl border border-transparent p-3.5 transition-all"
					>
						<div
							id="stepdiv2-3"
							class="flex items-center justify-center rounded-lg transition-all"
						>
							<span id="stepspan-3" class="p-3 transition-all">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									><path
										fill="none"
										stroke="currentColor"
										stroke-linecap="square"
										stroke-width="2"
										d="M8.5 5h7v1.5l-5 3.5v1H12a4 4 0 0 1 0 8h-.5a4 4 0 0 1-4-4"
									></path></svg
								>
							</span>
						</div>
						<div class="flex flex-col items-start justify-center rounded-md">
							<h6
								id="steph6-3"
								class="mb-0.5 text-base font-semibold transition-all"
							>
								Elije el nombre de tu empresa
							</h6>
							<p id="stepp-3" class="text-xs font-normal transition-all">
								Elije tres opciones de nombre para tu empresa
							</p>
						</div>
					</div>
				</button>
			</li>
			<li id="stepli-4" class="relative flex-1">
				<button
					class="flex w-full max-w-sm items-center justify-center gap-8 text-left"
					id="paso4btn"
				>
					<div
						id="stepdiv1-4"
						class="group relative z-10 flex w-full items-center gap-3.5 rounded-xl border border-transparent p-3.5 transition-all"
					>
						<div
							id="stepdiv2-4"
							class="flex items-center justify-center rounded-lg transition-all"
						>
							<span id="stepspan-4" class="p-3 transition-all">
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="24"
									height="24"
									viewBox="0 0 24 24"
									><path
										fill="none"
										stroke="currentColor"
										stroke-linecap="square"
										stroke-width="2"
										d="M14.5 19v-4m0 0H7v-1l6.5-9h1zm0 0h2"></path></svg
								>
							</span>
						</div>
						<div class="flex flex-col items-start justify-center rounded-md">
							<h6
								id="steph6-4"
								class="mb-0.5 text-base font-semibold transition-all"
							>
								Verifica tus datos y registraté
							</h6>
							<p id="stepp-4" class="text-xs font-normal transition-all">
								Verifica los datos que seleccionaste y registrate para entrar a
								nuestra plataforma.
							</p>
						</div>
					</div>
				</button>
			</li>
		</ol>
	</div>
	<div
		class="test dark:bg-black-700 bg-opacity-20 z-20 m-auto flex h-full w-full flex-col items-center justify-center place-self-center rounded-lg bg-white bg-cover bg-clip-padding bg-center py-20 drop-shadow-xl backdrop-blur-md backdrop-contrast-100 backdrop-saturate-100 backdrop-filter md:mr-5"
	>
		<form id="business-form" class="w-full">
			<input type="hidden" name="estado_de" value="En proceso" />
			<div id="paso1">
				<div class="pb-10 text-center">
					<h3 class="text-black-900 text-3xl dark:text-white">
						Estructura de la empresa
					</h3>
					<p class="text-neutral-700 dark:text-gray-400">
						Elija el tipo de entidad adecuada para su negocio.
					</p>
				</div>
				<ul class="grid w-full place-items-center gap-6">
					<li class="w-4/5 md:w-3/5">
						<input
							type="radio"
							id="LLC_radio_btn"
							name="tipo_de_empresa"
							value="LLC"
							class="peer hidden"
							checked
							required
						/>
						<label
							for="LLC_radio_btn"
							class="dark:bg-black-900 peer-checked:border-black-600 peer-checked:text-black-600 bg-white-100 dark:peer-checked:bg-black-600 dark:hover:bg-black-600 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border border-neutral-700 p-5 text-neutral-500 peer-checked:bg-white hover:text-neutral-900 dark:text-gray-400 dark:peer-checked:text-white dark:hover:text-white"
						>
							<div class="block max-w-[90%]">
								<div class="w-full text-lg font-semibold">LLC</div>
								<div class="w-full text-sm">
									Tarifas mínimas + privacidad y flexibilidad inigualables.
								</div>
							</div>
							<svg
								class="ms-3 h-5 w-5 rtl:rotate-180"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 14 10"
							>
								<path
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M1 5h12m0 0L9 1m4 4L9 9"></path>
							</svg>
						</label>
					</li>
					<li class="w-4/5 md:w-3/5">
						<input
							type="radio"
							id="C_coorp_btn_radio"
							name="tipo_de_empresa"
							value="C-corporation"
							class="peer hidden"
							required
						/>
						<label
							for="C_coorp_btn_radio"
							class="dark:bg-black-900 peer-checked:border-black-600 peer-checked:text-black-600 bg-white-100 dark:peer-checked:bg-black-600 dark:hover:bg-black-600 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border border-neutral-700 p-5 text-neutral-500 peer-checked:bg-white hover:text-neutral-900 dark:text-gray-400 dark:peer-checked:text-white dark:hover:text-white"
						>
							<div class="block max-w-[90%]">
								<div class="w-full text-lg font-semibold">C-corporation</div>
								<div class="w-full text-sm">
									Ideal para startups que planean buscar financiación externa.
								</div>
							</div>
							<svg
								class="ms-3 h-5 w-5 rtl:rotate-180"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 14 10"
							>
								<path
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M1 5h12m0 0L9 1m4 4L9 9"></path>
							</svg>
						</label>
					</li>
					<li class="w-4/5 md:w-3/5">
						<button
							id="openBtnxd"
							type="button"
							class="dark:bg-black-900 peer-checked:border-black-600 peer-checked:text-black-600 bg-white-100 dark:peer-checked:bg-black-600 dark:hover:bg-black-600 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border border-neutral-700 p-5 text-left text-neutral-500 peer-checked:bg-white hover:text-neutral-900 dark:text-gray-400 dark:peer-checked:text-white dark:hover:text-white"
						>
							<div class="block max-w-[90%]">
								<div class="w-full text-lg font-semibold">Ayúdame a elegir</div>
								<div class="w-full text-sm">
									Una evaluación estratégica para entender tu etapa actual, tus
									riesgos y el paso exacto que necesitas dar.
								</div>
							</div>
							<svg
								class="ms-3 h-5 w-5 rtl:rotate-180"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 14 10"
							>
								<path
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M1 5h12m0 0L9 1m4 4L9 9"></path>
							</svg>
						</button>
					</li>
				</ul>
				<div class="mt-8 flex w-full justify-center">
					<button
						type="button"
						id="continuarBtn"
						class="from-black-400 via-black-500 to-black-600 me-2 mb-2 w-4/5 rounded-lg bg-linear-to-r px-5 py-2.5 text-center font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:w-3/5 md:text-lg dark:focus:ring-neutral-500"
						>Continuar</button
					>
				</div>
			</div>
			<div id="paso2" class="hidden">
				<div class="relative">
					<button
						type="button"
						id="atrasBtn"
						class="text-white-500 group absolute bottom-10 left-5 flex cursor-pointer items-center text-center font-medium"
						><span class="transition delay-101 group-hover:-translate-x-0.5"
							><svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								><path
									fill="currentColor"
									d="M17 11H9.41l3.3-3.29a1 1 0 1 0-1.42-1.42l-5 5a1 1 0 0 0-.21.33a1 1 0 0 0 0 .76a1 1 0 0 0 .21.33l5 5a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.42L9.41 13H17a1 1 0 0 0 0-2"
								></path></svg
							></span
						> atrás</button
					>
				</div>
				<div class="pb-5 text-center">
					<h3 class="text-3xl text-neutral-800 dark:text-white">
						Elija el estado de registro
					</h3>
					<p class="text-neutral-700 dark:text-gray-400">Estados populares</p>
					<ol class="mt-3 flex justify-center">
						<li>
							<span
								class="bg-black-500 me-2 rounded-full px-2.5 py-0.5 text-sm font-medium text-white dark:bg-[#134aed] dark:text-white"
								>Florida</span
							>
						</li>
						<li>
							<span
								class="bg-black-500 me-2 rounded-full px-2.5 py-0.5 text-sm font-medium text-white dark:bg-[#134aed] dark:text-white"
								>Wyoming</span
							>
						</li>
					</ol>
				</div>
				<ul class="grid w-full place-items-center gap-3">
					<li class="w-4/5 md:w-3/5">
						<div id="seleccionar" class="mt-5">
							<select
								id="estados"
								name="estado_de_empresa"
								class="dark:bg-black-900 border-black-500 bg-white-50 text-black-900 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border p-5 hover:bg-white hover:text-neutral-800 dark:text-gray-400 dark:hover:bg-[#192033] dark:hover:text-white"
								required
							>
								{
									estados?.map((es) => (
										<option
											value={es.Estado}
											selected={es.Estado === 'Florida'}
										>
											{es.Estado}
										</option>
									))
								}
							</select>
						</div>
					</li>
				</ul>
				<div class="mt-8 flex w-full justify-center">
					<button
						type="button"
						id="continuarBtn2"
						class="from-black-400 via-black-500 to-black-600 me-2 mb-2 w-4/5 rounded-lg bg-linear-to-r px-5 py-2.5 text-center font-medium text-white hover:bg-linear-to-br focus:ring-4 focus:ring-neutral-600 focus:outline-none md:w-3/5 md:text-lg dark:focus:ring-neutral-500"
						>Continuar</button
					>
				</div>
			</div>
			<div id="paso3" class="hidden">
				<div class="relative">
					<button
						type="button"
						id="atrasBtn4"
						class="text-white-500 group absolute bottom-10 left-5 flex cursor-pointer items-center text-center font-medium"
						><span class="transition delay-101 group-hover:-translate-x-0.5"
							><svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								><path
									fill="currentColor"
									d="M17 11H9.41l3.3-3.29a1 1 0 1 0-1.42-1.42l-5 5a1 1 0 0 0-.21.33a1 1 0 0 0 0 .76a1 1 0 0 0 .21.33l5 5a1 1 0 0 0 1.42 0a1 1 0 0 0 0-1.42L9.41 13H17a1 1 0 0 0 0-2"
								></path></svg
							></span
						> atrás</button
					>
				</div>
				<div class="pb-10 text-center">
					<h3 class="text-3xl text-neutral-800 dark:text-white">
						Escoge el nombre de tu empresa
					</h3>
					<p class="text-neutral-700 dark:text-gray-400">
						Elije los nombres que mas se adapten a tu empresa
					</p>
				</div>
				<ul class="flex w-full flex-col place-items-center gap-2 px-10">
					{
						datosName.map((name) => (
							<li class="m-2 h-full w-full md:w-3/5">
								<label
									for={name.id}
									class="mb-2 block text-sm font-medium text-gray-900 dark:text-gray-400"
								>
									{name.nombre}
								</label>
								<div class="flex">
