---
const supabase = Astro.locals.supabase;

const { id } = Astro.params;

const { data: formularios } = await supabase
	.from('formularios_envios')
	.select(
		`
	empresa_incorporacion_id,
    data_json,
    formularios (form_id, titulo, slug, descripcion),
    usuarios (user_id, nombre, apellido),
    empresas_incorporaciones (nombre_1, estado)
  `,
	)
	.eq('submission_id', id)
	.single();

const { data: estados } = await supabase
	.from('estados')
	.select('Estado')
	.order('Estado');

const { data: paises } = await supabase
	.from('paises')
	.select('nombre_paises')
	.order('nombre_paises');

const { data: actividades } = await supabase
	.from('actividades')
	.select('Actividad')
	.order('Actividad');

const managers = formularios?.data_json?.Managers || [];
---

<script src="@lib/alpinejs/alpine.js"></script>

<div class="grid grid-cols-1 px-4 pt-6 xl:grid-cols-2 xl:gap-4">
	<div class="col-span-full mb-4 xl:mb-2">
		<nav class="mb-5 flex" aria-label="Breadcrumb">
			<ol
				class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
			>
				<li class="inline-flex items-center">
					<a
						href="/"
						class="inline-flex items-center text-neutral-700 hover:text-[#967432] dark:text-neutral-300 dark:hover:text-white"
					>
						<svg
							class="mr-2.5 h-5 w-5"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
							></path></svg
						>
						Inicio
					</a>
				</li>
				<li class="inline-flex items-center">
					<a
						href="/crud/verficacion-incorporacion"
						class="inline-flex items-center text-neutral-700 hover:text-[#967432] dark:text-neutral-300 dark:hover:text-white"
					>
						<svg
							class="h-6 w-6 text-neutral-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						verificación incorporación
					</a>
				</li>
				<li>
					<div class="flex items-center">
						<svg
							class="h-6 w-6 text-neutral-400"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"></path></svg
						>
						<span
							class="ml-1 text-neutral-400 md:ml-2 dark:text-neutral-500"
							aria-current="page"
							>Empresa {
								formularios?.empresas_incorporaciones?.[0]?.nombre_1
							}</span
						>
					</div>
				</li>
			</ol>
		</nav>
		<h1
			class="text-xl font-semibold text-neutral-900 sm:text-2xl dark:text-white"
		>
			Respuestas del formulario de incorporación
		</h1>
	</div>
	<!-- Right Content -->

	<div class="col-span-2">
		<form
			action=""
			x-data="{ formadeAdministracion: '' }"
			x-init="formadeAdministracion = document.getElementById('forma_de_administrar').value"
		>
			<input
				type="text"
				name="empresa_id"
				id="empresa_id"
				value={formularios?.empresa_incorporacion_id}
				hidden
			/>
			<div
				class="dark:bg-black-800 mb-4 rounded-lg border border-neutral-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-neutral-700"
			>
				<h3 class="mb-4 text-xl font-semibold dark:text-white">
					Actividad de la compañía
				</h3>

				<div
					class="grid grid-cols-6 gap-6"
					x-data="{ direccionEEUU: 'No' }"
					x-init="direccionEEUU = document.getElementById('direccion_operativa_eeuu').value"
				>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="Ingresos_de_EEUU"
							class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
							>¿La LLC obtendrá ingresos provenientes de Estados Unidos?</label
						>
						<select
							name="Ingresos_de_EEUU"
							class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
						>
							<!-- Opción por defecto (placeholder) -->
							<option
								value=""
								disabled
								hidden
								selected={formularios?.data_json
									?.ingresos_provenientes_de_Estados_Unidos == null}
							>
								Seleccione una opción
							</option>

							<!-- Opción "Sí" -->
							<option
								value="true"
								selected={formularios?.data_json
									?.ingresos_provenientes_de_Estados_Unidos === true}
							>
								Sí
							</option>

							<!-- Opción "No" -->
							<option
								value="false"
								selected={formularios?.data_json
									?.ingresos_provenientes_de_Estados_Unidos === false}
							>
								No
							</option>
						</select>
					</div>

					{
						formularios?.data_json?.actividad_en_lista ===
						'No está en la lista' ? (
							<div class="col-span-6 sm:col-span-3">
								<label
									for="actividad_manual"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>
									Actividad registrada de forma manual
								</label>
								<input
									type="text"
									name="actividad_manual"
									value={`${formularios?.data_json?.codigo_actividad} - ${formularios?.data_json?.descripcion_actividad}`}
									id="actividad_manual"
									class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
									placeholder="114110 - Pesca"
								/>
							</div>
						) : (
							<div class="col-span-6 sm:col-span-3">
								<label
									for="actividad"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>
									Actividad
								</label>
								<select
									name="actividad"
									class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
								>
									<option
										value=""
										disabled
										hidden
										selected={formularios?.data_json?.Actividad == null}
									>
										Seleccione una opción
									</option>

									{actividades?.map((actividad) => (
										<option
											value={actividad.Actividad}
											selected={
												formularios?.data_json?.Actividad ===
												actividad.Actividad
											}
										>
											{actividad.Actividad}
										</option>
									))}
								</select>
							</div>
						)
					}

					<div class="col-span-6 sm:col-span-3">
						<label
							for="forma_de_administrar"
							class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
							>Forma de administrar</label
						>
						<select
							name="forma_de_administrar"
							id="forma_de_administrar"
							x-model="formadeAdministracion"
							class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
						>
							<option
								value=""
								selected={!formularios?.data_json?.forma_administracion}
								hidden
								disabled>Seleccione una forma de administar</option
							>

							<!-- Opción "Sí" -->
							<option
								value="Manager-Managed"
								selected={formularios?.data_json?.forma_administracion ===
									'Manager-Managed'}
							>
								Manager-Managed
							</option>

							<!-- Opción "No" -->
							<option
								value="Member-Managed"
								selected={formularios?.data_json?.forma_administracion ===
									'Member-Managed'}
							>
								Member-Managed
							</option>
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="forma_de_tributar"
							class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
							>Forma de tributar</label
						>
						<select
							name="forma_de_tributar"
							class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
						>
							<option
								value=""
								selected={!formularios?.data_json?.forma_tributacion}
								hidden
								disabled>Seleccione una forma de tibutar</option
							>

							<!-- Opción "Sí" -->
							<option
								value="Entidad de paso"
								selected={formularios?.data_json?.forma_tributacion ===
									'Entidad de paso'}
							>
								Entidad de paso
							</option>

							<!-- Opción "No" -->
							<option
								value="Corporación"
								selected={formularios?.data_json?.forma_tributacion ===
									'Corporación'}
							>
								Corporación
							</option>
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="city"
							class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
							>¿Tiene dirección operativa en EE.UU.?</label
						>
						<select
							name="direccion_operativa_eeuu"
							id="direccion_operativa_eeuu"
							x-model="direccionEEUU"
							class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
						>
							<option
								value=""
								selected={!formularios?.data_json?.direccion_operativa_eeuu}
								hidden
								disabled
							>
								Seleccione una opción
							</option>

							<option
								value="Si"
								selected={formularios?.data_json?.direccion_operativa_eeuu ===
									'Si'}
							>
								Si
							</option>

							<option
								value="No"
								selected={formularios?.data_json?.direccion_operativa_eeuu ===
									'No'}
							>
								No
							</option>

							<option
								value="Quiero que Sotomayor Consulting International provea una dirección"
								selected={formularios?.data_json?.direccion_operativa_eeuu ===
									'Quiero que Sotomayor Consulting International provea una dirección'}
							>
								Quiero que Sotomayor Consulting International provea una
								dirección
							</option>
						</select>
					</div>

					<!-- condicionales de Tiene dirección operativa en EE.UU. -->
					<!-- inicio direccionEEUU === 'Si' -->

					<template x-if="direccionEEUU === 'Si'">
						<div class="col-span-6 sm:col-span-3">
							<label
								for="direccion"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Dirección</label
							>
							<input
								type="text"
								name="direccion"
								value={formularios?.data_json?.Direccion}
								id="address"
								class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
								placeholder="ejem. Av. Juan Molineros"
							/>
						</div>
					</template>
					<template x-if="direccionEEUU === 'Si'">
						<div class="col-span-6 sm:col-span-3">
							<label
								for="condado"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Condado</label
							>
							<input
								type="text"
								name="condado"
								value={formularios?.data_json?.Condado}
								id="condado"
								class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
								placeholder="ejem. Miami-Dade"
							/>
						</div>
					</template>
					<template x-if="direccionEEUU === 'Si'">
						<div class="col-span-6 sm:col-span-3">
							<label
								for="ciudad"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Ciudad</label
							>
							<input
								type="text"
								name="ciudad"
								value={formularios?.data_json?.Ciudad}
								id="ciudad"
								class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
								placeholder="ejem. Miami"
							/>
						</div>
					</template>
					<template x-if="direccionEEUU === 'Si'">
						<div class="col-span-6 sm:col-span-3">
							<label
								for="estado"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Estado</label
							>
							<select
								name="estado"
								class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
							>
								<option
									value=""
									disabled
									hidden
									selected={formularios?.data_json?.Estado == null}
								>
									Seleccione un país
								</option>

								{
									estados?.map((estados) => (
										<option
											value={estados.Estado}
											selected={
												formularios?.data_json?.Estado === estados.Estado
											}
										>
											{estados.Estado}
										</option>
									))
								}
							</select>
						</div>
					</template>
					<template x-if="direccionEEUU === 'Si'">
						<div class="col-span-6 sm:col-span-3">
							<label
								for="Codigo_postal"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Codigo Postal</label
							>
							<input
								type="text"
								name="Codigo_postal"
								value={formularios?.data_json?.Ciudad}
								id="Codigo_postal"
								class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
								placeholder="ejem. Miami-Dade"
							/>
						</div>
					</template>

					<!-- fin direccionEEUU === 'Si' -->

					<!-- direccionEEUU === 'No' -->
					<template x-if="direccionEEUU === 'No'"
						><div class="col-span-6 sm:col-span-3">
							<label
								for="Pais_operativo"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Pais</label
							>
							<select
								name="Pais_operativo"
								class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
							>
								<option
									value=""
									disabled
									hidden
									selected={formularios?.data_json?.Pais_ == null}
								>
									Seleccione un pais
								</option>

								{
									paises?.map((paises) => (
										<option
											value={paises.nombre_paises}
											selected={
												formularios?.data_json?.Pais_ === paises.nombre_paises
											}
										>
											{paises.nombre_paises}
										</option>
									))
								}
							</select>
						</div>
					</template>

					<template x-if="direccionEEUU === 'No'">
						<div class="col-span-6 sm:col-span-3">
							<label
								for="direccion_empresa"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Dirección Empresa</label
							>
							<input
								type="text"
								name="direccion_empresa"
								value={formularios?.data_json?.direccion_empresa}
								id="direccion_empresa"
								class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
								placeholder="Av. Juan Molineros"
							/>
						</div>
					</template>
					<template x-if="direccionEEUU === 'No'">
						<div class="col-span-6 sm:col-span-3">
							<label
								for="factura_servicio_basico"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>Factura de servicio básico</label
							>
							<div class="flex items-center gap-1">
								{
									formularios?.data_json?.factura_servicio_basico && (
										<img
											src={formularios?.data_json?.factura_servicio_basico}
											class="w-20 cursor-zoom-in"
											alt="Factura de servicio básico"
											data-modal-target="static-modal"
											data-modal-toggle="static-modal"
										/>
									)
								}

								<input
									type="file"
									name="factura_servicio_basico"
									value={formularios?.data_json?.direccion_empresa}
									id="factura_servicio_basico"
									class="dark:bg-black-800 block h-fit w-full rounded-lg border border-neutral-300 bg-neutral-50 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
									placeholder="Av. Juan Molineros"
								/>

								{
									formularios?.data_json?.factura_servicio_basico && (
										<div
											id="static-modal"
											data-modal-backdrop="static"
											tabindex="-1"
											aria-hidden="true"
											class="fixed top-0 right-0 left-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0"
										>
											<div class="relative max-h-full w-full max-w-2xl p-4">
												<div class="dark:bg-black-800 relative rounded-lg bg-white shadow-sm">
													<div class="flex items-center justify-between rounded-t border-b border-neutral-200 p-4 md:p-5 dark:border-neutral-600">
														<h3 class="text-xl font-semibold text-black dark:text-white">
															Factura de servicio básico
														</h3>
														<button
															type="button"
															class="hover:bg-white-100 ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-neutral-400 hover:text-neutral-900 dark:hover:bg-neutral-600 dark:hover:text-white"
															data-modal-hide="static-modal"
														>
															<svg
																class="h-3 w-3"
																aria-hidden="true"
																xmlns="http://www.w3.org/2000/svg"
																fill="none"
																viewBox="0 0 14 14"
															>
																<path
																	stroke="currentColor"
																	stroke-linecap="round"
																	stroke-linejoin="round"
																	stroke-width="2"
																	d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"
																/>
															</svg>
															<span class="sr-only">Cerrar modal</span>
														</button>
													</div>

