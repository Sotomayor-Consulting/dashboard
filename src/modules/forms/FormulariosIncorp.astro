							<div class="col-span-6 sm:col-span-3">
								<label
									for="informacion_miembros"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>
									Sotomayor Consulting International asigna al Manager
								</label>
								<select
									name="informacion_miembros"
									id="informacion_miembros"
									x-model="asignarManager"
									class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
								>
									<option
										value=""
										disabled
										hidden
										selected={formularios?.data_json?.manager_sci == null}
									>
										Seleccione una opcion
									</option>

									<option
										value="Si"
										selected={formularios?.data_json?.manager_sci == true}
									>
										Si
									</option>

									<option
										value="No"
										selected={formularios?.data_json?.manager_sci == false}
									>
										No
									</option>
								</select>
							</div>
							<template x-if="asignarManager === 'No'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="manager_parte_miembros"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
									>
										El manager es parte de los miembros
									</label>
									<select
										name="manager_parte_miembros"
										id="manager_parte_miembros"
										x-model="manager_parte_miembros"
										class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
									>
										<option
											value=""
											disabled
											hidden
											selected={formularios?.data_json?.manager_es_miembro ==
												null}
										>
											Seleccione una opcion
										</option>

										<option
											value="Si"
											selected={formularios?.data_json?.manager_es_miembro ==
												true}
										>
											Si
										</option>

										<option
											value="No"
											selected={formularios?.data_json?.manager_es_miembro ==
												false}
										>
											No
										</option>
									</select>
								</div>
							</template>
							<template x-if="manager_parte_miembros === 'Si'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="managers"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
									>
										Miembros que son managers
									</label>
									{
										formularios?.data_json?.panel_socios.map((socio: any) => (
											<div class="mb-4 flex items-center">
												<input
													id={`miembros-managers-${socio?.Nombres_completos}`}
													name={`miembros-managers-${socio?.Nombres_completos}`}
													type="checkbox"
													value={socio?.Nombres_completos}
													class="h-4 w-4 rounded-sm border-gray-300 bg-gray-100 text-[#8c681d] focus:ring-2 focus:ring-[#8c681d] dark:border-gray-600 dark:bg-gray-700 dark:ring-offset-gray-800 dark:focus:ring-[#323f67]"
													checked={formularios?.data_json?.Seleccion_managers?.includes(
														socio?.Nombres_completos,
													)}
												/>
												<label
													for={`miembros-managers-${socio?.Nombres_completos}`}
													class="ms-2 text-sm font-medium text-gray-900 dark:text-gray-300"
												>
													{socio?.Nombres_completos}
												</label>
											</div>
										))
									}
								</div>
							</template>
							<template x-if="manager_parte_miembros === 'Si'">
								<div class="col-span-6 sm:col-span-3">
									<label
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
									>
										¿Añadir otro(s) socio(s) fuera de la lista?
										<div class="mt-2 flex cursor-pointer">
											<input
												type="checkbox"
												name="otros-miembros-fuera-de-lista"
												id="otros-miembros-fuera-de-lista"
												x-model="otrosMiembrosfuera"
												class="peer sr-only"
												checked={formularios?.data_json
													?.agregar_otros_socios === true}
											/>
											<div
												class="peer relative h-6 w-11 rounded-full bg-gray-200 peer-checked:bg-[#8c681d] peer-focus:ring-4 peer-focus:ring-blue-300 peer-focus:outline-none after:absolute after:start-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white rtl:peer-checked:after:-translate-x-full dark:border-gray-600 dark:bg-gray-700 dark:peer-checked:bg-[#8c681d] dark:peer-focus:ring-[#8c681d]"
											>
											</div>
											<span
												class="ms-3 text-sm font-medium text-gray-900 dark:text-gray-300"
												>Si</span
											>
										</div>
									</label>
								</div>
							</template>
						</div>
						<template
							x-if="manager_parte_miembros === 'No' || otrosMiembrosfuera === true"
						>
							<div>
								<hr
									class="bg-white-100 dark:bg-black-800 col-span-6 my-8 h-px border-0"
								/>
								<h3 class="mb-4 text-xl font-semibold dark:text-white">
									Añadir manager
								</h3>
								{
									managers.length > 0 &&
										managers.map((manager: any, index: number) => (
											<div
												class="grid grid-cols-6 gap-6"
												id={`contenedor-managers-${index}`}
											>
												<div class="col-span-6 sm:col-span-3">
													<label
														for={`informacion_miembros-${index}`}
														class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
													>
														Nombres y Apellidos
													</label>
													<input
														type="text"
														name={`Nombres_y_apellidos_manager-${index}`}
														value={manager?.Nombres_manager || ''}
														id={`Nombres_y_apellidos_manager-${index}`}
														class="dark:bg-black-800 block h-fit w-full rounded-lg border border-neutral-300 bg-neutral-50 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
													/>
												</div>
											</div>
										))
								}

								{
									managers.length === 0 && (
										<div class="grid grid-cols-6 gap-6">
											<div class="col-span-6 sm:col-span-3">
												<label
													for="informacion_miembros"
													class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
												>
													Nombres y Apellidos
												</label>
												<input
													type="text"
													name="Nombres_y_apellidos_manager"
													value=""
													id="Nombres_y_apellidos_manager"
													class="dark:bg-black-800 block h-fit w-full rounded-lg border border-neutral-300 bg-neutral-50 text-neutral-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
												/>
											</div>
										</div>
									)
								}
							</div>
						</template>
					</div>
				</div>
			</template>

			<div
				id="datos-info-adicional"
				class="dark:bg-black-800 mb-4 rounded-lg border border-neutral-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-neutral-700"
			>
				<h3 class="mb-4 text-xl font-semibold dark:text-white">
					Informacion Adicional
				</h3>

				<div class="grid grid-cols-6 gap-6">
					<div class="col-span-6 sm:col-span-3">
						<label
							for="informacion_miembros"
							class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
						>
							Informacion de los miembros
						</label>
						<select
							name="informacion_miembros"
							class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
						>
							<option
								value=""
								disabled
								hidden
								selected={formularios?.data_json?.informacion_miembros == null}
							>
								Seleccione una opcion
							</option>

							<option
								value="Pública"
								selected={formularios?.data_json?.informacion_miembros ==
									'Pública'}
							>
								Pública
							</option>

							<option
								value="Privada"
								selected={formularios?.data_json?.informacion_miembros ==
									'Privada'}
							>
								Privada
							</option>
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label
							for="responsable_irs"
							class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
						>
							Responsable frente al IRS
						</label>
						<select
							name="responsable_irs"
							class="dark:bg-black-800 block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-neutral-600 dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
						>
							<option
								value=""
								disabled
								hidden
								selected={formularios?.data_json?.responsable_irs == null}
							>
								Seleccione una responsable
							</option>

							{
								formularios?.data_json?.panel_socios.map((socio: any) => (
									<option
										value={socio?.Nombres_completos}
										selected={
											formularios?.data_json?.responsable_irs ==
											socio?.Nombres_completos
										}
									>
										{socio?.Nombres_completos}
									</option>
								))
							}
						</select>
					</div>

					<div class="col-span-6 sm:col-span-3">
						<div class="relative">
							<label
								for="estado_civil"
								class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
							>
								Firma
							</label>
							<img src={formularios?.data_json?.firma} alt="firma" />
						</div>
					</div>

					<div class="sm:col-full col-span-6">
						<button
							class="focus:ring-primary-300 rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
							type="submit"
						>
							Guardar datos
						</button>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>
