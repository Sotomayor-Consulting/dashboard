---
import Stripelogo from '@assets/stripe.svg';
import { Icon } from 'astro-icon/components';
import { getIncorporacionesEnProceso } from '@lib/tables/companies/empresa_incorporaciones';
import { ListaServiciosStripe } from '@lib/tables/services/servicios';

const User = Astro.locals.user;
const userId = User?.id || '';
const supabase = Astro.locals.supabase;

const [empresas, servicios] = await Promise.all([
	getIncorporacionesEnProceso(supabase, userId),
	ListaServiciosStripe(supabase),
]);

const planBasico = servicios?.find((s) => s.nombre === 'Plan Básico');
const planEstandar = servicios?.find((s) => s.nombre === 'Plan Estándar');
const planBusiness = servicios?.find((s) => s.nombre === 'Plan Business');
const planDiseno = servicios?.find((s) => s.nombre === 'Plan Diseño - upgrade');
---

<!-- ========== MAIN CONTENT ========== -->
<main id="content" class={userId} data-user-id={userId}>
	<div class="overflow-hidden">
		<div class="relative flex h-[110vh] flex-col items-center pt-5" id="panel1">
			<div class="mx-auto mb-10 max-w-2xl text-center">
				<h3 class="text-3xl text-neutral-800 dark:text-white">
					Selecciona la empresa a incorporar
				</h3>
			</div>
			<div
				class="dark:bg-black-900 flex w-full flex-col items-center rounded-2xl border border-neutral-500 bg-white p-4 md:w-1/2 md:p-8 dark:border-neutral-800"
			>
				<p
					class="mt-2 mb-5 w-full text-left text-gray-800 lg:text-lg dark:text-neutral-200"
				>
					Lista de empresas
				</p>
				<select
					name="empresa"
					id="empresa-select"
					class="dark:bg-black-800 focus:border-black-600 focus:ring-black-600 mb-5 block w-full rounded-lg border-neutral-600 bg-gray-50 px-4 py-3 pe-9 text-sm disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:text-neutral-200 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
				>
					{
						empresas?.map((empresa) => (
							<option value={empresa.empresa_incorporacion_id}>
								{empresa.nombre_1}
							</option>
						))
					}
				</select>
				<button
					id="btn-paso1"
					class="bg-black-600 hover:bg-black-600/80 focus:bg-black-600/80 inline-flex w-fit items-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-center text-sm font-medium text-white focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
				>
					Continuar</button
				>
			</div>
		</div>
		<div class="relative hidden" id="panel2">
			<div
				class="mx-auto max-w-340 px-4 pt-5 sm:px-6 lg:px-8 lg:pt-14"
				id="step-plans"
			>
				<!-- Title -->
				<div class="mx-auto mb-10 max-w-2xl text-center">
					<h3 class="text-3xl text-neutral-900 dark:text-white">
						Escoge tu plan
					</h3>
					<p class="mt-2 text-gray-800 lg:text-lg dark:text-neutral-200">
						Elije el plan que mas se adapte a tu negocio y necesidades
					</p>
				</div>

				<div
					class="mt-6 grid gap-3 md:mt-12 md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:items-center lg:gap-3 xl:gap-6"
					id="divActivo"
				>
					{
						planBasico && (
							<div>
								<input
									type="radio"
									id={planBasico.id_servicios}
									name="plan"
									value={planBasico.id_servicios}
									class="peer hidden"
									required
									data-price={planBasico.precio}
									data-servicio={planBasico.etiqueta}
								/>
								<label
									for={planBasico.id_servicios}
									class="dark:bg-black-900 dark:peer-checked:border-black-400 peer-checked:border-black-600 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planBasico.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planBasico.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planBasico.descripcion}
									</p>
									<ul class="mt-7 space-y-2.5 text-sm">
										{[
											'Incorporación de la LLC frente al Estado.',
											'Obtención del EIN (Número de Identificación Tributaria).',
											'Agente Residente por un año.',
										].map((li) => (
											<li class="flex gap-x-2">
												<Icon
													name="ri:check-line"
													class="text-black-600 mt-0.5 size-4 shrink-0"
												/>
												<span class="text-left text-gray-800 dark:text-neutral-400">
													{li}
												</span>
											</li>
										))}
									</ul>
								</label>
							</div>
						)
					}

					{
						planBusiness && (
							<div class="tarjeta-2">
								<input
									type="radio"
									id={planBusiness.id_servicios}
									name="plan"
									value={planBusiness.id_servicios}
									class="peer hidden"
									required
									checked
									data-price={planBusiness.precio}
									data-servicio={planBusiness.etiqueta}
								/>
								<label
									for={planBusiness.id_servicios}
									class="dark:bg-black-900 peer-checked:border-black-600 dark:peer-checked:border-black-400 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<p class="mb-3">
										<span class="bg-black-600 dark:bg-black-600 inline-flex animate-pulse items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold text-white uppercase dark:text-white">
											Más popular
										</span>
									</p>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planBusiness.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planBusiness.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planBusiness.descripcion}
									</p>

									<ul class="mt-7 space-y-2.5 text-sm">
										<li class="flex gap-x-2">
											<span class="text-left text-gray-800 dark:text-neutral-300">
												Los beneficios del plan básico y Los beneficios del plan
												estándar, más:
											</span>
										</li>
										{[
											{
												label: 'Planificación y diseño legal - tributario.',
												icono: 'ri:star-s-fill',
											},
											{
												label:
													'Acompañamiento bancario (Mercury o Relay + Stripe).',
												icono: 'ri:star-line',
											},
											{
												label: 'EIN acelerado.',
												icono: 'ri:star-line',
											},
										].map((li) => (
											<li class="flex gap-x-2">
												<Icon
													name={li.icono}
													class="text-black-600 mt-0.5 size-4 shrink-0"
												/>
												<span class="text-left text-gray-800 dark:text-neutral-400">
													{li.label}
												</span>
											</li>
										))}
									</ul>
								</label>
							</div>
						)
					}

					{
						planEstandar && (
							<div class="tarjeta-3">
								<input
									type="radio"
									id={planEstandar.id_servicios}
									name="plan"
									value={planEstandar.id_servicios}
									class="peer hidden"
									required
									data-price={planEstandar.precio}
									data-servicio={planEstandar.etiqueta}
								/>
								<label
									for={planEstandar.id_servicios}
									class="dark:bg-black-900 peer-checked:border-black-600 dark:peer-checked:border-black-400 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planEstandar.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planEstandar.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planEstandar.descripcion}
									</p>

									<ul class="mt-7 space-y-2.5 text-sm">
										<li class="flex gap-x-2">
											<span class="text-left text-gray-800 dark:text-neutral-300">
												Los beneficios del Plan Básico más:
											</span>
										</li>
										{[
											'Elaboración del Acuerdo de Operación.',
											'Consultas ilimitadas por un año.',
											'Solicitud de Exención BE-13',
										].map((li) => (
											<li class="flex gap-x-2">
												<Icon
													name="ri:check-line"
													class="text-black-600 mt-0.5 size-4 shrink-0"
												/>
												<span class="text-left text-gray-800 dark:text-neutral-400">
													{li}
												</span>
											</li>
										))}
									</ul>
								</label>
							</div>
						)
					}
				</div>

				<div
					class="diseño-contenedor mt-6 grid gap-3 md:mt-12 md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:items-center lg:gap-3 xl:gap-6"
					id="divInactivo"
				>
					{
						planDiseno && (
							<div class="tarjeta-4 col-start-2">
								<input
									type="radio"
									id={planDiseno.id_servicios}
									name="plan"
									value={planDiseno.id_servicios}
									class="peer hidden"
									required
									data-price={planDiseno.precio}
									data-servicio={planDiseno.etiqueta}
								/>
								<label
									for={planDiseno.id_servicios}
									class="dark:bg-black-900 peer-checked:border-black-600 dark:peer-checked:border-black-400 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<div class="col-span-2 mt-2">
										<button
											class="flex h-full items-end justify-end place-self-end text-neutral-700 dark:text-white"
											data-popover-target="popover-description4"
											data-popover-placement="right"
											type="button"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="20"
												height="20"
												viewBox="0 0 24 24"
											>
												<g fill="none">
													<>
														<path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z" />
														<path
															fill="currentColor"
															d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 14a1 1 0 1 0 0 2a1 1 0 0 0 0-2m0-9.5a3.625 3.625 0 0 0-3.625 3.625a1 1 0 1 0 2 0a1.625 1.625 0 1 1 2.23 1.51c-.676.27-1.605.962-1.605 2.115V14a1 1 0 1 0 2 0c0-.244.05-.366.261-.47l.087-.04A3.626 3.626 0 0 0 12 6.5"
														/>
													</>
												</g>
											</svg>
										</button>
									</div>

									<div
										data-popover
										id="popover-description4"
										role="tooltip"
										class="dark:bg-black-800 invisible absolute z-10 inline-block w-96 rounded-lg border border-gray-200 bg-white text-sm text-gray-500 opacity-0 shadow-xs transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
									>
										<div class="space-y-2 p-3">
											<h3 class="font-semibold text-gray-900 dark:text-white">
												¿Que es el plan de diseño - upgrade?
											</h3>
											<p class="grid grid-cols-[auto,1fr] text-left">
												<span>
													No todas las LLC son iguales. Para que una LLC
													realmente le sirva, debe diseñarse a medida según su
													giro de negocio, nacionalidad, residencia fiscal y
													número de socios.
													<br />
													En la práctica, hay 5 decisiones clave que determinan
													cómo quedará estructurada su LLC:
												</span>
											</p>
											<p class="ml-2 grid gap-2 text-left">
												{[
													'- Estado de incorporación (50 jurisdicciones posibles).',
													'- Tratamiento tributario federal que más le conviene (2 alternativas principales).',
													'- Modelo administrativo y de gestión (2 esquemas típicos, según quién administre y cómo se tomen decisiones).',
													'- Sistema contable que utilizará (2 bases contables usuales, según su operación y necesidades).',
													'- Nivel de confidencialidad: si desea o no que terceros puedan identificar a los socios/beneficiarios en registros públicos (según lo permita la normativa aplicable).',
												].map((items) => (
													<span>{items}</span>
												))}
											</p>
											<p class="text-left">
												<span>
													<b>
														Para definir estas decisiones con criterio y evitar
														errores costosos, es necesario asesorarse.
													</b>
												</span>
											</p>
											<p class="text-left">
												<span>
													<b>
														El servicio de Planificación, Diseño y Legal de LLC
														consiste en una o más reuniones con un abogado
														tributario para analizar su caso y establecer la
														estructura óptima.
													</b>
												</span>
											</p>
											<p class="text-left">
												<span>
													<b>*Entregable:</b> un informe técnico donde se
													detallan, de forma clara y aplicada a su situación,
													las características con las que recomendamos
													incorporar su LLC y los lineamientos para
													implementarlas correctamente.
												</span>
											</p>
										</div>
										<div data-popper-arrow />
									</div>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planDiseno.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planDiseno.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planDiseno.descripcion}
									</p>

									<ul class="mt-7 space-y-2.5 text-sm">
										<li class="flex gap-x-2">
											<Icon
												name="ri:check-line"
												class="text-black-600 mt-0.5 size-4 shrink-0"
											/>
											<span class="text-left text-gray-800 dark:text-neutral-400">
												Planificación y diseño de LLC
											</span>
										</li>
									</ul>
								</label>
							</div>
						)
					}
				</div>

				<p
					id="checkout-status"
					class="mt-8 text-center text-sm text-gray-600 dark:text-neutral-400"
				>
				</p>

				<div class="mt-6 flex items-center justify-center gap-2">
					<p class="text-base font-normal text-gray-500 dark:text-gray-400">
						Pago seguro gestionado por:
					</p>
					<Stripelogo width={80} />
				</div>

				<div class="my-10 flex items-center justify-center gap-4">
					<button
						type="button"
						id="btn-atras"
						class="focus:bg-black-600/80 inline-flex w-fit items-center gap-x-2 rounded-lg border border-transparent bg-zinc-500 px-4 py-3 text-sm font-medium text-white hover:bg-zinc-600 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
					>
						Regresar
					</button>
					<button
						id="btn-paso2"
						class="bg-black-600 hover:bg-black-600/80 focus:bg-black-600/80 inline-flex w-fit items-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-center text-sm font-medium text-white focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
					>
						Ir a pagar</button
					>
				</div>
			</div>
		</div>
	</div>
</main>

<script>
	function initIncorporacionPaymentFlow() {
		const root = document.getElementById('content');
		if (!root || root.dataset.paymentFlowInitialized === 'true') return;
		root.dataset.paymentFlowInitialized = 'true';

		const userId = root.dataset.userId || '';

		const btnPaso1 = document.getElementById('btn-paso1');
		const btnAtras = document.getElementById('btn-atras');
		const btnPaso2 = document.getElementById(
			'btn-paso2',
		) as HTMLButtonElement | null;
		const panel1 = document.getElementById('panel1');
		const panel2 = document.getElementById('panel2');
		const status = document.getElementById('checkout-status');

		btnPaso1?.addEventListener('click', () => {
			panel1?.classList.add('hidden');
			panel2?.classList.remove('hidden');
		});

		btnAtras?.addEventListener('click', () => {
			panel2?.classList.add('hidden');
			panel1?.classList.remove('hidden');
		});

		btnPaso2?.addEventListener('click', async () => {
			const radio = document.querySelector(
				'input[name="plan"]:checked',
			) as HTMLInputElement | null;
			if (!radio) {
				alert('Por favor selecciona un plan antes de continuar.');
				return;
			}

			const empresaSelect = document.getElementById(
				'empresa-select',
			) as HTMLSelectElement | null;
			if (!empresaSelect || !empresaSelect.value) {
				alert('Por favor selecciona la empresa para la que vas a pagar.');
				return;
			}

			if (!userId) {
				alert('No se detectó tu sesión. Vuelve a iniciar sesión.');
				return;
			}

			btnPaso2.disabled = true;
			if (status) status.textContent = 'Redirigiendo a Stripe…';

			try {
				const res = await fetch('/api/payment/checkout-session', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						planId: radio.value,
						userId,
						empresaId: empresaSelect.value,
					}),
				});
				const data = await res.json();
				if (!res.ok || !data.url) {
					throw new Error(data.error || 'No se pudo iniciar el pago');
				}
				window.location.href = data.url;
			} catch (err) {
				console.error('[checkout]', err);
				if (status)
					status.textContent =
						'No se pudo iniciar el pago. Intenta nuevamente.';
				btnPaso2.disabled = false;
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener(
			'DOMContentLoaded',
			initIncorporacionPaymentFlow,
			{ once: true },
		);
	} else {
		initIncorporacionPaymentFlow();
	}

	document.addEventListener('astro:page-load', initIncorporacionPaymentFlow);
</script>
