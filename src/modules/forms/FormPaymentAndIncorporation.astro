---
import Stripelogo from '@assets/logos/stripe.svg';
import { Icon } from 'astro-icon/components';
import { Badge } from '@components/ui/Badge';
import {
	Card,
	CardAction,
	CardContent,
	CardDescription,
	CardHeader,
	CardTitle,
} from '@components/ui/Card';
import CompanySelect from './islands/CompanySelect.tsx';
import { getIncorporacionesEnProceso } from '@domains/companies/incorporations';
import { ListaServiciosStripe } from '@domains/services/services';

const user = Astro.locals.user;
const userId = user?.id || '';
const supabase = Astro.locals.supabase;

const [empresas, servicios] = await Promise.all([
	getIncorporacionesEnProceso(supabase, userId),
	ListaServiciosStripe(supabase),
]);

const planBasico = servicios?.find(
	(s: { nombre: string }) => s.nombre === 'Plan Básico',
);
const planEstandar = servicios?.find(
	(s: { nombre: string }) => s.nombre === 'Plan Estándar',
);
const planBusiness = servicios?.find(
	(s: { nombre: string }) => s.nombre === 'Plan Business',
);
const planDiseno = servicios?.find(
	(s: { nombre: string }) => s.nombre === 'Plan Diseño - upgrade',
);

const basePlans = [planBasico, planBusiness, planEstandar].filter(Boolean);

const featuresByPlan = new Map<string, string[]>([
	[
		'Plan Básico',
		[
			'Incorporación de la LLC frente al Estado.',
			'Obtención del EIN (Número de Identificación Tributaria).',
			'Agente Residente por un año.',
		],
	],
	[
		'Plan Business',
		[
			'Planificación y diseño legal - tributario.',
			'Acompañamiento bancario (Mercury o Relay + Stripe).',
			'EIN acelerado.',
		],
	],
	[
		'Plan Estándar',
		[
			'Elaboración del Acuerdo de Operación.',
			'Consultas ilimitadas por un año.',
			'Solicitud de Exención BE-13.',
		],
	],
	['Plan Diseño - upgrade', ['Planificación y diseño de LLC.']],
]);

const planLeadByPlan = new Map<string, string>([
	['Plan Básico', 'Base esencial para iniciar su incorporación.'],
	[
		'Plan Business',
		'La opción más completa para iniciar con una estructura robusta.',
	],
	['Plan Estándar', 'Amplía la cobertura legal y operativa del plan básico.'],
	[
		'Plan Diseño - upgrade',
		'Ideal para redefinir la estructura de una LLC ya existente.',
	],
]);

const designPlanDetails = [
	'Estado de incorporación (50 jurisdicciones posibles).',
	'Tratamiento tributario federal que más le conviene.',
	'Modelo administrativo y de gestión según su operación.',
	'Sistema contable más conveniente para su negocio.',
	'Nivel de confidencialidad aplicable a socios y beneficiarios.',
];
---

<main id="content" class={userId} data-user-id={userId}>
	<div class="relative overflow-hidden">
		<div
			class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-linear-to-b from-amber-100/70 via-transparent to-transparent dark:from-amber-500/10"
		>
		</div>

		<section
			id="panel1"
			class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-6xl items-center px-4 py-10 sm:px-6 lg:px-8"
		>
			<div
				class="grid w-full gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center"
			>
				<div class="space-y-5">
					<Badge
						variant="outline"
						className="px-3 py-1 text-[11px] tracking-[0.24em] uppercase"
					>
						Checkout LLC
					</Badge>
					<div class="space-y-3">
						<h1
							class="text-foreground max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl"
						>
							Seleccione la empresa y prepare su proceso de pago.
						</h1>
						<p
							class="text-muted-foreground max-w-2xl text-base leading-7 sm:text-lg"
						>
							Elija la incorporación que desea activar y avance a un checkout
							seguro con Stripe.
						</p>
					</div>

					<div class="grid gap-3 sm:grid-cols-3">
						<div class="bg-background/80 rounded-xl border p-4 shadow-xs">
							<p
								class="text-muted-foreground text-xs tracking-[0.2em] uppercase"
							>
								Empresas
							</p>
							<p class="text-foreground mt-2 text-2xl font-semibold">
								{empresas?.length ?? 0}
							</p>
						</div>
						<div class="bg-background/80 rounded-xl border p-4 shadow-xs">
							<p
								class="text-muted-foreground text-xs tracking-[0.2em] uppercase"
							>
								Planes
							</p>
							<p class="text-foreground mt-2 text-2xl font-semibold">
								{basePlans.length + (planDiseno ? 1 : 0)}
							</p>
						</div>
						<div class="bg-background/80 rounded-xl border p-4 shadow-xs">
							<p
								class="text-muted-foreground text-xs tracking-[0.2em] uppercase"
							>
								Pasarela
							</p>
							<div class="mt-3 flex items-center gap-2">
								<Stripelogo width={70} />
							</div>
						</div>
					</div>
				</div>

				<Card className="border-border/70 bg-background/95 shadow-2xl">
					<CardHeader className="space-y-2 border-b pb-5">
						<CardTitle className="text-xl">Empresa a incorporar</CardTitle>
						<CardDescription>
							Seleccione la empresa sobre la cual desea continuar el checkout.
						</CardDescription>
					</CardHeader>
					<CardContent className="space-y-5 pt-5">
						{
							empresas?.length ? (
								<>
									<div class="space-y-2">
										<label
											for="empresa-select"
											class="text-foreground text-sm font-medium"
										>
											Empresas disponibles
										</label>
										<CompanySelect companies={empresas ?? []} client:load />
									</div>

									<div class="border-border bg-muted/30 text-muted-foreground rounded-xl border border-dashed p-4 text-sm">
										Su selección definirá a qué incorporación se vinculará el
										pago y el flujo posterior del proceso.
									</div>

									<button
										id="btn-paso1"
										type="button"
										class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-11 w-full items-center justify-center rounded-xl px-4 text-sm font-medium transition disabled:pointer-events-none disabled:opacity-50"
									>
										Continuar a planes
									</button>
								</>
							) : (
								<div class="border-border bg-muted/30 text-muted-foreground rounded-xl border border-dashed p-4 text-sm">
									Aún no tienes ninguna empresa pendiente por pagar.
								</div>
							)
						}
					</CardContent>
				</Card>
			</div>
		</section>

		<section id="panel2" class="hidden px-4 py-10 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-6xl space-y-10">
				<div class="mx-auto max-w-3xl text-center">
					<Badge
						variant="secondary"
						className="mb-4 px-3 py-1 text-[11px] tracking-[0.24em] uppercase"
					>
						Planes disponibles
					</Badge>
					<h2
						class="text-foreground text-3xl font-semibold tracking-tight sm:text-4xl"
					>
						Escoja su plan
					</h2>
					<p class="text-muted-foreground mt-3 text-base leading-7 sm:text-lg">
						Elija la alternativa que mejor se adapta a su estructura y continúe
						al pago seguro.
					</p>
				</div>

				<div class="grid gap-5 lg:grid-cols-3">
					{
						basePlans.map((plan, index) => {
							const features = featuresByPlan.get(plan.nombre) ?? [];
							const lead =
								planLeadByPlan.get(plan.nombre) ?? plan.descripcion ?? '';
							const isFeatured = plan.nombre === 'Plan Business';

							return (
								<div class="relative">
									<input
										type="radio"
										id={plan.id_servicios}
										name="plan"
										value={plan.id_servicios}
										class="peer sr-only"
										required
										checked={isFeatured}
										data-price={plan.precio}
										data-servicio={plan.etiqueta}
									/>
									<label
										for={plan.id_servicios}
										class="block cursor-pointer peer-checked:[&_.plan-copy]:text-[#a67c28] peer-checked:[&_.plan-feature]:text-[#b4862f] peer-checked:[&_.plan-price]:text-[#c89b3c] peer-checked:[&_[data-slot=card-description]]:text-[#a67c28] peer-checked:[&_[data-slot=card-title]]:text-[#c89b3c]"
									>
										<span class="bg-primary text-primary-foreground pointer-events-none absolute top-3 right-3 z-10 inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold opacity-0 shadow-sm transition-opacity duration-200 peer-checked:opacity-100">
											Seleccionado
										</span>
										<Card className="h-full border-border/70 bg-background/95 shadow-lg transition-all duration-200 hover:-translate-y-1 hover:shadow-xl">
											<CardHeader className="space-y-3 border-b pb-5">
												<CardAction>
													{isFeatured ? (
														<Badge variant="default">Mas popular</Badge>
													) : (
														<Badge variant="outline">Plan {index + 1}</Badge>
													)}
												</CardAction>
												<div class="space-y-1 pr-20">
													<CardTitle className="text-xl">
														{plan.nombre}
													</CardTitle>
													<CardDescription>{lead}</CardDescription>
												</div>
												<div class="pt-4">
													<p class="plan-price text-foreground text-4xl font-semibold tracking-tight transition-colors duration-200">
														${plan.precio}
													</p>
													<p class="plan-copy text-muted-foreground mt-2 text-sm transition-colors duration-200">
														{plan.descripcion}
													</p>
												</div>
											</CardHeader>
											<CardContent className="space-y-4 pt-5">
												<ul class="text-muted-foreground space-y-3 text-sm">
													{features.map((feature) => (
														<li class="flex items-start gap-3">
															<span class="bg-primary/10 text-primary mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full">
																<Icon name="ri:check-line" class="size-3.5" />
															</span>
															<span class="plan-feature text-foreground/85 transition-colors duration-200">
																{feature}
															</span>
														</li>
													))}
												</ul>
											</CardContent>
										</Card>
									</label>
								</div>
							);
						})
					}
				</div>

				{
					planDiseno && (
						<div class="mx-auto max-w-3xl">
							<input
								type="radio"
								id={planDiseno.id_servicios}
								name="plan"
								value={planDiseno.id_servicios}
								class="peer sr-only"
								required
								data-price={planDiseno.precio}
								data-servicio={planDiseno.etiqueta}
							/>
							<label
								for={planDiseno.id_servicios}
								class="block cursor-pointer peer-checked:[&_.plan-copy]:text-[#a67c28] peer-checked:[&_.plan-feature]:text-[#b4862f] peer-checked:[&_.plan-price]:text-[#c89b3c] peer-checked:[&_[data-slot=card-description]]:text-[#a67c28] peer-checked:[&_[data-slot=card-title]]:text-[#c89b3c]"
							>
								<span class="bg-primary text-primary-foreground pointer-events-none absolute top-3 right-3 z-10 inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-semibold opacity-0 shadow-sm transition-opacity duration-200 peer-checked:opacity-100">
									Seleccionado
								</span>
								<Card className="border-border/70 bg-background/95 shadow-lg transition-all duration-200 hover:shadow-xl">
									<CardHeader className="space-y-3 border-b pb-5">
										<CardAction>
											<Badge variant="warning">Upgrade</Badge>
										</CardAction>
										<div class="space-y-1 pr-20">
											<CardTitle className="text-xl">
												{planDiseno.nombre}
											</CardTitle>
											<CardDescription>
												{planLeadByPlan.get(planDiseno.nombre) ??
													planDiseno.descripcion}
											</CardDescription>
										</div>
										<div class="pt-4">
											<p class="plan-price text-foreground text-4xl font-semibold tracking-tight transition-colors duration-200">
												${planDiseno.precio}
											</p>
											<p class="plan-copy text-muted-foreground mt-2 text-sm transition-colors duration-200">
												{planDiseno.descripcion}
											</p>
										</div>
									</CardHeader>
									<CardContent className="space-y-6 pt-5">
										<div class="border-border bg-muted/30 text-muted-foreground rounded-xl border border-dashed p-4 text-sm leading-7">
											<p>
												No todas las LLC son iguales. Este plan permite diseñar
												la estructura adecuada según su actividad, residencia
												fiscal, número de socios y objetivos operativos.
											</p>
										</div>
										<div class="grid gap-3 sm:grid-cols-2">
											{designPlanDetails.map((item) => (
												<div class="bg-background text-foreground/85 flex items-start gap-3 rounded-xl border px-4 py-3 text-sm">
													<span class="bg-primary/10 text-primary mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full">
														<Icon name="ri:star-smile-line" class="size-3.5" />
													</span>
													<span class="plan-feature transition-colors duration-200">
														{item}
													</span>
												</div>
											))}
										</div>
									</CardContent>
								</Card>
							</label>
						</div>
					)
				}

				<div
					class="bg-background/90 space-y-6 rounded-2xl border p-6 shadow-sm"
				>
					<p
						id="checkout-status"
						class="text-muted-foreground text-center text-sm"
					>
					</p>

					<div
						class="text-muted-foreground flex flex-wrap items-center justify-center gap-3 text-sm"
					>
						<span>Pago seguro gestionado por</span>
						<Stripelogo width={84} />
					</div>

					<div class="flex flex-col justify-center gap-3 sm:flex-row">
						<button
							type="button"
							id="btn-atras"
							class="border-border bg-background text-foreground hover:bg-muted inline-flex h-11 items-center justify-center rounded-xl border px-5 text-sm font-medium transition disabled:pointer-events-none disabled:opacity-50"
						>
							Regresar
						</button>
						<button
							type="button"
							id="btn-paso2"
							class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-11 items-center justify-center rounded-xl px-5 text-sm font-medium transition disabled:pointer-events-none disabled:opacity-50"
						>
							Ir a pagar
						</button>
					</div>
				</div>
			</div>
		</section>
	</div>
</main>

<script>
	function initIncorporacionPaymentFlow() {
		const root = document.getElementById('content');
		if (!root || root.dataset.paymentFlowInitialized === 'true') return;
		root.dataset.paymentFlowInitialized = 'true';

		const userId = root.dataset.userId || '';

		const btnPaso1 = document.getElementById('btn-paso1');
		const btnAtras = document.getElementById('btn-atras');
		const btnPaso2 = document.getElementById(
			'btn-paso2',
		) as HTMLButtonElement | null;
		const panel1 = document.getElementById('panel1');
		const panel2 = document.getElementById('panel2');
		const status = document.getElementById('checkout-status');

		btnPaso1?.addEventListener('click', () => {
			panel1?.classList.add('hidden');
			panel2?.classList.remove('hidden');
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		btnAtras?.addEventListener('click', () => {
			panel2?.classList.add('hidden');
			panel1?.classList.remove('hidden');
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		btnPaso2?.addEventListener('click', async () => {
			const radio = document.querySelector(
				'input[name="plan"]:checked',
			) as HTMLInputElement | null;
			if (!radio) {
				alert('Por favor selecciona un plan antes de continuar.');
				return;
			}

			const empresaSelect = document.getElementById(
				'empresa-select',
			) as HTMLSelectElement | null;
			if (!empresaSelect || !empresaSelect.value) {
				alert('Por favor selecciona la empresa para la que vas a pagar.');
				return;
			}

			if (!userId) {
				alert('No se detectó tu sesión. Vuelve a iniciar sesión.');
				return;
			}

			btnPaso2.disabled = true;
			if (status) status.textContent = 'Redirigiendo a Stripe...';

			try {
				const res = await fetch('/api/payment/checkout-session', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						planId: radio.value,
						userId,
						empresaId: empresaSelect.value,
					}),
				});
				const data = await res.json();
				if (!res.ok || !data.url) {
					throw new Error(data.error || 'No se pudo iniciar el pago');
				}
				window.location.href = data.url;
			} catch (err) {
				console.error('[checkout]', err);
				if (status) {
					status.textContent =
						'No se pudo iniciar el pago. Intenta nuevamente.';
				}
				btnPaso2.disabled = false;
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener(
			'DOMContentLoaded',
			initIncorporacionPaymentFlow,
			{ once: true },
		);
	} else {
		initIncorporacionPaymentFlow();
	}

	document.addEventListener('astro:page-load', initIncorporacionPaymentFlow);
</script>
