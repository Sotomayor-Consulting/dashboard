---
import Stripelogo from '@assets/logos/stripe.svg';
import LogoSCI from '../../icons/Letras_logo_SCI.svg';
import { Icon } from 'astro-icon/components';
import ColorModeSwitcher from '@components/display/ColorModeSwitcher.astro';
import CompanySelect from './islands/CompanySelect.tsx';
import { getIncorporacionesEnProceso } from '@domains/companies/incorporations';
import { ListaServiciosStripe } from '@domains/services/services';

const user = Astro.locals.user;
const userId = user?.id || '';
const supabase = Astro.locals.supabase;

const [empresas, servicios] = await Promise.all([
	getIncorporacionesEnProceso(supabase, userId),
	ListaServiciosStripe(supabase),
]);

// Los planes se identifican por slug canónico (catalogs.service_plans);
// el radio manda `plan.id` (int canónico) como planId al checkout.
const planBasico = servicios?.find(
	(s: { slug: string }) => s.slug === 'basico',
);
const planEstandar = servicios?.find(
	(s: { slug: string }) => s.slug === 'estandar',
);
const planBusiness = servicios?.find(
	(s: { slug: string }) => s.slug === 'business',
);
const planDiseno = servicios?.find(
	(s: { slug: string }) => s.slug === 'diseno',
);

// Los 4 planes en una sola grilla (Diseño incluido como cuarta opción).
const allPlans = [planBasico, planBusiness, planEstandar, planDiseno].filter(
	(p): p is NonNullable<typeof planBasico> => Boolean(p),
);

const featuresByPlan = new Map<string, string[]>([
	[
		'basico',
		[
			'Incorporación de la LLC frente al Estado.',
			'Obtención del EIN (Número de Identificación Tributaria).',
			'Agente Residente por un año.',
		],
	],
	[
		'business',
		[
			'Planificación y diseño legal - tributario.',
			'Acompañamiento bancario (Mercury o Relay + Stripe).',
			'EIN acelerado.',
		],
	],
	[
		'estandar',
		[
			'Elaboración del Acuerdo de Operación.',
			'Consultas ilimitadas por un año.',
			'Solicitud de Exención BE-13.',
		],
	],
	[
		'diseno',
		[
			'Estado de incorporación ideal (50 jurisdicciones).',
			'Tratamiento tributario federal óptimo.',
			'Modelo administrativo y contable a medida.',
		],
	],
]);

// Etiqueta corta de tier por plan (business resalta en dorado).
const tagByPlan = new Map<string, string>([
	['basico', 'Esencial'],
	['business', 'Más popular'],
	['estandar', 'Completo'],
	['diseno', 'Upgrade'],
]);

const planLeadByPlan = new Map<string, string>([
	['basico', 'Base esencial para iniciar su incorporación.'],
	[
		'business',
		'La opción más completa para iniciar con una estructura robusta.',
	],
	['estandar', 'Amplía la cobertura legal y operativa del plan básico.'],
	['diseno', 'Ideal para redefinir la estructura de una LLC ya existente.'],
]);

const year = new Date().getFullYear();

// Métodos de pago aceptados (glyphs monocromáticos de Remix Icon, offline).
// Stripe procesa siempre Visa/Mastercard vía tarjeta; añade Amex/PayPal aquí
// solo si están habilitados en el dashboard de Stripe.
const paymentMethods = [
	{ icon: 'ri:visa-fill', label: 'Visa' },
	{ icon: 'ri:mastercard-fill', label: 'Mastercard' },
];

// ─── Tokens de estilo flat/open (consistentes con el start wizard) ──
const goldLabel =
	'text-primary-gold text-xs font-semibold tracking-[0.25em] uppercase';
const heading =
	'text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl dark:text-white';
const subtitle = 'text-base leading-7 text-slate-500 dark:text-slate-400';
// CTA primario: dorado sólido con texto oscuro (alto contraste), micro-lift
// al hover, scale al pulsar y ring de foco accesible.
const goldButton =
	'group inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-primary-gold px-5 text-sm font-semibold text-primary-black shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:brightness-105 active:translate-y-0 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-primary-gold/50 focus-visible:ring-offset-2 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-60 dark:focus-visible:ring-offset-black';
// Secundario ghost: solo borde, subordinado al primario.
const ghostButton =
	'group inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-transparent px-5 text-sm font-medium text-slate-700 transition-all duration-200 hover:border-slate-300 hover:bg-slate-50 active:scale-[0.98] focus-visible:ring-2 focus-visible:ring-slate-300 focus-visible:ring-offset-2 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-60 dark:border-neutral-800 dark:text-slate-200 dark:hover:bg-white/5 dark:focus-visible:ring-neutral-700 dark:focus-visible:ring-offset-black';
const dashedNote =
	'rounded-xl border border-dashed border-slate-200 bg-slate-50/60 p-4 text-sm text-slate-500 dark:border-neutral-800 dark:bg-white/[0.02] dark:text-slate-400';
// El label recibe las variantes peer-checked (borde/ring + check dorado).
const planCard =
	'relative block h-full cursor-pointer rounded-2xl border border-slate-200 bg-white p-6 transition-all hover:border-slate-300 dark:border-neutral-800 dark:bg-neutral-950 dark:hover:border-neutral-700 peer-checked:border-[#8c681d] peer-checked:ring-2 peer-checked:ring-[#8c681d]/20 peer-checked:[&_.plan-check]:opacity-100';
---

<main id="content" class="flex min-h-dvh flex-col" data-user-id={userId}>
	<header
		class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-5 sm:px-6 lg:px-8"
	>
		<a
			href="https://sotomayorconsulting.com/inicio/"
			class="inline-flex items-center invert dark:invert-0"
			aria-label="Sotomayor Consulting"
		>
			<LogoSCI class="h-6 w-auto" />
		</a>
		<ColorModeSwitcher />
	</header>

	<section id="panel1" class="flex flex-1 flex-col justify-center px-4 py-10">
		<div class="mx-auto w-full max-w-md">
			<div class="space-y-2 text-center">
				<p class={goldLabel}>Paso 01 · de 02</p>
				<h1 class={heading}>Selecciona tu empresa</h1>
				<p class={subtitle}>
					Elige la incorporación que deseas activar y avanza a un checkout
					seguro con Stripe.
				</p>
			</div>

			<div class="mt-10 space-y-5">
				{
					empresas?.length ? (
						<>
							<div>
								<label
									for="empresa-select"
									class="mb-2 block text-sm font-medium text-slate-900 dark:text-white"
								>
									Empresa a incorporar
								</label>
								<CompanySelect companies={empresas ?? []} client:load />
							</div>

							<p class={dashedNote}>
								Tu selección definirá a qué incorporación se vinculará el pago y
								el flujo posterior del proceso.
							</p>

							<button
								id="btn-paso1"
								type="button"
								class={`w-full ${goldButton}`}
							>
								Continuar a planes
								<Icon
									name="ri:arrow-right-line"
									class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
								/>
							</button>

							<div class="flex items-center justify-center gap-2 text-sm text-slate-400 dark:text-slate-500">
								<Icon name="ri:lock-2-line" class="size-4" />
								<span>Pago seguro gestionado por</span>
								<span class="brightness-0 dark:brightness-0 dark:invert">
									<Stripelogo width={60} />
								</span>
							</div>
						</>
					) : (
						<div class={dashedNote}>
							Aún no tienes ninguna empresa pendiente por pagar.
						</div>
					)
				}
			</div>
		</div>
	</section>

	<section id="panel2" class="hidden">
		<div class="mx-auto max-w-7xl space-y-10 px-4 pt-14 pb-28 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl space-y-2 text-center">
				<p class={goldLabel}>Paso 02 · de 02</p>
				<h2 class={heading}>Escoja su plan</h2>
				<p class={subtitle}>
					Elija la alternativa que mejor se adapta a su estructura y continúe al
					pago seguro.
				</p>
			</div>

			<div class="grid items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{
					allPlans.map((plan) => {
						const features = featuresByPlan.get(plan.slug) ?? [];
						const lead =
							planLeadByPlan.get(plan.slug) ?? plan.descripcion ?? '';
						const tag = tagByPlan.get(plan.slug) ?? 'Plan';
						const isFeatured = plan.slug === 'business';

						return (
							<div
								class:list={[
									'relative',
									isFeatured && 'order-first sm:order-none',
								]}
							>
								<input
									type="radio"
									id={`plan-${plan.id}`}
									name="plan"
									value={plan.id}
									class="peer sr-only"
									required
									checked={isFeatured}
									data-price={plan.precio}
									data-servicio={plan.etiqueta}
									data-nombre={plan.nombre}
								/>
								<label for={`plan-${plan.id}`} class={planCard}>
									<span class="plan-check bg-primary-gold absolute top-5 right-5 flex size-6 items-center justify-center rounded-full text-white opacity-0 transition-opacity duration-200">
										<Icon name="ri:check-line" class="size-3.5" />
									</span>

									{isFeatured ? (
										<span class="bg-primary-gold text-primary-black inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-semibold tracking-wide uppercase">
											{tag}
										</span>
									) : (
										<span class="inline-flex items-center rounded-full border border-slate-200 px-2.5 py-0.5 text-[10px] font-medium tracking-wide text-slate-400 uppercase dark:border-neutral-800 dark:text-slate-500">
											{tag}
										</span>
									)}

									<h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">
										{plan.nombre}
									</h3>
									<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
										{lead}
									</p>

									<p class="mt-5 text-3xl font-semibold tracking-tight text-slate-900 tabular-nums dark:text-white">
										${plan.precio}
									</p>
									<p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
										{plan.descripcion}
									</p>

									<div class="my-5 h-px bg-slate-200 dark:bg-neutral-800" />

									<ul class="space-y-2.5 text-sm">
										{features.map((feature) => (
											<li class="flex items-start gap-2.5">
												<span class="bg-primary-gold/10 text-primary-gold mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full">
													<Icon name="ri:check-line" class="size-3.5" />
												</span>
												<span class="text-slate-600 dark:text-slate-300">
													{feature}
												</span>
											</li>
										))}
									</ul>
								</label>
							</div>
						);
					})
				}
			</div>

			<!-- Footer de confianza: seguridad, métodos de pago y copyright -->
			<footer class="mx-auto max-w-3xl space-y-5 pt-2 text-center">
				<div
					class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-slate-500 dark:text-slate-400"
				>
					<span class="inline-flex items-center gap-1.5">
						<Icon
							name="ri:shield-check-fill"
							class="text-primary-gold size-4"
						/>
						Pago cifrado de extremo a extremo
					</span>
					<span class="inline-flex items-center gap-1.5">
						<Icon
							name="ri:secure-payment-fill"
							class="text-primary-gold size-4"
						/>
						Procesado de forma segura por Stripe
					</span>
					<span class="inline-flex items-center gap-1.5">
						<Icon name="ri:bank-card-fill" class="text-primary-gold size-4" />
						No almacenamos los datos de tu tarjeta
					</span>
				</div>

				<div class="flex items-center justify-center gap-3">
					<span class="text-xs text-slate-400 dark:text-slate-500"
						>Aceptamos</span
					>
					<div class="flex items-center gap-2">
						{
							paymentMethods.map((m) => (
								<span
									class="inline-flex h-7 w-11 items-center justify-center rounded-md border border-slate-200 dark:border-neutral-800"
									title={m.label}
								>
									<Icon
										name={m.icon}
										class="size-5 text-slate-500 dark:text-slate-400"
									/>
								</span>
							))
						}
					</div>
				</div>

				<div class="border-t border-slate-200 pt-5 dark:border-neutral-800">
					<p class="text-xs text-slate-400 dark:text-slate-500">
						© {year} Sotomayor Consulting International. Todos los derechos reservados.
					</p>
					<div class="mt-2 flex items-center justify-center gap-4 text-xs">
						<a
							href="https://sotomayorconsulting.com/inicio/politicas/"
							class="hover:text-primary-gold text-slate-500 dark:text-slate-400"
						>
							Términos de Servicio
						</a>
						<span class="text-slate-300 dark:text-neutral-700">·</span>
						<a
							href="https://sotomayorconsulting.com/inicio/politicas/"
							class="hover:text-primary-gold text-slate-500 dark:text-slate-400"
						>
							Política de Privacidad
						</a>
					</div>
				</div>
			</footer>
		</div>

		<!-- Barra de acción fija: resumen del plan + CTA siempre visible -->
		<div
			class="sticky bottom-0 z-30 border-t border-slate-200 bg-white/85 backdrop-blur-md dark:border-neutral-800 dark:bg-black/85"
		>
			<div
				class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
			>
				<div class="min-w-0">
					<p
						class="text-[11px] tracking-wide text-slate-500 uppercase dark:text-slate-400"
					>
						Plan seleccionado
					</p>
					<p class="mt-0.5 text-sm">
						<span
							id="selected-plan-name"
							class="font-semibold text-slate-900 dark:text-white"
						>
							{planBusiness?.nombre ?? allPlans[0]?.nombre}
						</span>
						<span class="text-primary-gold font-semibold tabular-nums">
							{' · $'}
							<span id="selected-plan-price">
								{planBusiness?.precio ?? allPlans[0]?.precio}
							</span>
						</span>
					</p>
					<p
						id="checkout-status"
						class="mt-0.5 text-xs text-slate-500 dark:text-slate-400"
					>
					</p>
				</div>

				<div class="flex items-center gap-3">
					<div
						class="mr-1 hidden items-center gap-2 text-slate-400 md:flex dark:text-slate-500"
					>
						<Icon name="ri:lock-2-line" class="size-4" />
						<span class="brightness-0 dark:brightness-0 dark:invert">
							<Stripelogo width={46} />
						</span>
						<span class="h-4 w-px bg-slate-200 dark:bg-neutral-800"></span>
						{
							paymentMethods.slice(0, 2).map((m) => (
								<span
									class="inline-flex h-6 w-9 items-center justify-center rounded border border-slate-200 dark:border-neutral-800"
									title={m.label}
								>
									<Icon name={m.icon} class="size-4" />
								</span>
							))
						}
					</div>
					<button type="button" id="btn-atras" class={ghostButton}>
						<Icon
							name="ri:arrow-left-line"
							class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5"
						/>
						Regresar
					</button>
					<button
						type="button"
						id="btn-paso2"
						class={`flex-1 sm:flex-none ${goldButton}`}
					>
						<span
							id="pay-spinner"
							class="hidden size-4 animate-spin rounded-full border-2 border-current border-t-transparent"
							aria-hidden="true"></span>
						Ir a pagar
						<span
							id="pay-arrow"
							class="inline-flex transition-transform duration-200 group-hover:translate-x-0.5"
						>
							<Icon name="ri:arrow-right-line" class="size-4" />
						</span>
					</button>
				</div>
			</div>
		</div>
	</section>
</main>

<script>
	function initIncorporacionPaymentFlow() {
		const root = document.getElementById('content');
		if (!root || root.dataset.paymentFlowInitialized === 'true') return;
		root.dataset.paymentFlowInitialized = 'true';

		const userId = root.dataset.userId || '';

		const btnPaso1 = document.getElementById('btn-paso1');
		const btnAtras = document.getElementById('btn-atras');
		const btnPaso2 = document.getElementById(
			'btn-paso2',
		) as HTMLButtonElement | null;
		const panel1 = document.getElementById('panel1');
		const panel2 = document.getElementById('panel2');
		const status = document.getElementById('checkout-status');

		btnPaso1?.addEventListener('click', () => {
			panel1?.classList.add('hidden');
			panel2?.classList.remove('hidden');
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		btnAtras?.addEventListener('click', () => {
			panel2?.classList.add('hidden');
			panel1?.classList.remove('hidden');
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		// Mantener el resumen de la barra fija sincronizado con el plan elegido
		const planRadios =
			document.querySelectorAll<HTMLInputElement>('input[name="plan"]');
		const selectedName = document.getElementById('selected-plan-name');
		const selectedPrice = document.getElementById('selected-plan-price');

		function syncSelectedPlan() {
			const checked = document.querySelector<HTMLInputElement>(
				'input[name="plan"]:checked',
			);
			if (!checked) return;
			if (selectedName) {
				selectedName.textContent = checked.dataset.nombre ?? '';
			}
			if (selectedPrice) {
				selectedPrice.textContent = checked.dataset.price ?? '';
			}
		}

		planRadios.forEach((radio) => {
			radio.addEventListener('change', syncSelectedPlan);
		});
		syncSelectedPlan();

		btnPaso2?.addEventListener('click', async () => {
			const radio = document.querySelector(
				'input[name="plan"]:checked',
			) as HTMLInputElement | null;
			if (!radio) {
				alert('Por favor selecciona un plan antes de continuar.');
				return;
			}

			const empresaSelect = document.getElementById(
				'empresa-select',
			) as HTMLSelectElement | null;
			if (!empresaSelect || !empresaSelect.value) {
				alert('Por favor selecciona la empresa para la que vas a pagar.');
				return;
			}

			if (!userId) {
				alert('No se detectó tu sesión. Vuelve a iniciar sesión.');
				return;
			}

			const paySpinner = document.getElementById('pay-spinner');
			const payArrow = document.getElementById('pay-arrow');
			btnPaso2.disabled = true;
			btnPaso2.setAttribute('aria-busy', 'true');
			paySpinner?.classList.remove('hidden');
			payArrow?.classList.add('hidden');
			if (status) status.textContent = 'Redirigiendo a Stripe...';

			try {
				const res = await fetch('/api/payment/checkout-session', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						planId: radio.value,
						userId,
						empresaId: empresaSelect.value,
					}),
				});
				const data = await res.json();
				if (!res.ok || !data.url) {
					throw new Error(data.error || 'No se pudo iniciar el pago');
				}
				window.location.href = data.url;
			} catch (err) {
				console.error('[checkout]', err);
				if (status) {
					status.textContent =
						'No se pudo iniciar el pago. Intenta nuevamente.';
				}
				btnPaso2.disabled = false;
				btnPaso2.removeAttribute('aria-busy');
				paySpinner?.classList.add('hidden');
				payArrow?.classList.remove('hidden');
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener(
			'DOMContentLoaded',
			initIncorporacionPaymentFlow,
			{ once: true },
		);
	} else {
		initIncorporacionPaymentFlow();
	}

	document.addEventListener('astro:page-load', initIncorporacionPaymentFlow);
</script>
