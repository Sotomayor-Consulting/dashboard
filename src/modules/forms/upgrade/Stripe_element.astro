---
interface Props {
	stripePublishableKey: string;
	userId: string;
	isPaymentEnabled: boolean;
	UPGRADE_BASE_PRICE: string | number;
	PROCESSING_FEE_PERCENT: string | number;
	servicioUpgrade: servicioUpgradetype | null;
}

interface servicioUpgradetype {
	id_servicios: number;
	nombre: string;
	precio: number;
}

const {
	stripePublishableKey,
	userId,
	isPaymentEnabled,
	PROCESSING_FEE_PERCENT,
	servicioUpgrade,
}: Props = Astro.props;

const servicioUpgradeId = servicioUpgrade?.id_servicios ?? '';
const servicioUpgradePrecio = servicioUpgrade?.precio ?? 0;
---

<div
	class="dark:bg-black-900 row-start-2 mx-auto mt-10 mb-16 w-full place-self-center justify-self-center rounded-2xl border border-gray-200 bg-white/80 p-6 shadow-sm md:row-start-1 md:w-4/5 dark:border-neutral-800"
>
	<div
		id="stripe-config"
		data-pk={stripePublishableKey}
		data-user-id={userId}
		data-servicio-id={String(servicioUpgradeId)}
		data-base-price={String(servicioUpgradePrecio)}
		data-fee-percent={String(PROCESSING_FEE_PERCENT)}
		data-enabled={isPaymentEnabled ? 'true' : 'false'}
		class="hidden"
	>
	</div>

	<h3 class="mb-2 text-xl font-semibold text-gray-800 dark:text-neutral-100">
		Completa tu pago
	</h3>
	<p
		class="mb-4 text-base text-gray-600 dark:text-neutral-400"
		id="selected-plan-summary"
	>
		Estás pagando el upgrade de tu LLC.
	</p>

	<form id="payment-form" class="space-y-4">
		<div>
			<label
				class="mb-1 block text-sm font-medium text-gray-700 dark:text-neutral-300"
			>
				Datos de la tarjeta
			</label>
			<div
				id="card-element"
				class="dark:bg-black-800 rounded-lg border border-gray-300 bg-white p-3 text-neutral-700 dark:border-neutral-700"
			>
			</div>
			<p id="card-errors" class="mt-2 text-sm text-red-500"></p>
		</div>

		<p
			id="status-message"
			class="text-base text-gray-600 dark:text-neutral-300"
		>
		</p>

		{
			!isPaymentEnabled && (
				<p class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-200">
					No pudimos habilitar el pago del upgrade. Verifica que exista una
					empresa disponible y que Stripe este configurado.
				</p>
			)
		}

		<button
			type="submit"
			id="pay-button"
			class="bg-black-600 hover:bg-black-600/80 inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-sm font-medium text-white focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
			disabled={!isPaymentEnabled}
		>
			Pagar ahora
		</button>

		<button
			type="button"
			id="btn-back"
			class="dark:bg-black-900 mt-2 inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-700"
		>
			Volver a elegir empresa
		</button>
	</form>
</div>
