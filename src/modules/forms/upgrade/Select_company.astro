---
import type { empresasUpgrade } from './types';

interface Props {
	empresas: empresasUpgrade[];
}

const { empresas } = Astro.props;
---

<div class="relative flex h-[110vh] flex-col items-center pt-5" id="panel1">
	<div class="mx-auto mb-10 max-w-2xl text-center">
		<h3 class="text-3xl text-neutral-800 dark:text-white">
			Selecciona la empresa a incorporar
		</h3>
	</div>
	<div
		class="dark:bg-black-900 flex w-full flex-col items-center rounded-2xl border border-neutral-500 bg-white p-4 md:w-1/2 md:p-8 dark:border-neutral-800"
	>
		<p
			class="mt-2 mb-5 w-full text-left text-gray-800 lg:text-lg dark:text-neutral-200"
		>
			Lista de empresas
		</p>
		<select
			name="empresa"
			id="empresa-select"
			class="dark:bg-black-800 focus:border-black-600 focus:ring-black-600 mb-5 block w-full rounded-lg border-neutral-600 bg-gray-50 px-4 py-3 pe-9 text-sm disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:text-neutral-200 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
		>
			{
				empresas?.map((empresa) => (
					<option value={empresa.empresa_incorporacion_id}>
						{empresa.nombre_1}
					</option>
				))
			}
		</select>
		<button
			id="btn-paso1"
			class="bg-black-600 hover:bg-black-600/80 focus:bg-black-600/80 inline-flex w-fit items-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-center text-sm font-medium text-white focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
		>
			Continuar</button
		>
	</div>
</div>
