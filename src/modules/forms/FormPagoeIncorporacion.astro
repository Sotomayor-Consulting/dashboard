---
import Stripelogo from '@assets/stripe.svg';
import { Icon } from 'astro-icon/components';
import { getIncorporacionesEnProceso } from '@lib/tablas/companies/empresa_incorporaciones';
import { ListaServiciosStripe } from '@lib/tablas/services/servicios';

const User = Astro.locals.user;
const userId = User?.id || '';
const supabase = Astro.locals.supabase;
const stripePublishableKey =
	process.env.PUBLIC_STRIPE_PUBLISHABLE_KEY ??
	import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY ??
	'';

const [empresas, servicios] = await Promise.all([
	getIncorporacionesEnProceso(supabase, userId),
	ListaServiciosStripe(supabase),
]);

const planBasico = servicios?.find((s) => s.nombre === 'Plan Básico');
const planEstandar = servicios?.find((s) => s.nombre === 'Plan Estándar');
const planBusiness = servicios?.find((s) => s.nombre === 'Plan Business');
const planDiseno = servicios?.find((s) => s.nombre === 'Plan Diseño - upgrade');
---

<!-- ========== MAIN CONTENT ========== -->
<main id="content" class={userId}>
	<div class="overflow-hidden">
		<div class="relative flex h-[110vh] flex-col items-center pt-5" id="panel1">
			<div class="mx-auto mb-10 max-w-2xl text-center">
				<h3 class="text-3xl text-neutral-800 dark:text-white">
					Selecciona la empresa a incorporar
				</h3>
			</div>
			<div
				class="dark:bg-black-900 flex w-full flex-col items-center rounded-2xl border border-neutral-500 bg-white p-4 md:w-1/2 md:p-8 dark:border-neutral-800"
			>
				<p
					class="mt-2 mb-5 w-full text-left text-gray-800 lg:text-lg dark:text-neutral-200"
				>
					Lista de empresas
				</p>
				<select
					name="empresa"
					id="empresa-select"
					class="dark:bg-black-800 focus:border-black-600 focus:ring-black-600 mb-5 block w-full rounded-lg border-neutral-600 bg-gray-50 px-4 py-3 pe-9 text-sm disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-700 dark:text-neutral-200 dark:placeholder-neutral-500 dark:focus:ring-neutral-600"
				>
					{
						empresas?.map((empresa) => (
							<option value={empresa.empresa_incorporacion_id}>
								{empresa.nombre_1}
							</option>
						))
					}
				</select>
				<button
					id="btn-paso1"
					class="bg-black-600 hover:bg-black-600/80 focus:bg-black-600/80 inline-flex w-fit items-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-center text-sm font-medium text-white focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
				>
					Continuar</button
				>
			</div>
		</div>
		<div class="relative hidden" id="panel2">
			<div
				class="mx-auto max-w-340 px-4 pt-5 sm:px-6 lg:px-8 lg:pt-14"
				id="step-plans"
			>
				<!-- Title -->
				<div class="mx-auto mb-10 max-w-2xl text-center">
					<h3 class="text-3xl text-neutral-900 dark:text-white">
						Escoge tu plan
					</h3>
					<p class="mt-2 text-gray-800 lg:text-lg dark:text-neutral-200">
						Elije el plan que mas se adapte a tu negocio y necesidades
					</p>
				</div>

				<div
					class="mt-6 grid gap-3 md:mt-12 md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:items-center lg:gap-3 xl:gap-6"
					id="divActivo"
				>
					{
						planBasico && (
							<div>
								<input
									type="radio"
									id={planBasico.id_servicios}
									name="plan"
									value={planBasico.id_servicios}
									class="peer hidden"
									required
									data-price={planBasico.precio}
									data-servicio={planBasico.etiqueta}
								/>
								<label
									for={planBasico.id_servicios}
									class="dark:bg-black-900 dark:peer-checked:border-black-400 peer-checked:border-black-600 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planBasico.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planBasico.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planBasico.descripcion}
									</p>
									<ul class="mt-7 space-y-2.5 text-sm">
										{[
											'Incorporación de la LLC frente al Estado.',
											'Obtención del EIN (Número de Identificación Tributaria).',
											'Agente Residente por un año.',
										].map((li) => (
											<li class="flex gap-x-2">
												<Icon
													name="ri:check-line"
													class="text-black-600 mt-0.5 size-4 shrink-0"
												/>
												<span class="text-left text-gray-800 dark:text-neutral-400">
													{li}
												</span>
											</li>
										))}
									</ul>
								</label>
							</div>
						)
					}

					{
						planBusiness && (
							<div class="tarjeta-2">
								<input
									type="radio"
									id={planBusiness.id_servicios}
									name="plan"
									value={planBusiness.id_servicios}
									class="peer hidden"
									required
									checked
									data-price={planBusiness.precio}
									data-servicio={planBusiness.etiqueta}
								/>
								<label
									for={planBusiness.id_servicios}
									class="dark:bg-black-900 peer-checked:border-black-600 dark:peer-checked:border-black-400 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<p class="mb-3">
										<span class="bg-black-600 dark:bg-black-600 inline-flex animate-pulse items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-semibold text-white uppercase dark:text-white">
											Más popular
										</span>
									</p>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planBusiness.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planBusiness.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planBusiness.descripcion}
									</p>

									<ul class="mt-7 space-y-2.5 text-sm">
										<li class="flex gap-x-2">
											<span class="text-left text-gray-800 dark:text-neutral-300">
												Los beneficios del plan básico y Los beneficios del plan
												estándar, más:
											</span>
										</li>
										{[
											{
												label: 'Planificación y diseño legal - tributario.',
												icono: 'ri:star-s-fill',
											},
											{
												label:
													'Acompañamiento bancario (Mercury o Relay + Stripe).',
												icono: 'ri:star-line',
											},
											{
												label: 'EIN acelerado.',
												icono: 'ri:star-line',
											},
										].map((li) => (
											<li class="flex gap-x-2">
												<Icon
													name={li.icono}
													class="text-black-600 mt-0.5 size-4 shrink-0"
												/>
												<span class="text-left text-gray-800 dark:text-neutral-400">
													{li.label}
												</span>
											</li>
										))}
									</ul>
								</label>
							</div>
						)
					}

					{
						planEstandar && (
							<div class="tarjeta-3">
								<input
									type="radio"
									id={planEstandar.id_servicios}
									name="plan"
									value={planEstandar.id_servicios}
									class="peer hidden"
									required
									data-price={planEstandar.precio}
									data-servicio={planEstandar.etiqueta}
								/>
								<label
									for={planEstandar.id_servicios}
									class="dark:bg-black-900 peer-checked:border-black-600 dark:peer-checked:border-black-400 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planEstandar.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planEstandar.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planEstandar.descripcion}
									</p>

									<ul class="mt-7 space-y-2.5 text-sm">
										<li class="flex gap-x-2">
											<span class="text-left text-gray-800 dark:text-neutral-300">
												Los beneficios del Plan Básico más:
											</span>
										</li>
										{[
											'Elaboración del Acuerdo de Operación.',
											'Consultas ilimitadas por un año.',
											'Solicitud de Exención BE-13',
										].map((li) => (
											<li class="flex gap-x-2">
												<Icon
													name="ri:check-line"
													class="text-black-600 mt-0.5 size-4 shrink-0"
												/>
												<span class="text-left text-gray-800 dark:text-neutral-400">
													{li}
												</span>
											</li>
										))}
									</ul>
								</label>
							</div>
						)
					}
				</div>

				<div
					class="diseño-contenedor mt-6 grid gap-3 md:mt-12 md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:items-center lg:gap-3 xl:gap-6"
					id="divInactivo"
				>
					{
						planDiseno && (
							<div class="tarjeta-4 col-start-2">
								<input
									type="radio"
									id={planDiseno.id_servicios}
									name="plan"
									value={planDiseno.id_servicios}
									class="peer hidden"
									required
									data-price={planDiseno.precio}
									data-servicio={planDiseno.etiqueta}
								/>
								<label
									for={planDiseno.id_servicios}
									class="dark:bg-black-900 peer-checked:border-black-600 dark:peer-checked:border-black-400 flex cursor-pointer flex-col rounded-2xl border border-gray-200 bg-white p-4 text-center md:p-8 dark:border-neutral-800"
								>
									<div class="col-span-2 mt-2">
										<button
											class="flex h-full items-end justify-end place-self-end text-neutral-700 dark:text-white"
											data-popover-target="popover-description4"
											data-popover-placement="right"
											type="button"
										>
											<svg
												xmlns="http://www.w3.org/2000/svg"
												width="20"
												height="20"
												viewBox="0 0 24 24"
											>
												<g fill="none">
													<>
														<path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z" />
														<path
															fill="currentColor"
															d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 14a1 1 0 1 0 0 2a1 1 0 0 0 0-2m0-9.5a3.625 3.625 0 0 0-3.625 3.625a1 1 0 1 0 2 0a1.625 1.625 0 1 1 2.23 1.51c-.676.27-1.605.962-1.605 2.115V14a1 1 0 1 0 2 0c0-.244.05-.366.261-.47l.087-.04A3.626 3.626 0 0 0 12 6.5"
														/>
													</>
												</g>
											</svg>
										</button>
									</div>

									<div
										data-popover
										id="popover-description4"
										role="tooltip"
										class="dark:bg-black-800 invisible absolute z-10 inline-block w-96 rounded-lg border border-gray-200 bg-white text-sm text-gray-500 opacity-0 shadow-xs transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
									>
										<div class="space-y-2 p-3">
											<h3 class="font-semibold text-gray-900 dark:text-white">
												¿Que es el plan de diseño - upgrade?
											</h3>
											<p class="grid grid-cols-[auto,1fr] text-left">
												<span>
													No todas las LLC son iguales. Para que una LLC
													realmente le sirva, debe diseñarse a medida según su
													giro de negocio, nacionalidad, residencia fiscal y
													número de socios.
													<br />
													En la práctica, hay 5 decisiones clave que determinan
													cómo quedará estructurada su LLC:
												</span>
											</p>
											<p class="ml-2 grid gap-2 text-left">
												{[
													'- Estado de incorporación (50 jurisdicciones posibles).',
													'- Tratamiento tributario federal que más le conviene (2 alternativas principales).',
													'- Modelo administrativo y de gestión (2 esquemas típicos, según quién administre y cómo se tomen decisiones).',
													'- Sistema contable que utilizará (2 bases contables usuales, según su operación y necesidades).',
													'- Nivel de confidencialidad: si desea o no que terceros puedan identificar a los socios/beneficiarios en registros públicos (según lo permita la normativa aplicable).',
												].map((items) => (
													<span>{items}</span>
												))}
											</p>
											<p class="text-left">
												<span>
													<b>
														Para definir estas decisiones con criterio y evitar
														errores costosos, es necesario asesorarse.
													</b>
												</span>
											</p>
											<p class="text-left">
												<span>
													<b>
														El servicio de Planificación, Diseño y Legal de LLC
														consiste en una o más reuniones con un abogado
														tributario para analizar su caso y establecer la
														estructura óptima.
													</b>
												</span>
											</p>
											<p class="text-left">
												<span>
													<b>*Entregable:</b> un informe técnico donde se
													detallan, de forma clara y aplicada a su situación,
													las características con las que recomendamos
													incorporar su LLC y los lineamientos para
													implementarlas correctamente.
												</span>
											</p>
										</div>
										<div data-popper-arrow />
									</div>
									<h4 class="text-lg font-medium text-gray-800 dark:text-neutral-200">
										{planDiseno.nombre}
									</h4>
									<span class="mt-7 text-3xl font-bold text-gray-800 md:text-4xl xl:text-5xl dark:text-neutral-200">
										${planDiseno.precio}
									</span>
									<p class="mt-2 text-sm text-gray-500 dark:text-neutral-500">
										{planDiseno.descripcion}
									</p>

									<ul class="mt-7 space-y-2.5 text-sm">
										<li class="flex gap-x-2">
											<Icon
												name="ri:check-line"
												class="text-black-600 mt-0.5 size-4 shrink-0"
											/>
											<span class="text-left text-gray-800 dark:text-neutral-400">
												Planificación y diseño de LLC
											</span>
										</li>
									</ul>
								</label>
							</div>
						)
					}
				</div>
				<div class="mt-10 flex items-center justify-center gap-4">
					<button
						type="button"
						id="btn-atras"
						class="focus:bg-black-600/80 inline-flex w-fit items-center gap-x-2 rounded-lg border border-transparent bg-zinc-500 px-4 py-3 text-sm font-medium text-white hover:bg-zinc-600 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
					>
						Regresar
					</button>
					<button
						id="btn-paso2"
						class="bg-black-600 hover:bg-black-600/80 focus:bg-black-600/80 inline-flex w-fit items-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-center text-sm font-medium text-white focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
					>
						Continuar</button
					>
				</div>
			</div>
		</div>
		<div class="relative hidden" id="panel3">
			<div id="step-payment" class="grid md:grid-cols-2">
				<div
					class="dark:bg-black-900 row-start-2 mx-auto mt-10 mb-16 w-full place-self-center justify-self-center rounded-2xl border border-gray-200 bg-white/80 p-6 shadow-sm md:row-start-1 md:w-4/5 dark:border-neutral-800"
				>
					<div
						id="stripe-config"
						data-pk={stripePublishableKey}
						data-id={userId}
						class="hidden"
					>
					</div>
					<h3
						class="mb-2 text-xl font-semibold text-gray-800 dark:text-neutral-100"
					>
						Completa tu pago
					</h3>
					<p
						class="mb-4 text-base text-gray-600 dark:text-neutral-400"
						id="selected-plan-summary"
					>
						Estás pagando el plan seleccionado.
					</p>

					<form id="payment-form" class="space-y-4">
						<div>
							<label
								class="mb-1 block text-sm font-medium text-gray-700 dark:text-neutral-300"
							>
								Datos de la tarjeta
							</label>
							<div
								id="card-element"
								class="dark:bg-black-800 rounded-lg border border-gray-300 bg-white p-3 text-neutral-700 dark:border-neutral-700"
							>
							</div>
							<p id="card-errors" class="mt-2 text-sm text-red-500"></p>
						</div>
						<p
							id="status-message"
							class="text-base text-gray-600 dark:text-neutral-300"
						>
						</p>

						<button
							type="submit"
							id="pay-button"
							class="bg-black-600 hover:bg-black-600/80 inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent px-4 py-3 text-sm font-medium text-white focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
						>
							Pagar ahora
						</button>

						<button
							type="button"
							id="btn-back"
							class="dark:bg-black-900 mt-2 inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-700"
						>
							Volver a elegir plan
						</button>
					</form>
				</div>

				<div class="mt-10 mb-16 w-full grow md:w-3/5">
					<div
						id="price-summary"
						class="dark:bg-black-900 space-y-4 rounded-lg border border-gray-100 bg-gray-50 p-6 dark:border-gray-700"
					>
						<div class="space-y-2">
							<dl class="flex items-center justify-between gap-4">
								<dt
									class="text-base font-normal text-gray-500 dark:text-gray-400"
								>
									Precio del plan
								</dt>
								<dd
									id="summary-base"
									class="text-base font-medium text-gray-900 dark:text-white"
								>
									$0.00
								</dd>
							</dl>

							<dl class="flex items-center justify-between gap-4">
								<dt
									class="text-base font-normal text-gray-500 dark:text-gray-400"
								>
									Tarifas de procesamiento
								</dt>
								<dd
									id="summary-fee"
									class="text-base font-medium text-gray-900 dark:text-white"
								>
									$0.00
								</dd>
							</dl>
						</div>

						<dl
							class="flex items-center justify-between gap-4 border-t border-gray-200 pt-2 dark:border-gray-700"
						>
							<dt class="text-base font-bold text-gray-900 dark:text-white">
								Total
							</dt>
							<dd
								id="summary-total"
								class="text-base font-bold text-gray-900 dark:text-white"
							>
								$0.00
							</dd>
						</dl>
					</div>

					<div class="mt-6 flex items-center justify-center gap-2">
						<p class="text-base font-normal text-gray-500 dark:text-gray-400">
							Pago seguro gestionado por:
						</p>
						<Stripelogo width={80} />
					</div>
				</div>
			</div>
		</div>
	</div>
</main>

<script id="stripe-js" src="https://js.stripe.com/v3/"></script>

<script is:inline>
	function initIncorporacionPaymentConfig() {
		const cfg = document.getElementById('stripe-config');
		if (!cfg || cfg.dataset.paymentConfigInitialized === 'true') return;

		if (typeof window.Stripe !== 'function') {
			const stripeScript = document.getElementById('stripe-js');
			if (stripeScript && cfg.dataset.paymentConfigWaiting !== 'true') {
				cfg.dataset.paymentConfigWaiting = 'true';
				stripeScript.addEventListener('load', initIncorporacionPaymentConfig, {
					once: true,
				});
			}
			return;
		}

		cfg.dataset.paymentConfigInitialized = 'true';

		// --- NUEVO: toggle de facturación (mostrar/ocultar y required) ---
		const facturaCheckbox = document.getElementById('factura-checkbox');
		const contFacturacion = document.getElementById('contenedor-facturacion');
		function setBillingRequired(on) {
			if (!contFacturacion) return;
			const fields = contFacturacion.querySelectorAll(
				'input, select, textarea',
			);
			fields.forEach((el) => {
				el.required = !!on;
			});
		}
		if (facturaCheckbox && contFacturacion) {
			// estado inicial
			contFacturacion.classList.toggle('hidden', !facturaCheckbox.checked);
			setBillingRequired(facturaCheckbox.checked);
			// cambio
			facturaCheckbox.addEventListener('change', () => {
				const on = facturaCheckbox.checked;
				contFacturacion.classList.toggle('hidden', !on);
				setBillingRequired(on);
			});
		}
		// --- FIN NUEVO ---

		// 1) Config Stripe
		const pk = cfg.dataset.pk;
		const userId = cfg.dataset.id; // user_id del dataset
		if (!pk || !userId) {
			console.error('Stripe publishable key or user ID missing', {
				hasPublishableKey: Boolean(pk),
				hasUserId: Boolean(userId),
			});
			return;
		}

		// 2) Inicializar Stripe y Elements
		const stripe = window.Stripe(pk);
		const elements = stripe.elements();
		const cardElement = elements.create('card', {
			hidePostalCode: true,
			style: {
				base: {
					color: '#88898a',
					fontFamily:
						'"Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
					fontSize: '14px',
					'::placeholder': { color: '#9ca3af' },
					iconColor: '#facc15',
				},
				invalid: { color: '#f97373', iconColor: '#f97373' },
			},
		});
		cardElement.mount('#card-element');

		// Exponer para el segundo script
		window.stripeInstance = stripe;
		window.cardElementInstance = cardElement;
		window.userIdGlobal = userId;

		// 3) DOM refs
		const btnContinue = document.getElementById('btn-continue');
		const btnBack = document.getElementById('btn-back');
		const stepPayment = document.getElementById('step-payment');
		const paymentForm = document.getElementById('payment-form');
		const cardErrors = document.getElementById('card-errors');
		const statusMessage = document.getElementById('status-message');
		const payButton = document.getElementById('pay-button');
		const planSummary = document.getElementById('selected-plan-summary');

		// Resumen de precios
		const baseEl = document.getElementById('summary-base');
		const feeEl = document.getElementById('summary-fee');
		const totalEl = document.getElementById('summary-total');

		// selector de empresa (ya existía)
		const empresaSelect = document.getElementById('empresa-select');

		let currentClientSecret = null;

		// Helpers selección plan/empresa
		function getSelectedPlan() {
			const radio = document.querySelector('input[name="plan"]:checked');
			if (!radio) return null;
			const label = radio.closest('label') || radio.parentElement;
			const titleEl = label ? label.querySelector('h4') : null;
			const rawPrice = radio.dataset.price;
			const price = rawPrice ? parseFloat(rawPrice) : NaN;
			return {
				id: radio.value,
				label: titleEl ? titleEl.textContent.trim() : 'Plan seleccionado',
				price,
			};
		}
		function getSelectedEmpresaId() {
			if (!empresaSelect) return null;
			const v = empresaSelect.value;
			return v && v.length ? v : null;
		}
		function getSelectedEmpresaLabel() {
			if (!empresaSelect) return null;
			const opt = empresaSelect.options[empresaSelect.selectedIndex];
			return opt ? opt.textContent.trim() : null;
		}

		// Resumen precios
		function formatUSD(amount) {
			if (!Number.isFinite(amount)) return '$0.00';
			return '$' + amount.toFixed(2);
		}

		function updatePriceSummary(plan) {
			console.log('DEBUG updatePriceSummary:', plan);
			if (!plan || !Number.isFinite(plan.price)) {
				baseEl.textContent = '$0.00';
				feeEl.textContent = '$0.00';
				totalEl.textContent = '$0.00';
				return;
			}

			const base = plan.price;
			const feePercent = 0.045;
			const fee = base * feePercent;
			const total = base + fee;

			// Actualizar el texto del resumen
			let summaryText = `Estás pagando: ${plan.label}`;

			const empresaLabel = getSelectedEmpresaLabel();
			if (empresaLabel) {
				summaryText += ` | Empresa: ${empresaLabel}`;
			}

			planSummary.textContent = summaryText;

			baseEl.textContent = formatUSD(plan.price);
			feeEl.textContent = formatUSD(fee);
			totalEl.textContent = formatUSD(total);
		}

		// Crear PaymentIntent
		async function createPaymentIntent(planId, userId, empresaId) {
			statusMessage.textContent = 'Preparando el pago...';
			payButton.disabled = true;
			try {
				const res = await fetch('/api/payment/payment-intent', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						planId,
						userId,
						empresaId,
					}),
				});
				const data = await res.json();
				if (!res.ok || !data.clientSecret)
					throw new Error(data.error || 'Error al crear el pago');
				currentClientSecret = data.clientSecret;
				statusMessage.textContent = 'Ingresa los datos de tu tarjeta.';
			} catch (err) {
				console.error(err);
				statusMessage.textContent =
					'No se pudo preparar el pago. Intenta nuevamente.';
			} finally {
				payButton.disabled = false;
			}
		}

		// --- NUEVO: recolectar datos de facturación con TUS IDs actuales ---
		function getBillingPayload() {
			const personaEl = document.querySelector(
				'input[name="bill-legal-type"]:checked',
			);
			return {
				userId,
				empresaId: getSelectedEmpresaId(),
				persona: personaEl ? personaEl.value : '', // "natural" | "juridica"
				nombre_razon:
					document.getElementById('bill-razon')?.value?.trim() || '',
				email: document.getElementById('bill-email')?.value?.trim() || '',
				telefono_codigo:
					document.getElementById('bill-phone-country')?.value || '', // ej. "+593"
				telefono_numero:
					document.getElementById('bill-phone')?.value?.trim() || '',
				id_tipo: document.getElementById('bill-id-type')?.value || '', // "Cedula", "RUC", etc.
				id_numero:
					document.getElementById('bill-id-number')?.value?.trim() || '',
				direccion:
					document.getElementById('bill-address1')?.value?.trim() || '',
				ciudad: document.getElementById('bill-city')?.value?.trim() || '',
				pais: document.getElementById('bill-country')?.value || '', // ISO del país
			};
		}
		async function enviarFacturacion(payload) {
			try {
				const res = await fetch('/api/facturacion/upsert', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const data = await res.json();
				if (!res.ok) {
					console.error('[Billing] error:', data);
					return false;
				}
				return true;
			} catch (e) {
				console.error('[Billing] network error:', e);
				return false;
			}
		}
		// --- FIN NUEVO ---
	}

	if (document.readyState === 'loading') {
		document.addEventListener(
			'DOMContentLoaded',
			initIncorporacionPaymentConfig,
			{
				once: true,
			},
		);
	} else {
		initIncorporacionPaymentConfig();
	}

	document.addEventListener('astro:page-load', initIncorporacionPaymentConfig);
</script>

<script>
	function initIncorporacionPaymentFlow() {
		const root = document.getElementById('content');
		if (!root || root.dataset.paymentFlowInitialized === 'true') return;
		root.dataset.paymentFlowInitialized = 'true';

		const boton = document.getElementById('btn-paso1');
		const regresar = document.getElementById('btn-atras');
		const boton2 = document.getElementById('btn-paso2');
		const div2 = document.getElementById('panel2');
		const div1 = document.getElementById('panel1');

		boton?.addEventListener('click', function () {
			div1?.classList.add('hidden');
			div2?.classList.remove('hidden');
		});

		regresar?.addEventListener('click', function () {
			div2?.classList.add('hidden');
			div1?.classList.remove('hidden');
		});

		boton2?.addEventListener('click', function () {
			const radio = document.querySelector(
				'input[name="plan"]:checked',
			) as HTMLInputElement | null;
			if (!radio) {
				alert('Por favor selecciona un plan antes de continuar.');
				return;
			}
			const label = radio.closest('label') || radio.parentElement;
			const titleEl = label ? label.querySelector('h4') : null;
			const rawPrice = radio.dataset.price;
			const price = rawPrice ? parseFloat(rawPrice) : NaN;
			const plan = {
				id: radio.value,
				label: titleEl ? titleEl.textContent.trim() : 'Plan seleccionado',
				price,
			};

			const empresaSelect = document.getElementById(
				'empresa-select',
			) as HTMLSelectElement | null;
			if (!empresaSelect || !empresaSelect.value) {
				alert('Por favor selecciona la empresa para la que vas a pagar.');
				return;
			}
			const empresaId = empresaSelect.value;
			const empresaLabel =
				empresaSelect.options[
					empresaSelect.selectedIndex
				]?.textContent?.trim() || '';

			const planSummary = document.getElementById('selected-plan-summary');
			const baseEl = document.getElementById('summary-base');
			const feeEl = document.getElementById('summary-fee');
			const totalEl = document.getElementById('summary-total');

			const empresaInfo = empresaLabel ? ` | Empresa: ${empresaLabel}` : '';
			if (planSummary)
				planSummary.textContent = `Estás pagando: ${plan.label}${empresaInfo}`;

			if (!plan || !Number.isFinite(plan.price)) {
				if (baseEl) baseEl.textContent = '$0.00';
				if (feeEl) feeEl.textContent = '$0.00';
				if (totalEl) totalEl.textContent = '$0.00';
			} else {
				const base = plan.price;
				const feePercent = 0.045;
				const fee = base * feePercent;
				const total = base + fee;
				if (baseEl) baseEl.textContent = '$' + base.toFixed(2);
				if (feeEl) feeEl.textContent = '$' + fee.toFixed(2);
				if (totalEl) totalEl.textContent = '$' + total.toFixed(2);
			}

			const statusMessage = document.getElementById('status-message');
			const payButton = document.getElementById(
				'pay-button',
			) as HTMLButtonElement | null;
			const cfg = document.getElementById('stripe-config');
			const userId = cfg?.dataset.id;

			async function createPaymentIntentAndShow() {
				if (statusMessage) statusMessage.textContent = 'Preparando el pago...';
				if (payButton) payButton.disabled = true;
				try {
					const res = await fetch('/api/payment/payment-intent', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							planId: plan.id,
							userId,
							empresaId,
						}),
					});
					const data = await res.json();
					if (!res.ok || !data.clientSecret)
						throw new Error(data.error || 'Error al crear el pago');
					(window as any).currentClientSecret = data.clientSecret;
					if (statusMessage)
						statusMessage.textContent = 'Ingresa los datos de tu tarjeta.';
				} catch (err) {
					console.error(err);
					if (statusMessage)
						statusMessage.textContent =
							'No se pudo preparar el pago. Intenta nuevamente.';
				} finally {
					if (payButton) payButton.disabled = false;
				}
			}

			createPaymentIntentAndShow();

			div2?.classList.add('hidden');
			document.getElementById('panel3')?.classList.remove('hidden');
			document.getElementById('step-payment')?.classList.remove('hidden');
		});

		const btnBack = document.getElementById('btn-back');
		btnBack?.addEventListener('click', function () {
			document.getElementById('step-payment')?.classList.add('hidden');
			document.getElementById('panel3')?.classList.add('hidden');
			div2?.classList.remove('hidden');
		});

		const paymentForm = document.getElementById('payment-form');
		const statusMessage = document.getElementById('status-message');
		const cardErrors = document.getElementById('card-errors');
		const payButton = document.getElementById(
			'pay-button',
		) as HTMLButtonElement | null;

		if (paymentForm) {
			paymentForm.addEventListener('submit', async (event) => {
				event.preventDefault();

				const stripe = (window as any).stripeInstance;
				const cardElement = (window as any).cardElementInstance;
				if (!stripe || !cardElement) {
					if (statusMessage) {
						statusMessage.textContent =
							'El formulario de pago aun no esta listo. Espera un momento e intenta nuevamente.';
					}
					if (cardErrors) {
						cardErrors.textContent =
							'No se pudo inicializar Stripe correctamente.';
					}
					return;
				}

				const currentClientSecret = (window as any).currentClientSecret;
				if (!currentClientSecret) {
					if (statusMessage)
						statusMessage.textContent =
							'El pago no está listo. Vuelve a intentar (elige el plan de nuevo).';
					return;
				}

				if (payButton) payButton.disabled = true;
				if (statusMessage) statusMessage.textContent = 'Procesando pago...';
				if (cardErrors) cardErrors.textContent = '';

				try {
					const { error, paymentIntent } = await stripe.confirmCardPayment(
						currentClientSecret,
						{ payment_method: { card: cardElement } },
					);

					if (error) {
						console.error(error);
						if (cardErrors)
							cardErrors.textContent =
								error.message || 'Error al procesar el pago.';
						if (statusMessage)
							statusMessage.textContent =
								'No se pudo completar el pago. Intenta nuevamente.';
						if (payButton) payButton.disabled = false;
						return;
					}

					if (paymentIntent && paymentIntent.status === 'succeeded') {
						if (statusMessage)
							statusMessage.textContent =
								'Pago realizado con éxito. Registrando la información...';

						const res = await fetch('/api/payment/register', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ paymentIntentId: paymentIntent.id }),
						});
						const data = await res.json();
						console.log('Register response:', { status: res.status, data });
						if (!res.ok) {
							console.error('Error registrando pago en BD:', data);
							if (statusMessage)
								statusMessage.textContent =
									'El pago se realizó, pero hubo un problema registrándolo internamente. Nuestro equipo lo revisará. Error: ' +
									(data.error || JSON.stringify(data));
							if (payButton) payButton.disabled = false;
							return;
						} else {
							console.log('Pago registrado en BD:', data);
							if (statusMessage)
								statusMessage.textContent =
									'Pago realizado con éxito. Estamos iniciando el proceso de incorporación de tu LLC.';
						}

						window.location.href = '/';
					} else {
						if (statusMessage)
							statusMessage.textContent =
								'No se pudo completar el pago. Intenta nuevamente.';
						if (payButton) payButton.disabled = false;
					}
				} catch (err) {
					console.error(err);
					if (statusMessage)
						statusMessage.textContent = 'Ocurrió un error al procesar el pago.';
					if (payButton) payButton.disabled = false;
				}
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener(
			'DOMContentLoaded',
			initIncorporacionPaymentFlow,
			{
				once: true,
			},
		);
	} else {
		initIncorporacionPaymentFlow();
	}

	document.addEventListener('astro:page-load', initIncorporacionPaymentFlow);
</script>
