---
import { Image } from 'astro:assets';
import imagen from '@assets/g31.avif';
import { FormsEnviadosForId } from '@lib/tablas/formulariosEnviados';
import { Icon } from 'astro-icon/components';

const user = Astro.locals.user;
const userId = user?.id;
const supabase = Astro.locals.supabase;
const formularios = userId ? await FormsEnviadosForId(supabase, userId) : null;
---

<div class="mb-10">
	<div class="grid grid-cols-1 px-4 pt-6 xl:gap-4">
		<div class="col-span-full mb-4 xl:mb-2">
			<nav class="mb-5 flex" aria-label="Breadcrumb">
				<ol
					class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
				>
					<li class="inline-flex items-center">
						<a
							href="/"
							class="dark:hover:text-primary-500 inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300"
						>
							<svg
								class="mr-2.5 h-5 w-5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
								></path></svg
							>
							Inicio
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="h-6 w-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"></path></svg
							>
							<span
								class="ml-1 text-gray-400 md:ml-2 dark:text-gray-500"
								aria-current="page">Tus documentos</span
							>
						</div>
					</li>
				</ol>
			</nav>
			<h1
				class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
			>
				Tus documentos
			</h1>
			<h3 class="mt-5 text-gray-400 md:ml-2 dark:text-gray-300">Formularios</h3>
		</div>
		<!-- Right Content -->
		<div class="grid gap-2 md:grid-cols-2 xl:grid-cols-3">
			{
				(formularios?.length ?? 0) === 0 ? (
					<div class="col-span-3 flex flex-col items-center rounded-lg p-6 text-center text-gray-600 dark:text-gray-300">
						<h3 class="mb-5 text-lg font-semibold">
							No tienes formularios o documentos aún
						</h3>
						<Image
							src={imagen}
							class="my-20 opacity-50"
							alt="test"
							width={400}
							height={400}
							loading={'eager'}
						/>
					</div>
				) : (
					formularios?.map((fr) => (
						<div class="dark:bg-black-800 bg-white-50 border-default rounded-base block max-w-sm justify-self-center border shadow-xs">
							<a href={`/forms/enviados/${fr.submission_id}`}>
								<Image
									class="rounded-t-base"
									src="https://images.unsplash.com/photo-1732408425578-464d66066441?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
									alt={`imagen de formulario ${fr.formularios.titulo}`}
									inferSize={true}
									loading={'eager'}
								/>
							</a>
							<a
								href={`/forms/enviados/${fr.submission_id}`}
								class="flex w-full flex-col items-center gap-2 p-6 text-center"
							>
								<span class="bg-success-soft border-success-subtle text-fg-success inline-flex w-fit items-center rounded-sm border px-1.5 py-0.5 text-xs font-medium">
									<Icon name="ri:checkbox-circle-line" class="me-1 text-base" />
									Terminado
								</span>

								<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
									{fr.formularios.titulo}
								</h5>
								<p class="mb-3 font-normal text-gray-700 dark:text-gray-400">
									{fr.formularios.descripcion}
								</p>
							</a>
							<div class="mr-2 mb-2 flex w-full justify-end">
								<button
									id="dropdownMenuIconButton"
									data-dropdown-toggle={fr.submission_id}
									class="text-heading focus:ring-neutral-tertiary rounded-base group box-border border border-transparent p-2 text-sm font-medium"
									type="button"
								>
									<Icon
										name="ri:more-2-fill"
										class="group-hover:text-white-400 text-2xl group-hover:scale-105"
									/>
								</button>

								<div
									id={fr.submission_id}
									class="dark:bg-black-800 bg-white-50 border-default-medium rounded-base z-10 hidden w-44 border shadow-lg"
								>
									<ul
										class="text-body p-2 text-sm font-medium"
										aria-labelledby="dropdownMenuIconButton"
									>
										<li>
											<a
												href={`/forms/enviados/${fr.submission_id}`}
												target="_blank"
												class="hover:bg-neutral-tertiary-medium hover:text-heading inline-flex w-full items-center rounded p-2"
											>
												Ver respuestas
											</a>
										</li>
										<li>
											<a
												href="#"
												class="hover:bg-neutral-tertiary-medium hover:text-heading inline-flex w-full items-center rounded p-2"
											>
												Descargar pdf
											</a>
										</li>
									</ul>
								</div>
							</div>
						</div>
					))
				)
			}
		</div>
	</div>
	<hr
		class="mx-auto my-4 h-1 w-48 rounded-sm border-0 bg-gray-100 md:my-10 dark:bg-gray-700"
	/>
</div>
