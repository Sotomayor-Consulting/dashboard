---
import WhatsappBtn from '@components/display/WhatsappBtn.astro';
---

<WhatsappBtn />
<!--Modal --><!-- Main modal -->
<div
	id="modalCard"
	aria-hidden="true"
	class="bg-opacity-70 fixed top-0 right-0 left-0 z-50 hidden h-full max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto bg-neutral-800 md:inset-0"
>
	<div class="relative w-full max-w-screen-lg p-4">
		<!-- Modal content -->
		<div class="dark:bg-black-900 relative rounded-lg bg-white shadow-sm">
			<!-- Modal header -->
			<div
				class="flex items-center justify-between rounded-t p-4 md:p-5 dark:border-gray-600"
			>
				<button
					type="button"
					id="closeBtn"
					class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
				>
					<svg
						class="h-3 w-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 14 14"
					>
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
					</svg>
					<span class="sr-only">Close modal</span>
				</button>
			</div>
			<!-- Modal body -->
			<div
				class="flex-col items-center justify-center space-y-4 p-4 text-center md:p-5"
			>
				<h3
					class="mx-auto mb-10 w-4/5 text-center text-3xl font-semibold text-gray-900 md:w-3/5 dark:text-white"
				>
					Encuentre el tipo de entidad adecuado para su negocio
				</h3>
				<p
					class="mx-auto my-10 w-4/5 text-justify text-lg leading-relaxed text-gray-500 md:w-3/5 dark:text-gray-400"
				>
					La elección de tu entidad legal es el primer gran paso. Evita riesgos
					fiscales y legales. Nuestros consultores te brindan una asesoría
					gratuita para identificar la mejor opción para tu negocio, asegurando
					un crecimiento sólido y protegido en EE. UU.
				</p>
				<div class="mt-10 flex h-full w-full justify-center text-white">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="100"
						height="100"
						viewBox="0 0 24 24"
						><g fill="none"
							><path
								fill="currentColor"
								d="M2 9c0-1.886 0-2.828.586-3.414S4.114 5 6 5h12c1.886 0 2.828 0 3.414.586S22 7.114 22 9c0 .471 0 .707-.146.854C21.707 10 21.47 10 21 10H3c-.471 0-.707 0-.854-.146C2 9.707 2 9.47 2 9m0 9c0 1.886 0 2.828.586 3.414S4.114 22 6 22h12c1.886 0 2.828 0 3.414-.586S22 19.886 22 18v-5c0-.471 0-.707-.146-.854C21.707 12 21.47 12 21 12H3c-.471 0-.707 0-.854.146C2 12.293 2 12.53 2 13z"
							></path><path
								stroke="currentColor"
								stroke-linecap="round"
								stroke-width="2"
								d="M7 3v3m10-3v3"></path></g
						></svg
					>
				</div>
			</div>
			<!-- Modal footer -->
			<div
				class="flex items-center justify-center rounded-b p-4 md:p-5 dark:border-gray-600"
			>
				<a
					type="button"
					href=""
					class="w-3/5 rounded-lg px-5 py-2.5 text-center text-base font-medium text-white focus:ring-4 focus:ring-neutral-500 focus:outline-none dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-neutral-500"
					>Agendar una cita</a
				>
			</div>

			<div class="h-[50px]"></div>
		</div>
	</div>
</div>

<div class="my-8 flex w-full items-center justify-center">
	<div class="ml-5 hidden w-full lg:flex lg:min-h-[700px] lg:flex-col">
		<div class="mt-16">
