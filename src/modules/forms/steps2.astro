				</div>
				<ul class="grid w-full place-items-center gap-6">
					<li class="w-4/5 md:w-3/5">
						<input
							type="radio"
							id="LLC_radio_btn"
							name="tipo_de_empresa"
							value="LLC"
							class="peer hidden"
