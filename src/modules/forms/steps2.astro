							for="LLC_radio_btn"
							class="dark:bg-black-900 inline-flex w-full cursor-pointer items-center justify-between rounded-lg border p-5 peer-checked:border-[#8c681d] peer-checked:text-[#8c681d] hover:bg-gray-100 hover:text-gray-600 dark:border-gray-700 dark:text-gray-400 dark:peer-checked:border-[#8c681d] dark:peer-checked:bg-[#1d1d1d] dark:peer-checked:text-[#8c681d] dark:hover:bg-[#1d1d1d] dark:hover:text-white"
