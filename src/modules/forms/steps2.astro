				>
					<div
						id="stepdiv1-1"
						class="relative z-10 flex w-full items-center gap-3.5 rounded-xl border border-[#8c681d] bg-neutral-800 p-3.5 text-left"
					>
						<div
							id="stepdiv2-1"
							class="flex items-center justify-center rounded-lg bg-[#8c681d]"
