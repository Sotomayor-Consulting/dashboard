---
import { getReferidos } from '@lib/tablas/partners/referidos';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const UserId = user?.id;

const rows = UserId ? await getReferidos(supabase, UserId) : null;

const referidosSupabase = (rows ?? []).map((r) => ({
	name:
		`${r.referido[0]?.nombre ?? ''} ${r.referido[0]?.apellido ?? ''}`.trim() ||
		'—',
	email: r.referido[0]?.correo ?? '—',
	avatar: r.referido[0]?.avatar_url ?? null,
	code: r.code,
	fecha: r.created_at,
	estado: r.referido[0]?.estado,
	fuente: 'Supabase',
}));
type Referral = {
	name: string;
	email?: string | null;
	create_date?: string;
	avatar?: string | null;
	fuente?: string;
};

let referrals: Referral[] = [];
let errorMsg = '';
let loading = true;

try {
	const apiUrl = new URL('/api/odoo/referrals', Astro.request.url);

	// 2) Pasar las cookies del request actual al endpoint
	const res = await fetch(apiUrl.toString(), {
		headers: {
			cookie: Astro.request.headers.get('cookie') ?? '',
		},
	});

	if (!res.ok) {
		errorMsg = 'Sistema ERP no disponible temporalmente.';
	} else {
		const { success, data } = await res.json();

		if (!success) {
			errorMsg = 'Sistema ERP no disponible temporalmente.';
		} else {
			referrals = data ?? [];
		}
	}
} catch (err) {
	errorMsg = 'No se pudo conectar con el ERP.';
} finally {
	loading = false;
}

// Combinar datos de Odoo y Supabase
const referidosOdoo = referrals.map((r) => ({
	name: r.name,
	email: r.email,
	avatar: r.avatar || null,
	fecha: r.create_date,
	fuente: 'Odoo',
}));

const referidosCombinados = [...referidosSupabase, ...referidosOdoo].sort(
	(a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime(),
);
---

<div class="px-4 pt-6">
	<div class="grid gap-4 xl:grid-cols-2 2xl:grid-cols-3">
		<!-- Main widget -->
		<div
			class="dark:bg-black-800 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700"
		>
			<div class="mb-4 flex items-center justify-between">
				<div class="shrink-0">
					<span
						class="text-xl leading-none font-bold text-gray-900 sm:text-2xl dark:text-white"
						>Referidos</span
					>
					<h3 class="text-base font-light text-gray-500 dark:text-gray-400">
						por dia
					</h3>
				</div>
			</div>

			<!-- NOTE: Charts could be extracted to a generic UI component -->
			<div id="main-chart"></div>

			<!-- Card Footer -->
			<div
				class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 sm:pt-6 dark:border-gray-700"
			>
				<div>
					<p
						class="inline-flex items-center rounded-lg p-2 text-center text-sm font-medium text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
					>
						Últimos 10 días
					</p>
				</div>
			</div>
		</div>
		<!--Tabs widget -->
		<div
			class="dark:bg-black-800 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 dark:border-gray-700"
		>
			<h3
				class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-white"
			>
				Lista de usuarios que referiste
				<button
					data-popover-target="popover-description"
					data-popover-placement="bottom-end"
					type="button"
					><svg
						class="ml-2 h-4 w-4 text-gray-400 hover:text-gray-500"
						aria-hidden="true"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
							clip-rule="evenodd"></path></svg
					><span class="sr-only">Mostrar información</span></button
				>
			</h3>
			<div
				data-popover
				id="popover-description"
				role="tooltip"
				class="dark:bg-black-800 invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 bg-white text-sm font-light text-gray-500 opacity-0 shadow-sm transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
			>
				<div class="space-y-2 p-3">
					<h3 class="font-semibold text-gray-900 dark:text-white">Referidos</h3>
					<p>Listado de todos los usuarios que usaron tu codigo de referido.</p>
				</div>
				<div data-popper-arrow></div>
			</div>

			<div class="space-y-2 p-3">
				<h3 class="font-semibold text-gray-900 dark:text-white">Referidos</h3>
			</div>
			<div
				id="fullWidthTabContent"
				class="border-t border-gray-200 dark:border-gray-600"
			>
				<div
					class="pt-4"
					id="about"
					role="tabpanel"
					aria-labelledby="about-tab"
				>
					<ul role="list" class="divide-y divide-gray-200 dark:divide-gray-700">
						{
							referidosCombinados?.map((r) => (
								<li class="py-3 sm:py-4">
									<div class="flex items-center space-x-4">
										<div class="shrink-0">
											{!r.avatar || r.avatar === 'NULL' ? (
												<img
													class="h-10 w-10 rounded-full"
													src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${r.name}`}
													alt={`Avatar de ${r.name}`}
												/>
											) : (
												<img
													class="h-10 w-10 rounded-full"
													src={r.avatar}
													alt={`Avatar de ${r.name}`}
												/>
											)}
										</div>
										<div class="min-w-0 flex-1">
											<p class="truncate font-medium text-gray-900 dark:text-white">
												{r.name}
											</p>
											<p class="truncate text-sm text-gray-500 dark:text-gray-400">
												{r.email}
											</p>
										</div>
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import '../dashboard/DashBoardpartners.client.ts';
</script>

<style is:global>
	@reference "../../styles/global.css";

	/* chart styles */
	.apexcharts-tooltip {
		background-color: white !important;
		color: rgb(107 114 128) !important;
		border: 0 !important;
		border-radius: 0.5rem !important;
		box-shadow:
			0 10px 15px -3px rgba(0, 0, 0, 0.1),
			0 4px 6px -4px rgba(0, 0, 0, 0.1) !important;
	}

	:is(.dark .apexcharts-tooltip) {
		background-color: var(--color-black-900) !important;
		color: rgb(156 163 175) !important;
	}

	.apexcharts-tooltip .apexcharts-tooltip-title {
		padding: 0.5rem 1rem !important;
		background-color: rgb(243 244 246) !important;
		border-bottom: 1px solid rgb(229 231 235) !important;
	}

	:is(.dark .apexcharts-tooltip .apexcharts-tooltip-title) {
		background-color: rgb(75 85 99) !important;
		border-color: rgb(107 114 128) !important;
	}

	.apexcharts-xaxistooltip {
		color: rgb(107 114 128) !important;
		border: 0 !important;
		background-color: white !important;
		border-radius: 0.5rem !important;
		box-shadow:
			0 10px 15px -3px rgba(0, 0, 0, 0.1),
			0 4px 6px -4px rgba(0, 0, 0, 0.1) !important;
	}

	:is(.dark .apexcharts-xaxistooltip) {
		background-color: var(--color-black-800) !important;
		color: rgb(209 213 219) !important;
	}

	.apexcharts-tooltip .apexcharts-tooltip-text-y-value {
		@apply dark:text-white;
	}

	.apexcharts-xaxistooltip-text {
		font-weight: 500 !important;
		font-size: 0.875rem !important;
	}

	.apexcharts-xaxistooltip:before,
	.apexcharts-xaxistooltip:after {
		border: 0 !important;
	}
</style>
