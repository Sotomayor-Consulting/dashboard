---
import Dropzone from '@components/display/Dropzone.astro';
import { Icon } from 'astro-icon/components';
import InfoPopover from '@components/ui/InfoPopover.tsx';
import PrintContract from '@components/display/PrintContract.astro';
import { getUsuarioById, getMissingPartnerFields } from '@domains/users/users';
import { getDocumentosGenerales } from '@domains/documents/documents';
const user = Astro.locals.user;
const userRoles = Astro.locals.userRoles || [];
const UserId = user?.id;
const supabase = Astro.locals.supabase;

let datosParaReporte = {};

let usuario = UserId ? await getUsuarioById(supabase, UserId) : null;

if (!usuario && Astro.props.data) {
	usuario = Astro.props.data;
}
if (usuario) {
	datosParaReporte = {
		nombre: [usuario.nombre, usuario.apellido].join(' '),
		correoElectronico: usuario.correo,
		fullAddress: [usuario.direccion_linea1, usuario.direccion_linea2].join(' '),
		tipoIdentificacion: usuario.tipo_identificacion,
		numeroIdentificacion: usuario.numero_de_identificacion,
		tipoPersona: usuario.tipo_persona,
	};
}

const documentos = UserId
	? await getDocumentosGenerales(supabase, UserId)
	: null;

interface Props {
	data: object;
	templateName?: string;
	reportName?: string;
}

let perfilCompleto = false;
const isPartner = userRoles.includes('partner');

if (isPartner && user) {
	const camposFaltantes = await getMissingPartnerFields(supabase, user.id);
	perfilCompleto = camposFaltantes.length === 0;
}
