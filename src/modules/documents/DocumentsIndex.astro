---
import { getIncorporacionesByUserId } from '@lib/tablas/companies/empresa_incorporaciones';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;

if (!userId) {
	return Astro.redirect('/sign-in?status=error&msg=No%20autenticado');
}

const companies = await getIncorporacionesByUserId(supabase, userId);
---

<div class="px-4 pt-2">
	<h1 class="mb-4 text-2xl font-semibold text-gray-900 dark:text-white">
		Mis documentos
	</h1>

	{
		!companies || companies.length === 0 ? (
			<div class="rounded-lg border border-dashed border-gray-200 p-6 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-300">
				No tienes empresas disponibles para gestionar documentos.
			</div>
		) : (
			<div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
				<table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
					<thead class="bg-gray-50 dark:bg-[#28314c]">
						<tr>
							<th class="px-4 py-3 text-left text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-300">
								Empresa
							</th>
							<th class="px-4 py-3 text-left text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-300">
								Estado
							</th>
							<th class="px-4 py-3 text-left text-xs font-semibold tracking-wide text-gray-600 uppercase dark:text-gray-300">
								Acción
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
						{companies.map((company: any) => (
							<tr class="bg-white hover:bg-gray-50 dark:bg-[#1f2937] dark:hover:bg-[#111827]">
								<td class="px-4 py-3 text-sm text-gray-900 dark:text-gray-100">
									{company.nombre_1 ?? 'Sin nombre'}
								</td>
								<td class="px-4 py-3 text-sm text-gray-500 dark:text-gray-300">
									{company.estado_de_incorporacion ?? 'Sin estado'}
								</td>
								<td class="px-4 py-3">
									<a
										href={`/my-companies/${company.empresa_incorporacion_id}/documents`}
										class="inline-flex items-center rounded-lg bg-blue-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-700"
									>
										Abrir
									</a>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)
	}
</div>
