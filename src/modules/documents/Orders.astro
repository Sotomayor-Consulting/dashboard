---
import { Icon } from 'astro-icon/components';
import OrderActionsDropdown from './islands/OrderActionsDropdown';

const lista = [
	{
		nombre: 'Mariana G. Valdez',
		id: 'ID: #ORD-99210',
		servicio: 'Incorporación',
		producto: 'Incorporación',
		pago: 'credit_card',
		metodo_de_pago: 'Tarjeta de credito',
		metodoPago: 'Tarjeta de credito',
		precio_base: '$850.00',
		precio: '$850.00',
		costo_total: '$935.00',
		empresa: 'Northwind Ventures LLC',
		realizado: '28 abr 2026',
		stripePaymentIntentId: 'pi_3Rt2sAxxxxxx01',
		estado: 'pagado',
		icono: 'ri:building-2-line',
	},
];
---

<div class="px-4">
	<ul class="my-4 space-y-3">
		{
			lista.map((li, index) => (
				<li class="rounded-xl border border-gray-200 bg-white p-5 shadow-md shadow-gray-200/70 sm:p-6 dark:border-gray-700 dark:bg-black dark:shadow-none">
					<div class="grid grid-cols-2 grid-rows-3 items-center justify-between gap-2 gap-y-6 xl:grid-cols-5 xl:grid-rows-1 xl:gap-6 xl:gap-y-0">
						<div class="col-start-1 row-start-1 flex min-w-0 flex-1 items-center gap-4">
							<div class="border-primary/20 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border">
								<Icon name={li.icono} class="text-primary text-2xl" />
							</div>
							<div class="truncate">
								<p class="font-title-lg text-title-lg text-on-surface">
									{li.nombre}
								</p>
								<p class="text-sm font-light">ID: #{index + 1}</p>
							</div>
						</div>
						<div class="flex flex-col justify-center xl:items-center">
							<p class="font-title-md text-title-md text-on-surface">
								{li.servicio}
							</p>
							<p class="text-label-sm text-y text-sm text-amber-600">
								Plan Premium
							</p>
						</div>
						<div class="flex flex-col items-end justify-center xl:items-center">
							<div class="text-on-surface-variant mb-1 flex items-center gap-2">
								<span class="material-symbols-outlined text-sm">
									{li.metodo_de_pago}
								</span>
							</div>
							<div class="group flex items-center gap-1.5">
								<p class="font-body-md text-body-md text-on-surface-variant">
									{li.precio_base}
								</p>
							</div>
						</div>
						<div class="flex flex-col justify-center font-bold xl:items-center">
							<p class="font-display-md text-display-md text-primary">
								{li.costo_total}
							</p>
							<p class="font-label-sm text-sm font-light">Precio total</p>
						</div>
						<div class="col-start-2 row-start-1 flex justify-end gap-4 xl:col-start-5 xl:row-start-1 xl:items-center">
							<span class="border-success text-success-strong hidden items-center gap-1.5 rounded-full border bg-[#04785733] px-4 py-1.5 xl:inline-flex">
								<span class="bg-success-strong h-2 w-2 rounded-full" />
								<span class="text-label-lg font-bold">{li.estado}</span>
							</span>
							<OrderActionsDropdown
								order={{
									id: li.id,
									producto: li.producto,
									precio: li.precio,
									metodoPago: li.metodoPago,
									cliente: li.nombre,
									empresa: li.empresa,
									realizado: li.realizado,
									stripePaymentIntentId: li.stripePaymentIntentId,
									estado: li.estado,
								}}
								client:visible
							/>
						</div>
						<div class="flex items-center justify-end gap-4">
							<span class="border-success text-success-strong inline-flex items-center gap-1.5 rounded-full border bg-[#04785733] px-4 py-1.5 text-sm xl:hidden">
								<span class="bg-success-strong h-2 w-2 rounded-full" />
								<span class="text-label-lg font-bold">{li.estado}</span>
							</span>
						</div>
					</div>
				</li>
			))
		}
	</ul>
</div>
