---
import { Icon } from 'astro-icon/components';
import OrderActionsDropdown from './islands/OrderActionsDropdown';
import { getOrdersByIncorporation } from '@domains/payments/orders';

interface Props {
	incorporationId: string | undefined;
}

const { incorporationId } = Astro.props;
const supabase = Astro.locals.supabase;

const orders = incorporationId
	? await getOrdersByIncorporation(supabase, incorporationId)
	: [];

const STATUS_LABEL: Record<string, string> = {
	draft: 'Borrador',
	pending_payment: 'Pago pendiente',
	confirmed: 'Pagado',
	canceled: 'Cancelada',
};

const fmtUsd = (value: number | null) =>
	typeof value === 'number'
		? value.toLocaleString('en-US', {
				style: 'currency',
				currency: 'USD',
				minimumFractionDigits: 2,
			})
		: null;

const fmtDate = (value: string | null) =>
	value
		? new Date(value).toLocaleDateString('es-ES', {
				year: 'numeric',
				month: 'short',
				day: '2-digit',
			})
		: '—';
---

<div class="px-4">
	{
		orders.length === 0 ? (
			<div class="flat-card-padded my-4 text-center text-sm font-light">
				No hay órdenes para esta empresa todavía.
			</div>
		) : (
			<ul class="my-4 space-y-3">
				{orders.map((order) => {
					const isPaid = order.status === 'confirmed';
					const totalLabel = fmtUsd(order.total);
					return (
						<li class="flat-card-padded sm:p-6">
							<div class="grid grid-cols-2 grid-rows-3 items-center justify-between gap-2 gap-y-6 xl:grid-cols-5 xl:grid-rows-1 xl:gap-6 xl:gap-y-0">
								<div class="col-start-1 row-start-1 flex min-w-0 flex-1 items-center gap-4">
									<div class="border-primary/20 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border">
										<Icon name="ri:contract-line" class="text-primary text-2xl" />
									</div>
									<div class="truncate">
										<p class="font-title-lg text-title-lg text-on-surface">
											{order.client_name ?? 'Cliente'}
										</p>
										<p class="text-sm font-light">{order.order_number}</p>
									</div>
								</div>
								<div class="flex flex-col justify-center xl:items-center">
									<p class="font-title-md text-title-md text-on-surface">
										{order.plan_name ?? 'Servicio'}
									</p>
									<p class="text-label-sm text-y text-sm text-amber-600">
										{order.incorporation_name ?? ''}
									</p>
								</div>
								<div class="flex flex-col items-end justify-center xl:items-center">
									<p class="text-on-surface-variant mb-1 text-sm">
										{fmtDate(order.created_at)}
									</p>
									<p class="font-body-md text-body-md text-on-surface-variant">
										{order.lines.length} servicio
										{order.lines.length === 1 ? '' : 's'}
									</p>
								</div>
								<div class="flex flex-col justify-center font-bold xl:items-center">
									<p class="font-display-md text-display-md text-primary">
										{totalLabel ?? '—'}
									</p>
									<p class="font-label-sm text-sm font-light">Precio total</p>
								</div>
								<div class="col-start-2 row-start-1 flex justify-end gap-4 xl:col-start-5 xl:row-start-1 xl:items-center">
									<span
										class:list={[
											'hidden items-center gap-1.5 rounded-full border px-4 py-1.5 xl:inline-flex',
											isPaid
												? 'border-success text-success-strong bg-[#04785733]'
												: 'border-amber-500 bg-amber-500/10 text-amber-600',
										]}
									>
										<span
											class:list={[
												'h-2 w-2 rounded-full',
												isPaid ? 'bg-success-strong' : 'bg-amber-500',
											]}
										/>
										<span class="text-label-lg font-bold">
											{STATUS_LABEL[order.status] ?? order.status}
										</span>
									</span>
									<OrderActionsDropdown order={order} client:visible />
								</div>
								<div class="flex items-center justify-end gap-4">
									<span
										class:list={[
											'inline-flex items-center gap-1.5 rounded-full border px-4 py-1.5 text-sm xl:hidden',
											isPaid
												? 'border-success text-success-strong bg-[#04785733]'
												: 'border-amber-500 bg-amber-500/10 text-amber-600',
										]}
									>
										<span
											class:list={[
												'h-2 w-2 rounded-full',
												isPaid ? 'bg-success-strong' : 'bg-amber-500',
											]}
										/>
										<span class="text-label-lg font-bold">
											{STATUS_LABEL[order.status] ?? order.status}
										</span>
									</span>
								</div>
							</div>
						</li>
					);
				})}
			</ul>
		)
	}
</div>
