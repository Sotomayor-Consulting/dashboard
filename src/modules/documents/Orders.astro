---
import { Icon } from 'astro-icon/components';

const lista = [
	{
		nombre: 'Mariana G. Valdez',
		id: 'ID: #ORD-99210',
		servicio: 'Incorporación',
		pago: 'credit_card',
		metodo_de_pago: 'Tarjeta de credito',
		precio_base: '$850.00',
		costo_total: '$935.00',
		estado: 'pagado',
		icono: 'ri:building-2-line',
	},
];
---

<ul class="my-10 space-y-3">
	{
		lista.map((li, index) => (
			<li class="to-black-600 from-black-900 rounded-xl border bg-white p-6 transition-colors delay-150 dark:bg-linear-to-tl dark:hover:bg-linear-to-bl">
				<div class="grid grid-cols-5 grid-rows-1 items-center justify-between gap-6">
					<div class="flex min-w-0 flex-1 items-center gap-4">
						<div class="bg-primary-container/20 border-primary/20 flex h-12 w-12 shrink-0 items-center justify-center rounded-full border">
							<Icon name={li.icono} class="text-primary text-2xl" />
						</div>
						<div class="truncate">
							<p class="font-title-lg text-title-lg text-on-surface">
								{li.nombre}
							</p>
							<p class="font-label-sm text-label-sm text-on-surface-variant">
								ID: #{index + 1}
							</p>
						</div>
					</div>
					<div class="flex flex-col items-center justify-center">
						<p class="font-title-md text-title-md text-on-surface">
							{li.servicio}
						</p>
						<p class="font-label-sm text-label-sm text-primary">Plan Premium</p>
					</div>
					<div class="flex flex-col items-center justify-center">
						<div class="text-on-surface-variant mb-1 flex items-center gap-2">
							<span class="material-symbols-outlined text-sm">
								{li.metodo_de_pago}
							</span>
						</div>
						<div class="group flex items-center gap-1.5">
							<p class="font-body-md text-body-md text-on-surface-variant">
								{li.precio_base}
							</p>
						</div>
					</div>
					<div class="flex-1 text-center">
						<p class="font-display-md text-display-md text-primary">
							{li.costo_total}
						</p>
						<p class="font-label-sm text-label-sm text-on-surface-variant">
							Precio total
						</p>
					</div>
					<div class="flex items-center justify-end gap-4">
						<span class="bg-success/20 border-secondary/20 text-success-strong inline-flex items-center gap-1.5 rounded-full border px-4 py-1.5">
							<span class="bg-success-strong h-2 w-2 rounded-full" />
							<span class="text-label-lg font-bold">{li.estado}</span>
						</span>
						<button class="dark:hover:bg-black-600 hover:text-primary rounded-xl p-2 transition-all">
							<Icon name="ri:more-2-line" />
						</button>
					</div>
				</div>
			</li>
		))
	}
</ul>
