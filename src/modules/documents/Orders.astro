---
import { Icon } from 'astro-icon/components';
import OrderActionsDropdown from './islands/OrderActionsDropdown';
import { getOrdersByIncorporation } from '@domains/payments/orders';
import {
	ORDER_STATUS_LABEL,
	formatDate,
	formatUsd,
} from '@components/display/orders/order-format';

interface Props {
	incorporationId: string | undefined;
}

const { incorporationId } = Astro.props;
const supabase = Astro.locals.supabase;

const orders = incorporationId
	? await getOrdersByIncorporation(supabase, incorporationId)
	: [];
---

<div>
	<header class="border-border border-b pb-4">
		<h1 class="text-foreground text-xl font-semibold">Órdenes</h1>
		<p class="text-muted-foreground mt-1 text-sm">
			Órdenes de pago asociadas a esta incorporación.
		</p>
	</header>

	<div class="divide-border divide-y">
		<div
			class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[200px_1fr]"
		>
			<div>
				<div class="flex items-center gap-2">
					<Icon
						name="ri:shopping-bag-4-line"
						class="text-muted-foreground h-5 w-5 shrink-0"
					/>
					<h3 class="text-foreground text-sm font-medium">Pagos</h3>
				</div>
				<p class="text-muted-foreground mt-1 text-sm">
					Historial de pagos realizados.
				</p>
			</div>
			<div>
				{
					orders.length === 0 ? (
						<div class="flex flex-col items-center gap-2 rounded-lg border border-dashed border-gray-200 py-10 text-center dark:border-gray-700">
							<Icon
								name="ri:shopping-bag-4-line"
								class="text-muted-foreground h-8 w-8"
							/>
							<p class="text-muted-foreground text-sm">
								No hay órdenes para esta incorporación.
							</p>
						</div>
					) : (
						<ul role="list" class="divide-border divide-y">
							{orders.map((order) => {
								const isPaid = order.status === 'confirmed';
								const statusLabel =
									ORDER_STATUS_LABEL[order.status] ?? order.status;
								const pillClasses = isPaid
									? 'border-success text-success bg-success/15'
									: 'border-amber-500 bg-amber-500/10 text-amber-600';
								const dotClasses = isPaid
									? 'bg-success'
									: 'bg-amber-500';
								return (
									<li class="flex items-center gap-4 py-4">
										<div class="border-primary/20 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border">
											<Icon
												name="ri:contract-line"
												class="text-primary text-lg"
											/>
										</div>

										<div class="min-w-0 flex-1">
											<div class="flex flex-wrap items-center gap-2">
												<p class="text-foreground text-sm font-medium">
													{order.plan_name ?? 'Servicio'}
												</p>
												<span
													class:list={[
														'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium',
														pillClasses,
													]}
												>
													<span
														class:list={[
															'h-1.5 w-1.5 rounded-full',
															dotClasses,
														]}
													/>
													{statusLabel}
												</span>
											</div>
											<div class="text-muted-foreground mt-0.5 flex flex-wrap items-center gap-2 text-xs">
												<span class="font-mono">
													{order.order_number}
												</span>
												<span class="text-border">·</span>
												<span>{formatDate(order.created_at)}</span>
												<span class="text-border">·</span>
												<span>
													{order.lines.length} servicio{order.lines.length === 1 ? '' : 's'}
												</span>
											</div>
										</div>

										<p class="text-foreground shrink-0 text-sm font-semibold">
											{formatUsd(order.total)}
										</p>

										<OrderActionsDropdown
											order={order}
											client:visible
										/>
									</li>
								);
							})}
						</ul>
					)
				}
			</div>
		</div>
	</div>
</div>
