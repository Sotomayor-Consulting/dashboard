---
import { Icon } from 'astro-icon/components';
import {
	getIncorporacionById,
	getIncorporacionByIdAdmin,
} from '@domains/companies/incorporations';
import {
	getDocumentRequestsForIncorporationCase,
	getDocumentsForIncorporationCase,
	getDocumentTypesList,
} from '@domains/documents/document_dashboard';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import { DocumentTypeComboboxField } from '@modules/documents/islands/DocumentTypeComboboxField';
import CompanyDocumentsList from '@modules/documents/islands/CompanyDocumentsList';

interface Props {
	incorporationCaseId: string | undefined;
	showQuickUpload?: boolean;
	dashboardVariant?: 'client' | 'staff';
}

const {
	incorporationCaseId,
	showQuickUpload = true,
	dashboardVariant = 'client',
} = Astro.props;
const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];
const hasStaffRole =
	userRoles.includes('admin') || userRoles.includes('operaciones');
const isStaffDashboard = dashboardVariant === 'staff';
const canUseStaffActions = isStaffDashboard && hasStaffRole;
const dataClient = isStaffDashboard ? supabaseAdmin : supabase;

let errorMessage = '';
let company: any = null;
let requests: any[] = [];
let documents: any[] = [];
let documentTypes: any[] = [];

if (!userId) {
	errorMessage = 'No autenticado';
} else if (!incorporationCaseId) {
	errorMessage = 'ID de incorporación no válido';
} else {
	company = isStaffDashboard
		? await getIncorporacionByIdAdmin(dataClient, incorporationCaseId)
		: await getIncorporacionById(supabase, incorporationCaseId, userId);

	if (!company) {
		errorMessage = 'Empresa no encontrada';
	} else {
		[requests, documents, documentTypes] = await Promise.all([
			getDocumentRequestsForIncorporationCase(dataClient, incorporationCaseId),
			getDocumentsForIncorporationCase(
				supabaseAdmin,
				incorporationCaseId,
				userId,
				userRoles,
			),
			getDocumentTypesList(dataClient),
		]);
	}
}

const uploadEndpointBase = `/api/documents/upload?incorporationCaseId=${encodeURIComponent(
	incorporationCaseId ?? '',
)}&back=${encodeURIComponent(Astro.url.pathname)}`;

const BLOCKED_REQUEST_STATUSES = new Set([
	'approved',
	'closed',
	'cancelled',
	'rejected',
]);

const canUploadForRequest = (status: string) =>
	!BLOCKED_REQUEST_STATUSES.has(status);
---

<div>
	{
		errorMessage ? (
			<div class="rounded-lg border border-dashed border-border p-6 text-sm text-muted-foreground">
				{errorMessage}
			</div>
		) : (
			<div class="my-4 grid w-full grid-cols-1 gap-6 xl:grid-cols-2">
				<div>
					<h3 class="text-lg font-semibold text-foreground">Solicitudes</h3>
					<p class="mt-1 mb-4 text-sm text-muted-foreground">
						Documentos solicitados por el equipo de operaciones.
					</p>

					{canUseStaffActions && showQuickUpload ? (
						<div class="mb-4 rounded-lg border border-dashed border-border bg-muted/30 p-4">
							<h4 class="text-sm font-semibold text-foreground">
								Subida rápida (Operaciones/Admin)
							</h4>
							<form
								method="post"
								enctype="multipart/form-data"
								action={uploadEndpointBase}
								class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-2"
							>
								<input
									type="file"
									name="file"
									required
									class="block w-full text-sm text-foreground file:mr-3 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:py-2 file:text-sm file:font-medium file:text-foreground hover:file:bg-muted/80"
									accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
								/>
								<DocumentTypeComboboxField
									client:visible
									documentTypes={documentTypes}
								/>
								<select
									name="visibility"
									class="block w-full rounded-lg border border-border bg-card px-2 py-2 text-sm text-foreground"
								>
									<option value="internal_only">Interno</option>
									<option value="client_visible">Visible</option>
								</select>
								<select
									name="shareWithClient"
									class="block w-full rounded-lg border border-border bg-card px-2 py-2 text-sm text-foreground"
								>
									<option value="false">No compartir</option>
									<option value="true">Compartir</option>
								</select>
								<div class="md:col-span-2">
									<button
										type="submit"
										class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
									>
										<Icon name="ri:upload-2-line" class="text-base" />
										Subir documento
									</button>
								</div>
							</form>
						</div>
					) : null}

					{requests.length === 0 ? (
						<div class="rounded-lg border border-dashed border-border p-6 text-center text-sm text-muted-foreground">
							No hay solicitudes de documentos para esta empresa.
						</div>
					) : (
						<div class="rounded-lg border border-border">
							<ul class="divide-y divide-border">
								{requests.map((request) => (
									<li class="p-4">
										<p class="text-sm font-semibold text-foreground">
											{request.document_type?.name ?? 'Documento requerido'}
										</p>
										<p class="mt-1 text-xs text-muted-foreground">
											Status: {request.status}
											{request.due_date
												? ` · Vence: ${request.due_date}`
												: ''}
										</p>

										{canUploadForRequest(request.status) ? (
											<form
												method="post"
												enctype="multipart/form-data"
												action={`${uploadEndpointBase}&documentRequestId=${encodeURIComponent(request.id)}`}
												class="mt-3 flex flex-col gap-2"
											>
												<input
													type="file"
													name="file"
													required
													class="block w-full text-sm text-foreground file:mr-3 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:py-2 file:text-sm file:font-medium file:text-foreground hover:file:bg-muted/80"
													accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
												/>
												{canUseStaffActions ? (
													<select
														name="visibility"
														class="block w-full rounded-lg border border-border bg-card px-2 py-1 text-xs text-foreground"
													>
														<option value="internal_only">Interno</option>
														<option value="client_visible">
															Visible cliente
														</option>
													</select>
												) : null}
												<button
													type="submit"
													class="inline-flex w-fit items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
												>
													<Icon name="ri:upload-2-line" class="text-base" />
													Subir
												</button>
											</form>
										) : (
											<p class="mt-3 text-xs font-medium text-amber-700 dark:text-amber-300">
												La solicitud está {request.status}. No se permiten
												nuevas cargas.
											</p>
										)}
									</li>
								))}
							</ul>
						</div>
					)}
				</div>

				<div>
					<h3 class="text-lg font-semibold text-foreground">Documentos</h3>
					<p class="mt-1 mb-4 text-sm text-muted-foreground">
						Archivos subidos y compartidos de esta empresa.
					</p>

					<div class="rounded-lg border border-border p-4">
						<CompanyDocumentsList
							documents={documents}
							canUseStaffActions={canUseStaffActions}
							incorporationCaseId={incorporationCaseId ?? ''}
							companyUserId={company.user_id}
							isStaffDashboard={isStaffDashboard}
							client:load
						/>
					</div>
				</div>
			</div>
		)
	}
</div>
