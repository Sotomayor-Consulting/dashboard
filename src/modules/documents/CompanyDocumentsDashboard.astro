---
import { Icon } from 'astro-icon/components';
import {
	getIncorporacionById,
	getIncorporacionByIdAdmin,
} from '@domains/companies/incorporations';
import {
	getDocumentRequestsForIncorporationCase,
	getDocumentsForIncorporationCase,
	getDocumentTypesList,
} from '@domains/documents/document_dashboard';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import { DocumentTypeComboboxField } from '@modules/documents/islands/DocumentTypeComboboxField';
import CompanyDocumentsList from '@modules/documents/islands/CompanyDocumentsList';

interface Props {
	incorporationCaseId: string | undefined;
	showQuickUpload?: boolean;
	dashboardVariant?: 'client' | 'staff';
}

const {
	incorporationCaseId,
	showQuickUpload = true,
	dashboardVariant = 'client',
} = Astro.props;
const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];
const hasStaffRole =
	userRoles.includes('admin') || userRoles.includes('operaciones');
const isStaffDashboard = dashboardVariant === 'staff';
const canUseStaffActions = isStaffDashboard && hasStaffRole;
const dataClient = isStaffDashboard ? supabaseAdmin : supabase;

let errorMessage = '';
let company: any = null;
let requests: any[] = [];
let documents: any[] = [];
let documentTypes: any[] = [];

if (!userId) {
	errorMessage = 'No autenticado';
} else if (!incorporationCaseId) {
	errorMessage = 'ID de incorporación no válido';
} else {
	company = isStaffDashboard
		? await getIncorporacionByIdAdmin(dataClient, incorporationCaseId)
		: await getIncorporacionById(supabase, incorporationCaseId, userId);

	if (!company) {
		errorMessage = 'Empresa no encontrada';
	} else {
		[requests, documents, documentTypes] = await Promise.all([
			getDocumentRequestsForIncorporationCase(dataClient, incorporationCaseId),
			getDocumentsForIncorporationCase(
				supabaseAdmin,
				incorporationCaseId,
				userId,
				userRoles,
			),
			getDocumentTypesList(dataClient),
		]);
	}
}

const uploadEndpointBase = `/api/documents/upload?incorporationCaseId=${encodeURIComponent(
	incorporationCaseId ?? '',
)}&back=${encodeURIComponent(Astro.url.pathname)}`;

const BLOCKED_REQUEST_STATUSES = new Set([
	'approved',
	'closed',
	'cancelled',
	'rejected',
]);

const canUploadForRequest = (status: string) =>
	!BLOCKED_REQUEST_STATUSES.has(status);
---

<div class="px-4 pt-2">
	{
		errorMessage ? (
			<div class="rounded-lg border border-dashed border-gray-200 p-6 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">
				{errorMessage}
			</div>
		) : (
			<>
				<div class="mb-6 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
					<div>
						<h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
							{company.principal_name ?? 'Empresa'}
						</h1>
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
							{company.estado_de_incorporacion ?? 'Sin estado'} ·{' '}
							{company.estado ?? '—'}
						</p>
					</div>
					<div class="flex items-center gap-2 text-xs">
						<span class="rounded-full bg-gray-100 px-2.5 py-1 font-medium text-gray-800 dark:bg-gray-400/20 dark:text-gray-300">
							{requests.length} solicitudes
						</span>
						<span class="rounded-full bg-gray-100 px-2.5 py-1 font-medium text-gray-800 dark:bg-gray-400/20 dark:text-gray-300">
							{documents.length} documentos
						</span>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
					<section class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-transparent">
						{canUseStaffActions && showQuickUpload ? (
							<div class="mb-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 dark:border-gray-600 dark:bg-white/5">
								<h3 class="text-sm font-semibold text-gray-900 dark:text-white">
									Subida rápida (Operaciones/Admin)
								</h3>
								<form
									method="post"
									enctype="multipart/form-data"
									action={uploadEndpointBase}
									class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-2"
								>
									<input
										type="file"
										name="file"
										required
										class="block w-full text-sm text-gray-900 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-200 dark:text-gray-200 dark:file:bg-white/10 dark:file:text-gray-200 dark:hover:file:bg-white/15"
										accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
									/>
									<DocumentTypeComboboxField
										client:visible
										documentTypes={documentTypes}
									/>
									<select
										name="visibility"
										class="block w-full rounded-lg border border-gray-200 bg-white px-2 py-2 text-sm text-gray-700 dark:border-gray-700 dark:bg-white/5 dark:text-gray-300"
									>
										<option value="internal_only">Interno</option>
										<option value="client_visible">Visible</option>
									</select>
									<select
										name="shareWithClient"
										class="block w-full rounded-lg border border-gray-200 bg-white px-2 py-2 text-sm text-gray-700 dark:border-gray-700 dark:bg-white/5 dark:text-gray-300"
									>
										<option value="false">No compartir</option>
										<option value="true">Compartir</option>
									</select>
									<div class="md:col-span-2">
										<button
											type="submit"
											class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
										>
											<Icon name="ri:upload-2-line" class="text-base" />
											Subir documento
										</button>
									</div>
								</form>
							</div>
						) : null}

						<div class="mb-3 flex items-center justify-between">
							<h2 class="text-lg font-semibold text-gray-900 dark:text-white">
								Solicitudes
							</h2>
						</div>

						{requests.length === 0 ? (
							<div class="rounded-lg border border-dashed border-gray-200 p-6 text-center text-sm text-gray-500 dark:border-gray-700 dark:text-gray-300">
								No hay solicitudes de documentos para esta empresa.
							</div>
						) : (
							<ul class="space-y-3">
								{requests.map((request) => (
									<li class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
										<p class="text-sm font-semibold text-gray-900 dark:text-white">
											{request.document_type?.name ?? 'Documento requerido'}
										</p>
										<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
											Status: {request.status}
											{request.due_date ? ` · Vence: ${request.due_date}` : ''}
										</p>

										{canUploadForRequest(request.status) ? (
											<form
												method="post"
												enctype="multipart/form-data"
												action={`${uploadEndpointBase}&documentRequestId=${encodeURIComponent(request.id)}`}
												class="mt-3 flex flex-col gap-2"
											>
												<input
													type="file"
													name="file"
													required
													class="block w-full text-sm text-gray-900 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-200 dark:text-gray-200 dark:file:bg-white/10 dark:file:text-gray-200 dark:hover:file:bg-white/15"
													accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
												/>
												{canUseStaffActions ? (
													<select
														name="visibility"
														class="block w-full rounded-lg border border-gray-200 bg-white px-2 py-1 text-xs text-gray-700 dark:border-gray-700 dark:bg-white/5 dark:text-gray-300"
													>
														<option value="internal_only">Interno</option>
														<option value="client_visible">
															Visible cliente
														</option>
													</select>
												) : null}
												<button
													type="submit"
													class="inline-flex w-fit items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
												>
													<Icon name="ri:upload-2-line" class="text-base" />
													Subir
												</button>
											</form>
										) : (
											<p class="mt-3 text-xs font-medium text-amber-700 dark:text-amber-300">
												La solicitud está {request.status}. No se permiten
												nuevas cargas.
											</p>
										)}
									</li>
								))}
							</ul>
						)}
					</section>

					<section class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-transparent">
						<div class="mb-3 flex items-center justify-between">
							<h2 class="text-lg font-semibold text-gray-900 dark:text-white">
								Documentos
							</h2>
						</div>

						<CompanyDocumentsList
							documents={documents}
							canUseStaffActions={canUseStaffActions}
							incorporationCaseId={incorporationCaseId ?? ''}
							companyUserId={company.user_id}
							isStaffDashboard={isStaffDashboard}
							client:load
						/>
					</section>
				</div>
			</>
		)
	}
</div>

