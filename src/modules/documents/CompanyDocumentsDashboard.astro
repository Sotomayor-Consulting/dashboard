---
import { Icon } from 'astro-icon/components';
import {
	getIncorporacionById,
	getIncorporacionByIdAdmin,
} from '@domains/companies/incorporations';
import {
	getDocumentRequestsForIncorporationCase,
	getDocumentsForCompanyView,
	getDocumentTypesList,
} from '@domains/documents/document_dashboard';
import { getDocumentosPorFirmar } from '@domains/documents/pending-signature';
import SignedPanel from '@modules/companies/components/dashboard-companies/SignedPanel.astro';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import { canManageDocuments, isAdmin } from '@shared/roles';
import { DocumentTypeComboboxField } from '@modules/documents/islands/DocumentTypeComboboxField';
import { requestStatusLabel } from '@modules/documents/document-ui';
import DocumentRequestList from '@modules/documents/islands/DocumentRequestList';
import CompanyDocumentsList from '@modules/documents/islands/CompanyDocumentsList';

interface Props {
	incorporationCaseId: string | undefined;
	companyId?: string | null;
	showQuickUpload?: boolean;
	dashboardVariant?: 'client' | 'staff';
}

const {
	incorporationCaseId,
	companyId = null,
	showQuickUpload = true,
	dashboardVariant = 'client',
} = Astro.props;
const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];
// Mismo conjunto que STAFF_ROLES y que documents.is_staff() en Postgres.
const hasStaffRole = canManageDocuments(userRoles);
const isStaffDashboard = dashboardVariant === 'staff';
const canUseStaffActions = isStaffDashboard && hasStaffRole;
// El borrado permanente es exclusivo de admin (ver deleteDocument).
const canDeleteDocuments = isStaffDashboard && isAdmin(userRoles);
const dataClient = isStaffDashboard ? supabaseAdmin : supabase;

let errorMessage = '';
let company: any = null;
let requests: any[] = [];
let documents: any[] = [];
let documentTypes: any[] = [];
let porfirmar: any[] = [];

if (!userId) {
	errorMessage = 'No autenticado';
} else if (!incorporationCaseId) {
	errorMessage = 'ID de incorporación no válido';
} else {
	company = isStaffDashboard
		? await getIncorporacionByIdAdmin(dataClient, incorporationCaseId)
		: await getIncorporacionById(supabase, incorporationCaseId, userId);

	if (!company) {
		errorMessage = 'Empresa no encontrada';
	} else {
		[requests, documents, documentTypes, porfirmar] = await Promise.all([
			getDocumentRequestsForIncorporationCase(dataClient, incorporationCaseId),
			getDocumentsForCompanyView(
				supabaseAdmin,
				companyId,
				incorporationCaseId,
				userId,
				userRoles,
				// El staff recibe también los archivados; la tabla los oculta
				// tras un filtro para poder restaurarlos o eliminarlos.
				canUseStaffActions,
			),
			getDocumentTypesList(dataClient),
			getDocumentosPorFirmar(supabase, userId, incorporationCaseId),
		]);
	}
}

const uploadEndpointBase = `/api/documents/upload?incorporationCaseId=${encodeURIComponent(
	incorporationCaseId ?? '',
)}&back=${encodeURIComponent(Astro.url.pathname)}`;

// Estados terminales de document_request_status ('closed' no existe en el
// enum; se retiró junto con el del servicio).
const BLOCKED_REQUEST_STATUSES = new Set(['approved', 'cancelled', 'rejected']);

const canUploadForRequest = (status: string) =>
	!BLOCKED_REQUEST_STATUSES.has(status);

/** Solicitudes que todavía admiten documentos, para el selector de subida. */
const openRequests = requests.filter((request) =>
	canUploadForRequest(request.status),
);
---

<div>
	{
		errorMessage ? (
			<div class="border-border text-muted-foreground rounded-lg border border-dashed p-6 text-sm">
				{errorMessage}
			</div>
		) : (
			<>
				{porfirmar.length > 0 && (
					<div class="mb-4">
						<SignedPanel porfirmar={porfirmar} />
					</div>
				)}

				<header class="border-border border-b pb-4">
					<h1 class="text-foreground text-xl font-semibold">Documentos</h1>
					<p class="text-muted-foreground mt-1 text-sm">
						Solicitudes y archivos de la empresa.
					</p>
				</header>

				<div class="divide-border divide-y">
					{/* Solicitudes */}
					<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[200px_1fr]">
						<div>
							<div class="flex items-center gap-2">
								<Icon
									name="ri:file-list-3-line"
									class="text-muted-foreground h-5 w-5 shrink-0"
								/>
								<h3 class="text-foreground text-sm font-medium">Solicitudes</h3>
							</div>
							<p class="text-muted-foreground mt-1 text-sm">
								Documentos solicitados por el equipo de operaciones.
							</p>
						</div>
						<div>
							{canUseStaffActions && showQuickUpload ? (
								<div class="border-border bg-muted/30 mb-4 rounded-lg border border-dashed p-4">
									<h4 class="text-foreground text-sm font-semibold">
										Subida rápida (Operaciones/Admin)
									</h4>
									<form
										method="post"
										enctype="multipart/form-data"
										action={uploadEndpointBase}
										class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-2"
									>
										<input
											type="file"
											name="file"
											required
											class="text-foreground file:bg-muted file:text-foreground hover:file:bg-muted/80 block w-full text-sm file:mr-3 file:rounded-lg file:border-0 file:px-3 file:py-2 file:text-sm file:font-medium"
											accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
										/>
										<DocumentTypeComboboxField
											client:visible
											documentTypes={documentTypes}
										/>
										{openRequests.length > 0 && (
											<select
												name="documentRequestId"
												class="border-border bg-card text-foreground block w-full rounded-lg border px-2 py-2 text-sm md:col-span-2"
											>
												<option value="">
													No responde a ninguna solicitud
												</option>
												{openRequests.map((request) => (
													<option value={request.id}>
														Responde a:{' '}
														{request.document_type?.name ??
															'Documento requerido'}
													</option>
												))}
											</select>
										)}
										<select
											name="shareWithClient"
											class="border-border bg-card text-foreground block w-full rounded-lg border px-2 py-2 text-sm"
										>
											<option value="false">No compartir</option>
											<option value="true">Compartir</option>
										</select>
										<div class="md:col-span-2">
											<button
												type="submit"
												class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
											>
												<Icon name="ri:upload-2-line" class="text-base" />
												Subir documento
											</button>
										</div>
									</form>
								</div>
							) : null}

							{canUseStaffActions ? (
								/*
									Vista de staff: revisar. Usa el mismo componente que la
									pestaña de documentos del detalle de incorporación, para no
									mantener dos listas de solicitudes en paralelo. La carga
									contra una solicitud se hace desde «Subida rápida», que
									tiene su propio selector.
								*/
								<DocumentRequestList
									client:load
									requests={requests}
									canReview={canUseStaffActions}
								/>
							) : requests.length === 0 ? (
								<div class="border-border text-muted-foreground rounded-lg border border-dashed p-6 text-center text-sm">
									No hay solicitudes de documentos para esta empresa.
								</div>
							) : (
								<div class="border-border rounded-lg border">
									<ul class="divide-border divide-y">
										{requests.map((request) => (
											<li class="p-4">
												<p class="text-foreground text-sm font-semibold">
													{request.document_type?.name ?? 'Documento requerido'}
												</p>
												<p class="text-muted-foreground mt-1 text-xs">
													Estado: {requestStatusLabel(request.status)}
													{request.due_date
														? ` · Vence: ${request.due_date}`
														: ''}
												</p>

												{request.documents.length > 0 && (
													<ul class="mt-2 space-y-1">
														{request.documents.map((file: any) => (
															<li class="text-muted-foreground flex items-center gap-1.5 text-xs">
																<Icon
																	name="ri:file-text-line"
																	class="h-3.5 w-3.5 shrink-0"
																/>
																<span class="truncate">
																	{file.file_title ?? file.file_name}
																</span>
															</li>
														))}
													</ul>
												)}

												{canUploadForRequest(request.status) ? (
													<form
														method="post"
														enctype="multipart/form-data"
														action={`${uploadEndpointBase}&documentRequestId=${encodeURIComponent(request.id)}`}
														class="mt-3 flex flex-col gap-2"
													>
														<input
															type="file"
															name="file"
															required
															class="block w-full text-sm text-gray-900 file:mr-3 file:ml-0 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-200 dark:text-gray-200 dark:file:bg-white/10 dark:file:text-gray-200 dark:hover:file:bg-white/15"
															accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
														/>
														{canUseStaffActions ? (
															<select
																name="shareWithClient"
																class="border-border bg-card text-foreground block w-full rounded-lg border px-2 py-1 text-xs"
															>
																<option value="false">No compartir</option>
																<option value="true">
																	Compartir con cliente
																</option>
															</select>
														) : null}
														<button
															type="submit"
															class="inline-flex w-fit items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
														>
															<Icon name="ri:upload-2-line" class="text-base" />
															Subir
														</button>
													</form>
												) : (
													<p class="mt-3 text-xs font-medium text-amber-700 dark:text-amber-300">
														La solicitud está{' '}
														{requestStatusLabel(request.status).toLowerCase()}.
														No se permiten nuevas cargas.
													</p>
												)}
											</li>
										))}
									</ul>
								</div>
							)}
						</div>
					</div>

					{/* Documentos */}
					<div class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[200px_1fr]">
						<div>
							<div class="flex items-center gap-2">
								<Icon
									name="ri:folder-open-line"
									class="text-muted-foreground h-5 w-5 shrink-0"
								/>
								<h3 class="text-foreground text-sm font-medium">Archivos</h3>
							</div>
							<p class="text-muted-foreground mt-1 text-sm">
								Archivos subidos y compartidos de esta empresa.
							</p>
						</div>
						<div>
							<CompanyDocumentsList
								documents={documents}
								canUseStaffActions={canUseStaffActions}
								canDelete={canDeleteDocuments}
								incorporationCaseId={incorporationCaseId ?? ''}
								companyUserId={company.user_id}
								isStaffDashboard={isStaffDashboard}
								client:load
							/>
						</div>
					</div>
				</div>
			</>
		)
	}
</div>
