---
import { Icon } from 'astro-icon/components';
import {
	getIncorporacionById,
	getIncorporacionByIdAdmin,
} from '@lib/tables/companies/empresa_incorporaciones';
import {
	getDocumentRequestsForIncorporationCase,
	getDocumentsForIncorporationCase,
	getDocumentTypesList,
} from '@lib/tables/documents/document_dashboard';
import { supabaseAdmin } from '@lib/supabase/admin';
import { DocumentTypeComboboxField } from '@modules/documents/views/documentTypeComboboxField';

interface Props {
	incorporationCaseId: string | undefined;
	showQuickUpload?: boolean;
	dashboardVariant?: 'client' | 'staff';
}

const {
	incorporationCaseId,
	showQuickUpload = true,
	dashboardVariant = 'client',
} = Astro.props;
const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];
const hasStaffRole =
	userRoles.includes('admin') || userRoles.includes('operaciones');
const isStaffDashboard = dashboardVariant === 'staff';
const canUseStaffActions = isStaffDashboard && hasStaffRole;
const documentDetailBasePath = isStaffDashboard
	? `/incorporations/${incorporationCaseId}/documents`
	: `/my-companies/${incorporationCaseId}/documents`;
const dataClient = isStaffDashboard ? supabaseAdmin : supabase;

let errorMessage = '';
let company: any = null;
let requests: any[] = [];
let documents: any[] = [];
let documentTypes: any[] = [];

if (!userId) {
	errorMessage = 'No autenticado';
} else if (!incorporationCaseId) {
	errorMessage = 'ID de incorporación no válido';
} else {
	company = isStaffDashboard
		? await getIncorporacionByIdAdmin(dataClient, incorporationCaseId)
		: await getIncorporacionById(supabase, incorporationCaseId, userId);

	if (!company) {
		errorMessage = 'Empresa no encontrada';
	} else {
		[requests, documents, documentTypes] = await Promise.all([
			getDocumentRequestsForIncorporationCase(dataClient, incorporationCaseId),
			getDocumentsForIncorporationCase(
				supabaseAdmin,
				incorporationCaseId,
				userId,
				userRoles,
			),
			getDocumentTypesList(dataClient),
		]);
	}
}

const uploadEndpointBase = `/api/documents/upload?incorporationCaseId=${encodeURIComponent(
	incorporationCaseId ?? '',
)}&back=${encodeURIComponent(Astro.url.pathname)}`;

const BLOCKED_REQUEST_STATUSES = new Set([
	'approved',
	'closed',
	'cancelled',
	'rejected',
]);

const canUploadForRequest = (status: string) =>
	!BLOCKED_REQUEST_STATUSES.has(status);
---

<div class="px-4 pt-2">
	{
		errorMessage ? (
			<div class="rounded-lg border border-dashed border-gray-200 p-6 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">
				{errorMessage}
			</div>
		) : (
			<>
				<div class="mb-6 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
					<div>
						<h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
							{company.nombre_1 ?? 'Empresa'}
						</h1>
						<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
							{company.estado_de_incorporacion ?? 'Sin estado'} ·{' '}
							{company.estado ?? '—'}
						</p>
					</div>
					<div class="flex items-center gap-2 text-xs">
						<span class="rounded-full bg-gray-100 px-2.5 py-1 font-medium text-gray-800 dark:bg-gray-400/20 dark:text-gray-300">
							{requests.length} solicitudes
						</span>
						<span class="rounded-full bg-gray-100 px-2.5 py-1 font-medium text-gray-800 dark:bg-gray-400/20 dark:text-gray-300">
							{documents.length} documentos
						</span>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
					<section class="to-black-600 from-black-900 rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-linear-to-tl">
						{canUseStaffActions && showQuickUpload ? (
							<div class="mb-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 dark:border-gray-600 dark:bg-white/5">
								<h3 class="text-sm font-semibold text-gray-900 dark:text-white">
									Subida rápida (Operaciones/Admin)
								</h3>
								<form
									method="post"
									enctype="multipart/form-data"
									action={uploadEndpointBase}
									class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-2"
								>
									<input
										type="file"
										name="file"
										required
										class="block w-full text-sm text-gray-900 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-200 dark:text-gray-200 dark:file:bg-white/10 dark:file:text-gray-200 dark:hover:file:bg-white/15"
										accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
									/>
									<DocumentTypeComboboxField
										client:load
										documentTypes={documentTypes}
									/>
									<select
										name="visibility"
										class="block w-full rounded-lg border border-gray-200 bg-white px-2 py-2 text-sm text-gray-700 dark:border-gray-700 dark:bg-white/5 dark:text-gray-300"
									>
										<option value="internal_only">Interno</option>
										<option value="client_visible">Visible</option>
									</select>
									<select
										name="shareWithClient"
										class="block w-full rounded-lg border border-gray-200 bg-white px-2 py-2 text-sm text-gray-700 dark:border-gray-700 dark:bg-white/5 dark:text-gray-300"
									>
										<option value="false">No compartir</option>
										<option value="true">Compartir</option>
									</select>
									<div class="md:col-span-2">
										<button
											type="submit"
											class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
										>
											<Icon name="ri:upload-2-line" class="text-base" />
											Subir documento
										</button>
									</div>
								</form>
							</div>
						) : null}

						<div class="mb-3 flex items-center justify-between">
							<h2 class="text-lg font-semibold text-gray-900 dark:text-white">
								Solicitudes
							</h2>
						</div>

						{requests.length === 0 ? (
							<div class="rounded-lg border border-dashed border-gray-200 p-6 text-center text-sm text-gray-500 dark:border-gray-700 dark:text-gray-300">
								No hay solicitudes de documentos para esta empresa.
							</div>
						) : (
							<ul class="space-y-3">
								{requests.map((request) => (
									<li class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
										<p class="text-sm font-semibold text-gray-900 dark:text-white">
											{request.document_type?.name ?? 'Documento requerido'}
										</p>
										<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
											Status: {request.status}
											{request.due_date ? ` · Vence: ${request.due_date}` : ''}
										</p>

										{canUploadForRequest(request.status) ? (
											<form
												method="post"
												enctype="multipart/form-data"
												action={`${uploadEndpointBase}&documentRequestId=${encodeURIComponent(request.id)}`}
												class="mt-3 flex flex-col gap-2"
											>
												<input
													type="file"
													name="file"
													required
													class="block w-full text-sm text-gray-900 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-200 dark:text-gray-200 dark:file:bg-white/10 dark:file:text-gray-200 dark:hover:file:bg-white/15"
													accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.webp"
												/>
												{canUseStaffActions ? (
													<select
														name="visibility"
														class="block w-full rounded-lg border border-gray-200 bg-white px-2 py-1 text-xs text-gray-700 dark:border-gray-700 dark:bg-white/5 dark:text-gray-300"
													>
														<option value="internal_only">Interno</option>
														<option value="client_visible">
															Visible cliente
														</option>
													</select>
												) : null}
												<button
													type="submit"
													class="inline-flex w-fit items-center gap-2 rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
												>
													<Icon name="ri:upload-2-line" class="text-base" />
													Subir
												</button>
											</form>
										) : (
											<p class="mt-3 text-xs font-medium text-amber-700 dark:text-amber-300">
												La solicitud está {request.status}. No se permiten
												nuevas cargas.
											</p>
										)}
									</li>
								))}
							</ul>
						)}
					</section>

					<section class="to-black-600 from-black-900 rounded-lg border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-linear-to-tr">
						<div class="mb-3 flex items-center justify-between">
							<h2 class="text-lg font-semibold text-gray-900 dark:text-white">
								Documentos
							</h2>
						</div>

						{documents.length === 0 ? (
							<div class="rounded-lg border border-dashed border-gray-200 p-6 text-center text-sm text-gray-500 dark:border-gray-700 dark:text-gray-300">
								Aún no hay documentos para esta empresa.
							</div>
						) : (
							<ul class="divide-y divide-gray-200 dark:divide-gray-700">
								{documents.map((document) => (
									<li class="flex items-start justify-between gap-3 py-4">
										<div class="min-w-0">
											<p class="truncate text-sm font-semibold text-gray-900 dark:text-white">
												<a
													href={`${documentDetailBasePath}/${document.id}`}
													class="hover:underline"
												>
													{document.file_title ?? document.file_name}
												</a>
											</p>
											<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
												{document.document_type?.name ?? 'Documento'} ·{' '}
												{document.status}
												<span class="mx-1">·</span>
												{document.visibility === 'client_visible'
													? 'Visible cliente'
													: 'Interno'}
											</p>
										</div>

										<div class="flex shrink-0 items-center gap-2">
											<button
												type="button"
												class="btn-doc-download inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-semibold text-gray-800 hover:bg-gray-50 dark:border-gray-700 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
												data-document-id={document.id}
											>
												<Icon name="ri:download-2-line" class="text-base" />
												Descargar
											</button>
											{canUseStaffActions ? (
												<>
													<button
														type="button"
														class="btn-doc-history inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm font-semibold text-gray-800 hover:bg-gray-100 dark:border-gray-600 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
														data-document-id={document.id}
													>
														<Icon name="ri:history-line" class="text-base" />
														Historial
													</button>
													{document.shares.some(
														(share: {
															shared_with_user_id: string;
															share_status: string;
														}) =>
															share.shared_with_user_id === company.user_id &&
															share.share_status === 'active',
													) ? (
														<button
															type="button"
															class="btn-doc-revoke inline-flex items-center gap-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-100 dark:border-amber-500/50 dark:bg-amber-500/10 dark:text-amber-200 dark:hover:bg-amber-500/20"
															data-document-id={document.id}
															data-shared-with-user-id={company.user_id}
														>
															<Icon name="ri:forbid-2-line" class="text-base" />
															Revocar
														</button>
													) : (
														<button
															type="button"
															class="btn-doc-share inline-flex items-center gap-2 rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-100 dark:border-emerald-500/50 dark:bg-emerald-500/10 dark:text-emerald-200 dark:hover:bg-emerald-500/20"
															data-document-id={document.id}
															data-shared-with-user-id={company.user_id}
														>
															<Icon
																name="ri:share-forward-line"
																class="text-base"
															/>
															Compartir
														</button>
													)}
												</>
											) : null}
										</div>
									</li>
								))}
							</ul>
						)}
					</section>
				</div>
			</>
		)
	}
</div>

<script is:inline>
	document.addEventListener('click', async (e) => {
		const target = e.target;
		if (!(target instanceof HTMLElement)) return;

		const downloadBtn = target.closest('.btn-doc-download');
		if (downloadBtn) {
			const documentId = downloadBtn.dataset.documentId;
			if (!documentId) return;
			try {
				const res = await fetch('/api/documents/signed-url', {
					method: 'POST',
					credentials: 'include',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ documentId }),
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data?.error || 'Error');
				window.open(data.signedUrl, '_blank');
			} catch (error) {
				console.error('Error al descargar documento:', error);
				alert('No se pudo descargar el documento');
			}
			return;
		}

		const shareBtn = target.closest('.btn-doc-share');
		if (shareBtn) {
			const documentId = shareBtn.dataset.documentId;
			const sharedWithUserId = shareBtn.dataset.sharedWithUserId;
			if (!documentId || !sharedWithUserId) return;
			try {
				const res = await fetch('/api/documents/share', {
					method: 'POST',
					credentials: 'include',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ documentId, sharedWithUserId }),
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data?.error || 'Error');
				window.location.reload();
			} catch (error) {
				console.error('Error al compartir documento:', error);
				alert('No se pudo compartir el documento');
			}
			return;
		}

		const revokeBtn = target.closest('.btn-doc-revoke');
		if (revokeBtn) {
			const documentId = revokeBtn.dataset.documentId;
			const sharedWithUserId = revokeBtn.dataset.sharedWithUserId;
			if (!documentId || !sharedWithUserId) return;
			try {
				const res = await fetch('/api/documents/revoke-share', {
					method: 'POST',
					credentials: 'include',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ documentId, sharedWithUserId }),
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data?.error || 'Error');
				window.location.reload();
			} catch (error) {
				console.error('Error al revocar compartición:', error);
				alert('No se pudo revocar la compartición');
			}
			return;
		}

		const historyBtn = target.closest('.btn-doc-history');
		if (!historyBtn) return;
		const documentId = historyBtn.dataset.documentId;
		if (!documentId) return;
		try {
			const res = await fetch(
				`/api/documents/events?documentId=${encodeURIComponent(documentId)}`,
				{
					method: 'GET',
					credentials: 'include',
				},
			);
			const data = await res.json();
			if (!res.ok) throw new Error(data?.error || 'Error');
			const text =
				(data.events || [])
					.map(
						(eventItem) =>
							`${eventItem.created_at} · ${eventItem.event_type} · ${eventItem.actor_role}`,
					)
					.join('\n') || 'Sin eventos';
			alert(text);
		} catch (error) {
			console.error('Error al cargar historial:', error);
			alert('No se pudo cargar el historial');
		}
	});
</script>
