---
import Alerta from '@components/feedback/alertageneral.astro';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import { pagosRealizadosData } from '@lib/tablas/payments/PagosPorLeer';
import PagosRealizadosTable from '@modules/billing/views/PagosRealizadosTable';

const supabase = Astro.locals.supabase;

const pagosRealizados = await pagosRealizadosData(supabase);
---

<Alerta />
<div>
	<div
		class="block w-full items-center justify-between border-b border-gray-200 p-4 sm:flex lg:mt-1.5"
	>
		<CrudPageHeader
			title="Todos los pagos realizados"
			breadcrumbItems={[
				{ label: 'Formularios', href: '/formularios/enviados/' },
			]}
			refreshHref="/admin/pagos/"
		/>
	</div>

	<div class="flex flex-col">
		<div class="overflow-x-auto">
			<div class="inline-block min-w-full align-middle">
				<div class="overflow-hidden shadow">
					<PagosRealizadosTable data={pagosRealizados ?? []} client:load />
				</div>
			</div>
		</div>
	</div>
</div>
