---
import Alerta from '@components/feedback/Alert.astro';
import { pagosRealizadosData } from '@domains/payments/unread';
import Tabs from '@modules/billing/islands/Tabs';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';

const supabase = Astro.locals.supabase;

const pagosRealizados = await pagosRealizadosData(supabase);
---

<Alerta />
<div class="space-y-4 p-4 lg:p-6">
	<div class="overflow-hidden shadow">
		<CrudPageHeader
			title="Gestiona los pagos y ordenes"
			descripcion="Pagos y Ordenes"
			classAlt="px-4 pt-4"
		/>

		<Tabs data={pagosRealizados ?? []} client:load />
	</div>
</div>
