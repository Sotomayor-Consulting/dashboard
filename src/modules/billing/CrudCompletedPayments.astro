---
import Alerta from '@components/feedback/alertageneral.astro';
import { pagosRealizadosData } from '@domains/payments/unread';
import Tabs from '@modules/billing/islands/Tabs';

const supabase = Astro.locals.supabase;

const pagosRealizados = await pagosRealizadosData(supabase);
---

<Alerta />
<div>
	<div class="flex flex-col">
		<div class="overflow-x-auto">
			<div class="inline-block min-w-full align-middle">
				<div class="mt-10 overflow-hidden shadow">
					<Tabs data={pagosRealizados ?? []} client:load />
				</div>
			</div>
		</div>
	</div>
</div>
