---
import { Icon } from 'astro-icon/components';

interface Props {
	userName: string;
}

const { userName } = Astro.props;

const options = [
	{
		id: 'crear',
		eyebrow: 'Opcion 01',
		title: 'Crea una empresa en EE. UU.',
		description:
			'Constituye una LLC o C-Corp en minutos, sin viajar. Incluye EIN, agente registrado y acuerdo operativo.',
		cta: 'Iniciar constitucion',
		href: '/start/',
		icon: 'ri:sparkling-2-line',
		recommended: true,
	},
	{
		id: 'vincular',
		eyebrow: 'Opcion 02',
		title: 'Ya tengo mi empresa en EE. UU.',
		description:
			'Conecta tu empresa existente y deja que nos encarguemos del cumplimiento, impuestos y contabilidad.',
		cta: 'Vincular mi empresa',
		href: '/my-companies/',
		icon: 'ri:building-2-line',
		recommended: false,
	},
];

const benefits = [
	{
		title: 'Hecho para Latinoamerica',
		description:
			'Sin SSN ni viaje a EE. UU. Acepta pagos globales y factura en dolares desde el dia uno.',
		icon: 'ri:flashlight-line',
	},
	{
		title: 'Cumplimiento sin estres',
		description:
			'Reportes estatales, agente registrado e impuestos del IRS gestionados por expertos.',
		icon: 'ri:shield-check-line',
	},
	{
		title: 'Soporte en espanol',
		description:
			'Equipo bilingue disponible por WhatsApp en horario de Mexico, Colombia y Argentina.',
		icon: 'ri:message-2-line',
	},
];
---

<main class="min-h-screen px-4 py-8 sm:px-6 lg:px-10 lg:py-12">
	<div class="mx-auto w-full max-w-5xl">
		<header class="mb-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-black-800 sm:p-8 lg:mb-12 lg:p-10">
			<p class="mb-4 inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-1 text-[11px] font-semibold tracking-wide text-gray-500 uppercase dark:border-gray-600 dark:text-gray-400">
				<span class="h-1.5 w-1.5 rounded-full bg-[#8c681d]"></span>
				Panel de invitado · Latinoamerica
			</p>
			<h1 class="text-3xl font-semibold leading-tight text-gray-900 dark:text-white sm:text-4xl lg:text-5xl">
				Bienvenido,
				<br />
				<span class="text-gray-500 dark:text-gray-400">{userName}.</span>
			</h1>
			<p class="mt-4 max-w-3xl text-sm leading-7 text-gray-600 dark:text-gray-300 sm:text-base">
				Crea o gestiona tu empresa en Estados Unidos desde Latinoamerica. Elige el camino que mejor se adapte a ti y podras cambiarlo despues.
			</p>
		</header>

		<section
			aria-label="Elige como empezar"
			class="mb-12 grid grid-cols-1 gap-4 md:grid-cols-2"
		>
			{
				options.map((option) => (
					<a
						href={option.href}
						class={`group relative rounded-2xl border bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md dark:bg-black-800 ${
							option.recommended
								? 'border-[#8c681d]/50 dark:border-[#8c681d]/60'
								: 'border-gray-200 dark:border-gray-700'
						}`}
					>
						{option.recommended && (
							<span class="absolute top-5 right-5 rounded-full border border-[#8c681d]/35 bg-[#8c681d]/10 px-2.5 py-1 text-[10px] font-semibold tracking-wide text-[#8c681d] uppercase dark:border-[#8c681d]/40 dark:text-[#c9ac67]">
								Recomendado
							</span>
						)}

						<div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-gray-50 text-gray-700 dark:border-gray-700 dark:bg-black-900 dark:text-gray-200">
							<Icon name={option.icon} class="h-5 w-5" />
						</div>

						<p class="mb-2 text-[11px] font-semibold tracking-[0.16em] text-gray-500 uppercase dark:text-gray-400">
							{option.eyebrow}
						</p>
						<h2 class="text-xl font-semibold leading-tight text-gray-900 dark:text-white lg:text-2xl">
							{option.title}
						</h2>
						<p class="mt-3 text-sm leading-7 text-gray-600 dark:text-gray-300">
							{option.description}
						</p>

						<div class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-100">
							<span>{option.cta}</span>
							<Icon name="ri:arrow-right-up-line" class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
						</div>
					</a>
				))
			}
		</section>

		<section aria-labelledby="beneficios" class="mb-12">
			<div class="mb-8 flex items-center gap-4">
				<span class="h-px flex-1 bg-gray-200 dark:bg-gray-700"></span>
				<h2 id="beneficios" class="text-[11px] font-semibold tracking-[0.2em] text-gray-500 uppercase dark:text-gray-400">
					Por que nos eligen los founders LATAM
				</h2>
				<span class="h-px flex-1 bg-gray-200 dark:bg-gray-700"></span>
			</div>

			<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
				{
					benefits.map((benefit) => (
						<div class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-black-800">
							<Icon name={benefit.icon} class="mb-3 h-5 w-5 text-[#8c681d]" />
							<h3 class="text-base font-semibold text-gray-900 dark:text-white">
								{benefit.title}
							</h3>
							<p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300">
								{benefit.description}
							</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-black-800 sm:p-8">
			<div class="mb-4 flex justify-center text-[#8c681d]">
				{
					Array.from({ length: 5 }).map(() => (
						<Icon name="ri:star-fill" class="h-4 w-4" />
					))
				}
			</div>
			<blockquote class="mx-auto max-w-3xl text-center text-xl leading-relaxed font-medium text-gray-900 dark:text-white sm:text-2xl">
				"Constituimos nuestra C-Corp en Delaware desde Bogota en una tarde. Sotomayor Consulting nos abrio las puertas para facturar a clientes de EE. UU. sin complicaciones."
			</blockquote>
			<p class="mt-5 text-center text-sm text-gray-600 dark:text-gray-300">
				<span class="font-semibold text-gray-900 dark:text-white">Marta Velez</span>
				<span class="mx-2">·</span>
				Fundadora · Bogota, Colombia
			</p>
			<p class="mt-6 text-center text-xs tracking-[0.14em] text-gray-500 uppercase dark:text-gray-400">
				+10.000 founders LATAM · Mexico · Colombia · Argentina · Chile · 4.9 / 5 en Trustpilot
			</p>
		</section>

		<p class="mt-8 text-center text-xs text-gray-500 dark:text-gray-400">
			No sabes cual elegir?
			<a
				href="https://zcal.co/t/agendar-asesoria-llc/60min"
				target="_blank"
				class="ml-1 font-semibold text-gray-900 underline decoration-gray-300 underline-offset-4 hover:text-[#8c681d] dark:text-gray-100 dark:decoration-gray-600"
			>
				Habla con un especialista en espanol
			</a>
		</p>
	</div>
</main>
