---
import Alerta from '@components/feedback/alertageneral.astro';
import { pagosRealizadosPorSubir } from '@lib/tablas/PagosPorLeer';

import '@styles/datatables.css';

const supabase = Astro.locals.supabase;
const empresas = await pagosRealizadosPorSubir(supabase);
---

<script src="@lib/alpinejs/alpine.js"></script>
<div
	class="dark:bg-black-900 block items-center justify-between border-b border-gray-200 p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<Alerta />
	<div class="mb-1 w-full">
		<div class="mb-4">
			<nav class="mb-5 flex" aria-label="Breadcrumb">
				<ol
					class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
				>
					<li class="inline-flex items-center">
						<a
							href="/"
							class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
						>
							<svg
								class="mr-2.5 h-5 w-5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
								></path></svg
							>
							Inicio
						</a>
					</li>

					<li>
						<div class="flex items-center">
							<svg
								class="h-6 w-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"></path></svg
							>
							<p class="dark:text-white-50 ml-1 text-gray-700 md:ml-2">
								Subir documentos
							</p>
						</div>
					</li>
				</ol>
			</nav>
			<h1
				class="text-white-900 text-xl font-semibold sm:text-2xl dark:text-white"
			>
				Lista de empresas
			</h1>
		</div>
	</div>
</div>
<div class="flex flex-col">
	<div class="overflow-x-auto">
		<div class="inline-block min-w-full align-middle">
			<div class="overflow-hidden shadow">
				<table
					class="min-w-full table-fixed divide-y divide-gray-200 dark:divide-gray-600"
					id="myTable"
				>
					<thead class="bg-gray-100 dark:bg-[#374151]">
						<tr>
							{
								['Cliente', 'Empresa', 'Plan', 'Estado'].map((th) => (
									<th
										scope="col"
										class="p-4 text-left text-xs font-medium text-gray-500 uppercase dark:text-gray-400"
									>
										<span class="flex items-center uppercase">
											{th}
											<svg
												class="ms-1 h-4 w-4"
												aria-hidden="true"
												xmlns="http://www.w3.org/2000/svg"
												width="24"
												height="24"
												fill="none"
												viewBox="0 0 24 24"
											>
												<path
													stroke="currentColor"
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="m8 15 4 4 4-4m0-6-4-4-4 4"
												/>
											</svg>
										</span>
									</th>
								))
							}
						</tr>
					</thead>
					<tbody
						class="dark:bg-black-800 divide-y divide-gray-200 bg-white dark:divide-gray-700"
					>
						{
							empresas?.map((e) => (
								<div>
									<tr
										class="odd:bg-white cursor-pointer even:bg-gray-50 hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]"
										onclick={`window.open('/forms/upload_documents/${e.empresas_incorporaciones.empresa_incorporacion_id}', '_blank')`}
									>
										<td class="mr-12 flex items-center space-x-6 p-4 whitespace-nowrap">
											<div class="text-sm font-normal text-gray-500 dark:text-gray-400">
												<div class="text-base font-semibold text-gray-900 dark:text-white">
													{e.usuarios.nombre} {e.usuarios.apellido}
												</div>
												<div class="text-sm font-normal text-gray-500 dark:text-gray-400">
													{e.usuarios.correo}
												</div>
											</div>
										</td>
										<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
											{e.empresas_incorporaciones.nombre_1}
										</td>
										<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
											{e.servicios.nombre}
										</td>

										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											<div class="flex items-center">
												{e.empresas_incorporaciones.estado === 'Activo' ? (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-green-400" />
												) : (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-red-500" />
												)}
												{e.empresas_incorporaciones.estado}
											</div>
										</td>
									</tr>
								</div>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<!-- Top Right Modal -->
<div
	id="top-right-modal"
	data-modal-placement="top-right"
	tabindex="-1"
	class="fixed top-0 right-0 left-0 z-50 hidden h-full w-full overflow-x-hidden overflow-y-auto p-4 md:inset-0"
>
	<div class="relative h-full w-full max-w-2xl">
		<!-- Modal content -->
		<div
			class="relative h-full rounded-lg bg-white shadow-sm dark:bg-[#0e2738]"
		>
			<!-- Modal header -->
			<div
				class="flex items-center justify-between rounded-t border-b border-gray-200 p-4 md:p-5 dark:border-gray-600"
			>
				<h3 class="text-xl font-medium text-gray-900 dark:text-white">
					Subir archivo
				</h3>
				<button
					type="button"
					class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					data-modal-hide="top-right-modal"
				>
					<svg
						class="h-3 w-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 14 14"
					>
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
					</svg>
					<span class="sr-only">Cerrar modal</span>
				</button>
			</div>
			<!-- Modal body -->
			<div class="space-y-4 p-4 md:p-5">
				<form action="/api/update/admin-notifications-update" method="post">
					<input
						type="text"
						name="user_id_modal_name"
						id="user_id_modal"
						hidden
					/>
					<div class="mb-4 grid gap-4 sm:grid-cols-2">
						<div>
							<label
								for="descripcion-link-notificacion"
								class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
								>Descripción del link</label
							>
							<input
								type="text"
								name="descripcion-link-notificacion"
								id="descripcion-link-notificacion"
								class="dark:bg-black-900 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
								placeholder="Inserta el link"
								required=""
							/>
						</div>
						<div>
							<label
								for="link-notificacion"
								class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
								>Link</label
							>
							<input
								type="text"
								name="link-notificacion"
								id="link-notificacion"
								class="dark:bg-black-900 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
								placeholder="Inserta el asunto del correo"
								required=""
							/>
						</div>
						<div class="h-full sm:col-span-2">
							<label
								for="mensaje-notificacion"
								class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
								>Mensaje</label
							>
							<textarea
								id="mensaje-notificacion"
								name="mensaje-notificacion"
								rows="28"
								class="focus:ring-primary-500 focus:border-primary-500 dark:bg-black-900 mb-2 block h-full w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
								placeholder="Escribe un mensaje corto para el usuario"
								required></textarea>
						</div>
					</div>
					<div
						class="flex items-center space-x-3 rounded-b border-t border-gray-200 p-4 md:p-5 rtl:space-x-reverse dark:border-gray-600"
					>
						<button
							data-modal-hide="top-right-modal"
							type="submit"
							class="rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
							>Enviar notificación</button
						>
						<button
							data-modal-hide="top-right-modal"
							type="button"
							class="ms-3 rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white dark:focus:ring-gray-700"
							>Cancelar</button
						>
					</div>
				</form>
			</div>
			<!-- Modal footer -->
		</div>
	</div>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		// Obtener todos los botones de notificación
		const notificationButtons = document.querySelectorAll(
			'button[data-user-notification]',
		);

		notificationButtons.forEach(function (button) {
			button.addEventListener('click', function () {
				// Obtener el user_id del dataset
				const userId = this.getAttribute('data-user-id');

				// Buscar el input en el modal por su name
				const userInput = document.querySelector(
					'input[name="user_id_modal_name"]',
				);

				if (userInput && userId) {
					// Asignar el valor
					userInput.value = userId;
				} else {
					console.log('No se encontró el input o no hay user_id');
					console.log('User ID desde dataset:', userId);
					console.log('Input encontrado:', userInput);
				}
			});
		});
	});
</script>
<script>
	import { DataTable } from '@lib/simple-data-tables/simple-data-table.js';

	function initDT() {
		const el = document.querySelector('#myTable') as HTMLElement | null;
		if (!el) return;
		if ((el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit === '1')
			return;

		new DataTable(el, {
			searchable: true,
			perPage: 25,
			perPageSelect: [5, 10, 25, 50],

			// Textos en español
			labels: {
				placeholder: 'Buscar...',
				perPage: 'Filas',
				noRows: 'No hay Empresas',
				noResults: 'No se encontraron resultados',
				info: 'Mostrando {start} de {rows} registros',
			},

			// Layout estilo Flowbite (arriba: perPage + search / abajo: info + paging)
			layout: {
				top: '{select}{search}',
				bottom: '{info}{pager}',
			},
		});

		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit = '1';
		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInstance = '1';
	}

	initDT();
	document.addEventListener('astro:page-load', initDT);
</script>
