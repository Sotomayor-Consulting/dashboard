---
import Alerta from '@components/feedback/alertageneral.astro';

import '@styles/datatables.css';
import { getAllUsuarios } from '@lib/tablas/usuarios';
import { RolesGeneralUsers } from '@lib/tablas/roles';

const supabase = Astro.locals.supabase;
const [usuarios, roles] = await Promise.all([
	getAllUsuarios(supabase),
	RolesGeneralUsers(supabase),
]);
---

<script src="@lib/alpinejs/alpine.js"></script>
<div
	class="dark:bg-black-900 block items-center justify-between border-b border-gray-200 bg-white p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<Alerta />
	<div class="mb-1 w-full">
		<div class="mb-4">
			<nav class="mb-5 flex" aria-label="Breadcrumb">
				<ol
					class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
				>
					<li class="inline-flex items-center">
						<a
							href="/"
							class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
						>
							<svg
								class="mr-2.5 h-5 w-5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
								></path></svg
							>
							Inicio
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="h-6 w-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"></path></svg
							>
							<a
								href="/crud/notificaciones-personalizadas"
								class="ml-1 text-gray-700 hover:text-[#967432] md:ml-2 dark:text-gray-300 dark:hover:text-white"
								>Notificaciones</a
							>
						</div>
					</li>
				</ol>
			</nav>
			<h1
				class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
			>
				Envio de notificaciones
			</h1>
		</div>
	</div>
</div>
<div class="flex flex-col">
	<div class="overflow-x-auto">
		<div class="inline-block min-w-full align-middle">
			<div class="overflow-hidden shadow">
				<table class="divide-gray-200 dark:divide-gray-600" id="myTable">
					<thead class="bg-gray-100 dark:bg-[#374151]">
						<tr>
							{
								[
									{ col: 'avatar', label: 'Avatar', width: '10%' },
									{ col: 'Nombre', label: 'Nombre', width: '20%' },
									{ col: 'Compañía', label: 'Compañía', width: '10%' },
									{ col: 'Cargo', label: 'Cargo', width: '10%' },
									{ col: 'País', label: 'País', width: '10%' },
									{ col: 'Estado', label: 'Estado', width: '10%' },
									{ col: 'Rol', label: 'Rol', width: '10%' },
									{ col: 'Acciones', label: 'Acciones', width: '10%' },
								].map((th) => (
									<th
										scope="col"
										class="w-2 p-4 text-left text-xs font-medium text-gray-500 uppercase dark:text-gray-400"
										width={th.width}
									>
										<span class="flex items-center uppercase">
											{th.col}
											<svg
												class="ms-1 h-4 w-4"
												aria-hidden="true"
												xmlns="http://www.w3.org/2000/svg"
												width="24"
												height="24"
												fill="none"
												viewBox="0 0 24 24"
											>
												<path
													stroke="currentColor"
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="m8 15 4 4 4-4m0-6-4-4-4 4"
												/>
											</svg>
										</span>
									</th>
								))
							}
						</tr>
					</thead>
					<tbody
						class="dark:bg-black-800 divide-gray-200 bg-white dark:divide-gray-700"
					>
						{
							usuarios?.map((user) => (
								<div>
									<tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]">
										<td style="width: 5px;">
											{user.avatar_url === 'NULL' || !user.avatar_url ? (
												<img
													class="h-10 w-10 rounded-full"
													src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${user.nombre}`}
													alt={`Avatar de ${user.nombre}`}
												/>
											) : (
												<img
													class="h-10 w-10 rounded-full"
													src={user.avatar_url}
													alt={`Avatar de ${user.nombre}`}
												/>
											)}
										</td>
										<td class="mr-12 flex items-center space-x-6 p-4 whitespace-nowrap">
											<div class="text-sm font-normal text-gray-500 dark:text-gray-400">
												<div class="text-base font-semibold text-gray-900 dark:text-white">
													{user.nombre} {user.apellido}
												</div>
												<div class="text-sm font-normal text-gray-500 dark:text-gray-400">
													{user.correo}
												</div>
											</div>
										</td>
										<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
											{user.organizacion}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{user.cargo}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{user.paises?.nombre_paises ?? '—'}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											<div class="flex items-center">
												{user.estado === 'activo' ? (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-green-400" />
												) : (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-red-500" />
												)}
												{user.estado}
											</div>
										</td>
										<td class="p-4 text-base font-normal whitespace-nowrap text-gray-900 dark:text-white">
											<div class="flex items-center gap-1">
												{roles?.map(
													(rol) =>
														user.user_id === rol.user_id &&
														(() => {
															// Definir clases según el nombre del rol
															let badgeClass =
																'text-xs font-medium px-1.5 py-0.5 rounded ';

															switch (rol.roles.name) {
																case 'admin':
																	badgeClass +=
																		'bg-danger-soft text-fg-danger-strong';
																	break;
																case 'cliente':
																	badgeClass +=
																		'bg-success-soft text-fg-success-strong';
																	break;
																case 'partner':
																	badgeClass +=
																		'bg-warning-soft text-fg-warning';
																	break;
																case 'operaciones':
																	badgeClass +=
																		'bg-warning-soft text-fg-warning';
																	break;
																default:
																	badgeClass +=
																		'bg-success-soft text-fg-success-strong';
															}

															return (
																<span class={badgeClass}>{rol.roles.name}</span>
															);
														})(),
												)}
											</div>
										</td>
										<td class="flex space-x-2 p-4">
											<button
												data-modal-target="send-email-modal"
												data-modal-toggle="send-email-modal"
												data-user-notification
												data-email={user.correo}
												data-user-id={user.user_id}
												class="notify-btn block w-full rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none md:w-auto dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
												type="button"
											>
												Enviar notificación
											</button>
										</td>
									</tr>
								</div>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		// Obtener todos los botones de notificación
		const notificationButtons = document.querySelectorAll(
			'button[data-user-notification]',
		);

		notificationButtons.forEach(function (button) {
			button.addEventListener('click', function () {
				// Obtener el user_id del dataset
				const userId = this.getAttribute('data-user-id');

				// Buscar el input en el modal por su name
				const userInput = document.querySelector(
					'input[name="user_id_modal_name"]',
				);

				if (userInput && userId) {
					// Asignar el valor
					userInput.value = userId;
				} else {
					console.log('No se encontró el input o no hay user_id');
					console.log('User ID desde dataset:', userId);
					console.log('Input encontrado:', userInput);
				}
			});
		});
	});
</script>
<script>
	import { DataTable } from '@lib/simple-data-tables/simple-data-table.js';

	function initDT() {
		const el = document.querySelector('#myTable') as HTMLElement | null;
		if (!el) return;
		if ((el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit === '1')
			return;

		new DataTable(el, {
			searchable: true,
			perPage: 25,
			perPageSelect: [5, 10, 25, 50],

			// Textos en español
			labels: {
				placeholder: 'Buscar...',
				perPage: 'Filas',
				noRows: 'No hay usuarios',
				noResults: 'No se encontraron usuarios',
				info: 'Mostrando {start} a {end} de {rows} registros',
			},

			// Layout estilo Flowbite (arriba: perPage + search / abajo: info + paging)
			layout: {
				top: '{select}{search}',
				bottom: '{info}{pager}',
			},
		});

		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit = '1';
		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInstance = '1';
	}

	initDT();
	document.addEventListener('astro:page-load', initDT);
</script>

<script>
	import { initModals } from 'flowbite';

	initModals();

	const email = document.getElementById('email') as HTMLInputElement;

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.notify-btn') as HTMLButtonElement;

		if (btn && email) {
			email.value = btn.dataset.email || '';
		}
	});
</script>
