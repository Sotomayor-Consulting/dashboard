---
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import PictureUploader from '@components/forms/PictureUploader.astro';
import { PaisesGeneral } from '@lib/tablas/paises';
import { FacturacionbyId } from '@lib/tablas/facturacion';
import { getUsuarioById } from '@lib/tablas/usuarios';

const supabase = Astro.locals.supabase;

const email = Astro.locals.user?.email;
const user = Astro.locals.user;
const userId = user?.id ?? '';

const [paises, usuario, facturacion] = await Promise.all([
	PaisesGeneral(supabase),
	getUsuarioById(supabase, userId),
	FacturacionbyId(supabase, userId),
]);

type Opcion = {
	value: string;
	label: string;
};

const opcionesPerfil: Opcion[] = [
	{ value: 'Cédula', label: 'Cédula' },
	{ value: 'RUC', label: 'RUC' },
	{ value: 'ID', label: 'ID' },
	{ value: 'Pasaporte', label: 'Pasaporte' },
	{ value: 'EIN', label: 'EIN' },
];

const TipoPersonaOptions: Opcion[] = [
	{ value: 'Natural', label: 'Natural' },
	{ value: 'Jurídica', label: 'Jurídica' },
];

const TipoIdentificacionOptions: Opcion[] = [
	{ value: 'Cédula', label: 'Cédula' },
	{ value: 'RUC', label: 'RUC' },
	{ value: 'ID', label: 'ID' },
	{ value: 'Pasaporte', label: 'Pasaporte' },
	{ value: 'EIN', label: 'EIN' },
];

const inputClass =
	'bg-white dark:bg-black-900 block w-full rounded-lg border border-gray-300 p-2.5 text-gray-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]';
const inputTextClass =
	'bg-white dark:bg-black-900 block w-full rounded-lg border border-gray-300 p-2.5 text-sm text-gray-900 focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]';
const labelClass =
	'mb-2 block text-sm font-medium text-gray-900 dark:text-white';
const cardClass =
	'dark:bg-black-800 mb-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-gray-700';
const submitBtnClass =
	'focus:ring-primary-300 rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]';
---

<div class="grid grid-cols-1 px-4 pt-6 xl:grid-cols-3 xl:gap-4">
	<div class="col-span-full mb-4 xl:mb-2">
		<CrudPageHeader
			title="Configuraciones de usuario"
			breadcrumbItems={[{ label: 'Configuracion' }]}
		/>
	</div>
	<!-- Right Content -->
	<div class="col-span-full xl:col-auto">
		<div class={cardClass}>
			<div
				class="items-center sm:flex sm:space-x-4 xl:block xl:space-x-0 2xl:flex 2xl:space-x-4"
			>
				<PictureUploader title="Foto de perfil" />
			</div>
		</div>
		<div class={cardClass}>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">Rol de cuenta</h3>
			<div class="mb-4">
				<label for="" class={`${inputClass} cursor-not-allowed`}>{email}</label>
			</div>

			<div>
				<a href="/" class={submitBtnClass}>Promover a cuenta de asociado</a>
			</div>
		</div>
		<div class={cardClass}>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">
				Canjear código de Referido
			</h3>
			<form action="/api/partners_code/code_canje" method="POST">
				<div class="mb-4">
					<input
						type="text"
						name="code"
						class={inputClass}
						placeholder="Ejemplo: 9F2A7C4B"
					/>
				</div>

				<div>
					<button type="submit" class={submitBtnClass}>Canjear</button>
				</div>
			</form>
		</div>
	</div>
	<div class="col-span-2">
		<div class={cardClass}>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">
				Información General
			</h3>
			<form method="post" action="/api/update/update-profile">
				<div class="grid grid-cols-6 gap-6">
					<div class="col-span-6 sm:col-span-3">
						<label for="first-name" class={labelClass}>Nombre</label>
						<input
							type="text"
							name="nombre"
							value={usuario?.nombre ?? ''}
							id="first-name"
							class={inputClass}
							placeholder="Juan"
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="last-name" class={labelClass}>Apellido</label>
						<input
							type="text"
							name="apellido"
							id="last-name"
							class={inputClass}
							placeholder="Green"
							value={usuario.apellido ?? ''}
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="country" class={labelClass}>Pais</label>
						<select name="pais" class={inputTextClass}>
							<option value="" selected={!usuario?.pais_id}
								>Seleccione un país</option
							>
							{
								paises?.map((p) => (
									<option value={p.id} selected={usuario?.pais_id === p.id}>
										{p.nombre_paises}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="city" class={labelClass}>Ciudad</label>
						<input
							type="text"
							name="ciudad"
							value={usuario?.ciudad ?? ''}
							id="city"
							class={inputClass}
							placeholder="ejem. San Francisco"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="direccion" class={labelClass}>Dirección linea 1</label>
						<input
							type="text"
							name="direccion"
							value={usuario?.direccion_linea1 ?? ''}
							id="address"
							class={inputClass}
							placeholder="ejem. Av. Juan Molineros"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="direccion2" class={labelClass}>Dirección linea 2</label>
						<input
							type="text"
							name="direccion2"
							value={usuario?.direccion_linea2 ?? ''}
							id="address"
							class={inputClass}
							placeholder="ejem. y De los Guayacanes"
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="tipo_de_documento" class={labelClass}
							>Tipo de documento</label
						>
						<select name="tipo_de_documento" class={inputTextClass}>
							<option
								value=""
								selected={!usuario?.tipo_identificacion}
								disabled
								hidden>Seleccione un tipo de documento</option
							>
							{
								opcionesPerfil?.map((p) => (
									<option
										value={p.value}
										selected={usuario?.tipo_identificacion === p.value}
									>
										{p.label}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="Numero_de_identificacion" class={labelClass}
							>Numero de identificacion</label
						>
						<input
							type="text"
							name="Numero_de_identificacion"
							value={usuario?.numero_de_identificacion ?? ''}
							id="address"
							class={inputClass}
							placeholder="1777745898"
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="tipo_de_persona" class={labelClass}
							>Tipo de persona</label
						>
						<select name="tipo_de_persona" class={inputTextClass}>
							<option value="" selected={!usuario?.tipo_persona} disabled hidden
								>Seleccione el tipo de persona</option
							>
							{
								TipoPersonaOptions?.map((p) => (
									<option
										value={p.value}
										selected={usuario?.tipo_persona === p.value}
									>
										{p.label}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="email" class={labelClass}>Email</label>
						<label for="" class={`${inputClass} cursor-not-allowed`}
							>{email}</label
						>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="phone-number" class={labelClass}
							>Numero de telefono</label
						>
						<input
							type="number"
							name="telefono"
							id="phone-number"
							value={usuario?.telf ?? ''}
							class={inputClass}
							placeholder="ejem. +(12)3456 789"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="birthday" class={labelClass}>Fecha de nacimiento</label>
						<input
							type="date"
							name="fecha_nacimiento"
							value={usuario?.fecha_nacimiento ?? ''}
							id="birthday"
							class={inputClass}
							placeholder="15/08/1990"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="organization" class={labelClass}
							>Organizacion a la que pertenece</label
						>
						<input
							type="text"
							name="organizacion"
							value={usuario?.organizacion ?? ''}
							id="organizacion"
							class={inputClass}
							placeholder="Ejem. Sotomayor Consulting Ecuador"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="role" class={labelClass}>Cargo</label>
						<input
							type="text"
							name="cargo"
							value={usuario?.cargo ?? ''}
							id="role"
							class={inputClass}
							placeholder="Ejem. Gerente General"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="department" class={labelClass}>Departamento</label>
						<input
							type="text"
							name="departamento"
							value={usuario?.departamento ?? ''}
							id="department"
							class={inputClass}
							placeholder="Development"
							-
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="zip-code" class={labelClass}>Codigo Postal</label>
						<input
							type="number"
							name="codigo_postal"
							value={usuario?.codigo_postal ?? ''}
							id="zip-code"
							class={inputClass}
							placeholder="123456"
							-
						/>
					</div>

					<div class="sm:col-full col-span-6">
						<button class={submitBtnClass} type="submit">Guardar</button>
					</div>
				</div>
			</form>
		</div>
		<div id="datos-facturacion" class={cardClass}>
			<h3 class="mb-4 text-xl font-semibold dark:text-white">
				Datos de facturación
			</h3>
			<form method="post" action="/api/update/update-factura">
				<input hidden value={user?.id} name="user_id_factura" />
				<div class="grid grid-cols-6 gap-6">
					<div class="col-span-6 sm:col-span-3">
						<label for="tipo_de_persona" class={labelClass}>Personería</label>
						<select
							name="tipo_de_persona"
							id="tipo_de_persona"
							class={inputTextClass}
							required
						>
							<option
								value=""
								selected={!facturacion?.personería}
								disabled
								hidden>Seleccione el tipo de persona</option
							>
							{
								TipoPersonaOptions?.map((p) => (
									<option
										value={p.value}
										selected={facturacion?.personería === p.value}
									>
										{p.label}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="razon_social" class={labelClass}
							>Nombre o Razón Social</label
						>
						<input
							name="razon_social"
							value={facturacion?.nombre_o_razon_social ?? ''}
							type="text"
							id="razon_social"
							class={inputTextClass}
							placeholder="Ejem. Juan Perez o Comercial Perez S.A."
							required
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="correo_electronico_factura" class={labelClass}
							>Correo electrónico para facturacion</label
						>
						<input
							type="email"
							name="correo_electronico_factura"
							value={facturacion?.correo ?? ''}
							id="correo_electronico_factura"
							class={inputClass}
							placeholder="ejemplo@gmail.com"
							required
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<div class="relative">
							<label for="bill-phone" class={labelClass}>Telefono</label>
							<input
								type="text"
								id="bill-phone"
								name="bill-phone"
								data-billing="true"
								class="dark:bg-black-900 block w-full rounded-lg border-gray-200 bg-white px-4 py-2.5 ps-36 shadow-sm focus:z-10 focus:border-[#ba8d34] focus:ring-[#ba8d34] disabled:pointer-events-none disabled:opacity-50 sm:py-3 sm:ps-36 sm:text-sm md:ps-40 lg:ps-44 dark:border-neutral-700 dark:text-white dark:placeholder-gray-400 dark:focus:ring-neutral-600"
								placeholder="(000) 000-0000"
								value={facturacion?.telefono ?? ''}
								required
							/>
							<div
								class="absolute inset-s-1 top-7 flex w-4/12 items-center overflow-hidden p-1 ps-px text-gray-500 sm:w-2/6 md:w-2/6"
							>
								<label for="bill-phone-country" class="sr-only">País</label>
								<select
									id="bill-phone-country"
									data-billing="true"
									class="dark:bg-black-900 block w-full rounded-lg border-transparent bg-white text-sm focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-600 dark:text-neutral-500"
								>
									<option value="" disabled selected hidden>Pais</option>
									{
										paises?.map((p) => (
											<option
												data-countrycode={p.iso}
												value={`+${p.codigo_telf}`}
											>
												{p.nombre_paises}
											</option>
										))
									}
								</select>
							</div>
						</div>
					</div>
					<div class="col-span-6">
						<label for="direccion_factura" class={labelClass}>Dirección</label>
						<input
							type="text"
							name="direccion_factura"
							value={facturacion?.correo ?? ''}
							id="direccion_factura"
							class={inputClass}
							placeholder="Av. Siempre Viva 123 y Calle Alguna"
							required
						/>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="pais_factura" class={labelClass}>Pais</label>
						<select
							name="pais_factura"
							id="pais_factura"
							class={inputTextClass}
							required
						>
							<option value="" selected={!facturacion?.pais} disabled hidden
								>Seleccione un país</option
							>
							{
								paises?.map((p) => (
									<option
										value={p.nombre_paises}
										selected={facturacion?.pais === p.nombre_paises}
									>
										{p.nombre_paises}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-6 sm:col-span-3">
						<label for="ciudad_factura" class={labelClass}>Cuidad</label>
						<input
							type="text"
							name="ciudad_factura"
							value={facturacion?.ciudad ?? ''}
							id="ciudad_factura"
							class={inputClass}
							placeholder="Av. Siempre Viva 123 y Calle Alguna"
							required
						/>
					</div>
					<div class="col-span-6">
						<div class="w-full space-y-3">
							<div>
								<label for="correo_electronico_factura" class={labelClass}
									>Tipo de documento</label
								>
								<div class="relative w-full">
									<input
										type="text"
										id="documento_de_identidad"
										value={facturacion?.documento_de_identidad ?? ''}
										name="documento_de_identidad"
										class="dark:bg-black-900 block w-full rounded-lg border border-gray-300 bg-white p-2.5 ps-56 text-gray-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]"
										placeholder="171234567"
										required
									/>
									<div
										class="absolute inset-y-0 start-0 flex items-center ps-px text-gray-500"
									>
										<label for="tipo_de_documento" class="sr-only"
											>Tipo de documento</label
										>
										<select
											id="tipo_de_documento"
											name="tipo_de_documento"
											class="dark:bg-black-900 block w-full rounded-lg border-transparent bg-white text-sm focus:border-[#8c681d] focus:ring-[#8c681d] dark:border-gray-600 dark:text-white"
											required
										>
											<option
												value=""
												selected={facturacion?.tipo_de_documento}
												hidden>Tipo de documento</option
											>
											{
												TipoIdentificacionOptions?.map((p) => (
													<option
														value={p.value}
														selected={
															facturacion?.tipo_de_documento === p.value
														}
													>
														{p.label}
													</option>
												))
											}
										</select>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="sm:col-full col-span-6">
						<button class={submitBtnClass} type="submit">Guardar datos</button>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		const countrySelect = document.getElementById('bill-phone-country');
		const phoneInput = document.getElementById('bill-phone');
		// Función para actualizar el código de país
		function updateCountryCode() {
			const selectedCountryCode = countrySelect.value;
			const currentPhoneValue = phoneInput.value;

			// Si el valor actual ya empieza con un código de país, lo eliminamos
			const phoneWithoutCode = currentPhoneValue.replace(/^\+\d+\s?/, '');

			// Añadimos el nuevo código de país
			phoneInput.value = selectedCountryCode + ' ' + phoneWithoutCode;
		}
		// Actualizar cuando cambie la selección
		countrySelect.addEventListener('change', updateCountryCode);
		// Actualizar al cargar la página
		updateCountryCode();
	});
</script>
