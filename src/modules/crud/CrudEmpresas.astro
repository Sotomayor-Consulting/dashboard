---
import '@styles/datatables.css';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { IncorporacionesEmpresasBase } from '@lib/tablas/empresa_incorporaciones';
import { actividadesGeneral } from '@lib/tablas/actividades';
import { EstadosGeneral } from '@lib/tablas/estados';
import { PaisesGeneral } from '@lib/tablas/paises';

const supabase = Astro.locals.supabase;

const [empresas, actividades, estados, paises] = await Promise.all([
	IncorporacionesEmpresasBase(supabase),
	actividadesGeneral(supabase),
	EstadosGeneral(supabase),
	PaisesGeneral(supabase),
]);
---

<script src="@lib/alpinejs/alpine.js"></script>

<div
	class="bg-white-100 dark:bg-black-900 block items-center justify-between border-b border-gray-200 p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<div class="mb-1 w-full">
		<div class="mb-4">
			<nav class="mb-5 flex" aria-label="Breadcrumb">
				<ol
					class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
				>
					<li class="inline-flex items-center">
						<a
							href="/"
							class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
						>
							<svg
								class="mr-2.5 h-5 w-5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
								></path></svg
							>
							Inicio
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="h-6 w-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"></path></svg
							>
							<a
								href="/crud/empresas"
								class="ml-1 text-gray-700 hover:text-[#967432] md:ml-2 dark:text-gray-300 dark:hover:text-white"
								>Empresas</a
							>
						</div>
					</li>
				</ol>
			</nav>
			<h1
				class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
			>
				Lista de empresas
			</h1>
		</div>
	</div>
</div>
<div class="border-b border-gray-200 p-5 sm:flex dark:border-gray-700">
	<div class="mr-4 ml-auto flex items-center space-x-2 sm:space-x-3">
		<button
			type="button"
			data-modal-target="add-user-modal"
			data-modal-toggle="add-user-modal"
			class="focus:ring-primary-300 inline-flex w-1/2 items-center justify-center rounded-lg bg-[#1349ec] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#1349ec] focus:ring-4 sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
		>
			<svg
				class="mr-2 -ml-1 h-5 w-5"
				fill="currentColor"
				viewBox="0 0 20 20"
				xmlns="http://www.w3.org/2000/svg"
				><path
					fill-rule="evenodd"
					d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
					clip-rule="evenodd"></path></svg
			>
			Añadir nueva empresa
		</button>
	</div>
</div>
<div class="flex flex-col">
	<div class="overflow-x-auto">
		<div class="inline-block min-w-full align-middle">
			<div class="overflow-hidden shadow">
				<table
					class="min-w-full divide-y divide-gray-200 dark:divide-gray-600"
					id="myTable"
				>
					<thead class="dark:bg-black-800 bg-gray-100" id="test">
						<tr>
							{
								[
									'id',
									'Usuario que la creo',
									'Tipo de Negocio',
									'Estado de incorporación',
									'Estado',
									'Proceso',
									'Creado en',
								].map((th) => (
									<th
										scope="col"
										class="p-4 text-left text-xs font-medium text-gray-500 uppercase dark:text-gray-400"
									>
										<span class="flex items-center uppercase">
											{th}
											<svg
												class="ms-1 h-4 w-4"
												aria-hidden="true"
												xmlns="http://www.w3.org/2000/svg"
												width="24"
												height="24"
												fill="none"
												viewBox="0 0 24 24"
											>
												<path
													stroke="currentColor"
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="m8 15 4 4 4-4m0-6-4-4-4 4"
												/>
											</svg>
										</span>
									</th>
								))
							}
						</tr>
					</thead>
					<tbody
						class="dark:bg-black-800 divide-y divide-gray-200 bg-white dark:divide-gray-700"
					>
						{
							empresas?.map((empresa) => (
								<div>
									<tr
										class="odd:bg-white-100 cursor-pointer even:bg-[#d4d4d4] hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]"
										onclick={`window.open('/crud/empresa/${empresa.empresa_incorporacion_id}', '_blank')`}
									>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{empresa.nombre_1}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{empresa.usuarios[0]?.nombre}
											{empresa.usuarios[0]?.apellido}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{empresa.tipo_de_negocio}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{empresa.porcentaje_de_incorporacion}%
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											{empresa.estado_de_incorporacion}
										</td>
										<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
											<div class="flex items-center">
												{empresa.estado === 'Activo' ? (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-green-400" />
												) : (
													<div class="mr-2 h-2.5 w-2.5 rounded-full bg-red-500" />
												)}
												{empresa.estado}
											</div>
										</td>
										<td class="p-4 text-base font-normal whitespace-nowrap text-gray-900 dark:text-white">
											{empresa.updated_at &&
												new Date(empresa.updated_at)
													.toLocaleDateString('es-ES', {
														day: '2-digit',
														month: '2-digit',
														year: 'numeric',
													})
													.replace(/\//g, '-')}
										</td>
									</tr>
								</div>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<!-- Añadir empresa -->
<div
	class="fixed right-0 left-0 z-50 hidden h-screen items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0"
	id="add-user-modal"
>
	<div class="relative h-5/6 w-full px-4">
		<!-- Modal content -->
		<div class="dark:bg-black-900 relative rounded-lg bg-white shadow">
			<!-- Modal header -->
			<div
				class="flex items-start justify-between rounded-t border-b p-5 dark:border-gray-700"
			>
				<h3 class="text-xl font-semibold dark:text-white">Añadir empresa</h3>
				<button
					type="button"
					class="ml-auto inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-[#101522] dark:hover:text-white"
					data-modal-toggle="add-user-modal"
				>
					<svg
						class="h-5 w-5"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
						><path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path></svg
					>
				</button>
			</div>
			<!-- Modal body -->
			<form action="" method="post">
				<div
					class="grid w-full space-x-0 rounded-lg p-0 md:grid-cols-[auto_1fr] md:space-x-4 md:p-4"
					id="contacts"
					role="tabpanel"
					aria-labelledby="contacts-tab"
					x-data="{ 
				formadeAdministracion: '',  
				actvidadManual: null, 
				RegistroManual: '',
				direccionOperativa: '',
				otrosMiembrosfuera: null,
				managerMiembro: '',
				asignarManager: '',
				tabManager: '',
				
			}"
					x-effect="if (!actvidadManual) {
				RegistroManual = '';
			}; if (asignarManager === 'Si') {
				 managerMiembro = '';
			}"
				>
					<div class="mb-4 md:max-w-72 md:min-w-72 dark:border-gray-700">
						<ul
							class="flex-column dark:bg-black-800 space-y-5 rounded-lg p-5 text-sm font-medium text-gray-500 dark:text-gray-400"
							id="default-tab-2"
							data-tabs-toggle="#default-tab-content-2"
							role="tablist"
							data-tabs-active-classes="text-white bg-blue-700 dark:bg-blue-600"
							data-tabs-inactive-classes="hover:text-gray-900 bg-gray-50 hover:bg-gray-100 dark:bg-black-900 dark:hover:bg-[#101521]/80 dark:hover:text-white"
						>
							<li>
								<div>
									<h5 class="text-lg">navegación de edición</h5>
								</div>
							</li>
							{
								[
									{
										id: 'generales-tab',
										tabs: 'generales',
										label: 'Generales',
										icono: 'ri:building-2-fill',
										condicion: 'activo',
									},
									{
										id: 'ubicacion-tab',
										tabs: 'ubicacion',
										label: 'Ubicacion',
										icono: 'ri:folder-user-fill',
										condicion: 'activo',
									},
									{
										id: 'socios-edit-tab',
										tabs: 'socios-edit',
										label: 'Socios',
										icono: 'ri:file-copy-2-fill',
										condicion: 'activo',
									},
									{
										id: 'manager-tab',
										tabs: 'manager',
										label: 'Manager',
										icono: 'ri:edit-fill',
										condicion: 'condicional',
									},
								].map((i) =>
									i.condicion === 'activo' ? (
										<li role="presentation">
											<button
												id={i.id}
												data-tabs-target={`#${i.tabs}`}
												type="button"
												role="tab"
												aria-controls={i.tabs}
												aria-selected="false"
												class="flex w-full items-center gap-2 rounded-lg p-4"
											>
												<Icon name={i.icono} class="text-lg" />
												{i.label}
											</button>
										</li>
									) : (
										<li role="presentation">
											<button
												id={i.id}
												data-tabs-target={`#${i.tabs}`}
												type="button"
												role="tab"
												x-model="tabManager"
												x-show="formadeAdministracion === 'Member-Managed'"
												aria-controls={i.tabs}
												aria-selected="false"
												class="flex w-full items-center gap-2 rounded-lg p-4"
											>
												<Icon name={i.icono} class="text-lg" />
												{i.label}
											</button>
										</li>
									),
								)
							}
						</ul>
					</div>
					<div id="default-tab-content-2" class="ml-0 min-w-full">
						<div
							class="dark:bg-black-800 hidden rounded-lg bg-gray-50 p-4"
							id="generales"
							role="tabpanel"
							aria-labelledby="generales-tab"
						>
							<div class="dark:bg-black-900 w-full rounded-lg bg-white shadow">
								<div
									class="dark:bg-black-800 mb-4 min-w-full rounded-lg border border-neutral-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-neutral-700"
								>
									<h3 class="mb-4 text-xl font-semibold dark:text-white">
										Datos Generales
									</h3>

									<div class="grid grid-cols-6 gap-6">
										<div class="col-span-6 sm:col-span-3">
											<label
												for="Ingresos_de_EEUU"
												class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
												>¿La LLC obtendrá ingresos provenientes de Estados
												Unidos?</label
											>
											<select
												name="Ingresos_de_EEUU"
												id="Ingresos_de_EEUU"
												class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
											>
												<!-- Opción por defecto (placeholder) -->
												<option value="" disabled hidden selected>
													Seleccione una opción
												</option>

												<!-- Opción "Sí" -->
												<option value="true"> Sí </option>

												<!-- Opción "No" -->
												<option value="false"> No </option>
											</select>
										</div>

										<div class="col-span-6 flex items-end sm:col-span-3">
											<button
												type="button"
												data-modal-target="crud-modal"
												data-modal-toggle="crud-modal"
												class="flex items-center gap-2 rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
											>
												<Icon name="ri:add-line" /> Añadir actividad</button
											>
										</div>
										<div class="col-span-6 sm:col-span-3">
											<label
												for="actividad-input"
												class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
											>
												Actividad
											</label>

											<input
												list="actividades-list"
												id="actividad-input"
												name="actividad"
												placeholder="Escribe para buscar actividad..."
												class="block w-full truncate rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
											/>

											<datalist id="actividades-list">
												{
													actividades?.map((ac) => (
														<option value={ac.actividad}>{ac.Actividad}</option>
													))
												}
											</datalist>
										</div>

										<div class="col-span-6 sm:col-span-3">
											<label
												for="forma_de_administrar"
												class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
												>Forma de administrar</label
											>
											<select
												name="forma_de_administrar"
												id="forma_de_administrar"
												x-model="formadeAdministracion"
												class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
											>
												<option value="" selected hidden disabled
													>Seleccione una forma de tibutar</option
												>

												<!-- Opción "Sí" -->
												<option value="Member-Managed"> Member-Managed </option>

												<!-- Opción "No" -->
												<option value="Manager-Managed">
													Manager-Managed
												</option>
											</select>
										</div>
										<div class="col-span-6 sm:col-span-3">
											<label
												for="forma_de_tributar"
												class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
												>Forma de tributar</label
											>
											<select
												name="forma_de_tributar"
												id="forma_de_tributar"
												class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
											>
												<option value="" hidden disabled selected
													>Seleccione una forma de tributar</option
												>

												<!-- Opción "Sí" -->
												<option value="Entidad de paso">
													Entidad de paso
												</option>

												<!-- Opción "No" -->
												<option value="Corporación"> Corporación </option>
											</select>
										</div>

										<div class="col-span-6 sm:col-span-3">
											<label
												for="informacion_miembros"
												class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
											>
												Información de los miembros
											</label>
											<select
												name="informacion_miembros"
												id="informacion_miembros"
												class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
											>
												<option value="" disabled hidden selected>
													Seleccione una opcion
												</option>

												<option value="Pública"> Pública </option>

												<option value="Privada"> Privada </option>
											</select>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div
							class="dark:bg-black-800 hidden min-w-full rounded-lg bg-gray-50 p-4"
							id="ubicacion"
							role="tabpanel"
							aria-labelledby="ubicacion-tab"
						>
							<div
								class="dark:bg-black-900 relative min-w-full rounded-lg bg-white shadow"
							>
								<div
									class="dark:bg-black-800 mb-4 min-w-full rounded-lg border border-neutral-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-neutral-700"
								>
									<h3 class="mb-4 text-xl font-semibold dark:text-white">
										Ubicación
									</h3>

									<div class="grid grid-cols-6 gap-6">
										<div class="col-span-6 sm:col-span-3">
											<label
												for="direccionOperativa"
												class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
												>¿Tiene dirección operativa en EE.UU.?</label
											>
											<select
												name="direccionOperativa"
												id="direccionOperativa"
												x-model="direccionOperativa"
												class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
											>
												<option value="" selected hidden disabled
													>Selecciona una opción</option
												>
												<!-- Opción "Sí" -->
												<option value="Si"> Sí </option>

												<!-- Opción "No" -->
												<option value="No"> No </option>

												<option
													value="Quiero que Sotomayor Consulting International provea una dirección"
												>
													Quiero que Sotomayor Consulting International provea
													una dirección
												</option>
											</select>
										</div>

										<!-- condicionales de Tiene dirección operativa en EE.UU. -->
										<!-- inicio direccionOperativa === 'Si' -->

										<template x-if="direccionOperativa === 'Si'">
											<div class="col-span-6 sm:col-span-3">
												<label
													for="direccion"
													class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
													>Dirección</label
												>
												<input
													type="text"
													name="direccion"
													id="direccion"
													class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#1349ec] focus:ring-[#1349ec] sm:text-sm dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
													placeholder="ejem. Av. Juan Molineros"
												/>
											</div>
										</template>
										<template x-if="direccionOperativa === 'Si'">
											<div class="col-span-6 sm:col-span-3">
												<label
													for="condado"
													class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
