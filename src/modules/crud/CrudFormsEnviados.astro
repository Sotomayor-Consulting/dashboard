---
import Alerta from '@components/feedback/alertageneral.astro';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import DataTable from '@components/ui/DataTable.astro';
import DateCell from '@components/ui/DateCell.astro';
import Drawer from '@components/ui/Drawer.astro';
import DrawerConfirm from '@components/ui/DrawerConfirm.astro';
import DrawerFormActions from '@components/ui/DrawerFormActions.astro';
import StackedText from '@components/ui/StackedText.astro';
import StatusBadge from '@components/ui/StatusBadge.astro';
import { Icon } from 'astro-icon/components';
import { FormsEnviadosDataGeneral } from '@lib/tablas/forms/formulariosEnviados';

const supabase = Astro.locals.supabase;
const formularios_envios = await FormsEnviadosDataGeneral(supabase);

const inputClass =
	'dark:bg-black-800 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400';
const textareaClass =
	'focus:ring-primary-500 focus:border-primary-500 dark:bg-black-800 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-600 dark:text-white dark:placeholder-gray-400';
const labelClass =
	'mb-2 block text-sm font-medium text-gray-900 dark:text-white';
const selectClass =
	'focus:ring-primary-500 focus:border-primary-500 dark:bg-black-800 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-600 dark:text-white dark:placeholder-gray-400';
const tdClass =
	'max-w-sm truncate p-4 text-base font-normal whitespace-nowrap text-gray-900 dark:text-white';
const actionBtnClass =
	'focus:ring-primary-300 inline-flex w-1/2 items-center justify-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]';

const tableHeaders = [
	'id de formulario',
	'Subido por',
	'Porcentaje de progreso',
	'Fecha de inicio del formulario',
	'Fecha de ultima actualizacion',
	'Fecha de ultima subida',
	'estado',
	'Acciones',
];
---

<Alerta />
<div>
	<div
		class="block w-full items-center justify-between border-b border-gray-200 p-4 sm:flex lg:mt-1.5"
	>
		<CrudPageHeader
			title="Todos los formularios de incorporacion enviados"
			breadcrumbItems={[
				{
					label: 'Formularios',
					href: '/crud/formularios-enviados',
				},
			]}
			refreshHref="/crud/formularios-enviados"
		>
			<a
				slot="actions"
				href="/crud/formularios"
				target="_blank"
				class={actionBtnClass}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="mr-2 -ml-1 h-5 w-5"
					viewBox="0 0 24 24"
					><path
						fill="currentColor"
						d="M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6v2H5v12h12v-6zM13 3v2h4.586l-7.793 7.793l1.414 1.414L19 6.414V11h2V3z"
					></path></svg
				>
				Gestionar formularios
			</a>
		</CrudPageHeader>
	</div>

	<div class="flex flex-col">
		<div class="overflow-x-auto">
			<div class="inline-block min-w-full align-middle">
				<div class="overflow-hidden shadow">
					<DataTable
						headers={tableHeaders}
						noRowsMessage="No hay formularios para mostrar"
					>
						{
							formularios_envios?.map((sr) => (
								<tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]">
									<td class="p-4 text-sm font-normal whitespace-nowrap text-gray-500 dark:text-gray-400">
										<StackedText
											title={sr.formularios?.titulo ?? '— sin titulo —'}
											subtitle={sr.formularios?.slug ?? '— sin categoria —'}
										/>
									</td>
									<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
										<data>
											{sr.usuarios.nombre} {sr.usuarios.apellido}
										</data>
									</td>
									<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
										<data value="">{sr.progress_percent ?? '0'}% </data>
									</td>
									<td class={tdClass}>
										<DateCell date={sr.created_at} />
									</td>
									<td class={tdClass}>
										<DateCell date={sr.updated_at} />
									</td>
									<td class={tdClass}>
										<DateCell date={sr.submitted_at} />
									</td>
									<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
										<StatusBadge
											active={sr.status === 'submitted'}
											activeLabel="Terminado"
											inactiveLabel="En progreso"
											inactiveColor="bg-orange-400"
										/>
									</td>
									<td class="space-x-2 p-4 text-center whitespace-nowrap">
										<div class="flex h-full items-center justify-center gap-2">
											<a
												href={`/forms/enviados/${sr.submission_id}`}
												target="_blank"
												title="ver formulario"
												data-tooltip-target={`tool-tip-${sr.submission_id}`}
											>
												<Icon
													name="ri:eye-fill"
													class="text-2xl text-neutral-600 hover:scale-105 dark:text-neutral-400 dark:hover:text-neutral-300"
												/>
											</a>
											<div
												id={`tool-tip-${sr.submission_id}`}
												role="tooltip"
												class="tooltip dark:bg-black-800 invisible absolute z-10 inline-block rounded-lg bg-gray-900 px-3 py-2 text-sm font-medium text-white opacity-0 shadow-xs transition-opacity duration-300"
											>
												Ver respuestas del formulario
												<div class="tooltip-arrow" data-popper-arrow />
											</div>
										</div>
									</td>
								</tr>
							))
						}
					</DataTable>
				</div>
			</div>
		</div>
	</div>

	<!-- Edit Product Drawer -->
	<Drawer id="drawer-update-product-default" title="Actualizar Formulario">
		<form action="/api/update/admin-update-forms" method="post">
			<div class="space-y-4">
				<input type="hidden" name="service_id" id="modal_form_id" value="" />
				<div>
					<label for="nombre_update-service" class={labelClass}
						>Titulo del formulario</label
					>
					<input
						type="text"
						name="titulo-form"
						id="titulo-update-form"
						class={inputClass}
						value=""
						placeholder="inserta el titulo del formulario"
						required=""
					/>
				</div>
				<div>
					<label for="categoria_service" class={labelClass}>Categoria</label>
					<input
						type="text"
						name="categoria-form"
						id="categoria-form-update"
						class={inputClass}
						value=""
						placeholder="Anade la categoria del formulario"
						required=""
					/>
				</div>
				<div>
					<label for="precio-servicio" class={labelClass}
						>Pega el JSON del formulario</label
					>
					<textarea
						name="json-update"
						id="json-form"
						class={inputClass}
						placeholder="Anade el Json del formulario"
						required=""></textarea>
				</div>
				<div>
					<label for="descripcion-servicio" class={labelClass}
						>Tema del form (opcional)</label
					>
					<textarea
						id="tema-form"
						name="tema-form-update"
						rows="4"
						class={textareaClass}
						placeholder="Anade el codigo json del tema de tu formulario"
					></textarea>
				</div>
				<div>
					<label for="descripcion-servicio" class={labelClass}
						>Descripcion</label
					>
					<textarea
						id="descripcion-form"
						name="descripcion-form-update"
						rows="4"
						class={textareaClass}
						placeholder="Anade una descripcion para el form"></textarea>
				</div>
				<div>
					<label for="updaterol_estado" class={labelClass}>Estado</label>
					<select id="update-form-estado" name="estado" class={selectClass}>
						<option value="" disabled="" selected="">--</option>
						<option value="true">Activo</option>
						<option value="false">Inactivo</option>
					</select>
				</div>
			</div>
			<DrawerFormActions
				drawerId="drawer-update-product-default"
				submitLabel="Actualizar"
			/>
		</form>
	</Drawer>

	<!-- Archive Drawer -->
	<DrawerConfirm
		id="drawer-delete-product-default"
		title="Archivar Formulario"
		message="¿Estas seguro de querer archivar este servicio?"
		action="/api/update/admin-services-delete"
		formId="archivar_form"
		variant="danger"
	>
		<input type="hidden" name="servicio_id" id="servicio_id" />
		<input type="hidden" name="servicio_activo" value="false" />
	</DrawerConfirm>

	<!-- Unarchive Drawer -->
	<DrawerConfirm
		id="desarchivar-menu"
		title="Desarchivar servicio"
		message="¿Estas seguro de querer archivar este servicio?"
		action="/api/update/admin-services-add"
		formId="desarchivar_form"
		variant="success"
	>
		<input type="hidden" name="des_servicio_id" id="des_servicio_id" />
		<input type="hidden" name="des_servicio_activo" value="true" />
	</DrawerConfirm>

	<!-- Add Product Drawer -->
	<Drawer
		id="drawer-create-product-default"
		title="Nuevo Formulario"
		maxWidth="max-w-xs"
	>
		<form action="/api/create/admin-new-form" method="POST">
			<div class="space-y-4">
				<div>
					<label for="titulo-form" class={labelClass}
						>Titulo del formulario</label
					>
					<input
						type="text"
						name="titulo-form"
						id="nombre-service"
						class={inputClass}
						placeholder="Nombre del formulario"
						required=""
					/>
				</div>
				<div>
					<label for="categoria-form" class={labelClass}>Categoria</label>
					<input
						type="text"
						name="categoria-form"
						id="categoria-form"
						class={inputClass}
						placeholder="Anade la categoria del form"
						required=""
					/>
				</div>
				<div>
					<label for="json-update" class={labelClass}>Json del formulario</label
					>
					<textarea
						id="json-update"
						name="json-update"
						rows="4"
						class={textareaClass}
						placeholder="Pega aqui el Json del formulario"></textarea>
				</div>
				<div>
					<label for="tema-form-update" class={labelClass}
						>Tema del formulario (opcional)</label
					>
					<textarea
						id="tema-form-update"
						name="tema-form-update"
						rows="4"
						class={textareaClass}
						placeholder="Pega el Json del tema"></textarea>
				</div>
				<div>
					<label for="descripcion-form-update" class={labelClass}
						>descripcion</label
					>
					<textarea
						id="descripcion-form-update"
						name="descripcion-form-update"
						rows="4"
						class={textareaClass}
						placeholder="Anade una descripcion del formulario"></textarea>
				</div>
				<div>
					<label for="estado" class={labelClass}>Estado</label>
					<select id="estado" name="estado" class={selectClass}>
						<option value="" disabled="" selected="">--</option>
						<option value="true">Activo</option>
						<option value="false">Inactivo</option>
					</select>
				</div>
				<DrawerFormActions
					drawerId="drawer-create-product-default"
					submitLabel="Anadir formulario"
				/>
			</div>
		</form>
	</Drawer>

	<script is:inline>
		const bindArchivarFormButtons = () => {
			const form = document.getElementById('archivar_form');
			const uidInput = document.getElementById('servicio_id');

			if (!form || !uidInput) return;

			const btns = document.querySelectorAll('[data-open-estado]');

			btns.forEach((btn) => {
				if (btn.dataset.archivarBind === '1') return;
				btn.dataset.archivarBind = '1';

				btn.addEventListener('click', () => {
					const uid = btn.dataset.formId || '';
					uidInput.value = uid;
				});
			});

			if (form.dataset.submitBind === '1') return;
			form.dataset.submitBind = '1';

			form.addEventListener('submit', () => {
				const submitBtn = form.querySelector('button[type="submit"]');
				if (submitBtn) submitBtn.disabled = true;
			});
		};

		document.addEventListener('DOMContentLoaded', bindArchivarFormButtons);
		document.addEventListener('astro:page-load', bindArchivarFormButtons);
	</script>
	<script is:inline>
		const bindDesarchivarFormButtons = () => {
			const form = document.getElementById('desarchivar_form');
			const uidInput = document.getElementById('des_servicio_id');

			if (!form || !uidInput) return;

			const btns = document.querySelectorAll('[data-open-desarchivado]');

			btns.forEach((btn) => {
				if (btn.dataset.desarchivarBind === '1') return;
				btn.dataset.desarchivarBind = '1';

				btn.addEventListener('click', () => {
					const uid = btn.dataset.formId || '';
					uidInput.value = uid;
				});
			});

			if (form.dataset.submitBind === '1') return;
			form.dataset.submitBind = '1';

			form.addEventListener('submit', () => {
				const submitBtn = form.querySelector('button[type="submit"]');
				if (submitBtn) submitBtn.disabled = true;
			});
		};

		document.addEventListener('DOMContentLoaded', bindDesarchivarFormButtons);
		document.addEventListener('astro:page-load', bindDesarchivarFormButtons);
	</script>
</div>
