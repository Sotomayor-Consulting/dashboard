<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// Tipar los botones como HTMLElement (con dataset)
		const btns = document.querySelectorAll('[data-edit-user]');

		// Helper para setear .value de inputs/textarea de forma segura
		function setValue(id, val) {
			const el = document.getElementById(id);
			if (el) el.value = val ?? '';
		}

		// Helper específico para selects
		function setSelectValue(id, val) {
			const select = document.getElementById(id);
			if (select && val) {
				select.value = val;
			}
		}

		btns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const nombre = btn.dataset.nombre ?? '';
				const apellido = btn.dataset.apellido ?? '';
				const correo = btn.dataset.correo ?? '';
				const rolId = btn.dataset.rolId ?? '';
				const compania = btn.dataset.compania ?? '';
				const userId = btn.dataset.userId ?? '';
				const estado = btn.dataset.userestado ?? '';
				const pais = btn.dataset.pais ?? '';
				const ciudad = btn.dataset.ciudad ?? '';
				const linea1 = btn.dataset.linea1 ?? '';
				const linea2 = btn.dataset.linea2 ?? '';
				const telefono = btn.dataset.telefono ?? '';
				const nacimiento = btn.dataset.nacimiento ?? '';
				const tipoidentificacion = btn.dataset.tipoidentificacion ?? '';
				const identificacion = btn.dataset.numeroidentidad ?? '';
				const tipo = btn.dataset.tipo ?? '';

				// Inputs/Textareas
				setValue('modal_user_id', userId);
				setValue('modal_nombre', nombre);
				setValue('modal_apellido', apellido);
				setValue('modal_correo', correo);
				setValue('modal_compania', compania);
				setValue('ciudad', ciudad);
				setValue('direccion_linea1', linea1);
				setValue('direccion_linea2', linea2);
				setValue('modal_telefono', telefono);
				setValue('fecha_nacimiento', nacimiento);
				setValue('numero_de_identificacion', identificacion);

				// Selects (pais, tipoidentificacion, tipo)
				setSelectValue('pais', pais);
				setSelectValue('tipo_identificacion', tipoidentificacion);
				setSelectValue('tipo_persona', tipo);

				// Radios
				document.querySelectorAll('input[name="rol_id"]').forEach((r) => {
					r.checked = String(r.value) === String(rolId);
				});

				document.querySelectorAll('input[name="estado"]').forEach((r) => {
					r.checked = String(r.value) === String(estado);
				});
			});
		});
	});
</script>
