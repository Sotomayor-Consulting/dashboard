---
import { Picture } from 'astro:assets';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import DataTable from '@components/ui/DataTable.astro';
import Modal from '@components/ui/Modal.astro';
import StatusBadge from '@components/ui/StatusBadge.astro';
import { getAllUsuarios } from '@lib/tablas/usuarios';
import { RolesGeneral, RolesGeneralUsers } from '@lib/tablas/roles';
import { PaisesGeneral } from '@lib/tablas/countries';

const supabase = Astro.locals.supabase;
const [usuarios, roles, paises, rolesGeneral] = await Promise.all([
	getAllUsuarios(supabase),
	RolesGeneral(supabase),
	PaisesGeneral(supabase),
	RolesGeneralUsers(supabase),
]);

const inputClass =
	'dark:bg-black-900 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-gray-900 shadow-sm focus:border-[#8c681d] focus:ring-[#8c681d] sm:text-sm dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#8c681d] dark:focus:ring-[#323f67]';
const labelClass =
	'mb-2 block text-sm font-medium text-gray-900 dark:text-white';
const submitBtnClass =
	'focus:ring-primary-300 rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:focus:ring-[#323f67]';

const roleBadgeClasses: Record<string, string> = {
	admin: 'bg-danger-soft text-fg-danger-strong',
	cliente: 'bg-success-soft text-fg-success-strong',
	partner: 'bg-warning-soft text-fg-warning',
	operaciones: 'bg-warning-soft text-fg-warning',
};
---

<script src="@lib/alpinejs/alpine.js"></script>
<div
	class="dark:bg-black-900 block items-center justify-between border-b border-gray-200 bg-gray-50 p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<div class="mb-1 w-full">
		<CrudPageHeader
			title="Todos los usuarios"
			breadcrumbItems={[{ label: 'Usuarios' }]}
		>
			<button
				slot="actions"
				type="button"
				data-modal-target="add-user-modal"
				data-modal-toggle="add-user-modal"
				class="focus:ring-primary-300 inline-flex w-1/2 items-center justify-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#8c681d]/90 focus:ring-4 sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
			>
				<svg
					class="mr-2 -ml-1 h-5 w-5"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						fill-rule="evenodd"
						d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
						clip-rule="evenodd"></path>
				</svg>
				Invitar usuario
			</button>
			<button
				slot="actions"
				id="dropdownMenuIconButton"
				data-dropdown-toggle="dropdownDots2"
				class="dark:bg-black-800 dark:hover:bg-black-700 inline-flex items-center rounded-lg bg-white p-2 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-50 focus:outline-none dark:text-white dark:focus:ring-gray-600"
				type="button"
			>
				<svg
					class="h-5 w-5"
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					fill="currentColor"
					viewBox="0 0 4 15"
				>
					<path
						d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"
					></path>
				</svg>
			</button>
		</CrudPageHeader>
		<!-- Dropdown menu -->
		<div
			id="dropdownDots2"
			class="dark:bg-black-800 z-10 hidden w-44 divide-y divide-gray-100 rounded-lg bg-white shadow-sm dark:divide-gray-600"
		>
			<ul
				class="py-2 text-start text-sm text-gray-700 dark:text-gray-200"
				aria-labelledby="dropdownMenuIconButton"
			>
				<li>
					<button
						type="button"
						data-modal-target="rol-modal-admin"
						data-modal-toggle="rol-modal-admin"
						class="block w-full px-4 py-2 text-start hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
						>Añadir rol</button
					>
				</li>
			</ul>
		</div>
	</div>
</div>

<DataTable
	headers={[
		'Foto',
		'Nombre',
		'Compañía',
		'Cargo',
		'País',
		'Estado',
		'Rol',
		'Acciones',
	]}
	noRowsMessage="No hay usuarios"
>
	{
		usuarios?.map((user) => (
			<tr class="dark:hover:bg-black-700 odd:bg-gray-50 even:bg-gray-50 hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467]">
				<td class="w-4 pl-4">
					{user.avatar_url === 'NULL' || !user.avatar_url ? (
						<Picture
							class="h-10 w-10 rounded-full"
							src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${user.nombre}`}
							alt={`Avatar de ${user.nombre}`}
							inferSize={true}
							loading="eager"
						/>
					) : (
						<Picture
							class="h-10 w-10 rounded-full"
							src={user.avatar_url}
							alt={`Avatar de ${user.nombre}`}
							inferSize={true}
							loading="eager"
						/>
					)}
				</td>
				<td class="mr-12 flex items-center space-x-6 p-4 whitespace-nowrap">
					<div class="text-sm font-normal text-gray-500 dark:text-gray-400">
						<div class="text-base font-semibold text-gray-900 dark:text-white">
							{user.nombre} {user.apellido}
						</div>
						<div class="text-sm font-normal text-gray-500 dark:text-gray-400">
							{user.correo}
						</div>
					</div>
				</td>
				<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
					{user.organizacion}
				</td>
				<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
					{user.cargo}
				</td>
				<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
					{user.paises?.nombre_paises ?? '—'}
				</td>
				<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
					<StatusBadge active={user.estado === 'activo'} label={user.estado} />
				</td>
				<td class="p-4 text-base font-normal whitespace-nowrap text-gray-900 dark:text-white">
					<div class="flex items-center gap-1">
						{rolesGeneral?.map(
							(rol) =>
								user.user_id === rol.user_id && (
									<span
										class={`rounded px-1.5 py-0.5 text-xs font-medium ${roleBadgeClasses[rol.roles.name] || 'bg-success-soft text-fg-success-strong'}`}
									>
										{rol.roles.name}
									</span>
								),
						)}
					</div>
				</td>
				<td
					class="relative space-x-2 p-4 whitespace-nowrap"
					x-data="{ showTooltip: false }"
				>
					<button
						type="button"
						data-modal-target="edit-user-modal"
						data-modal-toggle="edit-user-modal"
						data-edit-user
						data-user-id={user.user_id}
						data-compania={user.organizacion || ''}
						data-cargo={user.cargo || ''}
						data-nombre={user.nombre || ''}
						data-apellido={user.apellido || ''}
						data-correo={user.correo || ''}
						data-rol-id={user.rol_id ?? ''}
						data-userestado={user.estado ?? ''}
						data-pais={user.pais_id ?? ''}
						data-ciudad={user.ciudad || ''}
						data-linea1={user.direccion_linea1 || ''}
						data-linea2={user.direccion_linea2 || ''}
						data-telefono={user.telf || ''}
						data-nacimiento={user.fecha_nacimiento || ''}
						data-tipoidentificacion={user.tipo_identificacion || ''}
						data-numeroidentidad={user.numero_de_identificacion || ''}
						data-tipo={user.tipo_persona ?? ''}
						data-user-roles={JSON.stringify(
							rolesGeneral
								?.filter((r) => r.user_id === user.user_id)
								.map((r) => r.rol_id) || [],
						)}
						class="focus:ring-primary-300 inline-flex items-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#8c681d]/90 focus:ring-4 dark:bg-[#134aed] dark:focus:ring-[#323f67]"
					>
						<svg
							class="mr-2 h-4 w-4"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z" />
							<path
								fill-rule="evenodd"
								d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"
								clip-rule="evenodd"
							/>
						</svg>
						Editar usuario
					</button>
					<button
						id={`dd-btn-${user.user_id}`}
						@click="showTooltip = !showTooltip"
						@click.outside="showTooltip = false"
						class="dark:hover:bg-black-700 inline-flex items-center rounded-lg bg-white p-2 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-50 focus:outline-none dark:bg-[#134aed] dark:text-white dark:focus:ring-gray-600"
						type="button"
						aria-haspopup="true"
						aria-expanded="false"
					>
						<svg
							class="h-5 w-5"
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							fill="currentColor"
							viewBox="0 0 4 15"
						>
							<path d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
						</svg>
					</button>
					<div
						id={`dd-${user.user_id}`}
						x-cloak
						x-show="showTooltip"
						x-transition
						class="dark:bg-black-800 absolute z-20 mt-1 w-44 divide-y divide-gray-100 rounded-lg border border-neutral-300 bg-white shadow-sm dark:divide-gray-600 dark:border-neutral-500"
						role="menu"
						aria-labelledby={`dd-btn-${user.user_id}`}
					>
						<ul
							class="py-2 text-sm text-gray-700 dark:text-gray-200"
							role="none"
						>
							<li>
								<button
									type="button"
									data-open-estado
									data-user-id={user.user_id}
									data-user-estado={user.estado || ''}
									data-user-name={`${user.nombre} ${user.apellido}`.trim()}
									data-modal-target="updaterol"
									data-modal-toggle="updaterol"
									class="block w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
									role="menuitem"
								>
									Archivar
								</button>
							</li>
						</ul>
					</div>
				</td>
			</tr>
		))
	}
</DataTable>

<!-- Edit User Modal -->
<Modal id="edit-user-modal" title="Editar usuario" maxWidth="max-w-4xl">
	<form action="/api/update/admin-update" method="post">
		<div class="space-y-6 p-6">
			<div class="grid grid-cols-6 gap-6">
				<input type="hidden" name="user_id" id="modal_user_id" />
				<div class="col-span-6 sm:col-span-3">
					<label for="first-name" class={labelClass}>Nombre</label>
					<input
						type="text"
						name="nombre"
						id="modal_nombre"
						class={inputClass}
						placeholder="Bonnie"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="last-name" class={labelClass}>Apellido</label>
					<input
						type="text"
						name="apellido"
						id="modal_apellido"
						class={inputClass}
						placeholder="Green"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="correo" class={labelClass}>Correo</label>
					<input
						type="email"
						name="correo"
						id="modal_correo"
						class={inputClass}
						placeholder="example@company.com"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="position" class={labelClass}>Compañía</label>
					<input
						type="text"
						name="compania"
						id="modal_compania"
						class={inputClass}
						placeholder="Sotomayor Consulting"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="pais" class={labelClass}>País</label>
					<select id="pais" name="pais_modal" class={inputClass}>
						<option selected hidden disabled>Selecciona un pais</option>
						{
							paises?.map((p) => (
								<option value={p.id}>{p.nombre_paises}</option>
							))
						}
					</select>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="ciudad" class={labelClass}>Ciudad</label>
					<input
						type="text"
						id="ciudad"
						name="ciudad_modal"
						class={inputClass}
						placeholder="Quito"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="direccion_linea1" class={labelClass}
						>Dirección linea 1</label
					>
					<input
						type="text"
						name="direccion_linea1"
						id="direccion_linea1"
						class={inputClass}
						placeholder="Av Juan molineros"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="direccion_linea2" class={labelClass}
						>Dirección linea 2</label
					>
					<input
						type="text"
						name="direccion_linea2"
						id="direccion_linea2"
						class={inputClass}
						placeholder="Y de los Guayacanes"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="modal_telefono" class={labelClass}>Teléfono</label>
					<input
						type="tel"
						id="modal_telefono"
						name="modal_telefono"
						class={inputClass}
						placeholder="0912345678"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="fecha_nacimiento" class={labelClass}
						>Fecha nacimiento</label
					>
					<input
						type="date"
						name="fecha_nacimiento"
						id="fecha_nacimiento"
						class={inputClass}
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="tipo_identificacion" class={labelClass}
						>Tipo de identificación</label
					>
					<select
						id="tipo_identificacion"
						name="tipo_identificacion"
						class={inputClass}
					>
						<option value="" hidden disabled selected>Tipo de documento</option>
						<option value="Cédula">Cédula</option>
						<option value="RUC">RUC</option>
						<option value="ID">ID</option>
						<option value="Pasaporte">Pasaporte</option>
						<option value="EIN">EIN</option>
					</select>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="numero_de_identificacion" class={labelClass}
						>Numero de identificación</label
					>
					<input
						type="text"
						name="numero_de_identificacion"
						id="numero_de_identificacion"
						class={inputClass}
						placeholder="1712345678"
					/>
				</div>
				<div class="col-span-6 sm:col-span-3">
					<label for="tipo_persona" class={labelClass}>Tipo de persona</label>
					<select id="tipo_persona" name="tipo_persona" class={inputClass}>
						<option value="" hidden>Tipo de persona</option>
						<option value="Natural">Natural</option>
						<option value="Jurídica">Jurídica</option>
					</select>
				</div>
				<div class="col-span-6">
					<h3 class="mb-4 font-semibold text-gray-900 dark:text-white">
						Añade un rol
					</h3>
					<ul
						class="dark:bg-black-900 w-full items-center gap-2 rounded-lg bg-white text-sm font-medium text-gray-900 sm:flex dark:border-gray-600 dark:text-white"
					>
						{
							roles?.map((rol, index) => (
								<li class="w-full">
									<div class="bg-neutral-primary-soft border-default rounded-base flex items-center border ps-4 shadow-xs">
										<input
											id={`bordered-checkbox-${index}`}
											type="checkbox"
											value={rol.id}
											name="roles[]"
											class="border-default-medium bg-neutral-secondary-medium focus:ring-brand-soft h-4 w-4 rounded-xs border focus:ring-2"
										/>
										<label
											for={`bordered-checkbox-${index}`}
											class="text-heading ms-2 w-full py-4 text-sm font-medium select-none"
										>
											{rol.name}
										</label>
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</div>
			<div
				class="items-center rounded-b border-t border-gray-200 p-6 dark:border-gray-700"
			>
				<button class={submitBtnClass} type="submit">Guardar</button>
			</div>
		</div>
	</form>
</Modal>

<!-- Add User Modal -->
<Modal id="add-user-modal" title="Invitar usuario" staticBackdrop={true}>
	<form action="/api/update/admin-invite" method="post">
		<div class="space-y-6 p-6">
			<div class="grid gap-6">
				<div>
					<label for="email" class={labelClass}>Correo</label>
					<input
						type="email"
						name="correo_create"
						id="email"
						class={inputClass}
						placeholder="correo@ejemplo.com"
						required
					/>
				</div>
			</div>
			<div
				class="items-center rounded-b border-t border-gray-200 p-6 dark:border-gray-700"
			>
				<button class={submitBtnClass} type="submit">Invitar Usuario</button>
			</div>
		</div>
	</form>
</Modal>

<!-- Add Role Modal -->
<Modal id="rol-modal-admin" title="Añadir Rol">
	<form action="/api/create/admin-new-rol" method="post">
		<div class="space-y-6 p-6">
			<div class="grid gap-6">
				<div>
					<label for="nombre_rol" class={labelClass}
						>Añade el nombre del rol</label
					>
					<input
						type="text"
						name="nombre_rol"
						id="rol-create"
						class={inputClass}
						placeholder="admin"
						required
					/>
				</div>
			</div>
			<div
				class="items-center rounded-b border-t border-gray-200 p-6 dark:border-gray-700"
			>
				<button class={submitBtnClass} type="submit">Añadir rol</button>
			</div>
		</div>
	</form>
</Modal>

<!-- Update Status Modal -->
<div
	id="updaterol"
	tabindex="-1"
	aria-hidden="true"
	class="h-modal fixed top-0 right-0 left-0 z-50 hidden w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0 md:h-full"
>
	<div class="relative h-full w-full max-w-2xl p-4 md:h-auto">
		<div
			class="dark:bg-black-800 relative rounded-lg bg-white p-4 shadow sm:p-5"
		>
			<div
				class="mb-4 flex items-center justify-between rounded-t border-b pb-4 sm:mb-5 dark:border-gray-600"
			>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
					Selecciona el estado del cliente
				</h3>
				<button
					type="button"
					class="ml-auto inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					data-modal-toggle="updaterol"
				>
					<svg
						aria-hidden="true"
						class="h-5 w-5"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path>
					</svg>
					<span class="sr-only">Close modal</span>
				</button>
			</div>
			<form action="/api/update/admin-update" method="post" id="updaterolForm">
				<input type="hidden" name="user_id" id="updaterol_user_id" />
				<div class="mb-4 grid gap-4">
					<div>
						<label for="updaterol_estado" class={labelClass}>Rol</label>
						<select id="updaterol_estado" name="estado" class={inputClass}>
							<option value="" disabled selected>--</option>
							<option value="activo">activo</option>
							<option value="inactivo">inactivo</option>
						</select>
					</div>
				</div>
				<div class="flex items-center space-x-4">
					<button type="submit" class={submitBtnClass}>
						Actualizar estado
					</button>
					<button
						data-modal-toggle="updaterol"
						type="button"
						class="inline-flex items-center rounded-lg border border-red-600 px-5 py-2.5 text-center text-sm font-medium text-red-600 hover:bg-red-600 hover:text-white focus:ring-4 focus:ring-red-300 focus:outline-none dark:border-red-500 dark:text-red-500 dark:hover:bg-red-600 dark:hover:text-white dark:focus:ring-red-900"
					>
						Cancelar
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script is:inline>
	const bindEditUserButtons = () => {
		const btns = document.querySelectorAll('[data-edit-user]');

		function setValue(id, val) {
			const el = document.getElementById(id);
			if (el) el.value = val ?? '';
		}

		function setSelectValue(id, val) {
			const select = document.getElementById(id);
			if (select && val) select.value = val;
		}

		btns.forEach((btn) => {
			if (btn.dataset.editBind === '1') return;
			btn.dataset.editBind = '1';

			btn.addEventListener('click', () => {
				setValue('modal_user_id', btn.dataset.userId ?? '');
				setValue('modal_nombre', btn.dataset.nombre ?? '');
				setValue('modal_apellido', btn.dataset.apellido ?? '');
				setValue('modal_correo', btn.dataset.correo ?? '');
				setValue('modal_compania', btn.dataset.compania ?? '');
				setValue('ciudad', btn.dataset.ciudad ?? '');
				setValue('direccion_linea1', btn.dataset.linea1 ?? '');
				setValue('direccion_linea2', btn.dataset.linea2 ?? '');
				setValue('modal_telefono', btn.dataset.telefono ?? '');
				setValue('fecha_nacimiento', btn.dataset.nacimiento ?? '');
				setValue('numero_de_identificacion', btn.dataset.numeroidentidad ?? '');

				setSelectValue('pais', btn.dataset.pais ?? '');
				setSelectValue(
					'tipo_identificacion',
					btn.dataset.tipoidentificacion ?? '',
				);
				setSelectValue('tipo_persona', btn.dataset.tipo ?? '');

				document.querySelectorAll('input[name="rol_id"]').forEach((r) => {
					r.checked = String(r.value) === String(btn.dataset.rolId);
				});
				document.querySelectorAll('input[name="estado"]').forEach((r) => {
					r.checked = String(r.value) === String(btn.dataset.userestado);
				});

				const userRoles = JSON.parse(btn.dataset.userRoles || '[]');
				document
					.querySelectorAll('input[name="roles[]"]')
					.forEach((checkbox) => {
						checkbox.checked = userRoles.includes(checkbox.value);
					});
			});
		});
	};

	document.addEventListener('DOMContentLoaded', bindEditUserButtons);
	document.addEventListener('astro:page-load', bindEditUserButtons);
</script>
<script is:inline>
	const bindEstadoButtons = () => {
		const form = document.getElementById('updaterolForm');
		const uidInput = document.getElementById('updaterol_user_id');
		const estadoSel = document.getElementById('updaterol_estado');
		const nameSpan = document.getElementById('updaterolUserName');
		const btns = document.querySelectorAll('[data-open-estado]');
		const fallbackBackPath = '/crud/users';

		if (!form || !uidInput || !estadoSel) return;

		function getSafeBackPath() {
			const path = window.location.pathname;
			if (typeof path === 'string' && path.startsWith('/')) {
				return path;
			}
			return fallbackBackPath;
		}

		btns.forEach((btn) => {
			if (btn.dataset.estadoBind === '1') return;
			btn.dataset.estadoBind = '1';

			btn.addEventListener('click', () => {
				const uid = btn.dataset.userId || '';
				const uname = btn.dataset.userName || '';
				const estCur = btn.dataset.userEstado || '';

				uidInput.value = uid;
				if (nameSpan) nameSpan.textContent = uname ? ` · ${uname}` : '';

				const hasOption = Array.from(estadoSel.options).some(
					(o) => o.value === estCur,
				);
				estadoSel.value = hasOption ? estCur : '';

				const back = getSafeBackPath();
				form.action = `/api/admin/usuarios/update?back=${encodeURIComponent(back)}`;
			});
		});

		if (form?.dataset.submitBind === '1') return;
		if (form) form.dataset.submitBind = '1';

		form?.addEventListener('submit', () => {
			const submitBtn = form?.querySelector('button[type="submit"]');
			if (submitBtn) submitBtn.disabled = true;
		});
	};

	document.addEventListener('DOMContentLoaded', bindEstadoButtons);
	document.addEventListener('astro:page-load', bindEstadoButtons);
</script>
