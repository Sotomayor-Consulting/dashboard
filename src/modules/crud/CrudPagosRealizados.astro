---
import DataTable from '@components/ui/DataTable.astro';
import StatusBadge from '@components/ui/StatusBadge.astro';
import DateCell from '@components/ui/DateCell.astro';
import StackedText from '@components/ui/StackedText.astro';
import Alerta from '@components/feedback/alertageneral.astro';
import { Icon } from 'astro-icon/components';
import { pagosRealizadosData } from '@lib/tablas/PagosPorLeer';

const supabase = Astro.locals.supabase;

const pagosRealizados = await pagosRealizadosData(supabase);
---

<Alerta />
<div>
	<div
		class="p-4 bg-gray-50 block sm:flex items-center justify-between border-b border-gray-200 lg:mt-1.5 dark:bg-black-900 w-full"
	>
		<div class="w-full mb-1">
			<div class="mb-4">
				<nav class="flex mb-5" aria-label="Breadcrumb">
					<ol
						class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
					>
						<li class="inline-flex items-center">
							<a
								href="/"
								class="inline-flex items-center text-gray-700 hover:text-primary-600 dark:text-gray-300 dark:hover:text-white"
							>
								<svg
									class="w-5 h-5 mr-2.5"
									fill="currentColor"
									viewBox="0 0 20 20"
									xmlns="http://www.w3.org/2000/svg"
									><path
										d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
									></path></svg
								>
								Inicio
							</a>
						</li>
						<li>
							<div class="flex items-center">
								<svg
									class="w-6 h-6 text-gray-400"
									fill="currentColor"
									viewBox="0 0 20 20"
									xmlns="http://www.w3.org/2000/svg"
									><path
										fill-rule="evenodd"
										d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
										clip-rule="evenodd"></path></svg
								>
								<a
									href="/crud/formularios-enviados"
									class="ml-1 text-gray-700 hover:text-primary-600 md:ml-2 dark:text-gray-300 dark:hover:text-white"
									>Formularios</a
								>
							</div>
						</li>
					</ol>
				</nav>
				<h1
					class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
				>
					Todos los pagos realizados
				</h1>
			</div>
			<div class="items-center justify-between block sm:flex">
				<div class="flex items-center ml-auto space-x-2 sm:space-x-3">
				<a
						href="/crud/pagos"
						type="button"
						class="inline-flex items-center justify-center w-1/2 px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:ring-primary-300 sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67] h-full"
					>
						<svg
							class="w-5 h-5 mr-2 -ml-1"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
							></path>
						</svg>
						Actualizar
					</a>
				</div>
			</div>
		</div>
	</div>

	<DataTable
		headers={[
			'id de Stripe',
			'Pago hecho por',
			'Empresa asociada al pago',
			'Servicio pagado',
			'cantidad',
			'Estado del pago',
			'Leído',
			'Fecha de pago',
			'Acciones',
		]}
		noRowsMessage="No hay pagos realizados"
		noResultsMessage="No se encontraron pagos recientes"
	>
		{
			pagosRealizados?.map((sr) => (
				<tr class="hover:bg-gray-100 dark:hover:bg-[#101522] odd:dark:bg-[#28314c] even:dark:bg-[#384467] odd:bg-gray-50 even:bg-gray-100">
					<td class="p-4 text-sm font-normal text-gray-500 whitespace-nowrap dark:text-gray-400">
						<div class="text-base font-semibold text-gray-900 dark:text-neutral-400">
							<data value="name">
								{sr.stripe_payment_intent_id ?? '— sin id —'}
							</data>
						</div>
					</td>
					<td class="max-w-sm p-4 overflow-hidden text-base font-normal text-gray-500 truncate xl:max-w-xs dark:text-gray-400">
						<data>
							{sr.usuarios.nombre} {sr.usuarios.apellido}
						</data>
					</td>
					<td class="max-w-sm p-4 overflow-hidden text-base font-normal text-gray-500 truncate xl:max-w-xs dark:text-gray-400">
						<StackedText
							title={sr.empresas_incorporaciones.nombre_1}
							subtitle={sr.empresas_incorporaciones.empresa_incorporacion_id}
						/>
					</td>
					<td class="max-w-sm p-4 text-base font-normal text-gray-900 whitespace-nowrap dark:text-white truncate">
						<div class="text-base font-semibold text-gray-900 dark:text-neutral-400">
							<data>{sr.servicios.nombre}</data>
						</div>
					</td>
					<td class="max-w-sm p-4 text-base font-normal text-gray-900 whitespace-nowrap dark:text-white truncate">
						<data>
							{sr.amount &&
								(sr.amount / 100).toLocaleString('en-US', {
									style: 'currency',
									currency: 'USD',
									minimumFractionDigits: 2,
								})}
						</data>
					</td>
					<td class="max-w-sm p-4 text-base font-normal text-gray-900 whitespace-nowrap dark:text-white truncate">
						<StatusBadge
							active={sr.status === 'succeeded'}
							activeLabel="Pago exitoso"
							inactiveLabel="Error de pago"
							activeColor="bg-green-400"
							inactiveColor="bg-orange-400"
						/>
					</td>
					<td class="max-w-sm p-4 text-base font-normal text-gray-900 whitespace-nowrap dark:text-white truncate">
						<StatusBadge
							active={sr.visto_por_operaciones === true}
							activeLabel="Leído"
							inactiveLabel="Sin leer"
							activeColor="bg-green-400"
							inactiveColor="bg-orange-400"
						/>
					</td>
					<td class="p-4 text-base font-medium text-gray-900 whitespace-nowrap dark:text-white">
						<DateCell date={sr.created_at} />
					</td>
					<td class="p-4 space-x-2 whitespace-nowrap text-center">
						<div class="h-full flex justify-center items-center gap-2">
							{sr.visto_por_operaciones === false ? (
								<form
									action="/api/update/operaciones-update-lectura-de-pagos"
									method="post"
								>
									<input
										type="text"
										value={sr.id_pagos}
										hidden
										name="pago_id"
									/>
									<input
										type="text"
										value="true"
										hidden
										name="marcar_como_visto"
									/>
									<button
										type="submit"
										title="marcar como leído"
										data-tooltip-target={`tool-tip-${sr.id_pagos}`}
									>
										<Icon
											name="ri:check-double-fill"
											class="text-neutral-600 dark:text-neutral-400 dark:hover:text-neutral-300 text-2xl hover:scale-105"
										/>
									</button>
								</form>
							) : (
								<div
									data-tooltip-target={`tool-tip-${sr.id_pagos}-read`}
								>
									<Icon
										name="ri:checkbox-circle-fill"
										class="text-neutral-600 dark:text-neutral-400 dark:hover:text-neutral-300 text-2xl hover:scale-105"
									/>
								</div>
							)}

							<div
								id={`tool-tip-${sr.id_pagos}`}
								role="tooltip"
								class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-xs opacity-0 tooltip dark:bg-black-800"
							>
								Marcar como leído
								<div class="tooltip-arrow" data-popper-arrow />
							</div>

							<div
								id={`tool-tip-${sr.id_pagos}-read`}
								role="tooltip"
								class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-xs opacity-0 tooltip dark:bg-black-800"
							>
								Leído
								<div class="tooltip-arrow" data-popper-arrow />
							</div>
						</div>
					</td>
				</tr>
			))
		}
	</DataTable>
</div>
