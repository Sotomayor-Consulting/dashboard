---
import '@styles/datatables.css';
import Alerta from '@components/feedback/alertageneral.astro';
import { ListaServiciosGeneral } from '@lib/tablas/servicios';

const servicio = await ListaServiciosGeneral();
---

<script src="@lib/alpinejs/alpine.js"></script>
<div
	class="dark:bg-black-900 block items-center justify-between border-b border-gray-200 bg-white p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<Alerta />
	<div class="w-full">
		<div
			class="dark:bg-black-900 block w-full items-center justify-between border-b border-gray-200 bg-white p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
		>
			<div class="mb-1 w-full">
				<div class="mb-4">
					<nav class="mb-5 flex" aria-label="Breadcrumb">
						<ol
							class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
						>
							<li class="inline-flex items-center">
								<a
									href="/"
									class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
								>
									<svg
										class="mr-2.5 h-5 w-5"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
										><path
											d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
										></path></svg
									>
									Inicio
								</a>
							</li>
							<li>
								<div class="flex items-center">
									<svg
										class="h-6 w-6 text-gray-400"
										fill="currentColor"
										viewBox="0 0 20 20"
										xmlns="http://www.w3.org/2000/svg"
										><path
											fill-rule="evenodd"
											d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
											clip-rule="evenodd"></path></svg
									>
									<a
										href="#"
										class="ml-1 text-gray-700 hover:text-[#967432] md:ml-2 dark:text-gray-300 dark:hover:text-white"
										>servicios</a
									>
								</div>
							</li>
						</ol>
					</nav>
					<h1
						class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
					>
						Todos los servicios
					</h1>
				</div>
				<div class="block items-center justify-between sm:flex">
					<div class="ml-auto flex items-center space-x-2 sm:space-x-3">
						<a
							href="/crud/services/"
							type="button"
							class="hover:bg-[#8c681d]focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-800 inline-flex w-1/2 items-center justify-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
						>
							<svg
								class="mr-2 -ml-1 h-5 w-5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
								></path>
							</svg>
							Actualizar
						</a>
						<button
							id="createProductButton"
							class="hover:bg-[#8c681d]focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-800 inline-flex w-1/2 items-center justify-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
							type="button"
							data-drawer-target="drawer-create-product-default"
							data-drawer-show="drawer-create-product-default"
							aria-controls="drawer-create-product-default"
							data-drawer-placement="right"
						>
							<svg
								class="mr-2 -ml-1 h-5 w-5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
									clip-rule="evenodd"></path></svg
							>
							Añadir servicio
						</button>
					</div>
				</div>
			</div>
		</div>

		<div class="flex flex-col">
			<div class="overflow-x-auto">
				<div class="inline-block min-w-full align-middle">
					<div class="overflow-hidden shadow">
						<table
							class="min-w-full table-fixed divide-y divide-gray-200 dark:divide-gray-600"
							id="myTable"
						>
							<thead class="bg-gray-100 dark:bg-[#1f2937]">
								<tr>
									{
										[
											'Nombre del servicio',
											'Categoría',
											'Descripción',
											'ID',
											'Precio',
											'Fecha de creación',
											'estado',
											'Acciones',
										].map((th) => (
											<th
												scope="col"
												class="p-4 text-left text-xs font-medium text-gray-500 uppercase dark:text-gray-400"
											>
												<span class="flex items-center uppercase">
													{th}
													<svg
														class="ms-1 h-4 w-4"
														aria-hidden="true"
														xmlns="http://www.w3.org/2000/svg"
														width="24"
														height="24"
														fill="none"
														viewBox="0 0 24 24"
													>
														<path
															stroke="currentColor"
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="2"
															d="m8 15 4 4 4-4m0-6-4-4-4 4"
														/>
													</svg>
												</span>
											</th>
										))
									}
								</tr>
							</thead>

							<tbody class="divide-y divide-gray-200 dark:divide-gray-700">
								{
									servicio?.map((sr) => (
										<tr class="odd:bg-white-100 even:bg-[#d4d4d4] hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]">
											<td class="p-4 text-sm font-normal whitespace-nowrap text-gray-500 dark:text-gray-400">
												<div class="text-base font-semibold text-gray-900 dark:text-white">
													<data value="name">{sr.nombre}</data>
												</div>
												<div class="text-sm font-normal text-gray-500 dark:text-gray-400">
													<data value="category">{sr.categoria}</data>
												</div>
											</td>

											<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
												<data value="description">{sr.categoria}</data>
											</td>
											<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
												<data value="description">{sr.descripcion}</data>
											</td>
											<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
												#<data value="price">{sr.id}</data>
											</td>
											<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
												$<data value="price">{sr.precio}</data>
											</td>
											<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
												<data value="price">
													{sr.created_at &&
														new Date(sr.created_at)
															.toLocaleDateString('es-ES', {
																day: '2-digit',
																month: '2-digit',
																year: 'numeric',
															})
															.replace(/\//g, '-')}
												</data>
											</td>
											<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
												<div class="flex items-center">
													{sr.servicio_activo === true ? (
														<>
															<div class="mr-2 h-2.5 w-2.5 rounded-full bg-green-400" />
															<span>Activo</span>
														</>
													) : (
														<>
															<div class="mr-2 h-2.5 w-2.5 rounded-full bg-red-500" />
															<span>Inactivo</span>
														</>
													)}
												</div>
											</td>

											<td
												class="space-x-2 p-4 whitespace-nowrap"
												x-data="{ showTooltip: false }"
											>
												<button
													type="button"
													id="updateProductButton"
													data-service-update
													data-id={sr.id}
													data-nombre={sr.nombre}
													data-precio={sr.precio || ''}
													data-categoria={sr.categoria || ''}
													data-descripcion={sr.descripcion || ''}
													data-drawer-target="drawer-update-product-default"
													data-drawer-show="drawer-update-product-default"
													aria-controls="drawer-update-product-default"
													data-drawer-placement="right"
													class="focus:ring-primary-300 inline-flex items-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
												>
													<svg
														class="mr-2 h-4 w-4"
														fill="currentColor"
														viewBox="0 0 20 20"
														xmlns="http://www.w3.org/2000/svg"
													>
														<svg>
															<path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z" />
															<path
																fill-rule="evenodd"
																d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"
																clip-rule="evenodd"
															/>
														</svg>
													</svg>
													Actualizar Servicio
												</button>
												<button
													id={`dd-btn-${sr.id}`}
													@click="showTooltip = !showTooltip"
													@click.outside="showTooltip = false"
													class="dark:bg-black-800 inline-flex items-center rounded-lg bg-white p-2 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-50 focus:outline-none dark:text-white dark:hover:bg-[#101522] dark:focus:ring-gray-600"
													type="button"
													aria-haspopup="true"
													aria-expanded="false"
												>
													<svg
														class="h-5 w-5"
														aria-hidden="true"
														xmlns="http://www.w3.org/2000/svg"
														fill="currentColor"
														viewBox="0 0 4 15"
													>
														<path d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
													</svg>
												</button>
												<div
													id={`dd-${sr.id}`}
													x-show="showTooltip"
													x-transition
													class="dark:bg-black-900 absolute right-2 z-20 mt-1 w-44 divide-y divide-gray-100 rounded-lg border border-neutral-300 bg-white shadow-sm dark:divide-gray-600 dark:border-neutral-500"
													role="menu"
													aria-labelledby={`dd-btn-${sr.id}`}
													data-dropdown-placement="bottom-start"
												>
													<ul
														class="py-2 text-sm text-gray-700 dark:text-gray-200"
														role="none"
													>
														<li>
															<button
																type="button"
																data-open-estado
																data-service-id={sr.id}
																data-service-precio={`${sr.precio}`.trim()}
																data-service-name={`${sr.nombre}`.trim()}
																data-service-categoria={`${sr.categoria}`.trim()}
																data-service-descripcion={`${sr.descripcion}`.trim()}
																data-servicios-estado={`${sr.servicio_activo}`.trim()}
																data-drawer-target="drawer-delete-product-default"
																data-drawer-show="drawer-delete-product-default"
																aria-controls="drawer-delete-product-default"
																data-drawer-placement="right"
																class="block w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
																role="menuitem"
															>
																Archivar
															</button>
														</li>
														<li>
															<button
																type="button"
																data-open-desarchivado
																data-service-id={sr.id}
																data-service-precio={`${sr.precio}`.trim()}
																data-service-name={`${sr.nombre}`.trim()}
																data-service-categoria={`${sr.categoria}`.trim()}
																data-service-descripcion={`${sr.descripcion}`.trim()}
																data-servicios-estado={`${sr.servicio_activo}`.trim()}
																data-drawer-target="desarchivar-menu"
																data-drawer-show="desarchivar-menu"
																aria-controls="desarchivar-menu"
																data-drawer-placement="right"
																class="block w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
																role="menuitem"
															>
																Desarchivar
															</button>
														</li>
													</ul>
												</div>
											</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>

		<!-- Edit Product Drawer -->
		<div
			id="drawer-update-product-default"
			class="dark:bg-black-800 fixed top-0 right-0 z-40 h-screen w-full max-w-sm translate-x-full overflow-y-auto bg-white p-4 transition-transform"
			tabindex="-1"
			aria-labelledby="drawer-label"
			aria-hidden="true"
		>
			<h5
				id="drawer-label"
				class="mb-6 inline-flex items-center text-sm font-semibold text-gray-500 uppercase dark:text-gray-400"
			>
				Actualizar servicio
			</h5>
			<button
				type="button"
				data-drawer-dismiss="drawer-update-product-default"
				aria-controls="drawer-update-product-default"
				class="absolute top-2.5 right-2.5 inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
			>
				<svg
					aria-hidden="true"
					class="h-5 w-5"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
					><path
						fill-rule="evenodd"
						d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
						clip-rule="evenodd"></path></svg
				>
				<span class="sr-only">Cerrar menu</span>
			</button>

			<form action="/api/update/admin-update-services" method="post">
				<div class="space-y-4">
					<input
						type="hidden"
						name="service_id"
						id="modal_service_id"
						value=""
					/>
					<div>
						<label
							for="nombre_update-service"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Nombre</label
						>
						<input
							type="text"
							name="nombre-service"
							id="nombre_update-service"
							class="dark:bg-black-800 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
							value="Education Dashboard"
							placeholder="inserta el nombre del servicio"
							required=""
						/>
					</div>
					<div>
						<label
							for="categoria_service"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Categoria</label
						>
						<input
							type="text"
							name="categoria-service"
							id="categoria_service"
							class="dark:bg-black-800 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
							value="Education Dashboard"
							placeholder="Añade el nombre del servicio"
							required=""
						/>
					</div>
					<div>
						<label
							for="precio-servicio"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Precio</label
						>
						<input
							type="number"
							name="precio-servicio"
							id="precio-servicio"
							class="dark:bg-black-800 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
							value="2999"
							placeholder="$149"
							required=""
						/>
					</div>
					<div>
						<label
							for="descripcion-servicio"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Descripcion</label
						>
						<textarea
							id="descripcion-servicio"
							name="descripcion-service"
							rows="4"
							class="dark:bg-black-800 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
							placeholder="Añade una descripcion del producto"
							>Start developing with an open-source library of over 450+ UI
							components, sections, and pages built with the utility classes
							from Tailwind CSS and designed in Figma.</textarea
						>
					</div>
				</div>
				<div
					class="bottom-0 left-0 mt-4 flex w-full justify-center space-x-4 pb-4 sm:absolute sm:mt-0 sm:px-4"
				>
					<button
						type="submit"
						class="w-full justify-center rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d] focus:ring-4 focus:ring-[#8c681d] focus:outline-none dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
					>
						Actualizar
					</button>
					<button
						data-drawer-hide="drawer-update-product-default"
						type="button"
						class="inline-flex w-full items-center justify-center rounded-lg border border-red-600 px-5 py-2.5 text-center text-sm font-medium text-red-600 hover:bg-red-600 hover:text-white focus:ring-4 focus:ring-red-300 focus:outline-none dark:border-red-500 dark:text-red-500 dark:hover:bg-red-600 dark:hover:text-white dark:focus:ring-red-900"
					>
						Cancelar
					</button>
				</div>
			</form>
		</div>

		<!-- Delete Product Drawer -->
		<div
			id="drawer-delete-product-default"
			class="dark:bg-black-800 fixed top-0 right-0 z-40 h-screen w-full max-w-xs translate-x-full overflow-y-auto bg-white p-4 transition-transform"
			tabindex="-1"
			aria-labelledby="drawer-label"
			aria-hidden="true"
		>
			<h5
				id="drawer-label"
				class="inline-flex items-center text-sm font-semibold text-gray-500 uppercase dark:text-gray-400"
			>
				Archivar servicio
			</h5>
			<button
				type="button"
				data-drawer-dismiss="drawer-delete-product-default"
				aria-controls="drawer-delete-product-default"
				class="absolute top-2.5 right-2.5 inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
			>
				<svg
					aria-hidden="true"
					class="h-5 w-5"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
					><path
						fill-rule="evenodd"
						d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
						clip-rule="evenodd"></path></svg
				>
				<span class="sr-only">Cerrar menu</span>
			</button>
			<svg
				class="mt-8 mb-4 h-10 w-10 text-red-600"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
				><path
					stroke-linecap="round"
