		<script>
			document.addEventListener('DOMContentLoaded', () => {
				// Tipar los botones como HTMLElement (con dataset)
				const btns = document.querySelectorAll<HTMLElement>(
					'[data-service-update]',
				);

				// Helper para setear .value de inputs/textarea de forma segura
				function setValue(id: string, val: string) {
					const el = document.getElementById(id) as
						| HTMLInputElement
						| HTMLTextAreaElement
						| null;
					if (el) el.value = val ?? '';
				}

				btns.forEach((btn) => {
					btn.addEventListener('click', () => {
						const id = btn.dataset.id ?? '';
						const nombre = btn.dataset.nombre ?? '';
						const precio = btn.dataset.precio ?? '';
						const categoria = btn.dataset.categoria ?? '';
						const descripcion = btn.dataset.descripcion ?? '';

						setValue('modal_service_id', id);
						setValue('nombre_update-service', nombre);
						setValue('precio-servicio', precio);
						setValue('categoria_service', categoria);
						setValue('descripcion-servicio', descripcion);
					});
				});
			});
		</script>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const form = document.getElementById('archivar_form');
