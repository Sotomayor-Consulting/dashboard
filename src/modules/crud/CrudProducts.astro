---
import Alerta from '@components/feedback/alertageneral.astro';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import DataTable from '@components/ui/DataTable.astro';
import DateCell from '@components/ui/DateCell.astro';
import Drawer from '@components/ui/Drawer.astro';
import DrawerConfirm from '@components/ui/DrawerConfirm.astro';
import DrawerFormActions from '@components/ui/DrawerFormActions.astro';
import StackedText from '@components/ui/StackedText.astro';
import StatusBadge from '@components/ui/StatusBadge.astro';
import { ListaServiciosGeneral } from '@lib/tablas/services/servicios';

const supabase = Astro.locals.supabase;
const servicio = await ListaServiciosGeneral(supabase);

const inputClass =
	'dark:bg-black-800 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]';
const labelClass =
	'mb-2 block text-sm font-medium text-gray-900 dark:text-white';
---

<script src="@lib/alpinejs/alpine.js"></script>
<div
	class="block items-center justify-between border-b border-gray-200 p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<Alerta />
	<div class="w-full">
		<div
			class="block w-full items-center justify-between border-gray-200 p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
		>
			<CrudPageHeader
				title="Todos los servicios"
				breadcrumbItems={[{ label: 'Servicios' }]}
				refreshHref="/crud/services/"
			>
				<button
					slot="actions"
					id="createProductButton"
					class="focus:ring-primary-300 dark:focus:ring-primary-800 inline-flex w-1/2 items-center justify-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#8c681d]/90 focus:ring-4 sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
					type="button"
					data-drawer-target="drawer-create-product-default"
					data-drawer-show="drawer-create-product-default"
					aria-controls="drawer-create-product-default"
					data-drawer-placement="right"
				>
					<svg
						class="mr-2 -ml-1 h-5 w-5"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							fill-rule="evenodd"
							d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
							clip-rule="evenodd"></path>
					</svg>
					Añadir servicio
				</button>
			</CrudPageHeader>
		</div>

		<DataTable
			headers={[
				'Nombre del servicio',
				'Categoría',
				'Descripción',
				'ID',
				'Precio',
				'Fecha de creación',
				'Estado',
				'Acciones',
			]}
			noRowsMessage="No hay servicios"
			noResultsMessage="No se encontraron servicios aun"
		>
			{
				servicio?.map((sr) => (
					<tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]">
						<td class="p-4 text-sm font-normal whitespace-nowrap text-gray-500 dark:text-gray-400">
							<StackedText title={sr.nombre} subtitle={sr.categoria} />
						</td>
						<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
							{sr.categoria}
						</td>
						<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
							{sr.descripcion}
						</td>
						<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
							#{sr.id}
						</td>
						<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
							${sr.precio}
						</td>
						<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
							<DateCell date={sr.created_at} />
						</td>
						<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
							<StatusBadge active={sr.servicio_activo === true} />
						</td>
						<td
							class="relative space-x-2 p-4 whitespace-nowrap"
							x-data="{ showTooltip: false }"
						>
							<button
								type="button"
								data-service-update
								data-id={sr.id}
								data-nombre={sr.nombre}
								data-precio={sr.precio || ''}
								data-categoria={sr.categoria || ''}
								data-descripcion={sr.descripcion || ''}
								data-drawer-target="drawer-update-product-default"
								data-drawer-show="drawer-update-product-default"
								aria-controls="drawer-update-product-default"
								data-drawer-placement="right"
								class="focus:ring-primary-300 inline-flex items-center rounded-lg bg-[#8c681d] px-3 py-2 text-center text-sm font-medium text-white hover:bg-[#8c681d]/90 focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
							>
								<svg
									class="mr-2 h-4 w-4"
									fill="currentColor"
									viewBox="0 0 20 20"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z" />
									<path
										fill-rule="evenodd"
										d="M2 6a2 2 0 012-2h4a1 1 0 010 2H4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"
										clip-rule="evenodd"
									/>
								</svg>
								Actualizar Servicio
							</button>
							<button
								id={`dd-btn-${sr.id}`}
								@click="showTooltip = !showTooltip"
								@click.outside="showTooltip = false"
								class="dark:bg-black-800 inline-flex items-center rounded-lg bg-white p-2 text-center text-sm font-medium text-gray-900 hover:bg-gray-100 focus:ring-4 focus:ring-gray-50 focus:outline-none dark:text-white dark:hover:bg-[#101522] dark:focus:ring-gray-600"
								type="button"
								aria-haspopup="true"
								aria-expanded="false"
							>
								<svg
									class="h-5 w-5"
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
									fill="currentColor"
									viewBox="0 0 4 15"
								>
									<path d="M3.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 6.041a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm0 5.959a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
								</svg>
							</button>
							<div
								id={`dd-${sr.id}`}
								x-cloak
								x-show="showTooltip"
								x-transition
								class="dark:bg-black-900 absolute right-2 z-20 mt-1 w-44 divide-y divide-gray-100 rounded-lg border border-neutral-300 bg-white shadow-sm dark:divide-gray-600 dark:border-neutral-500"
								role="menu"
								aria-labelledby={`dd-btn-${sr.id}`}
								data-dropdown-placement="bottom-start"
							>
								<ul
									class="py-2 text-sm text-gray-700 dark:text-gray-200"
									role="none"
								>
									<li>
										<button
											type="button"
											data-open-estado
											data-service-id={sr.id}
											data-drawer-target="drawer-delete-product-default"
											data-drawer-show="drawer-delete-product-default"
											aria-controls="drawer-delete-product-default"
											data-drawer-placement="right"
											class="block w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
											role="menuitem"
										>
											Archivar
										</button>
									</li>
									<li>
										<button
											type="button"
											data-open-desarchivado
											data-service-id={sr.id}
											data-drawer-target="desarchivar-menu"
											data-drawer-show="desarchivar-menu"
											aria-controls="desarchivar-menu"
											data-drawer-placement="right"
											class="block w-full px-4 py-2 text-left hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white"
											role="menuitem"
										>
											Desarchivar
										</button>
									</li>
								</ul>
							</div>
						</td>
					</tr>
				))
			}
		</DataTable>

		<!-- Edit Product Drawer -->
		<Drawer id="drawer-update-product-default" title="Actualizar servicio">
			<form action="/api/update/admin-update-services" method="post">
				<div class="space-y-4">
					<input
						type="hidden"
						name="service_id"
						id="modal_service_id"
						value=""
					/>
					<div>
						<label for="nombre_update-service" class={labelClass}>Nombre</label>
						<input
							type="text"
							name="nombre-service"
							id="nombre_update-service"
							class={inputClass}
							placeholder="inserta el nombre del servicio"
							required
						/>
					</div>
					<div>
						<label for="categoria_service" class={labelClass}>Categoria</label>
						<input
							type="text"
							name="categoria-service"
							id="categoria_service"
							class={inputClass}
							placeholder="Añade el nombre del servicio"
							required
						/>
					</div>
					<div>
						<label for="precio-servicio" class={labelClass}>Precio</label>
						<input
							type="number"
							name="precio-servicio"
							id="precio-servicio"
							class={inputClass}
							placeholder="$149"
							required
						/>
					</div>
					<div>
						<label for="descripcion-servicio" class={labelClass}
							>Descripcion</label
						>
						<textarea
							id="descripcion-servicio"
							name="descripcion-service"
							rows="4"
							class={inputClass}
							placeholder="Añade una descripcion del producto"></textarea>
					</div>
				</div>
				<DrawerFormActions
					drawerId="drawer-update-product-default"
					submitLabel="Actualizar"
				/>
			</form>
		</Drawer>

		<!-- Archive Product Drawer -->
		<DrawerConfirm
			id="drawer-delete-product-default"
			title="Archivar servicio"
			message="¿Estas seguro de querer archivar este servicio?"
			action="/api/update/admin-services-delete"
			formId="archivar_form"
			variant="danger"
		>
			<input type="hidden" name="servicio_id" id="servicio_id" />
			<input type="hidden" name="servicio_activo" value="false" />
		</DrawerConfirm>

		<!-- Unarchive Product Drawer -->
		<DrawerConfirm
			id="desarchivar-menu"
			title="Desarchivar servicio"
			message="¿Estas seguro de querer desarchivar este servicio?"
			action="/api/update/admin-services-add"
			formId="desarchivar_form"
			variant="success"
		>
			<input type="hidden" name="des_servicio_id" id="des_servicio_id" />
			<input type="hidden" name="des_servicio_activo" value="true" />
		</DrawerConfirm>

		<!-- Add Product Drawer -->
		<Drawer id="drawer-create-product-default" title="Nuevo Servicio">
			<form action="/api/create/admin-new-service" method="POST">
				<div class="space-y-4">
					<div>
						<label for="nombre-service" class={labelClass}>Nombre</label>
						<input
							type="text"
							name="nombre-service"
							id="nombre-service"
							class={inputClass}
							placeholder="Nombre del servicio"
							required
						/>
					</div>
					<div>
						<label for="price" class={labelClass}>Precio</label>
						<input
							type="number"
							name="precio-servicio"
							id="price"
							class={inputClass}
							placeholder="$2999"
							required
						/>
					</div>
					<div>
						<label for="categoria-service" class={labelClass}>Categoria</label>
						<input
							type="text"
							name="categoria-service"
							id="categoria-service"
							class={inputClass}
							placeholder="Categoria del servicio"
							required
						/>
					</div>
					<div>
						<label for="descripcion-service" class={labelClass}
							>Descripcion</label
						>
						<textarea
							id="descripcion-service"
							name="descripcion-service"
							rows="4"
							class={inputClass}
							placeholder="Ingresa una descripcion del servicio"></textarea>
					</div>
					<DrawerFormActions
						drawerId="drawer-create-product-default"
						submitLabel="Añadir servicio"
					/>
				</div>
			</form>
		</Drawer>

		<script>
			const bindServiceUpdateButtons = () => {
				const btns = document.querySelectorAll<HTMLElement>(
					'[data-service-update]',
				);

				function setValue(id: string, val: string) {
					const el = document.getElementById(id) as
						| HTMLInputElement
						| HTMLTextAreaElement
						| null;
					if (el) el.value = val ?? '';
				}

				btns.forEach((btn) => {
					if (btn.dataset.serviceUpdateBind === '1') return;
					btn.dataset.serviceUpdateBind = '1';

					btn.addEventListener('click', () => {
						setValue('modal_service_id', btn.dataset.id ?? '');
						setValue('nombre_update-service', btn.dataset.nombre ?? '');
						setValue('precio-servicio', btn.dataset.precio ?? '');
						setValue('categoria_service', btn.dataset.categoria ?? '');
						setValue('descripcion-servicio', btn.dataset.descripcion ?? '');
					});
				});
			};

			document.addEventListener('DOMContentLoaded', bindServiceUpdateButtons);
			document.addEventListener('astro:page-load', bindServiceUpdateButtons);
		</script>
		<script is:inline>
			const bindArchivarButtons = () => {
				const form = document.getElementById('archivar_form');
				const uidInput = document.getElementById('servicio_id');
				const btns = document.querySelectorAll('[data-open-estado]');

				if (!form || !uidInput) return;

				btns.forEach((btn) => {
					if (btn.dataset.archivarBind === '1') return;
					btn.dataset.archivarBind = '1';

					btn.addEventListener('click', () => {
						uidInput.value = btn.dataset.serviceId || '';
					});
				});

				if (form.dataset.submitBind === '1') return;
				form.dataset.submitBind = '1';

				form.addEventListener('submit', () => {
					const submitBtn = form.querySelector('button[type="submit"]');
					if (submitBtn) submitBtn.disabled = true;
				});
			};

			document.addEventListener('DOMContentLoaded', bindArchivarButtons);
			document.addEventListener('astro:page-load', bindArchivarButtons);
		</script>
		<script is:inline>
			const bindDesarchivarButtons = () => {
				const form = document.getElementById('desarchivar_form');
				const uidInput = document.getElementById('des_servicio_id');
				const btns = document.querySelectorAll('[data-open-desarchivado]');

				if (!form || !uidInput) return;

				btns.forEach((btn) => {
					if (btn.dataset.desarchivarBind === '1') return;
					btn.dataset.desarchivarBind = '1';

					btn.addEventListener('click', () => {
						uidInput.value = btn.dataset.serviceId || '';
					});
				});

				if (form.dataset.submitBind === '1') return;
				form.dataset.submitBind = '1';

				form.addEventListener('submit', () => {
					const submitBtn = form.querySelector('button[type="submit"]');
					if (submitBtn) submitBtn.disabled = true;
				});
			};

			document.addEventListener('DOMContentLoaded', bindDesarchivarButtons);
			document.addEventListener('astro:page-load', bindDesarchivarButtons);
		</script>
	</div>
</div>
