---
import { CompaniesTableClient as CompanyTable } from '@modules/companies/components/company-table-client.tsx';
import { SharedBreadcrumb } from '@components/ui/bread-crumb.tsx';
import { getCompanies } from '@modules/companies/services/companyService.ts';
import { getCountries } from '@lib/tablas/countries';
import { getAllUsuarios } from '@lib/tablas/usuarios';
import type { CompanyTableRow, Country } from './types';
import type { UsuarioItem as User } from '@modules/users/types';

const supabase = Astro.locals.supabase;

const [companies, countries, users] = await Promise.all([
	getCompanies(supabase),
	getCountries(supabase),
	getAllUsuarios(supabase),
]);

const countriesMap = countries.reduce(
	(acc, country) => {
		acc[country.id] = country;
		return acc;
	},
	{} as Record<string, Country>,
);

const usersMap = users.reduce(
	(acc, user) => {
		acc[user.user_id] = user;
		return acc;
	},
	{} as Record<string, User>,
);

const tableData: CompanyTableRow[] = companies.map((item) => ({
	...item,
	formation_country: item.formation_country_id
		? (countriesMap[item.formation_country_id] ?? null)
		: null,
	user: item.user_id ? (usersMap[item.user_id] ?? null) : null,
}));

console.log('tableData :>> ', tableData);

const paths = [{ label: 'Inicio', href: '/' }, { label: 'Empresas' }];
---

<SharedBreadcrumb paths={paths} />
<div class="flex flex-col border-gray-200/80 bg-transparent">
	<CompanyTable data={tableData} client:load />
</div>
