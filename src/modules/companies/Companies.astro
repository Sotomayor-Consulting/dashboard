---
import CompaniesCrudTable from '@modules/companies/islands/CompaniesCrudTable.tsx';
import { getCompaniesPageData } from '@modules/companies/services/get-companies-page-data';

const supabase = Astro.locals.supabase;

const [tableData, estadosResult] = await Promise.all([
	getCompaniesPageData(supabase),
	supabase.from('estados').select('Estado'),
]);

const estados = (estadosResult.data ?? []).map((e) => e.Estado as string);
---

<CompaniesCrudTable data={tableData} estados={estados} client:load />
