---
import CompaniesCrudTable from '@modules/companies/views/CompaniesCrudTable';
import { SharedBreadcrumb } from '@components/ui/bread-crumb.tsx';
import { getCompaniesPageData } from '@modules/companies/services/getCompaniesPageData';

const supabase = Astro.locals.supabase;

const [tableData, estadosResult] = await Promise.all([
	getCompaniesPageData(supabase),
	supabase.from('estados').select('Estado'),
]);

const estados = (estadosResult.data ?? []).map((e) => e.Estado as string);

const paths = [{ label: 'Inicio', href: '/' }, { label: 'Empresas' }];
---

<SharedBreadcrumb paths={paths} />
<CompaniesCrudTable data={tableData} estados={estados} client:load />
