---
import { getCompanyDetailData } from './services/get-company-detail-data';

import TabBar from '@components/navigation/TabBar.astro';
import CompanyEditForm from './components/CompanyEditForm.astro';
import CompanyOperationsPanel from '@modules/company-operations/OperationsPanel.astro';
import ActivityModal from './components/ActivityModal.astro';
import ManagerModal from './components/ManagerModal.astro';
import type { CompanyDetailData } from './types';
import {
	type DocumentDashboardRow,
	type DocumentRequestDashboardRow,
	type DocumentTypeLite,
	getDocumentRequestsForIncorporationCase,
	getDocumentTypesList,
	getDocumentsForIncorporationCase,
} from '@domains/documents/document_dashboard';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import DocumentRequestManager from '@modules/documents/islands/DocumentRequestManager';
import CompanyDocumentsUploadManager from '@modules/documents/islands/CompanyDocumentsUploadManager';
import { getUsStates } from './services/get-us-states';
import { canManageCompanyData, hasAnyRole, ROLE_GROUPS } from '@shared/roles';

const empresaId = String(Astro.props.empresaId ?? '');
const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];
const isStaff = hasAnyRole(userRoles, ROLE_GROUPS.INCORPORATION_ROUTE);
const canEditDetails = canManageCompanyData(userRoles);
const backPath = Astro.url.pathname;

let data: CompanyDetailData | null = null;
let documentRequests: DocumentRequestDashboardRow[] = [];
let documentTypes: DocumentTypeLite[] = [];
let documentsNew: DocumentDashboardRow[] = [];

if (empresaId) {
	data = await getCompanyDetailData(supabase, empresaId);
	const documentResults: [
		DocumentRequestDashboardRow[],
		DocumentTypeLite[],
		DocumentDashboardRow[],
	] = await Promise.all([
		getDocumentRequestsForIncorporationCase(supabaseAdmin, empresaId),
		getDocumentTypesList(supabaseAdmin),
		getDocumentsForIncorporationCase(
			supabaseAdmin,
			empresaId,
			userId,
			userRoles,
		),
	]);
	[documentRequests, documentTypes, documentsNew] = documentResults;
}

const us_states = await getUsStates(supabase);
const empresa = data?.empresa ?? null;

const socios = data?.socios ?? [];
const addresses = data?.addresses ?? [];
const companyMembers = data?.companyMembers ?? [];
const managers = data?.managers ?? [];
const actividades = data?.actividades ?? [];
const paises = data?.paises ?? [];
const empresaSafe = empresa as CompanyDetailData['empresa'];
const errorMessage = !empresaId
	? 'ID de empresa no valido'
	: !data
		? 'No se encontro esta empresa'
		: '';

const operationsTabs = [
	{
		id: 'operations',
		label: 'Tareas',
		icon: 'ri:survey-line',
		kind: 'panel' as const,
		active: true,
	},
	{
		id: 'contacts',
		label: 'Editar datos',
		icon: 'ri:edit-line',
		kind: 'panel' as const,
		active: false,
	},
	{
		id: 'requests',
		label: 'Solicitar documentos',
		icon: 'ri:file-list-3-line',
		kind: 'panel' as const,
		active: false,
	},
	{
		id: 'upload',
		label: 'Subir documentos',
		icon: 'ri:upload-cloud-2-line',
		kind: 'panel' as const,
		active: false,
	},
];
---

{
	errorMessage ? (
		<div class="mx-5 mt-5">
			<div class="rounded-lg border border-dashed border-gray-200 p-6 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">
				{errorMessage}
			</div>
		</div>
	) : (
		<>
			<div class="mx-5 mt-5">
				<TabBar buttons={operationsTabs} syncUrl={false} />

				<div data-tab-panel="operations" class="my-4">
					<CompanyOperationsPanel
						empresaId={empresaId}
						empresaNombre={empresaSafe?.nombre_1}
					/>
				</div>
				<div data-tab-panel="contacts" class="my-4" hidden>
					<CompanyEditForm
						empresa={empresaSafe}
						socios={socios}
						addresses={addresses}
						companyMembers={companyMembers}
						managers={managers}
						actividades={actividades}
						canEditDetails={canEditDetails}
						backPath={backPath}
						states={us_states}
					/>
				</div>
				<div data-tab-panel="requests" class="my-4" hidden>
					<DocumentRequestManager
						client:load
						incorporationCaseId={empresaId}
						backPath={backPath}
						documentTypes={documentTypes}
						requests={documentRequests}
					/>
				</div>
				<div data-tab-panel="upload" class="my-4" hidden>
					<CompanyDocumentsUploadManager
						client:load
						incorporationCaseId={empresaId}
						backPath={backPath}
						documentTypes={documentTypes}
						documents={documentsNew}
						isStaff={isStaff}
						sharedWithUserId={empresaSafe?.user_id ?? undefined}
					/>
				</div>
			</div>
			<ActivityModal />
			<ManagerModal empresaId={empresaId} paises={paises} />
		</>
	)
}

<script src="@third-party/alpinejs/alpine.js"></script>
