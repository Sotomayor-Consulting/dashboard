---
import TabBar from '@components/navigation/TabBar.astro';
import { getDocumentsForCompanyView } from '@domains/documents/document_dashboard';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import CompanyDocumentsDashboard from '@modules/documents/CompanyDocumentsDashboard.astro';
import CompanyDocumentsList from '@modules/documents/islands/CompanyDocumentsList';
import { companyClientTabs } from './company-tabs';

interface Props {
	companyId: string | undefined;
}

const { companyId } = Astro.props;
const user = Astro.locals.user;
const userId = user?.id;
const supabase = Astro.locals.supabase;
const userRoles = Astro.locals.userRoles ?? [];

if (!companyId || !userId) {
	return Astro.redirect('/');
}

// Ownership vía RLS de companies (dueño o staff).
const { data: company } = await supabase
	.from('companies')
	.select('id, legal_name, incorporation_id')
	.eq('id', companyId)
	.maybeSingle<{
		id: string;
		legal_name: string | null;
		incorporation_id: string | null;
	}>();

if (!company) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}

// Empresas sin caso de incorporación asociado (legacy o creadas directamente):
// sin incorporation_id el dashboard completo (solicitudes + por firmar) no
// aplica, así que mostramos solo la lista de documentos de la empresa.
const fallbackDocuments = !company.incorporation_id
	? await getDocumentsForCompanyView(
			supabaseAdmin,
			companyId,
			null,
			userId,
			userRoles,
		).catch(() => [])
	: [];

const tabs = companyClientTabs(companyId, 'documents');
---

<div>
	<TabBar buttons={tabs} />

	<div data-tab-panel="documents" class="mx-auto max-w-5xl px-4 pt-6 pb-12">
		{
			company.incorporation_id ? (
				<CompanyDocumentsDashboard
					incorporationCaseId={company.incorporation_id}
					companyId={companyId}
					dashboardVariant="client"
				/>
			) : (
				<CompanyDocumentsList
					documents={fallbackDocuments}
					canUseStaffActions={false}
					incorporationCaseId=""
					companyUserId={userId}
					isStaffDashboard={false}
					client:load
				/>
			)
		}
	</div>
</div>
