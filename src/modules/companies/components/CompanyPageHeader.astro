---
import { Icon } from 'astro-icon/components';
import type { CompanyItem, EntityType, LegalStatus } from '../types';

interface Props {
	company: CompanyItem;
	backHref: string | null;
	backLabel: string | null;
}

const { company, backHref, backLabel } = Astro.props;

const ENTITY_CLASS: Record<string, string> = {
	llc: 'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300',
	'c-corp':
		'bg-violet-50 text-violet-700 dark:bg-violet-950/40 dark:text-violet-300',
	lp: 'bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-300',
};

const STATUS_CLASS: Record<
	string,
	{ label: string; cls: string; dot: string }
> = {
	active: {
		label: 'Activa',
		cls: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400',
		dot: 'bg-emerald-500',
	},
	draft: {
		label: 'Borrador',
		cls: 'bg-gray-100 text-gray-600 dark:bg-neutral-800 dark:text-gray-400',
		dot: 'bg-gray-400',
	},
	pending: {
		label: 'Pendiente',
		cls: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400',
		dot: 'bg-amber-500',
	},
	pending_validation: {
		label: 'Pendiente validación',
		cls: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400',
		dot: 'bg-amber-500',
	},
	suspended: {
		label: 'Suspendida',
		cls: 'bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400',
		dot: 'bg-amber-500',
	},
	inactive: {
		label: 'Inactiva',
		cls: 'bg-gray-100 text-gray-600 dark:bg-neutral-800 dark:text-gray-400',
		dot: 'bg-gray-400',
	},
	dissolved: {
		label: 'Disuelta',
		cls: 'bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-400',
		dot: 'bg-red-500',
	},
};

const entityType = (company.entity_type ?? '').toLowerCase() as EntityType;
const legalStatus = (company.legal_status ?? 'draft').toLowerCase() as LegalStatus;
const entityCls =
	ENTITY_CLASS[entityType] ??
	'bg-gray-100 text-gray-600 dark:bg-neutral-800 dark:text-gray-400';
const status =
	STATUS_CLASS[legalStatus] ?? STATUS_CLASS['draft']!;
---

<header
	class="flex flex-col gap-3 border-b border-gray-200 px-7 pt-6 pb-5 dark:border-gray-800"
>
	{
		backHref && backLabel && (
			<a
				href={backHref}
				class="inline-flex w-fit items-center gap-1.5 text-[12.5px] text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
			>
				<Icon name="ri:arrow-left-line" class="h-4 w-4" />
				{backLabel}
			</a>
		)
	}

	<div class="flex items-end justify-between gap-4">
		<div class="min-w-0">
			<p
				class="text-[11.5px] font-semibold tracking-wider text-gray-500 uppercase dark:text-gray-400"
			>
				Empresa
			</p>
			<h1
				class="mt-1 truncate text-[22px] font-semibold text-gray-900 dark:text-gray-100"
			>
				{company.legal_name ?? 'Sin nombre'}
			</h1>
			<div class="mt-2 flex flex-wrap items-center gap-1.5">
				<span
					class:list={[
						'inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 text-[10.5px] font-medium',
						status.cls,
					]}
				>
					<span class:list={['h-1.5 w-1.5 rounded-full', status.dot]} />
					{status.label}
				</span>
				{
					entityType && (
						<span
							class:list={[
								'inline-flex items-center rounded-md px-2 py-0.5 text-[10.5px] font-semibold uppercase tracking-wide',
								entityCls,
							]}
						>
							{entityType.toUpperCase()}
						</span>
					)
				}
				{
					company.identification_number && (
						<span class="inline-flex items-center rounded-md bg-gray-100 px-2 py-0.5 text-[10.5px] font-medium text-gray-600 dark:bg-neutral-800 dark:text-gray-400">
							EIN {company.identification_number}
						</span>
					)
				}
			</div>
		</div>
	</div>
</header>
