<!-- Modal: Crear actividad -->
<div
	id="crud-modal"
	tabindex="-1"
	aria-hidden="true"
	class="fixed top-0 right-0 left-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0"
>
	<div class="relative max-h-full w-full max-w-md p-4">
		<div class="dark:bg-black-800 relative rounded-lg bg-white shadow-sm">
			<div
				class="flex items-center justify-between rounded-t-lg border-b border-gray-200 p-4 md:p-5 dark:border-gray-600"
			>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
					Crear nuevo registro de actividad
				</h3>
				<button
					type="button"
					class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					data-modal-toggle="crud-modal"
				>
					<svg
						class="h-3 w-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 14 14"
					>
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
					</svg>
					<span class="sr-only">Close modal</span>
				</button>
			</div>
			<form class="p-4 md:p-5">
				<div class="mb-4 grid grid-cols-2 gap-4">
					<div class="col-span-2">
						<label
							for="ActividadGeneral"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Actividad General</label
						>
						<input
							type="text"
							name="ActividadGeneral"
							id="ActividadGeneral"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							placeholder="Agricultura, silvicultura y pesca"
							required=""
						/>
					</div>
					<div class="col-span-2 sm:col-span-1">
						<label
							for="Tipo"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Tipo</label
						>
						<input
							type="text"
							name="Tipo"
							id="Tipo"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							placeholder="Minería"
							required=""
						/>
					</div>
					<div class="col-span-2 sm:col-span-1">
						<label
							for="Codigo"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Codigo</label
						>
						<input
							type="number"
							name="Codigo"
							id="Codigo"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							placeholder="115210"
							required=""
						/>
					</div>
					<div class="col-span-2">
						<label
							for="Actividad"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Actividad
						</label>
						<textarea
							id="Actividad"
							name="Actividad"
							rows="4"
							class="dark:bg-black-900 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-500 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500"
							placeholder="Actividades de procesamiento de transacciones financieras, reserva y cámara de compensación."
						></textarea>
					</div>
				</div>
				<button
					type="submit"
					class="inline-flex items-center rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
				>
					Añadir actividad
				</button>
			</form>
		</div>
	</div>
</div>
