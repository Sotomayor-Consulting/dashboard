---
import type { EmpresaDetail } from '../types';

interface Props {
	empresa: EmpresaDetail;
}

const { empresa } = Astro.props;
---

<div
	class="relative col-span-2 mb-2 flex h-full w-full flex-col gap-5 rounded-xl border border-gray-200 bg-white p-5 md:mb-0 lg:col-span-1 dark:border-neutral-700 dark:bg-transparent dark:text-neutral-300"
>
	<div class="flex">
		<p class="text-base font-bold text-neutral-500">Nombre de la empresa</p>

		<button
			data-popover-target="popover-description"
			data-popover-placement="bottom-end"
			type="button"
			><svg
				class="ms-2 h-4 w-4 text-neutral-500 hover:text-neutral-600"
				aria-hidden="true"
				fill="currentColor"
				viewBox="0 0 20 20"
				xmlns="http://www.w3.org/2000/svg"
				><path
					fill-rule="evenodd"
					d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
					clip-rule="evenodd"></path></svg
			><span class="sr-only">Mostrar información</span></button
		>
		<div
			data-popover
			id="popover-description"
			role="tooltip"
			class="invisible absolute z-10 inline-block w-72 rounded-lg border border-neutral-200 bg-white text-sm text-neutral-500 opacity-0 shadow-xs transition-opacity duration-300 dark:border-neutral-600 dark:bg-black dark:text-neutral-400"
		>
			<div class="space-y-2 p-3">
				<h3
					class="font-semibold text-neutral-900 dark:text-white"
					aria-label="¿Porque se muestra este nombre?"
				>
					¿Porque se muestra este nombre?
				</h3>
				<p>
					Este nombre corresponde al registro inicial realizado durante la
					creación de la empresa mediante el dashboard de Sotomayor Consulting.
					Existen dos denominaciones opcionales adicionales. En caso de requerir
					una edición por motivos operativos, es necesario verificar y
					contrastar la información con los documentos oficiales disponibles.
				</p>
			</div>
			<div data-popper-arrow></div>
		</div>
	</div>
	<div class="absolute right-5">
		{
			empresa.estado === 'Activo' ? (
				<span class="flex w-full items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/50 dark:text-green-300">
					<div class="mr-2 h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
					{empresa.estado}
				</span>
			) : (
				<span class="flex w-fit items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-orange-800 dark:bg-orange-900/50 dark:text-orange-300">
					<div class="mr-2 h-1.5 w-1.5 rounded-full bg-orange-500" />
					{empresa.estado}
				</span>
			)
		}
	</div>

	<div
		class="flex w-full items-center gap-10 text-neutral-800 dark:text-neutral-300"
	>
		<div class="flex h-full w-full gap-5">
			<div>
				<p class="text-base font-bold lg:text-4xl">
					{empresa.nombre_1} - {empresa.tipo_de_negocio}
				</p>
			</div>
		</div>
	</div>
</div>
