---
import InfoPopover from '@components/ui/InfoPopover.tsx';
import type { EmpresaDetail } from '../types';

interface Props {
	empresa: EmpresaDetail;
}

const { empresa } = Astro.props;
---

<div
	class="relative col-span-2 mb-2 flex h-full w-full flex-col gap-5 rounded-xl border border-gray-200 bg-white p-5 md:mb-0 lg:col-span-1 dark:border-neutral-700 dark:bg-transparent dark:text-neutral-300"
>
	<div class="flex">
		<p class="text-base font-bold text-neutral-500">Nombre de la empresa</p>

		<InfoPopover
			client:load
			title="¿Porque se muestra este nombre?"
			text="Este nombre corresponde al registro inicial realizado durante la creación de la empresa mediante el dashboard de Sotomayor Consulting. Existen dos denominaciones opcionales adicionales. En caso de requerir una edición por motivos operativos, es necesario verificar y contrastar la información con los documentos oficiales disponibles."
			iconClass="ms-2 text-neutral-500 hover:text-neutral-600"
		/>
	</div>
	<div class="absolute right-5">
		{
			empresa.estado === 'Activo' ? (
				<span class="flex w-full items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/50 dark:text-green-300">
					<div class="mr-2 h-1.5 w-1.5 animate-pulse rounded-full bg-green-400" />
					{empresa.estado}
				</span>
			) : (
				<span class="flex w-fit items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-orange-800 dark:bg-orange-900/50 dark:text-orange-300">
					<div class="mr-2 h-1.5 w-1.5 rounded-full bg-orange-500" />
					{empresa.estado}
				</span>
			)
		}
	</div>

	<div
		class="flex w-full items-center gap-10 text-neutral-800 dark:text-neutral-300"
	>
		<div class="flex h-full w-full gap-5">
			<div>
				<p class="text-base font-bold lg:text-4xl">
					{empresa.principal_name} - {empresa.tipo_de_negocio}
				</p>
			</div>
		</div>
	</div>
</div>
