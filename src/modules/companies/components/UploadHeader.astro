---
import type { EmpresaDetail } from '../types';

interface Props {
	empresa: EmpresaDetail;
}

const { empresa } = Astro.props;
---

<div
	class="to-black-600 from-black-900 col-span-1 items-center justify-between rounded-lg bg-white p-4 shadow-sm sm:flex sm:p-6 xl:col-span-2 2xl:col-span-1 2xl:col-start-1 dark:bg-linear-to-tl"
>
	<div class="w-full">
		<h3 class="text-base font-normal text-gray-500 dark:text-gray-400">
			Nombre de empresa
		</h3>
		<div class="w-full">
			<div class="relative">
				<h1 class="dark:text-white-50 text-white-900 text-2xl">
					{empresa.nombre_1}
				</h1>
			</div>
		</div>
		<p
			class="flex items-center text-base font-normal text-gray-500 dark:text-gray-400"
		>
			{empresa.tipo_de_negocio}
		</p>
	</div>
</div>
