---
import type { PaisItem } from '../types';

interface Props {
	empresaId: string;
	paises: PaisItem[];
}

const { empresaId, paises } = Astro.props;
---

<!-- Modal: Crear manager -->
<div
	id="crud-modal-2"
	tabindex="-1"
	aria-hidden="true"
	class="fixed top-0 right-0 left-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0"
>
	<div class="relative max-h-full w-full max-w-md p-4">
		<div class="dark:bg-black-800 relative rounded-lg bg-white shadow-sm">
			<div
				class="flex items-center justify-between rounded-t-lg border-b border-gray-200 p-4 md:p-5 dark:border-gray-600"
			>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
					Crear nuevo manager
				</h3>
				<button
					type="button"
					class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					data-modal-toggle="crud-modal-2"
				>
					<svg
						class="h-3 w-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 14 14"
					>
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
					</svg>
					<span class="sr-only">Close modal</span>
				</button>
			</div>
			<form class="p-4 md:p-5">
				<div class="mb-4 grid grid-cols-2 gap-4">
					<input
						type="text"
						id="añadir-manager-idempresa"
						name="añadir-manager-idempresa"
						hidden
						value={empresaId}
					/>
					<div class="col-span-2">
						<label
							for="Nombre-completo-manager"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Nombre completo</label
						>
						<input
							type="text"
							name="Nombre-completo-manager"
							id="Nombre-completo-manager"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							placeholder="Joe Due"
							required=""
						/>
					</div>
					<div class="col-span-2">
						<label
							for="correo-manager"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Correo</label
						>
						<input
							type="email"
							name="correo-manager"
							id="correo-manager"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							placeholder="correo@ejemplo.com"
							required
						/>
					</div>
					<div class="col-span-2">
						<label
							for="Pais-añadir-manager"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Pais</label
						>
						<select
							id="Pais-añadir-manager"
							name="Pais-añadir-manager"
							class="dark:bg-black-900 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500"
						>
							<option value="" disabled hidden selected>
								Seleccione un pais
							</option>

							{
								paises?.map((p) => (
									<option value={p.name}>{p.name}</option>
								))
							}
						</select>
					</div>

					<div class="col-span-2 sm:col-span-1">
						<label
							for="Numero-de-pasaporte-manager"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Numero de pasaporte</label
						>
						<input
							type="text"
							name="Numero-de-pasaporte-manager"
							id="Numero-de-pasaporte-manager"
							placeholder="Ej: A1234567"
							maxlength="20"
							pattern="[A-Za-z0-9]{6,20}"
							title="Ingresa tu número de pasaporte (letras y números, 6-20 caracteres)"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							required=""
						/>
					</div>
					<div class="col-span-2 sm:col-span-1">
						<label
							for="Numero-de-seguro-manager"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Numero de seguro social</label
						>
						<input
							type="text"
							name="Numero-de-seguro-manager"
							id="Numero-de-seguro-manager"
							placeholder="123456789"
							maxlength="9"
							pattern="\d{9}"
							title="9 dígitos sin espacios o guiones"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							required=""
						/>
					</div>
					<div class="col-span-2 sm:col-span-1">
						<label
							for="Numero-de-itin-manager"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Numero de ITIN</label
						>
						<input
							type="text"
							name="Numero-de-itin-manager"
							id="Numero-de-itin-manager"
							placeholder="9XX-XX-XXXX"
							maxlength="11"
							pattern="9\d{2}[\-]\d{2}[\-]\d{4}"
							title="Formato: 9XX-XX-XXXX (siempre comienza con 9)"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							required=""
						/>
					</div>
					<div class="col-span-2 sm:col-span-1">
						<label
							for="direccion-de-manager"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Direccion de manager</label
						>
						<input
							type="text"
							name="direccion-de-manager"
							id="direccion-de-manager"
							class="focus:ring-primary-600 focus:border-primary-600 dark:bg-black-900 dark:focus:ring-primary-500 dark:focus:border-primary-500 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-500 dark:text-white dark:placeholder-gray-400"
							placeholder="Av. ejemplo y Calle 123"
							required=""
						/>
					</div>
					<div class="col-span-2">
						<label class="inline-flex cursor-pointer items-center">
							<input
								type="checkbox"
								value=""
								class="peer sr-only"
								id="residente-manager-en-EEUU"
								name="residente-manager-en-EEUU"
							/>
							<div
								class="peer relative h-6 w-11 rounded-full bg-gray-200 peer-checked:bg-blue-600 peer-focus:ring-4 peer-focus:ring-blue-300 after:absolute after:inset-s-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white rtl:peer-checked:after:-translate-x-full dark:border-gray-600 dark:bg-gray-700 dark:peer-checked:bg-blue-600 dark:peer-focus:ring-blue-800"
							>
							</div>
							<span
								class="ms-3 text-sm font-medium text-gray-900 dark:text-gray-300"
								>¿Es Residente fiscal en EE.UU?</span
							>
						</label>
					</div>
					<div class="col-span-2">
						<label class="inline-flex cursor-pointer items-center">
							<input
								type="checkbox"
								value=""
								class="peer sr-only"
								id="manager_misma_direccion_empresa"
								name="manager_misma_direccion_empresa"
							/>
							<div
								class="peer relative h-6 w-11 rounded-full bg-gray-200 peer-checked:bg-blue-600 peer-focus:ring-4 peer-focus:ring-blue-300 after:absolute after:inset-s-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-[''] peer-checked:after:translate-x-full peer-checked:after:border-white rtl:peer-checked:after:-translate-x-full dark:border-gray-600 dark:bg-gray-700 dark:peer-checked:bg-blue-600 dark:peer-focus:ring-blue-800"
							>
							</div>
							<span
								class="ms-3 text-sm font-medium text-gray-900 dark:text-gray-300"
								>¿El manager tiene la misma direccion de la empresa?</span
							>
						</label>
					</div>
				</div>
				<button
					type="submit"
					class="inline-flex items-center rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
				>
					Añadir manager
				</button>
			</form>
		</div>
	</div>
</div>
