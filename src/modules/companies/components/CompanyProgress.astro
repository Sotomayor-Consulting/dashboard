---
import type { EmpresaDetail } from '../types';

interface Props {
	empresa: EmpresaDetail;
}

const { empresa } = Astro.props;
---

<div
	class="col-span-2 mb-2 flex h-full w-full flex-col justify-center gap-5 rounded-xl border border-gray-200 bg-white p-5 text-neutral-800 md:col-span-1 md:mb-0 dark:border-neutral-700 dark:bg-transparent dark:text-neutral-300"
>
	<div class="flex">
		<p class="text-base font-bold text-neutral-500">
			Porcentaje de incorporación
		</p>
	</div>

	<div class="flex items-center gap-10">
		<div class="dark:bg-primary-gold/20 bg-primary-gold/20 w-full rounded-full">
			<div
				class="bg-primary-gold dark:bg-primary-gold rounded-full p-1 text-center leading-none text-blue-100"
				style={`width: ${empresa.porcentaje_de_incorporacion}%`}
			>
			</div>
		</div><div class="flex flex-col gap-5">
			<div>
				<p class="text-2xl font-bold">
					{empresa.porcentaje_de_incorporacion}%
				</p>
			</div>
		</div>
	</div>
</div>
