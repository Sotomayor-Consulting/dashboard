---
import type { EmpresaDetail } from '../types';

interface Props {
	empresa: EmpresaDetail;
}

const { empresa } = Astro.props;
---

<div
	class="col-span-2 mb-2 flex h-full w-full flex-col justify-center gap-5 rounded-md bg-white p-14 text-neutral-800 md:col-span-1 md:mb-0 dark:bg-transparent dark:text-neutral-300"
>
	<div class="flex">
		<p class="text-base font-bold text-neutral-500">
			Porcentaje de incorporación
		</p>
	</div>

	<div class="flex items-center gap-10">
		<div class="flex flex-col gap-5">
			<div>
				<p class="text-4xl font-bold">
					{empresa.porcentaje_de_incorporacion}%
				</p>
			</div>
		</div>
		<div class="dark:bg-black-800 w-full rounded-full bg-white">
			<div
				class="rounded-full bg-[#8c681d] p-1 text-center leading-none text-blue-100 dark:bg-[#134aed]"
				style={`width: ${empresa.porcentaje_de_incorporacion}%`}
			>
			</div>
		</div>
	</div>
</div>
