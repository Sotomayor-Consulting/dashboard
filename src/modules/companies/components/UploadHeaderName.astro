---
import type { PagoPorLeer } from '../types';

interface Props {
	pagos: PagoPorLeer;
}

const { pagos } = Astro.props;
---

<div
	class="to-black-600 from-black-900 flex items-center justify-between rounded-lg bg-white p-4 shadow-sm sm:p-6 dark:bg-linear-to-tr"
>
	<div class="w-full">
		<h3 class="text-base font-normal text-gray-500 dark:text-gray-400">
			Creador de la empresa
		</h3>
		<div class="w-full">
			<div class="relative">
				<h1 class="dark:text-white-50 text-white-900 text-2xl">
					{pagos?.usuarios?.nombre}
					{pagos?.usuarios?.apellido}
				</h1>
			</div>
		</div>
		<p
			class="flex items-center text-base font-normal text-gray-500 dark:text-gray-400"
		>
			{pagos?.usuarios?.correo}
		</p>
	</div>
</div>
