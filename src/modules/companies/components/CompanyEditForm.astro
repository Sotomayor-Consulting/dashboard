---
import CompanyDetailsForm from '../islands/CompanyDetailsForm';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type {
	EmpresaDetail,
	SocioItem,
	ManagerItem,
	ActividadItem,
	EstadoItem,
} from '../types';

interface Props {
	empresa: EmpresaDetail;
	socios: SocioItem[];
	managers: ManagerItem[];
	actividades: ActividadItem[];
	estados: EstadoItem[];
	paises: PaisItem[];
	canEditDetails: boolean;
	backPath: string;
}

const {
	empresa,
	socios,
	managers,
	actividades,
	estados,
	canEditDetails,
	backPath,
	paises,
} = Astro.props;
---

<CompanyDetailsForm
	client:load
	empresa={empresa}
	socios={socios}
	managers={managers}
	actividades={actividades}
	estados={estados}
	canEditDetails={canEditDetails}
	backPath={backPath}
/>

<form action="" method="post">
	<div
		class="grid w-full space-x-0 rounded-lg p-0 md:grid-cols-[auto_1fr] md:space-x-4 md:p-4"
		id="contacts"
		role="tabpanel"
		aria-labelledby="contacts-tab"
		x-data="{
				formadeAdministracion: '',
				actvidadManual: null,
				RegistroManual: '',
				direccionOperativa: '',
				otrosMiembrosfuera: null,
				managerMiembro: '',
				asignarManager: '',
				tabManager: '',
				init() {
					const checkbox = document.querySelector('#otros-miembros-fuera-de-lista');
					if (checkbox) {
						this.actvidadManual = checkbox.checked;
					};
					const direccionop = document.querySelector('#direccionOperativa');
					if (direccionop) {
						this.direccionOperativa = direccionop.value
					};
					const administracion = document.querySelector('#forma_de_administrar');
					if (administracion) {
						this.formadeAdministracion = administracion.value
					};
					const manager = document.querySelector('#informacionmanager');
					if (manager) {
						this.managerMiembro = manager.value
					};
				}
			}"
		x-effect="if (!actvidadManual) {
				RegistroManual = '';
			}; if (asignarManager === 'Si') {
				 managerMiembro = '';
			}"
	>
		<!-- ── Edit sub-tab sidebar ──────────────────────────── -->
		<div class="mb-4 md:max-w-72 md:min-w-72 dark:border-gray-700">
			<ul
				class="flex-column to-black-600 from-black-900 space-y-5 rounded-lg p-5 text-sm font-medium text-gray-500 dark:bg-linear-to-tr dark:text-gray-400"
				id="default-tab-2"
				data-tabs-toggle="#default-tab-content-2"
				role="tablist"
				data-tabs-active-classes="text-white bg-blue-700 dark:bg-blue-600"
				data-tabs-inactive-classes="hover:text-gray-900 bg-gray-50 hover:bg-gray-100 dark:bg-black-900 dark:hover:bg-[#101521]/80 dark:hover:text-white"
			>
				<li>
					<div>
						<h5 class="text-lg">{empresa.nombre_1}</h5>
						<p class="font-light">navegacion de edicion</p>
					</div>
				</li>
				{
					[
						{
							id: 'generales-tab',
							tabs: 'generales',
							label: 'Generales',
							icono: 'ri:building-2-fill',
							condicion: 'activo',
						},
						{
							id: 'ubicacion-tab',
							tabs: 'ubicacion',
							label: 'Ubicacion',
							icono: 'ri:folder-user-fill',
							condicion: 'activo',
						},
						{
							id: 'socios-edit-tab',
							tabs: 'socios-edit',
							label: 'Socios',
							icono: 'ri:file-copy-2-fill',
							condicion: 'activo',
						},
						{
							id: 'manager-tab',
							tabs: 'manager',
							label: 'Manager',
							icono: 'ri:edit-fill',
							condicion: 'condicional',
						},
					].map((i) =>
						i.condicion === 'activo' ? (
							<li role="presentation">
								<button
									id={i.id}
									data-tabs-target={`#${i.tabs}`}
									type="button"
									role="tab"
									aria-controls={i.tabs}
									aria-selected="false"
									class="flex w-full items-center gap-2 rounded-lg p-4"
								>
									<Icon name={i.icono} class="text-lg" />
									{i.label}
								</button>
							</li>
						) : (
							<li role="presentation">
								<button
									id={i.id}
									data-tabs-target={`#${i.tabs}`}
									type="button"
									role="tab"
									x-model="tabManager"
									x-cloak
									x-show="formadeAdministracion === 'Member-Managed'"
									aria-controls={i.tabs}
									aria-selected="false"
									class="flex w-full items-center gap-2 rounded-lg p-4"
								>
									<Icon name={i.icono} class="text-lg" />
									{i.label}
								</button>
							</li>
						),
					)
				}
			</ul>
		</div>

		<!-- ── Edit sub-tab content ──────────────────────────── -->
		<div id="default-tab-content-2" class="ml-0 min-w-full">
			<!-- Sub-tab: Generales -->
			<div
				class="to-black-600 from-black-900 hidden rounded-lg bg-gray-50 p-4 dark:bg-linear-to-tr"
				id="generales"
				role="tabpanel"
				aria-labelledby="generales-tab"
			>
				<div class="dark:bg-black-900 w-full rounded-lg bg-white shadow">
					<div
						class="to-black-600 from-black-900 mb-4 min-w-full rounded-lg border border-neutral-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-neutral-700 dark:bg-linear-to-tr"
					>
						<h3 class="mb-4 text-xl font-semibold dark:text-white">
							Datos Generales
						</h3>

						<div class="grid grid-cols-6 gap-6">
							<div class="col-span-6 sm:col-span-3">
								<label
									for="Ingresos_de_EEUU"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
									>¿La LLC obtendrá ingresos provenientes de Estados Unidos?</label
								>
								<select
									name="Ingresos_de_EEUU"
									id="Ingresos_de_EEUU"
									class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
								>
									<option
										value=""
										disabled
										hidden
										selected={empresa.Obtendra_ingresos_desde_eeuu === null}
									>
										Seleccione una opción
									</option>
									<option
										value="true"
										selected={empresa.Obtendra_ingresos_desde_eeuu === true}
									>
										Sí
									</option>
									<option
										value="false"
										selected={empresa.Obtendra_ingresos_desde_eeuu === false}
									>
										No
									</option>
								</select>
							</div>

							<div class="col-span-6 flex items-end sm:col-span-3">
								<button
									type="button"
									data-modal-target="crud-modal"
									data-modal-toggle="crud-modal"
									class="flex items-center gap-2 rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
								>
									<Icon name="ri:add-line" /> Añadir actividad</button
								>
							</div>
							<div class="col-span-6 sm:col-span-3">
								<label
									for="actividad-input"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>
									Actividad
								</label>
								<input
									list="actividades-list"
									id="actividad-input"
									name="actividad"
									value={empresa.actividad}
									placeholder="Escribe para buscar actividad..."
									class="block w-full truncate rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
								/>

								<datalist id="actividades-list">
									{
										actividades?.map((ac) => (
											<option value={ac.Actividad}>{ac.Actividad}</option>
										))
									}
								</datalist>
							</div>

							<div class="col-span-6 sm:col-span-3">
								<label
									for="forma_de_administrar"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
									>Forma de administrar</label
								>
								<select
									name="forma_de_administrar"
									id="forma_de_administrar"
									x-model="formadeAdministracion"
									class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
								>
									<option
										value=""
										selected={!empresa.forma_administracion}
										hidden
										disabled>Seleccione una forma de tibutar</option
									>
									<option
										value="Member-Managed"
										selected={empresa.forma_administracion === 'Member-Managed'}
									>
										Member-Managed
									</option>
									<option
										value="Manager-Managed"
										selected={empresa.forma_administracion ===
											'Manager-Managed'}
									>
										Manager-Managed
									</option>
								</select>
							</div>
							<div class="col-span-6 sm:col-span-3">
								<label
									for="forma_de_tributar"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
									>Forma de tributar</label
								>
								<select
									name="forma_de_tributar"
									id="forma_de_tributar"
									class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
								>
									<option
										value=""
										hidden
										disabled
										selected={!empresa.forma_tributacion}
										>Seleccione una forma de tibutar</option
									>
									<option
										value="Entidad de paso"
										selected={empresa.forma_tributacion === 'Entidad de paso'}
									>
										Entidad de paso
									</option>
									<option
										value="Corporación"
										selected={empresa.forma_tributacion === 'Corporación'}
									>
										Corporación
									</option>
								</select>
							</div>
							<div class="col-span-6 sm:col-span-3">
								<label
									for="responsable_irs"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>
									Responsable frente al IRS
								</label>
								<select
									name="responsable_irs"
									id="responsable_irs"
									class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
								>
									<option
										value=""
										disabled
										hidden
										selected={!empresa.responsable_irs}
									>
										Seleccione una responsable
									</option>

									{
										socios?.map((s) => (
											<option
												value={s.nombre_de_socio}
												selected={s.nombre_de_socio === empresa.responsable_irs}
											>
												{s.nombre_de_socio}
											</option>
										))
									}
								</select>
							</div>

							<div class="col-span-12 sm:col-span-6">
								<label
									for="informacion_miembros"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
								>
									Informacion de los miembros
								</label>
								<select
									name="informacion_miembros"
									id="informacion_miembros"
									class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
								>
									<option
										value=""
										disabled
										hidden
										selected={!empresa.informacion_miembros}
									>
										Seleccione una opcion
									</option>

									<option
										value="Pública"
										selected={empresa.informacion_miembros === 'Pública'}
									>
										Pública
									</option>

									<option
										value="Privada"
										selected={empresa.informacion_miembros === 'Privada'}
									>
										Privada
									</option>
								</select>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Sub-tab: Ubicacion -->
			<div
				class="to-black-600 from-black-900 hidden min-w-full rounded-lg bg-gray-50 p-4 dark:bg-linear-to-tr"
				id="ubicacion"
				role="tabpanel"
				aria-labelledby="ubicacion-tab"
			>
				<div
					class="dark:bg-black-900 relative min-w-full rounded-lg bg-white shadow"
				>
					<div
						class="to-black-600 from-black-900 mb-4 min-w-full rounded-lg border border-neutral-200 bg-white p-4 shadow-sm sm:p-6 2xl:col-span-2 dark:border-neutral-700 dark:bg-linear-to-tr"
					>
						<h3 class="mb-4 text-xl font-semibold dark:text-white">
							Ubicacion
						</h3>

						<div class="grid grid-cols-6 gap-6">
							<div class="col-span-6 sm:col-span-3">
								<label
									for="direccionOperativa"
									class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
									>¿Tiene dirección operativa en EE.UU.?</label
								>
								<select
									name="direccionOperativa"
									id="direccionOperativa"
									x-model="direccionOperativa"
									class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
								>
									<option
										value="Si"
										selected={empresa.direccion_operativa_eeuu === 'Si'}
									>
										Sí
									</option>
									<option
										value="No"
										selected={empresa.direccion_operativa_eeuu === 'No'}
									>
										No
									</option>
									<option
										value="Quiero que Sotomayor Consulting International provea una dirección"
										selected={empresa.direccion_operativa_eeuu ===
											'Quiero que Sotomayor Consulting International provea una dirección'}
									>
										Quiero que Sotomayor Consulting International provea una
										dirección
									</option>
								</select>
							</div>

							<template x-if="direccionOperativa === 'Si'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="direccion"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
										>Dirección</label
									>
									<input
										type="text"
										name="direccion"
										id="direccion"
										class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#1349ec] focus:ring-[#1349ec] sm:text-sm dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
										value={empresa.direccion_eeuu}
										placeholder="ejem. Av. Juan Molineros"
									/>
								</div>
							</template>
							<template x-if="direccionOperativa === 'Si'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="condado"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
										>Condado</label
									>
									<input
										type="text"
										name="condado"
										id="condado"
										value={empresa.condado_eeuu}
										class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#1349ec] focus:ring-[#1349ec] sm:text-sm dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
										placeholder="ejem. Miami-Dade"
									/>
								</div>
							</template>
							<template x-if="direccionOperativa === 'Si'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="ciudad"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
										>Ciudad</label
									>
									<input
										type="text"
										name="ciudad"
										id="ciudad"
										value={empresa.ciudad_eeuu}
										class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#1349ec] focus:ring-[#1349ec] sm:text-sm dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
										placeholder="ejem. Miami"
									/>
								</div>
							</template>
							<template x-if="direccionOperativa === 'Si'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="estado"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
										>Estado</label
									>
									<select
										name="estado"
										id="estado"
										class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
									>
										<option
											value=""
											disabled
											hidden
											selected={!empresa.estado_eeuu}
										>
											Seleccione un estado
										</option>

										{
											estados?.map((e) => (
												<option
													value={e.Estado}
													selected={e.Estado === empresa.estado_eeuu}
												>
													{e.Estado}
												</option>
											))
										}
									</select>
								</div>
							</template>
							<template x-if="direccionOperativa === 'Si'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="Codigo_postal"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
										>Codigo Postal</label
									>
									<input
										type="text"
										name="Codigo_postal"
										id="Codigo_postal"
										value={empresa.codigo_postal_eeuu}
										class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#1349ec] focus:ring-[#1349ec] sm:text-sm dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
										placeholder="ejem. Miami-Dade"
									/>
								</div>
							</template>

							<template x-if="direccionOperativa === 'No'"
								><div class="col-span-6 sm:col-span-3">
									<label
										for="Pais_operativo"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
										>Pais</label
									>
									<select
										name="Pais_operativo"
										id="Pais_operativo"
										class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-sm text-neutral-900 focus:border-[#1349ec] focus:ring-[#1349ec] dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
									>
										<option
											value=""
											disabled
											hidden
											selected={!empresa.Pais_operativo}
										>
											Seleccione un pais
										</option>

										{
											paises?.map((p) => (
												<option
													value={p.name}
													selected={p.name === empresa.Pais_operativo}
												>
													{p.name}
												</option>
											))
										}
									</select>
								</div>
							</template>

							<template x-if="direccionOperativa === 'No'">
								<div class="col-span-6 sm:col-span-3">
									<label
										for="direccion_empresa"
										class="mb-2 block text-sm font-medium text-neutral-900 dark:text-white"
										>Dirección Empresa</label
									>
									<input
										type="text"
										name="direccion_empresa"
										id="direccion_empresa"
										value={empresa.direccion_empresa}
										class="block w-full rounded-lg border border-neutral-300 bg-neutral-50 p-2.5 text-neutral-900 shadow-sm focus:border-[#1349ec] focus:ring-[#1349ec] sm:text-sm dark:border-neutral-600 dark:bg-[#101522] dark:text-white dark:placeholder-neutral-400 dark:focus:border-[#1349ec] dark:focus:ring-[#323f67]"
										placeholder="Av. Juan Molineros"
									/>
								</div>
							</template>
						</div>
					</div>
				</div>
			</div>

			<!-- Sub-tab: Socios -->
			<div
