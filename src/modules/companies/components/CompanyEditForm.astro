---
import CompanyDetailsForm from '../islands/CompanyDetailsForm';
import type {
	EmpresaDetail,
	CompanyAddressItem,
	CompanyMemberItem,
	SocioItem,
	ManagerItem,
	ActividadItem,
	State,
} from '../types';

interface Props {
	empresa: EmpresaDetail;
	socios: SocioItem[];
	addresses: CompanyAddressItem[];
	companyMembers: CompanyMemberItem[];
	managers: ManagerItem[];
	actividades: ActividadItem[];
	canEditDetails: boolean;
	backPath: string;
	states: State[];
}

const {
	empresa,
	socios,
	addresses,
	companyMembers,
	managers,
	actividades,
	canEditDetails,
	backPath,
	states,
} = Astro.props;
---

<CompanyDetailsForm
	client:load
	empresa={empresa}
	socios={socios}
	addresses={addresses}
	companyMembers={companyMembers}
	managers={managers}
	actividades={actividades}
	canEditDetails={canEditDetails}
	backPath={backPath}
	states={states}
/>
