---
import CompanyDetailsForm from '../islands/CompanyDetailsForm';
import type {
	EmpresaDetail,
	CanonicalCompanyItem,
	CompanyAddressItem,
	CompanyMemberItem,
	ManagerItem,
	State,
} from '../types';

interface Props {
	empresa: EmpresaDetail;
	canonicalCompany: CanonicalCompanyItem | null;
	addresses: CompanyAddressItem[];
	companyMembers: CompanyMemberItem[];
	managers: ManagerItem[];
	canEditDetails: boolean;
	backPath: string;
	states: State[];
}

const {
	empresa,
	canonicalCompany,
	addresses,
	companyMembers,
	managers,
	canEditDetails,
	backPath,
	states,
} = Astro.props;
---

<CompanyDetailsForm
	client:load
	empresa={empresa}
	canonicalCompany={canonicalCompany}
	addresses={addresses}
	companyMembers={companyMembers}
	managers={managers}
	canEditDetails={canEditDetails}
	backPath={backPath}
	states={states}
/>
