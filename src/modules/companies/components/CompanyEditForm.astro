---
import CompanyDetailsForm from '../islands/CompanyDetailsForm';
import type { CompanyItem, EmpresaDetail, State } from '../types';

interface Props {
	empresa: EmpresaDetail;
	company: CompanyItem | null;
	canEditDetails: boolean;
	states: State[];
}

const { empresa, company, canEditDetails, states } = Astro.props;
---

<CompanyDetailsForm
	client:load
	empresa={empresa}
	company={company}
	canEditDetails={canEditDetails}
	states={states}
/>
