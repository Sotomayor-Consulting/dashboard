---
interface Props {
	incorporationId: string;
}

const { incorporationId } = Astro.props;
---

<div class="flex flex-col items-center justify-center py-20 text-center">
	<div class="bg-muted flex h-16 w-16 items-center justify-center rounded-full">
		<svg
			class="text-muted-foreground h-8 w-8"
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
			stroke-width="1.5"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21"
			></path>
		</svg>
	</div>
	<h3 class="text-foreground mt-4 text-lg font-semibold">
		Empresa aún no constituida
	</h3>
	<p class="text-muted-foreground mt-1 max-w-sm text-sm">
		Tu empresa se encuentra en proceso de incorporación. Una vez completado el
		proceso, aquí podrás ver toda la información de tu empresa constituida.
	</p>
	<a
		href={`/my-companies/${incorporationId}/dashboard`}
		class="border-border text-foreground hover:bg-muted mt-6 inline-flex items-center gap-2 rounded-lg border px-4 py-2.5 text-sm font-medium transition-colors"
	>
		Ver proceso de incorporación
	</a>
</div>
