---
import { Icon } from 'astro-icon/components';
import { STAGE_REGISTRY, isKnownStage } from './stages/registry.ts';
import type { MeetingData, StageItem } from './stages/types';

interface Props {
	stages: StageItem[];
	completedCount: number;
	totalCount: number;
	progressPercent: number;
	empresaId: string;
	userId: string;
	meeting?: MeetingData | null;
	lockedStages?: { name: string; slug: string }[];
}

const {
	stages,
	completedCount,
	totalCount,
	progressPercent,
	empresaId,
	userId,
	meeting,
	lockedStages = [],
} = Astro.props;

const LOCKED_STAGE_ICONS: Record<string, string> = {
	boir_registration: 'ri:government-line',
	bank_account: 'ri:bank-line',
	stripe_account: 'ri:bank-card-line',
	tax_election_8832: 'ri:file-text-line',
	be13: 'ri:file-chart-line',
	fiscal_documents: 'ri:file-shield-2-line',
	document_signing: 'ri:quill-pen-line',
	ein_request: 'ri:hashtag',
	state_registration: 'ri:building-line',
	planning_meeting: 'ri:calendar-check-line',
	client_form: 'ri:survey-line',
};

const isAllDone = progressPercent >= 100;
---

<section>
	<div
		class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
	>
		<div>
			<h2
				class="text-foreground text-xl font-semibold tracking-tight sm:text-2xl"
			>
				Proceso de incorporación
			</h2>
			<p class="text-muted-foreground mt-1 text-sm">
				Sigue el avance etapa por etapa de tu empresa.
			</p>
		</div>
		<div class="flex items-center gap-3">
			<div class="text-muted-foreground flex items-center gap-1.5 text-sm">
				<Icon name="ri:check-double-line" class="h-4 w-4" />
				<span class="font-medium tabular-nums">
					{completedCount}<span class="text-muted-foreground/60"
						>/{totalCount}</span
					>
				</span>
			</div>
			<div class="bg-border h-4 w-px"></div>
			<span
				class:list={[
					'rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums',
					isAllDone
						? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300'
						: 'bg-primary/10 text-primary',
				]}
			>
				{progressPercent}%
			</span>
		</div>
	</div>

	<!-- Segmented progress bar -->
	<div class="mb-8 flex gap-1">
		{
			stages.map((stage) => (
				<div
					class:list={[
						'h-1.5 flex-1 rounded-full',
						stage.status === 'completed' && 'bg-emerald-500',
						stage.status === 'in_progress' && 'bg-primary',
						stage.status === 'waiting' && 'bg-amber-400',
						stage.status === 'pending' && 'bg-muted',
					]}
				/>
			))
		}
	</div>

	<!-- Stages list -->
	<div class="divide-y divide-border -mx-6 border-t border-border">
		{
			stages.map((stage) => {
				if (!isKnownStage(stage.slug)) return null;
				const StageComponent = STAGE_REGISTRY[stage.slug];
				return (
					<StageComponent
						stage={stage}
						empresaId={empresaId}
						userId={userId}
						meeting={stage.slug === 'planning_meeting' ? meeting : null}
					/>
				);
			})
		}
	</div>

	{lockedStages.length > 0 && (
		<div class="relative -mx-6 overflow-hidden">
			<!-- Blurred locked stages -->
			<div class="select-none blur-[2px]">
				<div class="divide-y divide-border/40 border-t border-border/40">
					{lockedStages.map((stage) => (
						<div class="flex items-center gap-4 px-6 py-5 opacity-50">
							<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-border bg-card">
								<Icon name={LOCKED_STAGE_ICONS[stage.slug] || 'ri:lock-line'} class="h-5 w-5 text-muted-foreground" />
							</div>
							<div class="flex-1 min-w-0">
								<p class="text-sm font-medium text-foreground">{stage.name}</p>
							</div>
							<span class="rounded-full bg-muted px-2.5 py-1 text-xs text-muted-foreground">
								Por completar
							</span>
						</div>
					))}
				</div>
			</div>

			<!-- Overlay with lock + CTA -->
			<div class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-background/60 backdrop-blur-[1px]">
				<div class="flex h-12 w-12 items-center justify-center rounded-full border border-border bg-card">
					<Icon name="ri:lock-line" class="h-5 w-5 text-muted-foreground" />
				</div>
				<p class="mt-3 text-sm font-medium text-foreground">
					Desbloquea {lockedStages.length} etapas adicionales
				</p>
				<p class="mt-1 text-xs text-muted-foreground">
					Accede a todos los servicios para tu LLC con el upgrade.
				</p>
				<a
					href="/upgrade"
					class="mt-4 inline-flex items-center rounded-lg bg-primary-gold px-4 py-2.5 text-sm font-semibold text-primary-black transition-all hover:brightness-105 active:scale-[0.98]"
				>
					Desbloquear beneficios
				</a>
			</div>
		</div>
	)}
</section>
