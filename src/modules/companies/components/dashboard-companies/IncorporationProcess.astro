---
import { STAGE_REGISTRY, isKnownStage } from './stages/registry.ts';
import type { MeetingData, StageItem } from './stages/types';

interface Props {
	stages: StageItem[];
	completedCount: number;
	totalCount: number;
	progressPercent: number;
	empresaId: string;
	userId: string;
	meeting?: MeetingData | null;
}

const {
	stages,
	completedCount,
	totalCount,
	progressPercent,
	empresaId,
	userId,
	meeting,
} = Astro.props;
---

<div
	class="rounded-lg border border-gray-200 bg-white p-4 shadow-md shadow-gray-200/70 sm:p-6 2xl:col-span-2 dark:border-gray-700 dark:bg-transparent dark:shadow-none"
>
	<div
		class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"
	>
		<div>
			<h2 class="text-xl font-semibold text-gray-900 dark:text-white">
				Proceso de incorporación
			</h2>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
				Sigue el avance etapa por etapa de tu empresa.
			</p>
		</div>
		<div class="flex items-center gap-2">
			<span
				class="dark:bg-primary-gold rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700 dark:text-white"
			>
				{completedCount}/{totalCount} completadas
			</span>
			<span
				class="dark:bg-primary-gold/20 rounded-md bg-[#e8efff] px-2 py-1 text-xs font-semibold text-[#134aed] dark:text-amber-100"
			>
				{progressPercent}%
			</span>
		</div>
	</div>

	<div class="px-1 pb-1">
		<ol class="relative border-s border-gray-200 pl-1 dark:border-gray-700">
			{
				stages.map((stage) => {
					if (!isKnownStage(stage.slug)) return null;
					const StageComponent = STAGE_REGISTRY[stage.slug];
					return (
						<StageComponent
							stage={stage}
							empresaId={empresaId}
							userId={userId}
							meeting={stage.slug === 'planning_meeting' ? meeting : null}
						/>
					);
				})
			}
		</ol>
	</div>
</div>
