---
import { STAGE_REGISTRY, isKnownStage } from './stages/registry.ts';
import type { MeetingData, StageItem } from './stages/types';

interface Props {
	stages: StageItem[];
	completedCount: number;
	totalCount: number;
	progressPercent: number;
	empresaId: string;
	userId: string;
	meeting?: MeetingData | null;
}

const {
	stages,
	completedCount,
	totalCount,
	progressPercent,
	empresaId,
	userId,
	meeting,
} = Astro.props;
---

<div class="2xl:col-span-2">
	<div
		class="section-header flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"
	>
		<div>
			<h2 class="section-title">Proceso de incorporación</h2>
			<p class="section-description">
				Sigue el avance etapa por etapa de tu empresa.
			</p>
		</div>
		<div class="flex items-center gap-2">
			<span
				class="rounded-md bg-muted px-2 py-1 text-xs font-medium text-foreground"
			>
				{completedCount}/{totalCount} completadas
			</span>
			<span
				class="badge-status rounded-md bg-accent-gold/10 text-accent-gold"
			>
				{progressPercent}%
			</span>
		</div>
	</div>

	<div class="flat-card p-4 sm:p-6">
		<ol class="relative border-s border-border pl-1">
			{
				stages.map((stage) => {
					if (!isKnownStage(stage.slug)) return null;
					const StageComponent = STAGE_REGISTRY[stage.slug];
					return (
						<StageComponent
							stage={stage}
							empresaId={empresaId}
							userId={userId}
							meeting={stage.slug === 'planning_meeting' ? meeting : null}
						/>
					);
				})
			}
		</ol>
	</div>
</div>
