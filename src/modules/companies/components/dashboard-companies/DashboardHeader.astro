---
import { Icon } from 'astro-icon/components';

interface Props {
	empresa: {
		principal_name: string;
		tipo_de_negocio: string;
		estado_de_incorporacion: string;
		state?: string;
		ein?: string | null;
		numero_ein?: string | null;
		ein_number?: string | null;
		tax_id?: string | null;
		tin?: string | null;
	};
	upgradeAvailable?: boolean;
	upgradePrice?: number | null;
	pendingDocuments?: number;
	pendingProcesses?: number;
}

const {
	empresa,
	upgradeAvailable = false,
	upgradePrice = null,
	pendingDocuments = 0,
	pendingProcesses = 0,
} = Astro.props;

const fmtUsd = (n: number | null | undefined) =>
	typeof n === 'number' && !Number.isNaN(n)
		? new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				maximumFractionDigits: 0,
			}).format(n)
		: null;

const upgradePriceLabel = fmtUsd(upgradePrice);

---

{
	upgradeAvailable && (
		<div class="-mx-6 mt-6 bg-amber-50/40 px-6 py-4 dark:bg-amber-500/5">
			<div class="flex items-center gap-3.5">
				<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-amber-200 bg-amber-100/80 dark:border-amber-500/30 dark:bg-amber-500/15">
					<Icon name="ri:arrow-up-circle-line" class="h-4.5 w-4.5 text-amber-600 dark:text-amber-400" />
				</div>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-semibold text-amber-950 dark:text-amber-50">
						Lleva tu LLC al siguiente nivel
					</p>
					<p class="mt-0.5 text-xs text-amber-800/70 dark:text-amber-200/60">
						Cuenta bancaria, pasarela de cobros, optimización fiscal y más.
					</p>
				</div>
				{upgradePriceLabel && (
					<div class="shrink-0 text-right">
						<p class="text-lg font-bold tracking-tight text-amber-950 dark:text-amber-50">{upgradePriceLabel}</p>
						<p class="text-[11px] text-amber-700/70 dark:text-amber-300/50">pago único</p>
					</div>
				)}
				<a
					href="/upgrade"
					class="shrink-0 inline-flex items-center rounded-lg bg-primary-gold px-4 py-2.5 text-sm font-semibold text-primary-black transition-all hover:brightness-105 active:scale-[0.98]"
				>
					Desbloquear beneficios
				</a>
			</div>
		</div>
		<div class="-mx-6 mt-4 border-b border-border" />
	)
}

<div class="mt-6 mb-2">
	<h2 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
		{empresa.principal_name}
	</h2>
</div>

<!-- Inline stats -->
<div class="-mx-6 mt-4 mb-6 flex flex-wrap gap-6 border-b border-border px-6 pb-6">
	<div class="flex items-center gap-2.5">
		<div class="flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-card">
			<Icon name="ri:loader-3-line" class="h-4 w-4 text-muted-foreground" />
		</div>
		<div>
			<p class="text-lg font-semibold leading-none text-foreground">{pendingProcesses}</p>
			<p class="text-xs text-muted-foreground">Etapas pendientes</p>
		</div>
	</div>
	<div class="flex items-center gap-2.5">
		<div class="flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-card">
			<Icon name="ri:file-copy-line" class="h-4 w-4 text-muted-foreground" />
		</div>
		<div>
			<p class="text-lg font-semibold leading-none text-foreground">{pendingDocuments}</p>
			<p class="text-xs text-muted-foreground">Documentos por firmar</p>
		</div>
	</div>
</div>
