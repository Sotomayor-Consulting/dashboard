---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import AppSciLogo from '@assets/isotipo-re.png';

// Ruta
// C:\Users\Juan Diego Gualotuna\DevWorkSpace\dashboard\src\assets\avatarSCI.png

interface Props {
	empresa: {
		nombre_1: string;
		tipo_de_negocio: string;
		porcentaje_de_incorporacion: number;
		estado_de_incorporacion: string;
		estado?: string;
		ein?: string | null;
		numero_ein?: string | null;
		ein_number?: string | null;
		tax_id?: string | null;
		tin?: string | null;
	};
	progressPercent?: number;
	planName?: string;
	completedStages?: number;
	totalStages?: number;
	currentStageName?: string | null;
	currentStageOrder?: number | null;
	estimatedCompletion?: string | null;
	nextStageName?: string | null;
	upgradeAvailable?: boolean;
	upgradePrice?: number | null;
}

const {
	empresa,
	progressPercent = empresa.porcentaje_de_incorporacion,
	planName = 'Plan Business',
	completedStages = 0,
	totalStages = 0,
	currentStageName = null,
	currentStageOrder = null,
	estimatedCompletion = null,
	nextStageName = null,
	upgradeAvailable = false,
	upgradePrice = null,
} = Astro.props;

const daysRemaining = (() => {
	if (!estimatedCompletion) return null;
	const end = new Date(estimatedCompletion).getTime();
	if (Number.isNaN(end)) return null;
	const diff = end - Date.now();
	return Math.max(0, Math.ceil(diff / (1000 * 60 * 60 * 24)));
})();

const miamiWeekday = new Intl.DateTimeFormat('en-US', {
	timeZone: 'America/New_York',
	weekday: 'short',
}).format(new Date());

const miamiHour = Number(
	new Intl.DateTimeFormat('en-US', {
		timeZone: 'America/New_York',
		hour: '2-digit',
		hour12: false,
	}).format(new Date()),
);

const isBusinessWeekday = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].includes(
	miamiWeekday,
);
const isAdvisorOnline = isBusinessWeekday && miamiHour >= 8 && miamiHour < 17;

const rawEin =
	empresa.ein ??
	empresa.numero_ein ??
	empresa.ein_number ??
	empresa.tax_id ??
	empresa.tin ??
	null;

const maskedEin = (() => {
	if (!rawEin) return null;
	const digits = rawEin.replace(/\D/g, '');
	if (digits.length >= 4)
		return `${digits.slice(0, 2)}-${digits.slice(2, 4)}*****`;
	if (digits.length >= 2) return `${digits.slice(0, 2)}-*****`;
	return `${rawEin.slice(0, 2)}***`;
})();

const einDisplayValue =
	maskedEin ?? (import.meta.env.DEV ? '12-34*****' : null);

const fmtUsd = (n: number | null | undefined) =>
	typeof n === 'number' && !Number.isNaN(n)
		? new Intl.NumberFormat('en-US', {
				style: 'currency',
				currency: 'USD',
				maximumFractionDigits: 0,
			}).format(n)
		: null;

const planLabelShort = planName.replace(/^Plan\s+/i, '').trim();
const upgradePriceLabel = fmtUsd(upgradePrice);
---

{
	upgradeAvailable && (
		<div class="dark:via-black-900 mt-4 overflow-hidden rounded-xl border bg-linear-to-r shadow-md dark:border-gray-700 dark:bg-transparent dark:shadow-none">
			<div class="flex flex-col items-stretch gap-3 p-3 sm:p-4 md:flex-row md:items-center md:gap-4">
				<div class="flex flex-1 items-center gap-3">
					<span class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-500/15 text-amber-600 sm:inline-flex dark:text-amber-300">
						<Icon name="ri:star-fill" class="h-5 w-5" />
					</span>
					<div class="min-w-0">
						<p class="text-[11px] font-semibold tracking-[0.18em] text-amber-700 uppercase dark:text-amber-300">
							Plan {planLabelShort} · Etapa 1 completada
						</p>
						<p class="mt-0.5 truncate text-sm text-gray-700 dark:text-gray-200">
							Continúa a{' '}
							<span class="font-semibold text-gray-900 dark:text-white">
								{nextStageName ? `Plan ${nextStageName}` : 'Plan Business'}
							</span>
						</p>
					</div>
				</div>
				<div class="flex items-center justify-between gap-3 md:justify-end">
					<a
						href="/upgrade"
						class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-gray-300 bg-transparent px-4 py-2 text-sm font-semibold text-black hover:bg-gray-50 dark:border-[#b98d33] dark:text-white dark:hover:bg-gray-800"
					>
						<Icon name="ri:bank-card-line" class="h-4 w-4" />
						Pagar upgrade
						{upgradePriceLabel && (
							<span class="opacity-90">· {upgradePriceLabel}</span>
						)}
						<Icon name="ri:arrow-right-line" class="h-4 w-4" />
					</a>
				</div>
			</div>
		</div>
	)
}

<div class="my-4 grid w-full grid-cols-1 gap-4 xl:grid-cols-2">
	<div
		class="overflow-hidden rounded-xl border border-gray-200 shadow-md shadow-gray-200/70 dark:border-gray-700 dark:shadow-none"
	>
		<div class="bg-white p-5 sm:p-6 dark:bg-transparent">
			<div
				class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start"
			>
				<div class="min-w-0">
					<div class="flex items-start gap-4">
						<div class="min-w-0">
							<div class="mb-2 inline-flex items-center gap-2">
								<Icon name="ri:star-fill" class="h-3.5 w-3.5 text-amber-500" />
								<span
									class="line-clamp-1 max-w-full text-sm font-semibold tracking-wide wrap-anywhere text-amber-600 uppercase dark:text-amber-300"
								>
									{planName}
								</span>
							</div>
							<h2
								class="line-clamp-2 text-2xl leading-tight font-semibold tracking-tight wrap-anywhere text-gray-900 sm:text-3xl dark:text-white"
							>
								{empresa.nombre_1}
							</h2>
							<div
								class="mt-2 flex flex-wrap items-center gap-3 text-sm text-gray-600 dark:text-gray-300"
							>
								<span
									class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-300"
								>
									<Icon name="ri:briefcase-3-line" class="h-4 w-4" />
									{empresa.tipo_de_negocio || 'No definido'}
								</span>
								<span
									class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-300"
								>
									<Icon name="ri:map-pin-line" class="h-4 w-4" />
									{empresa.estado_de_incorporacion}
								</span>
								{
									einDisplayValue && (
										<span class="inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-700 dark:bg-neutral-900 dark:text-gray-200">
											<Icon name="ri:shield-keyhole-line" class="h-3.5 w-3.5" />
											EIN: {einDisplayValue}
											<button
												type="button"
												title="Copiar EIN"
												class="dark:hover:bg-black-600 inline-flex h-5 w-5 items-center justify-center rounded transition-colors hover:bg-gray-200"
											>
												<Icon name="ri:file-copy-line" class="h-3.5 w-3.5" />
											</button>
											{!maskedEin && import.meta.env.DEV && (
												<span class="text-2xs rounded bg-amber-100 px-1 py-0.5 font-bold text-amber-700 dark:bg-amber-500/20 dark:text-amber-300">
													Demo
												</span>
											)}
										</span>
									)
								}
							</div>
						</div>
					</div>

					<div
						class="mt-8 rounded-xl border border-gray-200 bg-gray-50 p-4 lg:mt-14 dark:border-gray-700 dark:bg-transparent"
					>
						<div class="flex items-center justify-between">
							<span class="text-sm font-medium text-gray-700 dark:text-gray-200"
								>Progreso de incorporación</span
							>
							<span class="text-2xl font-bold text-gray-900 dark:text-white"
								>{progressPercent}%</span
							>
						</div>
						<div
							class="mt-3 h-2 overflow-hidden rounded-full bg-gray-200 dark:bg-white/10"
						>
							<div
								class="h-full rounded-full bg-[#134aed] transition-all"
								style={`width: ${progressPercent}%`}
							>
							</div>
						</div>
						<div
							class="mt-2 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400"
						>
							<span>{completedStages} de {totalStages} etapas completadas</span>
							{
								nextStageName ? (
									<>
										Siguiente:{' '}
										<span class="font-semibold text-gray-700 dark:text-gray-200">
											{nextStageName}
										</span>
									</>
								) : daysRemaining !== null ? (
									<span class="inline-flex items-center gap-1">
										<Icon name="ri:time-line" class="h-3 w-3" />
										{daysRemaining} días restantes
									</span>
								) : null
							}
						</div>
					</div>
				</div>

				<div class="w-full space-y-4 lg:w-72 lg:min-w-72 lg:justify-self-end">
					<div
						class="rounded-xl border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-transparent"
					>
						<p
							class="mb-2 text-xs tracking-wider text-gray-500 uppercase dark:text-gray-400"
						>
							Etapa actual
						</p>
						<div class="flex items-center gap-3">
							<div
								class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-500/20"
							>
								<Icon
									name="ri:time-line"
									class="h-5 w-5 text-amber-600 dark:text-amber-300"
								/>
							</div>
							<div class="min-w-0">
								<p
									class="truncate text-sm font-medium text-gray-900 dark:text-white"
								>
									{currentStageName || 'Pendiente de iniciar'}
								</p>
								<p class="text-xs text-gray-500 dark:text-gray-400">
									Etapa {currentStageOrder || '-'} de {totalStages || '-'}
								</p>
							</div>
						</div>
					</div>

					<div
						class="rounded-xl border border-gray-200 bg-gray-50 p-4 dark:border-gray-700 dark:bg-transparent"
					>
						<p
							class="mb-2 text-xs tracking-wider text-gray-500 uppercase dark:text-gray-400"
						>
							Tu asesor
						</p>
						<div class="flex items-center gap-3">
							<div
								class="relative flex h-10 w-10 items-center justify-center rounded-full border-2 border-gray-200 bg-[#eef3ff] text-sm font-semibold text-[#134aed] dark:border-white/30 dark:bg-white/20 dark:text-white"
							>
								<Image
									src={AppSciLogo}
									alt="Asesor de incorporación"
									class="h-8 w-8 rounded-full object-cover"
								/>
								<span
									class="dark:bg-black-900/80 absolute -right-0.5 -bottom-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full bg-white"
								>
									<span
										class={`absolute inline-flex h-2.5 w-2.5 animate-[ping_2.2s_ease-out_infinite] rounded-full opacity-45 ${isAdvisorOnline ? 'bg-emerald-300' : 'bg-amber-300'}`}
									></span>
									<span
										class={`relative inline-flex h-2 w-2 rounded-full ${isAdvisorOnline ? 'bg-emerald-500' : 'bg-amber-500'}`}
									></span>
								</span>
							</div>
							<div class="min-w-0 flex-1">
								<p
									class="truncate text-sm font-medium text-gray-900 dark:text-white"
								>
									Sotomayor Consulting
								</p>
								<div class="flex items-center gap-2 text-xs">
									<p class="text-gray-500 dark:text-gray-400">
										Equipo de soporte
									</p>
									<span
										class={`inline-flex items-center rounded-full px-1.5 py-0.5 font-medium ${
											isAdvisorOnline
												? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300'
												: 'bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300'
										}`}
									>
										{isAdvisorOnline ? 'En linea' : 'Offline'}
									</span>
								</div>
							</div>
						</div>
						<div class="mt-3 grid grid-cols-2 gap-2">
							<div
								class="group relative"
								title={!isAdvisorOnline
									? 'Fuera de horario laboral'
									: undefined}
							>
								<button
									type="button"
									disabled={!isAdvisorOnline}
									class={`inline-flex w-full items-center justify-center gap-1.5 rounded-lg border px-2 py-1.5 text-sm font-semibold shadow-xs transition-colors dark:border-white/20 dark:bg-neutral-900 dark:text-white cursor-pointer ${
										isAdvisorOnline
											? 'border-gray-200 bg-white text-gray-900 hover:bg-gray-50 dark:hover:bg-white/30'
											: 'pointer-events-none cursor-not-allowed border-gray-200 bg-gray-100 text-gray-400 opacity-80 dark:bg-white/10 dark:text-gray-300'
									}`}
								>
									<Icon name="ri:phone-line" class="h-3.5 w-3.5" />
									Llamar
								</button>
								{
									!isAdvisorOnline && (
										<span class="pointer-events-none absolute -top-9 left-1/2 z-10 -translate-x-1/2 rounded-md bg-gray-900 px-2 py-1 text-[11px] font-medium whitespace-nowrap text-white opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100 dark:bg-black">
											Fuera de horario laboral
										</span>
									)
								}
							</div>
							<div
								class="group relative"
								title={!isAdvisorOnline
									? 'Fuera de horario laboral'
									: undefined}
							>
								<button
									type="button"
									disabled={!isAdvisorOnline}
									class={`inline-flex w-full items-center justify-center gap-1.5 rounded-lg border px-2 py-1.5 text-sm font-semibold shadow-xs transition-colors dark:border-white/20 dark:bg-neutral-900 dark:text-white cursor-pointer ${
										isAdvisorOnline
											? 'border-gray-200 bg-white text-gray-900 hover:bg-gray-50 dark:hover:bg-white/30'
											: 'pointer-events-none cursor-not-allowed border-gray-200 bg-gray-100 text-gray-400 opacity-80 dark:bg-white/10 dark:text-gray-300'
									}`}
								>
									<Icon name="ri:message-3-line" class="h-3.5 w-3.5" />
									Chat
								</button>
								{
									!isAdvisorOnline && (
										<span class="pointer-events-none absolute -top-9 left-1/2 z-10 -translate-x-1/2 rounded-md bg-gray-900 px-2 py-1 text-[11px] font-medium whitespace-nowrap text-white opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100 dark:bg-black">
											Fuera de horario laboral
										</span>
									)
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div
		class="relative items-center justify-center gap-5 rounded-lg border border-gray-200 bg-white p-4 shadow-md shadow-gray-200/70 sm:p-6 lg:flex dark:border-gray-700 dark:bg-transparent dark:shadow-none"
	>
		<div
			class="top-5 left-5 mb-4 flex w-fit flex-col items-center justify-between lg:absolute lg:flex-row"
		>
			<div class="w-fit text-start">
				<span
					class="text-xl leading-none font-bold text-gray-900 sm:text-2xl dark:text-white"
					>{empresa?.estado_de_incorporacion || ''}</span
				>
				<h3 class="w-fit text-base font-light text-gray-500 dark:text-gray-400">
					Estado de incorporación
				</h3>
			</div>
		</div>

		<div
			class="mt-4 flex items-center justify-between border-t border-gray-200 pt-3 text-[11px] text-gray-500 dark:border-gray-700 dark:text-gray-400"
		>
			<a
				href="mailto:soporte@sotomayorconsulting.com"
				class="inline-flex items-center gap-1.5 hover:text-gray-700 dark:hover:text-gray-300"
			>
				<Icon name="ri:mail-line" class="h-3.5 w-3.5" />
				soporte@sotomayorconsulting.com
			</a>
			<span class="inline-flex items-center gap-1.5">
				<Icon name="ri:time-line" class="h-3.5 w-3.5" />
				Resp. &lt; 2h
			</span>
		</div>
	</div>
</div>
