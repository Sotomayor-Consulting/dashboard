---
import { Icon } from 'astro-icon/components';
// import { getStateInfo } from './state-info/states-data';
// import StateQuickStats from './state-info/StateQuickStats.astro';
// import StateBenefits from './state-info/StateBenefits.astro';
// import StateTaxInfo from './state-info/StateTaxInfo.astro';
// import StateLegalDetails from './state-info/StateLegalDetails.astro';
// import StateOfficialLink from './state-info/StateOfficialLink.astro';
// import StatePlate from './state-info/StatePlate.astro';
import type { CompanyRow } from '@domains/companies/types/company';

interface Props {
	company: Pick<
		CompanyRow,
		| 'legal_name'
		| 'entity_type'
		| 'identification_number'
		| 'filing_number'
		| 'incorporation_date'
		| 'created_at'
	> & {
		formation_state_name: string | '';
	};
}

const { company } = Astro.props;

// const stateInfo = getStateInfo(company.formation_state_id);

const rawEin = company.identification_number ?? null;

const maskedEin = (() => {
	if (!rawEin) return null;
	const digits = rawEin.replace(/\D/g, '');
	if (digits.length >= 4)
		return `${digits.slice(0, 2)}-${digits.slice(2, 4)}*****`;
	return `${rawEin.slice(0, 2)}***`;
})();

const fechaConstitucion = company.created_at
	? new Intl.DateTimeFormat('es-ES', {
			day: 'numeric',
			month: 'short',
			year: 'numeric',
		}).format(new Date(company.created_at))
	: '—';

const tipoEntidadFull =
	company.entity_type === 'llc'
		? 'Limited Liability Company'
		: company.entity_type || '—';

const rows = [
	{ label: 'Tipo de entidad', value: tipoEntidadFull, mono: false },
	{
		label: 'Estado',
		value: `${company.formation_state_name}, USA`,
		mono: false,
	},
	{ label: 'EIN', value: maskedEin ?? '—', mono: true, copyable: true },
	{
		label: 'File Number',
		value: company.filing_number ?? '—',
		mono: true,
		copyable: !!company.filing_number,
	},
	{ label: 'Fecha de constitución', value: fechaConstitucion, mono: false },
	{
		label: 'Año fiscal',
		value: 'Enero – Diciembre',
		mono: false,
	},
	{
		label: 'Agente Residente',
		value: 'Sotomayor Consulting International',
		mono: false,
	},
];
---

<div class="mt-2 grid w-full">
	<!-- Datos fiscales y de registro -->
	<div>
		<header class="border-border -mx-6 border-b px-6 py-2">
			<p
				class="text-[11.5px] font-semibold tracking-wider text-gray-500 uppercase dark:text-gray-400"
			>
				Empresa
			</p>
			<h2
				class="mt-1 text-[22px] font-semibold text-gray-900 dark:text-gray-100"
			>
				{company.legal_name ?? 'Sin nombre'}
			</h2>
		</header>

		<div class="-mx-6">
			<dl class="divide-border divide-y">
				{
					rows.map((row) => (
						<div class="flex items-center justify-between gap-4 px-6 py-3">
							<dt class="text-muted-foreground text-sm">{row.label}</dt>
							<dd class="text-foreground flex items-center gap-2 text-right text-sm font-semibold">
								<span class={row.mono ? 'font-mono' : ''}>{row.value}</span>
								{row.copyable && (
									<button
										type="button"
										title={`Copiar ${row.label}`}
										class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex h-5 w-5 items-center justify-center rounded transition-colors"
									>
										<Icon name="ri:file-copy-line" class="h-3.5 w-3.5" />
									</button>
								)}
							</dd>
						</div>
					))
				}
			</dl>
		</div>

		<!-- <button
			type="button"
			class="border-border text-foreground hover:bg-muted mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg border px-4 py-2.5 text-sm font-medium transition-colors"
		>
			<Icon name="ri:download-line" class="h-4 w-4" />
			Descargar Certificate of Formation
		</button> -->
	</div>

