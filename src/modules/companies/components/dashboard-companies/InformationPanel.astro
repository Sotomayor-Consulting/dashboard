---
import { Icon } from 'astro-icon/components';
import type { CompanyRow } from '@domains/companies/types/company';

interface Props {
	company: Pick<
		CompanyRow,
		| 'legal_name'
		| 'entity_type'
		| 'identification_number'
		| 'filing_number'
		| 'incorporation_date'
		| 'created_at'
	> & {
		formation_state_name: string | '';
	};
}

const { company } = Astro.props;

const rawEin = company.identification_number ?? null;

const maskedEin = (() => {
	if (!rawEin) return null;
	const digits = rawEin.replace(/\D/g, '');
	if (digits.length >= 4)
		return `${digits.slice(0, 2)}-${digits.slice(2, 4)}*****`;
	return `${rawEin.slice(0, 2)}***`;
})();

const fechaConstitucion = company.created_at
	? new Intl.DateTimeFormat('es-ES', {
			day: 'numeric',
			month: 'short',
			year: 'numeric',
		}).format(new Date(company.created_at))
	: '—';

const tipoEntidadFull =
	company.entity_type === 'llc'
		? 'Limited Liability Company'
		: company.entity_type || '—';
---

<div class="grid w-full">
	<header class="border-border border-b pb-4">
		<h1 class="text-foreground text-xl font-semibold">
			{company.legal_name ?? 'Sin nombre'}
		</h1>
		<p class="text-muted-foreground mt-1 text-sm">
			Información general de la empresa.
		</p>
	</header>

	<div class="divide-border divide-y">
		<!-- Datos de registro -->
		<div
			class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 first:pt-6 sm:grid-cols-[180px_1fr]"
		>
			<div>
				<div class="flex items-center gap-2">
					<Icon
						name="ri:bank-line"
						class="text-muted-foreground h-5 w-5 shrink-0"
					/>
					<h3 class="text-foreground text-sm font-medium">Registro</h3>
				</div>
				<p class="text-muted-foreground mt-1 text-sm">
					Datos de constitución y tipo de entidad.
				</p>
			</div>
			<dl class="grid grid-cols-2 gap-x-6 gap-y-4">
				<div>
					<dt class="text-muted-foreground text-sm">Tipo de entidad</dt>
					<dd class="text-foreground mt-1 text-sm font-medium">
						{tipoEntidadFull}
					</dd>
				</div>
				<div>
					<dt class="text-muted-foreground text-sm">Estado</dt>
					<dd class="text-foreground mt-1 text-sm font-medium">
						{company.formation_state_name
							? `${company.formation_state_name}, USA`
							: '—'}
					</dd>
				</div>
				<div>
					<dt class="text-muted-foreground text-sm">Fecha de constitución</dt>
					<dd class="text-foreground mt-1 text-sm font-medium">
						{fechaConstitucion}
					</dd>
				</div>
				<div>
					<dt class="text-muted-foreground text-sm">Año fiscal</dt>
					<dd class="text-foreground mt-1 text-sm font-medium">
						Enero – Diciembre
					</dd>
				</div>
			</dl>
		</div>

		<!-- Identificación fiscal -->
		<div
			class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[180px_1fr]"
		>
			<div>
				<div class="flex items-center gap-2">
					<Icon
						name="ri:fingerprint-line"
						class="text-muted-foreground h-5 w-5 shrink-0"
					/>
					<h3 class="text-foreground text-sm font-medium">Identificación</h3>
				</div>
				<p class="text-muted-foreground mt-1 text-sm">
					Números de identificación fiscal y expediente.
				</p>
			</div>
			<dl class="grid grid-cols-2 gap-x-6 gap-y-4">
				<div>
					<dt class="text-muted-foreground text-sm">EIN</dt>
					<dd class="mt-1 flex items-center gap-2">
						{
							rawEin ? (
								<span
									class="text-foreground text-sm font-medium font-mono"
									id="ein-display"
									data-masked={maskedEin}
									data-revealed="false"
								>
									{maskedEin}
								</span>
								<button
									type="button"
									id="ein-toggle"
									title="Mostrar EIN"
									class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex h-6 w-6 items-center justify-center rounded transition-colors"
								>
									<Icon
										name="ri:eye-line"
										class="h-4 w-4"
										id="ein-icon-show"
									/>
									<Icon
										name="ri:eye-off-line"
										class="hidden h-4 w-4"
										id="ein-icon-hide"
									/>
								</button>
								<button
									type="button"
									id="ein-copy"
									title="Copiar EIN"
									class="hidden text-muted-foreground hover:bg-muted hover:text-foreground inline-flex h-6 w-6 items-center justify-center rounded transition-colors"
								>
									<Icon
										name="ri:file-copy-line"
										class="h-3.5 w-3.5"
										id="ein-copy-icon"
									/>
									<Icon
										name="ri:check-line"
										class="hidden h-3.5 w-3.5 text-green-600"
										id="ein-check-icon"
									/>
								</button>
							) : (
								<span class="text-foreground text-sm font-medium">—</span>
							)
						}
					</dd>
				</div>
				<div>
					<dt class="text-muted-foreground text-sm">File Number</dt>
					<dd class="mt-1 flex items-center gap-2">
						<span class="text-foreground text-sm font-medium font-mono"
							>{company.filing_number ?? '—'}</span
						>
						{
							company.filing_number && (
								<button
									type="button"
									title="Copiar File Number"
									class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex h-6 w-6 items-center justify-center rounded transition-colors"
									data-copy-value={company.filing_number}
									data-copy-btn
								>
									<Icon
										name="ri:file-copy-line"
										class="h-3.5 w-3.5"
										data-copy-default
									/>
									<Icon
										name="ri:check-line"
										class="hidden h-3.5 w-3.5 text-green-600"
										data-copy-success
									/>
								</button>
							)
						}
					</dd>
				</div>
			</dl>
		</div>

		<!-- Agente residente -->
		<div
			class="grid grid-cols-1 gap-x-8 gap-y-4 py-8 sm:grid-cols-[180px_1fr]"
		>
			<div>
				<div class="flex items-center gap-2">
					<Icon
						name="ri:shield-user-line"
						class="text-muted-foreground h-5 w-5 shrink-0"
					/>
					<h3 class="text-foreground text-sm font-medium">Representación</h3>
				</div>
				<p class="text-muted-foreground mt-1 text-sm">
					Agente residente designado.
				</p>
			</div>
			<dl>
				<div>
					<dt class="text-muted-foreground text-sm">Agente Residente</dt>
					<dd class="text-foreground mt-1 text-sm font-medium">
						Sotomayor Consulting International
					</dd>
				</div>
			</dl>
		</div>
	</div>
</div>

<script is:inline define:vars={{ rawEin }}>
	function initCompanyInfoPanel() {
		// ── EIN toggle (show/hide + copy) ──
		const einToggle = document.getElementById('ein-toggle');
		const einDisplay = document.getElementById('ein-display');
		const einCopy = document.getElementById('ein-copy');

		if (
			einToggle &&
			einDisplay &&
			einToggle.dataset.bound !== '1'
		) {
			einToggle.dataset.bound = '1';
			const masked = einDisplay.dataset.masked || '';

			einToggle.addEventListener('click', () => {
				const isRevealed = einDisplay.dataset.revealed === 'true';
				const nextState = !isRevealed;

				einDisplay.textContent = nextState ? rawEin : masked;
				einDisplay.dataset.revealed = String(nextState);

				einToggle.title = nextState ? 'Ocultar EIN' : 'Mostrar EIN';

				document
					.getElementById('ein-icon-show')
					?.classList.toggle('hidden', nextState);
				document
					.getElementById('ein-icon-hide')
					?.classList.toggle('hidden', !nextState);

				if (einCopy) einCopy.classList.toggle('hidden', !nextState);
			});
		}

		if (einCopy && einCopy.dataset.bound !== '1') {
			einCopy.dataset.bound = '1';

			einCopy.addEventListener('click', async () => {
				if (!einDisplay || einDisplay.dataset.revealed !== 'true') return;

				try {
					await navigator.clipboard.writeText(rawEin);

					const defaultIcon = document.getElementById('ein-copy-icon');
					const successIcon = document.getElementById('ein-check-icon');

					if (defaultIcon) defaultIcon.classList.add('hidden');
					if (successIcon) successIcon.classList.remove('hidden');

					setTimeout(() => {
						if (defaultIcon) defaultIcon.classList.remove('hidden');
						if (successIcon) successIcon.classList.add('hidden');
					}, 2000);
				} catch {
					// Clipboard API no disponible o permiso denegado
				}
			});
		}

		// ── Generic copy buttons (File Number, etc.) ──
		document
			.querySelectorAll('[data-copy-btn]')
			.forEach((btn) => {
				if (btn.dataset.bound === '1') return;
				btn.dataset.bound = '1';

				btn.addEventListener('click', async () => {
					const value = btn.dataset.copyValue;
					if (!value) return;

					try {
						await navigator.clipboard.writeText(value);

						const defaultIcon = btn.querySelector('[data-copy-default]');
						const successIcon = btn.querySelector('[data-copy-success]');

						if (defaultIcon) defaultIcon.classList.add('hidden');
						if (successIcon) successIcon.classList.remove('hidden');

						setTimeout(() => {
							if (defaultIcon) defaultIcon.classList.remove('hidden');
							if (successIcon) successIcon.classList.add('hidden');
						}, 2000);
					} catch {
						// Clipboard API no disponible o permiso denegado
					}
				});
			});
	}

	initCompanyInfoPanel();
	document.addEventListener('astro:page-load', initCompanyInfoPanel);
</script>
