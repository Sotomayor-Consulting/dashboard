---
import { Icon } from 'astro-icon/components';
interface Props {
	documentos: {
		name: string;
		updated_at?: string;
	}[];
	userId: string;
	empresaId: string;
}
const { documentos, userId, empresaId } = Astro.props;

const fechaFormatter = new Intl.DateTimeFormat('es-ES', {
	day: '2-digit',
	month: '2-digit',
	year: 'numeric',
});

const formatFecha = (fecha?: string) => {
	if (!fecha) return 'Sin fecha';
	const parsed = new Date(fecha);
	if (Number.isNaN(parsed.getTime())) return 'Sin fecha';
	return fechaFormatter.format(parsed);
};
---

<div
	class="flat-card-padded 2xl:col-span-2 sm:p-6"
>
	<div class="h-full w-full">
		<h3 class="section-title">
			Últimos documentos
		</h3>
		<div class="flow-root">
			<ul
				role="list"
				class="scrollbar scrollbar-w-2 mt-3 max-h-96 space-y-2 overflow-y-auto"
			>
				{
					documentos && documentos.length > 0 ? (
						documentos.map((d) => (
							<li class="rounded-xl border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-black-800">
								<div class="flex items-center gap-3">
									<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-500 dark:border-gray-700 dark:bg-black-700 dark:text-gray-300">
										<Icon name="ri:file-list-3-line" class="h-4 w-4" />
									</div>
									<div class="min-w-0 flex-1">
										<p class="truncate text-base font-semibold text-gray-900 dark:text-white" title={d.name}>
											{d.name}
										</p>
										<p class="text-sm text-gray-500 dark:text-gray-400">
											Fecha: {formatFecha(d.updated_at)}
										</p>
									</div>
									<span class="hidden rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 sm:inline-flex dark:bg-emerald-500/15 dark:text-emerald-300">
										Subido
									</span>
									<div class="inline-flex items-center">
										<button
											type="button"
											class="btn-ver-documento inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-700 dark:bg-black-700 dark:text-gray-200 dark:hover:bg-black-600"
											data-path={`${userId}/companies/${empresaId}/documents/${d.name}`}
											title="Ver documento"
										>
											<Icon name="ri:download-line" class="h-4 w-4" />
										</button>
									</div>
								</div>
							</li>
						))
					) : (
						<li class="py-4">
							<div class="flex h-full flex-col items-center justify-center gap-2">
								<h2 class="w-full text-sm text-gray-500 dark:text-gray-400">
									No hay documentos subidos aun...
								</h2>
								<Icon name="folders" width={300} height={300} />
							</div>
						</li>
					)
				}
			</ul>
		</div>
	</div>
</div>
<script>
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.btn-ver-documento');
		if (!btn) return;

		const path = (btn as HTMLElement).dataset.path;
		if (!path) return;

		try {
			const res = await fetch('/api/storage/get-signed-url', {
				method: 'POST',
				credentials: 'include',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ path }),
			});
			const data = await res.json();
			if (data.error) throw new Error(data.error);
			window.open(data.signedUrl, '_blank');
		} catch (error) {
			console.error('Error al obtener documento:', error);
			alert('Error al cargar el documento');
		}
	});
</script>
