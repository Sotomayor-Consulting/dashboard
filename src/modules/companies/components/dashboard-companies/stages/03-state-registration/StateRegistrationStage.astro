---
import StageShell from '../StageShell.astro';
import { formatStageDate } from '../shared/format-date.ts';
import type { StageProps } from '../types';

const { stage } = Astro.props as StageProps;
---

<StageShell
	stage={stage}
	icon="ri:government-line"
	description="Presentamos la incorporación ante la secretaría del estado correspondiente."
	formattedDate={formatStageDate(stage.dueAt)}
/>
