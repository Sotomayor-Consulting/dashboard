---
import { Icon } from 'astro-icon/components';
import type { PlanningMeetingApproval } from '@domains/workflow/stages/planning-meeting';

interface Props {
	rejection: PlanningMeetingApproval;
}

const { rejection } = Astro.props;
---

<div
	class="mt-3 rounded-lg border border-red-200 bg-red-50/50 p-3 dark:border-red-900/40 dark:bg-red-900/10"
>
	<div class="flex items-start gap-2">
		<Icon
			name="ri:error-warning-line"
			class="h-5 w-5 shrink-0 text-red-600 dark:text-red-400"
		/>
		<div class="min-w-0 flex-1">
			<p class="text-sm font-semibold text-red-800 dark:text-red-200">
				Rechazaste la planificación · ronda {rejection.round}
			</p>
			<p class="mt-0.5 text-xs text-red-700/80 dark:text-red-300/80">
				Operaciones está preparando una nueva versión basada en tus comentarios.
			</p>
			{
				rejection.comments && (
					<blockquote class="mt-2 rounded border-l-2 border-red-300 bg-white/60 px-2 py-1 text-[11px] text-gray-700 italic dark:border-red-500/50 dark:bg-gray-900/40 dark:text-gray-300">
						{rejection.comments}
					</blockquote>
				)
			}
		</div>
	</div>
</div>
