---
import { Icon } from 'astro-icon/components';
import type { PlanningDesignDocument } from '@domains/workflow/stages/planning-meeting';

interface Props {
	document: PlanningDesignDocument;
	signedUrl: string | null;
	stageId: string;
}

const { document: doc, signedUrl, stageId } = Astro.props;

const downloadUrl = signedUrl
	? `${signedUrl}${signedUrl.includes('?') ? '&' : '?'}download=${encodeURIComponent(doc.file_name)}`
	: null;
---

<div
	class="mt-4 rounded-lg border border-amber-200 bg-amber-50/40 p-3 sm:p-4 dark:border-amber-900/40 dark:bg-amber-900/10"
>
	<div class="mb-3 flex items-start justify-between gap-2">
		<div class="flex items-center gap-2 min-w-0">
			<Icon
				name="ri:file-check-line"
				class="h-5 w-5 shrink-0 text-amber-600 dark:text-amber-400"
			/>
			<div class="min-w-0">
				<p class="text-sm font-semibold text-gray-900 dark:text-white">
					Documento de planificación y diseño
				</p>
				<p class="truncate text-[11px] text-gray-500 dark:text-gray-400">
					{doc.file_title ?? doc.file_name} · v{doc.version}
				</p>
			</div>
		</div>
		{
			signedUrl && (
				<div class="flex shrink-0 items-center gap-1.5">
					<a
						href={signedUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1 rounded-md bg-white px-2 py-1 text-[11px] font-semibold text-gray-700 ring-1 ring-gray-200 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-200 dark:ring-gray-700 dark:hover:bg-gray-700"
					>
						<Icon name="ri:external-link-line" class="h-3.5 w-3.5" />
						Abrir
					</a>
					{downloadUrl && (
						<a
							href={downloadUrl}
							class="inline-flex items-center gap-1 rounded-md bg-[#134aed] px-2 py-1 text-[11px] font-semibold text-white transition hover:bg-[#0f3bc4]"
						>
							<Icon name="ri:download-line" class="h-3.5 w-3.5" />
							Descargar
						</a>
					)}
				</div>
			)
		}
	</div>

	<div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
		<button
			type="button"
			class="btn-planning-approve inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-emerald-700 disabled:opacity-60"
			data-stage-id={stageId}
		>
			<Icon name="ri:check-line" class="h-4 w-4" />
			Aprobar planificación
		</button>

		<details class="planning-reject-dialog group flex-1">
			<summary
				class="inline-flex cursor-pointer list-none items-center justify-center gap-2 rounded-lg border border-red-200 bg-white px-4 py-2 text-xs font-semibold text-red-700 transition select-none hover:bg-red-50 dark:border-red-900/40 dark:bg-transparent dark:text-red-300 dark:hover:bg-red-900/20"
			>
				<Icon name="ri:close-line" class="h-4 w-4" />
				Rechazar
			</summary>

			<form
				class="planning-reject-form mt-3 space-y-2 rounded-md border border-red-200 bg-red-50/40 p-3 dark:border-red-900/40 dark:bg-red-900/10"
				data-stage-id={stageId}
			>
				<label
					for={`reject-${stageId}`}
					class="block text-[11px] font-semibold text-gray-700 dark:text-gray-200"
				>
					¿Qué necesitas corregir? *
				</label>
				<textarea
					id={`reject-${stageId}`}
					name="comments"
					rows="3"
					required
					minlength="5"
					placeholder="Describe qué se debe ajustar para que operaciones suba una nueva versión."
					class="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs text-gray-900 placeholder:text-gray-400 focus:border-red-400 focus:ring-1 focus:ring-red-400 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-white dark:placeholder:text-gray-500"
				></textarea>
				<div class="flex justify-end gap-2">
					<button
						type="submit"
						class="inline-flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-[11px] font-semibold text-white transition hover:bg-red-700 disabled:opacity-60"
					>
						<Icon name="ri:send-plane-line" class="h-3.5 w-3.5" />
						Enviar rechazo
					</button>
				</div>
			</form>
		</details>
	</div>
</div>

<style>
	details.planning-reject-dialog > summary::-webkit-details-marker {
		display: none;
	}
</style>
