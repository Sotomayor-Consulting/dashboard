---
import { Icon } from 'astro-icon/components';
import type { PlanningDesignDocument } from '@domains/workflow/stages/planning-meeting';

interface Props {
	document: PlanningDesignDocument;
	signedUrl: string | null;
}

const { document: doc, signedUrl } = Astro.props;

const downloadUrl = signedUrl
	? `${signedUrl}${signedUrl.includes('?') ? '&' : '?'}download=${encodeURIComponent(doc.file_name)}`
	: null;
---

<div class="mt-3 flex items-center justify-between gap-3 rounded-lg border border-border bg-card px-4 py-3">
	<div class="flex items-center gap-3 min-w-0">
		<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-emerald-200 bg-emerald-50 dark:border-emerald-500/20 dark:bg-emerald-500/10">
			<Icon name="ri:checkbox-circle-line" class="h-4 w-4 text-emerald-600 dark:text-emerald-400" />
		</div>
		<div class="min-w-0">
			<p class="text-sm font-medium text-foreground">
				Planificación y diseño disponible
			</p>
			<p class="truncate text-xs text-muted-foreground">
				{doc.file_title ?? doc.file_name} · v{doc.version}
			</p>
		</div>
	</div>
	{
		downloadUrl && (
			<a
				href={downloadUrl}
				class="group/btn inline-flex shrink-0 items-center gap-2 rounded-lg border border-border bg-card px-3 py-2 text-xs font-medium text-foreground transition-colors hover:bg-muted"
			>
				<Icon name="ri:download-line" class="h-4 w-4 text-emerald-500" />
				Descargar
			</a>
		)
	}
</div>
