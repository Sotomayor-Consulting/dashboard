---
import { Icon } from 'astro-icon/components';
---

<div class="mt-3 flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3">
	<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-primary/20 bg-primary/5">
		<Icon name="ri:file-edit-line" class="h-4 w-4 text-primary" />
	</div>
	<div class="min-w-0">
		<p class="text-sm font-medium text-foreground">
			Tu asesor está preparando el documento
		</p>
		<p class="mt-0.5 text-xs text-muted-foreground">
			Pronto recibirás el documento de planificación y diseño.
		</p>
	</div>
</div>
