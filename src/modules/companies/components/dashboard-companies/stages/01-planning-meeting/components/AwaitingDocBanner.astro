---
import { Icon } from 'astro-icon/components';
---

<div
	class="mt-3 flex items-start gap-3 rounded-lg border border-blue-200 bg-blue-50 p-3 dark:border-blue-900/50 dark:bg-blue-900/20"
>
	<div
		class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900/40"
	>
		<Icon
			name="ri:file-edit-line"
			class="h-4 w-4 text-blue-600 dark:text-blue-300"
		/>
	</div>
	<div class="min-w-0 flex-1">
		<p class="text-sm font-semibold text-blue-900 dark:text-blue-100">
			Tu asesor está preparando el documento
		</p>
		<p class="mt-0.5 text-xs text-blue-700 dark:text-blue-300/80">
			Pronto recibirás el documento de planificación y diseño para tu revisión y
			aprobación.
		</p>
	</div>
</div>
