---
import { Icon } from 'astro-icon/components';

interface Props {
	href: string;
	empresaId: string;
	userId: string;
	label?: string;
}

const {
	href,
	empresaId,
	userId,
	label = 'Agendar reunión de planificación',
} = Astro.props;
---

<button
	type="button"
	class="btn-booking-intent group/btn inline-flex items-center gap-2.5 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted disabled:opacity-60"
	data-href={href}
	data-empresa-id={empresaId}
	data-user-id={userId}
>
	<Icon name="ri:calendar-event-line" class="h-4 w-4 text-primary" />
	{label}
	<Icon name="ri:arrow-right-line" class="h-3.5 w-3.5 text-muted-foreground transition-transform group-hover/btn:translate-x-0.5" />
</button>
