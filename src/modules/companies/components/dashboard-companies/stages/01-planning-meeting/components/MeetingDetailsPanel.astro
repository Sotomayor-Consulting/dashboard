---
import { Icon } from 'astro-icon/components';
import {
	formatMeetingDate,
	formatMeetingTime,
	platformLabel,
} from '../../shared/format-date.ts';
import type { MeetingData } from '../../types';
import PlatformIcon from './PlatformIcon.astro';

interface Props {
	meeting: MeetingData;
}

const { meeting } = Astro.props;

const endsAt =
	new Date(meeting.scheduled_at).getTime() +
	meeting.duration_minutes * 60 * 1000;
const isPast = Date.now() > endsAt;
const canJoin =
	meeting.status === 'scheduled' && meeting.meeting_url && !isPast;
const showHistoricBadge = isPast && meeting.status === 'scheduled';
---

<details class="meeting-details group mt-3">
	<summary
		class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-md bg-gray-100 px-2.5 py-1 text-[11px] font-semibold text-gray-700 transition select-none hover:bg-gray-200 dark:bg-transparent dark:text-gray-300 dark:hover:bg-gray-600"
	>
		VER DETALLES DE LA REUNIÓN
		<Icon
			name="ri:arrow-down-s-line"
			class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180"
		/>
	</summary>

	<div
		class="mt-2 overflow-hidden rounded-lg border border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-transparent"
	>
		<div class="p-3 sm:p-4">
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
				<div class="flex items-start gap-2.5">
					<div
						class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg"
					>
						<Icon name="ri:calendar-line" class="h-4 w-4" />
					</div>
					<div class="min-w-0">
						<p class="text-[11px] font-medium text-gray-500 dark:text-gray-400">
							Fecha
						</p>
						<p
							class="text-sm font-semibold text-gray-900 capitalize dark:text-white"
						>
							{formatMeetingDate(meeting.scheduled_at)}
						</p>
					</div>
				</div>

				<div class="flex items-start gap-2.5">
					<div
						class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg dark:bg-transparent"
					>
						<Icon name="ri:time-line" class="h-4 w-4" />
					</div>
					<div class="min-w-0">
						<p class="text-[11px] font-medium text-gray-500 dark:text-gray-400">
							Hora
						</p>
						<p class="text-sm font-semibold text-gray-900 dark:text-white">
							{formatMeetingTime(meeting.scheduled_at)} ({
								meeting.duration_minutes
							} min)
						</p>
					</div>
				</div>

				<div class="flex items-start gap-2.5">
					<div
						class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white p-1 dark:bg-transparent"
					>
						<PlatformIcon platform={meeting.platform} class="h-5 w-5" />
					</div>
					<div class="min-w-0">
						<p class="text-[11px] font-medium text-gray-500 dark:text-gray-400">
							Plataforma
						</p>
						<p class="text-sm font-semibold text-gray-900 dark:text-white">
							{platformLabel(meeting.platform)}
						</p>
					</div>
				</div>

				{
					meeting.advisor_name && (
						<div class="flex items-start gap-2.5">
							<div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg dark:border-gray-500 dark:bg-transparent">
								<Icon name="ri:user-star-line" class="h-4 w-4" />
							</div>
							<div class="min-w-0">
								<p class="text-[11px] font-medium text-gray-500 dark:text-gray-400">
									Asesor
								</p>
								<p class="text-sm font-semibold text-gray-900 dark:text-white">
									{meeting.advisor_name}
								</p>
							</div>
						</div>
					)
				}
			</div>

			<div
				class="mt-4 flex flex-wrap items-center gap-2 border-t border-gray-200 pt-3 dark:border-gray-700"
			>
				{
					canJoin && (
						<>
							<a
								href={meeting.meeting_url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 rounded-lg bg-[#134aed] px-4 py-2 text-xs font-semibold text-white transition hover:bg-[#0f3bc4]"
							>
								<Icon name="ri:video-on-line" class="h-4 w-4" />
								Unirse a la reunión
							</a>
							{meeting.meeting_passcode && (
								<span class="dark:bg-black-700 inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-2 py-1 text-[11px] text-gray-600 dark:text-gray-400">
									Código: {meeting.meeting_passcode}
									<button
										type="button"
										title="Copiar Código de Acceso a la Reunión"
										aria-label="Copiar código"
										data-passcode={meeting.meeting_passcode}
										class="btn-copy-passcode dark:hover:bg-black-600 inline-flex h-5 w-5 items-center justify-center rounded transition-colors hover:bg-gray-200"
									>
										<Icon
											name="ri:file-copy-line"
											class="icon-default h-3.5 w-3.5"
										/>
										<Icon
											name="ri:check-line"
											class="icon-copied hidden h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400"
										/>
									</button>
								</span>
							)}
						</>
					)
				}

				{
					showHistoricBadge && (
						<span class="inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-2.5 py-1 text-[11px] font-semibold text-gray-600 dark:bg-gray-800 dark:text-gray-300">
							<Icon name="ri:history-line" class="h-3.5 w-3.5" />
							Reunión finalizada · histórico
						</span>
					)
				}
			</div>
		</div>
	</div>
</details>

<style>
	details > summary::-webkit-details-marker {
		display: none;
	}
</style>
