---
import { Icon } from 'astro-icon/components';
import {
	formatMeetingDate,
	formatMeetingTime,
	platformLabel,
} from '../../shared/format-date.ts';
import type { MeetingData } from '../../types';
import PlatformIcon from './PlatformIcon.astro';

interface Props {
	meeting: MeetingData;
}

const { meeting } = Astro.props;

const endsAt =
	new Date(meeting.scheduled_at).getTime() +
	meeting.duration_minutes * 60 * 1000;
const isPast = Date.now() > endsAt;
const canJoin =
	meeting.status === 'scheduled' && meeting.meeting_url && !isPast;
const showHistoricBadge = isPast && meeting.status === 'scheduled';
---

<details class="meeting-details group mt-3">
	<summary
		class="inline-flex cursor-pointer list-none items-center gap-2 rounded-lg border border-border bg-card px-3 py-2 text-xs font-medium text-muted-foreground transition-colors select-none hover:bg-muted hover:text-foreground"
	>
		<Icon name="ri:calendar-check-line" class="h-4 w-4" />
		Detalles de la reunión
		<Icon
			name="ri:arrow-down-s-line"
			class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-180"
		/>
	</summary>

	<div class="mt-3 rounded-lg border border-border bg-card">
		<div class="p-4">
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				<div class="flex items-center gap-3">
					<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-card">
						<Icon name="ri:calendar-line" class="h-4 w-4 text-muted-foreground" />
					</div>
					<div class="min-w-0">
						<p class="text-xs text-muted-foreground">Fecha</p>
						<p class="text-sm font-medium text-foreground capitalize">
							{formatMeetingDate(meeting.scheduled_at)}
						</p>
					</div>
				</div>

				<div class="flex items-center gap-3">
					<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-card">
						<Icon name="ri:time-line" class="h-4 w-4 text-muted-foreground" />
					</div>
					<div class="min-w-0">
						<p class="text-xs text-muted-foreground">Hora</p>
						<p class="text-sm font-medium text-foreground">
							{formatMeetingTime(meeting.scheduled_at)} ({meeting.duration_minutes} min)
						</p>
					</div>
				</div>

				<div class="flex items-center gap-3">
					<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-card p-1">
						<PlatformIcon platform={meeting.platform} class="h-5 w-5" />
					</div>
					<div class="min-w-0">
						<p class="text-xs text-muted-foreground">Plataforma</p>
						<p class="text-sm font-medium text-foreground">
							{platformLabel(meeting.platform)}
						</p>
					</div>
				</div>

				{
					meeting.advisor_name && (
						<div class="flex items-center gap-3">
							<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-border bg-card">
								<Icon name="ri:user-star-line" class="h-4 w-4 text-muted-foreground" />
							</div>
							<div class="min-w-0">
								<p class="text-xs text-muted-foreground">Asesor</p>
								<p class="text-sm font-medium text-foreground">
									{meeting.advisor_name}
								</p>
							</div>
						</div>
					)
				}
			</div>

			<div class="mt-4 flex flex-wrap items-center gap-2 border-t border-border pt-4">
				{
					canJoin && (
						<>
							<a
								href={meeting.meeting_url}
								target="_blank"
								rel="noopener noreferrer"
								class="group/btn inline-flex items-center gap-2.5 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
							>
								<Icon name="ri:video-on-line" class="h-4 w-4 text-primary" />
								Unirse a la reunión
								<Icon name="ri:arrow-right-line" class="h-3.5 w-3.5 text-muted-foreground transition-transform group-hover/btn:translate-x-0.5" />
							</a>
							{meeting.meeting_passcode && (
								<span class="inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-xs text-muted-foreground">
									Código: <span class="font-medium text-foreground">{meeting.meeting_passcode}</span>
									<button
										type="button"
										title="Copiar Código de Acceso a la Reunión"
										aria-label="Copiar código"
										data-passcode={meeting.meeting_passcode}
										class="btn-copy-passcode inline-flex h-5 w-5 items-center justify-center rounded transition-colors hover:bg-muted"
									>
										<Icon name="ri:file-copy-line" class="icon-default h-3.5 w-3.5" />
										<Icon name="ri:check-line" class="icon-copied hidden h-3.5 w-3.5 text-emerald-500" />
									</button>
								</span>
							)}
						</>
					)
				}

				{
					showHistoricBadge && (
						<div class="inline-flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-xs text-muted-foreground">
							<Icon name="ri:history-line" class="h-4 w-4" />
							<span class="font-medium">Reunión finalizada</span>
						</div>
					)
				}
			</div>
		</div>
	</div>
</details>

<style>
	details > summary::-webkit-details-marker {
		display: none;
	}
</style>
