---
import { Icon } from 'astro-icon/components';
import { STATUS_LABEL, type StageItem } from './types';

interface Props {
	stage: StageItem;
	icon: string;
	description: string;
	formattedDate?: string | undefined;
}

const { stage, icon, description, formattedDate } = Astro.props;
const { status, displayOrder } = stage;

const isDone = status === 'completed';
const isActive = status === 'in_progress' || status === 'waiting';
const isPending = status === 'pending';

const hasActions = Astro.slots.has('actions');
const hasDefault = Astro.slots.has('default');
---

<details
	class="stage-shell group"
	open={isActive || isDone}
	data-status={status}
>
	<summary class="flex cursor-pointer items-center gap-4 px-6 py-5 select-none [&::-webkit-details-marker]:hidden [&::marker]:hidden">
		<!-- Icon circle -->
		<div
			class:list={[
				'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border transition-colors',
				isDone && 'border-emerald-200 bg-emerald-50 dark:border-emerald-500/20 dark:bg-emerald-500/10',
				status === 'in_progress' && 'border-primary/20 bg-primary/5 dark:border-primary/30 dark:bg-primary/10',
				status === 'waiting' && 'border-amber-200 bg-amber-50 dark:border-amber-500/20 dark:bg-amber-500/10',
				isPending && 'border-border bg-card dark:bg-card',
			]}
		>
			{
				isDone ? (
					<Icon name="ri:check-line" class="h-5 w-5 text-emerald-600 dark:text-emerald-400" />
				) : (
					<Icon
						name={icon}
						class:list={[
							'h-5 w-5',
							status === 'in_progress' && 'text-primary',
							status === 'waiting' && 'text-amber-600 dark:text-amber-400',
							isPending && 'text-muted-foreground',
						]}
					/>
				)
			}
		</div>

		<!-- Title + meta -->
		<div class="min-w-0 flex-1">
			<div class="flex items-center gap-2">
				<h3
					class:list={[
						'truncate font-semibold',
						isPending ? 'text-muted-foreground' : 'text-foreground',
					]}
				>
					{stage.name}
				</h3>
				<span
					class:list={[
						'inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[11px] font-medium leading-none',
						isDone && 'bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300',
						status === 'in_progress' && 'bg-primary/10 text-primary',
						status === 'waiting' && 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300',
						isPending && 'bg-muted text-muted-foreground',
					]}
				>
					{STATUS_LABEL[status]}
				</span>
			</div>
			{
				isPending && (
					<p class="mt-0.5 text-xs text-muted-foreground/60">
						Etapa {displayOrder}
					</p>
				)
			}
		</div>

		<!-- Right side -->
		<div class="flex shrink-0 items-center gap-3">
			{
				formattedDate && (
					<span class="hidden text-xs tabular-nums text-muted-foreground md:block">
						{formattedDate}
					</span>
				)
			}
			<Icon
				name="ri:arrow-down-s-line"
				class="h-5 w-5 text-muted-foreground/50 transition-transform duration-200 group-open:rotate-180"
			/>
		</div>
	</summary>

	<!-- Expanded content -->
	<div class="pb-5 pl-21 pr-6">
		<p class="text-sm leading-relaxed text-muted-foreground">
			{description}
		</p>

		{
			hasActions && (
				<div class="mt-3 flex flex-wrap items-center gap-2">
					<slot name="actions" />
				</div>
			)
		}

		{hasDefault && <div class="mt-3"><slot /></div>}
	</div>
</details>

<style>
	@supports (interpolate-size: allow-keywords) {
		.stage-shell {
			interpolate-size: allow-keywords;
		}
		.stage-shell::details-content {
			height: 0;
			overflow: clip;
			transition:
				height 0.3s ease,
				content-visibility 0.3s ease allow-discrete;
		}
		.stage-shell[open]::details-content {
			height: auto;
		}
	}
</style>

