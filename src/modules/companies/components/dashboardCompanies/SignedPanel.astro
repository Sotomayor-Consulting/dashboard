---
import { Icon } from 'astro-icon/components';

interface Props {
	porfirmar: {
		nombre: string;
		storage_path: string;
		id: string;
	}[];
}

const { porfirmar } = Astro.props;
---

<div
	class="to-black-600 from-black-900 rounded-xl border border-gray-200 bg-white p-4 shadow-md shadow-gray-200/70 sm:p-6 dark:border-gray-700 dark:bg-linear-to-tl dark:shadow-none"
>
	<h3
		class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-white"
	>
		Documentos pendientes a firmar
		<button
			data-popover-target="popover-description"
			data-popover-placement="bottom-end"
			type="button"
		>
			<svg
				class="ml-2 h-4 w-4 text-gray-400 hover:text-gray-500"
				aria-hidden="true"
				fill="currentColor"
				viewBox="0 0 20 20"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path
					fill-rule="evenodd"
					d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
					clip-rule="evenodd"></path>
			</svg>
			<span class="sr-only">Ayuda</span>
		</button>
	</h3>

	<div
		data-popover
		id="popover-description"
		role="tooltip"
		class="to-black-600 from-black-900 invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 bg-white text-sm font-light text-gray-500 opacity-0 shadow-sm transition-opacity duration-300 dark:border-gray-600 dark:bg-linear-to-tr dark:text-gray-400"
	>
		<div class="space-y-2 p-3">
			<h3
				class="font-semibold text-gray-900 dark:text-white"
				aria-label="Acciones rapidas"
			>
				Documentos por firmar
			</h3>
			<p>
				Encuentra aqui la lista de documentos que tienes pendientes a firmar
				para constituir tu empresa en Estados Unidos. Descarga el documento,
				firmalo electronicamente, y subelo de nuevo dando click en el boton de
				subir documento firmado.
			</p>
		</div>
		<div data-popper-arrow></div>
	</div>

	{
		porfirmar && porfirmar.length > 0 ? (
			<div class="mt-3 space-y-2 border-t border-gray-200 pt-4 dark:border-gray-700">
				{porfirmar.map((f) => (
					<div class="to-black-600 from-black-900 rounded-xl border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-linear-to-tr">
						<div class="flex items-start gap-3">
							<div class="dark:bg-black-700 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-500 dark:border-gray-700 dark:text-gray-300">
								<Icon name="ri:quill-pen-line" class="h-4 w-4" />
							</div>
							<div class="min-w-0 flex-1">
								<p
									class="truncate text-base font-semibold text-gray-900 dark:text-white"
									title={f.nombre}
								>
									{f.nombre}
								</p>
								<span class="mt-1 inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-700 dark:bg-amber-500/15 dark:text-amber-300">
									Pendiente a firmar
								</span>
							</div>
							<div class="flex shrink-0 items-center gap-1.5">
								<button
									type="button"
									class="btn-ver-documento-table dark:bg-black-700 dark:hover:bg-black-600 inline-flex h-9 w-9 items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-700 transition-colors hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200"
									data-path={f.storage_path}
									title="Descargar documento"
								>
									<Icon name="ri:download-line" class="h-4 w-4" />
								</button>
								<button
									type="button"
									id={`btn-${f.id}`}
									data-file-id={f.id}
									data-modal-target="popup-modal"
									data-modal-toggle="popup-modal"
									class="btn-upload-firmado inline-flex h-9 w-9 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-700 transition-colors hover:bg-emerald-100 dark:border-emerald-500/30 dark:bg-emerald-500/10 dark:text-emerald-300 dark:hover:bg-emerald-500/20"
									title="Subir documento firmado"
								>
									<Icon name="ri:upload-2-line" class="h-4 w-4" />
								</button>
							</div>
						</div>
					</div>
				))}
			</div>
		) : (
			<h2 class="mt-2 text-sm text-gray-500 dark:text-gray-400">
				No hay documentos pendientes por firmar aun...
			</h2>
		)
	}
</div>
