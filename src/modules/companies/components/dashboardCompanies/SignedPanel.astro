---
import { Icon } from 'astro-icon/components';
interface Props {
	porfirmar: {
		nombre: string;
		storage_path: string;
		id: string;
	}[];
}
const { porfirmar } = Astro.props;
---

<div
	class="to-black-600 from-black-900 rounded-lg bg-white p-4 shadow-sm sm:p-6 dark:bg-linear-to-bl"
>
	{
		porfirmar && porfirmar.length > 0 ? (
			<>
				<h3 class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-white">
					Documentos pendientes a firmar
					<button
						data-popover-target="popover-description"
						data-popover-placement="bottom-end"
						type="button"
					>
						<>
							<svg
								class="ml-2 h-4 w-4 text-gray-400 hover:text-gray-500"
								aria-hidden="true"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
									clip-rule="evenodd"
								/>
							</svg>
							<span class="sr-only">Ayuda</span>
						</>
					</button>
				</h3>
				<div
					data-popover
					id="popover-description"
					role="tooltip"
					class="dark:bg-black-800 invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 bg-white text-sm font-light text-gray-500 opacity-0 shadow-sm transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
				>
					<div class="space-y-2 p-3">
						<h3
							class="font-semibold text-gray-900 dark:text-white"
							aria-label="Acciones rapidas"
						>
							Documentos por firmar
						</h3>
						<p>
							Encuentra aquí la lista de documentos que tienes pendientes a
							firmar para constituir tu empresa en Estados Unidos. Descarga el
							documento, firmalo electrónicamente, y subelo de nuevo dando click
							en el botón de subir documento firmado.
						</p>
					</div>
					<div data-popper-arrow />
				</div>

				<div class="border-t border-gray-200 dark:border-gray-600">
					<div class="pt-4">
						{porfirmar.map((f) => (
							<ul
								role="list"
								class="divide-y divide-gray-200 dark:divide-gray-700"
							>
								<ol class="relative ms-3.5 mb-4 md:mb-5">
									<li class="ms-6 mb-11">
										<span class="dark:bg-black-400 bg-white-100 text-black-400 ring-white-200 dark:ring-black-500 absolute -inset-s-3 flex h-6 w-6 animate-pulse items-center justify-center rounded-full ring-4 dark:text-white">
											<Icon name="ri:quill-pen-ai-line" class="text-sm" />
										</span>
										<div class="mb-2">
											<h3 class="text-heading my-2 flex items-start text-lg font-semibold">
												{f.nombre}
											</h3>
											<span class="dark:bg-warning-soft bg-warning-strong border-warning-subtle dark:text-fg-warning flex w-fit rounded border px-1.5 py-0.5 text-xs font-medium text-white">
												<Icon name="ri:alert-line" class="mr-1 animate-pulse" />
												Pendiente a firmar
											</span>
										</div>

										<button
											type="button"
											class="dark:bg-black-400 bg-black-400 dark:hover:bg-black-500 hover:bg-black-500 focus:ring-brand-medium rounded-base btn-ver-documento-table mb-2 box-border inline-flex cursor-pointer border border-transparent px-4 py-2.5 text-sm leading-5 font-medium text-white shadow-xs focus:ring-4 focus:outline-none md:mb-0"
											data-path={f.storage_path}
										>
											<Icon
												name="ri:download-2-fill"
												class="-ms-0.5 me-1.5 text-base"
											/>
											Descargar documento
										</button>

										<button
											type="button"
											id={`btn-${f.id}`}
											data-file-id={f.id}
											data-modal-target="popup-modal"
											data-modal-toggle="popup-modal"
											class="btn-upload-firmado bg-success hover:bg-success-strong focus:ring-success-medium rounded-base box-border inline-flex cursor-pointer border border-transparent px-4 py-2.5 text-sm leading-5 font-medium text-white shadow-xs focus:ring-4 focus:outline-none"
										>
											<Icon
												name="ri:upload-2-fill"
												class="-ms-0.5 me-1.5 text-base"
											/>
											Subir documento firmado
										</button>
									</li>
								</ol>
							</ul>
						))}
					</div>
				</div>
			</>
		) : (
			<>
				<h3 class="mb-4 flex items-center text-lg font-semibold text-gray-900 dark:text-white">
					Documentos pendientes a firmar
					<button
						data-popover-target="popover-description"
						data-popover-placement="bottom-end"
						type="button"
					>
						<>
							<svg
								class="ml-2 h-4 w-4 text-gray-400 hover:text-gray-500"
								aria-hidden="true"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									fill-rule="evenodd"
									d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
									clip-rule="evenodd"
								/>
							</svg>
							<span class="sr-only">Ayuda</span>
						</>
					</button>
				</h3>
				<div
					data-popover
					id="popover-description"
					role="tooltip"
					class="dark:bg-black-800 invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 bg-white text-sm font-light text-gray-500 opacity-0 shadow-sm transition-opacity duration-300 dark:border-gray-600 dark:text-gray-400"
				>
					<div class="space-y-2 p-3">
						<h3
							class="font-semibold text-gray-900 dark:text-white"
							aria-label="Acciones rapidas"
						>
							Documentos por firmar
						</h3>
						<p>
							Encuentra aquí la lista de documentos que tienes pendientes a
							firmar para constituir tu empresa en Estados Unidos. Descarga el
							documento, firmalo electrónicamente, y subelo de nuevo dando click
							en el botón de subir documento firmado.
						</p>
					</div>
					<div data-popper-arrow />
				</div>
				<h2 class="dark:text-white-400 text-white-500 w-full">
					No hay documentos pendientes por firmar aun...
				</h2>
			</>
		)
	}
</div>
