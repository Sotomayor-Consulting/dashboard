---
import { Image } from 'astro:assets';
import { SharedBreadcrumb } from '@components/ui/bread-crumb.tsx';
import { getEmpresasGenenralById } from '@domains/companies/companies';
import edificioimg from '@assets/edificio-vidrio.avif';
import imagen from '@assets/g31.avif';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const userId = user?.id;

const empresas = userId
	? await getEmpresasGenenralById(supabase, userId)
	: null;

const paths = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Mis incorporaciones' },
];
---

<SharedBreadcrumb paths={paths} />

<div class="px-4">
	<h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
		Tus incorporaciones
	</h1>

	<div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
		{
			(empresas?.length ?? 0) === 0 ? (
				<div class="col-span-3 flex flex-col items-center rounded-lg border p-6 text-center text-gray-600 dark:text-gray-300">
					<h3 class="mb-5 text-lg font-semibold">
						No tienes incorporaciones aún
					</h3>
					<Image src={imagen} alt="Sin empresas" width={400} height={300} />
				</div>
			) : (
				empresas?.map((fr) => (
					<div class="rounded-lg border border-gray-200 bg-white shadow-sm hover:bg-gray-100 dark:border-gray-700 dark:bg-[#28314c] dark:hover:bg-[#101522]">
						<a
							href={`/my-companies/${fr.empresa_incorporacion_id}/dashboard`}
							class="flex h-full flex-col items-center p-6 md:flex-row"
						>
							<Image
								class="mb-4 h-64 w-full rounded-lg object-cover md:mb-0 md:h-auto md:w-48"
								src={edificioimg}
								alt={`Imagen empresa ${fr.nombre_1}`}
								loading="eager"
							/>
							<div class="flex w-full items-center md:p-4">
								<div class="w-full">
									<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
										{fr.nombre_1} - {fr.tipo_de_negocio}
									</h5>
									<p class="mb-6 text-gray-500 dark:text-gray-400">
										{fr.estado_de_incorporacion}
									</p>
								</div>
								<div>
									{fr.estado === 'En proceso' ? (
										<span
											data-popover-target={`tooltip-${fr.empresa_incorporacion_id}`}
											data-popover-placement="bottom-end"
											class="flex w-fit items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800 dark:bg-gray-400/20 dark:text-gray-300"
										>
											<span class="mr-1 h-2 w-2 animate-pulse rounded-full bg-orange-500" />
											{fr.estado}
										</span>
									) : (
										<span class="flex w-fit items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800 dark:bg-gray-400/20 dark:text-gray-300">
											<span class="mr-1 h-2 w-2 animate-pulse rounded-full bg-green-500" />
											{fr.estado}
										</span>
									)}
								</div>
							</div>
						</a>
						<div
							data-popover
							id={`tooltip-${fr.empresa_incorporacion_id}`}
							role="tooltip"
							class="invisible absolute z-10 inline-block w-72 rounded-lg border border-gray-200 bg-white text-sm text-gray-500 opacity-0 shadow-xs transition-opacity duration-300 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400"
						>
							<div class="space-y-2 p-3">
								<h3
									class="font-semibold text-gray-900 dark:text-white"
									aria-label="¿Por qué mi empresa está en proceso?"
								>
									¿Por qué mi empresa está en proceso?
								</h3>
								<p>Tu empresa está en proceso por estas razones:</p>
								<ul class="list-inside list-disc space-y-1">
									<li>
										Tu empresa aún no está configurada al 100% y está pendiente
										el pago para iniciar el proceso de constitución.
									</li>
									<li>
										Tu empresa está en proceso de incorporación legal (si ya
										iniciaste el proceso de pago). Te informaremos por
										notificaciones y correo.
									</li>
								</ul>
							</div>
							<div data-popper-arrow />
						</div>
					</div>
				))
			)
		}
	</div>

	<hr
		class="mx-auto my-4 h-1 w-48 rounded-sm border-0 bg-gray-100 md:my-10 dark:bg-gray-700"
	/>
</div>
