---
import '@styles/datatables.css';
import { getIncorporacionById } from '@domains/companies/incorporations';
import CrudPageHeader from '@modules/companies/components/dashboardCompanies/breadcrumbs.astro';
import { getUserFolders } from '@infrastructure/storage/test.ts';
import { getDocumentosPorFirmar } from '@domains/documents/pending-signature';
import DocumentsLIst from '@modules/companies/components/dashboardCompanies/DocumentsLIst.astro';
import SignedPanel from '@modules/companies/components/dashboardCompanies/SignedPanel.astro';
import ModalDropzone from '@modules/companies/components/dashboardCompanies/modal.astro';
import Tab from '@components/ui/tabs.astro';

interface Props {
	empresaId: string;
}

const { empresaId } = Astro.props;
const { id } = Astro.params;
const user = Astro.locals.user;
const userId = user?.id;
const nameUser = user?.user_metadata?.name || 'Usuario';
const supabase = Astro.locals.supabase;

if (!id || !userId) {
	return Astro.redirect('/');
}

const [empresa, folderPath, porfirmar] = await Promise.all([
	getIncorporacionById(supabase, id, userId),
	getUserFolders(supabase, userId, id),
	getDocumentosPorFirmar(supabase, userId, empresaId),
]);

const folderPathSafe = (folderPath || []).map((file) => ({
	...file,
	updated_at: file.updated_at || new Date().toISOString(),
}));

if (!empresa) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}

---

<div class="px-4 pt-6">
	<div class="col-span-full mb-4 xl:mb-2">
		<CrudPageHeader title={`Bienvenido ${nameUser}`} />
	</div>
	<Tab
		buttons={[
			{
				label: 'General',
				icon: 'ri:layout-grid-line',
				active: false,
				link: `/my-companies/${id}`,
			},
			{
				label: 'Documentos',
				icon: 'ri:file-copy-line',
				active: true,
				link: `/my-companies/documents/${id}`,
			},
		]}
	/>

	<div
		class="my-4 grid w-full grid-cols-1 gap-4 xl:grid-cols-2 2xl:grid-cols-3"
	>
		<DocumentsLIst
			documentos={folderPathSafe}
			userId={userId}
			empresaId={empresaId}
		/>
		<SignedPanel porfirmar={porfirmar} />
	</div>
</div>

<ModalDropzone userId={userId} empresaId={empresaId} />

<script>
	import './CompanyDashboard.client.ts';
</script>

<script>
	import './CompanyDashboardGeo.client.ts';
</script>

<script>
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.btn-ver-documento-table');
		if (!btn) return;

		const path = (btn as HTMLElement).dataset.path;
		if (!path) return;

		try {
			const res = await fetch('/api/storage/get-signed-url', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ path }),
			});
			const data = await res.json();
			if (data.error) throw new Error(data.error);
			window.open(data.signedUrl, '_blank');
		} catch (error) {
			console.error('Error al obtener documento:', error);
			alert('Error al cargar el documento');
		}
	});
</script>

<script lang="ts" define:vars={{ empresaId, userId }}>
	document.addEventListener('click', async (e) => {
		const target = e.target;
		if (!(target instanceof HTMLElement)) return;
		const btn = target.closest('.btn-upload-firmado');
		if (!btn) return;

		const fileId = btn.dataset.fileId;
		if (!fileId) return;

		const newEndpoint = `/api/documents/upload-signed?empresaId=${empresaId}&userId=${userId}&fileId=${fileId}`;

		const event = new CustomEvent('dropzone:update-endpoint', {
			detail: { id: 'ConFirma', endpoint: newEndpoint, fileId },
		});
		document.dispatchEvent(event);
	});
</script>

<style>
	.cuadro_1 {
		animation: aparecer 1.5s;
	}
	canvas {
		animation: aparecer 1.5s;
	}
	@keyframes aparecer {
		from {
			opacity: 0%;
		}
		to {
			opacity: 100%;
		}
	}
</style>

<script>
	import { DataTable } from '@third-party/simple-data-tables/simple-data-table.js';

	function initDT() {
		const el = document.querySelector('#myTable') as HTMLElement | null;
		if (!el) return;
		if ((el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit === '1')
			return;

		new DataTable(el, {
			searchable: true,
			perPage: 25,
			perPageSelect: [5, 10, 25, 50],

			// Textos en español
			labels: {
				placeholder: 'Buscar...',
				perPage: 'Filas',
				noRows: 'No hay documentos de tu empresa',
				noResults: 'No se encontraron resultados',
				info: 'Mostrando {start} de {rows} registros',
			},

			// Layout estilo Flowbite (arriba: perPage + search / abajo: info + paging)
			layout: {
				top: '{select}{search}',
				bottom: '{info}{pager}',
			},
		});

		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInit = '1';
		(el as HTMLElement & { dataset: DOMStringMap }).dataset.dtInstance = '1';
	}

	initDT();
	document.addEventListener('astro:page-load', initDT);
</script>
