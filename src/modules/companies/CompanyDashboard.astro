---
import '@styles/datatables.css';
import { Icon } from 'astro-icon/components';
import { getIncorporacionById } from '@domains/companies/incorporations';
import { getEstadoPorEmpresa } from '@domains/utils/generals/states';
import { getDocumentosPorFirmar } from '@domains/documents/pending-signature';
import { getPlanContratadoPorEmpresa } from '@domains/payments/payments';
import { getServicioUpgrade } from '@domains/services/services';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import Head from '@modules/companies/components/dashboard-companies/DashboardHeader.astro';
import Gridline2 from '@modules/companies/components/dashboard-companies/StatusGrid.astro';
import ProcessIncorp from '@modules/companies/components/dashboard-companies/IncorporationProcess.astro';
import SignedPanel from '@modules/companies/components/dashboard-companies/SignedPanel.astro';
import ModalDropzone from '@modules/companies/components/dashboard-companies/DropzoneModal.astro';
import InformationPanel from '@modules/companies/components/dashboard-companies/InformationPanel.astro';
import { getClientWorkflowProgress } from '@modules/companies/services/get-client-workflow-progress';

interface Props {
	empresaId: string | undefined;
}

const { empresaId } = Astro.props;
const user = Astro.locals.user;
const userId = user?.id;
const supabase = Astro.locals.supabase;

if (!empresaId || !userId) {
	return Astro.redirect('/');
}

const [
	empresa,
	porfirmar,
	clientWorkflowProgress,
	planContratado,
	workflowMeetingRaw,
	servicioUpgrade,
] = await Promise.all([
	getIncorporacionById(supabase, empresaId, userId),
	getDocumentosPorFirmar(supabase, userId, empresaId),
	getClientWorkflowProgress(supabaseAdmin, empresaId),
	getPlanContratadoPorEmpresa(supabase, empresaId),
	supabaseAdmin
		.rpc('get_workflow_meeting', { p_incorporation_id: empresaId })
		.then((r) => r.data),
	getServicioUpgrade(supabase).catch(() => null),
]);

const workflowMeeting = workflowMeetingRaw?.found ? workflowMeetingRaw : null;

const rawPlanName = planContratado?.servicios?.nombre ?? 'Plan Business';
const planName =
	rawPlanName.trim().toLowerCase() === 'upgrade'
		? 'Plan Business'
		: rawPlanName;

if (!empresa) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}

const clientWorkflowData = clientWorkflowProgress;

let estadoMapa = null;
if (empresa?.estado_de_incorporacion) {
	const estadoData = await getEstadoPorEmpresa(
		supabase,
		empresa.estado_de_incorporacion,
	);
	if (estadoData) estadoMapa = estadoData.name;
}

const porfirmarCount = porfirmar.length;

const stages = clientWorkflowData?.stages ?? [];
const totalStagesCount = stages.length;
const completedStagesCount = stages.filter(
	(stage) => stage.status === 'completed',
).length;
const pendingProcessesCount = stages.filter(
	(stage) => stage.status !== 'completed',
).length;
const processProgressPercent =
	totalStagesCount > 0
		? Math.round((completedStagesCount / totalStagesCount) * 100)
		: 0;

const nextStage = stages.find((s) => s.status !== 'completed') ?? null;
const nextStageName = nextStage?.name ?? null;

// Upgrade banner: empresa con estado 'Upgrade' (elegible) + al menos
// la primera etapa completada. El precio sale del servicio en DB.
const firstStageCompleted = completedStagesCount >= 1;
const upgradeAvailable =
	empresa?.estado === 'Upgrade' && firstStageCompleted && !!servicioUpgrade;
const upgradePrice = servicioUpgrade?.precio
	? Number(servicioUpgrade.precio)
	: null;

const activeTabParam = Astro.url.searchParams.get('tab');
const initialTab = activeTabParam === 'info' ? 'info' : 'general';

const tabs = [
	{
		id: 'general',
		label: 'General',
		icon: 'ri:layout-grid-line',
		kind: 'panel' as const,
	},
	{
		id: 'info',
		label: 'Información',
		icon: 'ri:information-line',
		kind: 'panel' as const,
	},
	{
		id: 'documents',
		label: 'Documentos',
		icon: 'ri:file-copy-line',
		kind: 'link' as const,
		link: `/my-companies/${empresaId}/documents`,
	},
	{
		id: 'orders',
		label: 'Ordenes',
		icon: 'ri:contract-line',
		kind: 'link' as const,
		link: `/my-companies/${empresaId}/orders`,
	},
];
---

<div class="px-4 pt-6">
	<ul
		class="dark:bg-black-900 mt-4 flex w-fit items-center gap-1 rounded-lg border border-gray-200 bg-white p-1 text-xs font-medium shadow-sm shadow-gray-200/70 md:w-auto xl:inline-flex xl:text-sm dark:border-gray-700 dark:shadow-none"
		data-tab-strip
	>
		{
			tabs.map((tab, idx) => (
				<>
					{idx > 0 && (
						<li
							aria-hidden="true"
							class="mx-1 hidden h-6 w-px self-center bg-gray-300/90 md:block dark:bg-gray-600/80"
						/>
					)}
					<li class="m-0">
						{tab.kind === 'link' ? (
							<a
								href={tab.link}
								data-astro-prefetch="viewport"
								class="link-moderate inline-flex w-full items-center gap-2 rounded-md px-3 py-2 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 md:w-auto dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white"
							>
								<Icon name={tab.icon} class="h-4 w-4" />
								{tab.label}
							</a>
						) : (
							<button
								type="button"
								data-tab-btn={tab.id}
								class:list={{
									'link-moderate inline-flex w-full items-center gap-2 rounded-md px-3 py-2 transition-colors md:w-auto': true,
									'bg-gray-100 text-gray-900 shadow-sm dark:bg-neutral-900 dark:text-white':
										tab.id === initialTab,
									'text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white':
										tab.id !== initialTab,
								}}
								aria-current={tab.id === initialTab ? 'page' : undefined}
							>
								<Icon name={tab.icon} class="h-4 w-4" />
								{tab.label}
							</button>
						)}
					</li>
				</>
			))
		}
	</ul>

	<div data-tab-panel="general" hidden={initialTab !== 'general'}>
		<Head
			empresa={empresa}
			estadoMapa={estadoMapa ?? ''}
			planName={planName}
			progressPercent={clientWorkflowData?.progressPercent ?? 0}
			completedStages={completedStagesCount}
			totalStages={totalStagesCount}
			currentStageName={clientWorkflowData?.currentStageName ?? ''}
			currentStageOrder={clientWorkflowData?.stages?.find(
				(stage) => stage.status === 'in_progress',
			)?.displayOrder ?? null}
			estimatedCompletion={clientWorkflowData?.estimatedCompletion ?? null}
			nextStageName={nextStageName}
			upgradeAvailable={upgradeAvailable}
			upgradePrice={upgradePrice}
		/>
		<Gridline2
			empresa={empresa}
			porfirmar={porfirmarCount}
			pendingProcesses={pendingProcessesCount || 0}
		/>
		<div
			class="my-4 grid w-full grid-cols-1 gap-4 xl:grid-cols-2 2xl:grid-cols-3"
		>
			<ProcessIncorp
				stages={stages}
				completedCount={completedStagesCount}
				totalCount={totalStagesCount}
				progressPercent={processProgressPercent}
				empresaId={empresaId}
				userId={userId}
				meeting={workflowMeeting}
			/>
			<SignedPanel porfirmar={porfirmar} />
		</div>
	</div>

	<div data-tab-panel="info" hidden={initialTab !== 'info'}>
		<InformationPanel empresa={empresa} estadoMapa={estadoMapa ?? ''} />
	</div>
</div>

<ModalDropzone userId={userId} empresaId={empresaId} />

<script>
	import './company-dashboard.client.ts';
</script>

<script>
	import './company-dashboard-geo.client.ts';
</script>

<script>
	const buttons =
		document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
	const panels = document.querySelectorAll<HTMLElement>('[data-tab-panel]');
	const activeClasses = [
		'dark:bg-black-700',
		'bg-gray-100',
		'text-gray-900',
		'shadow-sm',
		'dark:text-white',
	];
	const inactiveClasses = [
		'text-gray-600',
		'hover:bg-gray-100',
		'hover:text-gray-900',
		'dark:text-gray-300',
		'dark:hover:bg-white/5',
		'dark:hover:text-white',
	];

	function setTab(id: string) {
		panels.forEach((p) => {
			p.hidden = p.dataset['tabPanel'] !== id;
		});
		buttons.forEach((b) => {
			const isActive = b.dataset['tabBtn'] === id;
			if (isActive) {
				b.classList.add(...activeClasses);
				b.classList.remove(...inactiveClasses);
				b.setAttribute('aria-current', 'page');
			} else {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
				b.removeAttribute('aria-current');
			}
		});
		const url = new URL(window.location.href);
		if (id === 'general') url.searchParams.delete('tab');
		else url.searchParams.set('tab', id);
		window.history.replaceState({}, '', url.toString());
		// Re-trigger map render if switching to info
		if (id === 'info') {
			document.dispatchEvent(new CustomEvent('dark-mode'));
		}
	}

	buttons.forEach((b) => {
		b.addEventListener('click', () => {
			const id = b.dataset['tabBtn'];
			if (id) setTab(id);
		});
	});
</script>

<script>
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.btn-ver-documento-table');
		if (!btn) return;

		const path = (btn as HTMLElement).dataset['path'];
		if (!path) return;

		try {
			const res = await fetch('/api/storage/get-signed-url', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ path }),
			});
			const data = await res.json();
			if (data.error) throw new Error(data.error);
			window.open(data.signedUrl, '_blank');
		} catch (error) {
			console.error('Error al obtener documento:', error);
			alert('Error al cargar el documento');
		}
	});
</script>

<script is:inline define:vars={{ empresaId, userId }}>
	document.addEventListener('click', async (e) => {
		const target = e.target;
		if (!(target instanceof HTMLElement)) return;
		const btn = target.closest('.btn-upload-firmado');
		if (!btn) return;

		const fileId = btn.dataset.fileId;
		if (!fileId) return;

		const newEndpoint = `/api/documents/upload-signed?empresaId=${empresaId}&userId=${userId}&fileId=${fileId}`;

		const event = new CustomEvent('dropzone:update-endpoint', {
			detail: { id: 'ConFirma', endpoint: newEndpoint, fileId },
		});
		document.dispatchEvent(event);
	});
</script>

<style>
	.cuadro_1 {
		animation: aparecer 1.5s;
	}
	canvas {
		animation: aparecer 1.5s;
	}
	@keyframes aparecer {
		from {
			opacity: 0%;
		}
		to {
			opacity: 100%;
		}
	}
</style>
