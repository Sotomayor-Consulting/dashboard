---
import '@styles/datatables.css';
import { getIncorporacionById } from '@domains/companies/incorporations';
import { getEstadoPorEmpresa } from '@domains/utils/generals/states';
import { getDocumentosPorFirmar } from '@domains/documents/pending-signature';
import { getPlanContratadoPorEmpresa } from '@domains/payments/payments';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import Head from '@modules/companies/components/dashboardCompanies/Gridhead.astro';
import Gridline2 from '@modules/companies/components/dashboardCompanies/Gridlenetwo.astro';
import ProcessIncorp from '@modules/companies/components/dashboardCompanies/ProcessIncorp.astro';
import SignedPanel from '@modules/companies/components/dashboardCompanies/SignedPanel.astro';
import ModalDropzone from '@modules/companies/components/dashboardCompanies/modal.astro';
import { getClientWorkflowProgress } from '@modules/companies/services/getClientWorkflowProgress';
import Tab from '@components/ui/tabs.astro';

interface Props {
	empresaId: string | undefined;
}

const { empresaId } = Astro.props;
const user = Astro.locals.user;
const userId = user?.id;
const supabase = Astro.locals.supabase;

if (!empresaId || !userId) {
	return Astro.redirect('/');
}

const [empresa, porfirmar, clientWorkflowProgress, planContratado] =
	await Promise.all([
		getIncorporacionById(supabase, empresaId, userId),
		getDocumentosPorFirmar(supabase, userId, empresaId),
		getClientWorkflowProgress(supabaseAdmin, empresaId),
		getPlanContratadoPorEmpresa(supabase, empresaId),
	]);

// El servicio "Upgrade" promueve la empresa al Plan Business — mostrar el
// plan resultante en lugar del nombre del servicio de upgrade.
const rawPlanName = planContratado?.servicios?.nombre ?? 'Plan Business';
const planName =
	rawPlanName.trim().toLowerCase() === 'upgrade'
		? 'Plan Business'
		: rawPlanName;

if (!empresa) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}

const clientWorkflowData = clientWorkflowProgress;

// Obtener estado de incorporación para el mapa
let estadoMapa = null;
if (empresa?.estado_de_incorporacion) {
	const estadoData = await getEstadoPorEmpresa(
		supabase,
		empresa.estado_de_incorporacion,
	);

	if (estadoData) {
		estadoMapa = estadoData.Estado;
	}
}

const FormateadorFecha = new Intl.DateTimeFormat('es-ES', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const porfirmarCount = porfirmar.length;

const stageIconBySlug: Record<string, string> = {
	planning_meeting: 'ri:calendar-schedule-line',
	client_form: 'ri:file-list-3-line',
	state_registration: 'ri:government-line',
	fiscal_documents: 'ri:file-paper-2-line',
	document_signing: 'ri:quill-pen-line',
	ein_request: 'ri:profile-line',
	boir_registration: 'ri:shield-check-line',
	bank_account: 'ri:bank-line',
	stripe_account: 'ri:bank-card-line',
	tax_election_8832: 'ri:calculator-line',
	be13: 'ri:building-4-line',
};

const stageDescriptionBySlug: Record<string, string> = {
	planning_meeting:
		'Coordinamos y agendamos la reunión de planificación con tu asesor.',
	client_form:
		'Completa el formulario inicial con los datos de tu empresa y responsables.',
	state_registration:
		'Presentamos la incorporación ante la secretaría del estado correspondiente.',
	fiscal_documents:
		'Preparamos, revisamos y organizamos los documentos fiscales requeridos.',
	document_signing: 'Te enviamos la documentación final para revisión y firma.',
	ein_request: 'Gestionamos la solicitud del EIN de tu empresa ante el IRS.',
	boir_registration:
		'Realizamos el registro BOIR ante FinCEN con la información validada.',
	bank_account: 'Te acompañamos en la apertura de cuenta bancaria empresarial.',
	stripe_account:
		'Configuramos y dejamos operativa tu cuenta Stripe empresarial.',
	tax_election_8832:
		'Procesamos la elección tributaria corporativa mediante el Form 8832.',
	be13: 'Preparamos y enviamos el reporte BE-13 cuando aplica para tu caso.',
};

const processTasks = clientWorkflowData
	? clientWorkflowData.stages.map((stage) => ({
			title: stage.name,
			description:
				stageDescriptionBySlug[stage.slug] ??
				`Etapa ${stage.slug.replaceAll('_', ' ')}.`,
			date: stage.dueAt ? FormateadorFecha.format(new Date(stage.dueAt)) : '-',
			completed:
				stage.status === 'completed'
					? 'Completado'
					: stage.status === 'in_progress'
						? 'En proceso'
						: 'Por completar',
			icon: stageIconBySlug[stage.slug] ?? 'ri:file-list-3-line',
		}))
	: [
			{
				title: 'Registro de la empresa',
				description: 'Hemos registrado tu empresa en el estado seleccionado.',
				date: FormateadorFecha.format(
					new Date(empresa?.fecha_de_validacion || '2024-03-22T14:30:00.000Z'),
				),
				completed: 'Completado',
				icon: 'ri:check-line',
			},
			{
				title: 'Obtención del EIN',
				description:
					'Estamos gestionando el número de identificación fiscal de tu empresa.',
				date: FormateadorFecha.format(
					new Date(empresa?.fecha_de_validacion || '2024-03-22T14:30:00.000Z'),
				),
				completed: 'En proceso',
				icon: 'ri:profile-line',
			},
			{
				title: 'Cuenta bancaria',
				description:
					'Próximamente te ayudaremos a abrir una cuenta bancaria para tu empresa.',
				completed: 'Por completar',
				icon: 'ri:bank-line',
			},
		];

const completedStagesCount = 0;

// const completedStagesCount = clientWorkflowData.stages.filter(
// 	(stage) => stage.status === 'completed',
// ).length;
// const totalStagesCount =
// 	clientWorkflowData.stages.length > 0
// 		? clientWorkflowData.stages.length
// 		: processTasks.length;
// const processProgressPercent =
// 	totalStagesCount > 0
// 		? Math.round((completedStagesCount / totalStagesCount) * 100)
// 		: 0;
// const pendingProcessesCount = clientWorkflowData.stages.filter(
// 	(stage) => stage.status !== 'completed',
// ).length;

const pendingProcessesCount = 0;
const processProgressPercent = 0;
const totalStagesCount = 0;
---

<div class="px-4 pt-6">
	<Tab
		buttons={[
			{
				label: 'General',
				icon: 'ri:layout-grid-line',
				active: true,
				link: `/my-companies/${empresaId}/dashboard`,
			},
			{
				label: 'Documentos',
				icon: 'ri:file-copy-line',
				active: false,
				link: `/my-companies/${empresaId}/documents`,
			},
			{
				label: 'Ordenes',
				icon: 'ri:contract-line',
				active: false,
				link: `/my-companies/${empresaId}/orders`,
			},
		]}
	/>

	<Head
		empresa={empresa}
		estadoMapa={estadoMapa ?? ''}
		planName={planName}
		progressPercent={clientWorkflowData?.progressPercent ?? 0}
		completedStages={completedStagesCount}
		totalStages={totalStagesCount}
		currentStageName={clientWorkflowData?.currentStageName ?? ''}
		currentStageOrder={clientWorkflowData?.stages?.find(
			(stage) => stage.status === 'in_progress',
		)?.displayOrder ?? null}
		estimatedCompletion={clientWorkflowData?.estimatedCompletion ?? null}
	/>
	<Gridline2
		empresa={empresa}
		porfirmar={porfirmarCount}
		pendingProcesses={pendingProcessesCount || 0}
	/>
	<div
		class="my-4 grid w-full grid-cols-1 gap-4 xl:grid-cols-2 2xl:grid-cols-3"
	>
		<ProcessIncorp
			tasks={processTasks}
			completedCount={completedStagesCount}
			totalCount={totalStagesCount}
			progressPercent={processProgressPercent}
		/>
		<SignedPanel porfirmar={porfirmar} />
	</div>
</div>

<ModalDropzone userId={userId} empresaId={empresaId} />

<script>
	import './CompanyDashboard.client.ts';
</script>

<script>
	import './CompanyDashboardGeo.client.ts';
</script>

<script>
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.btn-ver-documento-table');
		if (!btn) return;

		const path = (btn as HTMLElement).dataset.path;
		if (!path) return;

		try {
			const res = await fetch('/api/storage/get-signed-url', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ path }),
			});
			const data = await res.json();
			if (data.error) throw new Error(data.error);
			window.open(data.signedUrl, '_blank');
		} catch (error) {
			console.error('Error al obtener documento:', error);
			alert('Error al cargar el documento');
		}
	});
</script>

<script lang="ts" define:vars={{ empresaId, userId }}>
	document.addEventListener('click', async (e) => {
		const target = e.target;
		if (!(target instanceof HTMLElement)) return;
		const btn = target.closest('.btn-upload-firmado');
		if (!btn) return;

		const fileId = btn.dataset.fileId;
		if (!fileId) return;

		const newEndpoint = `/api/documents/upload-signed?empresaId=${empresaId}&userId=${userId}&fileId=${fileId}`;

		const event = new CustomEvent('dropzone:update-endpoint', {
			detail: { id: 'ConFirma', endpoint: newEndpoint, fileId },
		});
		document.dispatchEvent(event);
	});
</script>

<style>
	.cuadro_1 {
		animation: aparecer 1.5s;
	}
	canvas {
		animation: aparecer 1.5s;
	}
	@keyframes aparecer {
		from {
			opacity: 0%;
		}
		to {
			opacity: 100%;
		}
	}
</style>
