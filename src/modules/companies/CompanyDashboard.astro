								</div>

								<div class="rounded-lg border border-gray-200 p-4 dark:border-gray-700">
									<div class="mb-3 flex items-center justify-between">
										<h4 class="text-base font-semibold text-gray-900 dark:text-white">
											Documentos
										</h4>
										<span class="text-xs text-gray-500 dark:text-gray-400">
											{documentsNew.length}
										</span>
									</div>

									{documentsNew.length === 0 ? (
										<p class="text-sm text-gray-500 dark:text-gray-400">
											Aun no hay documentos.
										</p>
									) : (
										<ul class="divide-y divide-gray-200 dark:divide-gray-700">
											{documentsNew.slice(0, 8).map((d) => (
												<li class="flex items-start justify-between gap-3 py-3">
													<div class="min-w-0">
														<p class="truncate text-sm font-semibold text-gray-900 dark:text-white">
															{d.file_title ?? d.file_name}
														</p>
														<div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
															<span>
																{d.document_type?.name ?? 'Documento'}
															</span>
															<Badge variant={badgeForDocumentStatus(d.status)}>
																{d.status}
															</Badge>
														</div>
													</div>
													<DocumentActionsDropdown
														client:load
														documentId={d.id}
														showRevoke={isStaff}
														sharedWithUserId={empresa.user_id ?? undefined}
														canRevoke={
															!!empresa.user_id &&
															(d.shares?.some(
																(share) =>
																	share.shared_with_user_id ===
																		empresa.user_id &&
																	share.share_status === 'active',
															) ??
																false)
														}
													/>
												</li>
											))}
										</ul>
									)}

									{documentsNew.length > 8 ? (
										<p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
											Mostrando 8 de {documentsNew.length}. Usa “Abrir” para ver
											todo.
										</p>
									) : null}
								</div>
							</div>
						</div>
					</section>

					<section
						id="company-storage-panel"
						class="hidden"
						role="tabpanel"
						aria-labelledby="company-storage-tab"
					>
						<div class="dark:bg-black-800 bg-white-50 my-4 rounded-lg border border-gray-200 p-4 shadow-sm sm:p-6 dark:border-gray-700">
							{/* Card header */}
							<div class="items-center justify-between lg:flex">
								<div class="mb-4 lg:mb-0">
									<h3 class="mb-2 text-xl font-bold text-gray-900 dark:text-white">
										Documentos (Storage)
									</h3>
									<span class="text-base font-normal text-gray-500 dark:text-gray-400">
										Lista de archivos en Storage
									</span>
								</div>
							</div>
							<div class="mt-6">
								<CompanyStorageTable
									client:load
									folderPath={folderPath}
									userId={userId}
									companyId={id}
								/>
							</div>
						</div>
					</section>
				</div>
			</div>
			<div
				id="popup-modal"
				tabindex="-1"
				class="fixed top-0 right-0 left-0 z-50 hidden h-[calc(100%-1rem)] max-h-full w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0"
			>
				<div class="relative max-h-full w-full max-w-3xl p-4">
					<div class="bg-neutral-primary-soft border-default rounded-base relative border p-4 shadow-sm md:p-6">
						<button
							type="button"
							class="text-body hover:bg-neutral-tertiary hover:text-heading rounded-base absolute inset-e-2.5 top-3 ms-auto inline-flex h-9 w-9 items-center justify-center bg-transparent text-sm"
							data-modal-hide="popup-modal"
						>
							<svg
								class="h-5 w-5"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								fill="none"
								viewBox="0 0 24 24"
							>
								<path
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M6 18 17.94 6M18 18 6.06 6"
								/>
							</svg>
							<span class="sr-only">Close modal</span>
						</button>
						<div class="p-4 text-center md:p-5">
							<Dropzone
								mensaje="Arrastra el documento pendiente a firmar aquí o haz clic para subir."
								id="ConFirma"
								endpoint={`/api/documentos/upload_file_signed?empresaId=${empresaId}&userId=${userId}`}
							/>
						</div>
					</div>
				</div>
			</div>
		</>
	)
}

<script>
	import './CompanyDashboard.client.ts';
</script>

<script>
	import './CompanyDashboardGeo.client.ts';
</script>

<script>
	document.addEventListener('click', async (e) => {
		const target = e.target as HTMLElement;
		const btn = target.closest('.btn-ver-documento-table');
		if (!btn) return;

		const path = (btn as HTMLElement).dataset.path;
		if (!path) return;

		try {
			const res = await fetch('/api/storage/get-signed-url', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ path }),
			});
			const data = await res.json();
			if (data.error) throw new Error(data.error);
			window.open(data.signedUrl, '_blank');
		} catch (error) {
			console.error('Error al obtener documento:', error);
			alert('Error al cargar el documento');
		}
	});
</script>

<script lang="ts" define:vars={{ empresaId, userId }}>
	document.addEventListener('click', async (e) => {
		const target = e.target;
		if (!(target instanceof HTMLElement)) return;
		const btn = target.closest('.btn-upload-firmado');
		if (!btn) return;

		const fileId = btn.dataset.fileId;
		if (!fileId) return;

		const newEndpoint = `/api/documentos/upload_file_signed?empresaId=${empresaId}&userId=${userId}&fileId=${fileId}`;

		const event = new CustomEvent('dropzone:update-endpoint', {
			detail: { id: 'ConFirma', endpoint: newEndpoint, fileId },
		});
		document.dispatchEvent(event);
	});
</script>

