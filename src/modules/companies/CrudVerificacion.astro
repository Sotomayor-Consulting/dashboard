---
import DataTable from '@components/ui/DataTable.astro';
import StatusBadge from '@components/ui/StatusBadge.astro';
import DateCell from '@components/ui/DateCell.astro';
import StackedText from '@components/ui/StackedText.astro';
import { FormsEnviosVericacion } from '@lib/tablas/forms/formulariosEnviados';

const supabase = Astro.locals.supabase;

const formularios = await FormsEnviosVericacion(supabase);
---

<div
	class="block items-center justify-between border-b border-gray-200 p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<div class="mb-1 w-full">
		<div class="mb-4">
			<nav class="mb-5 flex" aria-label="Breadcrumb">
				<ol
					class="inline-flex items-center space-x-1 text-sm font-medium md:space-x-2"
				>
					<li class="inline-flex items-center">
						<a
							href="/"
							class="inline-flex items-center text-gray-700 hover:text-[#967432] dark:text-gray-300 dark:hover:text-white"
						>
							<svg
								class="mr-2.5 h-5 w-5"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
								></path></svg
							>
							Inicio
						</a>
					</li>
					<li>
						<div class="flex items-center">
							<svg
								class="h-6 w-6 text-gray-400"
								fill="currentColor"
								viewBox="0 0 20 20"
								xmlns="http://www.w3.org/2000/svg"
								><path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"></path></svg
							>
							<a
								href="/crud/empresas"
								class="ml-1 text-gray-700 hover:text-[#967432] md:ml-2 dark:text-gray-300 dark:hover:text-white"
								>Verificación</a
							>
						</div>
					</li>
				</ol>
			</nav>
			<h1
				class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white"
			>
				Lista de formularios
			</h1>
		</div>
	</div>
</div>

<DataTable
	headers={[
		'NOMBRE DEL FORMULARIO',
		'SUBIDO POR',
		'PORCENTAJE DE PROGRESO',
		'FECHA DE INICIO DEL FORMULARIO',
		'FECHA DE ULTIMA ACTUALIZACION',
		'FECHA DE ULTIMA SUBIDA',
		'ESTADO',
	]}
	noRowsMessage="No hay formularios a verificar"
	noResultsMessage="No se encontraron formularios aun"
>
	{
		formularios?.map((formularios) => (
			<tr
				class="dark:bg-black-900 cursor-pointer border-b border-gray-200 bg-white hover:bg-gray-50 dark:border-gray-700 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]"
				onclick={`window.open('/forms/validaciones/${formularios.submission_id}', '_blank')`}
			>
				<th
					scope="row"
					class="px-6 py-4 font-medium whitespace-nowrap text-gray-900 dark:text-white"
				>
					<StackedText
						title={formularios.formularios?.titulo ?? '— sin título —'}
						subtitle={formularios.formularios?.slug ?? '— sin ctaegoria —'}
					/>
				</th>
				<td class="px-6 py-4">
					<data value="">
						{formularios.usuarios.nombre} {formularios.usuarios.apellido}
					</data>
				</td>
				<td class="px-6 py-4">
					<data value="">% {formularios.progress_percent ?? '0'}</data>
				</td>
				<td class="px-6 py-4">
					<DateCell date={formularios.created_at} />
				</td>
				<td class="px-6 py-4">
					<DateCell date={formularios.updated_at} />
				</td>
				<td class="px-6 py-4">
					<DateCell date={formularios.submitted_at} />
				</td>
				<td class="px-6 py-4">
					<StatusBadge
						active={formularios.status === 'submitted'}
						activeLabel="Terminado"
						inactiveLabel="En progreso"
						activeColor="bg-green-400"
						inactiveColor="bg-orange-400"
					/>
				</td>
			</tr>
		))
	}
</DataTable>
