---
import { getCompanyPageData } from './services/get-company-page-data';
import CompanyInfoSection from './islands/company-details/sections/CompanyInfoSection';
import CompanyAddressesPanel from './islands/CompanyAddressesPanel';
import CompanyMembersPanel from './islands/CompanyMembersPanel';
import CompanyDocumentsCrudPanel from './islands/CompanyDocumentsPanel';
import TabBar, { type TabButton } from '@components/navigation/TabBar.astro';
import { canManageCompanyData, hasAnyRole, ROLE_GROUPS } from '@shared/roles';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import {
	getDocumentTypesList,
	getDocumentsForCompany,
	type DocumentDashboardRow,
	type DocumentTypeLite,
} from '@domains/documents/document_dashboard';

export type CompanyPageView = 'general' | 'members' | 'documents';

interface Props {
	companyId: string;
	view?: CompanyPageView;
}

const UUID_RE =
	/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

const { companyId, view = 'general' } = Astro.props as Props;
const supabase = Astro.locals.supabase;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];
const canEditDetails = canManageCompanyData(userRoles);
const isStaff = hasAnyRole(userRoles, ROLE_GROUPS.INCORPORATION_ROUTE);

const trimmedId = companyId?.trim() ?? '';
const isValidId = UUID_RE.test(trimmedId);

const data = isValidId ? await getCompanyPageData(supabase, trimmedId, supabaseAdmin) : null;
const errorMessage = !isValidId
	? 'ID de empresa inválido'
	: !data
		? 'No se encontró esta empresa'
		: '';

// Documentos: solo se cargan en la vista de documentos.
let documents: DocumentDashboardRow[] = [];
let documentTypes: DocumentTypeLite[] = [];
if (view === 'documents' && data && userId) {
	[documents, documentTypes] = await Promise.all([
		getDocumentsForCompany(supabaseAdmin, trimmedId, userId, userRoles).catch(
			() => [],
		),
		getDocumentTypesList(supabaseAdmin),
	]);
}

const base = `/admin/companies/${trimmedId}`;
const onGeneral = view === 'general';

const tabs: TabButton[] = [
	{
		label: 'Información',
		icon: 'ri:file-edit-line',
		kind: onGeneral ? 'panel' : 'link',
		id: 'informacion',
		link: base,
		active: onGeneral,
	},
	{
		label: 'Direcciones',
		icon: 'ri:map-pin-line',
		kind: onGeneral ? 'panel' : 'link',
		id: 'direcciones',
		link: `${base}?tab=direcciones`,
		active: false,
	},
	{
		label: 'Miembros',
		icon: 'ri:group-line',
		kind: 'link',
		link: `${base}/members`,
		active: view === 'members',
	},
	{
		label: 'Documentos',
		icon: 'ri:file-copy-line',
		kind: 'link',
		link: `${base}/documents`,
		active: view === 'documents',
	},
];
---

{
	errorMessage ? (
		<div class="mx-5 mt-5">
			<div class="border-border text-muted-foreground rounded-lg border border-dashed p-6 text-sm">
				{errorMessage}
			</div>
		</div>
	) : data ? (
		<div>
			<TabBar buttons={tabs} />

			<div class="mt-5">
				{onGeneral && (
					<>
						<div data-tab-panel="informacion">
							<CompanyInfoSection
								client:load
								company={data.company}
								managementTypeHealth={data.managementTypeHealth}
								actividades={data.actividades}
								canEditDetails={canEditDetails}
							/>
						</div>

						<div data-tab-panel="direcciones" hidden>
							<CompanyAddressesPanel
								client:load
								addresses={data.addresses}
								companyId={trimmedId}
								canEditDetails={canEditDetails}
							/>
						</div>
					</>
				)}

				{view === 'members' && (
					<CompanyMembersPanel
						client:load
						initialMembers={data.companyMembers}
						companyId={trimmedId}
						canEditDetails={canEditDetails}
					/>
				)}

				{view === 'documents' && (
					<CompanyDocumentsCrudPanel
						client:load
						documents={documents}
						documentTypes={documentTypes}
						companyId={trimmedId}
						incorporationId={data.incorporationId}
						companyOwnerUserId={data.company.user_id ?? null}
						canEditDetails={canEditDetails}
						isStaff={isStaff}
					/>
				)}
			</div>
		</div>
	) : null
}

