---
import TabBar from '@components/navigation/TabBar.astro';
import { supabaseAdmin } from '@infrastructure/supabase/admin';
import InformationPanel from './components/dashboard-companies/InformationPanel.astro';
import CompanyAddressesPanel from './components/dashboard-companies/CompanyAddressesPanel.astro';
import { getCompanyClientViewData } from './services/get-company-client-view-data';
import { companyClientTabs } from './company-tabs';
import type { CompanyEntityType } from '@domains/companies/types/company';

interface Props {
	companyId: string | undefined;
}

const { companyId } = Astro.props;
const user = Astro.locals.user;
const userId = user?.id;
const supabase = Astro.locals.supabase;

if (!companyId || !userId) {
	return Astro.redirect('/');
}

// Ownership: la empresa debe ser visible para el usuario de la sesión (RLS de
// companies: dueño o staff). Solo tras este check se usa supabaseAdmin en el
// agregador (RLS de members/addresses para clientes llega en F4 del plan).
const { data: ownedCompany } = await supabase
	.from('companies')
	.select('id')
	.eq('id', companyId)
	.maybeSingle<{ id: string }>();

if (!ownedCompany) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}

const userRoles = Astro.locals.userRoles ?? [];
const data = await getCompanyClientViewData(supabaseAdmin, companyId, {
	userId,
	userRoles,
});

if (!data.company) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}

const panelData = {
	legal_name: data.company.legal_name ?? 'Empresa',
	entity_type: (data.company.entity_type ?? 'llc') as CompanyEntityType,
	incorporation_date: data.company.incorporation_date,
	formation_state_name: data.company.formation_state_name,
	identification_number: data.company.identification_number,
	filing_number: data.company.filing_number,
	created_at: data.company.created_at,
};

const tabs = companyClientTabs(companyId, 'company');
---

<div>
	<TabBar buttons={tabs} />

	<div data-tab-panel="company" class="gird-cols-2">
		<InformationPanel company={panelData} />
		<CompanyAddressesPanel addresses={data.addresses} />
	</div>
</div>
