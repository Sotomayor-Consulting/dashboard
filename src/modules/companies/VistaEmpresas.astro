---
import '@styles/datatables.css';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import imagenempresa from '@assets/edificios-vista.avif';
import { getSociosByEmpresa } from '@lib/tablas/socios';
import { actividadesGeneral } from '@lib/tablas/actividades';
import { getManagerByEmpresa } from '@lib/tablas/managers';
import { PaisesGeneral } from '@lib/tablas/paises';
import { EstadosGeneral } from '@lib/tablas/estados';
import { getEmpresaById } from '@lib/tablas/empresas';

interface Props {
	empresaId: string;
}

const { empresaId } = Astro.props;
const supabase = Astro.locals.supabase;

const [socios, managers, actividades, paises, estados, empresa] =
	await Promise.all([
		getSociosByEmpresa(supabase, empresaId),
		getManagerByEmpresa(supabase, empresaId),
		actividadesGeneral(supabase),
		PaisesGeneral(supabase),
		EstadosGeneral(supabase),
		getEmpresaById(supabase, empresaId),
	]);

const esMember_Managed = empresa?.forma_administracion === 'Member-Managed';
---

<div class="mt-5 mx-5">
	<div class="mb-4 border-b border-neutral-200 dark:border-[#1f3443]">
		<ul
			class="flex flex-wrap -mb-px text-sm font-medium text-center"
			id="default-tab"
			data-tabs-toggle="#default-tab-content"
			role="tablist"
			data-tabs-active-classes="text-[#8c681d] hover:text-[#8c681d] dark:text-[#8c681d] dark:hover:text-[#8c681d] border-[#8c681d] dark:border-[#8c681d]"
			data-tabs-inactive-classes="dark:border-transparent text-neutral-500 hover:text-neutral-600 dark:text-neutral-400 border-neutral-100 hover:border-neutral-300 dark:border-neutral-700 dark:hover:text-neutral-300"
		>
			{
				[
					{
						id: 'profile-tab',
						tabs: 'profile',
						label: 'Datos Generales',
						icono: 'ri:building-2-fill',
					},
					{
						id: 'contacts-tab',
						tabs: 'contacts',
						label: 'Editar datos',
						icono: 'ri:edit-fill',
					},
				].map((i) => (
					<li class="me-2" role="presentation">
						<button
							class="p-4 border-b-2 rounded-t-lg flex items-center gap-2"
							id={i.id}
							data-tabs-target={`#${i.tabs}`}
							type="button"
							role="tab"
							aria-controls={i.tabs}
							aria-selected="false"
						>
							<Icon name={i.icono} class="text-lg" />
							{i.label}
						</button>
					</li>
				))
			}
		</ul>
	</div>
	<div id="default-tab-content">
		<div
			class="hidden p-4 rounded-lg grid lg:grid-cols-2 xl:grid-cols-3 md:grid-cols-1 gap-4"
			id="profile"
			role="tabpanel"
			aria-labelledby="profile-tab"
		>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 flex flex-col p-14 md:mb-0 mb-2 lg:col-span-1 col-span-2"
			>
				<div class="flex">
					<p class="font-bold text-base text-neutral-500">
						Nombre de la empresa
					</p>

					<button
						data-popover-target="popover-description"
						data-popover-placement="bottom-end"
						type="button"
						><svg
							class="w-4 h-4 ms-2 text-neutral-500 hover:text-neutral-600"
							aria-hidden="true"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
								clip-rule="evenodd"></path></svg
						><span class="sr-only">Mostrar información</span></button
					>
					<div
						data-popover
						id="popover-description"
						role="tooltip"
						class="absolute z-10 invisible inline-block text-sm text-neutral-500 transition-opacity duration-300 bg-white border border-neutral-200 rounded-lg shadow-xs opacity-0 w-72 dark:bg-black-800 dark:border-neutral-600 dark:text-neutral-400"
					>
						<div class="p-3 space-y-2">
							<h3
								class="font-semibold text-neutral-900 dark:text-white"
								aria-label="¿Porque se muestra este nombre?"
							>
								¿Porque se muestra este nombre?
							</h3>
							<p>
								Este nombre corresponde al registro inicial realizado durante la
								creación de la empresa mediante el dashboard de Sotomayor
								Consulting. Existen dos denominaciones opcionales adicionales.
								En caso de requerir una edición por motivos operativos, es
								necesario verificar y contrastar la información con los
								documentos oficiales disponibles.
							</p>
						</div>
						<div data-popper-arrow></div>
					</div>
				</div>

				<div
					class="flex gap-10 items-center dark:text-neutral-300 text-neutral-800"
				>
					<div class="flex gap-5">
						<div>
							<p class="font-bold lg:text-4xl text-3xl">
								{empresa.nombre_1} - {empresa.tipo_de_negocio}
							</p>
						</div>
						<div>
							{
								empresa.estado === 'Activo' ? (
									<span class="bg-green-100 text-green-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded-full dark:bg-green-900/50 dark:text-green-300 flex items-center mt-2 w-full">
										<div class="h-2.5 w-2.5 rounded-full bg-green-400 mr-2 animate-pulse" />
										{empresa.estado}
									</span>
								) : (
									<span class="bg-green-100 text-orange-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded-full dark:bg-orange-900/50 dark:text-orange-300 flex items-center mt-2 w-full">
										<div class="h-2.5 w-2.5 rounded-full bg-orange-500 mr-2" />
										{empresa.estado}
									</span>
								)
							}
						</div>
					</div>
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 text-neutral-800 flex flex-col md:mb-0 mb-2 md:col-span-1 col-span-2 p-14 justify-center"
			>
				<div class="flex">
					<p class="font-bold text-base text-neutral-500">
						Lugar de la empresa
					</p>
				</div>

				<div class="flex gap-5 items-center">
					<div class="flex flex-col gap-5">
						<div>
							<p class="font-bold lg:text-4xl text-3xl">
								{empresa.estado_de_incorporacion}
							</p>
						</div>
					</div><Icon name="ri:road-map-fill" class="text-4xl" />
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 text-neutral-800 flex flex-col p-14 md:mb-0 mb-2 md:col-span-1 col-span-2 justify-center"
			>
				<div class="flex">
					<p class="font-bold text-base text-neutral-500">
						Porcentaje de incorporación
					</p>
				</div>

				<div class="flex gap-10 items-center">
					<div class="flex flex-col gap-5">
						<div>
							<p class="font-bold text-4xl">
								{empresa.porcentaje_de_incorporacion}%
							</p>
						</div>
					</div>
					<div class="w-full bg-neutral-200 rounded-full dark:bg-black-800">
						<div
							class="bg-[#8c681d] dark:bg-[#134aed] text-blue-100 text-center p-1 leading-none rounded-full"
							style={`width: ${empresa.porcentaje_de_incorporacion}%`}
						>
						</div>
					</div>
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 flex col-span-2 relative"
			>
				<Image
					src={imagenempresa}
					alt="Edificios"
					class="object-cover w-full rounded-t-lg h-96 md:h-auto md:w-2/5 md:rounded-none md:rounded-s-lg md:block hidden"
					loading="eager"
				/>
				<div
					class="h-fit bg-[#1f3443] rounded-md bg-clip-padding backdrop-filter
				backdrop-blur-md bg-opacity-10 border border-neutral-400 absolute bottom-4 left-4 p-2 lg:block hidden"
				>
					<p class="font-normal text-white text-sm">Empresa id:</p>
					<p class="font-light text-white text-xs">
						#{empresaId}
					</p>
				</div>
				<div class="flex flex-col justify-center p-5 leading-normal">
					<div>
						<h5
							class="mb-2 text-2xl font-bold tracking-tight dark:text-neutral-300 text-neutral-800"
						>
							Nombres de la compañía
						</h5>
						<p
							class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-3xl"
						>
							{empresa.nombre_1}, {empresa.nombre_2}, {empresa.nombre_3}
						</p>
					</div>
					<div class="grid lg:grid-cols-2 grid-cols-1 gap-2 mt-10">
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Actividad de la compañía
							</h5>
							<p
								class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-base"
							>
								{empresa.actividad}
							</p>
						</div>
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Forma de tributar
							</h5>
							<p
								class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-base"
							>
								{empresa.forma_tributacion}
							</p>
						</div>
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Obtendrá ingresos desde EE.UU.
							</h5>
							<p
								class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-base"
							>
								{
									empresa.Obtendra_ingresos_desde_eeuu === true
										? 'Si obtendrá ingresos'
										: 'No obtendrá ingresos'
								}
							</p>
						</div>
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Forma de administración
							</h5>
							<p
								class="mb-3 font-normal text-neutral-700 dark:text-neutral-400"
							>
								{empresa.forma_administracion}
							</p>
						</div>
					</div>
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-2 lg:col-span-1"
			>
				<div
					class="bg-[#d4d4d4] dark:bg-[#134aed] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold"
				>
					<Icon name="ri:shake-hands-fill" />
					<p>Socios</p>
				</div>
				<div class="flow-root p-4">
					{
						(socios?.length ?? 0) === 0 ? (
							<p>No hay ningún socio aun</p>
						) : (
							<ul
								role="list"
								class="divide-y divide-neutral-200 dark:divide-neutral-700"
							>
								{socios?.map((s) => (
									<li class="py-3 sm:py-4">
										<div class="flex items-center">
											<div class="shrink-0">
												<Image
													class="w-8 h-8 rounded-full"
													src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${s.nombre_de_socio}`}
													alt={`avatar de ${s.nombre_de_socio}`}
													inferSize={true}
													loading="eager"
												/>
											</div>
											<div class="flex-1 min-w-0 ms-4">
												<p class="text-sm font-medium text-neutral-900 truncate dark:text-white">
													{s.nombre_de_socio}
												</p>
												<p class="text-sm text-neutral-500 truncate dark:text-neutral-400">
													{s.correo}
												</p>
											</div>
											<div class="inline-flex items-center text-sm font-semibold text-neutral-900 dark:text-neutral-500">
												Con el {s.porcentaje}%
											</div>
										</div>
									</li>
								))}
							</ul>
						)
					}
				</div>
			</div>
			{
				empresa.direccion_operativa_eeuu === 'Si' && (
					<div
						class={`w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-1 ${esMember_Managed ? 'col-span-2' : 'col-span-3'}`}
					>
						<div class="bg-[#d4d4d4] dark:bg-[#134aed] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold">
							<Icon name="ri:map-pin-fill" />
							<p>Dirección operativa EE.UU.</p>
						</div>
						<div class="grid lg:grid-cols-2 grid-cols-1 p-4">
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Dirección operativa en EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.direccion_eeuu}
									</p>
								</div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Condado de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.condado_eeuu}
									</p>
								</div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Ciudad de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.ciudad_eeuu}
									</p>
								</div>
							</div>
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Estado de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.estado_eeuu}
									</p>
								</div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Codigo postal de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.codigo_postal_eeuu}
									</p>
								</div>
							</div>
						</div>
					</div>
				)
			}
			{
				empresa.direccion_operativa_eeuu === 'No' && (
					<div
						class={`w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-1 ${esMember_Managed ? 'col-span-2' : 'col-span-3'}`}
					>
						<div class="bg-[#d4d4d4] dark:bg-[#134aed] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold">
							<Icon name="ri:map-pin-fill" />
							<p>Dirección operativa</p>
						</div>
						<div class="grid lg:grid-cols-2 grid-cols-1 p-4">
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										País operativo
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.Pais_operativo}
									</p>
								</div>
							</div>
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Dirección de la empresa
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.direccion_empresa}
									</p>
								</div>
							</div>
						</div>
					</div>
				)
			}
			{
				managers && managers.length > 0 && (
					<div class="w-full h-full bg-neutral-50 dark:bg-black-800 rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-2 lg:col-span-1">
						<div class="bg-[#d4d4d4] dark:bg-[#134aed] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold">
							<Icon name="ri:user-settings-fill" />
							<p>Managers</p>
						</div>
						<div class="flow-root p-4">
							{(managers?.length ?? 0) === 0 ? (
								<p>No hay ningún manager aun</p>
							) : (
								<ul
									role="list"
									class="divide-y divide-neutral-200 dark:divide-neutral-700"
								>
									{managers?.map((s) => (
										<li class="py-3 sm:py-4">
											<div class="flex items-center">
												<div class="shrink-0">
													<Image
														class="w-8 h-8 rounded-full"
														src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${s.Nombres_manager}`}
														alt={`avatar de ${s.Nombres_manager}`}
														inferSize={true}
														loading="eager"
													/>
												</div>
												<div class="flex-1 min-w-0 ms-4">
													<p class="text-sm font-medium text-neutral-900 truncate dark:text-white">
														{s.Nombres_manager}
													</p>
													<p class="text-sm text-neutral-500 truncate dark:text-neutral-400">
														{s.Correo_electronico_manager}
													</p>
												</div>
											</div>
										</li>
									))}
								</ul>
							)}
						</div>
					</div>
				)
			}
		</div>

		<form action="" method="post">
			<div
				class="hidden md:p-4 p-0 rounded-lg grid md:grid-cols-[auto_1fr] md:space-x-4 space-x-0 w-full"
				id="contacts"
				role="tabpanel"
				aria-labelledby="contacts-tab"
				x-data="{ 
				formadeAdministracion: '',  
				actvidadManual: null, 
				RegistroManual: '',
				direccionOperativa: '',
				otrosMiembrosfuera: null,
				managerMiembro: '',
				asignarManager: '',
				tabManager: '',
				init() {
					// Sincroniza con el valor real de Supabase
					const checkbox = document.querySelector('#otros-miembros-fuera-de-lista');
					if (checkbox) {
						this.actvidadManual = checkbox.checked;
					};
					const direccionop = document.querySelector('#direccionOperativa');
					if (direccionop) {
						this.direccionOperativa = direccionop.value
					};
					const administracion = document.querySelector('#forma_de_administrar');
					if (administracion) {
						this.formadeAdministracion = administracion.value
					};
					const manager = document.querySelector('#informacionmanager');
					if (manager) {
						this.managerMiembro = manager.value
					};
				}
			}"
				x-effect="if (!actvidadManual) {
				RegistroManual = '';
			}; if (asignarManager === 'Si') {
				 managerMiembro = '';
			}"
			>
				<div class="mb-4 dark:border-gray-700 md:max-w-72 md:min-w-72">
					<ul
						class="flex-column text-sm font-medium text-gray-500 dark:text-gray-400 dark:bg-black-800 p-5 rounded-lg space-y-5"
						id="default-tab-2"
						data-tabs-toggle="#default-tab-content-2"
						role="tablist"
						data-tabs-active-classes="text-white bg-blue-700 dark:bg-blue-600"
						data-tabs-inactive-classes="hover:text-gray-900 bg-gray-50 hover:bg-gray-100 dark:bg-black-900 dark:hover:bg-[#101521]/80 dark:hover:text-white"
					>
						<li>
							<div>
								<h5 class="text-lg">{empresa.nombre_1}</h5>
								<p class="font-light">navegacion de edicion</p>
							</div>
						</li>
						{
							[
								{
									id: 'generales-tab',
									tabs: 'generales',
									label: 'Generales',
									icono: 'ri:building-2-fill',
									condicion: 'activo',
								},
								{
									id: 'ubicacion-tab',
									tabs: 'ubicacion',
									label: 'Ubicacion',
									icono: 'ri:folder-user-fill',
									condicion: 'activo',
								},
								{
									id: 'socios-edit-tab',
									tabs: 'socios-edit',
									label: 'Socios',
									icono: 'ri:file-copy-2-fill',
									condicion: 'activo',
								},
								{
									id: 'manager-tab',
									tabs: 'manager',
									label: 'Manager',
									icono: 'ri:edit-fill',
									condicion: 'condicional',
								},
							].map((i) =>
								i.condicion === 'activo' ? (
									<li role="presentation">
										<button
											id={i.id}
											data-tabs-target={`#${i.tabs}`}
											type="button"
											role="tab"
											aria-controls={i.tabs}
											aria-selected="false"
											class="p-4 flex items-center gap-2 w-full rounded-lg"
										>
											<Icon name={i.icono} class="text-lg" />
											{i.label}
										</button>
									</li>
								) : (
									<li role="presentation">
										<button
											id={i.id}
											data-tabs-target={`#${i.tabs}`}
											type="button"
