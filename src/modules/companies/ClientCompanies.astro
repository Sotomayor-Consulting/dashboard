---
import { Icon } from 'astro-icon/components';
import { SharedBreadcrumb } from '@components/navigation/BreadcrumbPath';
import { getCompaniesByUserId } from '@domains/companies/companies';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const userId = user?.id;

const companies = userId ? await getCompaniesByUserId(supabase, userId) : [];

const STATUS_LABELS: Record<string, string> = {
	active: 'Activa',
	draft: 'En formación',
	dissolved: 'Disuelta',
	inactive: 'Inactiva',
};

const paths = [{ label: 'Inicio', href: '/' }, { label: 'Mis empresas' }];
---

<SharedBreadcrumb paths={paths} />

<div class="px-4">
	<div class="section-header">
		<h1 class="text-foreground text-xl font-semibold sm:text-2xl">
			Tus empresas
		</h1>
		<p class="text-muted-foreground mt-1 text-sm">
			Empresas constituidas vinculadas a tu cuenta.
		</p>
	</div>

	<div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
		{
			companies.length === 0 ? (
				<div class="border-border text-muted-foreground col-span-3 flex flex-col items-center rounded-lg border border-dashed p-10 text-center">
					<Icon
						name="ri:building-2-line"
						class="text-muted-foreground mb-3 h-10 w-10"
					/>
					<h3 class="text-foreground mb-1 text-lg font-semibold">
						Aún no tienes empresas constituidas
					</h3>
					<p class="max-w-sm text-sm">
						Cuando tu proceso de incorporación termine, tu empresa aparecerá
						aquí con toda su información legal.
					</p>
					<a
						href="/incorporation/"
						class="border-border text-foreground hover:bg-muted mt-6 inline-flex items-center gap-2 rounded-lg border px-4 py-2.5 text-sm font-medium transition-colors"
					>
						Ver mis incorporaciones
					</a>
				</div>
			) : (
				companies.map((c) => (
					<a
						href={`/company/${c.id}`}
						class="flat-card hover:bg-muted/50 flex flex-col gap-3 p-6 transition-colors"
					>
						<div class="flex items-start justify-between gap-3">
							<span class="border-border bg-muted flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border">
								<Icon
									name="ri:building-2-line"
									class="text-foreground h-5 w-5"
								/>
							</span>
							<span class="bg-muted text-muted-foreground rounded-full px-2.5 py-1 text-xs font-medium">
								{STATUS_LABELS[c.legal_status ?? ''] ??
									c.legal_status ??
									'Sin estado'}
							</span>
						</div>
						<div>
							<h5 class="text-foreground text-lg font-bold tracking-tight">
								{c.legal_name ?? 'Empresa sin nombre'}
							</h5>
							<p class="text-muted-foreground mt-1 text-sm">
								{[c.entity_type?.toUpperCase(), c.formation_state_name]
									.filter(Boolean)
									.join(' · ') || 'Sin datos de registro'}
							</p>
						</div>
					</a>
				))
			)
		}
	</div>
</div>
