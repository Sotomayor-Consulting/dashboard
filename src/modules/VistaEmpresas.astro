---
import '../estilos/datatables.css';
import { supabase } from '../lib/supabase';
import { Icon } from 'astro-icon/components';


interface Props {
	empresaId: string;
}

const { empresaId } = Astro.props;

const { data: empresa, error } = await supabase
	.from('empresas_incorporaciones')
	.select(
		`
    *,
    usuarios:user_id (nombre, apellido, correo)
  `,
	)
	.eq('empresa_incorporacion_id', empresaId)
	.single();

// Si no existe, redirigir
if (error || !empresa) {
	return Astro.redirect('/');
}

const { data: socios } = await supabase
	.from('socios_validados')
	.select('*')
	.eq('id_empresa', empresaId);

const { data: managers } = await supabase
	.from('managers_validados')
	.select('*')
	.eq('empresa_incorporacion_id', empresaId);


const esMember_Managed = empresa?.forma_administracion === 'Member-Managed';
---

<div class="mt-5 mx-5">
	<div class="mb-4 border-b border-neutral-200 dark:border-[#1f3443]">
		<ul
			class="flex flex-wrap -mb-px text-sm font-medium text-center"
			id="default-tab"
			data-tabs-toggle="#default-tab-content"
			role="tablist"
			data-tabs-active-classes="text-[#8c681d] hover:text-[#8c681d] dark:text-[#8c681d] dark:hover:text-[#8c681d] border-[#8c681d] dark:border-[#8c681d]"
			data-tabs-inactive-classes="dark:border-transparent text-neutral-500 hover:text-neutral-600 dark:text-neutral-400 border-neutral-100 hover:border-neutral-300 dark:border-neutral-700 dark:hover:text-neutral-300"
		>
			<li class="me-2" role="presentation">
				<button
					class="inline-block p-4 border-b-2 rounded-t-lg"
					id="profile-tab"
					data-tabs-target="#profile"
					type="button"
					role="tab"
					aria-controls="profile"
					aria-selected="false">Datos Generales</button
				>
			</li>
			<li class="me-2" role="presentation">
				<button
					class="inline-block p-4 border-b-2 rounded-t-lg hover:text-neutral-600 hover:border-neutral-300 dark:hover:text-neutral-300"
					id="socios-tab"
					data-tabs-target="#socios"
					type="button"
					role="tab"
					aria-controls="socios"
					aria-selected="false">Socios</button
				>
			</li>
			<!-- 
			<li class="me-2" role="presentation">
				<button
					class="inline-block p-4 border-b-2 rounded-t-lg hover:text-neutral-600 hover:border-neutral-300 dark:hover:text-neutral-300"
					id="managers-tab"
					data-tabs-target="#managers"
					type="button"
					role="tab"
					aria-controls="managers"
					aria-selected="false">Managers</button
				>
			</li>-->
			<li class="me-2" role="presentation">
				<button
					class="inline-block p-4 border-b-2 rounded-t-lg hover:text-neutral-600 hover:border-neutral-300 dark:hover:text-neutral-300"
					id="settings-tab"
					data-tabs-target="#settings"
					type="button"
					role="tab"
					aria-controls="settings"
					aria-selected="false">documentos</button
				>
			</li>
			<li role="presentation">
				<button
					class="inline-block p-4 border-b-2 rounded-t-lg hover:text-neutral-600 hover:border-neutral-300 dark:hover:text-neutral-300"
					id="contacts-tab"
					data-tabs-target="#contacts"
					type="button"
					role="tab"
					aria-controls="contacts"
					aria-selected="false">mantenimiento</button
				>
			</li>
		</ul>
	</div>
	<div id="default-tab-content">
		<div
			class="hidden p-4 rounded-lg grid lg:grid-cols-3 md:grid-cols-2 gap-4"
			id="profile"
			role="tabpanel"
			aria-labelledby="profile-tab"
		>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 flex flex-col p-14 md:mb-0 mb-2 lg:col-span-1 col-span-2"
			>
				<div class="flex">
					<p class="font-bold text-base text-neutral-500">
						Nombre de la empresa
					</p>

					<button
						data-popover-target="popover-description"
						data-popover-placement="bottom-end"
						type="button"
						><svg
							class="w-4 h-4 ms-2 text-neutral-500 hover:text-neutral-600"
							aria-hidden="true"
							fill="currentColor"
							viewBox="0 0 20 20"
							xmlns="http://www.w3.org/2000/svg"
							><path
								fill-rule="evenodd"
								d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
								clip-rule="evenodd"></path></svg
						><span class="sr-only">Mostrar información</span></button
					>
					<div
						data-popover
						id="popover-description"
						role="tooltip"
						class="absolute z-10 invisible inline-block text-sm text-neutral-500 transition-opacity duration-300 bg-white border border-neutral-200 rounded-lg shadow-xs opacity-0 w-72 dark:bg-neutral-800 dark:border-neutral-600 dark:text-neutral-400"
					>
						<div class="p-3 space-y-2">
							<h3 class="font-semibold text-neutral-900 dark:text-white">
								¿Porque se muestra este nombre?
							</h3>
							<p>
								Este nombre corresponde al registro inicial realizado durante la
								creación de la empresa mediante el dashboard de Sotomayor
								Consulting. Existen dos denominaciones opcionales adicionales.
								En caso de requerir una edición por motivos operativos, es
								necesario verificar y contrastar la información con los
								documentos oficiales disponibles.
							</p>
						</div>
						<div data-popper-arrow></div>
					</div>
				</div>

				<div class="flex gap-10 items-center dark:text-neutral-300 text-neutral-800">
					<div class="flex gap-5">
						<div>
							<p class="font-bold text-4xl">
								{empresa.nombre_1} - {empresa.tipo_de_negocio}
							</p>
						</div>
						<div>
							<span
								class="bg-green-100 text-green-800 text-base font-medium me-2 px-2.5 py-0.5 rounded-full dark:bg-green-900/50 dark:text-green-300 flex w-fit items-center mt-2"
								>{
									empresa.estado === 'Activo' ? (
										<div class="h-2.5 w-2.5 rounded-full bg-green-400 mr-2 animate-pulse" />
									) : (
										<div class="h-2.5 w-2.5 rounded-full bg-red-500 mr-2" />
									)
								}
								{empresa.estado}</span
							>
						</div>
					</div>
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 text-neutral-800 flex flex-col md:mb-0 mb-2 md:col-span-1 col-span-2 p-14 justify-center"
			>
				<div class="flex">
					<p class="font-bold text-base text-neutral-500">
						Lugar de la empresa
					</p>
				</div>

				<div class="flex gap-5 items-center">
					<div class="flex flex-col gap-5">
						<div>
							<p class="font-bold text-4xl">
								{empresa.estado_de_incorporacion}
							</p>
						</div>
					</div><Icon name="ri:road-map-fill" class="text-4xl" />
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 text-neutral-800 flex flex-col p-14 md:mb-0 mb-2 md:col-span-1 col-span-2 justify-center"
			>
				<div class="flex">
					<p class="font-bold text-base text-neutral-500">
						Porcentaje de incorporación
					</p>
				</div>

				<div class="flex gap-10 items-center">
					<div class="flex flex-col gap-5">
						<div>
							<p class="font-bold text-4xl">
								{empresa.porcentaje_de_incorporacion}%
							</p>
						</div>
					</div>
					<div class="w-full bg-neutral-200 rounded-full dark:bg-neutral-700">
						<div
							class="bg-[#8c681d] text-blue-100 text-center p-1 leading-none rounded-full"
							style={`width: ${empresa.porcentaje_de_incorporacion}%`}
						>
						</div>
					</div>
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 flex col-span-2 relative"
			>
				<img
					src="https://images.unsplash.com/photo-1609273817335-4fa6f22d565f?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
					alt="Edificios"
					class="object-cover w-full rounded-t-lg h-96 md:h-auto md:w-2/5 md:rounded-none md:rounded-s-lg md:block hidden"
				/>
				<div
					class="h-1/5 bg-[#1f3443] rounded-md bg-clip-padding backdrop-filter
				backdrop-blur-md bg-opacity-10 border border-neutral-400 absolute bottom-4 left-4 p-2 lg:block hidden"
				>
					<p class="font-normal text-white text-sm">Empresa id:</p>
					<p class="font-light text-white text-xs">
						#{empresaId}
					</p>
				</div>
				<div class="flex flex-col justify-center p-5 leading-normal">
					<div>
						<h5
							class="mb-2 text-2xl font-bold tracking-tight dark:text-neutral-300 text-neutral-800"
						>
							Nombres de la compañía
						</h5>
						<p
							class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-3xl"
						>
							{empresa.nombre_1}, {empresa.nombre_2}, {empresa.nombre_3}
						</p>
					</div>
					<div class="grid lg:grid-cols-2 grid-cols-1 gap-2 mt-10">
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Actividad de la compañía
							</h5>
							<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-base">
								{empresa.actividad}
							</p>
						</div>
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Forma de tributar
							</h5>
							<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-base">
								{empresa.forma_tributacion}
							</p>
						</div>
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Obtendrá ingresos desde EE.UU.
							</h5>
							<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400 text-base">
								{
									empresa.Obtendra_ingresos_desde_eeuu === true
										? 'Si obtendrá ingresos'
										: 'No obtendrá ingresos'
								}
							</p>
						</div>
						<div>
							<h5
								class="mb-2 text-lg font-bold tracking-tight text-neutral-700 dark:text-neutral-400"
							>
								Forma de administración
							</h5>
							<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
								{empresa.forma_administracion}
							</p>
						</div>
					</div>
				</div>
			</div>
			<div
				class="w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-2 lg:col-span-1"
			>
				<div
					class="bg-[#d4d4d4] dark:bg-[#2c485b] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold"
				>
					<Icon name="ri:shake-hands-fill" />
					<p>Socios</p>
				</div>
				<div class="flow-root p-4">
					{
						(socios?.length ?? 0) === 0 ? (
							<p>No hay ningún socio aun</p>
						) : (
							<ul
								role="list"
								class="divide-y divide-neutral-200 dark:divide-neutral-700"
							>
								{socios?.map((s) => (
									<li class="py-3 sm:py-4">
										<div class="flex items-center">
											<div class="shrink-0">
												<img
													class="w-8 h-8 rounded-full"
													src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${s.nombre_de_socio}`}
													alt={`avatar de ${s.nombre_de_socio}`}
												/>
											</div>
											<div class="flex-1 min-w-0 ms-4">
												<p class="text-sm font-medium text-neutral-900 truncate dark:text-white">
													{s.nombre_de_socio}
												</p>
												<p class="text-sm text-neutral-500 truncate dark:text-neutral-400">
													{s.correo}
												</p>
											</div>
											<div class="inline-flex items-center text-sm font-semibold text-neutral-900 dark:text-neutral-500">
												Con el {s.porcentaje}%
											</div>
										</div>
									</li>
								))}
							</ul>
						)
					}
				</div>
			</div>
			{
				empresa.direccion_operativa_eeuu === 'Si' && (
					<div
						class={`w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-1 ${esMember_Managed ? 'col-span-2' : 'col-span-3'}`}
					>
						<div class="bg-[#d4d4d4] dark:bg-[#2c485b] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold">
							<Icon name="ri:map-pin-fill" />
							<p>Dirección operativa EE.UU.</p>
						</div>
						<div class="grid lg:grid-cols-2 grid-cols-1 p-4">
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Dirección operativa en EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.direccion_eeuu}
									</p>
								</div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Condado de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.condado_eeuu}
									</p>
								</div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Ciudad de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.ciudad_eeuu}
									</p>
								</div>
							</div>
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Estado de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.estado_eeuu}
									</p>
								</div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Codigo postal de EE.UU.
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.codigo_postal_eeuu}
									</p>
								</div>
							</div>
						</div>
					</div>
				)
			}
			{
				empresa.direccion_operativa_eeuu === 'No' && (
					<div
						class={`w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-1 ${esMember_Managed ? 'col-span-2' : 'col-span-3'}`}
					>
						<div class="bg-[#d4d4d4] dark:bg-[#2c485b] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold">
							<Icon name="ri:map-pin-fill" />
							<p>Dirección operativa</p>
						</div>
						<div class="grid lg:grid-cols-2 grid-cols-1 p-4">
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										País operativo
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.Pais_operativo}
									</p>
								</div>
							</div>
							<div>
								<div>
									<h5 class="mb-2 text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-300">
										Dirección de la empresa
									</h5>
									<p class="mb-3 font-normal text-neutral-700 dark:text-neutral-400">
										{empresa.direccion_empresa}
									</p>
								</div>
							</div>
						</div>
					</div>
				)
			}
			{
				managers && managers.length > 0 && (
					<div class="w-full h-full bg-neutral-50 dark:bg-[#1f3443] rounded-md gap-5 dark:text-neutral-300 flex relative flex-col col-span-2 lg:col-span-1">
						<div class="bg-[#d4d4d4] dark:bg-[#2c485b] w-full h-fit rounded-t-md flex items-center text-xl p-4 gap-2 font-bold">
							<Icon name="ri:user-settings-fill" />
							<p>Managers</p>
						</div>
						<div class="flow-root p-4">
							{(managers?.length ?? 0) === 0 ? (
								<p>No hay ningún socio aun</p>
							) : (
								<ul
									role="list"
									class="divide-y divide-neutral-200 dark:divide-neutral-700"
								>
									{managers?.map((s) => (
										<li class="py-3 sm:py-4">
											<div class="flex items-center">
												<div class="shrink-0">
													<img
														class="w-8 h-8 rounded-full"
														src={`https://api.dicebear.com/9.x/thumbs/svg?seed=${s.Nombres_manager}`}
														alt={`avatar de ${s.Nombres_manager}`}
													/>
												</div>
												<div class="flex-1 min-w-0 ms-4">
													<p class="text-sm font-medium text-neutral-900 truncate dark:text-white">
														{s.Nombres_manager}
													</p>
													<p class="text-sm text-neutral-500 truncate dark:text-neutral-400">
														{s.Correo_electronico_manager}
													</p>
												</div>
											</div>
										</li>
									))}
								</ul>
							)}
						</div>
					</div>
				)
			}

			<hr class="h-px my-4 bg-neutral-400 border-0 dark:bg-neutral-600" />
			<div>
				<button
					type="button"
					class="text-white bg-[#967432] hover:bg-[#8c681d] focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-[#967432] dark:hover:bg-[#8c681d] focus:outline-none dark:focus:ring-[#967432] flex gap-1 justify-center items-center"
				>
					<Icon name="ri:edit-2-fill" /> Editar</button
				>
			</div>
		</div>
		<div
			class="hidden p-4 rounded-lg "
			id="socios"
			role="tabpanel"
			aria-labelledby="socios-tab"
		>
			<div>
				<div class="flex">
					<p class="font-bold text-lg text-neutral-400">
						Lista detallada de socios
					</p>
				</div>
				<hr class="h-px my-4 bg-neutral-200 border-0 dark:bg-neutral-600" />

				<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
					<table
						class="w-full text-sm text-left rtl:text-right text-neutral-500 dark:text-neutral-400"
						id="myTable"
					>
						<thead
							class="text-xs text-neutral-700 uppercase bg-neutral-400 dark:bg-neutral-800 dark:text-neutral-400"
						>
							<tr >
								{
									[
										'nombres',
										'tipo de socio',
										'Correo',
										'Porcentaje',
										'Estado civil',
										'Residente fiscal',
										'Nacionalidad',
										'Fecha de creación',
										'Acciones',
									].map((th) => (
										<th scope="col" class="px-6 py-3">
											<span class="flex items-center uppercase">
												{th}
												<svg
													class="w-4 h-4 ms-1"
													aria-hidden="true"
													xmlns="http://www.w3.org/2000/svg"
													width="24"
													height="24"
													fill="none"
													viewBox="0 0 24 24"
												>
													<path
														stroke="currentColor"
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="m8 15 4 4 4-4m0-6-4-4-4 4"
													/>
												</svg>
											</span>
										</th>
									))
								}
							</tr>
						</thead>
						<tbody>
							{
								socios?.map((socio) => (
									<tr class="hover:bg-neutral-100 dark:hover:bg-[#1b2e3c] odd:dark:bg-[#1f3443] even:dark:bg-[#1d313f] odd:bg-neutral-200 even:bg-[#d4d4d4]">
										<th
											scope="row"
											class="px-6 py-4 font-medium text-neutral-900 whitespace-nowrap dark:text-white"
										>
											{socio.nombre_de_socio}
										</th>
										<td class="px-6 py-4"> {socio.tipo_de_socio} </td>
										<td class="px-6 py-4"> {socio.correo} </td>
										<td class="px-6 py-4"> {socio.porcentaje} </td>
										<td class="px-6 py-4"> {socio.estado_civil} </td>
										<td class="px-6 py-4"> {socio.residente_fiscal} </td>
										<td class="px-6 py-4"> {socio.pais_de_nacionalidad} </td>
										<td class="px-6 py-4">
											{socio.created_at &&
												new Date(socio.created_at)
													.toLocaleDateString('es-ES', {
														day: '2-digit',
														month: '2-digit',
														year: 'numeric',
													})
													.replace(/\//g, '-')}
										</td>
										<td class="px-6 py-4">
											<button
												type="button"
												class="text-white bg-[#967432] hover:bg-[#8c681d] focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-[#967432] dark:hover:bg-[#8c681d] focus:outline-none dark:focus:ring-[#967432] flex gap-1 justify-center items-center"
											>
												<Icon name="ri:edit-2-fill" /> Editar
											</button>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div
			class="hidden p-4 rounded-lg"
			id="settings"
			role="tabpanel"
			aria-labelledby="settings-tab"
		>
			<div>
				<div class="flex">
					<p class="font-bold text-lg text-neutral-400">
						Documentos de la empresa
					</p>
				</div>
				<hr class="h-px my-4 bg-neutral-200 border-0 dark:bg-neutral-600" />

				<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
					<table
						class="w-full text-sm text-left rtl:text-right text-neutral-500 dark:text-neutral-400"
						id="myTable2"
					>
						<thead
							class="text-xs text-neutral-700 uppercase bg-neutral-50 dark:bg-neutral-700 dark:text-neutral-400"
						>
							<tr>
								{
									[
										'nombre',
										'tipo de Archivo',
										'Categoría',
										'Estado',
										'Fecha de subida',
										'Fecha de modificación',
										'Subido por',
										'Acciones',
									].map((th) => (
										<th scope="col" class="px-6 py-3">
											<span class="flex items-center uppercase">
												{th}
												<svg
													class="w-4 h-4 ms-1"
													aria-hidden="true"
													xmlns="http://www.w3.org/2000/svg"
													width="24"
													height="24"
													fill="none"
													viewBox="0 0 24 24"
												>
													<path
														stroke="currentColor"
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="2"
														d="m8 15 4 4 4-4m0-6-4-4-4 4"
													/>
												</svg>
											</span>
										</th>
									))
								}
								
							</tr>
						</thead>
						<tbody>
							{
								socios?.map((socio) => (
									<tr class="hover:bg-neutral-100 dark:hover:bg-[#1b2e3c] odd:dark:bg-[#1f3443] even:dark:bg-[#1d313f] odd:bg-neutral-200 even:bg-[#d4d4d4]">
										<th
											scope="row"
											class="px-6 py-4 font-medium text-neutral-900 whitespace-nowrap dark:text-white"
										>
											{socio.nombre_de_socio}
										</th>
										<td class="px-6 py-4"> {socio.tipo_de_socio} </td>
										<td class="px-6 py-4"> {socio.correo} </td>
										<td class="px-6 py-4"> {socio.porcentaje} </td>
										<td class="px-6 py-4"> {socio.estado_civil} </td>
										<td class="px-6 py-4"> {socio.residente_fiscal} </td>
										<td class="px-6 py-4"> {socio.pais_de_nacionalidad} </td>
										<td class="px-6 py-4">
											<button
												type="button"
												class="text-white bg-[#967432] hover:bg-[#8c681d] focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-[#967432] dark:hover:bg-[#8c681d] focus:outline-none dark:focus:ring-[#967432] flex gap-1 justify-center items-center"
											>
												<Icon name="ri:edit-2-fill" /> Editar
											</button>
										</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div
			class="hidden p-4 rounded-lg bg-neutral-50 dark:bg-[#1f3443]"
			id="contacts"
			role="tabpanel"
			aria-labelledby="contacts-tab"
		>
			<p class="text-sm text-neutral-500 dark:text-neutral-400">
				Pendiente
			</p>
		</div>
	</div>
</div>
<script type="module">
	import { DataTable } from 'https://cdn.jsdelivr.net/npm/simple-datatables@9.0.3/dist/module.js';

	function initDT() {
		const el = document.querySelector('#myTable');
		if (!el) return;
		if (el.dataset.dtInit === '1') return;

		const dt = new DataTable(el, {
			searchable: true,
			perPage: 25,
			perPageSelect: [5, 10, 25, 50],

			// Textos en español
			labels: {
				placeholder: 'Buscar...',
				perPage: 'Filas',
				noRows: 'No hay empresas',
				noResults: 'No se encontraron resultados',
				info: 'Mostrando {start} a {end} de {rows} registros',
			},

			// Layout estilo Flowbite (arriba: perPage + search / abajo: info + paging)
			layout: {
				top: '{select}{search}',
				bottom: '{info}{pager}',
			},
		});

		el.dataset.dtInit = '1';
		el.dataset.dtInstance = '1';
	}

	initDT();
	document.addEventListener('astro:page-load', initDT);
</script>
