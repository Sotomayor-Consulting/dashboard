---
import '../estilos/datatables.css';
import { supabase } from '../lib/supabase';
import { Icon } from 'astro-icon/components';

interface Props {
	empresaId: string;
}

const { empresaId } = Astro.props;

const { data: empresa, error } = await supabase
	.from('empresas_incorporaciones')
	.select(
		`
    *,
    usuarios:user_id (nombre, apellido, correo)
  `,
	)
	.eq('empresa_incorporacion_id', empresaId)
	.single();

// Si no existe, redirigir
if (error || !empresa) {
	return Astro.redirect('/');
}

const { data: socios } = await supabase
	.from('socios_validados')
	.select('*')
	.eq('id_empresa', empresaId);

const { data: managers } = await supabase
	.from('managers_validados')
	.select('*')
	.eq('empresa_incorporacion_id', empresaId);

const { data: personas_empresa } = await supabase
	.from('empresa_personas_nombre')
	.select('nombre_persona')
	.eq('id_empresa', empresaId);

const expirySeconds = 60 * 5;

// 1) Normalizar nombres (array)
const nombres = (personas_empresa ?? [])
	.map((p) => p.nombre_persona)
	.filter(Boolean);

// 2) Por cada persona: listar /servicio_basico, firmar y guardar
type SignedFile = { persona: string; name: string; url: string; path: string };

const servicioBasicoFirmado: SignedFile[] = [];

for (const persona of nombres) {
	const folder = `${empresaId}/documentos_socios/${persona}/servicio_basico`;

	const { data: files, error: listErr } = await supabase.storage
		.from('documentos_empresas')
		.list(folder, {
			limit: 100,
			offset: 0,
			sortBy: { column: 'name', order: 'asc' },
		});

	if (listErr) {
		console.error('Error listando servicio_basico de', persona, listErr);
		continue;
	}

	// solo archivos (evita carpetas si existieran)
	const paths = (files ?? [])
		.filter((f) => f.name && f.metadata) // metadata suele venir en archivos
		.map((f) => `${folder}/${f.name}`);

	if (!paths.length) continue;

	// 3) Firmar en batch (mucho mejor que 1x1)
	const { data: signedList, error: signErr } = await supabase.storage
		.from('documentos_empresas')
		.createSignedUrls(paths, expirySeconds);

	if (signErr) {
		console.error('Error firmando servicio_basico de', persona, signErr);
		continue;
	}

	(signedList ?? []).forEach((s, idx) => {
		const path = paths?.[idx];
		if (path) {
			servicioBasicoFirmado.push({
				persona,
				name: path.split('/').pop() ?? `file-${idx}`,
				url: s.signedUrl,
				path: path,
			});
		}
	});
}

const { data: pasaportes } = await supabase.storage
	.from('documentos_empresas')
	.list(`${empresaId}/documentos_socios/Mike test/pasaporte`, {
		limit: 20,
		offset: 0,
		sortBy: { column: 'name', order: 'asc' },
	});

const items: { name: string; url: string }[] = [];
for (const file of pasaportes || []) {
	const path = `${empresaId}/documentos_socios/Mike test/pasaporte/${file.name}`;
	const { data: signed, error: signErr } = await supabase.storage
		.from('documentos_empresas')
		.createSignedUrl(path, expirySeconds);
	if (signErr) {
		console.error('Error creando signed url para', file.name, signErr);
		continue;
	}
	items.push({ name: file.name, url: signed.signedUrl });
}

const { data: actividades } = await supabase
	.from('actividades_duplicate')
	.select('*');
const { data: estados } = await supabase.from('estados').select('*');
const { data: paises } = await supabase.from('paises').select('*');

const esMember_Managed = empresa?.forma_administracion === 'Member-Managed';
