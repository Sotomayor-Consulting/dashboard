								<p>No hay ningún socio aun</p>
							) : (
								<ul
									role="list"
									class="divide-y divide-neutral-200 dark:divide-neutral-700"
								>
									{managers?.map((s) => (
										<li class="py-3 sm:py-4">
											<div class="flex items-center">
