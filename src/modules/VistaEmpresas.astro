				)
			}

			<hr
				class="h-px my-4 bg-neutral-400 border-0 dark:bg-neutral-600 col-span-3"
			/>
			<div>
				<button
					type="button"
					class="text-white bg-[#967432] hover:bg-[#8c681d] focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 focus:outline-none dark:focus:ring-[#967432] flex gap-1 justify-center items-center"
