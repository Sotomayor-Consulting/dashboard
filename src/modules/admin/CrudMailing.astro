---
import Alerta from '@components/feedback/Alert.astro';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import Drawer from '@components/ui/Drawer.astro';
import DrawerFormActions from '@components/ui/DrawerFormActions.astro';
import Modal from '@components/ui/Modal.astro';
import CrudMailingTable from '@modules/admin/islands/CrudMailingTable';

const supabase = Astro.locals.supabase;
const { data: usuarios } = await supabase
	.from('usuarios')
	.select(
		`
    *,
    rol:roles!usuarios_rol_id_fkey ( id, nombre ),
    estado
  `,
		{ count: 'exact' },
	)
	.order('created_at', { ascending: false });

const inputClass =
	'dark:bg-black-800 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]';
const labelClass =
	'mb-2 block text-sm font-medium text-gray-900 dark:text-white';
const submitBtnClass =
	'rounded-lg bg-[#8c681d] px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-[#8c681d]/90 focus:ring-4 focus:ring-primary-300 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-primary-800';
---

<script src="@third-party/alpinejs/alpine.js"></script>
<div
	class="dark:bg-black-900 block items-center justify-between border-b border-gray-200 bg-white p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<Alerta />
	<div class="mb-1 w-full">
		<CrudPageHeader title="Todos los usuarios" />
	</div>
</div>

<CrudMailingTable usuarios={usuarios ?? []} client:load />

<!-- Send Email Modal -->
<div
	id="top-right-modal"
	data-modal-placement="top-right"
	tabindex="-1"
	class="fixed top-0 right-0 left-0 z-50 hidden h-full w-full overflow-x-hidden overflow-y-auto p-4 md:inset-0"
>
	<div class="relative h-full w-full max-w-2xl">
		<div
			class="relative h-full rounded-lg bg-white shadow-sm dark:bg-[#0e2738]"
		>
			<div
				class="flex items-center justify-between rounded-t border-b border-gray-200 p-4 md:p-5 dark:border-gray-600"
			>
				<h3 class="text-xl font-medium text-gray-900 dark:text-white">
					Mensaje para el usuario
				</h3>
				<button
					type="button"
					class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					data-modal-hide="top-right-modal"
				>
					<svg
						class="h-3 w-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 14 14"
					>
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
					</svg>
					<span class="sr-only">Cerrar modal</span>
				</button>
			</div>
			<div class="space-y-4 p-4 md:p-5">
				<form action="#">
					<div class="mb-4 grid gap-4 sm:grid-cols-2">
						<div>
							<label for="email" class={labelClass}>Para:</label>
							<input
								type="email"
								name="email"
								id="email"
								class={inputClass}
								placeholder="Correo de"
								value=""
								disabled
								required
							/>
						</div>
						<div>
							<label for="Asunto" class={labelClass}>Asunto</label>
							<input
								type="text"
								name="Asunto"
								id="Asunto"
								class={inputClass}
								placeholder="Inserta el asunto del correo"
								required
							/>
						</div>
						<div class="h-full sm:col-span-2">
							<label for="description" class={labelClass}
								>Cuerpo del correo</label
							>
							<textarea
								id="description"
								rows="29"
								class={`${inputClass} h-full`}
								placeholder="Escribe el cuerpo del correo aquí..."
								required></textarea>
						</div>
					</div>
				</form>
			</div>
			<div
				class="flex items-center space-x-3 rounded-b border-t border-gray-200 p-4 md:p-5 rtl:space-x-reverse dark:border-gray-600"
			>
				<button
					data-modal-hide="top-right-modal"
					type="button"
					class="rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
					>Enviar correo</button
				>
				<button
					data-modal-hide="top-right-modal"
					type="button"
					class="ms-3 rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white dark:focus:ring-gray-700"
					>Cancelar</button
				>
			</div>
		</div>
	</div>
</div>

<!-- Update Form Drawer -->
<Drawer id="drawer-update-product-default" title="Actualizar Formulario">
	<form action="/api/forms/update" method="post">
		<div class="space-y-4">
			<input type="hidden" name="service_id" id="modal_form_id" value="" />
			<div>
				<label for="titulo-update-form" class={labelClass}
					>Titulo del formulario</label
				>
				<input
					type="text"
					name="titulo-form"
					id="titulo-update-form"
					class={inputClass}
					placeholder="inserta el titulo del formulario"
					required
				/>
			</div>
			<div>
				<label for="categoria-form-update" class={labelClass}>Categoria</label>
				<input
					type="text"
					name="categoria-form"
					id="categoria-form-update"
					class={inputClass}
					placeholder="Añade la categoria del formulario"
					required
				/>
			</div>
			<div>
				<label for="json-form" class={labelClass}
					>Pega el JSON del formulario</label
				>
				<textarea
					name="json-update"
					id="json-form"
					class={inputClass}
					placeholder="Añade el Json del formulario"
					required></textarea>
			</div>
			<div>
				<label for="tema-form" class={labelClass}
					>Tema del form (opcional)</label
				>
				<textarea
					id="tema-form"
					name="tema-form-update"
					rows="4"
					class={inputClass}
					placeholder="Añade el codigo json del tema de tu formulario"
				></textarea>
			</div>
			<div>
				<label for="descripcion-form" class={labelClass}>Descripcion</label>
				<textarea
					id="descripcion-form"
					name="descripcion-form-update"
					rows="4"
					class={inputClass}
					placeholder="Añade una descripcion para el form"></textarea>
			</div>
			<div>
				<label for="update-form-estado" class={labelClass}>Estado</label>
				<select id="update-form-estado" name="estado" class={inputClass}>
					<option value="" disabled selected>--</option>
					<option value="true">Activo</option>
					<option value="false">Inactivo</option>
				</select>
			</div>
		</div>
		<DrawerFormActions
			drawerId="drawer-update-product-default"
			submitLabel="Actualizar"
		/>
	</form>
</Drawer>

<!-- Invite User Modal -->
<Modal id="add-user-modal" title="Invitar usuario">
	<form action="/api/users/invite" method="post">
		<div class="space-y-6 p-6">
			<div class="grid gap-6">
				<div>
					<label for="email" class={labelClass}>Correo</label>
					<input
						type="email"
						name="correo_create"
						id="email"
						class={inputClass}
						placeholder="correo@ejemplo.com"
						required
					/>
				</div>
			</div>
			<div
				class="items-center rounded-b border-t border-gray-200 p-6 dark:border-gray-700"
			>
				<button class={submitBtnClass} type="submit">Invitar Usuario</button>
			</div>
		</div>
	</form>
</Modal>

<!-- Add Role Modal -->
<Modal id="rol-modal-admin" title="Añadir Rol">
	<form action="/api/roles/create" method="post">
		<div class="space-y-6 p-6">
			<div class="grid gap-6">
				<div>
					<label for="nombre_rol" class={labelClass}
						>Añade el nombre del rol</label
					>
					<input
						type="text"
						name="nombre_rol"
						id="rol-create"
						class={inputClass}
						placeholder="admin"
						required
					/>
				</div>
			</div>
			<div
				class="items-center rounded-b border-t border-gray-200 p-6 dark:border-gray-700"
			>
				<button class={submitBtnClass} type="submit">Añadir rol</button>
			</div>
		</div>
	</form>
</Modal>

<!-- Update Status Modal -->
<div
	id="updaterol"
	tabindex="-1"
	aria-hidden="true"
	class="h-modal fixed top-0 right-0 left-0 z-50 hidden w-full items-center justify-center overflow-x-hidden overflow-y-auto md:inset-0 md:h-full"
>
	<div class="relative h-full w-full max-w-2xl p-4 md:h-auto">
		<div
			class="dark:bg-black-800 relative rounded-lg bg-white p-4 shadow sm:p-5"
		>
			<div
				class="mb-4 flex items-center justify-between rounded-t border-b pb-4 sm:mb-5 dark:border-gray-600"
			>
				<h3 class="text-lg font-semibold text-gray-900 dark:text-white">
					Selecciona el estado del cliente
				</h3>
				<button
					type="button"
					class="ml-auto inline-flex items-center rounded-lg bg-transparent p-1.5 text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					data-modal-toggle="updaterol"
				>
					<svg
						aria-hidden="true"
						class="h-5 w-5"
						fill="currentColor"
						viewBox="0 0 20 20"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							fill-rule="evenodd"
							d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
							clip-rule="evenodd"></path>
					</svg>
					<span class="sr-only">Close modal</span>
				</button>
			</div>
			<form action="/api/users/update" method="post" id="updaterolForm">
				<input type="hidden" name="user_id" id="updaterol_user_id" />
				<div class="mb-4 grid gap-4">
					<div>
						<label for="updaterol_estado" class={labelClass}>Rol</label>
						<select id="updaterol_estado" name="estado" class={inputClass}>
							<option value="" disabled selected>--</option>
							<option value="activo">activo</option>
							<option value="inactivo">inactivo</option>
						</select>
					</div>
				</div>
				<div class="flex items-center space-x-4">
					<button type="submit" class={submitBtnClass}>
						Actualizar estado
					</button>
					<button
						data-modal-toggle="updaterol"
						type="button"
						class="inline-flex items-center rounded-lg border border-red-600 px-5 py-2.5 text-center text-sm font-medium text-red-600 hover:bg-red-600 hover:text-white focus:ring-4 focus:ring-red-300 focus:outline-none dark:border-red-500 dark:text-red-500 dark:hover:bg-red-600 dark:hover:text-white dark:focus:ring-red-900"
					>
						Cancelar
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script is:inline>
	const bindMailingEstadoButtons = () => {
		const form = document.getElementById('updaterolForm');
		const uidInput = document.getElementById('updaterol_user_id');
		const estadoSel = document.getElementById('updaterol_estado');
		const nameSpan = document.getElementById('updaterolUserName');
		const btns = document.querySelectorAll('[data-open-estado]');
		const fallbackBackPath = '/admin/mailing/';

		if (!form || !uidInput || !estadoSel) return;

		function getSafeBackPath() {
			const path = window.location.pathname;
			if (typeof path === 'string' && path.startsWith('/')) {
				return path;
			}
			return fallbackBackPath;
		}

		btns.forEach((btn) => {
			if (btn.dataset.estadoBind === '1') return;
			btn.dataset.estadoBind = '1';

			btn.addEventListener('click', () => {
				const uid = btn.dataset.userId || '';
				const uname = btn.dataset.userName || '';
				const estCur = btn.dataset.userEstado || '';

				uidInput.value = uid;
				if (nameSpan) nameSpan.textContent = uname ? ` · ${uname}` : '';

				const hasOption = Array.from(estadoSel.options).some(
					(o) => o.value === estCur,
				);
				estadoSel.value = hasOption ? estCur : '';

				const back = getSafeBackPath();
				form.action = `/api/users/update?back=${encodeURIComponent(back)}`;
			});
		});

		if (form.dataset.submitBind === '1') return;
		form.dataset.submitBind = '1';

		form?.addEventListener('submit', () => {
			const submitBtn = form?.querySelector('button[type="submit"]');
			if (submitBtn) submitBtn.disabled = true;
		});
	};

	document.addEventListener('DOMContentLoaded', bindMailingEstadoButtons);
	document.addEventListener('astro:page-load', bindMailingEstadoButtons);
</script>
