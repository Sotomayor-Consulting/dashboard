---
import Alerta from '@components/feedback/alertageneral.astro';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import DataTable from '@components/ui/DataTable.astro';
import AvatarCell from '@components/ui/AvatarCell.astro';
import StackedText from '@components/ui/StackedText.astro';
import StatusBadge from '@components/ui/StatusBadge.astro';
import { getAllUsuarios } from '@lib/tablas/users/usuarios';
import { RolesGeneralUsers } from '@lib/tablas/utils/roles/roles';

const supabase = Astro.locals.supabase;
const [usuarios, roles] = await Promise.all([
	getAllUsuarios(supabase),
	RolesGeneralUsers(supabase),
]);

const inputClasses =
	'dark:bg-black-900 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-[#967432] focus:ring-[#967432] dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]';
const labelClasses =
	'mb-2 block text-sm font-medium text-gray-900 dark:text-white';
---

<script src="@lib/alpinejs/alpine.js"></script>
<div
	class="block items-center justify-between border-b border-gray-200 p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<Alerta />
	<CrudPageHeader
		title="Lista de usuarios"
		breadcrumbItems={[
			{
				label: 'Notificaciones',
				href: '/admin/notificaciones/',
			},
		]}
	/>
</div>

<DataTable
	headers={[
		'Foto',
		'Nombre',
		'Compañía',
		'Cargo',
		'País',
		'Estado',
		'Rol',
		'Acciones',
	]}
	noRowsMessage="No hay usuarios"
	noResultsMessage="No se encontraron usuarios"
>
	{
		usuarios?.map((user) => (
			<tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100 odd:dark:bg-[#28314c] even:dark:bg-[#384467] dark:hover:bg-[#101522]">
				<td class="w-4 pl-4">
					<AvatarCell src={user.avatar_url} name={user.nombre} />
				</td>
				<td class="mr-12 flex items-center space-x-6 p-4 whitespace-nowrap">
					<StackedText
						title={`${user.nombre} ${user.apellido}`}
						subtitle={user.correo}
					/>
				</td>
				<td class="max-w-sm truncate overflow-hidden p-4 text-base font-normal text-gray-500 xl:max-w-xs dark:text-gray-400">
					{user.organizacion}
				</td>
				<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
					{user.cargo}
				</td>
				<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
					{user.paises?.nombre_paises ?? '—'}
				</td>
				<td class="p-4 text-base font-medium whitespace-nowrap text-gray-900 dark:text-white">
					<StatusBadge active={user.estado === 'activo'} label={user.estado} />
				</td>
				<td class="p-4 text-base font-normal whitespace-nowrap text-gray-900 dark:text-white">
					<div class="flex items-center gap-1">
						{roles?.map(
							(rol) =>
								user.user_id === rol.user_id &&
								(() => {
									let badgeClass = 'text-xs font-medium px-1.5 py-0.5 rounded ';

									switch (rol.roles.name) {
										case 'admin':
											badgeClass += 'bg-danger-soft text-fg-danger-strong';
											break;
										case 'cliente':
											badgeClass += 'bg-success-soft text-fg-success-strong';
											break;
										case 'partner':
											badgeClass += 'bg-warning-soft text-fg-warning';
											break;
										case 'operaciones':
											badgeClass += 'bg-warning-soft text-fg-warning';
											break;
										default:
											badgeClass += 'bg-success-soft text-fg-success-strong';
									}

									return <span class={badgeClass}>{rol.roles.name}</span>;
								})(),
						)}
					</div>
				</td>
				<td class="flex space-x-2 p-4">
					<button
						data-modal-target="top-right-modal"
						data-modal-toggle="top-right-modal"
						data-user-notification
						data-user-id={user.user_id}
						class="block w-full rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none md:w-auto dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
						type="button"
					>
						Enviar notificación
					</button>
				</td>
			</tr>
		))
	}
</DataTable>

<!-- Top Right Modal -->
<div
	id="top-right-modal"
	data-modal-placement="top-right"
	tabindex="-1"
	class="fixed top-0 right-0 left-0 z-50 hidden h-full w-full overflow-x-hidden overflow-y-auto p-4 md:inset-0"
>
	<div class="relative h-full w-full max-w-2xl">
		<!-- Modal content -->
		<div
			class="dark:bg-black-800 relative h-full rounded-lg bg-white shadow-sm"
		>
			<!-- Modal header -->
			<div
				class="flex items-center justify-between rounded-t border-b border-gray-200 p-4 md:p-5 dark:border-gray-600"
			>
				<h3 class="text-xl font-medium text-gray-900 dark:text-white">
					Mensaje para el usuario
				</h3>
				<button
					type="button"
					class="ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-white"
					data-modal-hide="top-right-modal"
				>
					<svg
						class="h-3 w-3"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 14 14"
					>
						<path
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
					</svg>
					<span class="sr-only">Cerrar modal</span>
				</button>
			</div>
			<!-- Modal body -->
			<div class="space-y-4 p-4 md:p-5">
				<form action="/api/update/admin-notifications-update" method="post">
					<input
						type="text"
						name="user_id_modal_name"
						id="user_id_modal"
						hidden
					/>
					<div class="mb-4 grid gap-4 sm:grid-cols-2">
						<div>
							<label for="descripcion-link-notificacion" class={labelClasses}
								>Descripción del link</label
							>
							<input
								type="text"
								name="descripcion-link-notificacion"
								id="descripcion-link-notificacion"
								class={inputClasses}
								placeholder="Inserta el link"
								required=""
							/>
						</div>
						<div>
							<label for="link-notificacion" class={labelClasses}>Link</label>
							<input
								type="text"
								name="link-notificacion"
								id="link-notificacion"
								class={inputClasses}
								placeholder="Inserta el asunto del correo"
								required=""
							/>
						</div>
						<div class="h-full sm:col-span-2">
							<label for="mensaje-notificacion" class={labelClasses}
								>Mensaje</label
							>
							<textarea
								id="mensaje-notificacion"
								name="mensaje-notificacion"
								rows="28"
								class="focus:ring-primary-500 focus:border-primary-500 dark:bg-black-900 mb-2 block h-full w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 dark:border-gray-600 dark:text-white dark:placeholder-gray-400 dark:focus:border-[#967432] dark:focus:ring-[#967432]"
								placeholder="Escribe un mensaje corto para el usuario"
								required></textarea>
						</div>
					</div>
					<div
						class="flex items-center space-x-3 rounded-b border-t border-gray-200 p-4 md:p-5 rtl:space-x-reverse dark:border-gray-600"
					>
						<button
							data-modal-hide="top-right-modal"
							type="submit"
							class="rounded-lg bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
							>Enviar notificación</button
						>
						<button
							data-modal-hide="top-right-modal"
							type="button"
							class="ms-3 rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 focus:outline-none dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-[#101522] dark:hover:text-white dark:focus:ring-gray-700"
							>Cancelar</button
						>
					</div>
				</form>
			</div>
			<!-- Modal footer -->
		</div>
	</div>
</div>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function () {
		// Obtener todos los botones de notificación
		const notificationButtons = document.querySelectorAll(
			'button[data-user-notification]',
		);

		notificationButtons.forEach(function (button) {
			button.addEventListener('click', function () {
				// Obtener el user_id del dataset
				const userId = this.getAttribute('data-user-id');

				// Buscar el input en el modal por su name
				const userInput = document.querySelector(
					'input[name="user_id_modal_name"]',
				);

				if (userInput && userId) {
					// Asignar el valor
					userInput.value = userId;
				} else {
					console.log('No se encontró el input o no hay user_id');
					console.log('User ID desde dataset:', userId);
					console.log('Input encontrado:', userInput);
				}
			});
		});
	});
</script>
