---
import Alerta from '@components/feedback/Alert.astro';
import CrudPageHeader from '@components/ui/CrudPageHeader.astro';
import { getAllUsuarios } from '@domains/users/users';
import { RolesGeneralUsers } from '@domains/utils/roles/roles';
import UserNotificationsTable from '@modules/admin/islands/UserNotificationsTable';

const supabase = Astro.locals.supabase;
const [usuarios, roles] = await Promise.all([
	getAllUsuarios(supabase),
	RolesGeneralUsers(supabase),
]);
---

<div
	class="block items-center justify-between p-4 sm:flex lg:mt-1.5 dark:border-gray-700"
>
	<Alerta />
	<CrudPageHeader title="Lista de usuarios" />
</div>

<UserNotificationsTable
	client:load
	usuarios={usuarios ?? []}
	roles={roles ?? []}
/>
