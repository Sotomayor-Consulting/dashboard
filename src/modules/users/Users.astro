---
import UsersCrudTable from '@modules/users/islands/UsersCrudTable';
import { getUsersPageData } from '@modules/users/services/get-users-page-data';

const supabase = Astro.locals.supabase;
const { usuarios, roles, paises, rolesGeneral } = await getUsersPageData(supabase);
---

<UsersCrudTable
	client:load
	usuarios={usuarios}
	roles={roles}
	paises={paises}
	rolesGeneral={rolesGeneral}
/>
