---
// ─── Set Password (post-invitación) ─────────────────────
// Página a la que llega el usuario tras hacer clic en el enlace
// de invitación. Para entonces ya tiene sesión activa (el callback
// hizo exchangeCodeForSession). Aquí define su contraseña inicial.
import AstroLogo from '@assets/SC-INTER.webp';
import AstroLogoNg from '@assets/SC-INTER-NG.webp';
import { Image } from 'astro:assets';

const user = Astro.locals.user;
const email = user?.email ?? '';
const status = Astro.url.searchParams.get('status');
const msg = Astro.url.searchParams.get('msg');
---

<div
	class="w-full flex flex-col items-center justify-center px-6 pt-8 mx-auto pt:mt-0"
>
	<div
		class="w-full bg-gray-50 rounded-lg shadow md:mt-0 sm:max-w-md xl:p-0 dark:bg-black-900"
	>
		<a
			href="/"
			class="flex items-center justify-center mt-3 text-2xl font-semibold dark:text-white"
		>
			<Image
				src={AstroLogo}
				alt="Sotomayor Logo"
				height={44}
				class="h-11 dark:block hidden"
			/>
			<Image
				src={AstroLogoNg}
				alt="Sotomayor Logo"
				height={44}
				class="h-11 dark:hidden block"
			/>
		</a>

		<div class="w-full p-6 sm:p-8">
			{/* Header con ícono */}
			<div class="text-center space-y-3 mb-6">
				<div
					class="mx-auto w-12 h-12 bg-primary-600 dark:bg-[#134aed] rounded-full flex items-center justify-center"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-6 h-6 text-white"
						viewBox="0 0 24 24"
						fill="currentColor"
					>
						<path
							d="M14 14a4 4 0 1 0-3.5-2H3v3h2v3h3v-3h2.5A4 4 0 0 0 14 14m4-4a2 2 0 1 1 0-4 2 2 0 0 1 0 4"
						></path>
					</svg>
				</div>
				<h1 class="text-2xl font-bold text-gray-900 dark:text-white">
					Bienvenido al portal
				</h1>
				<p class="text-sm text-gray-500 dark:text-gray-400">
					Gracias por tu compra. Para acceder a tu contenido,
					crea una contraseña para tu cuenta.
				</p>
			</div>

			{
				status === 'error' && msg && (
					<div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700 dark:bg-red-900/30 dark:text-red-400">
						{msg}
					</div>
				)
			}

			<form
				class="mt-2 space-y-5"
				action="/api/auth/reset-password"
				method="post"
				x-data="{
					password: '',
					confirmPassword: '',
					showPassword: false,
					showConfirm: false,
					loading: false,
					get valid() { return this.password.length >= 6; },
					get match() { return this.password.length > 0 && this.password === this.confirmPassword; },
					get canSubmit() { return this.valid && this.match && !this.loading; }
				}"
				@submit="loading = true"
			>
				{/* Email (solo lectura) */}
				<div>
					<label
						for="email"
						class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
					>
						Tu correo de compra
					</label>
					<input
						id="email"
						type="email"
						value={email}
						disabled
						class="border sm:text-sm rounded-lg block w-full p-2.5 cursor-not-allowed
							bg-gray-100 dark:bg-[#05121d]/60 border-gray-300 dark:border-gray-700
							text-gray-500 dark:text-gray-400"
					/>
				</div>

				{/* Nueva contraseña */}
				<div>
					<label
						for="password"
						class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
					>
						Nueva contraseña
					</label>
					<div class="relative">
						<input
							id="password"
							name="password"
							:type="showPassword ? 'text' : 'password'"
							x-model="password"
							placeholder="Mínimo 6 caracteres"
							minlength="6"
							required
							autofocus
							class="border sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 pr-10
								dark:bg-[#05121d] bg-white border-gray-600 placeholder-gray-400 dark:text-white text-neutral-900"
						/>
						<button
							type="button"
							@click="showPassword = !showPassword"
							class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white"
							aria-label="Mostrar u ocultar contraseña"
						>
							<svg x-show="!showPassword" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7"/><circle cx="12" cy="12" r="3"/></svg>
							<svg x-show="showPassword" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-7 0-10-7-10-7a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
						</button>
					</div>
					<p
						x-show="password.length > 0 && !valid"
						x-cloak
						class="mt-1 text-xs text-red-600 dark:text-red-400"
					>
						La contraseña debe tener al menos 6 caracteres.
					</p>
				</div>

				{/* Confirmar contraseña */}
				<div>
					<label
						for="confirm-password"
						class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
					>
						Confirmar contraseña
					</label>
					<div class="relative">
						<input
							id="confirm-password"
							name="confirm-password"
							:type="showConfirm ? 'text' : 'password'"
							x-model="confirmPassword"
							placeholder="Repite tu contraseña"
							minlength="6"
							required
							class="border sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5 pr-10
								dark:bg-[#05121d] bg-white border-gray-600 placeholder-gray-400 dark:text-white text-neutral-900"
						/>
						<button
							type="button"
							@click="showConfirm = !showConfirm"
							class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white"
							aria-label="Mostrar u ocultar contraseña"
						>
							<svg x-show="!showConfirm" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7"/><circle cx="12" cy="12" r="3"/></svg>
							<svg x-show="showConfirm" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-7 0-10-7-10-7a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
						</button>
					</div>
					<p
						x-show="confirmPassword.length > 0 && !match"
						x-cloak
						class="mt-1 text-xs text-red-600 dark:text-red-400"
					>
						Las contraseñas no coinciden.
					</p>
					<p
						x-show="match"
						x-cloak
						class="mt-1 text-xs text-green-600 dark:text-green-400 flex items-center gap-1"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
						Las contraseñas coinciden.
					</p>
				</div>

				{/* Términos */}
				<div class="flex items-start">
					<div class="flex items-center h-5">
						<input
							id="terms"
							name="terms"
							type="checkbox"
							required
							class="w-4 h-4 rounded focus:ring-3 focus:ring-primary-500 ring-offset-gray-800 dark:bg-[#05121d] bg-white border-gray-600 text-primary-600"
						/>
					</div>
					<div class="ml-3 text-sm">
						<label
							for="terms"
							class="font-medium text-gray-900 dark:text-white"
						>
							Acepto los
							<a
								href="https://sotomayorconsulting.com/inicio/terminos/"
								target="_blank"
								rel="noopener"
								class="text-primary-600 hover:underline">Términos y Condiciones</a
							>
						</label>
					</div>
				</div>

				<button
					type="submit"
					:disabled="!canSubmit"
					class="w-full px-5 py-3 text-base font-medium text-center text-white rounded-lg
						bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:ring-primary-300
						dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]
						disabled:opacity-50 disabled:cursor-not-allowed transition-opacity"
				>
					<span x-show="!loading">Acceder al portal</span>
					<span x-show="loading" x-cloak>Configurando acceso…</span>
				</button>
			</form>

			<p
				class="mt-6 text-center text-xs text-gray-500 dark:text-gray-400"
			>
				Al continuar, aceptas nuestros
				<a
					href="https://sotomayorconsulting.com/inicio/terminos/"
					target="_blank"
					rel="noopener"
					class="text-gray-900 dark:text-white hover:underline font-medium"
					>Términos de servicio</a
				>
				y
				<a
					href="https://sotomayorconsulting.com/inicio/privacidad/"
					target="_blank"
					rel="noopener"
					class="text-gray-900 dark:text-white hover:underline font-medium"
					>Política de privacidad</a
				>.
			</p>
		</div>
	</div>
</div>
