---
import { Icon } from 'astro-icon/components';
---

<div
	class="w-full flex flex-col items-center justify-center px-6 pt-8 mx-auto pt:mt-0"
>
	<!-- Card -->
	<div
		class="w-full max-w-xl p-6 space-y-8 sm:p-8 bg-gray-200 rounded-lg shadow dark:bg-black-900"
	>
		<a
			href="/sign-in"
			class="flex items-center justify-center mb-8 text-2xl font-semibold lg:mb-10 dark:text-white"
		>
			<Icon
				name="logo-en-blanco"
				class="mr-4 dark:block hidden text-4xl"
				title="sign-in"
			/>
			<Icon
				name="logo-en-negro"
				class="mr-4 dark:hidden block text-4xl"
				title="sign-in"
			/>
		</a>
		<h2 class="text-2xl font-bold text-gray-900 dark:text-white">
			Inicia sesión
		</h2>
		<form class="mt-8 space-y-6" action="/api/auth/signin" method="post">
			<div>
				<label
					for="email"
					class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
					>Tu correo</label
				>
				<input
					type="email"
					name="email"
					id="email"
					class="border sm:text-sm rounded-lg focus:ring-[#134aed] focus:border-[#8c681d] block w-full p-2.5 dark:bg-black-800 bg-white border-gray-600 placeholder-gray-400 dark:text-white text-neutral-700"
					placeholder="correo@ejemplo.com"
					autocomplete="email"
					required
				/>
			</div>
			<div>
				<label
					for="password"
					class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
					>Tu contraseña</label
				>
				<input
					type="password"
					name="password"
					id="password"
					placeholder="••••••••"
					class="border sm:text-sm rounded-lg focus:ring-[#134aed] focus:border-[#8c681d] block w-full p-2.5 dark:bg-black-800 bg-white border-gray-600 placeholder-gray-400 dark:text-white text-neutral-700"
					autocomplete="on"
					required
				/>
			</div>
			<div class="flex items-start flex-wrap">
				<div class="flex items-center h-5">
					<input
						id="remember"
						aria-describedby="remember"
						name="remember"
						type="checkbox"
						class="w-4 h-4 border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-[#967432] dark:focus:ring-[#134aed] dark:ring-offset-gray-800 dark:bg-black-800 dark:border-gray-600 text-[#967432] dark:text-[#134aed]"
					/>
				</div>
				<div class="ml-3 text-sm">
					<label
						for="remember"
						class="font-medium text-gray-900 dark:text-white">Recuérdame</label
					>
				</div>
				<a
					href="/forgot-password"
					class="ml-auto mt-4 text-left text-sm text-[#8c681d] hover:underline dark:text-[#134aed] w-full"
					>Olvide mi contraseña</a
				>
			</div>
			<div class="w-full flex">
				<button
					type="submit"
					class="w-full px-5 py-3 text-base font-medium text-center text-white bg-[#8c681d] rounded-lg hover:bg-[#8c681d] focus:ring-4 focus:ring-[#967432] sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#134aed] cursor-pointer"
					>Iniciar sesión</button
				>
			</div>

			<div class="text-sm font-medium text-gray-500 dark:text-gray-400">
				¿No tienes una cuenta? <a
					href="/sign-up"
					class="text-[#8c681d] hover:underline dark:text-[#134aed]"
					>Crear una cuenta</a
				>
			</div>
			<div>
				<div class="inline-flex items-center justify-center w-full">
					<hr
						class="w-11/12 h-px my-5 border-0 dark:bg-black-800 bg-gray-300"
					/>
					<span class="absolute px-5 font-medium text-gray-900 dark:text-white">
						o
					</span>
				</div>
			</div>
		</form>
		<div>
			<form class="mt-8 space-y-6" action="/api/auth/signin" method="post">
				<button
					class="w-full flex border dark:border-white border-gray-500 rounded-lg dark:text-white gap-2 items-center justify-center p-2.5 dark:hover:bg-slate-300/10 hover:bg-slate-700/10 cursor-pointer"
					value="google"
					name="provider"
					id="provider"
					type="submit"
				>
					<Icon name="ri:google-fill" class="text-2xl" />
					Iniciar con Google
				</button>
			</form>
		</div>
	</div>
</div>
