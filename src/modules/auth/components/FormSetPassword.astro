---
// ─── Set Password (post-invitación) ─────────────────────
// Página a la que llega el usuario tras hacer clic en el enlace
// de invitación. Para entonces ya tiene sesión activa (el callback
// hizo exchangeCodeForSession). Aquí define su contraseña inicial.
import { Icon } from 'astro-icon/components';

const user = Astro.locals.user;
const email = user?.email ?? Astro.url.searchParams.get('email') ?? '';
const status = Astro.url.searchParams.get('status');
const msg = Astro.url.searchParams.get('msg');
---

<div
	class="pt:mt-0 mx-auto flex w-full flex-col items-center justify-center px-6 pt-8"
>
	<div
		class="dark:bg-black-900 w-full rounded-lg bg-gray-50 shadow sm:max-w-md md:mt-0 xl:p-0"
	>
		<a
			href="/"
			class="mt-4 flex items-center justify-center text-2xl font-semibold dark:text-white"
		>
			<Icon
				name="logo-sotomayor-consulting-black"
				class="hidden h-11 w-auto dark:block"
				title="Sotomayor Logo"
			/>
			<Icon
				name="logo-sotomayor-consulting"
				class="block h-11 w-auto dark:hidden"
				title="Sotomayor Logo"
			/>
		</a>

		<div class="w-full p-6 sm:p-8">
			{/* Header con ícono */}
			<div class="mb-7 space-y-3 text-center">
				<h1
					class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
				>
					Bienvenido al portal
				</h1>
				<p
					class="mx-auto max-w-sm text-sm leading-relaxed text-gray-500 dark:text-gray-400"
				>
					Gracias por tu compra. Para acceder a tu contenido, crea una
					contraseña para tu cuenta.
				</p>
			</div>

			{
				status === 'error' && msg && (
					<div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700 dark:bg-red-900/30 dark:text-red-400">
						{msg}
					</div>
				)
			}
			<form
				class="mt-2 space-y-5"
				action="/api/auth/reset-password"
				method="post"
				x-data="{
					password: '',
					confirmPassword: '',
					showPassword: false,
					showConfirm: false,
					loading: false,
					get valid() { return this.password.length >= 6; },
					get match() { return this.password.length > 0 && this.password === this.confirmPassword; },
					get canSubmit() { return this.valid && this.match && !this.loading; }
				}"
				x-on:submit="loading = true"
			>
				{/* Email (solo lectura) */}
				<div>
					<label
						for="email"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
					>
						Tu correo de compra
					</label>
					<div class="relative">
						<span
							class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 dark:text-gray-500"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="h-4 w-4"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<rect x="3" y="5" width="18" height="14" rx="2"></rect><path
									d="m3 7 9 6 9-6"></path>
							</svg>
						</span>
						<input
							id="email"
							type="email"
							value={email || 'No disponible'}
							disabled
							class="block w-full cursor-not-allowed rounded-xl border border-gray-300 bg-gray-100 py-2.5 pr-3 pl-9 text-sm text-gray-500 dark:border-gray-700 dark:bg-[#05121d]/60 dark:text-gray-400"
						/>
					</div>
				</div>

				{/* Nueva contraseña */}
				<div>
					<label
						for="password"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
					>
						Nueva contraseña
					</label>
					<div class="relative">
						<input
							id="password"
							name="password"
							x-bind:type="showPassword ? 'text' : 'password'"
							x-model="password"
							placeholder="Mínimo 6 caracteres"
							minlength="6"
							required
							autofocus
							class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 pr-16 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100 dark:placeholder:text-slate-500"
						/>
						<button
							type="button"
							x-on:click="showPassword = !showPassword"
							class="absolute inset-y-0 right-0 flex items-center pr-3 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
							aria-label="Mostrar u ocultar contraseña"
							x-bind:title="showPassword ? 'Ocultar contraseña' : 'Mostrar contraseña'"
						>
							<span x-show="!showPassword">Mostrar</span>
							<span x-show="showPassword" x-cloak style="display:none"
								>Ocultar</span
							>
						</button>
					</div>
					<p
						x-show="password.length > 0 && !valid"
						x-cloak
						class="mt-1 text-xs text-red-600 dark:text-red-400"
					>
						La contraseña debe tener al menos 6 caracteres.
					</p>
				</div>
				{/* Confirmar contraseña */}
				<div>
					<label
						for="confirm-password"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
					>
						Confirmar contraseña
					</label>
					<div class="relative">
						<input
							id="confirm-password"
							name="confirm-password"
							x-bind:type="showConfirm ? 'text' : 'password'"
							x-model="confirmPassword"
							placeholder="Repite tu contraseña"
							minlength="6"
							required
							class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 pr-16 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100 dark:placeholder:text-slate-500"
						/>
						<button
							type="button"
							x-on:click="showConfirm = !showConfirm"
							class="absolute inset-y-0 right-0 flex items-center pr-3 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
							aria-label="Mostrar u ocultar contraseña"
							x-bind:title="showConfirm ? 'Ocultar contraseña' : 'Mostrar contraseña'"
						>
							<span x-show="!showConfirm">Mostrar</span>
							<span x-show="showConfirm" x-cloak style="display:none"
								>Ocultar</span
							>
						</button>
					</div>
					<p
						x-show="confirmPassword.length > 0 && !match"
						x-cloak
						class="mt-1 text-xs text-red-600 dark:text-red-400"
					>
						Las contraseñas no coinciden.
					</p>
					<p
						x-show="match"
						x-cloak
						class="mt-1 flex items-center gap-1 text-xs text-green-600 dark:text-green-400"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							class="h-3 w-3"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="3"
							stroke-linecap="round"
							stroke-linejoin="round"
							><polyline points="20 6 9 17 4 12"></polyline></svg
						>
						Las contraseñas coinciden.
					</p>
				</div>

				{/* Términos */}
				<div class="flex items-start">
					<div class="flex h-5 items-center">
						<input
							id="terms"
							name="terms"
							type="checkbox"
							required
							class="peer border-white-400 dark:bg-input/30 size-4 shrink-0 rounded-xs border transition-colors outline-none focus-visible:ring-3 focus-visible:ring-[#8c681d]/30 disabled:cursor-not-allowed disabled:opacity-50"
						/>
					</div>
					<div class="ml-3 text-sm">
						<label
							for="terms"
							class="font-medium text-gray-900 dark:text-white"
						>
							Acepto los
							<a
								href="https://sotomayorconsulting.com/inicio/terminos/"
								target="_blank"
								rel="noopener"
								class="text-primary-600 hover:underline"
								>Términos y Condiciones</a
							>
						</label>
					</div>
				</div>

				<button
					type="submit"
					x-bind:disabled="!canSubmit"
					class="w-full rounded-lg border border-slate-300 bg-white px-5 py-3 text-center text-base font-medium text-slate-900 transition hover:bg-slate-100 focus:ring-2 focus:ring-[#8c681d]/30 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100 dark:hover:bg-[#111a2d]"
				>
					<span x-show="!loading">Acceder al portal</span>
					<span x-show="loading" x-cloak>Configurando acceso…</span>
				</button>
			</form>

			<p class="mt-6 text-center text-xs text-gray-500 dark:text-gray-400">
				Al continuar, aceptas nuestros
				<a
					href="https://sotomayorconsulting.com/inicio/terminos/"
					target="_blank"
					rel="noopener"
					class="font-medium text-gray-900 hover:underline dark:text-white"
					>Términos de servicio</a
				>
				y
				<a
					href="https://sotomayorconsulting.com/inicio/privacidad/"
					target="_blank"
					rel="noopener"
					class="font-medium text-gray-900 hover:underline dark:text-white"
					>Política de privacidad</a
				>.
			</p>
		</div>
	</div>
</div>
