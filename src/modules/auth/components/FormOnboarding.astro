---
// ─── Onboarding form ─────────────────────────────────────
// Captura los datos faltantes de la empresa cuando el usuario llegó
// vía invitación de Odoo: tipo de negocio, estado de incorporación
// y hasta 3 opciones de nombre.
import { Icon } from 'astro-icon/components';

interface Props {
	empresaId: string;
}
const { empresaId } = Astro.props;

const status = Astro.url.searchParams.get('status');
const msg = Astro.url.searchParams.get('msg');

// Estados frecuentes para incorporación de LLC en EE.UU.
const ESTADOS = [
	'Wyoming',
	'Delaware',
	'Florida',
	'Texas',
	'New Mexico',
	'Nevada',
	'California',
	'New York',
];
---

<div
	class="mx-auto flex w-full flex-col items-center justify-center px-6 pt-8 pt:mt-0"
>
	<div
		class="dark:bg-black-900 w-full rounded-lg bg-gray-50 shadow sm:max-w-xl md:mt-0 xl:p-0"
	>
		<a
			href="/"
			class="mt-4 flex items-center justify-center text-2xl font-semibold dark:text-white"
		>
			<Icon
				name="logo-sotomayor-consulting-black"
				class="hidden h-11 w-auto dark:block"
				title="Sotomayor Logo"
			/>
			<Icon
				name="logo-sotomayor-consulting"
				class="block h-11 w-auto dark:hidden"
				title="Sotomayor Logo"
			/>
		</a>

		<div class="w-full p-6 sm:p-8">
			<div class="mb-7 space-y-3 text-center">
				<h1
					class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
				>
					Cuéntanos sobre tu empresa
				</h1>
				<p
					class="mx-auto max-w-md text-sm leading-relaxed text-gray-500 dark:text-gray-400"
				>
					Necesitamos algunos datos para iniciar el proceso de
					incorporación de tu empresa en EE.UU.
				</p>
			</div>

			{
				status === 'error' && msg && (
					<div class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-700 dark:bg-red-900/30 dark:text-red-400">
						{msg}
					</div>
				)
			}

			<form
				class="mt-2 space-y-5"
				action={`/api/onboarding/complete?empresaId=${empresaId}`}
				method="post"
				x-data="{
					tipo: 'LLC',
					estado: 'Wyoming',
					nombre1: '',
					nombre2: '',
					nombre3: '',
					loading: false,
					get canSubmit() { return this.tipo && this.estado && this.nombre1.trim().length > 0 && !this.loading; }
				}"
				x-on:submit="loading = true"
			>
				<input type="hidden" name="empresa_incorporacion_id" value={empresaId} />

				{/* Tipo de negocio + Estado */}
				<div class="grid gap-4 md:grid-cols-2">
					<div>
						<label
							for="tipo_de_negocio"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
						>
							Tipo de negocio
						</label>
						<select
							id="tipo_de_negocio"
							name="tipo_de_negocio"
							x-model="tipo"
							required
							class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100"
						>
							<option value="LLC">LLC</option>
							<option value="C-corporation">C-Corporation</option>
						</select>
					</div>
					<div>
						<label
							for="estado_de_incorporacion"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
						>
							Estado de incorporación
						</label>
						<select
							id="estado_de_incorporacion"
							name="estado_de_incorporacion"
							x-model="estado"
							required
							class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100"
						>
							{ESTADOS.map((e) => <option value={e}>{e}</option>)}
						</select>
					</div>
				</div>

				{/* Nombres propuestos */}
				<div class="space-y-3">
					<div>
						<label
							for="nombre_1"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
						>
							Nombre principal de la empresa
							<span class="text-red-600">*</span>
						</label>
						<input
							id="nombre_1"
							name="nombre_1"
							type="text"
							x-model="nombre1"
							placeholder="Ej. Acme Holdings LLC"
							required
							class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100"
						/>
						<p
							class="mt-1 text-xs text-gray-500 dark:text-gray-400"
						>
							Si no está disponible, usaremos las alternativas en orden.
						</p>
					</div>
					<div class="grid gap-3 md:grid-cols-2">
						<div>
							<label
								for="nombre_2"
								class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>
								Alternativa 1
							</label>
							<input
								id="nombre_2"
								name="nombre_2"
								type="text"
								x-model="nombre2"
								placeholder="Opcional"
								class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100"
							/>
						</div>
						<div>
							<label
								for="nombre_3"
								class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>
								Alternativa 2
							</label>
							<input
								id="nombre_3"
								name="nombre_3"
								type="text"
								x-model="nombre3"
								placeholder="Opcional"
								class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100"
							/>
						</div>
					</div>
				</div>

				<button
					type="submit"
					x-bind:disabled="!canSubmit"
					class="w-full rounded-lg border border-slate-300 bg-white px-5 py-3 text-center text-base font-medium text-slate-900 transition hover:bg-slate-100 focus:ring-2 focus:ring-[#8c681d]/30 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100 dark:hover:bg-[#111a2d]"
				>
					<span x-show="!loading">Continuar</span>
					<span x-show="loading" x-cloak>Guardando…</span>
				</button>
			</form>
		</div>
	</div>
</div>

<script src="@third-party/alpinejs/alpine.js"></script>
