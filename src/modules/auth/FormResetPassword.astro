---
import AstroLogo from '@assets/SC-INTER.webp';
import AstroLogoNg from '@assets/SC-INTER-NG.webp';
import { Image } from 'astro:assets';
---

<div
	class="w-full flex flex-col items-center justify-center px-6 pt-8 mx-auto pt:mt-0"
>
	<!-- Card -->
	<div
		class="w-full bg-gray-50 rounded-lg shadow md:mt-0 sm:max-w-md xl:p-0 dark:bg-black-900"
	>
		<a
			href="/"
			class="flex items-center justify-center mt-3 text-2xl font-semibold dark:text-white"
		>
			<Image
				src={AstroLogo}
				alt="Sotomayor Logo"
				height={44}
				class="h-11 dark:block hidden"
			/>
			<Image
				src={AstroLogoNg}
				alt="Sotomayor Logo"
				height={44}
				class="h-11 dark:hidden block"
			/>
		</a>
		<div class="w-full p-6 sm:p-8">
			<h2 class="mb-3 text-2xl font-bold text-gray-900 dark:text-white">
				Restablecer contraseña
			</h2>
			<p class="text-base font-normal text-gray-500 dark:text-gray-400">
				Ingresa tu nueva contraseña. Debe tener al menos 6 caracteres.
			</p>
			<form
				class="mt-8 space-y-6"
				action="/api/auth/reset-password"
				method="post"
			>
				<div>
					<label
						for="password"
						class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
						>Nueva contraseña</label
					>
					<input
						type="password"
						name="password"
						id="password"
						placeholder="••••••••"
						class="border sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5
							dark:bg-[#05121d] bg-white border-gray-600 placeholder-gray-400 dark:text-white text-neutral-900"
						minlength="6"
						required
					/>
				</div>
				<div>
					<label
						for="confirm-password"
						class="block mb-2 text-sm font-medium text-gray-900 dark:text-white"
						>Confirmar nueva contraseña</label
					>
					<input
						type="password"
						name="confirm-password"
						id="confirm-password"
						placeholder="••••••••"
						class="border sm:text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5
							dark:bg-[#05121d] bg-white border-gray-600 placeholder-gray-400 dark:text-white text-neutral-900"
						minlength="6"
						required
					/>
				</div>
				<div class="flex items-start">
					<div class="flex items-center h-5">
						<input
							id="terms"
							aria-describedby="terms"
							name="terms"
							type="checkbox"
							class="w-4 h-4 rounded focus:ring-3 focus:ring-primary-500 ring-offset-gray-800 dark:bg-[#05121d] bg-white border-gray-600 text-primary-600"
							required
						/>
					</div>
					<div class="ml-3 text-sm">
						<label
							for="terms"
							class="font-medium text-gray-900 dark:text-white"
							>Acepto los <a
								href="https://sotomayorconsulting.com/inicio/terminos/"
								class="text-primary-600 hover:underline">Términos y Condiciones</a
							></label
						>
					</div>
				</div>
				<button
					type="submit"
					class="w-full px-5 py-3 text-base font-medium text-center text-white rounded-lg bg-primary-600 hover:bg-primary-700 focus:ring-4 focus:ring-primary-300 sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
					>Establecer nueva contraseña</button
				>
			</form>
		</div>
	</div>
</div>
