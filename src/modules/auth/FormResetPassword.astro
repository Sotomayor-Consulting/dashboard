---
import AstroLogo from '@assets/SC-INTER.webp';
import AstroLogoNg from '@assets/SC-INTER-NG.webp';
import { Image } from 'astro:assets';

const user = Astro.locals.user;
const email = user?.email ?? Astro.url.searchParams.get('email') ?? '';
---

<div
	class="pt:mt-0 mx-auto flex w-full flex-col items-center justify-center px-6 pt-8"
>
	<div
		class="dark:bg-black-900 w-full rounded-lg bg-gray-50 shadow sm:max-w-md md:mt-0 xl:p-0"
	>
		<a
			href="/"
			class="mt-4 flex items-center justify-center text-2xl font-semibold dark:text-white"
		>
			<Image
				src={AstroLogo}
				alt="Sotomayor Logo"
				height={44}
				class="hidden h-11 dark:block"
			/>
			<Image
				src={AstroLogoNg}
				alt="Sotomayor Logo"
				height={44}
				class="block h-11 dark:hidden"
			/>
		</a>
		<div class="w-full p-6 sm:p-8">
			<div class="mb-6 text-center">
				<h2
					class="mb-2 text-[28px] leading-[1.15] tracking-[-0.02em] text-black dark:text-white"
				>
					Restablecer contraseña
				</h2>
				<p class="text-sm text-[#777169] dark:text-gray-400">
					Ingresa tu nueva contraseña. Debe tener al menos 6 caracteres.
				</p>
			</div>
			<form
				class="mt-8 space-y-6"
				action="/api/auth/reset-password"
				method="post"
				x-data="{ showPassword: false, showConfirm: false }"
			>
				<div>
					<label
						for="email"
						class="mb-2 block text-sm font-medium text-black dark:text-white"
					>
						Tu correo de compra
					</label>
					<input
						id="email"
						type="email"
						value={email || 'No disponible'}
						disabled
						class="block h-11 w-full cursor-not-allowed rounded-xl border border-slate-300 bg-slate-100 px-3 text-sm text-slate-500 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-400"
					/>
				</div>
				<div>
					<label
						for="password"
						class="mb-2 block text-sm font-medium text-black dark:text-white"
						>Nueva contraseña</label
					>
					<div class="relative">
						<input
							x-bind:type="showPassword ? 'text' : 'password'"
							name="password"
							id="password"
							placeholder="Minimo 6 caracteres"
							class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 pr-16 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100 dark:placeholder:text-slate-500"
							minlength="6"
							required
						/>
						<button
							type="button"
							x-on:click="showPassword = !showPassword"
							class="absolute inset-y-0 right-0 flex items-center pr-3 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
							x-bind:title="showPassword ? 'Ocultar contraseña' : 'Mostrar contraseña'"
							aria-label="Mostrar u ocultar contraseña"
						>
							<span x-show="!showPassword">Mostrar</span>
							<span x-show="showPassword" x-cloak style="display:none"
								>Ocultar</span
							>
						</button>
					</div>
				</div>
				<div>
					<label
						for="confirm-password"
						class="mb-2 block text-sm font-medium text-black dark:text-white"
						>Confirmar nueva contraseña</label
					>
					<div class="relative">
						<input
							x-bind:type="showConfirm ? 'text' : 'password'"
							name="confirm-password"
							id="confirm-password"
							placeholder="Repite tu contraseña"
							class="block h-11 w-full rounded-xl border border-slate-300 bg-white px-3 pr-16 text-sm text-slate-900 placeholder:text-slate-400 focus:border-[#8c681d] focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100 dark:placeholder:text-slate-500"
							minlength="6"
							required
						/>
						<button
							type="button"
							x-on:click="showConfirm = !showConfirm"
							class="absolute inset-y-0 right-0 flex items-center pr-3 text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
							x-bind:title="showConfirm ? 'Ocultar contraseña' : 'Mostrar contraseña'"
							aria-label="Mostrar u ocultar contraseña"
						>
							<span x-show="!showConfirm">Mostrar</span>
							<span x-show="showConfirm" x-cloak style="display:none"
								>Ocultar</span
							>
						</button>
					</div>
				</div>
				<div class="flex items-start">
					<div class="flex h-5 items-center">
						<input
							id="terms"
							aria-describedby="terms"
							name="terms"
							type="checkbox"
							class="peer border-white-400 dark:bg-input/30 size-4 shrink-0 rounded-xs border transition-colors outline-none focus-visible:ring-3 focus-visible:ring-[#8c681d]/30 disabled:cursor-not-allowed disabled:opacity-50"
							required
						/>
					</div>
					<div class="ml-3 text-sm">
						<label for="terms" class="font-medium text-black dark:text-white"
							>Acepto los <a
								href="https://sotomayorconsulting.com/inicio/terminos/"
								class="text-black underline-offset-2 hover:underline dark:text-white"
								>Términos y Condiciones</a
							></label
						>
					</div>
				</div>
				<button
					type="submit"
					class="w-full rounded-lg border border-slate-300 bg-white px-5 py-3 text-center text-base font-medium text-slate-900 transition hover:bg-slate-100 focus:ring-2 focus:ring-[#8c681d]/30 dark:border-slate-600 dark:bg-[#0b1220] dark:text-slate-100 dark:hover:bg-[#111a2d]"
					>Establecer nueva contraseña</button
				>
			</form>
			<p class="mt-6 text-center text-xs text-[#777169] dark:text-gray-400">
				Al continuar, aceptas nuestra
				<a
					href="https://sotomayorconsulting.com/inicio/privacidad/"
					class="text-black underline-offset-2 hover:underline dark:text-white"
					>Política de privacidad</a
				>.
			</p>
		</div>
	</div>
</div>

<script src="@lib/alpinejs/alpine.js"></script>
