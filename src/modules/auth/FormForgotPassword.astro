---
import AstroLogo from '@assets/SC-INTER.webp';
import AstroLogoNg from '@assets/SC-INTER-NG.webp';
import { Image } from 'astro:assets';
---

<div
	class="pt:mt-0 mx-auto flex w-full flex-col items-center justify-center px-6 pt-8"
>
	<!-- Card -->
	<div
		class="bg-white-100 dark:bg-black-900 w-full rounded-lg shadow sm:max-w-md md:mt-0 xl:p-0"
	>
		<a
			href="/"
			class="mt-3 flex items-center justify-center text-2xl font-semibold dark:text-white"
		>
			<Image
				src={AstroLogo}
				alt="Sotomayor Logo"
				height={44}
				class="hidden h-11 dark:block"
			/>
			<Image
				src={AstroLogoNg}
				alt="Sotomayor Logo"
				height={44}
				class="block h-11 dark:hidden"
			/>
		</a>
		<div class="w-full p-6 sm:p-8">
			<h2 class="mb-3 text-2xl font-bold text-gray-900 dark:text-white">
				¿Olvidaste tu contraseña?
			</h2>
			<p class="text-base font-normal text-gray-500 dark:text-gray-400">
				¡No te preocupes! Solo escribe tu correo electrónico y te enviaremos un
				código para restablecer tu contraseña.
			</p>
			<form
				class="mt-8 space-y-6"
				action="/api/auth/forgot-password"
				method="post"
			>
				<div>
					<label
						for="email"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
						>Tu correo</label
					>
					<input
						type="email"
						name="email"
						id="email"
						class="block w-full rounded-lg border border-gray-600 bg-white p-2.5 text-neutral-900 placeholder-gray-400 focus:border-[#967432] focus:ring-[#967432] sm:text-sm dark:bg-[#05121d] dark:text-white"
						placeholder="correo@ejemplo.com"
						autocomplete="email"
						required
					/>
				</div>
				<div class="flex items-start">
					<div class="flex h-5 items-center">
						<input
							id="remember"
							aria-describedby="remember"
							name="remember"
							type="checkbox"
							class="h-4 w-4 rounded border-gray-600 bg-white text-[#967432] ring-offset-gray-800 focus:ring-3 focus:ring-[#967432] dark:bg-[#05121d]"
							required
						/>
					</div>
					<div class="ml-3 text-sm">
						<label
							for="remember"
							class="dtext-gray-900 font-medium dark:text-white"
							>Acepto los <a
								href="https://sotomayorconsulting.com/inicio/terminos/"
								class="text-[#8c681d] hover:underline">Términos y Condiciones</a
							></label
						>
					</div>
				</div>
				<button
					type="submit"
					class="focus:ring-primary-300 w-full rounded-lg bg-[#8c681d] px-5 py-3 text-center text-base font-medium text-white hover:bg-[#8c681d] focus:ring-4 sm:w-auto dark:bg-[#134aed] dark:hover:bg-[#134aed]/80 dark:focus:ring-[#323f67]"
					>Restablecer contraseña</button
				>
			</form>
		</div>
	</div>
</div>
