---
import { Image } from 'astro:assets';
import logo1 from '@assets/SC-INTER.png';
import logo2 from '@assets/SC-INTER-NG.png';
import PasswordMeter from '@components/forms/PasswordMeter.astro';
---

<div
	class="pt:mt-0 mx-auto mb-5 grid w-full grid-cols-1 gap-5 px-6 pt-8 lg:grid-cols-2"
>
	<div
		class="pt:mt-0 mx-auto flex w-full flex-col items-center justify-center px-6 pt-8"
	>
		<!-- Card -->
		<div
			class="dark:bg-black-900 bg-white w-full max-w-xl space-y-8 rounded-lg p-6 shadow sm:p-8"
		>
			<a
				href="/sign-up"
				class="mb-8 flex items-center justify-center text-2xl font-semibold lg:mb-10 dark:text-white"
			>
				<Image
					src={logo1}
					alt="Sotomayor Logo"
					height="44"
					class="mr-4 hidden dark:block"
				/>
				<Image
					src={logo2}
					alt="Sotomayor Logo"
					height="44"
					class="mr-4 block dark:hidden"
				/>
			</a>
			<h2 class="text-2xl font-bold text-gray-900 dark:text-white">
				Crea tu cuenta gratuita
			</h2>
			<form class="mt-8 space-y-6" action="/api/auth/register" method="post">
				<div class="grid grid-cols-2 gap-x-6 gap-y-8">
					<div class="col">
						<label
							for="name"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Nombre</label
						>
						<input
							type="text"
							name="name"
							id="name"
							class="block w-full rounded-lg border border-gray-600 bg-white p-2.5 placeholder-gray-400 focus:border-[#967432] focus:ring-[#967432] sm:text-sm dark:bg-[#05121d] dark:text-white"
							placeholder="Nombre"
							required
						/>
					</div>
					<div class="col">
						<label
							for="last-name"
							class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
							>Apellido</label
						>
						<input
							type="text"
							name="last-name"
							id="last-name"
							class="block w-full rounded-lg border border-gray-600 bg-white p-2.5 placeholder-gray-400 focus:border-[#967432] focus:ring-[#967432] sm:text-sm dark:bg-[#05121d] dark:text-white"
							placeholder="Apellido"
							required
						/>
					</div>
				</div>
				<div>
					<label
						for="email"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
						>Tu correo</label
					>
					<input
						type="email"
						name="email"
						id="email"
						class="block w-full rounded-lg border border-gray-600 bg-white p-2.5 placeholder-gray-400 focus:border-[#967432] focus:ring-[#967432] sm:text-sm dark:bg-[#05121d] dark:text-white"
						placeholder="correo@ejemplo.com"
						required
					/>
				</div>
				<div>
					<label
						for="password"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
						>Contraseña</label
					>
					<PasswordMeter
						id="password"
						name="password"
						placeholder="••••••••"
						required
						minlength={8}
						confirmInputId="confirm-password"
					/>
				</div>
				<div>
					<label
						for="confirm-password"
						class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
						>Confirmar contraseña</label
					>
					<input
						type="password"
						name="confirm-password"
						id="confirm-password"
						placeholder="••••••••"
						class="block w-full rounded-lg border border-gray-600 bg-white p-2.5 placeholder-gray-400 focus:border-[#967432] focus:ring-[#967432] sm:text-sm dark:bg-[#05121d] dark:text-white"
						required
					/>
				</div>
				<div class="flex items-start">
					<div class="flex h-5 items-center">
						<input
							id="remember"
							aria-describedby="remember"
							name="remember"
							type="checkbox"
							class="h-4 w-4 rounded border-gray-600 bg-white text-[#967432] ring-offset-gray-800 focus:ring-3 focus:ring-[#967432] dark:bg-[#05121d]"
							required
						/>
					</div>
					<div class="ml-3 text-sm">
						<label
							for="remember"
							class="font-medium text-gray-900 dark:text-white"
							>Al registrarte, estás creando una cuenta de Sotomayor consulting
							y aceptas los <a
								href="https://sotomayorconsulting.com/inicio/politicas/"
								class="text-[#8c681d] hover:underline"
								>Términos de uso y la Política de privacidad</a
							> de Sotomayor Consulting.
						</label>
					</div>
				</div>
				<button
					type="submit"
					class="hover:bg-primary-800 focus:ring-primary-300 dark:focus:ring-primary-800 w-full rounded-lg bg-[#8c681d] px-5 py-3 text-center text-base font-medium text-white focus:ring-4 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
					>Crear una cuenta</button
				>
			</form>
			<div>
				<div class="inline-flex w-full items-center justify-center">
					<hr
						class="dark:bg-black-800 my-2 h-px w-11/12 border-0 bg-gray-300"
					/>
					<span class="absolute px-5 font-medium text-gray-900 dark:text-white">
						o
					</span>
				</div>
			</div>
			<div>
				<form action="/api/auth/signin" method="post">
					<button
						class="flex w-full items-center justify-center gap-2 rounded-lg border border-gray-500 p-2.5 hover:bg-slate-700/10 dark:border-white dark:text-white dark:hover:bg-slate-300/10"
						value="google"
						name="provider"
						type="submit"
					>
						<svg
							class="w-6"
							viewBox="0 0 21 20"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<g clip-path="url(#clip0_13183_10121)"
								><path
									d="M20.3081 10.2303C20.3081 9.55056 20.253 8.86711 20.1354 8.19836H10.7031V12.0492H16.1046C15.8804 13.2911 15.1602 14.3898 14.1057 15.0879V17.5866H17.3282C19.2205 15.8449 20.3081 13.2728 20.3081 10.2303Z"
									fill="#3F83F8"></path><path
									d="M10.7019 20.0006C13.3989 20.0006 15.6734 19.1151 17.3306 17.5865L14.1081 15.0879C13.2115 15.6979 12.0541 16.0433 10.7056 16.0433C8.09669 16.0433 5.88468 14.2832 5.091 11.9169H1.76562V14.4927C3.46322 17.8695 6.92087 20.0006 10.7019 20.0006V20.0006Z"
									fill="#34A853"></path><path
									d="M5.08857 11.9169C4.66969 10.6749 4.66969 9.33008 5.08857 8.08811V5.51233H1.76688C0.348541 8.33798 0.348541 11.667 1.76688 14.4927L5.08857 11.9169V11.9169Z"
									fill="#FBBC04"></path><path
									d="M10.7019 3.95805C12.1276 3.936 13.5055 4.47247 14.538 5.45722L17.393 2.60218C15.5852 0.904587 13.1858 -0.0287217 10.7019 0.000673888C6.92087 0.000673888 3.46322 2.13185 1.76562 5.51234L5.08732 8.08813C5.87733 5.71811 8.09302 3.95805 10.7019 3.95805V3.95805Z"
									fill="#EA4335"></path></g
							><defs
								><clipPath id="clip0_13183_10121"
									><rect
										width="20"
										height="20"
										fill="white"
										transform="translate(0.5)"></rect></clipPath
								></defs
							>
						</svg>
						<label for="">Regístrate con google</label>
					</button>
				</form>
			</div>
			<div class="text-sm font-medium text-gray-500 dark:text-gray-400">
				¿Ya tienes una cuenta? <a
					href="/sign-in"
					class="text-[#8c681d] hover:underline">Inicia sesión</a
				>
			</div>
		</div>
	</div>
	<div
		class="pt:mt-0 mt-40 hidden h-full w-full flex-col items-center justify-center self-center px-6 lg:mt-0 lg:flex lg:items-start"
	>
		<div class="my-5 flex w-4/5 flex-col">
			<div
				class="mb-5 flex items-center justify-center text-center lg:justify-start lg:text-left"
			>
				<svg
					class="mr-4 hidden w-7 text-[#967432] lg:block"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
					><path
						fill-rule="evenodd"
						d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
						clip-rule="evenodd"></path></svg
				>
				<h3 class="text-2xl font-bold text-gray-900 dark:text-white">
					Creación de LLCs de forma rápida
				</h3>
			</div>

			<p
				class="text-center text-base text-gray-900 lg:text-left dark:text-white"
			>
				Crea tu empresa en minutos. Con nuestro proceso simplificado, solo
				necesitas unos pocos clics para registrar tu LLC y empezar a operar. Nos
				encargamos de todo el papeleo para que puedas enfocarte en tu negocio.
			</p>
		</div>
		<div class="my-5 flex w-4/5 flex-col">
			<div
				class="mb-5 flex items-center justify-center text-center lg:justify-start lg:text-left"
			>
				<svg
					class="mr-4 hidden w-7 text-[#967432] lg:block"
					fill="currentColor"
					viewBox="0 0 20 20"
					xmlns="http://www.w3.org/2000/svg"
					><path
						fill-rule="evenodd"
						d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
						clip-rule="evenodd"></path></svg
				>
				<h3 class="text-2xl font-bold text-gray-900 dark:text-white">
					Incorporación de empresas
				</h3>
			</div>

			<p
				class="text-center text-base text-gray-900 lg:text-left dark:text-white"
			>
				Crea tu estructura empresarial en minutos. Ya sea para tu negocio, para
				proteger tu patrimonio con una holding, operativas, trust o
				fideicomisos, nuestro proceso simplificado te permite establecer la
				estructura legal perfecta en unos pocos clics.
			</p>
		</div>
	</div>
</div>
