---
import '@estilos/datatables.css';
import { Icon } from 'astro-icon/components';

const { id } = Astro.params; // ID dinámico de la URL
const { redirect } = Astro;

const {
	data: { user },
	error: userErr,
} = await supabase.auth.getUser();
if (userErr || !user) {
	return redirect('/sign-in');
}

import { supabase } from '../lib/supabase';

const { data: empresa, error: empresaError } = await supabase
	.from('empresas_incorporaciones')
	.select('*')
	.eq('empresa_incorporacion_id', id)
	.eq('user_id', user.id)
	.single();

if (empresaError || !empresa) {
	return redirect('/pages/empresas');
}

// Obtener estado de incorporación para el mapa
let estadoMapa = null;
if (empresa.estado_de_incorporacion) {
	const { data: estadoData, error: estadoError } = await supabase
		.from('estados')
		.select('abreviatura, Estado')
		.eq('Estado', empresa.estado_de_incorporacion)
		.single();

	if (!estadoError && estadoData) {
		estadoMapa = estadoData.Estado;
	}
}

const acciones = [
	{
		title: 'Documentos completados',
		icono: 'ri:file-check-fill',
		link: '/pages/tus-formularios',
	},
	{
		title: 'Crea una nueva empresa',
		icono: 'ri:building-2-fill',
		link: '/start/',
	},
	{
		title: 'Obtener una cita con nosotros',
		icono: 'ri:calendar-fill',
		link: 'https://zcal.co/t/agendar-asesoria-llc/60min',
	},
	{
		title: 'Mira más de nuestros servicios',
		icono: 'ri:apps-ai-fill',
		link: '/pages/otros-servicios',
	},
	{
		title: 'Conviértete en Partner',
		icono: 'ri:shake-hands-fill',
		link: '',
	},
];
