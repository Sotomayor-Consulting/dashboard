<mjml>
	<mj-head>
		<mj-font
			name="Inter"
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
		></mj-font>
		<mj-attributes>
			<mj-text font-family="'Inter',Helvetica,Arial,sans-serif"></mj-text>
		</mj-attributes>
		<mj-style>
			p {
				margin: 0px 0px 0px 0px !important;
			}
			.fd-text a {
				color: unset;
				text-decoration: underline;
			}
			.fd-accountid p {
				background: #f1f2de;
				border-radius: 99px;
				padding: 10px 15px;
				text-align: center;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#ffffff">
		<mj-section padding="0px">
			<mj-column padding="0px">
				<mj-spacer height="14px"></mj-spacer>
			</mj-column>
		</mj-section>
		<!-- Hero -->
		<mj-section border-radius="8px" padding="0px" background-color="#000000">
			<mj-column width="100%" padding="20px">
				<mj-image
					padding="0px"
					align="center"
					width="200px"
					src="https://sotomayorconsulting.com/inicio/Logo_blanco-redesing.png"
				></mj-image>
				<!-- <mj-spacer height="26px"></mj-spacer> -->
				<!-- <mj-text font-size="20px" line-height="30px" font-weight="700" padding="0px" align="left" color="#eeeeee">
          <p>¡Recibe un cordial saludo de parte de Sotomayor Consulting!</p>
        </mj-text> -->
				<!-- <mj-spacer height="14px"></mj-spacer> -->
			</mj-column>
			<!-- <mj-column vertical-align="bottom" width="45%">
        <mj-image align="center" padding="0px" src="https://i.imgur.com/EZW1Ajm.png"></mj-image>
      </mj-column> -->
		</mj-section>
		<!-- Spacing -->
		<mj-section padding="0px">
			<mj-column padding="0px">
				<mj-spacer height="14px"></mj-spacer>
			</mj-column>
		</mj-section>
		<!-- Cart Head -->
		<mj-section
			padding="30px 40px 26px 40px"
			border-radius="8px 8px 0px 0px"
			background-color="#eeeeee"
		>
			<mj-column width="2%">
				<mj-spacer height="14px"></mj-spacer>
			</mj-column>
		</mj-section>
		<!-- Cart -->
		<!-- Cart > Product 1 -->
		<mj-section padding="0px 40px 26px 40px" background-color="#eeeeee">
			<mj-column width="100%" vertical-align="middle">
				<mj-text
					font-size="20px"
					line-height="30px"
					font-weight="700"
					padding="0px"
					align="left"
					color="black"
				>
					<p>{{title}}</p>
				</mj-text>
			</mj-column>
		</mj-section>
		<!-- Cart > Product 2 -->
		<mj-section padding="0px 40px 26px 40px" background-color="#eeeeee">
			<mj-column width="100%" vertical-align="middle">
				<mj-text
					font-size="15px"
					line-height="20px"
					padding="0px"
					align="left"
					color="black"
					>{{intro}}</mj-text
				>
			</mj-column>
		</mj-section>
		<mj-section padding="0px 40px 26px 40px" background-color="#eeeeee">
			<mj-column width="100%" vertical-align="middle">
				<mj-text
					font-size="15px"
					line-height="20px"
					padding="0px"
					align="left"
					color="black"
				>
					<b>{{highlight_label}}</b> {{highlight_value}}</mj-text
				>
				<mj-text
					font-size="15px"
					line-height="20px"
					padding="0px"
					align="left"
					color="black"
				>
					{{details}}</mj-text
				>
			</mj-column>
		</mj-section>
		<mj-section padding="0px 40px 26px 40px" background-color="#eeeeee">
			<mj-column width="100%" vertical-align="middle">
				<mj-text
					font-size="15px"
					line-height="20px"
					padding="0px"
					align="left"
					color="black"
					>{{cta_note}}</mj-text
				>
			</mj-column>
			<mj-column width="100%">
				<mj-spacer height="20px" />
			</mj-column>
			<mj-column width="100%">
				<mj-button
					href="{{cta_url}}"
					background-color="#b98d33"
					color="white"
					border-radius="10px"
					font-size="15px"
				>
					{{cta_label}}
				</mj-button>
			</mj-column>
		</mj-section>
		<mj-section
			border-radius="0px 0px 8px 8px"
			padding="0px 10px 26px 10px"
			background-color="#dddddd"
		>
			<mj-column padding="0px">
				<mj-spacer height="20px"></mj-spacer>
			</mj-column>
			<mj-column width="100%">
				<mj-text
					color="#2c2c2c"
					line-height="16px"
					font-size="10px"
					padding="0px"
					align="center"
					>Este mensaje esta generado por nuestros sistemas. Ante cualquier
					aviso o consulta responder a este correo.</mj-text
				>
			</mj-column>
		</mj-section>
		<!-- Spacing -->
		<mj-section padding="0px">
			<mj-column padding="0px">
				<mj-spacer height="14px"></mj-spacer>
			</mj-column>
		</mj-section>
		<!-- Footer -->
		<mj-section background-color="transparent" padding="30px 0px">
			<mj-column width="100%">
				<mj-spacer height="16px"></mj-spacer>
				<mj-text
					css-class="fd-text"
					padding="0px"
					line-height="20px"
					align="center"
					color="#b98d33"
					font-size="12px"
					css-class="fd-text"
				>
					Creado por
					<a href="https://sotomayorconsulting.com/inicio/"
						>Sotomoayor Consulting</a
					>.
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
