---
// ─── Set Password (post-invitación) ─────────────────────
// Página a la que llega el usuario tras hacer clic en el enlace de
// invitación. El callback (/api/auth/invite-callback) ya creó la sesión
// via exchangeCodeForSession/verifyOtp. Si no hay sesión (enlace expirado
// o ya usado — son de un solo uso), el island muestra el estado de error.
import LayoutStacked from '@layouts/LayoutSignIn.astro';
import FormSetPassword from '@modules/auth/islands/FormSetPassword.tsx';

const user = Astro.locals.user;
const email = user?.email ?? '';
const status = Astro.url.searchParams.get('status');
const message = Astro.url.searchParams.get('msg');
---

<LayoutStacked>
	<FormSetPassword
		email={email}
		status={status}
		message={message}
		hasSession={Boolean(user)}
		client:load
	/>
</LayoutStacked>
