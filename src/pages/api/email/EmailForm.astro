---

<div class="mx-auto max-w-md rounded-lg bg-white p-6 shadow-md">
	<form
		id="emailForm"
		class="flex flex-col space-y-4"
		method="POST"
		action="/api/email/sendEmail"
	>
		<input
			type="email"
			name="to"
			required
			placeholder="Destinatario"
			class="w-full rounded-md border border-gray-300 px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-blue-500 focus:outline-none"
		/>
		<input
			type="text"
			name="subject"
			required
			placeholder="Asunto"
			class="w-full rounded-md border border-gray-300 px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-blue-500 focus:outline-none"
		/>
		<textarea
			name="html"
			required
			placeholder="Mensaje"
			class="h-32 w-full resize-none rounded-md border border-gray-300 px-4 py-2 focus:border-transparent focus:ring-2 focus:ring-blue-500 focus:outline-none"
		></textarea>
		<button
			type="submit"
			class="w-full rounded-md bg-blue-600 px-4 py-2 font-semibold text-white transition duration-300 hover:bg-blue-700"
			>Enviar</button
		>
	</form>
</div>

