---
import LayoutStacked from '@app/layouts/LayoutStackedDos.astro';
import FormSignIn from '@modules/auth/islands/FormSignIn.tsx';
import Alerta from '@components/feedback/alertageneral.astro';
---

<LayoutStacked>
	<div class="flex items-center justify-center py-10">
		<Alerta />
		<FormSignIn client:load />
	</div>
</LayoutStacked>

<script
	src="https://accounts.google.com/gsi/client"
	is:inline
	onload="window.dispatchEvent(new Event('google-one-tap-loaded'))"
></script>
