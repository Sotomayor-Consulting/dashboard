---
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import VistaEmpresa from '@modules/companies/VistaEmpresas.astro';
import Alerta from '@components/feedback/alertageneral.astro';

const { id } = Astro.params;

if (!id) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}
---

<LayoutSidebar>
	<Alerta />
	<VistaEmpresa empresaId={id} />
</LayoutSidebar>
