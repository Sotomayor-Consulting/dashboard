---
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import VistaEmpresa from '@modules/companies/VistaEmpresas.astro';
import Alerta from '@components/feedback/alertageneral.astro';

// Auth + admin role handled by middleware (/crud/ routes require admin)
const { id } = Astro.params;

if (!id) {
	const mensaje = 'No se encontró esta empresa';
	const mensajeCodificado = encodeURIComponent(mensaje);

	return Astro.redirect(`/?status=error&msg=${mensajeCodificado}`);
}
---

<LayoutSidebar>
	<Alerta />
	<VistaEmpresa empresaId={id} />
</LayoutSidebar>
