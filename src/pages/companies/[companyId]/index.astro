---
import LayoutSidebar from '@layouts/LayoutSidebar.astro';
import CompanyPage from '@modules/companies/CompanyPage.astro';
import CompanyPageSkeleton from '@modules/companies/components/CompanyPageSkeleton.astro';
import Alerta from '@components/feedback/Alert.astro';

const { companyId } = Astro.params;
---

<LayoutSidebar>
	<Alerta />
	<div id="page-skeleton">
		<CompanyPageSkeleton />
	</div>
	<div id="page-content" class="hidden">
		<CompanyPage companyId={companyId ?? ''} />
	</div>
</LayoutSidebar>

<script>
	function revealContent() {
		const skeleton = document.getElementById('page-skeleton');
		const content = document.getElementById('page-content');
		if (skeleton && content) {
			skeleton.remove();
			content.classList.remove('hidden');
			content.style.animation = 'company-page-reveal 0.3s ease-out';
		}
	}

	if (document.readyState === 'complete') {
		revealContent();
	} else {
		window.addEventListener('load', revealContent, { once: true });
	}

	document.addEventListener('astro:page-load', revealContent);
</script>

<style is:global>
	@keyframes company-page-reveal {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
