---
import LayoutCommon from '@app/layouts/LayoutCommon.astro';
import { Icon } from 'astro-icon/components';
import Stripe from 'stripe';

const STRIPE_SECRET_KEY =
	process.env.STRIPE_SECRET_KEY ?? import.meta.env.STRIPE_SECRET_KEY;
const stripe = STRIPE_SECRET_KEY ? new Stripe(STRIPE_SECRET_KEY) : null;

const sessionId = Astro.url.searchParams.get('session_id');
let paid = false;
let amount = 0;
let currency = 'usd';
let customerEmail: string | null = null;
let paymentDate: Date | null = null;
let referenceId: string | null = null;

if (stripe && sessionId) {
	try {
		const session = await stripe.checkout.sessions.retrieve(sessionId);
		paid = session.payment_status === 'paid';
		amount = (session.amount_total ?? 0) / 100;
		currency = (session.currency ?? 'usd').toUpperCase();
		customerEmail =
			session.customer_details?.email ?? session.customer_email ?? null;
		paymentDate = session.created ? new Date(session.created * 1000) : null;
		referenceId = session.payment_intent
			? typeof session.payment_intent === 'string'
				? session.payment_intent
				: session.payment_intent.id
			: session.id;
	} catch (err) {
		console.error('[success] retrieve error:', err);
	}
}

const formattedAmount = new Intl.NumberFormat('es-ES', {
	style: 'currency',
	currency: currency || 'USD',
	minimumFractionDigits: 2,
}).format(amount);

const formattedDate = paymentDate
	? new Intl.DateTimeFormat('es-ES', {
			day: '2-digit',
			month: 'long',
			year: 'numeric',
			hour: '2-digit',
			minute: '2-digit',
		}).format(paymentDate)
	: null;

const shortRef = referenceId ? referenceId.slice(-12).toUpperCase() : null;
---

<LayoutCommon title={paid ? 'Pago confirmado' : 'Procesando pago'}>
	<main
		class="dark:bg-black-900 relative flex min-h-screen items-center justify-center overflow-hidden bg-gray-50 px-4 py-12 sm:px-6"
	>
		<!-- Background decorative gradients -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 overflow-hidden"
		>
			<div
				class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-[#8c681d]/10 blur-3xl dark:bg-[#134aed]/10"
			>
			</div>
			<div
				class="absolute -right-40 -bottom-40 h-96 w-96 rounded-full bg-emerald-400/10 blur-3xl dark:bg-emerald-500/5"
			>
			</div>
		</div>

		<div class="relative z-10 w-full max-w-xl">
			<!-- Card -->
			<div
				class="dark:bg-linear-to-tr to-black-600 from-black-900  dark:bg-black-800/80 relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl shadow-gray-200/40 backdrop-blur dark:border-neutral-800 dark:shadow-black/30"
			>
				<!-- Top accent bar -->
				<div
					class:list={[
						'h-1 w-full',
						paid
							? 'bg-linear-to-r from-emerald-400 via-emerald-500 to-emerald-400'
							: 'bg-linear-to-r from-amber-400 via-amber-500 to-amber-400',
					]}
				>
				</div>

				<div class="px-6 py-10 sm:px-10">
					{
						paid ? (
							<>
								<!-- Animated success icon -->
								<div class="relative mx-auto mb-6 flex h-24 w-24 items-center justify-center">
									<span class="success-ripple absolute inset-0 rounded-full bg-emerald-500/20" />
									<span class="success-ripple-delay absolute inset-2 rounded-full bg-emerald-500/30" />
									<div class="success-pop relative flex h-20 w-20 items-center justify-center rounded-full bg-linear-to-r from-emerald-400 to-emerald-600 shadow-lg shadow-emerald-500/40">
										<Icon
											name="ri:check-line"
											class="success-check h-12 w-12 text-white"
										/>
									</div>
								</div>

								<div class="text-center">
									<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700 ring-1 ring-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:ring-emerald-500/20">
										<span class="h-1.5 w-1.5 rounded-full bg-emerald-500" />
										Pago confirmado
									</span>
									<h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
										¡Sotomayor Consulting International agradece por su pago!
									</h1>
									<p class="mx-auto mt-3 max-w-md text-sm text-gray-500 sm:text-base dark:text-neutral-400">
										Hemos recibido tu pago correctamente. Estamos iniciando el
										proceso y recibirás un correo con los próximos pasos.
									</p>
								</div>

								<!-- Receipt summary -->
								<div class="dark:bg-black-900/60 mt-8 rounded-xl border border-gray-200 bg-gray-50/80 p-6 dark:border-neutral-800">
									<div class="flex items-baseline justify-between">
										<span class="text-sm font-medium text-gray-500 dark:text-neutral-400">
											Total pagado
										</span>
										<span class="text-2xl font-bold text-gray-900 dark:text-white">
											{formattedAmount}
										</span>
									</div>

									<div class="my-4 border-t border-dashed border-gray-200 dark:border-neutral-700" />

									<dl class="space-y-3 text-sm">
										{customerEmail && (
											<div class="flex items-center justify-between gap-4">
												<dt class="flex items-center gap-2 text-gray-500 dark:text-neutral-400">
													<Icon name="ri:mail-line" class="h-4 w-4" />
													Correo
												</dt>
												<dd class="truncate font-medium text-gray-900 dark:text-white">
													{customerEmail}
												</dd>
											</div>
										)}
										{formattedDate && (
											<div class="flex items-center justify-between gap-4">
												<dt class="flex items-center gap-2 text-gray-500 dark:text-neutral-400">
													<Icon name="ri:calendar-line" class="h-4 w-4" />
													Fecha
												</dt>
												<dd class="font-medium text-gray-900 dark:text-white">
													{formattedDate}
												</dd>
											</div>
										)}
										{shortRef && (
											<div class="flex items-center justify-between gap-4">
												<dt class="flex items-center gap-2 text-gray-500 dark:text-neutral-400">
													<Icon name="ri:hashtag" class="h-4 w-4" />
													Referencia
												</dt>
												<dd class="font-mono text-xs font-medium tracking-wider text-gray-900 dark:text-white">
													{shortRef}
												</dd>
											</div>
										)}
										<div class="flex items-center justify-between gap-4">
											<dt class="flex items-center gap-2 text-gray-500 dark:text-neutral-400">
												<Icon name="ri:bank-card-line" class="h-4 w-4" />
												Método
											</dt>
											<dd class="flex items-center gap-1.5 font-medium text-gray-900 dark:text-white">
												<Icon
													name="ri:secure-payment-line"
													class="h-5 w-5 text-neutral-400"
												/>
												Procesado por Stripe
											</dd>
										</div>
									</dl>
								</div>

								<!-- Next steps -->
								<div class="mt-8">
									<h2 class="text-sm font-semibold text-gray-900 dark:text-white">
										Próximos pasos
									</h2>
									<ul class="mt-3 space-y-2.5 text-sm">
										<li class="flex items-start gap-2.5 text-gray-600 dark:text-neutral-400">
											<Icon
												name="ri:check-double-line"
												class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500"
											/>
											<span>
												Hemos enviado un comprobante a tu correo electrónico.
											</span>
										</li>
										<li class="flex items-start gap-2.5 text-gray-600 dark:text-neutral-400">
											<Icon
												name="ri:time-line"
												class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500"
											/>
											<span>
												Iniciaremos el proceso de incorporación en las próximas
												horas.
											</span>
										</li>
										<li class="flex items-start gap-2.5 text-gray-600 dark:text-neutral-400">
											<Icon
												name="ri:notification-3-line"
												class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500"
											/>
											<span>
												Te notificaremos sobre cada avance directamente en tu
												panel.
											</span>
										</li>
									</ul>
								</div>

								<!-- Actions -->
								<div class="mt-8 flex flex-col gap-3 sm:flex-row">
									<a
										href="/"
										class="dark:focus:ring-primary-800 inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-emerald-600 px-5 py-3 text-center text-sm font-medium text-white transition hover:bg-emerald-700 focus:ring-4 focus:ring-amber-200 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
									>
										<Icon name="ri:function-ai-line" class="h-4 w-4" />
										Ir al panel
									</a>
									<a
										href="/my-companies"
										class="dark:bg-black-900/40 inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-5 py-3 text-center text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800/60"
									>
										<Icon name="ri:building-line" class="h-4 w-4" />
										Ver mis empresas
									</a>
								</div>
							</>
						) : (
							<>
								<!-- Processing state -->
								<div class="relative mx-auto mb-6 flex h-24 w-24 items-center justify-center">
									<span class="success-ripple absolute inset-0 rounded-full bg-amber-500/20" />
									<div class="relative flex h-20 w-20 items-center justify-center rounded-full bg-linear-to-r from-amber-400 to-amber-600 shadow-lg shadow-amber-500/40">
										<Icon
											name="ri:loader-4-line"
											class="h-12 w-12 animate-spin text-white"
										/>
									</div>
								</div>

								<div class="text-center">
									<span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700 ring-1 ring-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:ring-amber-500/20">
										<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-500" />
										Procesando
									</span>
									<h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white">
										Estamos procesando tu pago
									</h1>
									<p class="mx-auto mt-3 max-w-md text-sm text-gray-500 sm:text-base dark:text-neutral-400">
										Si el cobro fue aprobado, verás la confirmación en unos
										segundos. Puedes refrescar esta página o volver al inicio.
									</p>
								</div>

								<div class="mt-8 flex flex-col gap-3 sm:flex-row">
									<button
										type="button"
										onclick="window.location.reload()"
										class="inline-flex flex-1 items-center justify-center gap-2 rounded-lg bg-[#8c681d] px-5 py-3 text-center text-sm font-medium text-white transition hover:bg-[#7a5b19] focus:ring-4 focus:ring-amber-200 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
									>
										<Icon name="ri:refresh-line" class="h-4 w-4" />
										Verificar nuevamente
									</button>
									<a
										href="/"
										class="dark:bg-black-900/40 inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-5 py-3 text-center text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800/60"
									>
										<Icon name="ri:home-line" class="h-4 w-4" />
										Volver al inicio
									</a>
								</div>
							</>
						)
					}
				</div>
			</div>

			<!-- Footer trust signals -->
			<div
				class="mt-6 flex flex-col items-center justify-center gap-2 text-xs text-gray-500 sm:flex-row sm:gap-4 dark:text-neutral-500"
			>
				<span class="flex items-center gap-1.5">
					<Icon name="ri:shield-keyhole-line" class="h-4 w-4" />
					Pago seguro
				</span>
				<span class="hidden h-1 w-1 rounded-full bg-gray-300 sm:block dark:bg-neutral-700"
				></span>
				<span class="flex items-center gap-1.5">
					<Icon name="ri:lock-line" class="h-4 w-4" />
					Cifrado SSL
				</span>
				<span class="hidden h-1 w-1 rounded-full bg-gray-300 sm:block dark:bg-neutral-700"
				></span>
				<span class="flex items-center gap-1.5">
					<Icon name="ri:customer-service-2-line" class="h-4 w-4" />
					¿Necesitas ayuda?
					<a
						href="mailto:soporte@sotomayorconsulting.com"
						class="font-bold hover:underline"
					>
						Contáctanos
					</a>
				</span>
			</div>
		</div>
	</main>
</LayoutCommon>

<style>
	@keyframes success-pop {
		0% {
			transform: scale(0.5);
			opacity: 0;
		}
		60% {
			transform: scale(1.08);
			opacity: 1;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes success-check {
		0% {
			transform: scale(0) rotate(-45deg);
			opacity: 0;
		}
		60% {
			transform: scale(1.2) rotate(0);
			opacity: 1;
		}
		100% {
			transform: scale(1) rotate(0);
			opacity: 1;
		}
	}

	@keyframes success-ripple {
		0% {
			transform: scale(0.8);
			opacity: 0.7;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	.success-pop {
		animation: success-pop 500ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	.success-check {
		animation: success-check 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 200ms both;
	}

	.success-ripple {
		animation: success-ripple 1.8s ease-out infinite;
	}

	.success-ripple-delay {
		animation: success-ripple 1.8s ease-out 600ms infinite;
	}
</style>
