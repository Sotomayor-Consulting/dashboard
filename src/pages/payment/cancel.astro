---
import LayoutCommon from '@app/layouts/LayoutCommon.astro';
---

<LayoutCommon title="Pago cancelado">
	<main class="flex min-h-screen items-center justify-center p-6">
		<div
			class="dark:bg-black-900 w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 text-center shadow-sm dark:border-neutral-800"
		>
			<h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
				Pago cancelado
			</h1>
			<p class="mt-2 text-gray-600 dark:text-neutral-400">
				No se realizó ningún cargo. Puedes intentarlo nuevamente cuando quieras.
			</p>
			<a
				href="/incorporacion-y-pago"
				class="bg-black-600 hover:bg-black-600/80 mt-6 inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium text-white"
			>
				Volver a intentar
			</a>
		</div>
	</main>
</LayoutCommon>
