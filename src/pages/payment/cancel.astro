---
import LayoutCommon from '@app/layouts/LayoutCommon.astro';
import { Icon } from 'astro-icon/components';
---

<LayoutCommon title="Pago cancelado">
	<main
		class="dark:bg-black-900 relative flex min-h-screen items-center justify-center overflow-hidden bg-gray-50 px-4 py-12 sm:px-6"
	>
		<!-- Background decorative gradients -->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 overflow-hidden"
		>
			<div
				class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-rose-400/10 blur-3xl dark:bg-rose-500/10"
			>
			</div>
			<div
				class="absolute -right-40 -bottom-40 h-96 w-96 rounded-full bg-[#8c681d]/10 blur-3xl dark:bg-[#134aed]/10"
			>
			</div>
		</div>

		<div class="relative z-10 w-full max-w-xl">
			<!-- Card -->
			<div
				class="to-black-600 from-black-900 dark:bg-black-800/80 relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xl shadow-gray-200/40 backdrop-blur dark:border-neutral-800 dark:bg-linear-to-tr dark:shadow-black/30"
			>
				<!-- Top accent bar -->
				<div
					class="h-1 w-full bg-linear-to-r from-rose-400 via-rose-500 to-rose-400"
				>
				</div>

				<div class="px-6 py-10 sm:px-10">
					<!-- Animated cancel icon -->
					<div
						class="relative mx-auto mb-6 flex h-24 w-24 items-center justify-center"
					>
						<span
							class="cancel-ripple absolute inset-0 rounded-full bg-rose-500/20"
						></span>
						<span
							class="cancel-ripple-delay absolute inset-2 rounded-full bg-rose-500/30"
						></span>
						<div
							class="cancel-pop relative flex h-20 w-20 items-center justify-center rounded-full bg-linear-to-r from-rose-400 to-rose-600 shadow-lg shadow-rose-500/40 dark:bg-red-600"
						>
							<Icon
								name="ri:close-line"
								class="cancel-mark h-12 w-12 text-white"
							/>
						</div>
					</div>

					<div class="text-center">
						<span
							class="inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-3 py-1 text-xs font-medium text-rose-700 ring-1 ring-rose-200 dark:bg-rose-500/10 dark:text-rose-400 dark:ring-rose-500/20"
						>
							<span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
							Pago no completado
						</span>
						<h1
							class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-white"
						>
							Pago cancelado
						</h1>
						<p
							class="mx-auto mt-3 max-w-md text-sm text-gray-500 sm:text-base dark:text-neutral-400"
						>
							No se realizó ningún cargo en tu tarjeta. Puedes intentarlo
							nuevamente cuando quieras o contactarnos si necesitas ayuda.
						</p>
					</div>

					<!-- Reassurance card -->
					<div
						class="dark:bg-black-900/60 mt-8 rounded-xl border border-gray-200 bg-gray-50/80 p-6 dark:border-neutral-800"
					>
						<div class="flex items-start gap-3">
							<div
								class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-rose-100 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400"
							>
								<Icon name="ri:shield-check-line" class="h-5 w-5" />
							</div>
							<div>
								<p class="text-sm font-semibold text-gray-900 dark:text-white">
									Tu información está segura
								</p>
								<p class="mt-1 text-sm text-gray-600 dark:text-neutral-400">
									No se procesó ningún pago y no guardamos datos de tu tarjeta.
									El proceso es 100% gestionado por Stripe.
								</p>
							</div>
						</div>
					</div>

					<!-- Possible reasons -->
					<div class="mt-8">
						<h2 class="text-sm font-semibold text-gray-900 dark:text-white">
							¿Qué pudo haber pasado?
						</h2>
						<ul class="mt-3 space-y-2.5 text-sm">
							<li
								class="flex items-start gap-2.5 text-gray-600 dark:text-neutral-400"
							>
								<Icon
									name="ri:arrow-go-back-line"
									class="mt-0.5 h-4 w-4 shrink-0 text-rose-500"
								/>
								<span> Cancelaste el proceso de pago antes de finalizar. </span>
							</li>
							<li
								class="flex items-start gap-2.5 text-gray-600 dark:text-neutral-400"
							>
								<Icon
									name="ri:bank-card-2-line"
									class="mt-0.5 h-4 w-4 shrink-0 text-rose-500"
								/>
								<span>
									La tarjeta fue rechazada o no tenía fondos suficientes.
								</span>
							</li>
							<li
								class="flex items-start gap-2.5 text-gray-600 dark:text-neutral-400"
							>
								<Icon
									name="ri:wifi-off-line"
									class="mt-0.5 h-4 w-4 shrink-0 text-rose-500"
								/>
								<span> Hubo un problema de conexión durante el pago. </span>
							</li>
						</ul>
					</div>

					<!-- Actions -->
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a
							href="/incorporacion-y-pago"
							class="dark:focus:ring-primary-800 bg-black-400 hover:bg-black-500 inline-flex flex-1 items-center justify-center gap-2 rounded-lg px-5 py-3 text-center text-sm font-medium text-white transition focus:ring-4 focus:ring-amber-200 dark:bg-[#134aed] dark:hover:bg-[#134aed]/80"
						>
							<Icon name="ri:refresh-line" class="h-4 w-4" />
							Intentar nuevamente
						</a>
						<a
							href="/"
							class="dark:bg-black-900/40 inline-flex flex-1 items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-5 py-3 text-center text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-neutral-700 dark:text-neutral-300 dark:hover:bg-neutral-800/60"
						>
							<Icon name="ri:home-line" class="h-4 w-4" />
							Volver al inicio
						</a>
					</div>
				</div>
			</div>

			<!-- Footer trust signals -->
			<div
				class="mt-6 flex flex-col items-center justify-center gap-2 text-xs text-gray-500 sm:flex-row sm:gap-4 dark:text-neutral-500"
			>
				<span class="flex items-center gap-1.5">
					<Icon name="ri:shield-keyhole-line" class="h-4 w-4" />
					Pago seguro
				</span>
				<span
					class="hidden h-1 w-1 rounded-full bg-gray-300 sm:block dark:bg-neutral-700"
				></span>
				<span class="flex items-center gap-1.5">
					<Icon name="ri:lock-line" class="h-4 w-4" />
					Cifrado SSL
				</span>
				<span
					class="hidden h-1 w-1 rounded-full bg-gray-300 sm:block dark:bg-neutral-700"
				></span>
				<span class="flex items-center gap-1.5">
					<Icon name="ri:customer-service-2-line" class="h-4 w-4" />
					¿Necesitas ayuda?
					<a
						href="mailto:soporte@sotomayorconsulting.com"
						class="font-bold hover:underline"
					>
						Contáctanos
					</a>
				</span>
			</div>
		</div>
	</main>
</LayoutCommon>

<style>
	@keyframes cancel-pop {
		0% {
			transform: scale(0.5);
			opacity: 0;
		}
		60% {
			transform: scale(1.08);
			opacity: 1;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@keyframes cancel-mark {
		0% {
			transform: scale(0) rotate(45deg);
			opacity: 0;
		}
		60% {
			transform: scale(1.2) rotate(0);
			opacity: 1;
		}
		100% {
			transform: scale(1) rotate(0);
			opacity: 1;
		}
	}

	@keyframes cancel-ripple {
		0% {
			transform: scale(0.8);
			opacity: 0.7;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	.cancel-pop {
		animation: cancel-pop 500ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	.cancel-mark {
		animation: cancel-mark 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 200ms both;
	}

	.cancel-ripple {
		animation: cancel-ripple 1.8s ease-out infinite;
	}

	.cancel-ripple-delay {
		animation: cancel-ripple 1.8s ease-out 600ms infinite;
	}
</style>
