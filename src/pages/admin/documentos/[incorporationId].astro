---
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import Alerta from '@components/feedback/alertageneral.astro';
import CompanyDocumentsDashboard from '@modules/documents/CompanyDocumentsDashboard.astro';

const { incorporationId } = Astro.params;
if (!incorporationId) {
	return Astro.redirect('/admin/?status=error&msg=Caso%20invalido');
}
---

<LayoutSidebar>
	<Alerta />
	<CompanyDocumentsDashboard incorporationCaseId={incorporationId} />
</LayoutSidebar>
