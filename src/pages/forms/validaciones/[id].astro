---
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import { getFormularioEnviadoDetalle } from '@lib/tables/forms/formulariosEnviados';
const supabase = Astro.locals.supabase;

const { id } = Astro.params;
const user = Astro.locals.user;
const userId = user?.id;
const userRoles = Astro.locals.userRoles || [];

const isAdmin = userRoles.includes('admin');

const { data: envio, error: envioErr } = await getFormularioEnviadoDetalle(
	supabase,
	id!,
);

if (envioErr || !envio) return Astro.redirect('/');

// 4) Gate: dueño o admin
const canEdit = isAdmin;
if (!isAdmin && envio.user_id !== userId) return Astro.redirect('/');

const themeJson = envio.formularios?.tema_json;
const autorNombre = envio.usuarios?.nombre;
const apellido = envio.usuarios?.apellido;

const schemaSnapshot = envio.schema_snapshot ?? {};
const answers = envio.data_json ?? {};
const empresa_id = envio.empresa_incorporacion_id;

import '@styles/surveyjs.css';
---

<LayoutSidebar>
	<section class="mx-auto space-y-2 p-4">
		<h1 class="text-white-900 dark:text-black-50 text-2xl font-bold">
			{
				autorNombre || apellido
					? `Respuestas de ${autorNombre ?? ''} ${apellido ?? ''}`.trim()
					: 'Respuestas'
			}
		</h1>
	</section>

	<div id="surveyContainer" class="h-screen"></div>

	<script type="text/javascript" src="/surveyjs/survey_core_min.js"></script>
	<script type="text/javascript" src="/surveyjs/survey_js_ui_min.js"></script>

	<script
		type="module"
		define:vars={{
			schemaSnapshot,
			answers,
			themeJson,
			id,
			empresa_id,
			canEdit,
		}}
	>
		const survey = new Survey.Model(schemaSnapshot);

		survey.data = answers ?? {};
		survey.showCompletedPage = false;

		// Para Ops: no borres valores invisibles; backend decide qué aplica
		survey.clearInvisibleValues = 'none';

		if (typeof themeJson !== 'undefined' && themeJson) {
			survey.applyTheme(themeJson);
		}

		if (!canEdit) {
			survey.mode = 'display';
		} else {
			survey.mode = 'edit';
			survey.completeText = 'Validar';
		}

		// Helpers
		const tryParseJson = async (res) => {
			try {
				return await res.json();
			} catch {
				return null;
			}
		};

		const getDebugText = async (res) => {
			try {
				return await res.text();
			} catch {
				return '';
			}
		};

		// Si es editable envia a endopint
		if (canEdit) {
			survey.onComplete.add(async (sender) => {
				const payload = {
					submission_id: id,
					empresa_id: empresa_id,
					approved_data: sender.data,
				};

				try {
					const res = await fetch(
						'/api/operaciones/validacion_de_incorporacion',
						{
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								Accept: 'application/json',
							},
							credentials: 'include',
							redirect: 'manual',
							body: JSON.stringify(payload),
						},
					);

					// Detectar redirects (mala señal si esperas JSON)
					if (
						res.type === 'opaqueredirect' ||
						res.status === 0 ||
						(res.status >= 300 && res.status < 400)
					) {
						console.error(
							'[VALIDACION] El backend respondió con redirect (no JSON).',
							{
								status: res.status,
								type: res.type,
								location: res.headers?.get?.('location') ?? null,
							},
						);
						alert(
							'El servidor respondió con redirect. El endpoint debe devolver JSON (ok/false).',
						);
						return;
					}

					const out = await tryParseJson(res);

					// Si no vino JSON, mostramos texto para debugging
					if (!out) {
						const txt = await getDebugText(res);
						console.error('[VALIDACION] Respuesta no-JSON del backend', {
							status: res.status,
							text: txt?.slice?.(0, 2000) ?? txt,
						});
						alert(
							'El servidor no devolvió JSON. Revise consola para ver la respuesta.',
						);
						return;
					}

					// Manejo de error estándar { ok:false, error:{...} }
					if (!res.ok || out.ok === false) {
						console.error('[VALIDACION] Error backend:', out);

						const msg =
							out?.error?.message ||
							out?.message ||
							'No se pudo validar. Revise los errores en consola.';

						alert(msg);
						return;
					}

					// OK
					console.log('[VALIDACION] OK:', out);
					alert('Validación enviada correctamente.');

					// Opcional: recargar o navegar
					// window.location.reload();
					// window.location.href = `/admin/verificacion/?status=success&empresa_id=${encodeURIComponent(empresa_id)}`;
				} catch (e) {
					console.error('[VALIDACION] Error enviando validación:', e);
					alert('Error enviando validación. Revise consola.');
				}
			});
		}

		survey.render(document.getElementById('surveyContainer'));
	</script>
</LayoutSidebar>
