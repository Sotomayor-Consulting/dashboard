---
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import { getFormularioEnviadoDetalleItem } from '@lib/tablas/forms/formulariosEnviados';
const user = Astro.locals.user!;
const userRoles = Astro.locals.userRoles || [];
const { id } = Astro.params;
const supabase = Astro.locals.supabase;
const isAdmin = userRoles.includes('admin');

// Traer envío
const { data: envio, error: envioError } =
	await getFormularioEnviadoDetalleItem(supabase, id ?? '');
if (envioError || !envio) {
	console.error('Error fetching envio:', envioError);
	return Astro.redirect('/');
}

// 4) Gate: dueño o admin
if (!isAdmin && envio.user_id !== user.id) return Astro.redirect('/');

const themeJson = envio.formularios?.tema_json;

const schemaSnapshot = envio.schema_snapshot ?? {};
const answers = envio.data_json ?? {};

import '@styles/surveyjs.css';
---

<LayoutSidebar>
	<main>
		<section class="w-full">
			<div id="surveyContainer" class="h-dvh w-full rounded-2xl"></div>
		</section>

		<script type="text/javascript" src="/surveyjs/survey_core_min.js"></script>
		<script type="text/javascript" src="/surveyjs/survey_js_ui_min.js"></script>
	</main>
	<script type="module" define:vars={{ schemaSnapshot, answers, themeJson }}>
		const survey = new Survey.Model(schemaSnapshot);
		survey.data = answers;
		survey.mode = 'display';
		survey.showCompletedPage = false;
		if (typeof themeJson !== 'undefined' && themeJson) {
			survey.applyTheme(themeJson);
		}
		survey.render(document.getElementById('surveyContainer'));
	</script>
</LayoutSidebar>
