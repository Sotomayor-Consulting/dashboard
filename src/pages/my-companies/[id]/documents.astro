---
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import Alerta from '@components/feedback/alertageneral.astro';
import CompanyDocumentsDashboard from '@modules/documents/CompanyDocumentsDashboard.astro';

const { id } = Astro.params;

if (!id) {
	return Astro.redirect('/my-companies/');
}
---

<LayoutSidebar>
	<Alerta />
	<div class="px-4 pt-4">
		<nav
			class="mb-4 inline-flex rounded-lg border border-gray-200 bg-white p-1 text-sm dark:border-gray-700 dark:bg-[#28314c]"
			aria-label="Submenú de empresa"
		>
			<a
				href={`/my-companies/${id}`}
				class="rounded-md px-3 py-2 font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-white/10"
			>
				Resumen
			</a>
			<a
				href={`/my-companies/${id}/documents`}
				class="rounded-md bg-blue-600 px-3 py-2 font-semibold text-white"
				aria-current="page"
			>
				Documentos
			</a>
		</nav>
	</div>

	<CompanyDocumentsDashboard incorporationCaseId={id} />
</LayoutSidebar>

