---
import LayoutSidebar from '@layouts/LayoutSidebar.astro';
import CompanyDocs from '@modules/companies/CompanyDocuments.astro';
import Alerta from '@components/feedback/alertageneral.astro';

const { id } = Astro.params;

if (!id) {
	return Astro.redirect('/?status=error&msg=No se encontró esta empresa');
}
---

<LayoutSidebar>
	<Alerta />
	<CompanyDocs empresaId={id} transition:persist />
</LayoutSidebar>
