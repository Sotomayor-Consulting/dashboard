---
import Tab from '@components/ui/tabs.astro';
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import Orders from '@modules/documents/Orders.astro';

const { incorporationId } = Astro.params;
---

<LayoutSidebar>
	<Tab
		buttons={[
			{
				label: 'General',
				icon: 'ri:layout-grid-line',
				active: false,
				link: `/my-companies/${incorporationId}/dashboard`,
			},
			{
				label: 'Documentos',
				icon: 'ri:file-copy-line',
				active: false,
				link: `/my-companies/${incorporationId}/documents`,
			},
			{
				label: 'Ordenes',
				icon: 'ri:contract-line',
				active: true,
				link: `/my-companies/${incorporationId}/orders`,
			},
		]}
	/>
	<Orders />
</LayoutSidebar>
