// Ruta legacy: la vista de empresa constituida vive en /company/[companyId].
// Si la incorporación aún no tiene empresa canónica, volvemos al proceso.
const { data } = await Astro.locals.supabase
	.from('companies')
	.select('id')
	.eq('incorporation_id', Astro.params.incorporationId ?? '')
	.maybeSingle<{ id: string }>();

if (data?.id) {
	return Astro.redirect(`/company/${data.id}`);
}
return Astro.redirect(`/incorporation/${Astro.params.incorporationId}`);
