---
import LayoutSidebar from '@layouts/LayoutSidebar.astro';
import Alerta from '@components/feedback/Alert.astro';
import DocumentDetail from '@modules/documents/DocumentDetail.astro';

const { incorporationId, documentId } = Astro.params;
---

<LayoutSidebar>
	<Alerta />
	<DocumentDetail
		incorporationCaseId={incorporationId}
		documentId={documentId}
		backPath={`/incorporations/${incorporationId}/documents`}
	/>
</LayoutSidebar>
