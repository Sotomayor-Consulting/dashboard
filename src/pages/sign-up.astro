---
import LayoutStacked from '@layouts/LayoutSignIn.astro';
import FormSignUp from '@modules/auth/islands/FormSignUp.tsx';
import Alerta from '@components/feedback/Alert.astro';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
---

<LayoutStacked>
	<div class="flex h-full w-full items-center justify-center">
		<Alerta />
		<FormSignUp
			turnstileSiteKey={PUBLIC_TURNSTILE_SITE_KEY}
			client:load
		/>
	</div>
</LayoutStacked>
