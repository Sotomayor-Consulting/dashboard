---
import Alerta from '@components/feedback/alertageneral.astro';
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import DashBoard from '@modules/companies/CompanyDashboard.astro';
import { getIncorporacionById } from '@lib/tablas/empresa_incorporaciones';
const supabase = Astro.locals.supabase;

const { redirect } = Astro;
const { id } = Astro.params;
const user = Astro.locals.user;
const userId = user?.id;

if (!id || !userId) {
	return redirect('/companies');
}

const empresa = await getIncorporacionById(supabase, id, userId);

if (!empresa) {
	return redirect('/companies');
}
---

<LayoutSidebar>
	<Alerta />
	<DashBoard empresaId={id} />
</LayoutSidebar>
