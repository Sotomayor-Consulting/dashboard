---
import LayoutSidebar from '@app/layouts/LayoutSidebar.astro';
import DashBoard from '@modules/dashboard/DashBoardempresas.astro';
import { getIncorporacionById } from '@lib/tablas/empresa_incorporaciones';

const { redirect } = Astro;
const { id } = Astro.params;
const user = Astro.locals.user;
const userId = user?.id;

if (!id || !userId) {
	return redirect('/pages/empresas');
}

const empresa = await getIncorporacionById(id, userId);

if (!empresa) {
	return redirect('/pages/empresas');
}
---

<LayoutSidebar>
	<DashBoard />
</LayoutSidebar>
