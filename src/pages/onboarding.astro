---
// ─── Onboarding (post set-password) ─────────────────────
// Página a la que llega el usuario tras setear su contraseña cuando
// viene de una invitación de Odoo. Pide los datos faltantes de su
// empresa (nombre y estado de incorporación).
import LayoutStackedDos from '@app/layouts/LayoutStackedDos.astro';
import FormOnboarding from '@modules/auth/components/FormOnboarding.astro';
// @ts-ignore astro-check false positive: PATHS is used below
import { PATHS } from '@infrastructure/auth';

const supabase = Astro.locals.supabase;
const user = Astro.locals.user;

if (!user) return Astro.redirect(PATHS.signIn);

const meta = (user.user_metadata ?? {}) as Record<string, unknown>;
const appMeta = (user.app_metadata ?? {}) as Record<string, unknown>;
const isOdooUser = meta.source === 'odoo' || appMeta.source === 'odoo';

// Buscar empresa pendiente (source='odoo' y sin tipo_de_negocio)
let { data: empresa } = await supabase
	.from('empresas_incorporaciones')
	.select(
		'empresa_incorporacion_id, tipo_de_negocio, estado_de_incorporacion, nombre_1, nombre_2, nombre_3',
	)
	.eq('user_id', user.id)
	.eq('source', 'odoo')
	.is('tipo_de_negocio', null)
	.order('updated_at', { ascending: false })
	.limit(1)
	.maybeSingle();

// Si el usuario viene de Odoo pero no hay fila pendiente (ej: la RPC
// procesar_orden_odoo falló porque el producto no estaba mapeado),
// creamos un stub para que pueda completar el onboarding igualmente.
if (!empresa && isOdooUser) {
	const odooSaleOrderId = meta.odoo_sale_order_id ?? null;
	const { data: created, error: insertError } = await supabase
		.from('empresas_incorporaciones')
		.insert({
			user_id: user.id,
			estado_de_incorporacion: 'pendiente',
			estado: 'En proceso',
			porcentaje_de_incorporacion: 1,
			source: 'odoo',
			odoo_sale_order_id: odooSaleOrderId,
		})
		.select(
			'empresa_incorporacion_id, tipo_de_negocio, estado_de_incorporacion, nombre_1, nombre_2, nombre_3',
		)
		.single();
	if (insertError || !created) return Astro.redirect(PATHS.home);
	empresa = created;
}

// Si ya completó onboarding (o no es usuario Odoo), mandarlo al dashboard
if (!empresa) return Astro.redirect(PATHS.home);
---

<LayoutStackedDos>
	<div class="flex min-h-screen items-start pb-[8vh]">
		<FormOnboarding empresaId={empresa.empresa_incorporacion_id} />
	</div>
</LayoutStackedDos>
