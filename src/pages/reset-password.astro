---
import LayoutStacked from '@layouts/LayoutSignIn.astro';
import FormResetPassword from '@modules/auth/islands/FormResetPassword.tsx';

const user = Astro.locals.user;
const email = user?.email ?? Astro.url.searchParams.get('email') ?? '';
const status = Astro.url.searchParams.get('status');
const message = Astro.url.searchParams.get('msg');
---

<LayoutStacked>
	<FormResetPassword
		email={email}
		status={status}
		message={message}
		client:load
	/>
</LayoutStacked>
