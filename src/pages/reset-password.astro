---
import LayoutStacked from '@layouts/LayoutStackedDos.astro';
import FormResetPassword from '@modules/auth/islands/FormResetPassword.tsx';

const user = Astro.locals.user;
const email = user?.email ?? Astro.url.searchParams.get('email') ?? '';
const status = Astro.url.searchParams.get('status');
const message = Astro.url.searchParams.get('msg');
---

<LayoutStacked>
	<div class="min-h-screen align-middle flex pb-[12vh]">
		<FormResetPassword
			email={email}
			status={status}
			message={message}
			client:load
		/>
	</div>
</LayoutStacked>
