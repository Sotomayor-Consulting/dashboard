---
import LayoutSidebar from '@layouts/LayoutSidebar.astro';
import DocumentDetailContent from '@modules/documents/islands/DocumentDetailContent';

const mockDoc = {
	id: 'doc-test-001',
	status: 'approved',
	file_name: 'certificado-de-incorporacion.pdf',
	file_title: 'Certificado de Incorporación — Sotomayor LLC #2026',
	mime_type: 'application/pdf',
	file_size_bytes: 2845678,
	bucket_path: 'incorporations/case-123/documents/doc-test-001.pdf',
	created_at: '2026-05-10T08:00:00Z',
	uploaded_at: '2026-05-12T14:32:00Z',
	uploaded_by: 'user-staff-001',
	document_request_id: 'req-test-001',
	visibility: 'client_visible',
	shares: [
		{
			id: 'share-001',
			shared_with_user_id: 'user-client-001',
			share_status: 'active',
			shared_at: '2026-05-12T15:00:00Z',
		},
	],
	document_type: {
		id: 12,
		code: 12,
		name: 'Certificado de Incorporación',
		legal_category: 'corporate',
		applies_to: 'llc',
		description: 'Documento legal que acredita la constitución de la LLC.',
		is_active: true,
		is_expirable: false,
		requires_approval: true,
	},
};

const mockEvents = [
	{
		id: 'evt-001',
		event_type: 'uploaded',
		actor_role: 'cliente',
		notes: null,
		created_at: '2026-05-12T14:32:00Z',
	},
	{
		id: 'evt-002',
		event_type: 'shared',
		actor_role: 'admin',
		notes: 'Compartido con el equipo legal',
		created_at: '2026-05-12T15:00:00Z',
	},
	{
		id: 'evt-003',
		event_type: 'downloaded',
		actor_role: 'operaciones',
		notes: null,
		created_at: '2026-05-13T09:15:00Z',
	},
	{
		id: 'evt-004',
		event_type: 'approved',
		actor_role: 'admin',
		notes: 'Documento verificado y aprobado',
		created_at: '2026-05-13T11:00:00Z',
	},
];

const mockDocPending = {
	...mockDoc,
	id: 'doc-test-002',
	status: 'pending',
	file_title: 'Comprobante de Domicilio — Pendiente',
	mime_type: 'image/png',
	file_size_bytes: 512000,
	uploaded_at: null,
	document_type: {
		...mockDoc.document_type,
		name: 'Comprobante de Domicilio',
		legal_category: 'address',
	},
	shares: [],
};

const mockDocRejected = {
	...mockDoc,
	id: 'doc-test-003',
	status: 'rejected',
	file_title: 'Identificación Oficial — Rechazado',
	mime_type: 'application/pdf',
	file_size_bytes: 184000,
	document_type: {
		...mockDoc.document_type,
		name: 'Identificación Oficial',
		legal_category: 'identity',
	},
};

const mockEventsRejected = [
	{
		id: 'evt-r1',
		event_type: 'uploaded',
		actor_role: 'cliente',
		notes: null,
		created_at: '2026-05-10T10:00:00Z',
	},
	{
		id: 'evt-r2',
		event_type: 'rejected',
		actor_role: 'admin',
		notes: 'El documento no es legible. Por favor suba una copia más clara.',
		created_at: '2026-05-11T08:30:00Z',
	},
];

const mockDocUnderReview = {
	...mockDoc,
	id: 'doc-test-004',
	status: 'under_review',
	file_title: 'Contrato Social — En Revisión',
	mime_type: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
	file_size_bytes: 1250000,
	document_type: {
		...mockDoc.document_type,
		name: 'Contrato Social',
		legal_category: 'corporate',
	},
};
const mockEventsUnderReview = [
	{
		id: 'evt-ur1',
		event_type: 'uploaded',
		actor_role: 'cliente',
		notes: null,
		created_at: '2026-05-14T16:00:00Z',
	},
	{
		id: 'evt-ur2',
		event_type: 'metadata_updated',
		actor_role: 'operaciones',
		notes: 'Tipo de documento actualizado',
		created_at: '2026-05-14T17:30:00Z',
	},
];
---

<LayoutSidebar>
	<div class="p-6">
		<div class="mb-8">
			<h1 class="text-2xl font-bold text-gray-900 dark:text-white">
				Vista de prueba — Detalle de documentos
			</h1>
			<p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
				Prototipo del nuevo diseño para DocumentDetailContent
			</p>
		</div>

		<div class="mb-4 flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-800 dark:bg-amber-950/20 dark:text-amber-300">
			<svg
				class="h-4 w-4 shrink-0"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentcolor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
				/>
			</svg>
			<span>Vista previa con datos simulados. Los botones de descarga no funcionarán (
				<code class="rounded bg-amber-200/60 px-1 py-0.5 text-xs dark:bg-amber-900/40"
					>/api/documents/signed-url</code
				> no existe en este contexto).
			</span>
		</div>

		<DocumentDetailContent
			document={mockDoc}
			events={mockEvents}
			backPath="/test"
			variant="staff"
			client:load
		/>

		<div
			class="mt-6 rounded-xl border border-dashed border-gray-300 p-5 dark:border-gray-600"
		>
			<p class="mb-4 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
				Variantes de estado
			</p>
			<div class="grid gap-6 lg:grid-cols-3">
				<div>
					<div
						class="mb-2 flex items-center gap-2 text-xs font-medium text-gray-500"
					>
						<span
							class="inline-block h-2 w-2 rounded-full bg-amber-400"
						></span>
						Pendiente
					</div>
					<DocumentDetailContent
						document={mockDocPending}
						events={[]}
						backPath="/test"
						variant="staff"
						client:load
					/>
				</div>
				<div>
					<div
						class="mb-2 flex items-center gap-2 text-xs font-medium text-gray-500"
					>
						<span
							class="inline-block h-2 w-2 rounded-full bg-blue-400"
						></span>
						En revisión
					</div>
					<DocumentDetailContent
						document={mockDocUnderReview}
						events={mockEventsUnderReview}
						backPath="/test"
						variant="staff"
						client:load
					/>
				</div>
				<div>
					<div
						class="mb-2 flex items-center gap-2 text-xs font-medium text-gray-500"
					>
						<span
							class="inline-block h-2 w-2 rounded-full bg-red-400"
						></span>
						Rechazado
					</div>
					<DocumentDetailContent
						document={mockDocRejected}
						events={mockEventsRejected}
						backPath="/test"
						variant="staff"
						client:load
					/>
				</div>
			</div>
		</div>

		<div class="mt-6">
			<p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
				Estados de carga
			</p>
			<div class="grid gap-6 md:grid-cols-2">
				<div>
					<p class="mb-2 text-xs text-gray-500">Loading state</p>
					<DocumentDetailContent
						document={null}
						events={[]}
						backPath="/test"
						variant="staff"
						isLoading={true}
						client:load
					/>
				</div>
				<div>
					<p class="mb-2 text-xs text-gray-500">Error state</p>
					<DocumentDetailContent
						document={null}
						events={[]}
						backPath="/test"
						variant="staff"
						error="No se encontró el documento solicitado"
						client:load
					/>
				</div>
			</div>
		</div>
	</div>
</LayoutSidebar>
