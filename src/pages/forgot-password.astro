---
import LayoutStacked from '@layouts/LayoutStackedDos.astro';
import FormForgotPassword from '@modules/auth/islands/FormForgotPassword.tsx';

const status = Astro.url.searchParams.get('status');
const message = Astro.url.searchParams.get('msg');
---

<LayoutStacked>
	<div class="min-h-screen align-middle flex pb-[12vh]">
		<FormForgotPassword status={status} message={message} client:load />
	</div>
</LayoutStacked>
