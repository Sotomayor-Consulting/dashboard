---
import LayoutStacked from '@layouts/LayoutSignIn.astro';
import FormForgotPassword from '@modules/auth/islands/FormForgotPassword.tsx';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

const status = Astro.url.searchParams.get('status');
const message = Astro.url.searchParams.get('msg');
---

<LayoutStacked>
	<div class="flex h-full w-full items-center justify-center">
		<FormForgotPassword
			status={status}
			message={message}
			turnstileSiteKey={PUBLIC_TURNSTILE_SITE_KEY}
			client:load
		/>
	</div>
</LayoutStacked>
