---
import LayoutStacked from '@layouts/LayoutSignIn.astro';
import FormForgotPassword from '@modules/auth/islands/FormForgotPassword.tsx';

const status = Astro.url.searchParams.get('status');
const message = Astro.url.searchParams.get('msg');
---

<LayoutStacked>
	<div class="flex min-h-screen pb-[12vh] align-middle">
		<FormForgotPassword status={status} message={message} client:load />
	</div>
</LayoutStacked>
