---
import LayoutSidebar from '@layouts/LayoutSidebar.astro';
import SecuritySettings from '@modules/landing/SecuritySettings.astro';
import Alerta from '@components/feedback/Alert.astro';
import TabBar from '@components/navigation/TabBar.astro';
---

<LayoutSidebar>
	<Alerta />
	<TabBar
		buttons={[
			{
				label: 'Perfil',
				icon: 'ri:user-line',
				active: false,
				link: '/profile/',
			},
			{
				label: 'Facturación',
				icon: 'ri:bank-card-line',
				active: false,
				link: '/profile/billing',
			},
			{
				label: 'Notificaciones',
				icon: 'ri:notification-3-line',
				active: false,
				link: '/profile/notifications',
			},
			{
				label: 'Seguridad',
				icon: 'ri:shield-line',
				active: true,
				link: '/profile/security',
			},
		]}
	/>
	<SecuritySettings />
</LayoutSidebar>
