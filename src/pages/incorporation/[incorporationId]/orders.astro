---
import Tab from '@components/navigation/TabBar.astro';
import LayoutSidebar from '@layouts/LayoutSidebar.astro';
import Orderselemet from '@modules/documents/Orders.astro';
import { incorporationTabs } from '@modules/companies/incorporation-tabs';

const { incorporationId } = Astro.params;
---

<LayoutSidebar>
	<Tab buttons={incorporationTabs(incorporationId ?? '', 'orders')} />

	<Orderselemet incorporationId={incorporationId} />
</LayoutSidebar>
