{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"strictNullChecks": true,
		"paths": {
			"@components/*": ["./src/components/*"],
			"@assets/*": ["./src/assets/*"],
			"@estilos/*": ["./src/estilos/*"],
			"@lib/*": ["./src/lib/*"],
			"@app/*": ["./src/app/*"],
			"@modules/*": ["./src/modules/*"],
			"@types/*": ["./src/types/*"],
			"@services/*": ["./src/services/*"],
			"@datatables/*": ["./src/datatables/*"],
			"@middleware/*": ["./src/middleware/*"]
		}
	}
}
