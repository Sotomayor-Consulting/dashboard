{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"paths": {
			"@layouts/*": ["./src/layouts/*"],
			"@components/*": ["./src/components/*"],
			"@modules/*": ["./src/modules/*"],
			"@domains/*": ["./src/domains/*"],
			"@infrastructure/*": ["./src/lib/infrastructure/*"],
			"@integrations/*": ["./src/lib/integrations/*"],
			"@shared/*": ["./src/lib/shared/*"],
			"@third-party/*": ["./src/lib/third-party/*"],
			"@assets/*": ["./src/assets/*"],
			"@styles/*": ["./src/styles/*"]
		}
	},
	"exclude": [
		"dist",
		"node_modules",
		"public",
		"src/lib/third-party/alpinejs",
		"src/lib/third-party/simple-data-tables",
		"src/lib/third-party/surveyjs"
	]
}
