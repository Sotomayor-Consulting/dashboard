{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"paths": {
			"@components/*": ["./src/components/*"],
			"@assets/*": ["./src/assets/*"],
			"@styles/*": ["./src/styles/*"],
			"@lib/*": ["./src/lib/*"],
			"@lib/auth": ["./src/lib/auth/index.ts"],
			"@lib/supabase": ["./src/lib/supabase/index.ts"],
			"@app/*": ["./src/app/*"],
			"@modules/*": ["./src/modules/*"],
			"@types/*": ["./src/types/*"],
			"@services/*": ["./src/services/*"],
			"@middleware/*": ["./src/middleware/*"]
		}
	}
}
