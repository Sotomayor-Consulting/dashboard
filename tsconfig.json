{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"paths": {
			"@components/*": ["./src/components/*"],
			"@assets/*": ["./src/assets/*"],
			"@styles/*": ["./src/styles/*"],
			"@lib/*": ["./src/lib/*"],
			"@lib/auth": ["./src/lib/auth/index.ts"],
			"@lib/supabase": ["./src/lib/supabase/index.ts"],
			"@app/*": ["./src/app/*"],
			"@modules/*": ["./src/modules/*"],
			"@services/*": ["./src/services/*"]
		}
	},
	"exclude": [
		"dist",
		"node_modules",
		"public",
		"src/lib/alpinejs",
		"src/lib/simple-data-tables",
		"src/lib/surveyjs"
	]
}
