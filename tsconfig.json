{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"paths": {
			"@components/*": ["./src/components/*"],
			"@assets/*": ["./src/assets/*"],
			"@styles/*": ["./src/styles/*"],
			"@lib/*": ["./src/lib/*"],
			"@app/*": ["./src/app/*"],
			"@modules/*": ["./src/modules/*"],
			"@types/*": ["./src/types/*"],
			"@services/*": ["./src/services/*"]
		}
	}
}
